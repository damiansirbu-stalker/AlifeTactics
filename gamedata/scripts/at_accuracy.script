--- at_accuracy: Per-NPC rank-aware weapon dispersion via npc_shot_dispersion callback

local RegisterScriptCallback = RegisterScriptCallback

local cfg = at_mcm.cfg

local MT_RUN = 1
local TIERS = xcreature.RANK_TIERS

local _get_obj_rank_name = ranks.get_obj_rank_name

local _disp = {}
local _move = {}

local function _compute_disp(obj)
    if not cfg.disp_enabled then return nil end
    if not at_faction.has_flavor(obj, "accuracy") then return nil end
    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return nil end
    return _disp[tier]
end

local function _on_move_penalty(obj, wpn, body_state, move_type, temp_disp)
    if not cfg.move_enabled then return end
    if not (obj and temp_disp and temp_disp.dispersion) then return end
    if not at_faction.has_flavor(obj, "accuracy") then return end
    if not (move_type and move_type <= MT_RUN) then return end

    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return end
    local move = _move[tier]
    if not move or move == 1.0 then return end

    local timer  = xprofiler.new_if(at_debug.is_on()):start()
    local base = temp_disp.dispersion
    temp_disp.dispersion = base * move
    timer:stop()

    if at_debug.is_on() then
        local sect = (wpn and wpn:section()) or "none"
        at_debug.debug("[ACC] move id=%d tier=%s section=%s bs=%d mt=%d base=%.5f move=%.2f out=%.5f [%.3fms]",
            obj:id(), tier, sect, body_state, move_type, base, move, temp_disp.dispersion, timer:get_ms())
    end
end

local function _update_config()
    at_debug.update_config()
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _disp[tier] = at_mcm.get_config("acc_disp_" .. tier)
        _move[tier] = at_mcm.get_config("acc_move_" .. tier)
    end
end

local function _on_first_update()
    _update_config()
    at_debug.info("Accuracy hook initialized (dispersion=%s, moving=%s, dbg=%s)",
        cfg.disp_enabled and "on" or "off", cfg.move_enabled and "on" or "off", at_debug.is_on() and "true" or "false")
end

function on_game_start()
    at_effects_resolver.register(at_effects_resolver.EFFECT.SHOT_DISPERSION, _compute_disp)
    RegisterScriptCallback("npc_shot_dispersion",       _on_move_penalty)
    RegisterScriptCallback("actor_on_first_update",     _on_first_update)
    RegisterScriptCallback("on_option_change",          _update_config)
    RegisterScriptCallback("mcm_option_restore_default", _update_config)
end

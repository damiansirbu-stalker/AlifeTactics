--- at_accuracy: Per-NPC rank-aware weapon dispersion via npc_shot_dispersion callback

local RegisterScriptCallback = RegisterScriptCallback

local log = xlog.get_logger("AT.ACC", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- Engine flow (ai_stalker_fire.cpp:75-142): base = PI/180; base *= m_fRankDisperison (=0.8
-- for clamped Anomaly ranks); base *= per-state factor (walk/zoom/crouch); callback fires.
-- We stack disp on top: out = base * disp. disp=1.0 preserves engine baseline; lower = tighter.

local _disp = {
    novice       = 1.00,
    trainee      = 0.90,
    experienced  = 0.80,
    professional = 0.70,
    veteran      = 0.60,
    expert       = 0.52,
    master       = 0.45,
    legend       = 0.38,
}

local _get_obj_rank_name = ranks.get_obj_rank_name

-- Callback signature (obj, wpn, body_state, move_type, temp_disp) per
-- axr_main.script:126 and _g.script:1213-1217. temp_disp is a shared table;
-- subscribers read/write temp_disp.dispersion.
local function _on_npc_shot_dispersion(obj, wpn, body_state, move_type, temp_disp)
    if not cfg.accuracy_enabled then return end
    if not obj or not temp_disp then return end

    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return end

    local disp = _disp[tier]
    if not disp then return end

    local tmr  = xprofiler.new_if(_dbg):start()
    local base = temp_disp.dispersion
    if not base then tmr:stop() return end
    local out  = base * disp
    temp_disp.dispersion = out
    tmr:stop()

    if _dbg then
        log.debug("[ACC] id=%d tier=%s base=%.5f disp=%.2f out=%.5f [%.3fms]",
            obj:id(), tier, base, disp, out, tmr:get_ms())
    end
end

local function _refresh_config()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5

    _disp.novice       = at_mcm.get_config("acc_disp_novice")       or _disp.novice
    _disp.trainee      = at_mcm.get_config("acc_disp_trainee")      or _disp.trainee
    _disp.experienced  = at_mcm.get_config("acc_disp_experienced")  or _disp.experienced
    _disp.professional = at_mcm.get_config("acc_disp_professional") or _disp.professional
    _disp.veteran      = at_mcm.get_config("acc_disp_veteran")      or _disp.veteran
    _disp.expert       = at_mcm.get_config("acc_disp_expert")       or _disp.expert
    _disp.master       = at_mcm.get_config("acc_disp_master")       or _disp.master
    _disp.legend       = at_mcm.get_config("acc_disp_legend")       or _disp.legend
end

local function _on_first_update()
    _refresh_config()
    log.info("Accuracy hook initialized (enabled=%s, dbg=%s)",
        cfg.accuracy_enabled and "true" or "false", _dbg and "true" or "false")
end

function on_game_start()
    RegisterScriptCallback("npc_shot_dispersion",       _on_npc_shot_dispersion)
    RegisterScriptCallback("actor_on_first_update",     _on_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_config)
end

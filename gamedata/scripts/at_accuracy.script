--- at_accuracy: Per-NPC rank-aware weapon dispersion via npc_shot_dispersion callback

local RegisterScriptCallback = RegisterScriptCallback

local log = xlog.get_logger("AT.ACC", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- Engine flow (ai_stalker_fire.cpp:75-142): base = PI/180; base *= m_fRankDisperison (=0.8
-- for clamped Anomaly ranks); base *= per-state factor (walk/zoom/crouch); callback fires.
-- We stack two factors on top: out = base * disp * move. disp is the flat rank curve, spread wide
-- so rank reads over positional noise (novice 1.20 sprays, legend 0.20 is the proven 52-62%-hit
-- cone; 1.0 preserves engine baseline, lower = tighter, above 1.0 loosens). move applies ONLY while
-- the shooter is moving (move_type walk/run - the same movement_type() the engine keys its walk/run
-- multipliers on, ai_stalker_fire.cpp:81-104): it cancels part of the movement penalty per rank. The
-- penalty is ~2x cone (walk 5.1+1 vs still 2.0+1, m_stalker.ltx:478-482), so factor 0.50 erases it
-- and 1.00 keeps the full vanilla penalty; legend 0.50 = full erase for the top rank, novice 1.00 =
-- full penalty. Same tier-floor lerp as every curve (game_relations.ltx:8 floors / 27000).

-- Per-tier curves, filled from at_mcm at _refresh_config (single source of truth: the at_mcm defaults
-- table + MCM sliders). Empty here on purpose - get_config never returns nil for these keys (the
-- defaults table carries all 16), so a script-side copy would be dead. Curve shape is in the header.
local _disp = {}
local _move = {}

-- move_type enum (ai_monster_space.h:31-33): walk = 0, run = 1, stand = 2.
local MT_RUN = 1

-- The 8 rank tiers, MCM key order (mirrors the _disp/_move tables and the at_mcm slider ids).
local TIERS = { "novice", "trainee", "experienced", "professional", "veteran", "expert", "master", "legend" }

local _get_obj_rank_name = ranks.get_obj_rank_name

-- Callback signature (obj, wpn, body_state, move_type, temp_disp) per
-- axr_main.script:126 and _g.script:1213-1217. temp_disp is a shared table;
-- subscribers read/write temp_disp.dispersion.
local function _on_npc_shot_dispersion(obj, wpn, body_state, move_type, temp_disp)
    if not (cfg.disp_enabled or cfg.move_enabled) then return end
    if not obj or not temp_disp then return end
    if xcreature.community(obj) == "zombied" then return end

    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return end

    -- Dispersion and moving-fire are independent toggles: a disabled factor stays 1.0 (no change).
    local disp = (cfg.disp_enabled and _disp[tier]) or 1.0
    local move = 1.0
    if cfg.move_enabled and move_type and move_type <= MT_RUN then
        move = _move[tier] or 1.0
    end

    local tmr  = xprofiler.new_if(_dbg):start()
    local base = temp_disp.dispersion
    if not base then tmr:stop() return end
    local out  = base * disp * move
    temp_disp.dispersion = out
    tmr:stop()

    if _dbg then
        local sect = (wpn and wpn:section()) or "none"
        log.debug("[ACC] id=%d tier=%s section=%s bs=%d mt=%d base=%.5f disp=%.2f move=%.2f out=%.5f [%.3fms]",
            obj:id(), tier, sect, body_state, move_type, base, disp, move, out, tmr:get_ms())
    end
end

local function _refresh_config()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5

    for i = 1, #TIERS do
        local tier = TIERS[i]
        _disp[tier] = at_mcm.get_config("acc_disp_" .. tier)
        _move[tier] = at_mcm.get_config("acc_move_" .. tier)
    end
end

local function _on_first_update()
    _refresh_config()
    log.info("Accuracy hook initialized (dispersion=%s, moving=%s, dbg=%s)",
        cfg.disp_enabled and "on" or "off", cfg.move_enabled and "on" or "off", _dbg and "true" or "false")
end

function on_game_start()
    RegisterScriptCallback("npc_shot_dispersion",       _on_npc_shot_dispersion)
    RegisterScriptCallback("actor_on_first_update",     _on_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_config)
end

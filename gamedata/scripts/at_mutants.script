--- at_mutants: the mutant combat driver - tier stat scaling, innate Wild, the decision model over the engine FSM

local math_random, math_min, math_sqrt, math_floor = math.random, math.min, math.sqrt, math.floor
local math_acos, math_deg = math.acos, math.deg
local time_global, pairs, next, rawget, tostring = time_global, pairs, next, rawget, tostring
local table_concat = table.concat
local RegisterScriptCallback, UnregisterScriptCallback = RegisterScriptCallback, UnregisterScriptCallback
local ini_sys, level, AC_ID, vector = ini_sys, level, AC_ID, vector

local cfg = at_mcm.cfg

local LTX_PATH        = "alifetactics\\at_mutants_config.ltx"
local BEAT_MS         = 600
local STALE_MS        = 12000
local SWEEP_MS        = 10000
local TIER_MIN, TIER_MAX = 0, 5
local BURER           = "burer"
local CONTROLLER      = "controller"
local POLTERGEIST     = "poltergeist"
local AURA_NAMES      = { "psy", "radiation", "fire" }
local GATE            = "int, pers"
local GATE_WILD       = "int, pers, wild"
local VS_PLAYER, VS_NPC = "vs_player", "vs_npc"
local MOVE_CHARGED_LEAP      = "charged_leap"
local MOVE_SUDDEN_LEAP       = "sudden_leap"
local MOVE_ADJUSTING_LEAP    = "adjusting_leap"
local MOVE_INTERCEPTING_LEAP = "intercepting_leap"
local MOVE_CLOSING_LEAP      = "closing_leap"
local MOVE_CLAW       = "claw"
local MOVE_GRAVITY    = "gravity_attack"
local MOVE_RUN_ATTACK = "run_attack"
local MOVE_BACKSTRIKE = "backstrike"
local MOTION_STEADY, MOTION_MOVING = "steady", "moving"
local FIRED_CALLED, FIRED_SHAPED, FIRED_ENGINE = "called", "shaped", "engine"
local VIS_FULL        = 2

-- Charged leap keeps the species wind-up; every other leap launches straight into the glide (ePrepareSkip).
local LAUNCH_WINDUP  = { skip_prepare = false }
local LAUNCH_INSTANT = { skip_prepare = true }

-- Claw stops where it lands (eGroundSkip, control_jump.cpp:393); the mask carries into every later jump (:73-79), so it clears at once.
local CLAW_FLAGS     = { ground_skip = true }
local CLAW_FLAGS_OFF = {}

-- Every move the adopt line and the MCM tree key on; backstrike arms at adoption, claw checks on contact, the rest decide per beat.
local MOVE_KEYS = {
    "charged_leap", "sudden_leap", "adjusting_leap", "intercepting_leap", "closing_leap", "flee",
    "cloak", "gravity_attack", "claw", "backstrike",
}

-- The per-beat decision chain the selection shuffles and walks; backstrike/auras arm at adoption and claw checks on contact, not here.
local DECISION_MOVES = {
    "charged_leap", "sudden_leap", "adjusting_leap", "intercepting_leap", "closing_leap", "flee", "gravity_attack", "cloak",
}

-- The leaps a species may carry; any one of them makes the mutant a leaper that rolls its leap numbers at adoption.
local LEAP_MOVES = { "charged_leap", "sudden_leap", "adjusting_leap", "intercepting_leap", "closing_leap" }

-- The gate token each fired move prints: a leap whose force Wild spreads carries wild, Charged leap flies at the species force.
local MOVE_GATES = {
    charged_leap = GATE, sudden_leap = GATE_WILD, adjusting_leap = GATE_WILD,
    intercepting_leap = GATE_WILD, closing_leap = GATE_WILD,
}

local _states = {}
local _tracks = { damage = {}, taken = {} }
local _tun = nil
local _tun_num = nil
local _move_species = {}
local _personality_cache = {}
local _pages = {}
local _move_cfg = {}
local _all_toggle_keys = {}
local _backstrike_motions = {}
local _starts = nil
local _active = false
local _seams = nil
local _runaway_id = nil
local _next_sweep = 0
local _stale_ids = {}
local _tick_ms, _tick_max, _tick_n = 0, 0, 0
local _adopt_ms, _adopt_n = 0, 0
local _prop_ms, _prop_n, _prop_silent = 0, 0, 0
local _contact_ms, _contact_max, _contact_n = 0, 0, 0
local _actor_vuln, _actor_vuln_at = false, 0
local _log_at = 0
local _order = {}
local _apply_enabled

local WINDOW_MS = 30000

-- Accumulate per-beat cost into the windowed [MUT] summary line, the per-session budget verdict; the per-update contact lane rides along.
local function _log_tick(ms, now)
    _tick_n = _tick_n + 1
    _tick_ms = _tick_ms + ms
    if ms > _tick_max then _tick_max = ms end
    if now < _log_at then return end
    _log_at = now + WINDOW_MS
    local count = 0
    for _ in pairs(_states) do count = count + 1 end
    at_debug.debug("[MUT] window=%.0fs ticks=%d tick_avg=%.3fms tick_max=%.3fms contacts=%d contact_avg=%.3fms contact_max=%.3fms"
        .. " adopts=%d adopt_avg=%.3fms props=%d prop_avg=%.3fms silent=%d mutants=%d",
        WINDOW_MS / 1000, _tick_n, _tick_ms / _tick_n, _tick_max,
        _contact_n, _contact_n > 0 and _contact_ms / _contact_n or 0, _contact_max,
        _adopt_n, _adopt_n > 0 and _adopt_ms / _adopt_n or 0,
        _prop_n, _prop_n > 0 and _prop_ms / _prop_n or 0, _prop_silent, count)
    _tick_ms, _tick_max, _tick_n = 0, 0, 0
    _contact_ms, _contact_max, _contact_n = 0, 0, 0
    _adopt_ms, _adopt_n = 0, 0
    _prop_ms, _prop_n, _prop_silent = 0, 0, 0
end

-- A bounded pick in [low, high]; the Wild slider scales the spread - 0 = the band middle, 100 = any point across the band.
local function _select_band(low, high)
    local mid = (low + high) * 0.5
    local wild = (cfg.mut_wild or 0) * 0.01
    if wild <= 0 then return mid end
    return mid + (low + math_random() * (high - low) - mid) * wild
end

-- The Intelligence probability: (base + per-rank * tier) / 100, capped - the act chance of the decision model.
local function _compute_intelligence(rec)
    return math_min((cfg.mut_int_base + cfg.mut_int_rank_pct * rec.tier) / 100, _tun_num.int_cap)
end

-- The one Intelligence roll of a decision; the 6s clock stamps either way (the caller stamps it).
local function _check_intelligence(rec)
    return math_random() < _compute_intelligence(rec)
end

-- The species' MCM toggle for a move (page-keyed); false for a species carrying no page row.
local function _check_toggle(rec, move)
    local keys = rec.species and _move_cfg[rec.species]
    local key = keys and keys[move]
    return key ~= nil and cfg[key] == true
end

-- The page's MCM toggle for an ability vary family (psi_tube, stamina, aura, detection, gravity_numbers, telekinesis); false where no row exists.
local function _check_vary(rec, family)
    local page = rec.page
    return page ~= nil and cfg["mut_" .. page .. "_" .. family] == true
end

-- The adopt-line move list: the species' applicable moves (anatomy, the [moves] envelope).
local function _format_moves(species)
    if not species then return "-" end
    local parts = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        if _move_species[move][species] then parts[#parts + 1] = move end
    end
    if #parts == 0 then return "-" end
    return table_concat(parts, " ")
end

local function _read_num(section, key)
    return xltx.read_num(_tun, section, key)
end

-- The install's own value for one monster LTX key, nil when absent.
local function _read_basis(mob_section, key)
    return ini_sys:r_float_ex(mob_section, key)
end

local function _get_tier()
    local tier = xlevel.get_danger_tier(level.name()) or xlevel.DANGER_TIER_DEFAULT
    if tier < TIER_MIN then return TIER_MIN end
    if tier > TIER_MAX then return TIER_MAX end
    return tier
end

-- Rebuild the per-tier damage and resistance multipliers from the formula sliders.
local function _build_tracks()
    for tier = TIER_MIN, TIER_MAX do
        _tracks.damage[tier] = 1 + (cfg.mut_damage_pct or 0) / 100 * tier
        _tracks.taken[tier] = 1 - (cfg.mut_resist_pct or 0) / 100 * tier
    end
end

-- A basis value under a bounded wild fraction; nil basis skips the family.
local function _compute_offset(basis, pct)
    if not basis then return nil end
    return basis * _select_band(1 - pct, 1 + pct)
end

-- A band pair under ONE shared wild factor, so a narrow band can never invert min over max.
local function _compute_band(min_basis, max_basis, pct)
    if not (min_basis or max_basis) then return nil, nil end
    local factor = _select_band(1 - pct, 1 + pct)
    return min_basis and min_basis * factor or nil, max_basis and max_basis * factor or nil
end

-- The caps: starts assumed running per bucket; an offensive fire checks then adds, flee adds and is never denied.
local function _check_start(bucket)
    local cap = bucket == VS_PLAYER and _tun_num.cap_player or _tun_num.cap_npc
    return _starts:get_count(bucket) < cap
end

local function _add_start(bucket)
    _starts:add(bucket)
end

-- The per-species Personality roll for a move, rolled after the beat's Intelligence pass (the at_faction twin); cached per (move, species), absent = 1.0.
-- Each leap carries its own personality section (personality_charged_leap, _sudden_leap, ...); the leaps share nothing.
local function _check_personality(rec, move)
    local species = rec.species
    if not species then return true end
    local ck = move .. "/" .. species
    local chance = _personality_cache[ck]
    if chance == nil then
        local section = "personality_" .. move
        chance = _read_num(section, species) or _read_num(section, "default") or 1
        _personality_cache[ck] = chance
    end
    return at_core.check_chance(chance)
end

-- The leap numbers, rolled once at adoption: the force, the steering restore point, the Intelligence lead gain and the Closing leap reach.
-- The force basis is the species jump_factor, or [leap] basis where the species has none (the bloodsucker's never loads).
local function _apply_leap(_mob, rec, section)
    if not rec.leaper then return end
    local basis = _read_basis(section, "jump_factor") or _tun_num.leap_basis
    rec.leap_basis = basis
    rec.leap_force = basis * _select_band(_tun_num.force_min_mult, _tun_num.force_max_mult)
    rec.aim_basis = _read_basis(section, "jump_auto_aim_factor") or 0
    rec.lead_gain = _tun_num.lead_floor + (1 - _tun_num.lead_floor) * _compute_intelligence(rec) / _tun_num.int_cap
    rec.see_radius = _read_basis(section, "partial_visibility_radius") or _tun_num.see_radius
    if at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d force=%.2f basis=%.2f lead_gain=%.2f reach=%.1f",
            rec.id, rec.leap_force, basis, rec.lead_gain, rec.see_radius)
    end
end

-- The controller pacing: the psi tube rhythm and the stamina drain, varied over the install's own values.
local function _apply_controller_pacing(mob, rec, section)
    local see_ms, tube_ms, stamina
    local pct = _tun_num.ability_pct
    if _check_vary(rec, "psi_tube") then
        see_ms = _compute_offset(_read_basis(section, "tube_condition_see_duration"), pct)
        tube_ms = _compute_offset(_read_basis(section, "tube_condition_min_delay"), pct)
        if see_ms or tube_ms then
            xmonster.set_controller_tube_params(mob, { see_duration_ms = see_ms, min_delay_ms = tube_ms })
        end
    end
    if _check_vary(rec, "stamina") then
        stamina = _compute_offset(_read_basis(section, "stamina_hit"), pct)
        if stamina then xmonster.set_controller_stamina_hit(mob, stamina) end
    end
    if (see_ms or tube_ms or stamina) and at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d tube=%.0f/%.0fms stamina=%.3f",
            rec.id, see_ms or 0, tube_ms or 0, stamina or 0)
    end
end

-- The poltergeist detection envelope: perception ranges and speeds, a standalone ability, not flight movement.
local function _apply_poltergeist_pacing(mob, rec, section)
    if not _check_vary(rec, "detection") then return end
    local pct = _tun_num.ability_pct
    local near_f = _compute_offset(_read_basis(section, "detection_near_range_factor"), pct)
    local far_f = _compute_offset(_read_basis(section, "detection_far_range_factor"), pct)
    local far_r = _compute_offset(_read_basis(section, "detection_far_range"), pct)
    xmonster.set_poltergeist_detection_params(mob, {
        near_factor = near_f,
        far_factor = far_f,
        far_range = far_r,
        speed_factor = _compute_offset(_read_basis(section, "detection_speed_factor"), pct),
        loose_speed = _compute_offset(_read_basis(section, "detection_loose_speed"), pct),
    })
    if at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d detection=%.2f/%.2f/%.1f", rec.id, near_f or 0, far_f or 0, far_r or 0)
    end
end

-- The species pacing rolls: the controller tube and stamina, the poltergeist detection (cloak is a decided move now, not a dwell vary).
local function _apply_pacing(mob, rec, section)
    if rec.species == CONTROLLER then _apply_controller_pacing(mob, rec, section) end
    if rec.species == POLTERGEIST then _apply_poltergeist_pacing(mob, rec, section) end
end

-- The burer gravity numbers and telekinesis families, varied over the install's own values.
local function _apply_burer_params(mob, rec, section)
    if rec.species ~= BURER then return end
    rec.gravi_min = _read_basis(section, "Gravi_MinDist")
    rec.gravi_max = _read_basis(section, "Gravi_MaxDist")
    local pct = _tun_num.ability_pct
    if _check_vary(rec, "gravity_numbers") then
        local gravi_min, gravi_max = _compute_band(_read_basis(section, "Gravi_MinDist"),
            _read_basis(section, "Gravi_MaxDist"), pct)
        local cooldown = _compute_offset(_read_basis(section, "Gravi_Cooldown"), pct)
        local speed = _compute_offset(_read_basis(section, "Gravi_Speed"), pct)
        xmonster.set_burer_gravi_params(mob, {
            cooldown_ms = cooldown,
            min_dist = gravi_min, max_dist = gravi_max,
            speed = speed,
            radius = _compute_offset(_read_basis(section, "Gravi_Radius"), pct),
        })
        if at_debug.is_on() then
            at_debug.debug("[MUT] vary id=%d gravi=%.1f-%.1f cd=%.0f speed=%.1f",
                rec.id, gravi_min or 0, gravi_max or 0, cooldown or 0, speed or 0)
        end
    end
    if _check_vary(rec, "telekinesis") then
        local tele_min, tele_max = _compute_band(_read_basis(section, "tele_min_distance"),
            _read_basis(section, "tele_max_distance"), pct)
        local objects = _compute_offset(_read_basis(section, "Tele_Max_Handled_Objects"), pct)
        local count = objects and math_floor(objects + 0.5) or nil
        xmonster.set_burer_telekinesis_params(mob, {
            max_objects = count,
            find_radius = _compute_offset(_read_basis(section, "Tele_Find_Radius"), pct),
            min_dist = tele_min, max_dist = tele_max,
            fly_velocity = _compute_offset(_read_basis(section, "tele_fly_velocity"), pct),
        })
        if at_debug.is_on() then at_debug.debug("[MUT] vary id=%d tele=%.1f-%.1f objects=%d", rec.id, tele_min or 0, tele_max or 0, count or 0) end
    end
end

-- One aura family, strength and reach varied; a species without the keys skips it.
local function _apply_aura(mob, rec, section, name)
    local pct = _tun_num.ability_pct
    local power = _read_basis(section, name .. "_max_power")
    local dist = _read_basis(section, name .. "_max_distance")
    if not (power or dist) then return end
    local varied_power = _compute_offset(power, pct)
    local varied_dist = _compute_offset(dist, pct)
    xmonster.set_monster_aura_params(mob, name, {
        max_power = varied_power,
        max_distance = varied_dist,
    })
    if at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d aura=%s power=%.3f dist=%.1f",
            rec.id, name, varied_power or 0, varied_dist or 0)
    end
end

-- Every aura the species carries, behind the page's Aura row.
local function _apply_auras(mob, rec, section)
    if not _check_vary(rec, "aura") then return end
    for i = 1, #AURA_NAMES do
        _apply_aura(mob, rec, section, AURA_NAMES[i])
    end
end

-- The rear spin-strike arms once at adoption on an Intelligence x Personality roll; the engine self-fires it after.
local function _try_arm_backstrike(mob, rec)
    local motions = rec.moves.backstrike and _check_toggle(rec, "backstrike")
        and _backstrike_motions[rec.species] or nil
    if not motions or not _check_intelligence(rec) or not _check_personality(rec, "backstrike") then return end
    xmonster.set_monster_melee_strike(mob, motions[1], motions[2], _tun_num.backstrike_arc)
    rec.armed_backstrike = true
    if at_debug.is_on() then
        at_debug.debug("[MUT] arm id=%d backstrike arc=%.0f gate=%s", rec.id, _tun_num.backstrike_arc, GATE)
    end
end

-- A species carries a leap when any leap's [moves] envelope lists it.
local function _is_leaper(moves)
    for i = 1, #LEAP_MOVES do
        if moves[LEAP_MOVES[i]] then return true end
    end
    return false
end

local function _add_mutant(mob, id, now)
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local tier = _get_tier()
    local species = xcreature.get_mutant_species(id)
    local page = species and _pages[species] or nil
    local moves = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        moves[move] = species ~= nil and _move_species[move][species] == true
    end
    local rec = {
        id = id,
        species = species,
        page = page,
        tier = tier,
        leaper = _is_leaper(moves),
        next_ms = 0,
        seen_ms = now,
        tick_now = now,
        driver = "-",
        moves = moves,
        memo = {},
        move_buf = {},
        flee_ok_at = 0,
        flee_until = 0,
        gravity_release = 0,
        claw_ok_at = 0,
        leap_ok_at = 0,
        cloak_until = 0,
        cloak_ok_at = 0,
        claw = moves.claw,
        low_now = false,
    }
    _states[id] = rec
    local section = mob:section()
    _apply_leap(mob, rec, section)
    _apply_pacing(mob, rec, section)
    _apply_burer_params(mob, rec, section)
    _apply_auras(mob, rec, section)
    _try_arm_backstrike(mob, rec)
    tmr:stop()
    if dbg then
        local ms = tmr:get_ms()
        _adopt_n = _adopt_n + 1
        _adopt_ms = _adopt_ms + ms
        at_debug.debug("[MUT] adopt id=%s species=%s tier=%d moves=%s [%.3fms]",
            id, tostring(species), tier, _format_moves(species), ms)
    end
    return rec
end

local function _remove_stale(now)
    if now < _next_sweep then return end
    _next_sweep = now + SWEEP_MS
    local found = 0
    for id, rec in pairs(_states) do
        if now - rec.seen_ms > STALE_MS then
            found = found + 1
            _stale_ids[found] = id
        end
    end
    for i = 1, found do
        _states[_stale_ids[i]] = nil
        _stale_ids[i] = nil
    end
end

-- The enemy's can't-answer read: the back turned on this mutant per mutant, the actor's own state once per beat window for every mutant.
local function _check_enemy_vulnerable(mob, enemy, is_actor, now)
    if at_core.is_enemy_back_turned(enemy, mob) then return true end
    if not is_actor then return at_core.is_enemy_vulnerable(enemy) == true end
    if now >= _actor_vuln_at then
        _actor_vuln_at = now + BEAT_MS
        _actor_vuln = at_core.is_enemy_vulnerable(enemy) == true
    end
    return _actor_vuln
end

-- Start the debug outcome record of a fired leap or claw; the dealt seam marks its hits, the contact lane or the claw clear stops it.
local function _start_strike(rec, move, now, force, time_s)
    rec.strike = { move = move, fired_at = now, force = force, time_s = time_s, hit = false, dealt = 0, stuck = false }
end

-- Write the outcome line of a finished strike and drop the record.
local function _stop_strike(rec, now, finish)
    local strike = rec.strike
    rec.strike = nil
    at_debug.debug("[MUT] %s id=%d move=%s force=%.2f T=%.2f dur=%.2f hit=%s dealt=%.3f end=%s",
        strike.move == MOVE_CLAW and "CLAW" or "LEAP", rec.id, strike.move, strike.force, strike.time_s,
        (now - strike.fired_at) / 1000, strike.hit and "y" or "n", strike.dealt, finish)
end

-- The open leap's outcome, read on every update: land when the jump releases at or past T, abort before it.
-- One warning when the jump still holds the body past T plus the margin, the freeze check.
local function _update_strike(mob, rec, now)
    local strike = rec.strike
    local held_ms = now - strike.fired_at
    local time_ms = strike.time_s * 1000
    if xmonster.is_monster_jumping(mob) then
        if not strike.stuck and held_ms > time_ms + _tun_num.stuck_margin_ms then
            strike.stuck = true
            at_debug.warn("[MUT] LEAP id=%d move=%s held=%dms T=%.2f still in flight", rec.id, strike.move, held_ms, strike.time_s)
        end
        return
    end
    local finish = "land"
    if strike.stuck then finish = "stuck" elseif held_ms < time_ms then finish = "abort" end
    _stop_strike(rec, now, finish)
end

-- The per-beat motion sample: the enemy's horizontal velocity over the real elapsed time, and the previous beat's for the turn angle.
local function _update_samples(rec, enemy_pos, now)
    local px, pz, sampled_ms = rec.enemy_px, rec.enemy_pz, rec.sampled_ms
    rec.enemy_px, rec.enemy_pz, rec.sampled_ms = enemy_pos.x, enemy_pos.z, now
    rec.prev_vx, rec.prev_vz, rec.prev_moved = rec.enemy_vx, rec.enemy_vz, rec.moved
    if not px or now <= sampled_ms then
        rec.enemy_vx, rec.enemy_vz, rec.moved = nil, nil, false
        return
    end
    local dx, dz = enemy_pos.x - px, enemy_pos.z - pz
    local secs = (now - sampled_ms) / 1000
    rec.enemy_vx, rec.enemy_vz = dx / secs, dz / secs
    rec.moved = dx * dx + dz * dz > _tun_num.move_min_m * _tun_num.move_min_m
end

-- The enemy's velocity for the lead: the player's own physics velocity, else the beat displacement.
local function _get_enemy_velocity(rec, enemy, is_actor)
    local velocity = is_actor and xcombat.get_actor_velocity(enemy)
    if velocity then return velocity.x, velocity.z end
    return rec.enemy_vx, rec.enemy_vz
end

-- The enemy's motion over the last beats: moving when it covered more than [motion] move_min_m since the last beat.
-- Steady when it also moved the beat before and turned at most [motion] steady_deg between the two.
local function _compute_motion(rec)
    local vx, vz, wx, wz = rec.enemy_vx, rec.enemy_vz, rec.prev_vx, rec.prev_vz
    if not (vx and rec.moved) then return nil end
    if not (wx and rec.prev_moved) then return MOTION_MOVING end
    local speed, prev_speed = math_sqrt(vx * vx + vz * vz), math_sqrt(wx * wx + wz * wz)
    local cos_turn = (vx * wx + vz * wz) / (speed * prev_speed)
    if cos_turn < -1 then cos_turn = -1 elseif cos_turn > 1 then cos_turn = 1 end
    if math_deg(math_acos(cos_turn)) <= _tun_num.steady_deg then return MOTION_STEADY end
    return MOTION_MOVING
end

-- Stamp the driver label, the move's gate, and the fire time; the HUD reads them.
local function _log_fire(rec, move, dist, detail)
    local gate = MOVE_GATES[move] or GATE
    rec.driver = move:gsub("_", " "):upper()
    rec.fired_move = move
    rec.fired_kind = FIRED_CALLED
    rec.gate = gate
    rec.fired_at = rec.tick_now
    if at_debug.is_on() then
        at_debug.debug("[MUT] FIRE id=%d move=%s d=%.1f%s gate=%s", rec.id, move, dist, detail or "", gate)
    end
end

-- A move refused by its block check: the cause goes to the trace, the selection walks on.
local function _log_block(rec, move, cause)
    if at_debug.is_on() then at_debug.debug("[MUT] BLOCK id=%d move=%s cause=%s", rec.id, move, cause) end
    return false
end

--- True when AT shaped this engine-fired move: backstrike was armed by us, Gravity numbers varied the blast; the run-attack is engine-only.
local function _check_shaped(rec, move)
    if move == MOVE_BACKSTRIKE then return rec.armed_backstrike == true end
    if move == MOVE_GRAVITY then return _check_vary(rec, "gravity_numbers") end
    return false
end

--- Stamp an engine-fired move (run-attack, backstrike, gravi) so the trace, HUD and manifest see it; fired outside the beat, so time_global not tick_now.
--- No gate: the HUD files a gated row as AT-driven. A gravi blast inside our own force window keeps the stamp _try_gravity wrote.
local function _log_engine_fire(mob, move)
    local rec = mob and _states[mob:id()]
    if not rec then return end
    if move == MOVE_GRAVITY and rec.gravity_release > 0 then return end
    rec.driver = move:gsub("_", " "):upper()
    rec.fired_move = move
    rec.fired_kind = _check_shaped(rec, move) and FIRED_SHAPED or FIRED_ENGINE
    rec.gate = nil
    rec.fired_at = time_global()
    if at_debug.is_on() then
        at_debug.debug("[MUT] FIRE id=%d move=%s by=%s d=%.1f", rec.id, move, rec.fired_kind, rec.dist or -1)
    end
end

--- The engine run-attack completion relay - the vanilla lunge, traced only.
local function _on_run_attack_end(mob) _log_engine_fire(mob, MOVE_RUN_ATTACK) end

--- The engine melee-jump (rear backstrike) completion relay.
local function _on_melee_jump_end(mob) _log_engine_fire(mob, MOVE_BACKSTRIKE) end

--- A burer gravi blast, autonomous or forced.
local function _on_burer_gravi(burer) _log_engine_fire(burer, MOVE_GRAVITY) end

-- The engine-state gate every leap shares: the mutant sensed its enemy within [leap] sense_ms, by its own enemy memory.
-- Below the enemy-memory reader it falls back to the instant see read.
local function _can_leap(mob, enemy, now)
    local unseen_ms = xmonster.get_enemy_unseen_ms(mob, now)
    if unseen_ms == nil then
        if not xcombat.can_see(mob, enemy) then return false, "unseen" end
        return true
    end
    if unseen_ms > _tun_num.leap_sense_ms then return false, "unseen" end
    return true
end

-- The gates every leap shares after its own premise: the per-mob gap, then the engine-state gate.
-- The mod owns the pacing because the game's own jump cooldown is 0 on the chimera and lurker and absent on the bloodsucker.
local function _check_leap_block(mob, rec, now)
    if now < rec.leap_ok_at then return "gap" end
    local can_leap, leap_block = _can_leap(mob, rec.memo.enemy, now)
    if not can_leap then return leap_block end
    return nil
end

-- Charged leap: an enemy up on a rock or ledge, the 0.8m standard of the game's own dog (dog.cpp:410-422).
local function _check_charged_leap_block(mob, rec, now)
    if not xcombat.is_enemy_above(rec.memo.enemy, mob, _tun_num.above_m) then return "level" end
    return _check_leap_block(mob, rec, now)
end

-- Sudden leap: the enemy aims at the mutant (a wind-up hands them the shot) or cannot answer (reloading, turned away).
local function _check_sudden_leap_block(mob, rec, now)
    local memo = rec.memo
    if not (memo.aiming or memo.vulnerable) then return "calm" end
    return _check_leap_block(mob, rec, now)
end

-- Adjusting leap: the enemy is moving, so the steering follows it in flight.
local function _check_adjusting_leap_block(mob, rec, now)
    if not rec.memo.motion then return "still" end
    return _check_leap_block(mob, rec, now)
end

-- Intercepting leap: the enemy moves steadily, so its path predicts where it will be.
local function _check_intercepting_leap_block(mob, rec, now)
    if rec.memo.motion ~= MOTION_STEADY then return "unsteady" end
    return _check_leap_block(mob, rec, now)
end

-- Closing leap: inside the drawn range (bloodsucker.cpp:590-600), a perched enemy at any distance or the aiming player past the charge band.
-- Only the player counts as aiming, since a stalker cannot see it beyond full visibility; it sets memo.perch for the force.
local function _check_closing_leap_block(mob, rec, now)
    local memo = rec.memo
    if memo.dist > rec.see_radius then return "far" end
    if xcombat.is_enemy_above(memo.enemy, mob, _tun_num.above_m) then
        memo.perch = true
    elseif memo.is_actor and memo.aiming and memo.dist >= _tun_num.closing_min_m then
        memo.perch = false
    else
        return "calm"
    end
    return _check_leap_block(mob, rec, now)
end

-- The Intercepting leap aim point: the enemy's position advanced by its velocity over the engine's own flight time, scaled by the lead gain.
-- One fixed-point pass (time the unled point, lead, time the led point), the offset capped, and a point off the navmesh falls back to the unled one.
local function _compute_lead_point(mob, rec, memo, force)
    local pos = memo.enemy_pos
    local vx, vz = memo.vel_x, memo.vel_z
    if not vx then return pos, 0 end
    local gain = rec.lead_gain
    local time_s = xmonster.compute_jump_time(mob, pos, force)
    if not time_s then return pos, 0 end
    local lead = vector():set(pos.x + vx * time_s * gain, pos.y, pos.z + vz * time_s * gain)
    time_s = xmonster.compute_jump_time(mob, lead, force)
    local off_x, off_z = vx * time_s * gain, vz * time_s * gain
    local off = math_sqrt(off_x * off_x + off_z * off_z)
    local cap = _tun_num.lead_max_m
    if off > cap then
        off_x, off_z = off_x * cap / off, off_z * cap / off
        off = cap
    end
    lead:set(pos.x + off_x, pos.y, pos.z + off_z)
    if xcombat.is_point_off_navmesh(lead, _tun_num.lead_gap_m * _tun_num.lead_gap_m) then return pos, 0 end
    return lead, off
end

-- The shared leap launch: the start cap, the claw clear, the optional steering, the engine jump, the unled retry, the restore.
-- order = { target, force, steered, lead_m }; feasibility is the can_jump mirror in xmonster.try_monster_jump.
local function _execute_leap(mob, rec, move, now, order)
    local memo = rec.memo
    if not _check_start(memo.bucket) then return false end
    local aim
    if order.steered then
        aim = _select_band(_tun_num.adapt_min, _tun_num.adapt_max)
        xmonster.set_monster_jump_flags(mob, { auto_aim = true, auto_aim_factor = aim })
    end
    local launch = move == MOVE_CHARGED_LEAP and LAUNCH_WINDUP or LAUNCH_INSTANT
    local target, lead_m = order.target, order.lead_m
    local fired = xmonster.try_monster_jump(mob, target, order.force, launch)
    if not fired and lead_m > 0 then
        target, lead_m = memo.enemy_pos, 0
        fired = xmonster.try_monster_jump(mob, target, order.force, launch)
    end
    if aim then
        rec.aim_restore = fired or nil
        xmonster.set_monster_jump_flags(mob, fired and {} or { auto_aim_factor = rec.aim_basis })
    end
    if not fired then return false end
    _add_start(memo.bucket)
    rec.leap_ok_at = now + _tun_num.leap_gap
    if at_debug.is_on() then
        local time_s = xmonster.compute_jump_time(mob, target, order.force) or 0
        _start_strike(rec, move, now, order.force, time_s)
        _log_fire(rec, move, memo.dist, (" force=%.2f lead=%.2f T=%.2f%s"):format(order.force, lead_m, time_s,
            aim and (" aim=%.2f"):format(aim) or ""))
    else
        _log_fire(rec, move, memo.dist)
    end
    return true
end

-- Fill the shared launch order for one leap.
local function _build_order(target, force, steered, lead_m)
    _order.target, _order.force, _order.steered, _order.lead_m = target, force, steered, lead_m
    return _order
end

-- Charged leap: the one wind-up leap, at the species force so the arc clears a ledge lip a flat fast arc would clip (control_jump.cpp:462-472).
local function _try_charged_leap(mob, rec, _move, now)
    local block = _check_charged_leap_block(mob, rec, now)
    if block then return _log_block(rec, MOVE_CHARGED_LEAP, block) end
    if not _check_personality(rec, MOVE_CHARGED_LEAP) then return false end
    return _execute_leap(mob, rec, MOVE_CHARGED_LEAP, now, _build_order(rec.memo.enemy_pos, rec.leap_basis, false, 0))
end

-- Sudden leap: the instant pounce at where the enemy stands.
local function _try_sudden_leap(mob, rec, _move, now)
    local block = _check_sudden_leap_block(mob, rec, now)
    if block then return _log_block(rec, MOVE_SUDDEN_LEAP, block) end
    if not _check_personality(rec, MOVE_SUDDEN_LEAP) then return false end
    return _execute_leap(mob, rec, MOVE_SUDDEN_LEAP, now, _build_order(rec.memo.enemy_pos, rec.leap_force, false, 0))
end

-- Adjusting leap: the instant pounce that steers in flight toward the enemy's live position.
local function _try_adjusting_leap(mob, rec, _move, now)
    local block = _check_adjusting_leap_block(mob, rec, now)
    if block then return _log_block(rec, MOVE_ADJUSTING_LEAP, block) end
    if not _check_personality(rec, MOVE_ADJUSTING_LEAP) then return false end
    return _execute_leap(mob, rec, MOVE_ADJUSTING_LEAP, now, _build_order(rec.memo.enemy_pos, rec.leap_force, true, 0))
end

-- Intercepting leap: the instant pounce at where the enemy will be, with no steering (steering homes on the live position and undoes the lead).
local function _try_intercepting_leap(mob, rec, _move, now)
    local block = _check_intercepting_leap_block(mob, rec, now)
    if block then return _log_block(rec, MOVE_INTERCEPTING_LEAP, block) end
    if not _check_personality(rec, MOVE_INTERCEPTING_LEAP) then return false end
    local target, lead_m = _compute_lead_point(mob, rec, rec.memo, rec.leap_force)
    return _execute_leap(mob, rec, MOVE_INTERCEPTING_LEAP, now, _build_order(target, rec.leap_force, false, lead_m))
end

-- Closing leap: the bloodsucker's gap-closer, which never hits in the air (its jump hit range never loads); its claws strike after it lands.
-- A perch takes the species force for the ledge lip, the aim case the Wild-spread force.
local function _try_closing_leap(mob, rec, _move, now)
    local block = _check_closing_leap_block(mob, rec, now)
    if block then return _log_block(rec, MOVE_CLOSING_LEAP, block) end
    if not _check_personality(rec, MOVE_CLOSING_LEAP) then return false end
    local force = rec.memo.perch and rec.leap_basis or rec.leap_force
    return _execute_leap(mob, rec, MOVE_CLOSING_LEAP, now, _build_order(rec.memo.enemy_pos, force, false, 0))
end

-- Rout out of melee reach: hurt, far enough to disengage, not nose-on to the enemy; a committed fixed-timer window, the caps never deny it.
local function _try_flee(mob, rec, _move, now)
    if not rec.low_now then return false end
    local memo = rec.memo
    if memo.dist < _tun_num.flee_min_m or now < rec.flee_ok_at or not _runaway_id then return false end
    if xcombat.is_facing(mob, memo.enemy_pos, _tun_num.flee_face_cone) then return false end
    if not _check_personality(rec, "flee") then return false end
    local hold = _select_band(_tun_num.survival_hold_min, _tun_num.survival_hold_max)
    rec.flee_until = now + hold
    rec.flee_ok_at = now + _tun_num.flee_throttle_ms
    _add_start(memo.bucket)
    _log_fire(rec, "flee", memo.dist, (" hold=%dms"):format(hold))
    return true
end

-- The engine-state gate for a claw: the jump component refuses while a jump already holds the body.
local function _can_claw(mob)
    if xmonster.is_monster_jumping(mob) then return false, "jumping" end
    return true
end

-- The claw gates on the contact lane: the cheap record fields first, then the live reach and facing, then the engine-state gate.
-- It records the live target and distance on rec.contact_pos and rec.contact_dist for the launch.
local function _check_claw_block(mob, rec, now)
    if now < rec.claw_ok_at then return "gap" end
    if not rec.dist or rec.dist > _tun_num.claw_near_m then return "far" end
    if rec.flee_until > now or rec.gravity_release > now then return "window" end
    local enemy = mob:get_enemy()
    if not (enemy and enemy:alive()) then return "no_enemy" end
    local enemy_pos = enemy:position()
    local dist_sqr = mob:position():distance_to_sqr(enemy_pos)
    if dist_sqr > _tun_num.claw_range_m * _tun_num.claw_range_m then return "range" end
    if not xcombat.is_facing(mob, enemy_pos, _tun_num.claw_cone) then return "facing" end
    local can_claw, claw_block = _can_claw(mob)
    if not can_claw then return claw_block end
    rec.contact_pos, rec.contact_dist = enemy_pos, math_sqrt(dist_sqr)
    return nil
end

-- Claw: the chimera-class point-blank pounce with no wind-up, its damage the jump's own hit (control_jump.cpp:523-570).
-- Checked on every monster update because contact lasts a fraction of a beat; any roll stamps the gap.
local function _try_claw(mob, rec, now)
    if _check_claw_block(mob, rec, now) then return end
    rec.claw_ok_at = now + _tun_num.claw_gap
    local miss = (not _check_intelligence(rec) and "int") or (not _check_personality(rec, MOVE_CLAW) and "pers") or nil
    if miss then
        if at_debug.is_on() then at_debug.debug("[MUT] CLAW id=%d miss cause=%s", rec.id, miss) end
        return
    end
    xmonster.set_monster_jump_flags(mob, CLAW_FLAGS)
    local fired = xmonster.try_monster_jump(mob, rec.contact_pos, rec.leap_basis, LAUNCH_INSTANT)
    xmonster.set_monster_jump_flags(mob, CLAW_FLAGS_OFF)
    if not fired then return end
    rec.tick_now = now
    if at_debug.is_on() then
        _start_strike(rec, MOVE_CLAW, now, rec.leap_basis, xmonster.compute_jump_time(mob, rec.contact_pos, rec.leap_basis) or 0)
    end
    _log_fire(rec, MOVE_CLAW, rec.contact_dist)
end

-- The burer forced gravi throw, shield-safe by the trigger: a vulnerable or back-turned player is not shooting, so the burer's shield is never wanted.
-- force_gravi bypasses the gravi gate (burer_state_attack_gravi_inline.h:81), so the range band, LOS and facing are hoisted here; the cooldown bypass stays.
local function _try_gravity(mob, rec, _move, now)
    local memo = rec.memo
    if not memo.vulnerable and xcombat.is_enemy_watching(memo.enemy, mob, _tun_num.threat_cone) then return false end
    if rec.gravi_max and (memo.dist > rec.gravi_max or memo.dist < (rec.gravi_min or 0)) then return false end
    if not xcombat.can_see(mob, memo.enemy) then return false end
    if not xcombat.is_facing(mob, memo.enemy_pos, _tun_num.gravity_cone) then return false end
    if not _check_personality(rec, MOVE_GRAVITY) then return false end
    if not _check_start(memo.bucket) then return false end
    if not xmonster.set_burer_gravi_force(mob, true) then return false end
    rec.gravity_release = now + _tun_num.gravity_release
    _add_start(memo.bucket)
    _log_fire(rec, MOVE_GRAVITY, memo.dist)
    return true
end

-- The bloodsucker cloak: vanish reactively to break a lock or a hit, then re-appear when the window ends.
-- Forces no_visibility over the engine's natural flicker (the vanilla force_visibility_state); rate-limited, released on its window in the upkeep.
local function _try_cloak(mob, rec, _move, now)
    local memo = rec.memo
    if memo.dist <= _tun_num.cloak_melee_m then return false end
    local hit = rec.hit_at and (now - rec.hit_at) < _tun_num.cloak_hit_ms
    if not (memo.aiming or hit) then return false end
    if now < rec.cloak_ok_at then return false end
    if xmonster.get_visibility_state(mob) ~= VIS_FULL then return false end
    if not _check_personality(rec, "cloak") then return false end
    if not xmonster.force_visibility_state(mob, 0) then return false end
    rec.cloak_until = now + _tun_num.cloak_window_ms
    rec.cloak_ok_at = now + _tun_num.cloak_throttle_ms
    _log_fire(rec, "cloak", memo.dist, hit and " on=hit" or " on=aim")
    return true
end

-- The move -> handler dispatch for the per-beat decision chain; each leap is its own atomic handler with its own gates and Personality.
local TRY = {
    charged_leap = _try_charged_leap, sudden_leap = _try_sudden_leap, adjusting_leap = _try_adjusting_leap,
    intercepting_leap = _try_intercepting_leap, closing_leap = _try_closing_leap,
    flee = _try_flee, gravity_attack = _try_gravity, cloak = _try_cloak,
}

-- The selection shuffles this species' toggled decision moves in place (xmath.shuffle_back).
-- It walks up to [select] candidates and the FIRST that fires consumes the beat and breaks; no premise table, no shared gate.
local function _select_move(mob, rec, now)
    local buf = rec.move_buf
    local count = 0
    for i = 1, #DECISION_MOVES do
        local move = DECISION_MOVES[i]
        if rec.moves[move] and _check_toggle(rec, move) then
            count = count + 1
            buf[count] = move
        end
    end
    if count == 0 then return end
    xmath.shuffle_back(buf, count)
    local limit = _tun_num.candidates
    if limit > count then limit = count end
    for i = 1, limit do
        if TRY[buf[i]](mob, rec, buf[i], now) then return end
    end
end

-- The no-enemy reset: release what the fight held and drop the per-engagement state.
local function _reset_fight(mob, rec)
    if rec.gravity_release > 0 then
        xmonster.set_burer_gravi_force(mob, false)
        rec.gravity_release = 0
    end
    if rec.cloak_until > 0 then
        xmonster.force_visibility_state(mob, -1)
        rec.cloak_until = 0
    end
    rec.driver = "-"
    rec.gate = nil
    rec.dist = nil
    rec.enemy_px, rec.enemy_pz, rec.sampled_ms = nil, nil, nil
    rec.enemy_vx, rec.enemy_vz, rec.prev_vx, rec.prev_vz = nil, nil, nil, nil
    rec.moved, rec.prev_moved = false, false
end

local _gate_probe = {}

-- The one 600ms lane runs upkeep and samples every beat, then (if no committed window holds) rolls Intelligence once.
-- Only on a pass does it build the decision memo and run the move selection; a miss does zero premise or feasibility work.
local function _update_mutant(mob, rec, now)
    rec.tick_now = now
    rec.seen_ms = now
    if rec.gravity_release > 0 and now >= rec.gravity_release then
        xmonster.set_burer_gravi_force(mob, false)
        rec.gravity_release = 0
    end
    if rec.cloak_until > 0 and now >= rec.cloak_until then
        xmonster.force_visibility_state(mob, -1)
        rec.cloak_until = 0
    end
    local enemy = mob:get_enemy()
    if not enemy or not enemy:alive() then
        _reset_fight(mob, rec)
        return
    end
    local enemy_pos = enemy:position()
    local mob_pos = mob:position()
    local dist_sqr = mob_pos:distance_to_sqr(enemy_pos)
    local dist = math_sqrt(dist_sqr)
    rec.dist = dist
    _update_samples(rec, enemy_pos, now)
    if rec.flee_until > now or rec.gravity_release > now then return end
    local ac = db.actor
    if not ac then return end
    _gate_probe.actor_dist_sqr = mob_pos:distance_to_sqr(ac:position())
    if not at_core.is_in_gate(_gate_probe) then return end
    if not _check_intelligence(rec) then
        if at_debug.is_on() then at_debug.debug("[MUT] PASS id=%d int", rec.id) end
        return
    end
    local is_actor = enemy:id() == AC_ID
    local memo = rec.memo
    memo.enemy = enemy
    memo.enemy_pos = enemy_pos
    memo.mob_pos = mob_pos
    memo.dist = dist
    memo.dist_sqr = dist_sqr
    memo.is_actor = is_actor
    memo.bucket = is_actor and VS_PLAYER or VS_NPC
    memo.aiming = xcombat.is_enemy_watching(enemy, mob, _tun_num.aim_cone)
    memo.vulnerable = _check_enemy_vulnerable(mob, enemy, is_actor, now)
    if rec.leaper then
        memo.vel_x, memo.vel_z = _get_enemy_velocity(rec, enemy, is_actor)
        memo.motion = _compute_motion(rec)
    end
    rec.low_now = xmonster.get_monster_health(mob) <= _tun_num.survival_frac
    _select_move(mob, rec, now)
end

-- The per-update lane ahead of the beat throttle: the leap outcome, the steering restore and the claw contact check.
-- monster_on_update is a scheduler-cadence carrier (100ms near to 625ms far), never a render frame.
local function _update_contact(mob, rec, now)
    if rec.strike then _update_strike(mob, rec, now) end
    if rec.aim_restore and not xmonster.is_monster_jumping(mob) then
        xmonster.set_monster_jump_flags(mob, { auto_aim_factor = rec.aim_basis })
        rec.aim_restore = nil
    end
    if rec.claw then _try_claw(mob, rec, now) end
end

local function _on_mob_update(mob)
    if not _active then return end
    if not (mob and mob:alive()) then return end
    local now = time_global()
    local id = mob:id()
    local rec = _states[id]
    if rec then
        local dbg = at_debug.is_on()
        local tmr = xprofiler.new_if(dbg):start()
        _update_contact(mob, rec, now)
        tmr:stop()
        if dbg then
            local ms = tmr:get_ms()
            _contact_n = _contact_n + 1
            _contact_ms = _contact_ms + ms
            if ms > _contact_max then _contact_max = ms end
        end
        if now < rec.next_ms then return end
    end
    if _seams == nil then
        _seams = xmonster.get_monster_state(mob) ~= nil
        if not _seams then
            at_debug.warn("at_mutants INACTIVE: the monster seam set is absent on this exe")
            _apply_enabled()
            return
        end
        if xmonster.has_trace_surface(mob) then
            xmonster.on_run_attack_end(_on_run_attack_end)
            xmonster.on_melee_jump_end(_on_melee_jump_end)
            xmonster.on_burer_gravi(_on_burer_gravi)
        end
    end
    if not rec then
        if cfg.combat_ignore_companions and xsquad.is_companion(get_object_squad(mob)) then return end
        rec = _add_mutant(mob, id, now)
    end
    rec.next_ms = now + BEAT_MS
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    _update_mutant(mob, rec, now)
    _remove_stale(now)
    timer:stop()
    if at_debug.is_on() then _log_tick(timer:get_ms(), now) end
end

-- Re-propose eStateAttack_RunAway while a flee window holds; the silent path stays pure Lua.
local function _on_combat_action(monster, _enemy, _dist, _enemy_strength, _can_jump, flags)
    local rec = _states[monster:id()]
    if not rec or rec.flee_until <= rec.tick_now then
        if at_debug.is_on() then _prop_silent = _prop_silent + 1 end
        return
    end
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    flags.substate = _runaway_id
    tmr:stop()
    if dbg then
        _prop_n = _prop_n + 1
        _prop_ms = _prop_ms + tmr:get_ms()
    end
end

-- Scale what an adopted mutant deals; shared by the three victim seams. A 1.0 track skips the engine write.
local function _apply_dealt(shit)
    if next(_states) == nil or not shit then return end
    local attacker = shit.draftsman
    if not attacker then return end
    local rec = _states[attacker:id()]
    if not rec then return end
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local dealt = _tracks.damage[rec.tier]
    if dealt ~= 1 then xcombat.apply_hit_power(shit, dealt) end
    tmr:stop()
    if dbg then
        local strike = rec.strike
        if strike then
            strike.hit = true
            strike.dealt = strike.dealt + shit.power
        end
        at_debug.debug("[MUT] dealt id=%d mult=%.2f power=%.3f move=%s [%.3fms]", rec.id, dealt, shit.power,
            strike and strike.move or "-", tmr:get_ms())
    end
end

local function _on_npc_before_hit(_npc, shit, _bone_id)
    _apply_dealt(shit)
end

-- Scale what an adopted mutant takes; monster-vs-monster dealt scaling routes through the same seam.
local function _on_monster_before_hit(mob, shit, _bone_id)
    if next(_states) == nil or not shit then return end
    _apply_dealt(shit)
    local rec = _states[mob:id()]
    if not rec then return end
    rec.hit_at = rec.tick_now
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local taken = _tracks.taken[rec.tier]
    if taken ~= 1 then xcombat.apply_hit_power(shit, taken) end
    tmr:stop()
    if dbg then
        at_debug.debug("[MUT] taken id=%d mult=%.2f power=%.3f [%.3fms]", rec.id, taken, shit.power, tmr:get_ms())
    end
end

-- Drop the record on server-entity unregister; freed ids are pooled.
local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _states[se_obj.id] = nil
end

-- Release what a dropped record pushed and still owns live: the animation override, a pending gravi force, or a gain restore.
-- Pushed params revert on the next spawn (not serialized).
local function _release_mutant(rec)
    local mob = xobject.get_go(rec.id)
    if not mob then return end
    if rec.gravity_release > 0 then xmonster.set_burer_gravi_force(mob, false) end
    if rec.cloak_until > 0 then xmonster.force_visibility_state(mob, -1) end
    if rec.aim_restore then xmonster.set_monster_jump_flags(mob, { auto_aim_factor = rec.aim_basis }) end
end

-- Any nonzero stat slider, any species move toggle, or any vary row keeps the module live.
local function _check_wanted()
    if _seams == false then return false end
    if (cfg.mut_damage_pct or 0) > 0 or (cfg.mut_resist_pct or 0) > 0 then
        return true
    end
    for i = 1, #_all_toggle_keys do
        if cfg[_all_toggle_keys[i]] == true then return true end
    end
    return false
end

_apply_enabled = function()
    local wanted = _check_wanted()
    if wanted == _active then return end
    _active = wanted
    if _active then
        RegisterScriptCallback("monster_on_update", _on_mob_update)
        RegisterScriptCallback("actor_on_before_hit", _apply_dealt)
        RegisterScriptCallback("npc_on_before_hit", _on_npc_before_hit)
        RegisterScriptCallback("monster_on_before_hit", _on_monster_before_hit)
        xmonster.on_monster_combat_action(_on_combat_action)
    else
        UnregisterScriptCallback("monster_on_update", _on_mob_update)
        UnregisterScriptCallback("actor_on_before_hit", _apply_dealt)
        UnregisterScriptCallback("npc_on_before_hit", _on_npc_before_hit)
        UnregisterScriptCallback("monster_on_before_hit", _on_monster_before_hit)
        UnregisterScriptCallback("monster_on_combat_action", _on_combat_action)
        for _, rec in pairs(_states) do _release_mutant(rec) end
        _states = {}
    end
end

-- One species' move-toggle keys (mut_<page>_<move>), each new key collected into the global list once.
local function _build_species_keys(species, page, seen_keys)
    local keys = {}
    for k = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[k]
        local key = _move_species[move][species] and ("mut_" .. page .. "_" .. move) or nil
        if key then
            keys[move] = key
        end
        if key and not seen_keys[key] then
            seen_keys[key] = true
            _all_toggle_keys[#_all_toggle_keys + 1] = key
        end
    end
    return keys
end

-- The ability vary-row keys; the Wild law for what may vary lives in at_mutants_config.ltx [wild].
local VARY_KEYS = {
    "mut_controller_psi_tube", "mut_controller_stamina", "mut_controller_aura",
    "mut_poltergeist_detection",
    "mut_burer_gravity_numbers", "mut_burer_telekinesis",
}

local function _load_tunables()
    _tun = xltx.resolve_handle(LTX_PATH)
    _tun_num = {
        candidates = _read_num("select", "candidates") or 3,
        flee_throttle_ms = (_read_num("throttle", "flee") or 60) * 1000,
        cap_player = _read_num("caps", "vs_player"),
        cap_npc = _read_num("caps", "vs_npc"),
        int_cap = _read_num("intelligence", "cap"),
        above_m = _read_num("premises", "above_m"),
        leap_basis = _read_num("leap", "basis"),
        force_min_mult = _read_num("leap", "force_min_mult"),
        force_max_mult = _read_num("leap", "force_max_mult"),
        leap_gap = _read_num("leap", "gap_ms"),
        leap_sense_ms = _read_num("leap", "sense_ms"),
        stuck_margin_ms = _read_num("leap", "stuck_margin_ms"),
        lead_floor = _read_num("lead", "floor_mult"),
        lead_max_m = _read_num("lead", "max_m"),
        lead_gap_m = _read_num("lead", "navmesh_gap_m"),
        move_min_m = _read_num("motion", "move_min_m"),
        steady_deg = _read_num("motion", "steady_deg"),
        see_radius = _read_num("closing_leap", "see_radius"),
        closing_min_m = _read_num("closing_leap", "aim_min_m"),
        flee_min_m = _read_num("survival", "min_dist_m"),
        flee_face_cone = _read_num("survival", "face_cone_deg"),
        survival_frac = _read_num("survival", "health_frac"),
        survival_hold_min = _read_num("survival", "hold_min"),
        survival_hold_max = _read_num("survival", "hold_max"),
        threat_cone = _read_num("threat", "facing_cone_deg"),
        aim_cone = _read_num("threat", "aim_cone_deg"),
        adapt_min = _read_num("adapt", "factor_min"), adapt_max = _read_num("adapt", "factor_max"),
        claw_range_m = _read_num("claw", "range_m"),
        claw_near_m = _read_num("claw", "near_m"),
        claw_cone = _read_num("claw", "facing_cone_deg"),
        claw_gap = _read_num("claw", "gap_ms"),
        gravity_cone = _read_num("gravity_attack", "face_cone_deg"),
        gravity_release = _read_num("gravity_attack", "release_ms"),
        cloak_melee_m = _read_num("cloak", "melee_m"),
        cloak_hit_ms = _read_num("cloak", "hit_ms"),
        cloak_window_ms = _read_num("cloak", "window_ms"),
        cloak_throttle_ms = _read_num("cloak", "throttle_ms"),
        backstrike_arc = _read_num("backstrike", "arc_deg"),
        ability_pct = _read_num("wild", "ability_pct"),
    }
    _starts = xttltable.create_ttl_counter({ ttl = _read_num("caps", "starts_s") or 3 })
    _move_species = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        local set = {}
        local list = xltx.read_list(_tun, "moves", move)
        for k = 1, #list do set[list[k]] = true end
        _move_species[move] = set
    end
    _personality_cache = {}
    _move_cfg = {}
    _all_toggle_keys = {}
    local seen_keys = {}
    _pages = xltx.read_section(_tun, "pages")
    for species, page in pairs(_pages) do
        _move_cfg[species] = _build_species_keys(species, page, seen_keys)
    end
    for i = 1, #VARY_KEYS do _all_toggle_keys[#_all_toggle_keys + 1] = VARY_KEYS[i] end
    _backstrike_motions = {}
    local backstrike_list = xltx.read_list(_tun, "moves", "backstrike")
    for i = 1, #backstrike_list do
        local species = backstrike_list[i]
        local pair = xltx.read_list(_tun, "backstrike", species)
        if #pair >= 2 then _backstrike_motions[species] = pair end
    end
end

local function _on_option_change()
    _build_tracks()
    _apply_enabled()
end

local function _on_first_update()
    _runaway_id = rawget(_G, "monster_state") and monster_state.eStateAttack_RunAway or nil
    _build_tracks()
    _apply_enabled()
end

--- The per-mutant record for one id (the HUD read: moves, windows, the decision clock), nil when not adopted.
function get_mutant_record(id)
    return _states[id]
end

--- The species' per-beat decided moves as a set (the DECISION_MOVES the species carries), for the manifestation coverage harness.
function get_species_moves(species)
    local set = {}
    if not species then return set end
    for i = 1, #DECISION_MOVES do
        local move = DECISION_MOVES[i]
        if _move_species[move] and _move_species[move][species] then set[move] = true end
    end
    return set
end

--- The driver label for one adopted mutant ("CLAW"/"SUDDEN LEAP"/"RUN ATTACK"/.../"-"), nil when not adopted.
--- The record's .gate ("int, pers" or "int, pers, wild") names what influenced the fired move; the HUD appends it.
function get_driver(id)
    local rec = _states[id]
    return rec and rec.driver or nil
end

function on_game_start()
    _load_tunables()
    RegisterScriptCallback("actor_on_first_update", _on_first_update)
    RegisterScriptCallback("on_option_change", _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
end

--- at_mutants: the mutant combat driver - tier stat scaling, innate Wild, the decision model over the engine FSM

local math_random, math_min, math_sqrt, math_floor = math.random, math.min, math.sqrt, math.floor
local time_global, pairs, next, rawget, tostring, tonumber = time_global, pairs, next, rawget, tostring, tonumber
local table_concat = table.concat
local RegisterScriptCallback, UnregisterScriptCallback = RegisterScriptCallback, UnregisterScriptCallback
local ini_sys, level, AC_ID = ini_sys, level, AC_ID

local cfg = at_mcm.cfg

local LTX_PATH        = "alifetactics\\at_mutants_config.ltx"
local BEAT_MS         = 600
local STALE_MS        = 12000
local SWEEP_MS        = 10000
local TIER_MIN, TIER_MAX = 0, 5
local SHOTGUN_KIND    = "w_shotgun"
local BAND_IN         = "in"
local BURER           = "burer"
local CONTROLLER      = "controller"
local POLTERGEIST     = "poltergeist"
local AURA_NAMES      = { "psy", "radiation", "fire" }
local GATE_BOTH       = "int, wild"
local VS_PLAYER, VS_NPC = "vs_player", "vs_npc"
local LEAP_FAMILY     = "leap"
local MOVE_JUMP       = "jump"
local MOVE_LEAP_ADAPT = "leap_adapt"
local MOVE_JUMP_ADAPT = "jump_adapt"
local MOVE_FLEE       = "flee"
local MOVE_RETREAT    = "retreat"

local MOVE_KEYS = {
    "leap", "jump", "leap_adapt", "jump_adapt", "flee", "retreat",
    "cloak", "gravity_attack", "claw", "backstrike",
}

-- The capped moves check a bucket slot before firing; flee adds a slot but is never denied; claw sits outside the caps.
local CAPPED = {
    leap = true, jump = true, leap_adapt = true, jump_adapt = true,
    gravity_attack = true, retreat = true,
}

-- The premise-to-move table: array order is priority; bipeds marks rows the body-plan law denies quadrupeds.
local BEST_MOVES = {
    { premise = "low_health",    move = "flee" },
    { premise = "vulnerable",    move = "leap", bipeds = true },
    { premise = "shotgun_open",  move = "leap", bipeds = true },
    { premise = "enemy_above",   move = "leap" },
    { premise = "enemy_above",   move = "gravity_attack" },
    { premise = "aim_held",      move = "gravity_attack" },
    { premise = "unreachable",   move = "retreat", nojump = true },
    { premise = "contact",       move = "claw" },
}

local _states = {}
local _tracks = { damage = {}, taken = {} }
local _tun = nil
local _tun_num = nil
local _move_species = {}
local _inside_chance = {}
local _quadrupeds = {}
local _pages = {}
local _move_cfg = {}
local _all_toggle_keys = {}
local _claw_motion = nil
local _backstrike_motions = {}
local _slots = nil
local _active = false
local _seams = nil
local _runaway_id = nil
local _next_sweep = 0
local _stale_ids = {}
local _tick_ms, _tick_max, _tick_n = 0, 0, 0
local _adopt_ms, _adopt_n = 0, 0
local _prop_ms, _prop_n, _prop_silent = 0, 0, 0
local _actor_vuln, _actor_vuln_at = false, 0
local _log_at = 0
local _apply_enabled

local WINDOW_MS = 30000

-- Accumulate per-beat cost into the windowed [MUT] summary line, the per-session budget verdict.
local function _log_tick(ms, now)
    _tick_n = _tick_n + 1
    _tick_ms = _tick_ms + ms
    if ms > _tick_max then _tick_max = ms end
    if now < _log_at then return end
    _log_at = now + WINDOW_MS
    local count = 0
    for _ in pairs(_states) do count = count + 1 end
    at_debug.debug("[MUT] window=%.0fs ticks=%d tick_avg=%.3fms tick_max=%.3fms adopts=%d adopt_avg=%.3fms props=%d prop_avg=%.3fms silent=%d mutants=%d",
        WINDOW_MS / 1000, _tick_n, _tick_ms / _tick_n, _tick_max,
        _adopt_n, _adopt_n > 0 and _adopt_ms / _adopt_n or 0,
        _prop_n, _prop_n > 0 and _prop_ms / _prop_n or 0, _prop_silent, count)
    _tick_ms, _tick_max, _tick_n = 0, 0, 0
    _adopt_ms, _adopt_n = 0, 0
    _prop_ms, _prop_n, _prop_silent = 0, 0, 0
end

-- A bounded pick in [low, high]; the Wild slider scales the spread - 0 = the band middle, 100 = any point across the band.
local function _select_band(low, high)
    local mid = (low + high) * 0.5
    local wild = (cfg.mut_wild or 0) * 0.01
    if wild <= 0 then return mid end
    return mid + (low + math_random() * (high - low) - mid) * wild
end

-- The Intelligence probability: (base + per-rank * tier) / 100, capped - the act chance of the decision model.
local function _compute_intelligence(rec)
    return math_min((cfg.mut_int_base + cfg.mut_int_rank_pct * rec.tier) / 100, _tun_num.int_cap)
end

-- The one Intelligence roll of a decision; the 6s clock stamps either way (the caller stamps it).
local function _check_intelligence(rec)
    return math_random() < _compute_intelligence(rec)
end

-- The species' MCM toggle for a move (page-keyed); false for a species carrying no page row.
local function _check_toggle(rec, move)
    local keys = rec.species and _move_cfg[rec.species]
    local key = keys and keys[move]
    return key ~= nil and cfg[key] == true
end

-- The page's MCM toggle for an ability vary family (tube, stamina, aura, detection, gravity_numbers, telekinesis); false where no row exists.
local function _check_vary(rec, family)
    local page = rec.page
    return page ~= nil and cfg["mut_" .. page .. "_" .. family] == true
end

-- True when any of the four leap-family variants is toggled on for the species (the family row's eligibility).
local function _check_leap_toggled(rec)
    return _check_toggle(rec, "leap") or _check_toggle(rec, "jump")
        or _check_toggle(rec, "leap_adapt") or _check_toggle(rec, "jump_adapt")
end

-- The adopt-line move list: the species' applicable moves (anatomy, the [moves] envelope).
local function _format_moves(species)
    if not species then return "-" end
    local parts = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        if _move_species[move][species] then parts[#parts + 1] = move end
    end
    if #parts == 0 then return "-" end
    return table_concat(parts, " ")
end

local function _read_num(section, key)
    return xltx.read_num(_tun, section, key)
end

-- The install's own value for one monster LTX key, nil when absent.
local function _read_basis(mob_section, key)
    return ini_sys:r_float_ex(mob_section, key)
end

local function _get_tier()
    local tier = xlevel.get_danger_tier(level.name()) or xlevel.DANGER_TIER_DEFAULT
    if tier < TIER_MIN then return TIER_MIN end
    if tier > TIER_MAX then return TIER_MAX end
    return tier
end

-- Rebuild the per-tier damage and resistance multipliers from the formula sliders.
local function _build_tracks()
    for tier = TIER_MIN, TIER_MAX do
        _tracks.damage[tier] = 1 + (cfg.mut_damage_pct or 0) / 100 * tier
        _tracks.taken[tier] = 1 - (cfg.mut_resist_pct or 0) / 100 * tier
    end
end

-- A basis value under a bounded wild fraction; nil basis skips the family.
local function _compute_offset(basis, pct)
    if not basis then return nil end
    return basis * _select_band(1 - pct, 1 + pct)
end

-- A band pair under ONE shared wild factor, so a narrow band can never invert min over max.
local function _compute_band(min_basis, max_basis, pct)
    if not (min_basis or max_basis) then return nil, nil end
    local factor = _select_band(1 - pct, 1 + pct)
    return min_basis and min_basis * factor or nil, max_basis and max_basis * factor or nil
end

-- A "min, max" tuple string from the install's own section ("4.5, 8.0"), nil when absent.
local function _read_pair(section, key)
    local raw = ini_sys:r_string_ex(section, key)
    if not raw then return nil end
    local first, second = raw:match("([%d%.]+)%s*,%s*([%d%.]+)")
    if not first then return nil end
    return { tonumber(first), tonumber(second) }
end

-- The caps: slots assumed running per bucket; an offensive fire checks then adds, flee adds and is never denied.
local function _check_slot(bucket)
    local cap = bucket == VS_PLAYER and _tun_num.cap_player or _tun_num.cap_npc
    return _slots:get_count(bucket) < cap
end

local function _add_slot(bucket)
    _slots:add(bucket)
end

-- The inside chance: a flavor move still rolls its own execution chance on a seized opening; absent = 1.0 = always.
local function _check_inside_chance(move)
    return at_core.check_chance(_inside_chance[move])
end

-- The charge pacing: the species' own Run_Attack_Delay scaled by Intelligence, never the band geometry.
local function _apply_charge_pacing(mob, rec, section)
    if not _check_vary(rec, "rush") then return end
    local delay = _read_pair(section, "Run_Attack_Delay")
    if not delay then return end
    local skill = _compute_intelligence(rec) / _tun_num.int_cap
    local mult = _tun_num.charge_slow + (_tun_num.charge_fast - _tun_num.charge_slow) * skill
    local min_ms, max_ms = delay[1] * mult, delay[2] * mult
    xmonster.set_monster_rush_params(mob, { min_delay_ms = min_ms, max_delay_ms = max_ms })
    if at_debug.is_on() then
        at_debug.debug("[MUT] pace id=%d charge=%.0f-%.0fms mult=%.2f", rec.id, min_ms, max_ms, mult)
    end
end

-- The leap premise band: the species' own jump distances our commanded leaps read, plus the adapt restore point.
-- Read-only - the engine's jump solve stays vanilla; a missing jump_auto_aim_factor reads as the engine default 0.
local function _apply_leap(_mob, rec, section)
    local jump_max = _read_basis(section, "jump_max_distance")
    if not jump_max then return end
    rec.jump_min_m = _read_basis(section, "jump_min_distance")
    rec.jump_max_m = jump_max
    rec.aim_basis = _read_basis(section, "jump_auto_aim_factor") or 0
end

-- The controller pacing: the psi tube rhythm and the stamina drain, varied over the install's own values.
local function _apply_controller_pacing(mob, rec, section)
    local see_ms, tube_ms, stamina
    local pct = _tun_num.ability_pct
    if _check_vary(rec, "tube") then
        see_ms = _compute_offset(_read_basis(section, "tube_condition_see_duration"), pct)
        tube_ms = _compute_offset(_read_basis(section, "tube_condition_min_delay"), pct)
        if see_ms or tube_ms then
            xmonster.set_controller_tube_params(mob, { see_duration_ms = see_ms, min_delay_ms = tube_ms })
        end
    end
    if _check_vary(rec, "stamina") then
        stamina = _compute_offset(_read_basis(section, "stamina_hit"), pct)
        if stamina then xmonster.set_controller_stamina_hit(mob, stamina) end
    end
    if (see_ms or tube_ms or stamina) and at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d tube=%.0f/%.0fms stamina=%.3f",
            rec.id, see_ms or 0, tube_ms or 0, stamina or 0)
    end
end

-- The poltergeist detection envelope: perception ranges and speeds, a standalone ability, not flight movement.
local function _apply_poltergeist_pacing(mob, rec, section)
    if not _check_vary(rec, "detection") then return end
    local pct = _tun_num.ability_pct
    local near_f = _compute_offset(_read_basis(section, "detection_near_range_factor"), pct)
    local far_f = _compute_offset(_read_basis(section, "detection_far_range_factor"), pct)
    local far_r = _compute_offset(_read_basis(section, "detection_far_range"), pct)
    xmonster.set_poltergeist_detection_params(mob, {
        near_factor = near_f,
        far_factor = far_f,
        far_range = far_r,
        speed_factor = _compute_offset(_read_basis(section, "detection_speed_factor"), pct),
        loose_speed = _compute_offset(_read_basis(section, "detection_loose_speed"), pct),
    })
    if at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d detection=%.2f/%.2f/%.1f", rec.id, near_f or 0, far_f or 0, far_r or 0)
    end
end

-- The species pacing rolls: the cloak dwell, the controller tube and stamina, the poltergeist detection.
local function _apply_pacing(mob, rec, section)
    if rec.moves.cloak and _check_toggle(rec, "cloak") then
        local dwell = _compute_offset(_read_basis(section, "visibility_state_change_min_delay"), _tun_num.ability_pct)
        if dwell then
            xmonster.set_bloodsucker_invisibility_delay(mob, dwell)
            if at_debug.is_on() then at_debug.debug("[MUT] vary id=%d cloak=%.0fms", rec.id, dwell) end
        end
    end
    if rec.species == CONTROLLER then _apply_controller_pacing(mob, rec, section) end
    if rec.species == POLTERGEIST then _apply_poltergeist_pacing(mob, rec, section) end
end

-- The burer gravity numbers and telekinesis families, varied over the install's own values.
local function _apply_burer_params(mob, rec, section)
    if rec.species ~= BURER then return end
    local pct = _tun_num.ability_pct
    if _check_vary(rec, "gravity_numbers") then
        local gravi_min, gravi_max = _compute_band(_read_basis(section, "Gravi_MinDist"),
            _read_basis(section, "Gravi_MaxDist"), pct)
        local cooldown = _compute_offset(_read_basis(section, "Gravi_Cooldown"), pct)
        local speed = _compute_offset(_read_basis(section, "Gravi_Speed"), pct)
        xmonster.set_burer_gravi_params(mob, {
            cooldown_ms = cooldown,
            min_dist = gravi_min, max_dist = gravi_max,
            speed = speed,
            radius = _compute_offset(_read_basis(section, "Gravi_Radius"), pct),
        })
        if at_debug.is_on() then
            at_debug.debug("[MUT] vary id=%d gravi=%.1f-%.1f cd=%.0f speed=%.1f",
                rec.id, gravi_min or 0, gravi_max or 0, cooldown or 0, speed or 0)
        end
    end
    if _check_vary(rec, "telekinesis") then
        local tele_min, tele_max = _compute_band(_read_basis(section, "tele_min_distance"),
            _read_basis(section, "tele_max_distance"), pct)
        local objects = _compute_offset(_read_basis(section, "Tele_Max_Handled_Objects"), pct)
        local count = objects and math_floor(objects + 0.5) or nil
        xmonster.set_burer_telekinesis_params(mob, {
            max_objects = count,
            find_radius = _compute_offset(_read_basis(section, "Tele_Find_Radius"), pct),
            min_dist = tele_min, max_dist = tele_max,
            fly_velocity = _compute_offset(_read_basis(section, "tele_fly_velocity"), pct),
        })
        if at_debug.is_on() then at_debug.debug("[MUT] vary id=%d tele=%.1f-%.1f objects=%d", rec.id, tele_min or 0, tele_max or 0, count or 0) end
    end
end

-- One aura family, strength and reach varied; a species without the keys skips it.
local function _apply_aura(mob, rec, section, name)
    local pct = _tun_num.ability_pct
    local power = _read_basis(section, name .. "_max_power")
    local dist = _read_basis(section, name .. "_max_distance")
    if not (power or dist) then return end
    local varied_power = _compute_offset(power, pct)
    local varied_dist = _compute_offset(dist, pct)
    xmonster.set_monster_aura_params(mob, name, {
        max_power = varied_power,
        max_distance = varied_dist,
    })
    if at_debug.is_on() then
        at_debug.debug("[MUT] vary id=%d aura=%s power=%.3f dist=%.1f",
            rec.id, name, varied_power or 0, varied_dist or 0)
    end
end

-- Every aura the species carries, behind the page's Aura row.
local function _apply_auras(mob, rec, section)
    if not _check_vary(rec, "aura") then return end
    for i = 1, #AURA_NAMES do
        _apply_aura(mob, rec, section, AURA_NAMES[i])
    end
end

-- The rear spin-strike arms once at adoption on an Intelligence roll; the engine self-fires it after.
local function _try_arm_backstrike(mob, rec)
    local motions = rec.moves.backstrike and _check_toggle(rec, "backstrike")
        and _backstrike_motions[rec.species] or nil
    if not motions or not _check_intelligence(rec) then return end
    xmonster.set_monster_melee_strike(mob, motions[1], motions[2], _tun_num.backstrike_arc)
    if at_debug.is_on() then
        at_debug.debug("[MUT] arm id=%d backstrike arc=%.0f gate=int,wild", rec.id, _tun_num.backstrike_arc)
    end
end

local function _add_mutant(mob, id, now)
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local tier = _get_tier()
    local species = xcreature.get_mutant_species(id)
    local page = species and _pages[species] or nil
    local moves = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        moves[move] = species ~= nil and _move_species[move][species] == true
    end
    local rec = {
        id = id,
        species = species,
        page = page,
        tier = tier,
        quadruped = species ~= nil and _quadrupeds[species] == true,
        next_ms = 0,
        seen_ms = now,
        tick_now = now,
        driver = "-",
        moves = moves,
        memo = {},
        decided_at = 0,
        flee_ok_at = 0,
        flee_until = 0,
        retreat_ok_at = 0,
        retreat_until = 0,
        claw_until = 0,
        claw_motion = species and moves.claw and _claw_motion or nil,
        low_now = false,
    }
    _states[id] = rec
    local section = mob:section()
    _apply_leap(mob, rec, section)
    _apply_charge_pacing(mob, rec, section)
    _apply_pacing(mob, rec, section)
    _apply_burer_params(mob, rec, section)
    _apply_auras(mob, rec, section)
    _try_arm_backstrike(mob, rec)
    tmr:stop()
    if dbg then
        local ms = tmr:get_ms()
        _adopt_n = _adopt_n + 1
        _adopt_ms = _adopt_ms + ms
        at_debug.debug("[MUT] adopt id=%s species=%s tier=%d moves=%s [%.3fms]",
            id, tostring(species), tier, _format_moves(species), ms)
    end
    return rec
end

local function _remove_stale(now)
    if now < _next_sweep then return end
    _next_sweep = now + SWEEP_MS
    local found = 0
    for id, rec in pairs(_states) do
        if now - rec.seen_ms > STALE_MS then
            found = found + 1
            _stale_ids[found] = id
        end
    end
    for i = 1, found do
        _states[_stale_ids[i]] = nil
        _stale_ids[i] = nil
    end
end

-- The enemy's can't-answer read; the actor's is computed once per beat window and shared by every mutant.
local function _check_enemy_vulnerable(enemy, is_actor, now)
    if not is_actor then return at_core.is_enemy_vulnerable(enemy) == true end
    if now >= _actor_vuln_at then
        _actor_vuln_at = now + BEAT_MS
        _actor_vuln = at_core.is_enemy_vulnerable(enemy) == true
    end
    return _actor_vuln
end

-- The one-animation-owner clear: the claw override stops at its window's end, when any jump takes the body, or on a fire-path order.
local function _clear_claw(mob, rec, now, forced)
    if rec.claw_until <= 0 then return end
    local jumping = xmonster.is_monster_jumping(mob)
    if not forced and now < rec.claw_until and not jumping then return end
    xmonster.stop_monster_animation(mob)
    rec.claw_until = 0
    if jumping and at_debug.is_on() then
        at_debug.debug("[MUT] CLAW id=%d cleared cause=jump", rec.id)
    end
end

-- The per-beat motion sample: the lateral-displacement read (enemy strafing), the adapt-steering premise.
local function _update_samples(rec, enemy_pos, mob_pos)
    local px, pz = rec.enemy_px, rec.enemy_pz
    rec.enemy_px, rec.enemy_pz = enemy_pos.x, enemy_pos.z
    rec.strafing = false
    if not px then return end
    local dx, dz = enemy_pos.x - px, enemy_pos.z - pz
    local ax, az = enemy_pos.x - mob_pos.x, enemy_pos.z - mob_pos.z
    local alen = math_sqrt(ax * ax + az * az)
    if alen < 1 then return end
    local along = (dx * ax + dz * az) / alen
    rec.strafing = dx * dx + dz * dz - along * along > _tun_num.strafe_lat_sqr
end

-- The held-aim timer over per-beat xcombat.is_aim_held samples; gravity carriers only (the one raycast payer).
local function _update_aim_sample(mob, rec, enemy, dist_sqr, now)
    if not rec.moves.gravity_attack then return end
    if dist_sqr > _tun_num.stare_range_sqr or not xcombat.is_aim_held(enemy, mob, _tun_num.stare_cone) then
        rec.aim_since = nil
        return
    end
    rec.aim_since = rec.aim_since or now
end

-- The weapon half of the per-beat fight scratch; the caller pre-writes the geometry, dry skips the reads - the 100-mutant guard.
local function _reset_memo(rec)
    local memo = rec.memo
    local kind = not memo.dry and xcombat.get_weapon_kind(memo.enemy, memo.is_actor) or nil
    local band = kind and xcombat.get_range_band(memo.dist, kind) or nil
    local aimed = kind ~= nil and xcombat.is_facing(memo.enemy, memo.mob_pos, _tun_num.threat_cone)
    local shotgun_near = kind == SHOTGUN_KIND and band == BAND_IN
    local shotgun_aimed = shotgun_near and aimed
    if at_debug.is_on() then
        if shotgun_aimed and not memo.shotgun_aimed then
            at_debug.debug("[MUT] THREAT id=%d shotgun aimed d=%.1f", rec.id, memo.dist)
        elseif memo.shotgun_aimed and not shotgun_aimed then
            at_debug.debug("[MUT] THREAT id=%d shotgun clear", rec.id)
        end
    end
    memo.kind = kind
    memo.band = band
    memo.aimed = aimed
    memo.shotgun_near = shotgun_near
    memo.shotgun_aimed = shotgun_aimed
    memo.shotgun_open = shotgun_near and not aimed
end

-- The premise vocabulary: each a named boolean read over the memo, the samples, and the processed snapshots.
local PREMISES = {
    vulnerable = function(_mob, rec, now)
        local memo = rec.memo
        return _check_enemy_vulnerable(memo.enemy, memo.is_actor, now)
    end,
    shotgun_open = function(_mob, rec, _now)
        return rec.memo.shotgun_open == true
    end,
    enemy_above = function(mob, rec, _now)
        return xcombat.is_enemy_above(rec.memo.enemy, mob, _tun_num.above_m)
    end,
    aim_held = function(_mob, rec, now)
        return rec.aim_since ~= nil and now - rec.aim_since >= _tun_num.aim_held_ms
    end,
    unreachable = function(mob, rec, _now)
        local memo = rec.memo
        if not memo.is_actor then return false end
        if memo.dist > _tun_num.retreat_max_m then return false end
        return xcombat.is_enemy_above(memo.enemy, mob, _tun_num.above_m)
    end,
    low_health = function(mob, rec, _now)
        if not rec.low_now then return false end
        if rec.memo.dist < _tun_num.flee_min_m then return false end
        return not xcombat.is_facing(mob, rec.memo.enemy_pos, _tun_num.flee_face_cone)
    end,
    contact = function(mob, rec, _now)
        local memo = rec.memo
        if memo.dist > _tun_num.claw_range then return false end
        return xcombat.is_facing(mob, memo.enemy_pos, _tun_num.claw_cone)
    end,
}

local function _log_block(rec, move, cause)
    if at_debug.is_on() then
        at_debug.debug("[MUT] BLOCK id=%d move=%s cause=%s gate=int,wild", rec.id, move, cause)
    end
end

local function _log_fire(rec, move, detail)
    rec.driver = move:gsub("_", " "):upper()
    rec.gate = GATE_BOTH
    rec.fired_at = rec.tick_now
    if at_debug.is_on() then
        at_debug.debug("[MUT] FIRE id=%d move=%s d=%.1f%s gate=int,wild",
            rec.id, move, rec.memo.dist, detail or "")
    end
end

-- The 2x2 split: watching decides the wind-up (Leap keeps it, Jump drops it), strafing decides the steering (adapt).
local function _resolve_leap_variant(mob, rec)
    local memo = rec.memo
    local watching = xcombat.is_enemy_watching(memo.enemy, mob, _tun_num.threat_cone)
    local steered = rec.strafing and rec.aim_basis ~= nil
    if watching and steered and _check_toggle(rec, MOVE_JUMP_ADAPT) then return MOVE_JUMP_ADAPT end
    if watching and _check_toggle(rec, MOVE_JUMP) then return MOVE_JUMP end
    if steered and _check_toggle(rec, MOVE_LEAP_ADAPT) then return MOVE_LEAP_ADAPT end
    if _check_toggle(rec, LEAP_FAMILY) then return LEAP_FAMILY end
    if _check_toggle(rec, MOVE_JUMP) then return MOVE_JUMP end
    if rec.aim_basis and _check_toggle(rec, MOVE_JUMP_ADAPT) then return MOVE_JUMP_ADAPT end
    if rec.aim_basis and _check_toggle(rec, MOVE_LEAP_ADAPT) then return MOVE_LEAP_ADAPT end
    return nil
end

-- One commanded leap: the mechanical gates, the caps, the override clear, the variant's flags, the landing-deferred gain restore.
local function _execute_leap(mob, rec, move, now)
    local memo = rec.memo
    if memo.shotgun_aimed then return _log_block(rec, move, "shotgun") end
    if rec.quadruped and not xcombat.is_enemy_above(memo.enemy, mob, _tun_num.above_m) then
        return _log_block(rec, move, "flat")
    end
    if not rec.jump_max_m or memo.dist > rec.jump_max_m or memo.dist < (rec.jump_min_m or 0) then
        return _log_block(rec, move, "band")
    end
    if not xcombat.is_facing(mob, memo.enemy_pos, _tun_num.leap_cone) then return _log_block(rec, move, "facing") end
    if xmonster.is_monster_jumping(mob) then return _log_block(rec, move, "air") end
    local variant = _resolve_leap_variant(mob, rec)
    if variant == nil then return _log_block(rec, move, "toggle") end
    local steered = variant == MOVE_LEAP_ADAPT or variant == MOVE_JUMP_ADAPT
    if steered and not rec.aim_basis then return _log_block(rec, variant, "basis") end
    if not _check_slot(memo.bucket) then return _log_block(rec, variant, "caps") end
    _clear_claw(mob, rec, now, true)
    local aim = nil
    if steered then
        aim = _select_band(_tun_num.adapt_min, _tun_num.adapt_max)
        xmonster.set_monster_jump_flags(mob, { auto_aim = true, auto_aim_factor = aim })
    end
    local sudden = variant == MOVE_JUMP or variant == MOVE_JUMP_ADAPT
    local fired = xmonster.try_monster_jump(mob, memo.enemy_pos, 1, { skip_prepare = sudden })
    if aim then
        rec.aim_restore = fired or nil
        xmonster.set_monster_jump_flags(mob, fired and {} or { auto_aim_factor = rec.aim_basis })
    end
    if not fired then return _log_block(rec, variant, "refused") end
    _add_slot(memo.bucket)
    _log_fire(rec, variant, aim and (" aim=%.2f"):format(aim) or nil)
end

local function _execute_gravity(mob, rec, move, now)
    local memo = rec.memo
    if memo.dist_sqr > _tun_num.stare_range_sqr then return _log_block(rec, move, "band") end
    if not _check_slot(memo.bucket) then return _log_block(rec, move, "caps") end
    if not xmonster.set_burer_gravi_force(mob, true) then return _log_block(rec, move, "refused") end
    rec.gravity_release = now + _tun_num.gravity_release
    rec.aim_since = nil
    _add_slot(memo.bucket)
    _log_fire(rec, move)
end

-- The flee window: the inside chance can decline it (flavor), but the caps never do; one trigger, the survival crossing out of melee reach.
local function _execute_flee(_mob, rec, move, now)
    if not _check_inside_chance(move) then return _log_block(rec, move, "chance") end
    local hold = _select_band(_tun_num.survival_hold_min, _tun_num.survival_hold_max)
    rec.flee_until = now + hold
    rec.flee_ok_at = now + _tun_num.flee_throttle_ms
    _add_slot(rec.memo.bucket)
    _log_fire(rec, move, (" hold=%dms"):format(hold))
end

-- The retreat window: the flee mechanism on tactical premises - a short committed yield, capped like any offensive move.
local function _execute_retreat(_mob, rec, move, now)
    if not _check_slot(rec.memo.bucket) then return _log_block(rec, move, "caps") end
    local hold = _select_band(_tun_num.retreat_hold_min, _tun_num.retreat_hold_max)
    rec.retreat_until = now + hold
    rec.retreat_ok_at = now + _tun_num.retreat_throttle_ms
    _add_slot(rec.memo.bucket)
    _log_fire(rec, move, (" hold=%dms"):format(hold))
end

-- The chimera-class contact strike; one animation owner, outside the caps, cleared by its window or any jump.
local function _execute_claw(mob, rec, move, now)
    local memo = rec.memo
    if not rec.claw_motion then return _log_block(rec, move, "motion") end
    if memo.dist > _tun_num.claw_range then return _log_block(rec, move, "range") end
    if not xcombat.is_facing(mob, memo.enemy_pos, _tun_num.claw_cone) then return _log_block(rec, move, "facing") end
    if xmonster.is_monster_jumping(mob) then return _log_block(rec, move, "air") end
    if rec.claw_until > 0 then return _log_block(rec, move, "window") end
    if not xmonster.play_monster_animation(mob, rec.claw_motion) then return _log_block(rec, move, "refused") end
    rec.claw_until = now + _tun_num.claw_clear
    _log_fire(rec, move)
end

local MOVE_EXEC = {
    leap = _execute_leap, jump = _execute_leap, leap_adapt = _execute_leap, jump_adapt = _execute_leap,
    gravity_attack = _execute_gravity, flee = _execute_flee, retreat = _execute_retreat, claw = _execute_claw,
}

-- A best row is eligible when the species carries the toggled move, the body plan admits it, and the caps/clocks allow it.
local function _check_row(mob, rec, row, now)
    local move = row.move
    if not rec.moves[move] then return false end
    if row.bipeds and rec.quadruped then return false end
    if row.nojump and rec.moves.leap then return false end
    if move == MOVE_FLEE and (not _runaway_id or now < rec.flee_ok_at) then return false end
    if move == MOVE_RETREAT and (not _runaway_id or now < rec.retreat_ok_at) then return false end
    if CAPPED[move] and rec.memo.dry then return false end
    if move == LEAP_FAMILY then
        if not _check_leap_toggled(rec) then return false end
    elseif not _check_toggle(rec, move) then
        return false
    end
    return PREMISES[row.premise](mob, rec, now) == true
end

local function _find_row(mob, rec, now)
    for i = 1, #BEST_MOVES do
        local row = BEST_MOVES[i]
        if _check_row(mob, rec, row, now) then return row end
    end
    return nil
end

-- The decision: one true premise takes ONE Intelligence roll; the 6s clock stamps either way; a miss does nothing.
local function _run_decision(mob, rec, now)
    local row = _find_row(mob, rec, now)
    if not row then return end
    rec.decided_at = now
    if _check_intelligence(rec) then
        MOVE_EXEC[row.move](mob, rec, row.move, now, row.premise)
        return
    end
    if at_debug.is_on() then
        local best = row.move
        if best == LEAP_FAMILY then best = _resolve_leap_variant(mob, rec) or LEAP_FAMILY end
        at_debug.debug("[MUT] PASS id=%d premise=%s best=%s", rec.id, row.premise, best)
    end
end

-- The no-enemy reset: release what the fight held and drop the per-engagement state.
local function _reset_fight(mob, rec)
    if rec.claw_until > 0 then
        xmonster.stop_monster_animation(mob)
        rec.claw_until = 0
    end
    rec.driver = "-"
    rec.gate = nil
    rec.aim_since = nil
    rec.enemy_px, rec.enemy_pz = nil, nil
    rec.strafing = false
end

-- The one 600ms lane: upkeep every beat, samples every beat, the decision behind the flat 6s clock.
local function _update_mutant(mob, rec, now)
    rec.tick_now = now
    rec.seen_ms = now
    if rec.gravity_release and now >= rec.gravity_release then
        xmonster.set_burer_gravi_force(mob, false)
        rec.gravity_release = nil
    end
    if rec.aim_restore and not xmonster.is_monster_jumping(mob) then
        xmonster.set_monster_jump_flags(mob, { auto_aim_factor = rec.aim_basis })
        rec.aim_restore = nil
    end
    _clear_claw(mob, rec, now, false)
    local enemy = xmonster.get_monster_enemy(mob)
    if not enemy or not enemy:alive() then
        _reset_fight(mob, rec)
        return
    end
    local enemy_pos = enemy:position()
    local mob_pos = mob:position()
    local dist_sqr = mob_pos:distance_to_sqr(enemy_pos)
    local dist = math_sqrt(dist_sqr)
    _update_samples(rec, enemy_pos, mob_pos)
    _update_aim_sample(mob, rec, enemy, dist_sqr, now)
    if rec.flee_until > now or rec.retreat_until > now then return end
    if now - rec.decided_at < _tun_num.throttle_ms then return end
    local is_actor = enemy:id() == AC_ID
    local memo = rec.memo
    memo.enemy = enemy
    memo.enemy_pos = enemy_pos
    memo.mob_pos = mob_pos
    memo.dist = dist
    memo.dist_sqr = dist_sqr
    memo.is_actor = is_actor
    memo.bucket = is_actor and VS_PLAYER or VS_NPC
    memo.dry = not _check_slot(memo.bucket)
    _reset_memo(rec)
    rec.low_now = xmonster.get_monster_health(mob) <= _tun_num.survival_frac
    _run_decision(mob, rec, now)
end

local function _on_mob_update(mob)
    if not _active then return end
    if not (mob and mob:alive()) then return end
    local now = time_global()
    local id = mob:id()
    local rec = _states[id]
    if rec and now < rec.next_ms then return end
    if _seams == nil then
        _seams = xmonster.get_monster_state(mob) ~= nil
        if not _seams then
            at_debug.warn("at_mutants INACTIVE: the monster seam set is absent on this exe")
            _apply_enabled()
            return
        end
    end
    if not rec then rec = _add_mutant(mob, id, now) end
    rec.next_ms = now + BEAT_MS
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    _update_mutant(mob, rec, now)
    _remove_stale(now)
    timer:stop()
    if at_debug.is_on() then _log_tick(timer:get_ms(), now) end
end

-- Re-propose eStateAttack_RunAway while a flee or retreat window holds; the silent path stays pure Lua.
local function _on_combat_action(monster, _enemy, _dist, _enemy_strength, _can_jump, flags)
    local rec = _states[monster:id()]
    if not rec or (rec.flee_until <= rec.tick_now and rec.retreat_until <= rec.tick_now) then
        if at_debug.is_on() then _prop_silent = _prop_silent + 1 end
        return
    end
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    flags.substate = _runaway_id
    tmr:stop()
    if dbg then
        _prop_n = _prop_n + 1
        _prop_ms = _prop_ms + tmr:get_ms()
    end
end

-- Scale what an adopted mutant deals; shared by the three victim seams. A 1.0 track skips the engine write.
local function _apply_dealt(shit)
    if next(_states) == nil or not shit then return end
    local attacker = shit.draftsman
    if not attacker then return end
    local rec = _states[attacker:id()]
    if not rec then return end
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local dealt = _tracks.damage[rec.tier]
    if dealt ~= 1 then xcombat.apply_hit_power(shit, dealt) end
    tmr:stop()
    if dbg then
        at_debug.debug("[MUT] dealt id=%d mult=%.2f power=%.3f [%.3fms]", rec.id, dealt, shit.power, tmr:get_ms())
    end
end

local function _on_npc_before_hit(_npc, shit, _bone_id)
    _apply_dealt(shit)
end

-- Scale what an adopted mutant takes; monster-vs-monster dealt scaling routes through the same seam.
local function _on_monster_before_hit(mob, shit, _bone_id)
    if next(_states) == nil or not shit then return end
    _apply_dealt(shit)
    local rec = _states[mob:id()]
    if not rec then return end
    local dbg = at_debug.is_on()
    local tmr = xprofiler.new_if(dbg):start()
    local taken = _tracks.taken[rec.tier]
    if taken ~= 1 then xcombat.apply_hit_power(shit, taken) end
    tmr:stop()
    if dbg then
        at_debug.debug("[MUT] taken id=%d mult=%.2f power=%.3f [%.3fms]", rec.id, taken, shit.power, tmr:get_ms())
    end
end

-- Drop the record on server-entity unregister; freed ids are pooled.
local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _states[se_obj.id] = nil
end

-- Release what a dropped record pushed and still owns live: the animation override, a pending gravity force or gain restore.
-- Pushed params revert on the next spawn (not serialized).
local function _release_mutant(rec)
    local mob = xobject.get_go(rec.id)
    if not mob then return end
    if rec.claw_until > 0 then xmonster.stop_monster_animation(mob) end
    if rec.gravity_release then xmonster.set_burer_gravi_force(mob, false) end
    if rec.aim_restore then xmonster.set_monster_jump_flags(mob, { auto_aim_factor = rec.aim_basis }) end
end

-- Any nonzero stat slider, any species move toggle, or any vary row keeps the module live.
local function _check_wanted()
    if _seams == false then return false end
    if (cfg.mut_damage_pct or 0) > 0 or (cfg.mut_resist_pct or 0) > 0 then
        return true
    end
    for i = 1, #_all_toggle_keys do
        if cfg[_all_toggle_keys[i]] == true then return true end
    end
    return false
end

_apply_enabled = function()
    local wanted = _check_wanted()
    if wanted == _active then return end
    _active = wanted
    if _active then
        RegisterScriptCallback("monster_on_update", _on_mob_update)
        RegisterScriptCallback("actor_on_before_hit", _apply_dealt)
        RegisterScriptCallback("npc_on_before_hit", _on_npc_before_hit)
        RegisterScriptCallback("monster_on_before_hit", _on_monster_before_hit)
        xmonster.on_monster_combat_action(_on_combat_action)
    else
        UnregisterScriptCallback("monster_on_update", _on_mob_update)
        UnregisterScriptCallback("actor_on_before_hit", _apply_dealt)
        UnregisterScriptCallback("npc_on_before_hit", _on_npc_before_hit)
        UnregisterScriptCallback("monster_on_before_hit", _on_monster_before_hit)
        UnregisterScriptCallback("monster_on_combat_action", _on_combat_action)
        for _, rec in pairs(_states) do _release_mutant(rec) end
        _states = {}
    end
end

-- One species' move-toggle keys (mut_<page>_<move>), each new key collected into the global list once.
local function _build_species_keys(species, page, seen_keys)
    local keys = {}
    for k = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[k]
        local key = _move_species[move][species] and ("mut_" .. page .. "_" .. move) or nil
        if key then
            keys[move] = key
        end
        if key and not seen_keys[key] then
            seen_keys[key] = true
            _all_toggle_keys[#_all_toggle_keys + 1] = key
        end
    end
    return keys
end

-- The ability vary-row keys; Wild varies standalone ability numbers only, never a locomotion or attack solver input.
local VARY_KEYS = {
    "mut_controller_tube", "mut_controller_stamina", "mut_controller_aura",
    "mut_poltergeist_detection",
    "mut_burer_gravity_numbers", "mut_burer_telekinesis",
}

-- The charge-pacing row keys (Rush, Intelligence-driven); the Run_Attack_Delay basis gates species without the charge.
local CHARGE_KEYS = {
    "mut_bloodsucker_rush", "mut_boar_rush", "mut_gigant_rush",
}

local function _load_tunables()
    _tun = xltx.resolve_handle(LTX_PATH)
    _tun_num = {
        throttle_ms = (_read_num("throttle", "default") or 6) * 1000,
        flee_throttle_ms = (_read_num("throttle", "flee") or 60) * 1000,
        retreat_throttle_ms = (_read_num("throttle", "retreat") or 20) * 1000,
        cap_player = _read_num("caps", "vs_player"),
        cap_npc = _read_num("caps", "vs_npc"),
        int_cap = _read_num("intelligence", "cap"),
        aim_held_ms = (_read_num("premises", "aim_held_s") or 3) * 1000,
        above_m = _read_num("premises", "above_m"),
        strafe_lat_sqr = (_read_num("premises", "strafe_lat_m") or 1) ^ 2,
        flee_min_m = _read_num("survival", "min_dist_m"),
        flee_face_cone = _read_num("survival", "face_cone_deg"),
        survival_frac = _read_num("survival", "health_frac"),
        survival_hold_min = _read_num("survival", "hold_min"),
        survival_hold_max = _read_num("survival", "hold_max"),
        retreat_hold_min = _read_num("retreat", "hold_min"),
        retreat_hold_max = _read_num("retreat", "hold_max"),
        retreat_max_m = _read_num("retreat", "max_dist_m"),
        threat_cone = _read_num("threat", "facing_cone_deg"),
        leap_cone = _read_num("leap", "facing_cone_deg"),
        adapt_min = _read_num("adapt", "factor_min"), adapt_max = _read_num("adapt", "factor_max"),
        charge_slow = _read_num("charge", "slow_mult"), charge_fast = _read_num("charge", "fast_mult"),
        stare_range_sqr = (_read_num("gravity_attack", "range_m") or 0) ^ 2,
        stare_cone = _read_num("gravity_attack", "cone_deg"),
        gravity_release = _read_num("gravity_attack", "release_ms"),
        claw_range = _read_num("claw", "range_m"),
        claw_cone = _read_num("claw", "facing_cone_deg"),
        claw_clear = _read_num("claw", "clear_ms"),
        backstrike_arc = _read_num("backstrike", "arc_deg"),
        ability_pct = _read_num("wild", "ability_pct"),
    }
    _slots = xttltable.create_ttl_counter({ ttl = _read_num("caps", "slot_s") or 3 })
    _move_species = {}
    for i = 1, #MOVE_KEYS do
        local move = MOVE_KEYS[i]
        local set = {}
        local list = xltx.read_list(_tun, "moves", move)
        for k = 1, #list do set[list[k]] = true end
        _move_species[move] = set
    end
    _inside_chance = {}
    for i = 1, #MOVE_KEYS do
        _inside_chance[MOVE_KEYS[i]] = _read_num("inside_chance", MOVE_KEYS[i]) or 1
    end
    _quadrupeds = {}
    local quad_list = xltx.read_list(_tun, "quadrupeds", "species")
    for k = 1, #quad_list do _quadrupeds[quad_list[k]] = true end
    _move_cfg = {}
    _all_toggle_keys = {}
    local seen_keys = {}
    _pages = xltx.read_section(_tun, "pages")
    for species, page in pairs(_pages) do
        _move_cfg[species] = _build_species_keys(species, page, seen_keys)
    end
    for i = 1, #VARY_KEYS do _all_toggle_keys[#_all_toggle_keys + 1] = VARY_KEYS[i] end
    for i = 1, #CHARGE_KEYS do _all_toggle_keys[#_all_toggle_keys + 1] = CHARGE_KEYS[i] end
    _claw_motion = xltx.read_str(_tun, "claw", "motion")
    _backstrike_motions = {}
    local backstrike_list = xltx.read_list(_tun, "moves", "backstrike")
    for i = 1, #backstrike_list do
        local species = backstrike_list[i]
        local pair = xltx.read_list(_tun, "backstrike", species)
        if #pair >= 2 then _backstrike_motions[species] = pair end
    end
end

local function _on_option_change()
    _build_tracks()
    _apply_enabled()
end

local function _on_first_update()
    _runaway_id = rawget(_G, "monster_state") and monster_state.eStateAttack_RunAway or nil
    _build_tracks()
    _apply_enabled()
end

--- The per-mutant record for one id (the HUD read: moves, windows, the decision clock), nil when not adopted.
function get_mutant_record(id)
    return _states[id]
end

--- The driver label for one adopted mutant ("CLAW"/"JUMP"/"LEAP ADAPT"/"RUSH"/.../"-"), nil when not adopted.
--- The record's .gate ("int, wild") names what influenced the fired move; the HUD appends it.
function get_driver(id)
    local rec = _states[id]
    return rec and rec.driver or nil
end

function on_game_start()
    _load_tunables()
    RegisterScriptCallback("actor_on_first_update", _on_first_update)
    RegisterScriptCallback("on_option_change", _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
end

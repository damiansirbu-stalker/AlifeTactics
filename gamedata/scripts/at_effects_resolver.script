--- at_effects_resolver: highest-wins resolver and engine writes for the multi-source combat effects

local tostring, IsStalker = tostring, IsStalker
local RegisterScriptCallback, ini_file = RegisterScriptCallback, ini_file
local xcombat, xprofiler, at_debug, xcreature = xcombat, xprofiler, at_debug, xcreature

--- The multi-source effects; a single-source value stays in its owning module and never enters resolve
EFFECT = {
    DAMAGE_DEALT    = "damage_dealt",
    DAMAGE_RESIST   = "damage_resist",
    SHOT_DISPERSION = "shot_dispersion",
    VISION_RANGE    = "vision_range",
    AURA            = "aura",
}

local _REDUCE = {
    [EFFECT.DAMAGE_RESIST]   = true,
    [EFFECT.SHOT_DISPERSION] = true,
}

local _BOOL = {
    [EFFECT.AURA] = true,
}

local AURA_BONES = { "bip01_spine", "bip01_pelvis", "bip01_head", "link" }
local GEAR_LTX = "alifetactics\\at_gear_config.ltx"
local GEAR_SECTION = "at_gear"

local _providers = {}
local _aura = ""
local _aura_bone = ""
local _emitting = {}

local function _load_config()
    local ini = ini_file(GEAR_LTX)
    if not (ini and ini:section_exist(GEAR_SECTION)) then return end
    _aura = ini:r_string_ex(GEAR_SECTION, "aura") or ""
    _aura_bone = ini:r_string_ex(GEAR_SECTION, "aura_bone") or ""
end

local function _find_aura_bone(obj, bones)
    for i = 1, #bones do
        if xcreature.start_particle(obj, _aura, bones[i]) then return bones[i] end
    end
    return nil
end

local function _start_aura(id, obj)
    if _aura == "" or _emitting[id] then return end
    if not obj:alive() then return end
    local bone = xcreature.start_particle(obj, _aura, _aura_bone) and _aura_bone or _find_aura_bone(obj, AURA_BONES)
    if not bone then return end
    _emitting[id] = bone
    if at_debug.is_on() then at_debug.debug("[EFF] aura id=%d particle=%s bone=%s", id, _aura, bone) end
end

local function _apply_aura(npc)
    if resolve(npc, EFFECT.AURA) then _start_aura(npc:id(), npc) end
end

local function _apply_binds(npc)
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local vrange = resolve(npc, EFFECT.VISION_RANGE)
    xcombat.set_view_distance_factor(npc, vrange or 1.0)
    _apply_aura(npc)
    timer:stop()
    if at_debug.is_on() then
        at_debug.debug("[EFF] spawn id=%d vrange=%s aura=%s [%.3fms]",
            npc:id(), tostring(vrange), _emitting[npc:id()] and "on" or "off", timer:get_ms())
    end
end

local function _on_net_spawn(npc, _se_obj)
    if not npc then return end
    _emitting[npc:id()] = nil
    _apply_binds(npc)
end

local function _on_npc_before_hit(npc, shit, _bone_id, _flags)
    if not (npc and shit) then return end
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local before = shit.power
    xcombat.apply_hit_power(shit, resolve(npc, EFFECT.DAMAGE_RESIST))
    local attacker = shit.draftsman
    if attacker and IsStalker(attacker) then
        xcombat.apply_hit_power(shit, resolve(attacker, EFFECT.DAMAGE_DEALT))
    end
    timer:stop()
    if at_debug.is_on() and before ~= shit.power then
        at_debug.debug("[EFF] hit victim=%d attacker=%s power=%.3f->%.3f [%.3fms]",
            npc:id(), attacker and attacker:id() or "none", before, shit.power, timer:get_ms())
    end
end

local function _on_actor_before_hit(shit, _bone_id, _flags)
    if not shit then return end
    local attacker = shit.draftsman
    if not (attacker and IsStalker(attacker)) then return end
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local before = shit.power
    xcombat.apply_hit_power(shit, resolve(attacker, EFFECT.DAMAGE_DEALT))
    timer:stop()
    if at_debug.is_on() and before ~= shit.power then
        at_debug.debug("[EFF] hit victim=actor attacker=%d power=%.3f->%.3f [%.3fms]",
            attacker:id(), before, shit.power, timer:get_ms())
    end
end

local function _on_shot_dispersion(obj, _wpn, _body_state, _move_type, temp_disp)
    if not (obj and temp_disp) then return end
    local factor = resolve(obj, EFFECT.SHOT_DISPERSION)
    if not factor then return end
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local before = temp_disp.dispersion
    xcombat.apply_dispersion(temp_disp, factor)
    timer:stop()
    if at_debug.is_on() then
        at_debug.debug("[EFF] disp id=%d factor=%.3f cone=%.5f->%.5f [%.3fms]",
            obj:id(), factor, before or -1, temp_disp.dispersion or -1, timer:get_ms())
    end
end

local function _on_death(victim, _who)
    if victim then _emitting[victim:id()] = nil end
end

local function _on_entity_unregister(se_obj)
    if se_obj then _emitting[se_obj.id] = nil end
end

local function _on_first_update()
    at_debug.update_config()
    at_debug.info("Effects resolver initialized (aura=%s)", _aura ~= "" and _aura or "none")
end

--- Register a provider (fn(npc) -> value|nil) against an effect; resolve keeps the strongest, order free.
function register(effect, fn)
    local list = _providers[effect]
    if not list then
        list = {}
        _providers[effect] = list
    end
    list[#list + 1] = fn
end

--- Resolve an effect for one NPC: the strongest contribution across providers, or nil when none contributes.
function resolve(npc, effect)
    local list = _providers[effect]
    if not list then return nil end
    if _BOOL[effect] then
        for i = 1, #list do
            if list[i](npc) then return true end
        end
        return nil
    end
    local reduce = _REDUCE[effect]
    local best
    for i = 1, #list do
        local v = list[i](npc)
        if v and (best == nil or (reduce and v < best) or (not reduce and v > best)) then
            best = v
        end
    end
    return best
end

--- Re-apply the spawn-bound effects (VISION_RANGE, aura) for one NPC after a source invalidated its cache.
function apply_binds(npc)
    if not (npc and npc:alive()) then return end
    _apply_binds(npc)
end

function on_game_start()
    _emitting = {}
    _load_config()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_before_hit",           _on_npc_before_hit)
    RegisterScriptCallback("actor_on_before_hit",         _on_actor_before_hit)
    RegisterScriptCallback("npc_shot_dispersion",         _on_shot_dispersion)
    RegisterScriptCallback("npc_on_death_callback",       _on_death)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
end

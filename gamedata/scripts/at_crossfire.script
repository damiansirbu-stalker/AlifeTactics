--- at_crossfire: Same-faction friendly-fire damage block, keyed on per-NPC relation

local IsStalker, RegisterScriptCallback, AC_ID = IsStalker, RegisterScriptCallback, AC_ID

local cfg = at_mcm.cfg

-- Friendly-fire damage gate. Suppress damage unless the shooter and victim are actually enemies
-- (npc:relation == game_object.enemy). relation() sums the community-to-community base (+/-2000, the dominant
-- term) with personal/reputation/rank goodwill, so faction is paramount: same-faction NPCs (loner vs loner)
-- are neutral at worst and never enemy, so they stay protected; a cross-faction pair (a loner vs a soured
-- Clear Sky) damages each other only once their relation has actually gone hostile. Friend and neutral are
-- both suppressed. Runs on every hit, no throttle: a damage block must catch each hit, O(1) (one luabind).
-- Never touches actor-dealt damage.
local function _on_before_hit(npc, shit, _bone_id, _flags)
    if not cfg.crossfire_enabled then return end
    if not (npc and shit) then return end
    local attacker = shit.draftsman
    if not attacker then return end
    local attacker_id = attacker:id()
    if attacker_id == AC_ID then return end
    if attacker_id == npc:id() then return end
    if not (IsStalker(attacker) and IsStalker(npc)) then return end
    if xcreature.community(npc) == "zombied" then return end
    local tmr = xprofiler.new_if(at_debug.on()):start()
    if xcreature.is_enemy(attacker, npc) then tmr:stop() return end
    local before = shit.power
    shit.power = before * cfg.crossfire_factor
    tmr:stop()
    if at_debug.on() and before > 0 then
        at_debug.dbg("[CROSSFIRE] blocked attacker=%d victim=%d power=%.3f->%.3f [%dus]",
            attacker:id(), npc:id(), before, shit.power, tmr:get_us())
    end
end

function on_game_start()
    RegisterScriptCallback("npc_on_before_hit", _on_before_hit)
end

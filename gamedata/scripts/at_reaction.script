--- at_reaction: Per-NPC rank-aware tracking tightness, target lead, and vision speed via the engine binds

local RegisterScriptCallback = RegisterScriptCallback

local log = xlog.get_logger("AT.RCT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- Engine consumption (per-NPC fields, PR #594): min_speed is the sight's fine-tracking cap in rad/s
-- (select_speed, sight_manager.cpp:80-101), predict is seconds of target lead
-- (predict_object_position, sight_action.cpp:380); vision is a multiplier on get_visible_value
-- accumulation (visual_memory_manager.cpp:365-379), composing with whatever detection stack the
-- modpack installed. Angles pass -1 (follow the live ai_aim_* band - vanilla or the hardcore-aim game
-- option - so min_speed keeps one meaning in both regimes, and a co-installed global tuner stays
-- honored for the angle band). Fields are not serialized: they die with the game object, so every
-- net_spawn re-sets them. On an exe without the binds both wrappers are no-ops and vanilla behavior
-- applies - logged INACTIVE once below, never a version compare.

-- The numbers live in configs/alifetactics/at_reaction.ltx (grounding documented there: vanilla and
-- the hardcore-aim option bound the aim/lead curves, the installed-baseline rule bounds vision).
-- Resolution order per key: MCM slider (when the player moved it, defaults
-- fed from the same LTX) -> LTX -> the script fallbacks below (missing key/file only, the repo-wide
-- LTX convention). _predict has no MCM row: LTX -> fallback.
local CONFIG_PATH    = "alifetactics\\at_reaction.ltx"
local CONFIG_SECTION = "at_reaction"

-- Script-side fallbacks, mirroring the shipped LTX values (derivation + src proofs live there).
local _aim = {
    novice       = 0.24,
    trainee      = 0.53,
    experienced  = 0.78,
    professional = 0.99,
    veteran      = 1.24,
    expert       = 1.45,
    master       = 1.70,
    legend       = 2.50,
}

local _predict = {
    novice       = 0.40,
    trainee      = 0.38,
    experienced  = 0.37,
    professional = 0.36,
    veteran      = 0.35,
    expert       = 0.34,
    master       = 0.32,
    legend       = 0.28,
}

local _vision = {
    novice       = 1.00,
    trainee      = 1.00,
    experienced  = 1.00,
    professional = 1.00,
    veteran      = 1.00,
    expert       = 1.00,
    master       = 1.00,
    legend       = 1.00,
}

local _get_obj_rank_name = ranks.get_obj_rank_name

-- One-time capability log, driven by the wrapper booleans (t149 standard: log the capability, never
-- a build date).
local _bind_logged = false

local function _on_net_spawn(npc)
    if not cfg.reaction_enabled then return end
    if not (npc and npc:alive()) then return end

    local tier = _get_obj_rank_name(npc)
    if not tier or tier == "" then return end

    local aim = _aim[tier]
    local vision = _vision[tier]
    if not (aim and vision) then return end

    -- Never write a value worse than the live global: the game's hardcore-AI-aim option (or any
    -- global tuner) may have raised the baseline the unset NPCs follow, and a per-NPC absolute
    -- below it would DOWNGRADE the NPC against the player's own setting. Aim floors up (higher =
    -- faster tracking), lead floors down (lower = tighter lead).
    local console = get_console()
    local live_aim = console:get_float("ai_aim_min_speed")
    if live_aim and live_aim > aim then aim = live_aim end
    local predict = _predict[tier] or -1
    local live_predict = console:get_float("ai_aim_predict_time")
    if live_predict and live_predict > 0 and predict > 0 and live_predict < predict then predict = live_predict end

    local ok_aim = xcombat.set_aim_params(npc, -1, -1, aim, predict)
    local ok_vision = xcombat.set_vision_speed(npc, vision)

    if _dbg then
        log.debug("[RCT] id=%d name=%s tier=%s aim=%.2f predict=%.2f vision=%.2f applied_aim=%s applied_vision=%s",
            npc:id(), npc:name(), tier, aim, predict, vision,
            ok_aim and "yes" or "no", ok_vision and "yes" or "no")
    end

    if not _bind_logged then
        _bind_logged = true
        if ok_aim or ok_vision then
            log.info("Reaction engine binds active (aim=%s vision=%s)",
                ok_aim and "on" or "off", ok_vision and "on" or "off")
        else
            log.info("Reaction INACTIVE: exe lacks the per-NPC aim/vision binds (PR #594); vanilla behavior applies")
        end
    end
end

-- The 8 rank tiers, MCM key order (mirrors the _aim/_vision tables and the at_mcm slider ids).
local TIERS = { "novice", "trainee", "experienced", "professional", "veteran", "expert", "master", "legend" }

-- Load the LTX curves over the script fallbacks; called once at on_game_start, before any MCM read.
local function _load_config()
    local ini = ini_file(CONFIG_PATH)
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]     = ini:r_float_ex(CONFIG_SECTION, "aim_" .. tier)     or _aim[tier]
        _predict[tier] = ini:r_float_ex(CONFIG_SECTION, "predict_" .. tier) or _predict[tier]
        _vision[tier]  = ini:r_float_ex(CONFIG_SECTION, "vision_" .. tier)  or _vision[tier]
    end
end

local function _refresh_config()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]    = at_mcm.get_config("rct_aim_" .. tier)    or _aim[tier]
        _vision[tier] = at_mcm.get_config("rct_vision_" .. tier) or _vision[tier]
    end
end

local function _on_first_update()
    _refresh_config()
    log.info("Reaction hook initialized (enabled=%s)", cfg.reaction_enabled and "true" or "false")
end

function on_game_start()
    _load_config()
    RegisterScriptCallback("npc_on_net_spawn",           _on_net_spawn)
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_config)
end

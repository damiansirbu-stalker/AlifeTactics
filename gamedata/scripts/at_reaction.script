--- at_reaction: Per-NPC rank-aware tracking tightness and vision speed via the engine binds

local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global

local log = xlog.get_logger("AT.RCT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- Engine consumption (per-NPC fields, PR #594): min_speed is the sight's fine-tracking cap in rad/s
-- (select_speed, sight_manager.cpp:80-101), predict is seconds of target lead
-- (predict_object_position, sight_action.cpp:380); vision is a multiplier on get_visible_value
-- accumulation (visual_memory_manager.cpp:365-379), composing with whatever detection stack the
-- modpack installed. Angles pass -1 (follow the live ai_aim_* band - vanilla or the hardcore-aim game
-- option - so min_speed keeps one meaning in both regimes, and a co-installed global tuner stays
-- honored for the angle band). Fields are not serialized: they die with the game object, so every
-- net_spawn re-sets them. On an exe without the binds both wrappers are no-ops and vanilla behavior
-- applies - logged INACTIVE once below, never a version compare.

-- The numbers live in configs/alifetactics/at_reaction.ltx (grounding documented there: vanilla and
-- the hardcore-aim option bound the aim/lead curves, the installed-baseline rule bounds vision).
-- Resolution order per key (aim, lead, and vision alike): MCM slider (when the player moved it,
-- defaults fed from the same LTX) -> LTX -> the script fallbacks below (missing key/file only, the
-- repo-wide LTX convention). Each curve has its own rct_* slider set and its own enable toggle.
local CONFIG_PATH    = "alifetactics\\at_reaction.ltx"
local CONFIG_SECTION = "at_reaction"

-- Script-side fallbacks, mirroring the LTX values (derivation + src proofs live there).
local _aim = {
    novice       = 0.24,
    trainee      = 0.53,
    experienced  = 0.78,
    professional = 0.99,
    veteran      = 1.24,
    expert       = 1.45,
    master       = 1.70,
    legend       = 2.50,
}

local _vision = {
    novice       = 1.00,
    trainee      = 1.13,
    experienced  = 1.24,
    professional = 1.33,
    veteran      = 1.44,
    expert       = 1.54,
    master       = 1.65,
    legend       = 2.00,
}

-- Per-rank lead ERROR (t156): the rank's multiplier on the physically-correct lead. The engine leads a
-- moving target by aim_point += target_velocity * predict_time (sight_action.cpp:383-384); the correct
-- predict_time is the bullet's flight time = range / bullet_speed. _on_shot_lead recomputes that live and
-- scales it here - legend 1.00 leads true (hits movers), novice 2.00 over-leads (overshoots), linear
-- between. Skill is judging the lead right, and the error compounds with the wide low-rank dispersion cone.
-- Bounded and range-scaled, unlike the retired fixed 0.40 that over-led every rank at close range.
local _lead = {
    novice       = 2.00,
    trainee      = 1.85,
    experienced  = 1.70,
    professional = 1.55,
    veteran      = 1.40,
    expert       = 1.25,
    master       = 1.10,
    legend       = 1.00,
}

-- Adaptive-lead recompute knobs. predict = clamp(range / bullet_speed, 0, PREDICT_MAX_S) * _lead[tier],
-- re-derived on the fire seam, throttled per NPC (most shots cost one timestamp compare).
local LEAD_THROTTLE_MS = 1000
local PREDICT_MAX_S    = 0.5
-- _next_lead: npc id -> next time_global() ms the recompute is allowed to run.
-- _bspeed: weapon section -> bullet_speed m/s, or false when the section carries no bullet_speed key.
-- _wpn_ammo: weapon section -> its ammo_class list (split once). _ammok: ammo section -> k_bullet_speed.
local _next_lead = {}
local _bspeed    = {}
local _wpn_ammo  = {}
local _ammok     = {}

-- Fallback bullet speed (m/s) per weapon kind for a section with no bullet_speed key (exotic/melee skip).
local KIND_BSPEED = {
    w_pistol = 350, w_shotgun = 380, w_smg = 400, w_rifle = 850, w_sniper = 850,
}

local _get_obj_rank_name = ranks.get_obj_rank_name

-- One-time capability log, driven by the wrapper booleans (t149 standard: log the capability, never
-- a build date).
local _bind_logged = false

-- Log the reaction-bind capability exactly once, from the first apply that reaches the writes.
local function _log_binds_once(ok_aim, ok_vision, ok_disc)
    if _bind_logged then return end
    _bind_logged = true
    if ok_aim or ok_vision or ok_disc then
        log.info("Reaction spawn binds active (aim=%s vision=%s discipline=%s)",
            ok_aim and "on" or "off", ok_vision and "on" or "off", ok_disc and "on" or "off")
    else
        log.info("Reaction INACTIVE: exe lacks the per-NPC spawn binds (PR #594/#603); vanilla behavior applies")
    end
end

-- Confirm the adaptive-lead path exactly once (t149 standard): the first recompute that reaches the write
-- logs whether set_aim_params applied, the resolved bullet speed, and its source - so a log shows at a
-- glance that lead is live on this exe and which speed the physics used. INFO-level, one line, never a build
-- compare. _dbg adds the per-recompute detail below.
local _lead_logged = false
local function _log_lead_once(ok, bs, src, predict)
    if _lead_logged then return end
    _lead_logged = true
    if ok then
        log.info("Target lead active: first write bs=%.0f (%s) predict=%.3fs", bs, src, predict)
    else
        log.info("Target lead INACTIVE: set_aim_params is a no-op (exe lacks the bind); global lead applies")
    end
end

-- Resolve the tracking min_speed for a tier, floored up to the live global so a per-NPC value never
-- downgrades the NPC below the game's hardcore-aim option. Shared by the spawn apply and the lead
-- recompute (the recompute must re-pass this, else set_aim_params reverts min_speed to the global).
local function _resolve_aim(tier)
    local aim = _aim[tier]
    if not aim then return nil end
    local live_aim = get_console():get_float("ai_aim_min_speed")
    if live_aim and live_aim > aim then aim = live_aim end
    return aim
end

-- Loaded-round k_bullet_speed for the NPC's weapon: the engine multiplies the launch speed by it
-- (Level_Bullet_Manager.cpp:66). The current ammo type (get_ammo_type) indexes the weapon's ammo_class
-- list; that ammo section's k_bullet_speed (default 1.0) is the multiplier - so subsonic/AP rounds scale
-- the lead correctly. The class list caches per weapon section, the k per ammo section. 1.0 on any miss,
-- so the caller keeps the plain weapon base speed.
local function _ammo_speed_k(wpn, sect)
    local idx = wpn:get_ammo_type()
    if not idx then return 1.0 end
    local list = _wpn_ammo[sect]
    if list == nil then
        list = {}
        local classes = ini_sys:r_string_ex(sect, "ammo_class")
        if classes then
            for a in classes:gmatch("[^%s,]+") do list[#list + 1] = a end
        end
        _wpn_ammo[sect] = list
    end
    local ammo_sect = list[idx + 1]
    if not ammo_sect then return 1.0 end
    local k = _ammok[ammo_sect]
    if k == nil then
        k = ini_sys:r_float_ex(ammo_sect, "k_bullet_speed") or 1.0
        _ammok[ammo_sect] = k
    end
    return k
end

-- Bullet speed (m/s) for the NPC's current weapon: the weapon section's own bullet_speed
-- (ShootingObject.cpp:168) times the loaded round's k_bullet_speed, cached per section; a per-kind
-- fallback (no ammo scaling) covers a section without the key. Returns (speed, source) where source is
-- "section" or "fallback" for tracing; speed is nil when neither resolves (melee/exotic), caller skips.
local function _bullet_speed(obj, wpn)
    local sect = wpn and wpn:section()
    if sect then
        local bs = _bspeed[sect]
        if bs == nil then
            bs = ini_sys:r_float_ex(sect, "bullet_speed") or false
            _bspeed[sect] = bs
        end
        if bs then return bs * _ammo_speed_k(wpn, sect), "section" end
    end
    return KIND_BSPEED[xcombat.get_weapon_kind(obj)], "fallback"
end

-- Fire discipline (t154): two per-rank queue scales fed to set_fire_queue_scale (#603). _qsize scales
-- burst size (crisper short bursts at high rank), _qinterval scales the inter-burst pause (tighter
-- cadence at high rank). NON-DEGRADATION INVARIANT: the shipped defaults keep _qsize >= _qinterval at
-- every tier. rounds/min is proportional to size/(interval + size*dt), so size_k >= interval_k makes
-- rounds/min >= vanilla, while a shorter burst drops only the dispersed TAIL rounds (past
-- base_dispersioned_bullets_count, WeaponMagazined.cpp:797-800) -> per-shot% rises. Volume >= vanilla and
-- per-shot% >= vanilla => hits/min >= vanilla (doc/library/modding/npc-combat-effectiveness.md, the queue
-- section). Interval floored so bursts never merge into full-auto. 1.0/1.0 (novice) = exact vanilla.
-- Vanilla-planner fire only: maneuver/state_mgr fire bypasses select_queue_params and this scale.
local DISC_INT_FLOOR = 0.60
local _qsize = {
    novice       = 1.00,
    trainee      = 0.98,
    experienced  = 0.96,
    professional = 0.94,
    veteran      = 0.92,
    expert       = 0.90,
    master       = 0.88,
    legend       = 0.85,
}
local _qinterval = {
    novice       = 1.00,
    trainee      = 0.96,
    experienced  = 0.93,
    professional = 0.89,
    veteran      = 0.86,
    expert       = 0.82,
    master       = 0.79,
    legend       = 0.75,
}

-- Set the per-rank queue scales on one NPC. novice (1.0/1.0) leaves the vanilla queue (field unset).
-- No-op when the toggle is off or on a floor exe (the wrapper returns false).
local function _apply_discipline(npc, tier)
    if not cfg.discipline_enabled then return end
    local sk = _qsize[tier]
    local ik = _qinterval[tier]
    if not (sk and ik) then return end
    if sk == 1.0 and ik == 1.0 then return end
    if ik < DISC_INT_FLOOR then ik = DISC_INT_FLOOR end
    local ok = xcombat.set_fire_queue_scale(npc, sk, ik)
    if _dbg then
        log.debug("[RCT] disc id=%d tier=%s size_k=%.2f interval_k=%.2f applied=%s",
            npc:id(), tier, sk, ik, ok and "yes" or "no")
    end
    return ok
end

--- Apply the rank curves to one NPC. The npc_on_net_spawn body, public because the engine fields
--- are set once per spawn and never re-read: a runtime rank change (npc:set_character_rank) leaves
--- the old tier's aim/lead/vision applied until this re-keys them. Sets tracking behind aim_enabled and
--- vision behind vision_enabled; INACTIVE exes no-op inside the xcombat wrappers.
--- @param npc game_object stalker to (re-)apply the curves to
function apply(npc)
    if not (npc and npc:alive()) then return end
    if not (cfg.aim_enabled or cfg.vision_enabled or cfg.discipline_enabled) then return end

    local tier = _get_obj_rank_name(npc)
    if not tier or tier == "" then return end

    -- Tracking and vision are set once here, each behind its own toggle. Target lead is NOT set at spawn
    -- (no enemy or range yet) - predict follows the global ai_aim_predict_time until the first throttled
    -- fire-seam recompute (_on_shot_lead, t156). _resolve_aim floors aim up to the live global so a per-NPC
    -- value never downgrades the NPC below the game's hardcore-aim option.
    local ok_aim, ok_vision
    if cfg.aim_enabled then
        local aim = _resolve_aim(tier)
        if aim then ok_aim = xcombat.set_aim_params(npc, -1, -1, aim, -1) end
    end
    if cfg.vision_enabled then
        local vision = _vision[tier]
        if vision then ok_vision = xcombat.set_vision_speed(npc, vision) end
    end
    local ok_disc = _apply_discipline(npc, tier)

    _log_binds_once(ok_aim, ok_vision, ok_disc)

    if _dbg then
        log.debug("[RCT] id=%d tier=%s applied_aim=%s applied_vision=%s",
            npc:id(), tier, ok_aim and "yes" or "no", ok_vision and "yes" or "no")
    end
end

--- Adaptive target lead on the fire seam (t156). Throttled per NPC: most shots cost one timestamp
--- compare. On recompute it reads the best_enemy range and the weapon's bullet speed, derives the
--- physically-correct lead time (flight time = range / bullet_speed), scales it by rank skill, clamps
--- it, and re-writes predict_time. It re-passes the rank aim (min_speed) so the adaptive call does not
--- revert min_speed to the global. Keeps the last predict when there is no enemy or no usable bullet
--- speed. INACTIVE exes no-op inside set_aim_params.
--- Callback signature (obj, wpn, body_state, move_type, temp_disp), same seam as at_accuracy.
--- @param obj game_object firing stalker
--- @param wpn game_object|nil the weapon that fired
local function _on_shot_lead(obj, wpn, body_state, move_type, temp_disp)
    if not cfg.lead_enabled then return end
    if not obj then return end

    local id = obj:id()
    local tg = time_global()
    local nxt = _next_lead[id]
    if nxt and tg < nxt then return end
    _next_lead[id] = tg + LEAD_THROTTLE_MS

    local enemy = obj:best_enemy()
    if not enemy then return end
    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return end
    local err = _lead[tier]
    if not err then return end
    local bs, src = _bullet_speed(obj, wpn)
    if not bs or bs <= 0 then return end

    local range = obj:position():distance_to(enemy:position())
    local predict = range / bs * err
    if predict < 0 then predict = 0 elseif predict > PREDICT_MAX_S then predict = PREDICT_MAX_S end

    local ok = xcombat.set_aim_params(obj, -1, -1, _resolve_aim(tier) or -1, predict)
    _log_lead_once(ok, bs, src, predict)

    if _dbg then
        log.debug("[RCT] lead id=%d tier=%s range=%.1f bs=%.0f src=%s err=%.2f predict=%.3f applied=%s",
            id, tier, range, bs, src, err, predict, ok and "yes" or "no")
    end
end

-- The 8 rank tiers, MCM key order (mirrors the _aim/_vision tables and the at_mcm slider ids).
local TIERS = { "novice", "trainee", "experienced", "professional", "veteran", "expert", "master", "legend" }

-- Load the LTX curves over the script fallbacks; called once at on_game_start, before any MCM read.
local function _load_config()
    local ini = ini_file(CONFIG_PATH)
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]       = ini:r_float_ex(CONFIG_SECTION, "aim_" .. tier)       or _aim[tier]
        _lead[tier]      = ini:r_float_ex(CONFIG_SECTION, "lead_" .. tier)      or _lead[tier]
        _vision[tier]    = ini:r_float_ex(CONFIG_SECTION, "vision_" .. tier)    or _vision[tier]
        _qsize[tier]     = ini:r_float_ex(CONFIG_SECTION, "qsize_" .. tier)     or _qsize[tier]
        _qinterval[tier] = ini:r_float_ex(CONFIG_SECTION, "qinterval_" .. tier) or _qinterval[tier]
    end
end

local function _refresh_config()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]       = at_mcm.get_config("rct_aim_" .. tier)       or _aim[tier]
        _lead[tier]      = at_mcm.get_config("rct_lead_" .. tier)      or _lead[tier]
        _vision[tier]    = at_mcm.get_config("rct_vision_" .. tier)    or _vision[tier]
        _qsize[tier]     = at_mcm.get_config("rct_qsize_" .. tier)     or _qsize[tier]
        _qinterval[tier] = at_mcm.get_config("rct_qinterval_" .. tier) or _qinterval[tier]
    end
end

local function _on_first_update()
    _refresh_config()
    log.info("Reaction hook initialized (aim=%s vision=%s lead=%s discipline=%s)",
        cfg.aim_enabled and "on" or "off", cfg.vision_enabled and "on" or "off",
        cfg.lead_enabled and "on" or "off", cfg.discipline_enabled and "on" or "off")
end

function on_game_start()
    _load_config()
    RegisterScriptCallback("npc_on_net_spawn",           apply)
    RegisterScriptCallback("npc_shot_dispersion",        _on_shot_lead)
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_config)
end

--- at_reaction: per-rank aim, target lead, vision, and fire discipline - one mechanism, three MCM pages

local RegisterScriptCallback, time_global, AC_ID = RegisterScriptCallback, time_global, AC_ID

local cfg = at_mcm.cfg

local CONFIG_PATH    = "alifetactics\\at_reaction_config.ltx"
local CONFIG_SECTION = "at_reaction"

local LEAD_THROTTLE_MS = 1000
local PREDICT_MAX_S    = 0.5
local DISC_INT_FLOOR = 0.60

local KIND_BSPEED = {
    w_pistol = 350, w_shotgun = 380, w_smg = 400, w_rifle = 850, w_sniper = 850,
}

local TIERS = xcreature.RANK_TIERS

local _aim = {
    novice       = 0.24,
    trainee      = 0.40,
    experienced  = 0.54,
    professional = 0.66,
    veteran      = 0.80,
    expert       = 0.92,
    master       = 1.06,
    legend       = 1.50,
}

local _track = {
    novice       = 0.196,
    trainee      = 0.222,
    experienced  = 0.245,
    professional = 0.264,
    veteran      = 0.287,
    expert       = 0.306,
    master       = 0.328,
    legend       = 0.400,
}

local _vision = {
    novice       = 1.00,
    trainee      = 1.03,
    experienced  = 1.06,
    professional = 1.09,
    veteran      = 1.12,
    expert       = 1.15,
    master       = 1.18,
    legend       = 1.21,
}

local _vrange = {
    novice       = 1.00,
    trainee      = 1.02,
    experienced  = 1.05,
    professional = 1.07,
    veteran      = 1.09,
    expert       = 1.11,
    master       = 1.13,
    legend       = 1.15,
}

local _lead = {
    novice       = 2.00,
    trainee      = 1.85,
    experienced  = 1.70,
    professional = 1.55,
    veteran      = 1.40,
    expert       = 1.25,
    master       = 1.10,
    legend       = 1.00,
}

local _qsize = {
    novice       = 1.00,
    trainee      = 0.97,
    experienced  = 0.95,
    professional = 0.93,
    veteran      = 0.91,
    expert       = 0.89,
    master       = 0.87,
    legend       = 0.80,
}
local _qinterval = {
    novice       = 1.00,
    trainee      = 0.96,
    experienced  = 0.93,
    professional = 0.89,
    veteran      = 0.86,
    expert       = 0.82,
    master       = 0.79,
    legend       = 0.75,
}

local _next_lead = {}
local _bspeed    = {}
local _wpn_ammo  = {}
local _ammok     = {}
local _tier_cache = {}
local _bind_logged = false
local _lead_logged = false

local _get_obj_rank_name = ranks.get_obj_rank_name

local function _log_binds_once(ok_aim, ok_vision, ok_disc)
    if _bind_logged then return end
    _bind_logged = true
    if ok_aim or ok_vision or ok_disc then
        at_debug.info("Reaction spawn binds active (aim=%s vision=%s discipline=%s)",
            ok_aim and "on" or "off", ok_vision and "on" or "off", ok_disc and "on" or "off")
    else
        at_debug.info("Reaction INACTIVE: exe lacks the per-NPC spawn binds (PR #594/#603); vanilla behavior applies")
    end
end

local function _log_lead_once(ok, bs, src, predict)
    if _lead_logged then return end
    _lead_logged = true
    if ok then
        at_debug.info("Target lead active: first write bs=%.0f (%s) predict=%.3fs", bs, src, predict)
    else
        at_debug.info("Target lead INACTIVE: set_aim_params is a no-op (exe lacks the bind); global lead applies")
    end
end

local function _resolve_aim(tier)
    local aim = _aim[tier]
    if not aim then return nil end
    local live_aim = get_console():get_float("ai_aim_min_speed")
    if live_aim and live_aim > aim then aim = live_aim end
    return aim
end

local function _resolve_min_angle(tier)
    local angle = _track[tier]
    if not angle then return -1 end
    local live = get_console():get_float("ai_aim_min_angle")
    if live and live > angle then return -1 end
    return angle
end

local function _get_ammo_speed_k(wpn, sect)
    local idx = wpn:get_ammo_type()
    if not idx then return 1.0 end
    local list = _wpn_ammo[sect]
    if list == nil then
        list = {}
        local classes = ini_sys:r_string_ex(sect, "ammo_class")
        if classes then
            for a in classes:gmatch("[^%s,]+") do list[#list + 1] = a end
        end
        _wpn_ammo[sect] = list
    end
    local ammo_sect = list[idx + 1]
    if not ammo_sect then return 1.0 end
    local k = _ammok[ammo_sect]
    if k == nil then
        k = ini_sys:r_float_ex(ammo_sect, "k_get_bullet_speed") or 1.0
        _ammok[ammo_sect] = k
    end
    return k
end

local function _get_bullet_speed(obj, wpn)
    local sect = wpn and wpn:section()
    if sect then
        local bs = _bspeed[sect]
        if bs == nil then
            bs = ini_sys:r_float_ex(sect, "bullet_speed") or false
            _bspeed[sect] = bs
        end
        if bs then return bs * _get_ammo_speed_k(wpn, sect), "section" end
    end
    return KIND_BSPEED[xcombat.get_weapon_kind(obj)], "fallback"
end

local function _on_entity_unregister(se_obj)
    if se_obj then
        _tier_cache[se_obj.id] = nil
        _next_lead[se_obj.id] = nil
    end
end

local function _apply_discipline(npc, tier)
    if not cfg.discipline_enabled then return end
    local sk = _qsize[tier]
    local ik = _qinterval[tier]
    if not (sk and ik) then return end
    if sk == 1.0 and ik == 1.0 then return end
    if ik < DISC_INT_FLOOR then ik = DISC_INT_FLOOR end
    local ok = xcombat.set_fire_queue_scale(npc, sk, ik)
    if at_debug.is_on() then
        at_debug.debug("[RCT] disc id=%d tier=%s size_k=%.2f interval_k=%.2f applied=%s",
            npc:id(), tier, sk, ik, ok and "yes" or "no")
    end
    return ok
end

local function _on_shot_lead(obj, wpn, body_state, move_type, temp_disp)
    if not cfg.lead_enabled then return end
    if not obj then return end
    local id = obj:id()
    local tg = time_global()
    local nxt = _next_lead[id]
    if nxt and tg < nxt then return end
    _next_lead[id] = tg + LEAD_THROTTLE_MS
    if not at_faction.has_flavor(obj, "reaction") then return end

    local enemy = xcombat.get_best_enemy(obj)
    if not enemy then return end
    local tier = _get_obj_rank_name(obj)
    if not tier or tier == "" then return end
    local err = _lead[tier]
    if not err then return end
    local bs, src = _get_bullet_speed(obj, wpn)
    if not bs or bs <= 0 then return end

    local range = obj:position():distance_to(enemy:position())
    local predict = range / bs * err
    if predict < 0 then predict = 0 elseif predict > PREDICT_MAX_S then predict = PREDICT_MAX_S end

    local aim = cfg.aim_enabled and (_resolve_aim(tier) or -1) or -1
    local track = cfg.aim_enabled and _resolve_min_angle(tier) or -1
    local ok = xcombat.set_aim_params(obj, -1, track, aim, predict)
    _log_lead_once(ok, bs, src, predict)

    if at_debug.is_on() then
        at_debug.debug("[RCT] lead id=%d tier=%s range=%.1f bs=%.0f src=%s err=%.2f predict=%.3f applied=%s",
            id, tier, range, bs, src, err, predict, ok and "yes" or "no")
    end
end

local function _on_enemy_selected(npc, new_enemy)
    if not at_debug.is_on() or not npc then return end

    local id = npc:id()
    local name = npc:name()
    if not new_enemy then
        at_debug.debug("[VIS] drop id=%d name=%s", id, name)
        return
    end
    if new_enemy:id() ~= AC_ID then return end

    local tier = _get_obj_rank_name(npc) or "?"
    local dist = npc:position():distance_to(new_enemy:position())
    local seen = xcombat.can_see(npc, new_enemy)
    local unseen_ms = xcombat.get_unseen_ms(npc, new_enemy, time_global())
    at_debug.debug("[VIS] select id=%d name=%s tier=%s dist=%.0fm seen=%s unseen_ms=%d",
        id, name, tier, dist, seen and "yes" or "no", unseen_ms)
end

local function _compute_vision_range(npc)
    if not cfg.vision_enabled then return nil end
    if not at_faction.has_flavor(npc, "reaction") then return nil end
    local tier = _get_obj_rank_name(npc)
    if not tier or tier == "" then return nil end
    return _vrange[tier]
end

local function _load_config()
    local ini = ini_file(CONFIG_PATH)
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]       = ini:r_float_ex(CONFIG_SECTION, "aim_" .. tier)       or _aim[tier]
        _track[tier]     = ini:r_float_ex(CONFIG_SECTION, "track_" .. tier)     or _track[tier]
        _lead[tier]      = ini:r_float_ex(CONFIG_SECTION, "lead_" .. tier)      or _lead[tier]
        _vision[tier]    = ini:r_float_ex(CONFIG_SECTION, "vision_" .. tier)    or _vision[tier]
        _vrange[tier]    = ini:r_float_ex(CONFIG_SECTION, "vrange_" .. tier)    or _vrange[tier]
        _qsize[tier]     = ini:r_float_ex(CONFIG_SECTION, "qsize_" .. tier)     or _qsize[tier]
        _qinterval[tier] = ini:r_float_ex(CONFIG_SECTION, "qinterval_" .. tier) or _qinterval[tier]
    end
end

local function _update_config()
    at_debug.update_config()
    for i = 1, #TIERS do
        local tier = TIERS[i]
        _aim[tier]       = at_mcm.get_config("rct_aim_" .. tier)       or _aim[tier]
        _track[tier]     = at_mcm.get_config("rct_track_" .. tier)     or _track[tier]
        _lead[tier]      = at_mcm.get_config("rct_lead_" .. tier)      or _lead[tier]
        _vision[tier]    = at_mcm.get_config("rct_vision_" .. tier)    or _vision[tier]
        _vrange[tier]    = at_mcm.get_config("rct_vrange_" .. tier)    or _vrange[tier]
        _qsize[tier]     = at_mcm.get_config("rct_qsize_" .. tier)     or _qsize[tier]
        _qinterval[tier] = at_mcm.get_config("rct_qinterval_" .. tier) or _qinterval[tier]
    end
end

local function _on_first_update()
    _tier_cache, _next_lead = {}, {}
    _update_config()
    at_debug.info("Reaction hook initialized (aim=%s vision=%s lead=%s discipline=%s)",
        cfg.aim_enabled and "on" or "off", cfg.vision_enabled and "on" or "off",
        cfg.lead_enabled and "on" or "off", cfg.discipline_enabled and "on" or "off")
end

--- Fire-discipline scales for one NPC ((1,1) when off or tierless, so callers multiply blindly).
function get_queue_scales(npc)
    if not cfg.discipline_enabled then return 1, 1 end
    local id = npc:id()
    local tier = _tier_cache[id]
    if tier == nil then
        tier = _get_obj_rank_name(npc) or false
        _tier_cache[id] = tier
    end
    if not tier then return 1, 1 end
    local sk = _qsize[tier] or 1
    local ik = _qinterval[tier] or 1
    if ik < DISC_INT_FLOOR then ik = DISC_INT_FLOOR end
    return sk, ik
end

--- Apply the rank curves to one NPC now (the spawn body; a runtime rank change needs this re-key).
function apply(npc)
    if not (npc and npc:alive()) then return end
    if not at_faction.has_flavor(npc, "reaction") then return end
    if not (cfg.aim_enabled or cfg.vision_enabled or cfg.discipline_enabled) then return end

    local tier = _get_obj_rank_name(npc)
    if not tier or tier == "" then return end

    local ok_aim, ok_vision
    if cfg.aim_enabled then
        local aim = _resolve_aim(tier)
        local track = _resolve_min_angle(tier)
        if aim then ok_aim = xcombat.set_aim_params(npc, -1, track, aim, -1) end
    end
    if cfg.vision_enabled then
        local vision = _vision[tier]
        if vision then ok_vision = xcombat.set_vision_speed(npc, vision) end
    end
    local ok_disc = _apply_discipline(npc, tier)

    _log_binds_once(ok_aim, ok_vision, ok_disc)

    if at_debug.is_on() then
        at_debug.debug("[RCT] id=%d tier=%s applied_aim=%s applied_vision=%s",
            npc:id(), tier, ok_aim and "yes" or "no", ok_vision and "yes" or "no")
    end
end

function on_game_start()
    _load_config()
    at_effects_resolver.register(at_effects_resolver.EFFECT.VISION_RANGE, _compute_vision_range)
    RegisterScriptCallback("npc_on_net_spawn",           apply)
    RegisterScriptCallback("npc_shot_dispersion",        _on_shot_lead)
    RegisterScriptCallback("npc_on_enemy_selected",      _on_enemy_selected)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           _update_config)
    RegisterScriptCallback("mcm_option_restore_default", _update_config)
end

--- at_ext_health: per-NPC health behavior controls.
-- Two layers of runtime tuning on top of vanilla xr_eat_medkit:
--
--  1. Heal rate multiplier. Replaces xr_eat_medkit.heal_hp with a version
--     that scales the per-tick change_health by an MCM multiplier. Vanilla
--     does change_health(0.05) every level.get_time_factor() seconds for
--     13 ticks (left=15..3, exits at left=2 because nextl=1 fails nextl>1).
--     Multiplier scales the per-tick amount; total recovery from vanilla
--     is 13 * 0.05 = 0.65 HP. The replacement reschedules itself via
--     xr_eat_medkit.heal_hp (which resolves to our patched function at call
--     time, so recursion is stable).
--
--  2. Per-rank healing-charge probability. Vanilla rolls a single 50% chance
--     at server-entity register and grants healing_charge=true on success.
--     We override on npc_on_net_spawn (first time the game_object comes
--     online): read rank, map to tier, roll MCM-configured chance for that
--     tier, set healing_charge=true|false unconditionally. Persists via
--     se_save_var; per-NPC "at_charge_processed" flag prevents re-rolling
--     across offline/online transitions or save/load.
--
-- Why direct assignment for heal_hp (not xevent.hook): we replace the body
-- entirely rather than wrap. xevent.hook is for stacking wrappers around
-- existing behavior; here we substitute the per-tick math, no chain needed.

local math_random, tonumber = math.random, tonumber
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback = RegisterScriptCallback

-- pstor wrappers with nil-key guard. Both functions accept (id, name, key[, val]); if
-- name is nil, vanilla pstor silently writes to a wrong key (and reads back nil), so
-- guard explicitly. Callers can pass npc:name() without their own pre-check.
local function _safe_save(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _safe_load(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end
-- CreateTimeEvent is NOT cached at module load: demonized_time_events replaces this
-- global at runtime, so capturing the upvalue would pin the original (vanilla) impl.

local log = xlog.get_logger("AT.HEALTH", { outfile = "alifetactics.log" })
local _dbg = false
local _heal_active = false

-- Vanilla rank names from game_relations.ltx [game_relations] rating folded into
-- the four MCM tiers. ranks.get_obj_rank_name resolves the numeric rank against
-- the same source so any mod that reshapes the rating intervals keeps working.
local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local function _rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

-- ==================== MCM READERS ====================

local function _is_enabled()
    if at_core_mcm and at_core_mcm.get_config then
        local v = at_core_mcm.get_config("stalker_healing_enabled")
        if v ~= nil then return v end
    end
    return true
end

local function _heal_rate_mult()
    if at_core_mcm and at_core_mcm.get_config then
        return tonumber(at_core_mcm.get_config("heal_rate_multiplier")) or 1.0
    end
    return 1.0
end

local function _charge_chance_pct(tier)
    if at_core_mcm and at_core_mcm.get_config then
        return tonumber(at_core_mcm.get_config("charge_chance_" .. tier)) or 50
    end
    return 50
end

-- ==================== PATCH: HEAL_HP MULTIPLIER ====================

-- Mirrors vanilla xr_eat_medkit.heal_hp (script:188-201) logic but scales
-- the per-tick heal by the current MCM multiplier. Recursive scheduling
-- captures xr_eat_medkit.heal_hp (our function after install) so the chain
-- propagates the multiplier through all 13 ticks. xprofiler.new_if(_dbg)
-- is a no-op singleton when debug logging is off, real profile_timer when
-- on -- timing appears in the [HEAL] debug line at zero cost otherwise.
local function _patched_heal_hp(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        local mult = _heal_rate_mult()
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- ==================== PATCH: HEAL_BLEED LOG ====================

-- Mirrors vanilla xr_eat_medkit.heal_bleed (script:203-215). No behavior
-- change: vanilla sets npc.bleeding = 0.07 per tick for 13 ticks (left=15..3,
-- exits at left=2). The replacement only adds [HEAL] bleed_tick / bleed_complete
-- log lines and xprofiler timing so bandage consumption is observable end-to-end,
-- matching the heal_hp pattern. Recursive scheduling captures xr_eat_medkit
-- .heal_bleed (our function after install) so the chain stays on the patched
-- function through all 13 ticks. No MCM-tunable multiplier because the engine
-- field is a hard set, not a delta -- a multiplier on a target value would be
-- unintuitive.
local function _patched_heal_bleed(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        npc.bleeding = 0.07
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

local function _install_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        log.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _patched_heal_hp
    xr_eat_medkit.heal_bleed = _patched_heal_bleed
    _heal_active = true
    log.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    log.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
end

-- ==================== CALLBACK: PER-RANK HEALING CHARGE ====================

-- Fires when an NPC game_object first becomes online (npc_on_net_spawn).
-- Vanilla server-entity on_register has already fired by now and may have
-- set healing_charge=true on a 50% roll. We override unconditionally with
-- our per-rank roll: every stalker, every spawn, exactly one resolution.
-- at_charge_processed flag is persisted via se_save_var so subsequent
-- offline/online transitions (or save/load cycles) skip the re-roll.
local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = npc:id()
    local name = npc:name()
    if _safe_load(id, name, "at_charge_processed") then
        tmr:stop()
        if _dbg then
            log.debug("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, tmr:get_ms())
        end
        return
    end
    _safe_save(id, name, "at_charge_processed", true)

    local tier = _rank_tier(npc)
    local chance = _charge_chance_pct(tier) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _safe_save(id, name, "healing_charge", granted)
    tmr:stop()
    if _dbg then
        log.debug("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", tmr:get_ms())
    end
end

-- ==================== LIFECYCLE ====================

local function _refresh_log()
    if at_core_mcm and at_core_mcm.get_config then
        local level_str = at_core_mcm.get_config("log_level") or "WARN"
        log.set_level(level_str)
        _dbg = log.get_level() >= 5
    end
end

local function _on_actor_first_update()
    _refresh_log()
    log.info("Health module initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        _heal_rate_mult(),
        _charge_chance_pct("novice"),
        _charge_chance_pct("experienced"),
        _charge_chance_pct("veteran"),
        _charge_chance_pct("master"))
end

function on_game_start()
    -- Master toggle. Disabled = no heal_hp/heal_bleed patch, no per-rank charge override.
    -- Vanilla xr_eat_medkit behavior runs unmodified. Runtime toggle requires game restart.
    if not _is_enabled() then
        log.info("Stalker Healing disabled at boot; vanilla xr_eat_medkit behavior in effect")
        RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
        RegisterScriptCallback("on_option_change",          _refresh_log)
        RegisterScriptCallback("mcm_option_restore_default", _refresh_log)
        return
    end
    _install_heal_patch()
    RegisterScriptCallback("npc_on_net_spawn",          _on_net_spawn)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)
end

--- at_hitresponse: Squad-aware hit disclosure
--- Hooks npc_on_hit_callback. On the first faction-enemy hit against a squad,
--- discloses the shooter to every online squadmate regardless of audible range,
--- extending the engine's earshot-bounded propagation to distant patrol members
--- and suppressed-weapon victims. Decay reverses the disclosure after the MCM
--- retention window so re-engagement re-fires the full pipeline.

local pairs, tostring, RegisterScriptCallback, IsStalker, alife_object = pairs, tostring, RegisterScriptCallback, IsStalker, alife_object
-- DO NOT cache CreateTimeEvent / ResetTimeEvent / RemoveTimeEvent as locals.
-- demonized_time_events.script replaces them; cached locals capture the dead
-- originals and timers never fire. See doc/library/xray/internals/globals.md:208-219.

local log = xlog.get_logger("AT.HIT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- ==================== CONSTANTS ====================

local GOODWILL_HOSTILE   = -2000
local TIMER_EV           = "at_hitresponse"
local TIMER_DECAY        = "decay"
local DECAY_INTERVAL_SEC = 5

-- ==================== STATE ====================

local _disclosed = {}

-- Returns true only when shooter's faction is community-level enemy of victim's.
-- This is the substrate-update gate: accidental hits on friendly/neutral NPCs do not
-- accumulate. Same-community hits are rejected as friendly fire.
--
-- character_community(obj) is the anomaly global wrapper (_g.script:2425-2433). For
-- stalkers and the actor it returns obj:character_community(). For anything else
-- (mutants, helicopters, anomalies) it returns the literal string "monster". Mutant
-- shooters therefore PASS this gate because is_factions_enemies(<stalker>, "monster")
-- is true, which is correct: mutant attacks are real combat events worth tracking in
-- substrate and the state machine. The mutant-specific restriction (goodwill writes
-- only for human shooters) lives in _disclose.
local function _shooter_is_combat_enemy(npc, who)
    local npc_comm = character_community(npc)
    if not npc_comm or npc_comm == "" or npc_comm == "none" then return false end
    local who_comm = character_community(who)
    if not who_comm or who_comm == "" or who_comm == "none" then return false end
    if who_comm == npc_comm then return false end
    return game_relations.is_factions_enemies(npc_comm, who_comm)
end

-- Walk squad members, force-disclose the shooter to every online one. Offline
-- members are skipped (no game_object). Three writes per member, all independent
-- mechanisms verified against engine source:
--
--   1. force_set_goodwill(-2000, who)
--      RELATION_REGISTRY personal goodwill override; subtracts community baseline
--      so final relation = exactly -2000 (relation_registry.cpp:161-179).
--      CAI_Stalker::tfGetRelationType (ai_stalker_misc.cpp:92-105) routes through
--      RELATION_REGISTRY.GetRelationType -> GetAttitude (relation_registry_inline.h:69-93),
--      which sums personal + reputation + rank + community_to_obj + community_to_community.
--      Net: final attitude = -2000 + reputation + rank, well below enemy threshold.
--      The squadmate treats the shooter as hostile in every is_relation_enemy() check.
--
--   2. enable_memory_object(who, true)
--      Toggles m_enabled on existing visual/sound/hit memory entries
--      (visual_memory_manager.cpp:245-251, sound_memory_manager.cpp:115-121,
--       hit_memory_manager.cpp:240-247). No-op when no prior entry. Cheap
--      insurance for squadmates that already heard/saw/got-hit-by the shooter.
--
--   3. register_in_combat()
--      Sets squad_mask bit on CAgentMemberManager::m_combat_mask
--      (agent_member_manager.cpp:114-132). This bit is the GATE for engine-native
--      squad memory propagation at agent_memory_manager.cpp:33-34: memory entries
--      with m_squad_mask intersecting combat_mask get spread across all combat-active
--      members each tick. Calling this on patrolling squadmates flips them combat-
--      active, and the next agent_manager update propagates the victim's hit-memory
--      of the shooter across the whole engaged squad. This is the engine's own
--      squad-memory-sharing mechanism; we just unlock it.
--
-- Safety: this function is only reached after _shooter_is_combat_enemy passed
-- (faction-relation already enemy). force_set_goodwill cannot flip a friendly
-- squad hostile because the gate at hit handler entry rejects friendly-fire
-- scenarios. set_relation(enemy) and set_enemy() are intentionally NOT called:
-- set_relation == SetGoodwill(goodwill_enemy_config) so it is redundant with
-- force_set_goodwill (relation_registry_inline.h:25-44); set_enemy is a bloodsucker-
-- only API that logs an error for stalkers (script_game_object_use2.cpp:231-243).
--
-- Mutant / helicopter / anomaly shooters: force_set_goodwill gated on IsStalker(who).
-- Mutant squadmates (e.g. mutant-vs-mutant or mutant-victim of stalker shooter):
-- gated on IsStalker(mem_npc). RELATION_REGISTRY::ForceSetGoodwill
-- (relation_registry.cpp:165-172) smart_casts BOTH ids to CSE_ALifeTraderAbstract
-- and bails with "cannot convert obj to CSE_ALifeTraderAbstract!" if either side
-- is non-stalker; mutants are CSE_ALifeMonsterAbstract so any mutant ID fails the
-- cast. enable_memory_object (script_game_object2.cpp:260-268) and
-- register_in_combat (agent_member_manager.cpp:114-132) work for any actor type so
-- they always run. Distant patrol squadmates still learn the squad is engaged with
-- the mutant via combat_mask propagation, matching vanilla xr_danger.script:132 which
-- escalates alertness regardless of shooter community.
local function _disclose_to_member(mem_npc, who, who_is_human)
    if not mem_npc then return false end
    if who_is_human and IsStalker(mem_npc) then
        mem_npc:force_set_goodwill(GOODWILL_HOSTILE, who)
    end
    mem_npc:enable_memory_object(who, true)
    mem_npc:register_in_combat()
    return true
end

local function _disclose(squad, who)
    if squad:npc_count() == 0 then return 0 end
    local count = 0
    local who_is_human = IsStalker(who)
    for member in squad:squad_members() do
        if _disclose_to_member(level.object_by_id(member.id), who, who_is_human) then
            count = count + 1
        end
    end
    return count
end

local function _collect_expired(map, now, threshold)
    local expired = {}
    for shooter_id, last_hit in pairs(map) do
        if now - last_hit > threshold then
            expired[#expired + 1] = shooter_id
        end
    end
    return expired
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = se_obj.id
    local was_squad = _disclosed[id] ~= nil
    _disclosed[id] = nil
    local affected = {}
    for _, map in pairs(_disclosed) do
        if map[id] then affected[#affected + 1] = map end
    end
    local cleared = #affected
    for i = 1, cleared do affected[i][id] = nil end
    tmr:stop()
    if _dbg and (was_squad or cleared > 0) then
        log.debug("[UNREGISTER] entity=%d was_squad=%s cleared=%d [%.2fms]",
            id, tostring(was_squad), cleared, tmr:get_ms())
    end
end

local function _decay_tick()
    ResetTimeEvent(TIMER_EV, TIMER_DECAY, DECAY_INTERVAL_SEC)
    local now = xtime.game_sec()
    if now == 0 then return end
    local threshold = cfg.hit_share_retention_min * 60
    local tmr = xprofiler.new_if(_dbg):start()
    local pruned = 0
    for _, map in pairs(_disclosed) do
        local expired = _collect_expired(map, now, threshold)
        local count = #expired
        for i = 1, count do map[expired[i]] = nil end
        pruned = pruned + count
    end
    tmr:stop()
    if _dbg and pruned > 0 then
        log.debug("[DECAY] pruned=%d threshold=%.0f [%.2fms]",
            pruned, threshold, tmr:get_ms())
    end
end

-- ==================== HIT HANDLER ====================

local function _on_hit(npc, amount, _local_direction, who, _bone_index)
    if not cfg.hit_share_enabled then return end
    if not amount or amount <= 0 then return end
    if not who or not npc then return end
    if who:id() == npc:id() then return end

    local tmr_total = xprofiler.new_if(_dbg):start()

    local tmr_gate = xprofiler.new_if(_dbg):start()
    local is_enemy = _shooter_is_combat_enemy(npc, who)
    tmr_gate:stop()
    if not is_enemy then
        tmr_total:stop()
        if _dbg then
            log.debug("[HIT] rejected reason=friendly_fire [gate=%.2fms total=%.2fms]",
                tmr_gate:get_ms(), tmr_total:get_ms())
        end
        return
    end

    local squad = get_object_squad(npc)
    if not squad then
        tmr_total:stop()
        if _dbg then
            log.debug("[HIT] rejected reason=no_squad [total=%.2fms]", tmr_total:get_ms())
        end
        return
    end

    local squad_id = squad.id
    local who_id   = who:id()
    local now      = xtime.game_sec()

    if not _disclosed[squad_id] then _disclosed[squad_id] = {} end
    local first_hit = _disclosed[squad_id][who_id] == nil
    _disclosed[squad_id][who_id] = now

    if not first_hit then
        tmr_total:stop()
        if _dbg then
            log.debug("[HIT] squad=%d shooter=%d (refreshed) [gate=%.2fms total=%.2fms]",
                squad_id, who_id, tmr_gate:get_ms(), tmr_total:get_ms())
        end
        return
    end

    local tmr_disclose = xprofiler.new_if(_dbg):start()
    local disclosed_to = _disclose(squad, who)
    tmr_disclose:stop()
    tmr_total:stop()

    if _dbg then
        log.debug("[DISCLOSURE] squad=%d shooter=%d disclosed_to=%d members [gate=%.2fms disclose=%.2fms total=%.2fms]",
            squad_id, who_id, disclosed_to, tmr_gate:get_ms(), tmr_disclose:get_ms(), tmr_total:get_ms())
    end
end

-- ==================== SPAWN HANDLER ====================

local function _inherit_one(npc, shooter_id, npc_id)
    if shooter_id == npc_id then return false end
    local who = level.object_by_id(shooter_id)
    if not who then return false end
    _disclose_to_member(npc, who, IsStalker(who))
    return true
end

local function _inherit_from_squad(npc, npc_id, squad_id, squad_map)
    local inherited = 0
    for shooter_id in pairs(squad_map) do
        if _inherit_one(npc, shooter_id, npc_id) then
            inherited = inherited + 1
        end
    end
    if _dbg and inherited > 0 then
        log.debug("[INHERIT] npc=%d squad=%d shooters=%d", npc_id, squad_id, inherited)
    end
end

local function _redisclose_member(mem_npc, who, who_is_human, shooter_id)
    if not mem_npc then return false end
    if mem_npc:id() == shooter_id then return false end
    return _disclose_to_member(mem_npc, who, who_is_human)
end

local function _redisclose_squad(squad_id, who, who_is_human, shooter_id)
    local sq = alife_object(squad_id)
    if not sq or not sq.squad_members then return 0 end
    if sq:npc_count() == 0 then return 0 end
    local count = 0
    for member in sq:squad_members() do
        if _redisclose_member(level.object_by_id(member.id), who, who_is_human, shooter_id) then
            count = count + 1
        end
    end
    return count
end

local function _on_shooter_online(npc, npc_id)
    local who_is_human = IsStalker(npc)
    local total = 0
    for squad_id, map in pairs(_disclosed) do
        if map[npc_id] then
            total = total + _redisclose_squad(squad_id, npc, who_is_human, npc_id)
        end
    end
    if _dbg and total > 0 then
        log.debug("[REDISCLOSE] shooter=%d members=%d", npc_id, total)
    end
end

local function _on_net_spawn(npc)
    if not npc then return end
    local npc_id = npc:id()
    local squad = get_object_squad(npc)
    if squad then
        local squad_map = _disclosed[squad.id]
        if squad_map then _inherit_from_squad(npc, npc_id, squad.id, squad_map) end
    end
    _on_shooter_online(npc, npc_id)
end

-- ==================== LIFECYCLE ====================

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_first_update()
    _disclosed = {}
    _refresh_log()
    RemoveTimeEvent(TIMER_EV, TIMER_DECAY)
    CreateTimeEvent(TIMER_EV, TIMER_DECAY, DECAY_INTERVAL_SEC, _decay_tick)
    log.info("Hit disclosure initialized (enabled=%s, retention=%dmin, dbg=%s)",
        cfg.hit_share_enabled and "true" or "false",
        cfg.hit_share_retention_min,
        _dbg and "true" or "false")
end

-- ==================== PUBLIC ====================

--- Walk every (squad_id, shooter_count) pair
function iterate_disclosed(fn)
    for squad_id, map in pairs(_disclosed) do
        local count = 0
        for _ in pairs(map) do count = count + 1 end
        fn(squad_id, count)
    end
end

function on_game_start()
    RegisterScriptCallback("npc_on_hit_callback",        _on_hit)
    RegisterScriptCallback("npc_on_net_spawn",           _on_net_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)
end

--- at_firstaid: active first-aid healing - heal-rate scaling, per-rank medkit charge, limp + heal
--- animations. Medkit healing is an ACTION (the NPC consumes an item and runs the xr_eat_medkit chain),
--- owned here and named apart from the passive regen at_gear writes via n039 (invariants I2, I4). It has
--- one owner and no source clash, so it is NOT an effect and never enters at_effects_resolver.

local math_random, tostring, pairs, type = math.random, tostring, pairs, type
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global
local IsStalker, IsWounded = IsStalker, IsWounded

-- The limp monitor pass period (a vanilla time event): the pass IS the drop-detector clock (a worn
-- pose must die the moment its gait stops matching); the eligibility check self-throttles to its own
-- slower period on a per-NPC stamp. Zero per-frame code.
local MONITOR_PERIOD_SEC        = 0.2
local LIMP_ELIGIBILITY_CHECK_MS = 1000
local LIMP_SAMPLE_MS            = 1000
local LIMP_REARM_MS             = 5000
-- Displacement that counts as "moved" for the drop detectors (anchor drift / path-stop sample).
local LIMP_MOVE_M               = 0.2
local LIMP_MOVE_SQR             = LIMP_MOVE_M * LIMP_MOVE_M
-- Presentation-only perceivability gate: the limp pose and heal gesture play only within this
-- radius of the actor (nobody sees them farther; xcombat.actor_dist_sqr is the 5s-TTL cached
-- read the combat seize gate shares). The healing SIMULATION (hp/bleed ticks, item consumption)
-- is never distance-gated - off-screen stalkers heal identically.
local ANIM_ACTOR_RADIUS_M       = 50
local ANIM_RADIUS_SQR           = ANIM_ACTOR_RADIUS_M * ANIM_ACTOR_RADIUS_M
-- xr_eat_medkit.consume_medkit schedules heal_hp/heal_bleed with left=15.
local HEAL_TICK_FIRST           = 15

-- Posture-slot tables for the dmg_norm hurt pose (the clutch-the-torso overlay), one variant per
-- commanded gait. Engine indexes torso anims by weapon posture slot, not inventory slot. Missing
-- entries fall through to slot 0 (fist). Slots 5, 7 not present in the OMF; slot 6 exists only as
-- the run variant (verified 2026-07-08 by binary grep across both installed variants of
-- stalker_animation.omf - a queued name the OMF lacks error-logs and plays nothing).
local LIMP_IDLE_BY_SLOT = {
    [0] = "dmg_norm_torso_0_idle_0", [1] = "dmg_norm_torso_1_idle_0",
    [2] = "dmg_norm_torso_2_idle_0", [3] = "dmg_norm_torso_3_idle_0",
    [4] = "dmg_norm_torso_4_idle_0",
    [8] = "dmg_norm_torso_8_idle_0", [9] = "dmg_norm_torso_9_idle_0",
    [10] = "dmg_norm_torso_10_idle_0",
}
local LIMP_WALK_BY_SLOT = {
    [0] = "dmg_norm_torso_0_walk_0", [1] = "dmg_norm_torso_1_walk_0",
    [2] = "dmg_norm_torso_2_walk_0", [3] = "dmg_norm_torso_3_walk_0",
    [4] = "dmg_norm_torso_4_walk_0",
    [8] = "dmg_norm_torso_8_walk_0", [9] = "dmg_norm_torso_9_walk_0",
    [10] = "dmg_norm_torso_10_walk_0",
}
local LIMP_RUN_BY_SLOT = {
    [0] = "dmg_norm_torso_0_run_0", [1] = "dmg_norm_torso_1_run_0",
    [2] = "dmg_norm_torso_2_run_0", [3] = "dmg_norm_torso_3_run_0",
    [4] = "dmg_norm_torso_4_run_0", [6] = "dmg_norm_torso_6_run_0",
    [8] = "dmg_norm_torso_8_run_0", [9] = "dmg_norm_torso_9_run_0",
    [10] = "dmg_norm_torso_10_run_0",
}
local HEAL_ANIM_MEDKIT  = "dmg_norm_torso_11_attack_0"
local HEAL_ANIM_BANDAGE = "norm_torso_12_attack_0"

local _limping = {}
-- ONLINE tracked stalkers, the limp monitor's roster: one record per NPC ({ eligibility_at }),
-- filled on net spawn, dropped on net destroy / unregister.
local _npc_states = {}

-- Vanilla pstor writes to a wrong key when name is nil. Guard explicitly.
local function _safe_save(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _safe_load(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end

local _heal_active = false
local cfg = at_mcm.cfg

-- Vanilla rank intervals (game_relations.ltx [game_relations] rating) folded
-- into MCM tiers via ranks.get_obj_rank_name.
local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local function _rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

-- One-shot medkit/bandage gesture. Gated on healing_anim toggle, on no visible
-- enemy (no anim during combat), on not-on-ground, and on STANDING STILL: a torso
-- gesture on a moving NPC suspends his leg animation while the body keeps
-- translating - the frozen-legs glide (reporter video 2026-07-25). movement_type
-- is the INTENT read, exactly right here: it answers "will his legs be animating".
-- The hurt pose belongs to LIMP, not here; HEAL is "I am applying an item" and
-- nothing else. The engine drains the queue when the gesture ends; action
-- transitions clear it on the way to action_wounded / action_critically_wounded
-- (stalker_base_action.cpp:24-29).
local function _try_play_heal_anim(npc, gesture)
    if not cfg.healing_anim_enabled then return end
    if xcombat.actor_dist_sqr(npc) > ANIM_RADIUS_SQR then return end
    if npc:best_enemy() then
        if at_trace.on() then at_trace.dbg("[HEAL] anim skipped id=%d reason=combat", npc:id()) end
        return
    end
    if IsWounded(npc) or npc:critically_wounded() then
        if at_trace.on() then at_trace.dbg("[HEAL] anim skipped id=%d reason=wounded", npc:id()) end
        return
    end
    if npc:movement_type() ~= move.stand then
        if at_trace.on() then at_trace.dbg("[HEAL] anim skipped id=%d reason=moving", npc:id()) end
        return
    end
    if npc:animation_count() > 0 then
        if at_trace.on() then at_trace.dbg("[HEAL] anim skipped id=%d reason=queued", npc:id()) end
        return
    end
    utils_obj.add_anim(npc, gesture)
    if at_trace.on() then at_trace.dbg("[HEAL] anim id=%d gesture=%s", npc:id(), gesture) end
end

-- t165: a fight must be able to end. True while the NPC is actively ENGAGED - a live enemy with
-- the weapon in his hands (the state_mgr.script:396 read: active_item + weapon_unstrapped), or an
-- enemy inside contact range regardless of weapon (a mutant mauling him; the reporter's melee-lock
-- case, where punch damage lost to a 3x heal refill and the fight could not resolve). One tick per
-- ~6s per healing NPC pays 2-4 luabind reads here.
local ENGAGED_MELEE_SQR = 5 * 5
local function _engaged(npc)
    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return false end
    if npc:active_item() and npc:weapon_unstrapped() then return true end
    return npc:position():distance_to_sqr(enemy:position()) <= ENGAGED_MELEE_SQR
end

-- t165 PAUSE while engaged: reset THIS event's timer so it stays queued (the caller returns false) -
-- no health applied, no tick consumed, the charge waits. Re-creating under the same key from
-- inside the callback would be a no-op (CreateTimeEvent skips existing keys, _g.script:345,
-- and the firing event is removed only after a true return, :374) and would kill the chain.
-- Healing resumes on the same cadence once the fight lets go. Bleed staunching (_patched_heal_bleed)
-- deliberately stays vanilla: pausing it would turn every pressed fight into a bleed-out
-- lottery - a larger balance swing than the unwinnable-stalemate fix needs.
local function _try_pause_hp(npc, id, name, left)
    if not _engaged(npc) then return false end
    if at_trace.on() then at_trace.dbg("[HEAL] hp_pause id=%d left=%d engaged", id, left) end
    ResetTimeEvent(id, name .. "_self_healing_event_hp_" .. left, level.get_time_factor())
    return true
end

-- Chain-end debug line: why this heal chain stopped (dead, despawned, or ticks spent).
local function _log_hp_complete(tmr, npc, id, left)
    if not at_trace.on() then return end
    local reason = "ticks_exhausted"
    if npc == nil then
        reason = "no_obj"
    elseif not npc:alive() then
        reason = "dead"
    end
    at_trace.dbg("[HEAL] complete id=%d reason=%s left=%d [%.2fms]", id, reason, left, tmr:get_ms())
end

-- Vanilla xr_eat_medkit.heal_hp (script:188-201) with MCM rate multiplier.
-- Reschedules via xr_eat_medkit.heal_hp lookup so the chain stays on the patched function.
local function _patched_heal_hp(id, left)
    local tmr = xprofiler.new_if(at_trace.on()):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        -- The master toggle is live: off = exact vanilla semantics (flat 0.05, no gesture) through
        -- the same installed function, so an MCM flip applies on the next tick, no restart.
        local enabled = cfg.healing_enabled ~= false
        local name = npc:name()
        if enabled and _try_pause_hp(npc, id, name, left) then
            tmr:stop()
            return false
        end
        local mult = enabled and cfg.heal_rate_multiplier or 1
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        if enabled and left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_MEDKIT)
        end
        tmr:stop()
        if at_trace.on() then
            at_trace.dbg("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, name .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        tmr:stop()
        _log_hp_complete(tmr, npc, id, left)
    end
    return true
end

-- Vanilla xr_eat_medkit.heal_bleed (script:203-215) with logging only.
-- Engine bleeding field is a hard set per tick, not a delta -- no multiplier.
local function _patched_heal_bleed(id, left)
    local tmr = xprofiler.new_if(at_trace.on()):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        npc.bleeding = 0.07
        -- The gesture is the only above-vanilla piece here; the bleeding set matches vanilla, so
        -- the live master toggle gates the gesture alone.
        if cfg.healing_enabled ~= false and left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_BANDAGE)
        end
        tmr:stop()
        if at_trace.on() then
            at_trace.dbg("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        tmr:stop()
        if at_trace.on() then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            at_trace.dbg("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- xr_eat_medkit.consume_medkit save-wrap, logging only: the real-item-vs-charge proof. A non-nil
-- medkit is a REAL inventory item the vanilla path is about to release (alife_release_id,
-- xr_eat_medkit.script:218-221); nil is the per-rank healing_charge fallback (no item existed).
-- This line is what distinguishes "they heal with real medkits" from silent magic healing.
local _orig_consume

local function _patched_consume(npc, medkit, kind)
    if at_trace.on() and npc then
        at_trace.dbg("[HEAL] consume id=%d item=%s kind=%s",
            npc:id(), medkit and medkit:section() or "CHARGE", tostring(kind))
    end
    return _orig_consume(npc, medkit, kind)
end

local function _install_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        at_trace.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _patched_heal_hp
    xr_eat_medkit.heal_bleed = _patched_heal_bleed
    if xr_eat_medkit.consume_medkit then
        _orig_consume = xr_eat_medkit.consume_medkit
        xr_eat_medkit.consume_medkit = _patched_consume
    end
    _heal_active = true
    at_trace.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    at_trace.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
    at_trace.info("[PATCH] xr_eat_medkit.consume_medkit wrapped (item-vs-charge trace)")
end

-- Install-once guard for the wounded-consume wrap. Module-local, so it resets with the Lua VM on
-- every game start / load / level change (script-loading.md); it only matters under -keep_lua, where
-- the VM persists across loads and on_game_start re-runs against an already-wrapped method.
local _wounded_wrapped = false

-- Hook one method on a luabind class object. Reading a method off the class returns the bound method
-- as a plain callable; luabind's __newindex accepts re-registering it, and every instance dispatches
-- through the class (there is no per-instance method copy), so the swap reaches instances created
-- afterward. Returns the captured original (call it as original(self, ...)), or nil if absent.
-- Kept local: this is AT's own mechanism, not an xlibs dependency.
local function _hook_method(class_obj, name, wrapper)
    if not class_obj then return nil end
    local original = class_obj[name]
    if type(original) ~= "function" then return nil end
    class_obj[name] = function(...) return wrapper(original, ...) end
    return original
end

-- The four medkit sections Cwound_manager:eat_medkit releases, in its exact fallback priority
-- (xr_wounded.script:282-289). The wrapper reports whichever the NPC holds, or `none` for the faked
-- heal (health set to full with no medkit in inventory).
local WOUNDED_MEDKITS = { "medkit_script", "medkit", "medkit_army", "medkit_scientic" }
local function _held_medkit_section(npc)
    for i = 1, #WOUNDED_MEDKITS do
        if npc:object(WOUNDED_MEDKITS[i]) then return WOUNDED_MEDKITS[i] end
    end
    return "none"
end

-- Wrapper for Cwound_manager:eat_medkit -- the wounded-DOWN recovery (xr_wounded.script:271-308),
-- distinct from xr_eat_medkit's standing self-heal. It sets health to full and releases one medkit,
-- firing no engine eat, so nothing else observes it: this trace is the only signal for medkits handed
-- to a wounded NPC via the help dialog or burned by the 90s autoheal. Read the held section BEFORE the
-- original releases it (sec is set only when tracing is on); log only on a true return (an actual
-- consume). Always calls through; trace-off is a pure pass-through.
local function _patched_wounded_eat(orig, self)
    local sec
    if at_trace.on() and self and self.npc then
        sec = _held_medkit_section(self.npc)
    end
    local ret = orig(self)
    if ret and sec then
        at_trace.dbg("[HEAL] wounded_consume id=%d item=%s", self.npc:id(), sec)
    end
    return ret
end

-- Cwound_manager lives on the xr_wounded module table (not _G), so touch xr_wounded first to force
-- its chunk (which defines the class) to load, then wrap the method. Runs at on_game_start in a fresh
-- VM, so the captured original is always vanilla; the guard covers the -keep_lua re-run. A missing
-- class (non-standard xr_wounded overlay) degrades to a warn + no trace, never an error.
local function _install_wounded_trace()
    if _wounded_wrapped then return end
    local _ = xr_wounded and xr_wounded.unlock_medkit
    local class_obj = xr_wounded and xr_wounded.Cwound_manager
    local original = class_obj and _hook_method(class_obj, "eat_medkit", _patched_wounded_eat)
    if not original then
        at_trace.warn("[PATCH] xr_wounded.Cwound_manager.eat_medkit unavailable; wounded-consume trace off")
        return
    end
    _wounded_wrapped = true
    at_trace.info("[PATCH] xr_wounded.Cwound_manager.eat_medkit wrapped (wounded-consume trace)")
end

-- Per-rank charge override of vanilla's flat 50% roll at xr_eat_medkit.script:36-44.
-- Vanilla's bug (re-roll on every save load) is suppressed in zzz_at_healing_patch.script.
local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    -- Live master toggle: no charge roll (and no processed marker) while off, so a later ON rolls
    -- this NPC on its next spawn. Vanilla's own roll stays unregistered either way
    -- (zzz_at_healing_patch) - the re-roll bug must not return when the toggle is off.
    if cfg.healing_enabled == false then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local tmr = xprofiler.new_if(at_trace.on()):start()
    local id = npc:id()
    local name = npc:name()
    if _safe_load(id, name, "at_charge_processed") then
        tmr:stop()
        if at_trace.on() then
            at_trace.dbg("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, tmr:get_ms())
        end
        return
    end
    _safe_save(id, name, "at_charge_processed", true)

    local tier = _rank_tier(npc)
    local chance = (cfg["charge_chance_" .. tier] or 50) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _safe_save(id, name, "healing_charge", granted)
    tmr:stop()
    if at_trace.on() then
        at_trace.dbg("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", tmr:get_ms())
    end
end

-- Hurt pose for the active weapon posture slot, variant by the commanded gait.
local function _pick_limp_anim(npc, mt)
    local tbl = (mt == move.walk and LIMP_WALK_BY_SLOT)
             or (mt == move.run  and LIMP_RUN_BY_SLOT)
             or LIMP_IDLE_BY_SLOT
    return tbl[npc:active_slot()] or tbl[0]
end

-- Drop one NPC's record and release the skeleton. clear_animations wipes only the script queue
-- (script_game_object3.cpp:466-476); the next engine update resumes its own animation selection.
local function _drop_limp(npc, id, reason, us)
    _limping[id] = nil
    if npc:alive() then npc:clear_animations() end
    if at_trace.on() then at_trace.dbg("[LIMP] lost id=%d hp=%.2f reason=%s [%dus]", id, npc.health, reason, us or -1) end
end

-- In combat = an enemy is selected OR the NPC is no longer calm (mental left free). The limp only starts
-- while calm (the eligibility chain), so either flip means a fight began. One predicate so the start gate
-- and the fast drop share the same definition of "in combat".
local function _in_combat(npc)
    return npc:best_enemy() ~= nil or npc:mental_state() ~= anim.free
end

-- The drop detectors, on their own 200ms clock. While a script animation is queued the engine
-- SUSPENDS its whole animation selection: update_impl returns right after play_script
-- (stalker_animation_manager_update.cpp:232) so play_torso/play_legs never run, and the script bone
-- mask covers every part but the head (stalker_animation_manager.cpp:97). The legs only look alive
-- while the skeleton loops the last-fed cycle, so an overlay outliving its gait freezes or slides the
-- body. Detectors: wounded/dead; the commanded gait changed from the add-time one; a stand-variant
-- NPC drifted off its add-time anchor; a walk/run-variant NPC stopped displacing (path ended with the
-- command still up). Returns true when the record was dropped.
local function _try_drop_limp(npc, id, rec, tg)
    local tmr = xprofiler.new_if(at_trace.on()):start()
    if not npc:alive() or IsWounded(npc) or npc:critically_wounded() then
        tmr:stop()
        _drop_limp(npc, id, "wounded_or_dead", tmr:get_us())
        return true
    end
    -- Combat drop on the FAST clock (this detector runs every pass; the enemy/mental gate otherwise sits
    -- on the throttled eligibility chain, ~1s): the instant a fight begins, drop the overlay now, not up to
    -- a second later. A limp still playing when the NPC is shot is what pins the body and slides it.
    if _in_combat(npc) then
        tmr:stop()
        _drop_limp(npc, id, "combat", tmr:get_us())
        return true
    end
    if rec.mt == nil then tmr:stop() return false end
    if npc:movement_type() ~= rec.mt then
        tmr:stop()
        _drop_limp(npc, id, "gait_changed", tmr:get_us())
        return true
    end
    local pos = npc:position()
    if rec.mt == move.stand then
        if rec.anchor and pos:distance_to_sqr(rec.anchor) > LIMP_MOVE_SQR then
            tmr:stop()
            _drop_limp(npc, id, "moved", tmr:get_us())
            return true
        end
        tmr:stop()
        return false
    end
    if (tg - (rec.sample_ms or 0)) < LIMP_SAMPLE_MS then tmr:stop() return false end
    local displaced = rec.last_pos == nil or pos:distance_to_sqr(rec.last_pos) > LIMP_MOVE_SQR
    rec.sample_ms = tg
    rec.last_pos = pos
    if not displaced then
        tmr:stop()
        _drop_limp(npc, id, "stopped", tmr:get_us())
        return true
    end
    tmr:stop()
    return false
end

-- [LIMP] decline aggregate, debug only: for HURT stalkers that failed eligibility, count the first
-- failing gate and summarize one line per window - the flood-free answer to "why is nobody limping"
-- (a per-decline line would be one per hurt NPC per second). The reads duplicate the eligibility
-- chain's, on the debug path only, so the live chain keeps its short-circuit shape.
local _limp_declines = { n = 0, far = 0, enemy = 0, mental = 0, standing = 0, wounded = 0, smart_cover = 0, zombied = 0, other = 0 }
local LIMP_DECLINE_WINDOW = 100

-- The first eligibility gate this hurt NPC fails, re-derived in the eligibility chain's order.
local function _limp_decline_reason(npc)
    if xcombat.actor_dist_sqr(npc) > ANIM_RADIUS_SQR then return "far" end
    if npc:best_enemy() then return "enemy" end
    if npc:mental_state() ~= anim.free then return "mental" end
    if npc:body_state() ~= move.standing then return "standing" end
    if IsWounded(npc) then return "wounded" end
    if npc:in_smart_cover() then return "smart_cover" end
    if xcreature.community(npc) == "zombied" then return "zombied" end
    return "other"
end

local function _limp_note_decline(npc)
    local counts = _limp_declines
    local reason = _limp_decline_reason(npc)
    counts[reason] = counts[reason] + 1
    counts.n = counts.n + 1
    if counts.n >= LIMP_DECLINE_WINDOW then
        at_trace.dbg("[LIMP] declined n=%d far=%d enemy=%d mental=%d standing=%d wounded=%d smart_cover=%d zombied=%d other=%d",
            counts.n, counts.far, counts.enemy, counts.mental, counts.standing, counts.wounded, counts.smart_cover, counts.zombied, counts.other)
        counts.n, counts.far, counts.enemy, counts.mental, counts.standing, counts.wounded, counts.smart_cover, counts.zombied, counts.other = 0, 0, 0, 0, 0, 0, 0, 0, 0
    end
end

-- One NPC's slice of the limp monitor pass: the drop detectors run on the pass itself (the pass
-- period IS the drop clock), the eligibility chain self-throttles to its slower period on the
-- roster record's stamp.
local function _run_limp_check(npc, id, state, tg)
    local rec = _limping[id]
    if rec and _try_drop_limp(npc, id, rec, tg) then return end
    if state.eligibility_at and tg < state.eligibility_at then return end
    state.eligibility_at = tg + LIMP_ELIGIBILITY_CHECK_MS
    local tmr = xprofiler.new_if(at_trace.on()):start()
    local eligible = IsStalker(npc)
        and npc:alive()
        and xcombat.actor_dist_sqr(npc) <= ANIM_RADIUS_SQR
        and not npc:in_smart_cover()
        and npc.health < cfg.limping_health_threshold
        and not npc:best_enemy()
        and npc:mental_state() == anim.free
        and npc:body_state() == move.standing
        and xcreature.community(npc) ~= "zombied"
        and not IsWounded(npc)

    if not eligible then
        tmr:stop()
        if at_trace.on() and IsStalker(npc) and npc:alive() and npc.health < cfg.limping_health_threshold then
            _limp_note_decline(npc)
        end
        if not _limping[id] then return end
        _drop_limp(npc, id, "not_eligible", tmr:get_us())
        return
    end
    rec = _limping[id]
    if not rec then
        rec = { next_add_ms = 0 }
        _limping[id] = rec
        if at_trace.on() then tmr:stop() at_trace.dbg("[LIMP] gained id=%d hp=%.2f [%dus]", id, npc.health, tmr:get_us()) end
    end
    if tg < rec.next_add_ms then return end
    if npc:animation_count() > 0 then return end

    local mt = npc:movement_type()
    local anim_name = _pick_limp_anim(npc, mt)
    utils_obj.add_anim(npc, anim_name)
    rec.next_add_ms = tg + LIMP_REARM_MS
    rec.mt = mt
    rec.anchor = npc:position()
    rec.last_pos = nil
    rec.sample_ms = tg
    if at_trace.on() then
        tmr:stop()
        local slot = npc:active_slot()
        local wpn  = npc:active_item()
        local sect = wpn and wpn:section() or "none"
        at_trace.dbg("[LIMP] anim id=%d name=%s slot=%d section=%s hp=%.2f [%dus]",
            id, anim_name, slot, sect, npc.health, tmr:get_us())
    end
end

-- The limp monitor pass, a vanilla time event every MONITOR_PERIOD_SEC: run the drop detectors and
-- the throttled eligibility chain on each tracked stalker. Per frame the whole limp system costs one
-- timer compare inside vanilla's own ProcessEventQueue walk; with the toggle off, one boolean per
-- pass. level.object_by_id is nil for a gone id - the roster entry dies with the NPC.
local _monitor_active = false

local function _run_monitor()
    if not _monitor_active then return true end
    -- Re-arm FIRST: ProcessEventQueue has no error protection, so an expired event that errors would
    -- re-fire and re-error every frame, starving every time event in the game. Re-armed, a fault costs
    -- one aborted pass. Liveness inside the check (_try_drop_limp and the eligibility chain test alive
    -- before any engine combat read).
    ResetTimeEvent("at_firstaid", "monitor", MONITOR_PERIOD_SEC)
    if not cfg.limping_anim_enabled then return end
    local tg = time_global()
    for id, state in pairs(_npc_states) do
        local npc = level.object_by_id(id)
        if npc then _run_limp_check(npc, id, state, tg) end
    end
end

-- Roster fill. Unconditional (the limp overlay is independent of the healing master toggle); the
-- per-rank charge roll rides the same spawn event behind its own _heal_active guard.
local function _on_roster_spawn(npc, se_obj)
    if not npc or not IsStalker(npc) then return end
    _npc_states[npc:id()] = { eligibility_at = 0 }
    _on_net_spawn(npc, se_obj)
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    _npc_states[id] = nil
    -- The script-queue overlay dies with the game object; a kept record would fire a spurious
    -- drop off a stale anchor when the NPC re-onlines.
    _limping[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _limping[se_obj.id] = nil
    _npc_states[se_obj.id] = nil
end

local function _refresh_log()
    at_trace.refresh()
end

-- Time events do not survive a save load (_g.script header), so the monitor arms here, per session.
local function _on_actor_first_update()
    _limping = {}
    _refresh_log()
    if not _monitor_active then
        _monitor_active = true
        RemoveTimeEvent("at_firstaid", "monitor")
        CreateTimeEvent("at_firstaid", "monitor", MONITOR_PERIOD_SEC, _run_monitor)
    end
    if not _heal_active then return end
    at_trace.info("Health module initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        cfg.heal_rate_multiplier,
        cfg.charge_chance_novice,
        cfg.charge_chance_experienced,
        cfg.charge_chance_veteran,
        cfg.charge_chance_master)
end

function on_game_start()
    RegisterScriptCallback("npc_on_net_spawn",            _on_roster_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)

    -- Installed unconditionally: the patched bodies read cfg.healing_enabled per tick, so the MCM
    -- master toggle is live mid-session (off = exact vanilla semantics through the same functions).
    _install_heal_patch()
    _install_wounded_trace()
end

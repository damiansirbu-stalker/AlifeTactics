--- at_stance: Crouch override for sniper-class weapon carriers on static-cover firing ops

local RegisterScriptCallback, tonumber = RegisterScriptCallback, tonumber

local log = xlog.get_logger("AT.STANCE", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- kind=w_sniper LTX classifier matches all designated-marksman and bolt-action rifles in
-- vanilla (SKS, Mosin, SVT40, K98, SVD, SR25, etc, ~19 files) plus GAMMA additions. Vanilla
-- ships zero LTX files with kind=w_launcher; RPG/GP-25 are kind=w_explosive. Sniper-class
-- doctrine (static crouched fire) covers this set.
local CROUCH_KINDS = {
    w_sniper = true,
}

-- EBodyState (ai_monster_space.h)
local BS_CROUCH = 0
local BS_STAND  = 1

-- Of all EWorldOperators that call body_state_combat_override in stalker_combat_actions.cpp,
-- only LookOut and HoldPosition are static-cover firing ops. Subsequent KillEnemy,
-- WaitInCover, HoldAmbushLocation inherit body_state without re-entering the functor
-- (stalker_combat_actions.cpp:442-459 KillEnemy::initialize does not call set_body_state).
local OP_LOOKOUT       = 22
local OP_HOLD_POSITION = 23

local OVERRIDE_OPS = {
    [OP_LOOKOUT]       = true,
    [OP_HOLD_POSITION] = true,
}

-- Capture any prior installer so we compose instead of silently overriding.
local _prev_functor = nil

-- Engine calls with (npc, wo, body_state) per stalker_movement_manager_base_inline.h:51-59.
local function _on_combat_set_body_state(npc, wo, body_state)
    local tmr = xprofiler.new_if(_dbg):start()

    if _prev_functor then
        local prev_result = _prev_functor(npc, wo, body_state)
        if prev_result ~= nil then body_state = prev_result end
    end

    if not cfg.stance_enabled then tmr:stop(); return body_state end
    if not OVERRIDE_OPS[wo] then tmr:stop(); return body_state end
    if body_state ~= BS_STAND then
        tmr:stop()
        if _dbg then
            local wpn_ec = npc and npc:active_item() or nil
            local sect_ec = wpn_ec and wpn_ec:section() or "none"
            log.debug("[STANCE] ENGINE_CROUCH id=%d op=%d section=%s body_state=%d",
                npc and npc:id() or 0, wo, sect_ec, body_state)
        end
        return body_state
    end
    if not npc then tmr:stop(); return body_state end

    local wpn = npc:active_item()
    if not wpn then tmr:stop(); return body_state end
    local section = wpn:section()
    if not section then tmr:stop(); return body_state end
    local kind = ini_sys:r_string_ex(section, "kind")
    if not kind or not CROUCH_KINDS[kind] then tmr:stop(); return body_state end

    tmr:stop()
    if _dbg then
        local weapon_class = ini_sys:r_string_ex(section, "weapon_class") or "nil"
        local scope_status = tonumber(ini_sys:r_string_ex(section, "scope_status")) or -1
        local silenc       = tonumber(ini_sys:r_string_ex(section, "silencer_status")) or -1
        local rank         = ranks.get_obj_rank_name(npc) or "none"
        log.debug("[STANCE] FLIP id=%d op=%d section=%s kind=%s wclass=%s scope=%d silenc=%d rank=%s stand->crouch [%.3fms]",
            npc:id(), wo, section, kind, weapon_class, scope_status, silenc, rank, tmr:get_ms())
    end
    return BS_CROUCH
end

local function _refresh_config()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_first_update()
    _refresh_config()
    log.info("Combat Crouch initialized (enabled=%s, dbg=%s)",
        cfg.stance_enabled and "true" or "false", _dbg and "true" or "false")
end

function on_game_start()
    if _G.CAI_Stalker__CombatSetBodyState
        and _G.CAI_Stalker__CombatSetBodyState ~= _on_combat_set_body_state then
        _prev_functor = _G.CAI_Stalker__CombatSetBodyState
    end
    _G.CAI_Stalker__CombatSetBodyState = _on_combat_set_body_state

    RegisterScriptCallback("actor_on_first_update",     _on_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_config)
end

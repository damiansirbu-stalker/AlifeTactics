--- at_combat_doctrine: the pure decision half of the combat takeover. Data + pure functions only - no
--- engine class, no per-NPC store, no callbacks. Given a per-scan context and a per-NPC slot it answers
--- "what should this NPC do": the registered checks (each a predicate + period), which maneuver answers a
--- fired check (each maneuver declares the checks it handles; the palette inverts that and pick() rolls a
--- random eligible one), where the destination is (resolve, by move), and the posture/speed roll. The shell
--- (at_combat.script) owns the GOAP classes, the single scan, the slot store, and the xcombat commands.
---
--- Behavior is emergent, not flagged: a faction reacts to a check only if some maneuver in its palette
--- handles it. No cover maneuver in a faction's palette = it never takes cover. The only per-faction data is
--- the faction tag on each maneuver. Tunables load via load_config (called by the shell on_game_start).

local pairs, ipairs, math_floor = pairs, ipairs, math.floor
local math_random, math_sqrt = math.random, math.sqrt
local character_community, vector = character_community, vector

at_combat_doctrine = at_combat_doctrine or {}

-- xcombat fire-mode aliases (the weapon state the engine runs)
local SHOOT, SNIPE, STOW = xcombat.FIRE, xcombat.SNIPE, xcombat.STOW
local STAND, CROUCH      = xcombat.STAND, xcombat.CROUCH
local STILL, WALK, RUN   = xcombat.STILL, xcombat.WALK, xcombat.RUN

-- Weapon buckets
local BUCKET_SNIPER, BUCKET_CLOSE, BUCKET_RIFLE = "SNIPER", "CLOSE", "RIFLE"

-- LTX token -> xcombat fire constant (the doctrine LTX uses lowercase tokens).
local FIRE_TOKENS = { shoot = SHOOT, snipe = SNIPE, stow = STOW }

-- Split a comma/space-separated LTX list into an array of tokens (whitespace trimmed).
local function _split(raw)
    local out = {}
    if raw then for tok in raw:gmatch("[^,%s]+") do out[#out + 1] = tok end end
    return out
end

-- Set form (token -> true). The _upper variant keys the bucket/env tokens the palette matches on.
local function _split_set(raw)
    local set = {}
    for _, tok in ipairs(_split(raw)) do set[tok] = true end
    return set
end

local function _split_set_upper(raw)
    local set = {}
    for _, tok in ipairs(_split(raw)) do set[tok:upper()] = true end
    return set
end


-- =========================================================================
-- LTX paths. Numeric tunables live in at_combat_config.ltx; the maneuver catalog in
-- at_combat_doctrine.ltx. Both loaded by load_config (the shell calls it on_game_start).
-- =========================================================================

local CONFIG_PATH    = "alifetactics\\at_combat_config.ltx"
local CONFIG_SECTION = "at_combat"
local DOCTRINE_PATH    = "alifetactics\\at_combat_doctrine.ltx"
local DOCTRINE_SECTION = "doctrine"

local GRENADE_MS, FRIENDLY_THRESH_M, RANGE_HYSTERESIS_M, HURT_FRAC, CROUCH_CHANCE, RUN_CHANCE
local ADVANCE_STANDOFF_M, BACK_STEP_M, STEP_BACK_M, FLANK_LAT_M, FLANK_FWD_M
local SQUAD_BUCKETS, STANCE_HOLD_MS

-- Maneuver catalog, filled from at_combat_doctrine.ltx. Each entry: handles (the checks it answers),
-- move (destination resolver), fire (xcombat mode), factions / weapons / env selection sets.
-- Filled in place so the exported reference stays valid.
local MANEUVERS = {}
at_combat_doctrine.MANEUVERS = MANEUVERS

local function _load_maneuvers()
    local ini = ini_file(DOCTRINE_PATH)
    local names = _split(ini:r_string_ex(DOCTRINE_SECTION, "maneuvers"))
    for idx = 1, #names do
        local name = names[idx]
        MANEUVERS[name] = {
            handles  = _split_set(ini:r_string_ex(name, "handles")),
            move     = ini:r_string_ex(name, "move"),
            fire     = FIRE_TOKENS[ini:r_string_ex(name, "fire")],
            factions = _split_set(ini:r_string_ex(name, "factions")),
            weapons  = _split_set_upper(ini:r_string_ex(name, "weapons")),
            env      = _split_set_upper(ini:r_string_ex(name, "env")),
        }
    end
end

function at_combat_doctrine.load_config()
    local ini = ini_file(CONFIG_PATH)
    local function f(k, d) return ini:r_float_ex(CONFIG_SECTION, k) or d end
    local function i(k, d) local v = ini:r_float_ex(CONFIG_SECTION, k); return v and math_floor(v) or d end
    GRENADE_MS         = i("grenade_ms",             3000)
    FRIENDLY_THRESH_M  = f("friendly_line_thresh_m", 1.5)
    RANGE_HYSTERESIS_M = f("range_hysteresis_m",     3)
    HURT_FRAC          = f("hurt_frac",              0.25)
    CROUCH_CHANCE      = f("crouch_chance",          0.30)
    RUN_CHANCE         = f("run_chance",             0.30)
    ADVANCE_STANDOFF_M = f("advance_standoff_m",     10)
    BACK_STEP_M        = f("back_step_m",            12)
    STEP_BACK_M        = f("step_back_m",            6)
    FLANK_LAT_M        = f("flank_lateral_m",        12)
    FLANK_FWD_M        = f("flank_forward_m",        6)
    SQUAD_BUCKETS      = i("squad_buckets",          5)
    STANCE_HOLD_MS     = i("stance_hold_ms",         5000)
    _load_maneuvers()
end


local function _is_stationary(maneuver) return maneuver.move == "hold" end
at_combat_doctrine.is_stationary = _is_stationary
function at_combat_doctrine.is_cover(maneuver)
    local move = maneuver.move
    return move == "cover" or move == "flank_cover" or move == "advance_cover"
end


-- =========================================================================
-- Palette: filter the catalog by (community, weapon bucket, environment) into a check -> maneuver-list map.
-- =========================================================================

local function _weapon_bucket(kind)
    if xcombat.SNIPER_KINDS[kind] then return BUCKET_SNIPER end
    if xcombat.AGGRESSOR_KINDS[kind] then return BUCKET_CLOSE end
    return BUCKET_RIFLE
end

-- Append a maneuver under each check it handles (check -> list of eligible maneuver names).
local function _add_handlers(pal, name, handles)
    for check in pairs(handles) do
        local list = pal[check]
        if not list then list = {} pal[check] = list end
        list[#list + 1] = name
    end
end

local function _build_palette(community, bucket, env)
    local pal = {}
    for name, m in pairs(MANEUVERS) do
        local fac_ok = (m.factions == nil) or m.factions[community]
        local wpn_ok = (m.weapons == nil) or m.weapons[bucket]
        local env_ok = (m.env == nil) or m.env[env]
        if fac_ok and wpn_ok and env_ok then _add_handlers(pal, name, m.handles) end
    end
    return pal
end

-- Check -> a random eligible maneuver from the palette, or nil. The roll is cached per slot so it holds until
-- the palette rebuilds (no per-pick thrash); different NPCs still roll different maneuvers.
function at_combat_doctrine.pick(check, slot)
    local list = slot.palette and slot.palette[check]
    if not list then return nil end
    if #list == 1 then return list[1] end
    local chosen = slot.event_pick[check]
    if not chosen then
        chosen = list[math_random(#list)]
        slot.event_pick[check] = chosen
    end
    return chosen
end


-- =========================================================================
-- Checks. Each is a predicate + period. The shell runs every check whose period elapsed once the current
-- maneuver is done, shuffles among the true ones, and fires its maneuver through the palette. engage is the
-- opener: true only while no maneuver has been picked this fight (slot.maneuver nil).
-- =========================================================================

-- Read the engagement geometry fresh: NPC position, enemy track position (live when seen, else last-known from
-- memory), and the flat distance between them. No cache - just a few cheap getters; if two checks (or a check
-- and the resolver) want it on the same pass, they re-read, which is fine. The shared reader the geometry
-- checks (wall / friendly / too_close) and the move resolvers all call. slot.sees is the throttled see cache,
-- kept current by the aim check and by any check that calls can_see this pass.
local function _geom(npc, enemy, slot)
    local npc_pos   = npc:position()
    local enemy_pos = xcombat.enemy_track_pos(npc, enemy, slot.sees)
    local dx, dz    = enemy_pos.x - npc_pos.x, enemy_pos.z - npc_pos.z
    return npc_pos, enemy_pos, math_sqrt(dx*dx + dz*dz)
end

-- Each check reads only what it needs, when its period fires. Signature (npc, enemy, slot, tg) - no shared
-- read-all phase. is_too_close updates the range hysteresis here (its only consumer) from a fresh distance and
-- the weapon band. is_blocked_wall / is_enemy_unseen read the throttled see cache via at_combat.can_see, passed
-- in as slot.sees by the aim check; is_blocked_wall also confirms with a fresh static ray.
local CHECKS = {
    { name = "engage",              speed = "react", pred = function(_, _, s, _) return s.maneuver == nil end },
    { name = "is_grenade_near",     speed = "react", pred = function(npc, _, _, tg)
        local bd = npc:best_danger()
        return bd ~= nil and bd:type() == danger_object.grenade and (tg - bd:time()) <= GRENADE_MS
    end },
    { name = "is_too_close",        speed = "react", pred = function(npc, enemy, s, _)
        local _, _, dist = _geom(npc, enemy, s)
        local band = xcombat.get_weapon_range(xcombat.get_weapon_kind(npc) or "w_rifle")
        return at_combat_doctrine.range_zone(s, band, dist) == "CLOSE"
    end },
    { name = "is_target_changed",   speed = "react", pred = function(_, enemy, s, _) return s.enemy_id ~= nil and enemy:id() ~= s.enemy_id end },
    { name = "is_hurt",             speed = "react", pred = function(npc, _, _, _) return npc.health < HURT_FRAC end },
    { name = "is_blocked_wall",     speed = "react", pred = function(npc, enemy, s, _)
        if s.sees then return false end
        local npc_pos, enemy_pos = _geom(npc, enemy, s)
        return xcombat.has_occluder_between(npc_pos, enemy_pos)
    end },
    { name = "is_blocked_friendly", speed = "react", pred = function(npc, enemy, s, _)
        local npc_pos, enemy_pos = _geom(npc, enemy, s)
        return xcombat.has_friendly_in_line(npc, npc_pos, enemy_pos, FRIENDLY_THRESH_M)
    end },
    { name = "is_enemy_unseen",     speed = "slow",  pred = function(_, _, s, _) return not s.sees end },
}
at_combat_doctrine.CHECKS = CHECKS


-- =========================================================================
-- Movement resolution, dispatched by move. Returns a destination vertex or nil (nil -> the shell holds).
-- =========================================================================

-- Unit NPC->enemy direction from the geometry the resolver already read. Allocates one vector for find_point /
-- find_cover (per maneuver commit, not per tick).
local function _dir_to(npc_pos, enemy_pos, dist)
    local inv = dist > 0 and (1 / dist) or 0
    return vector():set((enemy_pos.x - npc_pos.x) * inv, 0, (enemy_pos.z - npc_pos.z) * inv)
end

local function _res_hold(npc) return npc:level_vertex_id() end

local function _res_cover(npc, enemy, slot)
    local _, enemy_pos = _geom(npc, enemy, slot)
    return xcombat.find_cover(npc, enemy_pos)
end

-- advance_open: a point on the NPC->enemy line, standoff metres short of the enemy (committed, walked in full).
local function _res_advance_open(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist <= ADVANCE_STANDOFF_M then return npc:level_vertex_id() end
    return xcombat.find_point(npc, _dir_to(npc_pos, enemy_pos, dist), dist - ADVANCE_STANDOFF_M)
end

-- advance_cover: cover anchored at that same forward point (radial best_cover for now; t92 makes it directional).
local function _res_advance_cover(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist <= ADVANCE_STANDOFF_M then return xcombat.find_cover(npc, enemy_pos) end
    local reach = dist - ADVANCE_STANDOFF_M
    local dir = _dir_to(npc_pos, enemy_pos, dist)
    return xcombat.find_cover(npc, enemy_pos,
        vector():set(npc_pos.x + dir.x * reach, npc_pos.y, npc_pos.z + dir.z * reach))
end

local function _res_withdraw(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist < 1 then return npc:level_vertex_id() end
    local dir = _dir_to(npc_pos, enemy_pos, dist)
    return xcombat.find_point(npc, vector():set(-dir.x, 0, -dir.z), BACK_STEP_M)
end

local function _res_step_back(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist < 1 then return npc:level_vertex_id() end
    local dir = _dir_to(npc_pos, enemy_pos, dist)
    return xcombat.find_point(npc, vector():set(-dir.x, 0, -dir.z), STEP_BACK_M)
end

local function _res_step_side(npc, enemy, slot)
    local _, enemy_pos = _geom(npc, enemy, slot)
    return xcombat.find_shot(npc, enemy_pos)
end

-- Flank offset: lateral (side by squad bucket parity, so squadmates fan to opposite sides) + forward bias
-- toward the enemy. Shared by both flank resolvers; takes the direction the resolver already read.
local function _flank_offset(dir, slot)
    local sign = (slot.bucket % 2 == 0) and 1 or -1
    local fx = -dir.z * sign * FLANK_LAT_M + dir.x * FLANK_FWD_M
    local fz =  dir.x * sign * FLANK_LAT_M + dir.z * FLANK_FWD_M
    return fx, fz
end

-- Open flank: the bare lateral+forward point.
local function _res_flank(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist < 1 then return npc:level_vertex_id() end
    local fx, fz = _flank_offset(_dir_to(npc_pos, enemy_pos, dist), slot)
    local mag = math_sqrt(fx * fx + fz * fz)
    if mag < 1 then return npc:level_vertex_id() end
    return xcombat.find_point(npc, vector():set(fx / mag, 0, fz / mag), mag)
end

-- Cover flank: seek cover at the flank point (find_cover anchored at the offset, not at the NPC).
local function _res_flank_cover(npc, enemy, slot)
    local npc_pos, enemy_pos, dist = _geom(npc, enemy, slot)
    if dist < 1 then return npc:level_vertex_id() end
    local fx, fz = _flank_offset(_dir_to(npc_pos, enemy_pos, dist), slot)
    return xcombat.find_cover(npc, enemy_pos,
        vector():set(npc_pos.x + fx, npc_pos.y, npc_pos.z + fz))
end

local MOVE_RESOLVERS = {
    hold = _res_hold, cover = _res_cover, advance_open = _res_advance_open, advance_cover = _res_advance_cover,
    withdraw = _res_withdraw, step_back = _res_step_back, step_side = _res_step_side,
    flank = _res_flank, flank_cover = _res_flank_cover,
}

-- Resolve a maneuver's destination vertex. Each resolver reads its own geometry; a move with no resolver, or a
-- resolver that finds nothing, holds on the NPC's own node (never fails to vanilla).
function at_combat_doctrine.resolve(maneuver, npc, enemy, slot)
    local resolver = MOVE_RESOLVERS[maneuver.move]
    return resolver and resolver(npc, enemy, slot) or npc:level_vertex_id()
end


-- =========================================================================
-- Posture (stand/crouch) + speed (still/walk/run) per maneuver. The crouch/stand choice is what flickered when
-- maneuvers re-committed fast, so it is held per NPC for STANCE_HOLD_MS (vanilla keep_body_state cadence);
-- movement stays per-maneuver (a hold is still, a move walks or runs). xcombat.resolve_stance snaps the
-- preference to a combo the engine ships, so this function holds no state-matrix knowledge.
-- =========================================================================

function at_combat_doctrine.roll(slot, fire, stationary, tg)
    if not slot.crouch_until or tg >= slot.crouch_until then
        slot.want_crouch  = math_random() < CROUCH_CHANCE
        slot.crouch_until = tg + STANCE_HOLD_MS
    end
    local posture = slot.want_crouch and CROUCH or STAND
    local movement
    if stationary then
        movement = STILL
    elseif math_random() < RUN_CHANCE then
        movement = RUN
    else
        movement = WALK
    end
    return xcombat.resolve_stance(fire, posture, movement)
end


-- =========================================================================
-- Range zone (hysteresis on the weapon band): CLOSE / IN / FAR. Drives is_too_close.
-- =========================================================================

function at_combat_doctrine.range_zone(slot, band, dist)
    local zone = slot.range_zone or "IN"
    if zone == "FAR" then
        if dist < band.max - RANGE_HYSTERESIS_M then zone = "IN" end
    elseif zone == "CLOSE" then
        if dist > band.min + RANGE_HYSTERESIS_M then zone = "IN" end
    else
        if dist > band.max then zone = "FAR"
        elseif dist < band.min then zone = "CLOSE" end
    end
    slot.range_zone = zone
    return zone
end


-- =========================================================================
-- Slot context refresh: weapon bucket / environment + the eligible-maneuver palette. Rebuilds the
-- palette only when (community, weapon bucket, env) changes. Fills the static fields once (community, squad,
-- spread bucket). is_context_changed is just this call detecting a changed key.
-- =========================================================================

function at_combat_doctrine.refresh(slot, npc)
    if not slot.community then
        slot.community = character_community(npc) or "stalker"
        local squad = xsquad.get_squad_by_member(npc:id())
        slot.squad_id = squad and squad.id or nil
        slot.bucket   = xcombat.get_squad_ordinal(slot.squad_id, npc:id()) % SQUAD_BUCKETS
        slot.event_pick = slot.event_pick or {}
    end
    local kind = xcombat.get_weapon_kind(npc) or "w_rifle"
    slot.weapon      = kind
    slot.bucket_name = _weapon_bucket(kind)
    local npc_lvid = npc:level_vertex_id()
    if slot._env_lvid ~= npc_lvid then
        slot._env_lvid = npc_lvid
        slot.env = xcombat.is_indoor(npc:position()) and "INDOOR" or "OUTDOOR"
    end
    local key = slot.community .. "|" .. slot.bucket_name .. "|" .. slot.env
    if key ~= slot.pal_key then
        slot.pal_key = key
        slot.palette = _build_palette(slot.community, slot.bucket_name, slot.env)
        slot.event_pick = {}
    end
end

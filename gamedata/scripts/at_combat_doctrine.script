--- at_combat_doctrine: the decision half of the v2 takeover - the maneuver catalog and its ordered checks.
--- No engine class, no per-NPC store, no callbacks - the shell (at_combat) owns the monitor pass, the state
--- store, and the graft. This file answers one question: which catalog row (if any) should make AT seize this
--- NPC now. A maneuver is a catalog row with two methods - check_need, the need: a cheap compare over
--- memoized reads that returns the situation name when the row's moment is here (never a raycast, a path
--- build or a search); and find_destination, the feasibility: owns the geometry and returns the destination
--- vertex when the maneuver is doable here (nil = not doable) - plus a faction/weapon palette and an update,
--- the periodic re-application the shell runs while the maneuver is open. The design law every row obeys:
--- the need states the FULL problem and the maneuver's success negates it, so a solved problem does not
--- re-fire and a recurred or unsolved one legitimately does - the trigger is the throttle, no cooldown
--- exists. resolve_maneuver arbitrates: it walks the catalog in priority order from state.row_cursor, skips
--- rows out of scope (each row declares whose problem it answers - vs_actor rows fire when the actor is the
--- ignored close threat, the rest when he is the selected enemy), falls through a row whose need is absent
--- in the SAME tick, and spends at most ONE find_destination per tick - decline or pick, the cursor moves past
--- that row, so a blocked row defers to the next candidate and a picked one hands the next decision to the
--- row below it (retreat first, then flee).

local math_sqrt, math_floor, vector = math.sqrt, math.floor, vector
local table_concat = table.concat
local time_global, AC_ID = time_global, AC_ID

at_combat_doctrine = at_combat_doctrine or {}

local cfg = at_mcm.cfg
local show = at_debug.show

local CONFIG_PATH    = "alifetactics\\at_combat_config.ltx"
local CONFIG_SECTION = "at_combat"

local HURT_FRAC, STALL_MS, STALL_MOVE_SQR, STALL_CLOSE_M
local KITE_ARC_DEG, KITE_SPREAD_DEG
local FLEE_MIN_DIST_M, FLEE_BASE_MIN_DIST_M, RETREAT_REAR_M, UNDER_FIRE_MS
local COUNTERFLANK_ACTOR_DIST_SQR, PICKOFF_TARGETED_DEG, PICKOFF_ENTER_FACTOR, REPEAT_LIMIT, RELOAD_STALE_MS, RELOAD_COVER_CONE_DEG

-- Displacement under this between two same-situation picks reads as "the transaction changed nothing"
-- (squared, flat - stairs do not read as movement).
local REPEAT_MOVE_M   = 2
local REPEAT_MOVE_SQR = REPEAT_MOVE_M * REPEAT_MOVE_M

-- The maneuver catalog: an ordered array (array order = priority - resolve_maneuver walks it in order and
-- the first row whose need, palette, and feasibility all pass wins the tick). Built in load_config so
-- xcombat.* constants and the LTX tunables are resolved.
local CATALOG = {}


-- find_destination methods (feasibility). Each owns its geometry and returns a destination level vertex, or nil
-- when the maneuver is not doable here - the return IS the gate, no separate predicate, and the vertex
-- feasibility validated is the vertex the engine executes (resolve once, never re-resolve). Run only after
-- the row's need and palette pass, and at most ONE runs per begin tick (the walk ends when a find_destination
-- runs). All of them read the walk's shared geometry (memo.npc_pos / memo.enemy_pos / state.dist) instead
-- of re-probing.

-- Per-weapon kite back-off in metres: a kiting stalker retreats this far, full stop - a visible
-- fighting withdrawal that always ends well outside his weapon minimum. Replaces the
-- minimum-minus-distance arithmetic that produced 2m hops (2026-07-09).
local KITE_BACK = {
    w_melee = 4, w_shotgun = 4, w_pistol = 5, w_smg = 6, w_rifle = 8, w_sniper = 15, w_explosive = 8,
}

-- kite: back off a weapon-set distance, still firing - the shotgunner takes 4m, the rifleman 8, the
-- sniper 15. find_flee_lane runs the two-phase search: straight-back -> +-45 -> +-90 at the full
-- distance, the same fan at half distance, then the longest CLEAR straight stub; nil only when fully
-- boxed in. THE GUARANTEE (user ruling 2026-07-28): the destination is accepted only if standing on
-- it puts the enemy back OUTSIDE my weapon's minimum - the trigger's own quantity, measured
-- destination-to-enemy at decision time - so ARRIVING negates too_close by construction, and only
-- the enemy moving can re-create the problem (a fresh kite is then correct). This replaces two
-- earlier guards that could not guarantee it: weapon_min - dist (drops to zero exactly when the
-- trigger is strongest; 52 of 222 accepts under 2m, the 50-kite ping-pong class) and 0.4 x back_m
-- (a real withdrawal, but its endpoint could still be inside the minimum). A failing destination
-- declines instead; with every other row declining too, AT leaves the cornered NPC to vanilla,
-- which stands and fights (user-ruled 2026-07-26). memo.kind is set by _check_too_close, the only
-- need that opens this row.
local function _find_kite_lane(npc, _enemy, state, _tg, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dist = state.dist
    local dir
    if dist > 0 then
        dir = vector():set((np.x - ep.x) / dist, 0, (np.z - ep.z) / dist)
    else
        -- Zero separation: "away from the enemy" is undefined, so back out OPPOSITE the facing - a
        -- fighting NPC faces his enemy, and the old raw-facing fallback kited INTO him (f011).
        local fwd = xcombat.get_facing(npc)
        dir = vector():set(-fwd.x, 0, -fwd.z)
    end
    local back_m = KITE_BACK[memo.kind] or KITE_BACK.w_rifle
    local vid = xcombat.find_flee_lane(npc, dir, back_m, KITE_ARC_DEG, KITE_SPREAD_DEG)
    -- Every number the accept/decline decision reads, on both paths: back_m is the withdrawal the row asks
    -- find_flee_lane for, dest_enemy_m is the enemy's distance from the DESTINATION (the accept gate:
    -- must exceed min_m, my weapon's minimum - the trigger's own quantity), lane_m the withdrawal length.
    local min_m        = xcombat.get_weapon_range(memo.kind).min
    local vp           = vid and level.vertex_position(vid)
    local lane_m       = vp and math_sqrt(xmath.dist_flat_sqr(vp, np)) or -1
    local dest_enemy_m = vp and math_sqrt(xmath.dist_flat_sqr(vp, ep)) or -1
    if vid and dest_enemy_m <= min_m then
        at_debug.dbg("[CMB] can_kite id=%s name=%s dist=%.1f min_m=%.1f back_m=%.1f dest_enemy_m=%.2f lane_m=%.2f lane=%s result=short",
            show(state.id), show(state.name), dist or -1, min_m, back_m, dest_enemy_m, lane_m, show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_kite id=%s name=%s dist=%.1f min_m=%.1f back_m=%.1f dest_enemy_m=%.2f lane_m=%.2f lane=%s result=%s",
        show(state.id), show(state.name), dist or -1, min_m, back_m, dest_enemy_m, lane_m,
        show(vid or "none"), vid and "taken" or "no_lane")
    return vid
end

-- The pickoff premise beyond the range geometry: a hold is for the unbothered. "under_fire" - a fresh hit
-- (state.hit_at within UNDER_FIRE_MS) or a perceived shot from the enemy (the NPC's own danger memory);
-- "targeted" - the actor's aim is on him (facing offset under PICKOFF_TARGETED_DEG; a motionless head under
-- a player's crosshair is a gift regardless of range). Checked at feasibility (the luabind reads live off
-- the cascade path, the same placement as flee's _flee_blocked) and re-checked while the hold runs (the
-- row's check_end) - a broken premise ends the hold now, not at the cap. Returns the reason, or nil.
local function _pickoff_blocked(npc, enemy, state, tg, npc_pos)
    if has_recent_hit(state, tg, UNDER_FIRE_MS) then return "under_fire" end
    if xcombat.is_under_fire(npc, enemy, tg, UNDER_FIRE_MS) then return "under_fire" end
    if db.actor and xcombat.is_facing(db.actor, npc_pos, PICKOFF_TARGETED_DEG) then return "targeted" end
    return nil
end

-- pickoff: a deliberate-fire HOLD on the NPC's own node, only comfortably past the ENEMY's EFFECTIVE
-- range - the distance where his weapon is still genuinely dangerous, not where bullets stop existing
-- (a shotgun blast at 25m still arrives, spread thin), so the advantage is statistical, never immunity,
-- and the break-offs stay strict. Range hysteresis, 2 thresholds: ENTER only past effective range x
-- PICKOFF_ENTER_FACTOR; the check_end re-check ENDS the hold when the enemy closes inside 1.0x (his
-- weapon is dangerous again). Between the two nothing flaps. Declines while its premise is broken
-- (_pickoff_blocked: under fire or under the actor's aim). ends_on=time runs it to the hold timeout.
-- fire=FIRE at STILL, and set_combat's fire discipline downgrades it to READY when a shot makes no
-- sense (occluded / no LOS), so a holder without a lane stands weapon-up instead of firing at a wall.
-- A weaponless enemy (a mutant) has no kind and reads as the rifle band, so pickoff only plants on it
-- past 80m x factor - conservative, and a melee mutant that far away is no threat to a standing shooter.
local function _find_pickoff_spot(npc, enemy, state, tg, memo)
    local blocked = _pickoff_blocked(npc, enemy, state, tg, memo.npc_pos)
    if blocked then
        at_debug.dbg("[CMB] can_pickoff id=%s name=%s dist=%.1f enemy_max=unknown result=%s",
            show(state.id), show(state.name), state.dist or -1, show(blocked))
        return nil
    end
    local enemy_band = xcombat.get_weapon_range(xcombat.get_weapon_kind(enemy) or "w_rifle")
    local planted = state.dist > enemy_band.max * PICKOFF_ENTER_FACTOR
    at_debug.dbg("[CMB] can_pickoff id=%s name=%s dist=%.1f enemy_max=%s result=%s",
        show(state.id), show(state.name), state.dist or -1, show(enemy_band.max), planted and "plant" or "in_effective_range")
    if not planted then return nil end
    state.pickoff_exit_sqr = enemy_band.max * enemy_band.max
    return npc:level_vertex_id()
end

-- The pickoff premise re-check while the hold runs (the catalog row's check_end, on the 200ms end check):
-- the same terms _find_pickoff_spot gated on, plus the hysteresis exit - the enemy closing inside his own
-- EFFECTIVE range (stashed at feasibility) makes his weapon dangerous again and ends the hold now.
-- A hit landing or the actor's crosshair arriving mid-hold ends it with that reason - a standing
-- shooter does not sit through being shot at.
local function _check_end_pickoff(npc, enemy, state, tg)
    local pos = npc:position()
    local blocked = _pickoff_blocked(npc, enemy, state, tg, pos)
    if blocked then return blocked end
    if state.pickoff_exit_sqr and enemy and xmath.dist_flat_sqr(pos, enemy:position()) < state.pickoff_exit_sqr then
        return "in_effective_range"
    end
    return nil
end

-- counterflank: the actor-party row - an enemy actor at near-contact range while this NPC's committed fight
-- is someone FARTHER than him (shooting past the man who can kill him first, the enemy_manager's seen-now
-- scoring artifact: a seen distant target outranks the unseen man on his shoulder, enemy_manager.cpp:110-175).
-- A HOLD on his own node: aim at the actor, the turn makes him SEEN, and seen at contact range wins the
-- engine's own selection outright - at hand-back best_enemy IS the actor, which is what negates the need
-- (the transaction's success is the engine changing its mind). No feasibility geometry: the old wall
-- raycast was structurally blind across the whole trigger radius (its clearances left it unable to
-- report an obstacle below ~3.75m while the row fires inside 5m - f008), so the row pays for no test
-- that cannot decline; the real close gate is the need's own floor (_check_actor_close).
local function _find_counterflank_spot(npc, _enemy, state, _tg, _memo)
    at_debug.dbg("[CMB] can_counterflank id=%s name=%s path=taken", show(state.id), show(state.name))
    return npc:level_vertex_id()
end

-- reload_cover: the vulnerable-window reposition (t135, the n031 consumer). A reloading NPC in the
-- PLAYER'S line of fire moves to cover instead of standing in the open - the engine finishes the
-- reload on its own timer during the move. Order: the authoritative reload confirm FIRST
-- (xcombat.is_reloading over get_state - the event stamp the need read can be stale when the stop
-- edge was missed on a detached weapon), then the exposure gate: xcombat.actor_can_hit - the player
-- holds a firearm, faces him within RELOAD_COVER_CONE_DEG, and the shot line is clear. The leading
-- indicator, scope-correct for a player-only maneuver (the earlier hit/heard-shot/danger evidence
-- counted fire from ANY source - third-party crossfire fed a player-scoped decision - and reacted
-- only after the danger had materialized). Reloading out of the player's line declines: vanilla
-- reloads in place, per the t135 spec. Then the cover search at
-- his own position (concealment via best_cover, no firing sweep and no rear bias - out of the open, not a firing spot)
-- with the claim/release pairing retreat uses (state.cover_lvid, released on every exit).
local function _find_reload_cover(npc, _enemy, state, _tg, memo)
    if not xcombat.is_reloading(npc) then
        state.reloading = nil
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=not_reloading cover=-", show(state.id), show(state.name))
        return nil
    end
    if not xcombat.actor_can_hit(npc, RELOAD_COVER_CONE_DEG) then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=actor_no_shot cover=-", show(state.id), show(state.name))
        return nil
    end
    local vid = xcombat.find_cover(npc, memo.enemy_pos, { selection = "nearest", firing = false, radius = 5, search_pos = npc:position() })
    if not vid then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=no_cover cover=-", show(state.id), show(state.name))
        return nil
    end
    if not xcombat.claim_cover(vid, state.id) then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=claim_lost cover=%s", show(state.id), show(state.name), show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=taken cover=%s", show(state.id), show(state.name), show(vid))
    state.cover_lvid = vid
    return vid
end

-- The reload_cover premise while it runs: the reload ending (the stop edge clears state.reloading) hands
-- the NPC back NOW - his gun is up again and vanilla's own fire is better than finishing our walk at
-- READY. A missed stop edge leaves a stale stamp; the arrival/cap ends those.
local function _check_end_reload_cover(_npc, _enemy, state, _tg)
    if state.reloading then return nil end
    return "reload_done"
end

-- retreat: a firing pull-back to cover BEHIND the NPC. The search centers RETREAT_REAR_M behind him (along the
-- enemy->npc line) so candidates come from the half a retreating man uses, and the winning vertex is accepted
-- only when it is farther from the enemy than he stands - a retreat always grows the distance, toward-the-shooter
-- cover declines. find_cover returns a free firing vertex; claim it so no other AT NPC picks the same spot, and
-- record it on state so _end_maneuver releases the reservation on EVERY exit (t136). nil when no rear cover is
-- reachable or the claim loses a race - the find_destination return IS the viability gate.
local function _find_retreat_cover(npc, _enemy, state, _tg, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dx, dz = np.x - ep.x, np.z - ep.z
    local dist_sqr = dx * dx + dz * dz
    local center = np
    if dist_sqr > 0 then
        local inv = RETREAT_REAR_M / state.dist
        center = vector():set(np.x + dx * inv, np.y, np.z + dz * inv)
    end
    local vid = xcombat.find_cover(npc, ep, { selection = "best", firing = true, radius = 7, search_pos = center })
    if not vid then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=no_cover cover=- cover_dist=-1.0 npc_dist=-1.0",
            show(state.id), show(state.name))
        return nil
    end
    local vp = level.vertex_position(vid)
    local vdx, vdz = vp.x - ep.x, vp.z - ep.z
    local cover_dist_sqr = vdx * vdx + vdz * vdz
    if cover_dist_sqr <= dist_sqr then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=toward_enemy cover=%s cover_dist=%.1f npc_dist=%.1f",
            show(state.id), show(state.name), show(vid), math_sqrt(cover_dist_sqr), state.dist or -1)
        return nil
    end
    if not xcombat.claim_cover(vid, state.id) then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=claim_lost cover=%s cover_dist=-1.0 npc_dist=-1.0",
            show(state.id), show(state.name), show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_retreat id=%s name=%s path=taken cover=%s cover_dist=%.1f npc_dist=%.1f",
        show(state.id), show(state.name), show(vid), math_sqrt(cover_dist_sqr), state.dist or -1)
    state.cover_lvid = vid
    return vid
end

-- flee: a timid faction routs out of the fight to a friendly base in the distance - a smart terrain its enemies do
-- not hold, biased to the rear hemisphere (passing the enemy position biases the base search away from it), so the
-- rout runs far via real navmesh pathing instead of a short hop. The flee row holsters (fire=STOW -> sprint) and its
-- update re-asserts it, so the NPC turns its back and cannot fire while it runs. Declines when too close to
-- the shooter (turning your back point-blank is suicide) or when no friendly base is reachable. Ends like any
-- row - arrival, the timeout cap, or a lost target; on hand-back vanilla drives, so a flee that reached distance
-- stays gone (the engine's own enemy-distance gate holds) and one that capped in place fights back.
-- The rout gates that are not geometry: a standing squadmate (a rout is for the last man - a squadded timid
-- NPC answers pressure with retreat, the row above flee) or fresh incoming fire (a hit within UNDER_FIRE_MS via
-- state.hit_at, or a perceived shot from this enemy - nobody turns his back mid-burst; a blocked flee defers
-- the cursor and is re-asked a lap later, so the rout fires once the shooting pauses). Returns the decline
-- reason for the trace, or nil when clear to rout.
local function _flee_blocked(npc, enemy, state)
    if not xsquad.is_last_man(npc:id()) then return "squad_stands" end
    local tg = time_global()
    if has_recent_hit(state, tg, UNDER_FIRE_MS) then return "under_fire" end
    if xcombat.is_under_fire(npc, enemy, tg, UNDER_FIRE_MS) then return "under_fire" end
    return nil
end

-- memo.faction is set by the flee row's palette check, which always runs before this method.
local function _find_flee_base(npc, enemy, state, _tg, memo)
    local blocked = _flee_blocked(npc, enemy, state)
    if blocked then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=%s", show(state.id), show(state.name), show(blocked))
        return nil
    end
    -- Point-blank gate: do not flee with the shooter in your face (< flee_min_dist). Turning your back to run to a
    -- far base at point-blank range is suicide; vanilla fights it out at range instead.
    if state.dist < FLEE_MIN_DIST_M then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=too_close", show(state.id), show(state.name))
        return nil
    end
    -- Target a friendly base in the distance (a smart the enemy does not hold), biased to the rear hemisphere so the
    -- rout increases distance instead of curving back past the enemy. A far base's winding path no longer swings the
    -- facing back - the update's holster re-assert holds the NPC facing its run path the whole way.
    -- get_actor_level_id scopes the base search to the CURRENT level, not to the actor as a target:
    -- a fleeing NPC is online (the monitor tracks online NPCs only), and online NPCs are on the actor's level by
    -- construction, so this is the one level the rout can path on.
    local base = xsmart.find_friendly_base(memo.faction, memo.npc_pos,
        { level_id = xlevel.get_actor_level_id(), away_from_pos = memo.enemy_pos, min_distance = FLEE_BASE_MIN_DIST_M })
    if base then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=base", show(state.id), show(state.name))
        local vid = base.m_level_vertex_id
        if not vid or vid >= 4294967295 then vid = level.vertex_id(base.position) end
        return vid
    end
    at_debug.dbg("[CMB] can_flee id=%s name=%s path=no_base", show(state.id), show(state.name))
    return nil
end


-- One application of a maneuver's combat state, dispatched on the row's fire INTENT (no name read). The
-- fire discipline lives inside xcombat.set_combat (mechanism, not policy): a FIRE/SNIPE intent degrades to
-- READY when no shot makes sense - AT holds zero fire logic. The shell calls it once at begin
-- (at_combat._begin_maneuver); the rows reference it as their update, so it re-runs on the update_maneuver
-- check. Returns (applied fire, fire-gate verdict: seen/blocked/memory/hold/na) straight from the primitive, for the trace.
local function _apply_state(npc, maneuver, enemy)
    return xcombat.set_combat(npc, {
        fire = maneuver.fire, posture = maneuver.posture, movement = maneuver.movement, enemy = enemy,
    })
end
at_combat_doctrine.apply_state = _apply_state


-- True once the NPC has held position (moved less than stall_move) for stall_ms while the enemy is not closing
-- (distance not dropping by more than stall_close). Resets its timer on any move or on the enemy gaining ground,
-- so it fires only on a genuine standoff - the one spot vanilla holds where AT wants to push. Reuses one cached
-- vector for the held position, so the predicate allocates nothing on the monitor's hot path.
local function _eval_stalled(state, tg, npc_pos, dist)
    if not state.stall_pos then state.stall_pos = vector() end
    -- Flat, same metric as the repeat limit (stairs do not read as movement) - the two stall
    -- trackers measured the same concept with contradictory metrics until 2026-07-27 (f011).
    local held    = state.stall_set and xmath.dist_flat_sqr(npc_pos, state.stall_pos) <= STALL_MOVE_SQR
    local closing = state.stall_dist and dist < state.stall_dist - STALL_CLOSE_M
    if not held or closing then
        state.stall_pos:set(npc_pos)
        state.stall_dist = dist
        state.stall_since = tg
        state.stall_set = true
        return false
    end
    return (tg - state.stall_since) >= STALL_MS
end


-- check_need methods (need) - the cheap compares that open a row. Allowed reads: the walk memo and
-- O(1) state (positions, distance, health, weapon kind, relation) - never a raycast, a path build or a
-- cover/base search; find_destination owns those. Each states the row's FULL problem and returns the situation
-- NAME that holds (the begin trace's trigger field, the rows= walk) or nil - and a nil falls through to
-- the NEXT row in the SAME tick, so a row whose need is absent never consumes a decision slot. Shared
-- reads come off the walk memo: my kind, the enemy's kind, faction, and the actor reads resolve once per
-- walk. The success-negates-the-need law: every term here is chosen so the maneuver's completion makes
-- the need read false (kite clears its own minimum, retreat/flee push past the enemy's reach, counterflank flips
-- the engine's selection, a finished hold resets the stall measurement).

-- too_close: the enemy is inside the NPC's own weapon minimum. Complete as-is - the need IS a proximity
-- statement on my own weapon, and the kite's back-off ends well outside the minimum by construction.
local function _check_too_close(npc, _enemy, state, _tg, memo)
    if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
    if xcombat.is_inside_minimum(state.dist, memo.kind) then return "too_close" end
    return nil
end

-- reloading: the NPC's own weapon is mid-reload (the n031 event stamp at_combat writes on the reload
-- edges - a pure-Lua read on the walk, zero luabind). Bounded by RELOAD_STALE_MS from the start edge
-- because the stop edge is best-effort (a weapon detached mid-reload fires nothing); the feasibility
-- re-confirms with the authoritative get_state read. Success negates the need by time: the maneuver
-- outlives the ~2s reload (arrival or the reload-done premise ends it), so a completed reload_cover
-- cannot re-fire until a NEW reload starts. On an exe without the events the stamp never sets and the
-- row is inert. The under-fire half of the full problem (reloading in the OPEN) is the feasibility's
-- first gate - its reads cost luabind, which the need path is forbidden.
local function _check_reloading(_npc, _enemy, state, tg, _memo)
    if not state.reloading then return nil end
    if (tg - (state.reload_at or 0)) > RELOAD_STALE_MS then return nil end
    return "reloading"
end

-- hurt: health under HURT_FRAC AND the enemy inside HIS OWN weapon's reach - hurt alone was never the
-- problem; hurt with him close enough to keep hurting you is. The reach term is what makes a completed
-- retreat or flee negate the need (the accepted cover/base is farther by construction), so a solved
-- pressure does not re-fire and a re-closing enemy legitimately does. A weaponless enemy (a mutant)
-- reads as the rifle band, the standing convention.
local function _check_hurt(npc, enemy, state, _tg, memo)
    if memo.hurt == nil then memo.hurt = xcombat.get_health_frac(npc) < HURT_FRAC end
    if not memo.hurt then return nil end
    if memo.enemy_kind == nil then memo.enemy_kind = xcombat.get_weapon_kind(enemy) or "w_rifle" end
    if xcombat.is_inside_reach(state.dist, memo.enemy_kind) then return "hurt" end
    return nil
end

-- stalled: held position with the enemy not closing (_eval_stalled) for STALL_MS SINCE the last maneuver
-- (a transaction resets the tracker, so a finished hold negates its own need), AND the enemy inside MY
-- weapon's EFFECTIVE range - a standoff my weapon can exploit. The tracker runs on every walk that
-- reaches the pickoff row, so the stall memory stays warm across declined walks.
local function _check_stalled(npc, _enemy, state, tg, memo)
    if not _eval_stalled(state, tg, memo.npc_pos, state.dist) then return nil end
    if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
    local band = xcombat.get_weapon_range(memo.kind)
    if state.dist < band.min or state.dist > band.max then return nil end
    return "stalled"
end

-- actor_close: an enemy actor inside COUNTERFLANK_ACTOR_DIST while my committed fight is someone FARTHER than him
-- - the threat ordering is inverted and my back or side is what he sees. All pure math over the walk memo
-- (the actor position resolves once per walk); the relation luabind is last and paid only inside the
-- radius. Success is the engine's: the turn makes the actor SEEN and seen-at-contact wins his selection,
-- so at hand-back best_enemy IS the actor and the walk's scope retires this row.
-- OPEN DEFECT (f008): 56 of 119 counterflanks in the 2026-07-27 session ended cap-with-0-shots -
-- the sight manager never takes the ordered look target and the turn never starts (the direction
-- gate at state_mgr.script:318 then withholds every shot). Root cause pending the sight=/stype=
-- trace data (user ruling 2026-07-28: no trigger suppression; diagnose first, then fix the cause).
local function _check_actor_close(npc, _enemy, state, _tg, memo)
    local ap = memo.actor_pos
    if ap == nil then
        if not db.actor then return nil end
        ap = db.actor:position()
        memo.actor_pos = ap
    end
    local np = memo.npc_pos
    local dx, dz = ap.x - np.x, ap.z - np.z
    local actor_dist_sqr = dx * dx + dz * dz
    if actor_dist_sqr > COUNTERFLANK_ACTOR_DIST_SQR then return nil end
    if state.dist * state.dist <= actor_dist_sqr then return nil end
    if memo.actor_enemy == nil then memo.actor_enemy = xcreature.is_enemy_to_actor(npc) end
    if not memo.actor_enemy then return nil end
    return "actor_close"
end


-- Ordered array = the priority (user-set 2026-07-10, flee above retreat 2026-07-11): counterflank FIRST
-- - an ignored enemy actor at contact range outranks every other problem; reload_cover SECOND - a
-- reloading NPC under fire is at his most vulnerable and the window is ~2s, so it outranks the pressure
-- rows (a hurt AND reloading NPC takes cover first, then the pressure need re-fires if still standing);
-- flee THIRD - the rout is the FIRST pressure answer for the cowardly factions (its palette), and a
-- blocked rout (under fire / squad stands / no base) defers via the cursor to retreat - the coward
-- fights from cover only when he cannot run; retreat FOURTH - the brave factions' pressure answer (they
-- fall through flee's palette in the same tick and lose nothing to its position); kite FIFTH (a violated
-- weapon minimum); pickoff LAST (a pressed NPC retreats, only the merely-stalled one plants).
-- factions/weapons nil = match any. vs_actor marks
-- the row whose problem is the ACTOR (walked only when he is NOT the selected enemy; the shell stages
-- him as the committed target). update = the row's periodic re-application; every row re-applies its
-- combat state (a firing row re-checks its shot, flee re-asserts its holster). check_end = the row's
-- premise re-check while it runs (pickoff only).
local function _build_catalog(read_int)
    return {
        {
            -- counterflank: stop shooting past the man who can kill you first. A 3s hold: aim at the actor,
            -- the turn makes him seen, the engine's own selection flips, vanilla drives the new fight.
            name           = "counterflank",
            toggle         = "maneuver_counterflank",
            vs_actor       = true,
            check_need = _check_actor_close,
            factions       = nil,
            weapons        = nil,
            find_destination   = _find_counterflank_spot,
            update         = _apply_state,
            fire           = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on        = "time",
            timeout        = read_int("counterflank_max_ms", 3000),
        },
        {
            -- reload_cover: a reloading NPC under fire runs to the nearest cover instead of standing in
            -- the open; the engine finishes the reload on its own timer during the move. fire=READY (he
            -- cannot shoot mid-reload; the weapon comes up at hand-back), movement=RUN (the window is
            -- ~2s). check_end hands back the moment the reload finishes; not under fire declines at
            -- feasibility and vanilla reloads in place. Inert on exes without the n031 reload events.
            name           = "reload_cover",
            toggle         = "maneuver_reload_cover",
            check_need = _check_reloading,
            factions       = nil,
            weapons        = nil,
            find_destination   = _find_reload_cover,
            update         = _apply_state,
            check_end     = _check_end_reload_cover,
            fire           = xcombat.READY, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on        = "arrival",
            timeout        = read_int("maneuver_max_ms", 8000),
        },
        {
            -- flee: the rout, the cowardly factions' FIRST pressure answer (above retreat: a coward runs
            -- before he fights). Weapon HOLSTERED (STOW -> the sprint state: weapon strapped, mental=panic),
            -- re-asserted by the row's update, so the NPC turns its back and physically cannot fire while
            -- it runs. ecolog / clear sky / renegade only; everyone else falls through the palette in the
            -- same tick. A rout runs longer than a maneuver, so its cap (flee_max_ms) is longer than the
            -- mover stuck-cap.
            name           = "flee",
            toggle         = "maneuver_flee",
            check_need = _check_hurt,
            factions       = { ecolog = true, csky = true, renegade = true },
            weapons        = nil,
            find_destination   = _find_flee_base,
            update         = _apply_state,
            fire           = xcombat.STOW, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on        = "arrival",
            timeout        = read_int("flee_max_ms", 20000),
        },
        {
            -- retreat: answer pressure (hurt inside the enemy's reach) with a pull-back to rear cover,
            -- still firing - the brave factions' answer, and the cowardly ones' fallback when their rout
            -- is blocked (the cursor lands here after a declined flee). monolith and zombied get neither
            -- retreat nor flee - fanatics do not break.
            name           = "retreat",
            toggle         = "maneuver_retreat",
            check_need = _check_hurt,
            factions       = { army = true, dolg = true, freedom = true, killer = true, isg = true, stalker = true, bandit = true, greh = true, ecolog = true, csky = true, renegade = true },
            weapons        = nil,
            find_destination   = _find_retreat_cover,
            update         = _apply_state,
            fire           = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on        = "arrival",
            timeout        = read_int("maneuver_max_ms", 8000),
        },
        {
            name           = "kite",
            toggle         = "maneuver_kite",
            check_need = _check_too_close,
            factions       = nil,
            weapons        = nil,
            find_destination   = _find_kite_lane,
            update         = _apply_state,
            fire           = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on        = "arrival",
            timeout        = read_int("maneuver_max_ms", 8000),
        },
        {
            -- pickoff: any-firearm HOLD: ends_on=time (dest = own node, no arrival), runs to the hold
            -- timeout; check_end re-checks the premise (under fire / targeted / enemy back in range),
            -- ending a broken hold now, not at the cap. need_recheck=false: this row's success IS the
            -- stall-tracker reset, so a recheck reads pre-reset state - _trace_end prints "-" instead.
            name           = "pickoff",
            toggle         = "maneuver_pickoff",
            need_recheck   = false,
            check_need = _check_stalled,
            factions       = nil,
            weapons        = nil,
            find_destination   = _find_pickoff_spot,
            update         = _apply_state,
            check_end     = _check_end_pickoff,
            fire           = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on        = "time",
            timeout        = read_int("pickoff_hold_ms", 8000),
        },
    }
end

--- True when a hit landed on this NPC within window_ms - the landed-hit under-fire read over the
--- state.hit_at stamp (at_combat writes it on npc_on_hit). Window is caller policy.
function at_combat_doctrine.has_recent_hit(state, tg, window_ms)
    return state.hit_at ~= nil and (tg - state.hit_at) < window_ms
end

--- Load the tunables and (re)build the maneuver catalog. Called by the shell on_game_start; every key has
--- a script-side fallback. The catalog is built here so xcombat.* constants and the LTX values are ready.
function at_combat_doctrine.load_config()
    local ini = ini_file(CONFIG_PATH)
    local function read_float(k, d) return ini:r_float_ex(CONFIG_SECTION, k) or d end
    local function read_int(k, d) local v = ini:r_float_ex(CONFIG_SECTION, k) return v and math_floor(v) or d end
    HURT_FRAC      = read_float("hurt_frac",     0.40)
    STALL_MS       = read_int("stall_ms",        4000)
    local move_m   = read_float("stall_move_m",  2)
    STALL_MOVE_SQR = move_m * move_m
    STALL_CLOSE_M  = read_float("stall_close_m", 2)
    KITE_ARC_DEG    = read_int("kite_arc_deg",    45)
    KITE_SPREAD_DEG = read_int("kite_spread_deg", 90)
    RETREAT_REAR_M  = read_float("retreat_rear_m", 8)
    UNDER_FIRE_MS   = read_int("under_fire_ms",   2000)
    FLEE_MIN_DIST_M      = read_int("flee_min_dist_m",      5)
    FLEE_BASE_MIN_DIST_M = read_int("flee_base_min_dist_m", 100)
    local counterflank_dist_m    = read_float("counterflank_actor_dist_m",  5)
    COUNTERFLANK_ACTOR_DIST_SQR  = counterflank_dist_m * counterflank_dist_m
    PICKOFF_TARGETED_DEG = read_float("pickoff_targeted_deg", 10)
    PICKOFF_ENTER_FACTOR = read_float("pickoff_enter_factor", 1.2)
    RELOAD_COVER_CONE_DEG = read_float("reload_cover_cone_deg", 60)
    REPEAT_LIMIT        = read_int("repeat_limit", 3)
    RELOAD_STALE_MS      = read_int("reload_stale_ms", 6000)
    CATALOG = _build_catalog(read_int)
end


-- Faction/weapon palette for a row (nil = match any), reads memoized on the walk.
local function _palette_matches(row, npc, memo)
    if row.factions then
        if memo.faction == nil then memo.faction = xcreature.community(npc) end
        if not row.factions[memo.faction] then return false end
    end
    if row.weapons then
        if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
        if not row.weapons[memo.kind] then return false end
    end
    return true
end

-- The per-layer segment timer _check_row reads: the null object live (zero cost), swapped for a real
-- profiler by resolve_maneuver when tracing is on, so need= and dest= time separately.
local _seg = xprofiler.new_if(false)

-- One row's ordered check: scope first (one compare - the row walks only in the fight class whose problem
-- it answers: vs_actor rows when the actor is NOT the selected enemy, every other row when he IS; AT
-- seizes only problems the actor is party to, as row data) -> MCM toggle (one table read; live, so a
-- mid-fight flip holds from the next walk) -> check_need (need) -> palette -> find_destination
-- (feasibility geometry). Returns (dest, situation, stage, need_us, dest_us): dest non-nil = picked.
-- stage is the trace word for how far the row got ("scope" out of scope, "off" toggled off, "-" need
-- absent, "palette", "declined", "picked"). dest_us is non-nil exactly when find_destination RAN - the walk's
-- tick-over marker.
local function _check_row(row, npc, enemy, state, tg, memo)
    if (row.vs_actor or false) == memo.actor_fight then return nil, nil, "scope" end
    if cfg[row.toggle] == false then return nil, nil, "off" end
    _seg:reset() _seg:start()
    local situation = row.check_need(npc, enemy, state, tg, memo)
    _seg:stop()
    local need_us = _seg:get_us()
    if not situation then return nil, nil, "-", need_us end
    if not _palette_matches(row, npc, memo) then return nil, situation, "palette", need_us end
    _seg:reset() _seg:start()
    local dest = row.find_destination(npc, enemy, state, tg, memo)
    _seg:stop()
    local dest_us = _seg:get_us()
    if dest then return dest, situation, "picked", need_us, dest_us end
    return nil, situation, "declined", need_us, dest_us
end

-- Reset the per-walk memo on the state record: wipe the lazy reads (faction, my/enemy weapon kind, hurt,
-- the actor reads), compute the walk's scope class (actor_fight: is the selected enemy the actor - the
-- one compare every row's scope check reads), take this tick's positions, and compute the flat npc-enemy
-- distance every need and feasibility check shares (state.dist). One table per NPC, reused across walks -
-- no allocation on the monitor path.
local function _reset_memo(state, npc, enemy)
    local memo = state.memo
    if not memo then memo = {} state.memo = memo end
    memo.faction, memo.kind, memo.enemy_kind, memo.hurt = nil, nil, nil, nil
    memo.actor_pos, memo.actor_enemy = nil, nil
    memo.actor_fight = state.enemy_id == AC_ID
    local np, ep = npc:position(), enemy:position()
    memo.npc_pos, memo.enemy_pos = np, ep
    local dx, dz = ep.x - np.x, ep.z - np.z
    state.dist = math_sqrt(dx * dx + dz * dz)
    return memo
end

--- Arbitrate the catalog: walk the rows in priority order starting at state.row_cursor (per-NPC). A row
--- whose need is absent - out of scope (vs_actor vs the walk's fight class), check_need nil, toggle
--- off, palette mismatch - falls through to the NEXT row in the SAME tick, so a row that does not apply
--- never consumes a decision slot. The first row whose
--- need holds runs its find_destination - the ONE geometry probe this tick - and ends the walk either way: a
--- vertex stages the row, a nil declines the tick. In BOTH cases the cursor moves past that row, so a
--- declined row defers to the next candidate and retries after at most one lap (~catalog size x begin
--- period), and a picked row hands the NEXT decision to the row below it - a timid NPC whose flee
--- declined falls to retreat with no escalation state. The cursor resets to the top when the NPC leaves
--- the fight (at_combat). Cost per tick is bounded by construction: at most one lap of need compares
--- (microseconds) plus at most one find_destination. Positions and shared reads memoize on state.memo per
--- tick. When tracing is on, state.rows carries every examined row as "name:situation/stage" with
--- per-layer timings ("/need=Xus/dest=Yus") on the row whose find_destination ran, and state.walk_us the
--- whole walk's microseconds; the timers are null objects when tracing is off, zero cost live.
-- Format one examined row for the rows= trace: "name:situation/stage", plus the per-layer timings on the
-- one row whose find_destination ran (dest_us non-nil).
local function _row_trace(row, situation, stage, need_us, dest_us)
    local head = row.name .. ":" .. (situation and (situation .. "/" .. stage) or stage)
    if dest_us == nil then return head end
    return head .. "/need=" .. math_floor(need_us) .. "us/dest=" .. math_floor(dest_us) .. "us"
end

-- The repeat limit: a pick of the SAME situation with the NPC still within REPEAT_MOVE_M of the
-- previous pick means the last transaction changed nothing (the indoor kite ping-pong, a counterflank
-- whose hold failed to flip the selection); past the limit the pick is refused and vanilla owns him.
-- Displacement is the discriminator, never timing: a legitimate chain under a sprinting player re-fires
-- instantly too, but each transaction MOVED him, which resets the count. Release is world change, not a
-- clock - he moves 2m, the situation changes, or the fight ends (at_combat clears the record on fight
-- exit). Returns true when the pick must be refused.
local function _check_repeat_limit(state, situation, npc_pos)
    if REPEAT_LIMIT <= 0 then return false end
    local stuck = state.repeat_situation == situation and state.repeat_pos ~= nil
        and xmath.dist_flat_sqr(npc_pos, state.repeat_pos) <= REPEAT_MOVE_SQR
    if stuck then
        state.repeat_count = state.repeat_count + 1
    else
        state.repeat_situation = situation
        state.repeat_count = 1
        state.repeat_pos = state.repeat_pos or vector()
    end
    state.repeat_pos:set(npc_pos)
    if state.repeat_count <= REPEAT_LIMIT then return false end
    at_debug.dbg("[CMB] repeat id=%s name=%s situation=%s picks=%d - takeover suspended until the world changes",
        show(state.id), show(state.name), show(situation), state.repeat_count or -1)
    return true
end

--- Re-evaluate a row's need with a fresh memo - the maneuver-end need_cleared read (at_combat, debug
--- path only). Returns the situation still holding, or nil when the maneuver cleared the problem it fired
--- on. A row whose need still holds at hand-back is the churn signal: the maneuver ran but did not negate
--- its own trigger.
function at_combat_doctrine.recheck_need(row, npc, enemy, state, tg)
    if not (row and npc and enemy and row.check_need) then return nil end
    local memo = _reset_memo(state, npc, enemy)
    return row.check_need(npc, enemy, state, tg, memo)
end

function at_combat_doctrine.resolve_maneuver(npc, enemy, state, tg)
    local count = #CATALOG
    if count == 0 then return nil end
    local start = state.row_cursor or 1
    if start > count then start = 1 end
    local memo = _reset_memo(state, npc, enemy)
    local tracing = at_debug.on()
    local walk_timer = xprofiler.new_if(tracing)
    _seg = xprofiler.new_if(tracing)
    walk_timer:start()
    local rows_trace = tracing and {} or nil
    local spent_row, spent_vid, spent_situation
    for i = 0, count - 1 do
        local idx = (start + i - 1) % count + 1
        local row = CATALOG[idx]
        local vid, situation, stage, need_us, dest_us = _check_row(row, npc, enemy, state, tg, memo)
        if tracing then rows_trace[#rows_trace + 1] = _row_trace(row, situation, stage, need_us, dest_us) end
        if dest_us ~= nil then
            -- The row's find_destination ran: pick or decline, the tick is spent and the cursor moves past it.
            state.row_cursor = idx % count + 1
            spent_row, spent_vid, spent_situation = row, vid, situation
            break
        end
    end
    walk_timer:stop()
    if tracing then
        state.rows = table_concat(rows_trace, ",")
        state.walk_us = math_floor(walk_timer:get_us())
    end
    if not spent_vid then return nil end
    if _check_repeat_limit(state, spent_situation, memo.npc_pos) then
        -- The refused pick's find_destination may have claimed a cover vertex (retreat, reload_cover); no
        -- maneuver opens, so _end_maneuver never releases it - release here or the claim outlives the walk.
        if state.cover_lvid then
            xcombat.release_cover(state.cover_lvid, state.id)
            state.cover_lvid = nil
        end
        return nil
    end
    state.trigger = spent_situation
    return spent_row, spent_vid
end

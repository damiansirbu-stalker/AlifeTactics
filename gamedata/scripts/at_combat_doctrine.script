--- at_combat_doctrine: the decision half of the v2 takeover - the maneuver catalog and its ordered checks.
--- No engine class, no per-NPC store, no callbacks - the shell (at_combat) owns the monitor loop, the state
--- store, and the graft. This file answers one question: which catalog row (if any) should make AT seize this
--- NPC now. A maneuver is a catalog row: a situation predicate (the cheap compare that says the row's moment
--- is here), a faction/weapon palette, a resolver whose return IS the gate (a destination vertex = seize
--- there, nil = decline and fall through), and an update - the periodic re-application the shell runs while
--- the maneuver is open (nil = set once at begin). pick_maneuver walks the rows in order; the first full pass
--- wins (t141).

local math_sqrt, math_floor, vector = math.sqrt, math.floor, vector
local character_community, time_global, table_concat = character_community, time_global, table.concat

at_combat_doctrine = at_combat_doctrine or {}

local CONFIG_PATH    = "alifetactics\\at_combat_config.ltx"
local CONFIG_SECTION = "at_combat"

local HURT_FRAC, GRENADE_MS, STALL_MS, STALL_MOVE_SQR, STALL_CLOSE_M
local KITE_ARC_DEG, KITE_SPREAD_DEG
local FLEE_MIN_DIST_M, FLEE_BASE_MIN_DIST_M, RETREAT_REAR_M, UNDER_FIRE_MS

-- The maneuver catalog: an ordered array (array order = precedence - the walk stops at the first row whose
-- situation, palette, and resolver all pass). Built in load_config so xcombat.* constants and the LTX
-- tunables are resolved.
local CATALOG = {}


-- =========================================================================
-- Resolvers. A resolver reads its own geometry and returns a destination level vertex, or nil when the maneuver
-- is not viable here - the resolver IS the viability gate, no separate predicate. Run only on the seize path
-- (after situation + palette + backoff pass), so the raycasts cost only when AT is about to take the NPC. All
-- of them read the walk's shared geometry (memo.npc_pos / memo.enemy_pos / state.dist) instead of re-probing.
-- =========================================================================

-- kite: back off to the NPC's OWN weapon minimum - the shotgunner reclaims his 2m, the rifleman his 3, the
-- sniper walks back out to 10. The reseize cooldown keeps a re-triggered too_close from chaining takeovers.
-- find_flee_lane fans the heading straight-back -> +-45 -> +-90 and ray-checks each for a wall or obstacle,
-- first clear lane wins; nil only when fully boxed in (then the maneuver is not viable and AT declines).
-- memo.kind is set by _situation_too_close, the only situation that opens this row.
local function _resolve_kite(npc, _enemy, state, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dist = state.dist
    local dir = (dist > 0) and vector():set((np.x - ep.x) / dist, 0, (np.z - ep.z) / dist) or npc:direction()
    local band = xcombat.get_weapon_range(memo.kind)
    -- lane length = what the minimum is short by; floored at 2 because the lane search steps in 2m decrements.
    local back_m = band.min - dist
    if back_m < 2 then back_m = 2 end
    local vid = xcombat.find_flee_lane(npc, dir, back_m, KITE_ARC_DEG, KITE_SPREAD_DEG)
    at_combat_trace.resolve_kite(npc:id(), band.min, dist, back_m, vid)
    return vid
end

-- snipe: a precision-fire HOLD on the NPC's own node, only past the ENEMY's weapon maximum - he plants exactly
-- where the enemy cannot effectively answer (past 15m vs a shotgun, past 80m vs a rifle) and never gifts a
-- motionless head inside the enemy's working range. ends_on=time runs it to the hold timeout, not an arrival.
-- fire=SNIPE, and the fire gate in apply_state downgrades it to READY when a shot makes no sense (occluded /
-- no LOS), so a sniper without a lane holds weapon-up instead of firing at a wall.
-- A weaponless enemy (a mutant) has no kind and reads as the rifle band, so snipe only plants on it
-- past 80m - conservative, and a melee mutant past 80m is no threat to a planted sniper anyway.
local function _resolve_snipe(npc, enemy, state, _memo)
    local enemy_band = xcombat.get_weapon_range(xcombat.get_weapon_kind(enemy) or "w_rifle")
    local planted = state.dist > enemy_band.max
    at_combat_trace.resolve_snipe(npc:id(), state.dist, enemy_band.max, planted)
    if not planted then return nil end
    return npc:level_vertex_id()
end

-- retreat: a firing pull-back to cover BEHIND the NPC. The search centers RETREAT_REAR_M behind him (along the
-- enemy->npc line) so candidates come from the half a retreating man uses, and the winning vertex is accepted
-- only when it is farther from the enemy than he stands - a retreat always grows the distance, toward-the-shooter
-- cover declines. find_cover returns a free firing vertex; claim it so no other AT NPC picks the same spot, and
-- record it on state so _end_maneuver releases the reservation on EVERY exit (t136). nil when no rear cover is
-- reachable or the claim loses a race - the resolver IS the viability gate.
local function _resolve_retreat(npc, _enemy, state, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dx, dz = np.x - ep.x, np.z - ep.z
    local dist_sqr = dx * dx + dz * dz
    local center = np
    if dist_sqr > 0 then
        local inv = RETREAT_REAR_M / state.dist
        center = vector():set(np.x + dx * inv, np.y, np.z + dz * inv)
    end
    local vid = xcombat.find_cover(npc, ep, center)
    if not vid then
        at_combat_trace.resolve_retreat(npc:id(), "no_cover")
        return nil
    end
    local vp = level.vertex_position(vid)
    local vdx, vdz = vp.x - ep.x, vp.z - ep.z
    local cover_dist_sqr = vdx * vdx + vdz * vdz
    if cover_dist_sqr <= dist_sqr then
        at_combat_trace.resolve_retreat(npc:id(), "toward_enemy", vid, math_sqrt(cover_dist_sqr), state.dist)
        return nil
    end
    if not xcombat.claim_cover(vid, npc:id()) then
        at_combat_trace.resolve_retreat(npc:id(), "claim_lost", vid)
        return nil
    end
    at_combat_trace.resolve_retreat(npc:id(), "taken", vid, math_sqrt(cover_dist_sqr), state.dist)
    state.cover_lvid = vid
    return vid
end

-- flee: a timid faction routs out of the fight to a friendly base in the distance - a smart terrain its enemies do
-- not hold, biased to the rear hemisphere (passing the enemy position biases the base search away from it), so the
-- rout runs far via real navmesh pathing instead of a short hop. The flee row holsters (fire=STOW -> sprint) and its
-- update re-asserts it, so the NPC turns its back and cannot fire while it runs. Declines when too close to
-- the shooter (turning your back point-blank is suicide) or when no friendly base is reachable. The disengage that
-- stops vanilla re-selecting the enemy on hand-back is the flee hold opened in at_combat._begin_maneuver.
-- The rout gates that are not geometry: a standing squadmate (a rout is for the last man - the hurt NPC falls
-- through to retreat, flee sits before it in the catalog) or fresh incoming fire (a hit within UNDER_FIRE_MS via
-- state.hit_at, or a perceived shot from this enemy - nobody turns his back mid-burst; the begin check re-asks
-- and the rout fires in the lull). Returns the decline reason for the trace, or nil when clear to rout.
local function _flee_blocked(npc, enemy, state)
    local squad = xsquad.get_squad_by_member(npc:id())
    if squad and squad:npc_count() > 1 then return "squad_stands" end
    local tg = time_global()
    if state.hit_at and (tg - state.hit_at) < UNDER_FIRE_MS then return "under_fire" end
    if xcombat.is_under_fire(npc, enemy, tg, UNDER_FIRE_MS) then return "under_fire" end
    return nil
end

-- memo.faction is set by the flee row's palette check, which always runs before this resolver.
local function _resolve_flee(npc, enemy, state, memo)
    local blocked = _flee_blocked(npc, enemy, state)
    if blocked then
        if at_combat_trace.enabled() then at_combat_trace.resolve_flee(npc:id(), blocked) end
        return nil
    end
    -- Point-blank gate: do not flee with the shooter in your face (< flee_min_dist). Turning your back to run to a
    -- far base at point-blank range is suicide; vanilla fights it out at range instead.
    if state.dist < FLEE_MIN_DIST_M then
        if at_combat_trace.enabled() then at_combat_trace.resolve_flee(npc:id(), "too_close") end
        return nil
    end
    -- Target a friendly base in the distance (a smart the enemy does not hold), biased to the rear hemisphere so the
    -- rout increases distance instead of curving back past the enemy. A far base's winding path no longer swings the
    -- facing back - the update's holster re-assert holds the NPC facing its run path the whole way.
    -- get_actor_level_id scopes the base search to the CURRENT level, not to the actor as a target:
    -- a fleeing NPC is online (npc_on_update carrier), and online NPCs are on the actor's level by
    -- construction, so this is the one level the rout can path on.
    local base = xsmart.find_friendly_base(memo.faction, memo.npc_pos,
        { level_id = xlevel.get_actor_level_id(), away_from_pos = memo.enemy_pos, min_distance = FLEE_BASE_MIN_DIST_M })
    if base then
        if at_combat_trace.enabled() then at_combat_trace.resolve_flee(npc:id(), "base") end
        local vid = base.m_level_vertex_id
        if not vid or vid >= 4294967295 then vid = level.vertex_id(base.position) end
        return vid
    end
    if at_combat_trace.enabled() then at_combat_trace.resolve_flee(npc:id(), "no_base") end
    return nil
end


-- One application of a maneuver's combat state, dispatched on the row's fire intent (no name read). FIRE/SNIPE
-- use vanilla kill_enemy's order (stalker_combat_actions.cpp:483-494): enemy SEEN right now -> fire as asked,
-- no distance term (fire_make_sense's 2.5m point-blank bail is a smart-cover rule, wrong for open combat);
-- not seen -> fire_make_sense owns the blind case (occlusion at last-known, the 10s auto-weapon suppression
-- window) else READY. READY/STOW apply as asked, and a missing enemy faces the run path. The shell calls it
-- once at begin (at_combat._begin_maneuver); the rows reference it as their update, so it re-runs on the
-- update_maneuver check. Returns (applied fire, gate result: seen/true/false/na) for the trace.
-- The fire decision for a FIRE/SNIPE row, vanilla kill_enemy's order. Returns (fire to apply, gate value).
local function _gate_fire(npc, requested, enemy)
    if enemy and xcombat.sees(npc, enemy) then return requested, "seen" end
    if enemy and xcombat.fire_make_sense(npc, enemy) then return requested, "true" end
    return xcombat.READY, "false"
end

local function _apply_state(npc, maneuver, enemy)
    local requested = maneuver.fire
    local fire, gate = requested, "na"
    if requested == xcombat.FIRE or requested == xcombat.SNIPE then
        fire, gate = _gate_fire(npc, requested, enemy)
    end
    local aim = (requested == xcombat.READY or requested == xcombat.STOW or not enemy) and nil or enemy
    xcombat.set_combat(npc, { fire = fire, posture = maneuver.posture, movement = maneuver.movement, aim = aim })
    return fire, gate
end
at_combat_doctrine.apply_state = _apply_state


-- True once the NPC has held position (moved less than stall_move) for stall_ms while the enemy is not closing
-- (distance not dropping by more than stall_close). Resets its timer on any move or on the enemy gaining ground,
-- so it fires only on a genuine standoff - the one spot vanilla holds where AT wants to push. Reuses one cached
-- vector for the held position, so the predicate allocates nothing on the monitor's hot path.
local function _eval_stalled(state, tg, npc_pos, dist)
    if not state.stall_pos then state.stall_pos = vector() end
    local held    = state.stall_set and npc_pos:distance_to_sqr(state.stall_pos) <= STALL_MOVE_SQR
    local closing = state.stall_dist and dist < state.stall_dist - STALL_CLOSE_M
    if not held or closing then
        state.stall_pos:set(npc_pos)
        state.stall_dist = dist
        state.stall_since = tg
        state.stall_set = true
        return false
    end
    return (tg - state.stall_since) >= STALL_MS
end


-- =========================================================================
-- Situation predicates - the cheap compares that open a row (no geometry; the resolver owns that). Each
-- returns the situation NAME that holds (the begin trace's trigger field, the rows= walk) or nil. Shared
-- reads come off the walk memo: kind/faction resolve once per walk, the grenade danger reads best_danger once.
-- =========================================================================

-- too_close: the enemy is inside the NPC's own weapon minimum.
local function _situation_too_close(npc, _enemy, state, _tg, memo)
    if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
    if state.dist < xcombat.get_weapon_range(memo.kind).min then return "too_close" end
    return nil
end

-- pressure: a grenade danger within GRENADE_MS, or health under HURT_FRAC. Grenade checked first, matching
-- the old trigger precedence, so the traced situation name is the one the old shape would have fired.
local function _situation_pressure(npc, _enemy, _state, tg, memo)
    if memo.grenade == nil then
        local danger = npc:best_danger()
        memo.grenade = danger ~= nil and danger:type() == danger_object.grenade and (tg - danger:time()) <= GRENADE_MS
    end
    if memo.grenade then return "grenade" end
    if memo.hurt == nil then memo.hurt = npc.health < HURT_FRAC end
    if memo.hurt then return "hurt" end
    return nil
end

-- stalled: held position with the enemy not closing (_eval_stalled) - snipe's moment. The tracker runs on
-- every walk that reaches the snipe row, so the stall memory stays warm across declined walks.
local function _situation_stalled(_npc, _enemy, state, tg, memo)
    if _eval_stalled(state, tg, memo.npc_pos, state.dist) then return "stalled" end
    return nil
end


--- Load the tunables and (re)build the maneuver catalog. Called by the shell on_game_start; every key has a
--- script-side fallback. The catalog is built here so xcombat.* constants and the LTX values are ready.
function at_combat_doctrine.load_config()
    local ini = ini_file(CONFIG_PATH)
    local function read_float(k, d) return ini:r_float_ex(CONFIG_SECTION, k) or d end
    local function read_int(k, d) local v = ini:r_float_ex(CONFIG_SECTION, k) return v and math_floor(v) or d end
    HURT_FRAC      = read_float("hurt_frac",     0.25)
    GRENADE_MS     = read_int("grenade_ms",      3000)
    STALL_MS       = read_int("stall_ms",        4000)
    local move_m   = read_float("stall_move_m",  2)
    STALL_MOVE_SQR = move_m * move_m
    STALL_CLOSE_M  = read_float("stall_close_m", 2)
    KITE_ARC_DEG    = read_int("kite_arc_deg",    45)
    KITE_SPREAD_DEG = read_int("kite_spread_deg", 90)
    RETREAT_REAR_M  = read_float("retreat_rear_m", 4)
    UNDER_FIRE_MS   = read_int("under_fire_ms",   2000)
    FLEE_MIN_DIST_M      = read_int("flee_min_dist_m",      5)
    FLEE_BASE_MIN_DIST_M = read_int("flee_base_min_dist_m", 100)

    -- Ordered array = the walk order. kite first (a violated weapon minimum is answered before anything),
    -- flee BEFORE retreat (both open on pressure; a declined flee - squad stands / under fire / point-blank /
    -- no base - falls through to retreat), snipe LAST (this order reproduces the old trigger-precedence
    -- behavior: a hurt or grenade-pressed sniper retreats, only the merely-stalled one plants - t141).
    -- factions/weapons nil = match any. update = the row's periodic re-application; all four rows re-apply
    -- their combat state (a firing row re-checks its shot, flee re-asserts its holster).
    CATALOG = {
        {
            name      = "kite",
            situation = _situation_too_close,
            factions  = nil,
            weapons   = nil,
            resolve   = _resolve_kite,
            update    = _apply_state,
            fire      = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on   = "arrival",
            timeout   = read_int("maneuver_max_ms", 8000),
        },
        {
            -- flee: the rout, tried BEFORE retreat. Weapon HOLSTERED (STOW -> the sprint state: weapon
            -- strapped, mental=panic), re-asserted by the row's update, so the NPC turns its back and
            -- physically cannot fire while it runs. ecolog / clear sky / renegade only. A rout runs longer
            -- than a maneuver, so its cap (flee_max_ms) is longer than the mover stuck-cap.
            name      = "flee",
            situation = _situation_pressure,
            factions  = { ecolog = true, csky = true, renegade = true },
            weapons   = nil,
            resolve   = _resolve_flee,
            update    = _apply_state,
            fire      = xcombat.STOW, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on   = "arrival",
            timeout   = read_int("flee_max_ms", 15000),
        },
        {
            -- retreat: answer pressure (hurt / grenade) with a pull-back to rear cover, still firing. Brave
            -- factions always; timid factions land here when their flee declines (the flee row sits first).
            -- monolith and zombied get neither - fanatics do not break.
            name      = "retreat",
            situation = _situation_pressure,
            factions  = { army = true, dolg = true, freedom = true, killer = true, isg = true, stalker = true, bandit = true, greh = true, ecolog = true, csky = true, renegade = true },
            weapons   = nil,
            resolve   = _resolve_retreat,
            update    = _apply_state,
            fire      = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on   = "arrival",
            timeout   = read_int("maneuver_max_ms", 8000),
        },
        {
            -- snipe: w_sniper-only and a HOLD: ends_on=time (dest is the own node, so there is no arrival),
            -- so it runs to snipe_hold_ms.
            name      = "snipe",
            situation = _situation_stalled,
            factions  = nil,
            weapons   = { w_sniper = true },
            resolve   = _resolve_snipe,
            update    = _apply_state,
            fire      = xcombat.SNIPE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on   = "time",
            timeout   = read_int("snipe_hold_ms", 8000),
        },
    }
end


-- Faction/weapon palette for a row (nil = match any), reads memoized on the walk.
local function _palette_matches(row, npc, memo)
    if row.factions then
        if memo.faction == nil then memo.faction = character_community(npc) end
        if not row.factions[memo.faction] then return false end
    end
    if row.weapons then
        if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
        if not row.weapons[memo.kind] then return false end
    end
    return true
end

-- One row's ordered check: situation compare (cheap) -> palette -> resolver geometry.
-- Returns (dest, situation, stage): dest non-nil = picked. stage is the trace word for how far the row got
-- ("-" situation absent, "palette", "declined", "picked").
local function _check_row(row, npc, enemy, state, tg, memo)
    local sit = row.situation(npc, enemy, state, tg, memo)
    if not sit then return nil, nil, "-" end
    if not _palette_matches(row, npc, memo) then return nil, sit, "palette" end
    local dest = row.resolve(npc, enemy, state, memo)
    if dest then return dest, sit, "picked" end
    return nil, sit, "declined"
end

-- Reset the per-walk memo on the state record: wipe the lazy reads (faction, weapon kind, grenade, hurt),
-- take this tick's positions, and compute the flat npc-enemy distance every row and resolver shares
-- (state.dist). One table per NPC, reused across walks - no allocation on the monitor path.
local function _reset_memo(state, npc, enemy)
    local memo = state.memo
    if not memo then memo = {} state.memo = memo end
    memo.faction, memo.kind, memo.grenade, memo.hurt = nil, nil, nil, nil
    local np, ep = npc:position(), enemy:position()
    memo.npc_pos, memo.enemy_pos = np, ep
    local dx, dz = ep.x - np.x, ep.z - np.z
    state.dist = math_sqrt(dx * dx + dz * dz)
    return memo
end

-- Reused per-walk buffer for the rows= trace string (built only when tracing is on).
local _ROW_TRACE = {}

local function _rows_string(count)
    for i = count + 1, #_ROW_TRACE do _ROW_TRACE[i] = nil end
    return table_concat(_ROW_TRACE, ",")
end

--- Walk the catalog in order and return (maneuver, dest) for the first row whose situation, palette, and
--- resolver all pass, or nil when no row fires. The resolver IS the viability gate (a vertex = seize there,
--- nil = fall through to the next row). The walk reads positions once (memo.npc_pos / memo.enemy_pos,
--- state.dist) and memoizes the shared reads (faction, weapon kind, grenade danger) on state.memo for this
--- walk only. A pick stores the fired situation on state.trigger. When tracing is on, the per-row walk lands
--- on state.rows ("name:situation/stage/us" per walked row, the microseconds that row's check cost) and the
--- whole walk's microseconds on state.walk_us, for the decision line - the measurement that gates any future
--- cost work on this path. The timer is a null object when tracing is off (xprofiler.new_if), zero cost live.
function at_combat_doctrine.pick_maneuver(npc, enemy, state, tg)
    local memo = _reset_memo(state, npc, enemy)
    local tracing = at_combat_trace.enabled()
    local timer = xprofiler.new_if(tracing)
    local count = 0
    local walk_us = 0
    local picked, dest
    for i = 1, #CATALOG do
        local row = CATALOG[i]
        timer:start()
        local vid, sit, stage = _check_row(row, npc, enemy, state, tg, memo)
        timer:stop()
        if tracing then
            local total_us = timer:get_us()
            count = count + 1
            _ROW_TRACE[count] = row.name .. ":" .. (sit and (sit .. "/" .. stage) or stage) .. "/" .. math_floor(total_us - walk_us) .. "us"
            walk_us = total_us
        end
        if vid then
            picked, dest = row, vid
            state.trigger = sit
            break
        end
    end
    if tracing then
        state.rows = _rows_string(count)
        state.walk_us = math_floor(walk_us)
    end
    if picked then return picked, dest end
    return nil
end

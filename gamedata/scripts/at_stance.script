--- at_stance: the Conduct habits (Combat > Conduct) - small habits applied to VANILLA-driven NPCs at
--- moments the engine already decides. Two habits: cover POSTURE (below) and weapon SPACING (t198, the
--- per-NPC cover-distance band answered through the engine's combat-distance asks; its section sits
--- after the posture code). Posture: crouch to steady the shot when the NPC can STILL
--- hit the enemy from a crouch, stand to fire over a low wall that would eat a crouched shot. The 1.0.0
--- at_stance crouched blindly on planner ops and fired into random bumps (dropped, commit 591b6e0); this
--- form casts a crouch-eye shot ray to the enemy (xcombat.has_obstacle_to_target at BODY_Y.CROUCH_EYE) -
--- the real line-of-fire test, NOT the baked cover field, which never confirmed a shot. It HOLDS each
--- decision for DECIDE_MS - the engine re-asks posture several times a second, and a stateless per-ask
--- decision flapped crouch/stand continuously (1658 overrides in one session, 2026-07-23, the "up-down
--- shuffle"). Scope: the engine
--- fires npc_on_combat_set_body_state only from the vanilla combat planner's actions
--- (callbacks_gameobject.script COMBAT_BODY_STATE_OVERRIDE forwarder); a maneuver-held NPC never
--- reaches it (the takeover blocks that planner) and gets posture from his row instead - this is
--- the conduct layer for vanilla-driven NPCs, like at_accuracy. On an exe without the engine seam
--- the callback never fires and the module is inert.

local RegisterScriptCallback = RegisterScriptCallback
local tostring, time_global, math_random = tostring, time_global, math.random

local cfg = at_mcm.cfg

-- Long-range kinds whose carriers run posture discipline; short weapons keep vanilla's pick
-- (a shotgunner's fight is movement, not a firing line).
local LONG_KINDS = { w_rifle = true, w_sniper = true }
-- Tiers that use it - posture discipline is trained behavior; the green tiers keep vanilla.
local POSTURE_TIERS = { experienced = true, professional = true, veteran = true,
                        expert = true, master = true, legend = true }
-- The engine re-asks its combat body state several times a second while an action runs; deciding
-- fresh per ask is what flapped. One decision per NPC, held DECIDE_MS, re-decided early only when
-- the combat op changes; every ask during the hold answers the HELD posture, so the applied value
-- never alternates. The same sampled-decision-with-reset shape as the doctrine's stall tracker.
local DECIDE_MS = 3000
-- Flat distance floor: closer than this is a close/dynamic fight - stand and stay mobile. Not
-- exposed (the maneuvers carry on/off toggles only, so one lone slider here would read as arbitrary);
-- an internal constant like the thresholds above.
local CONDUCT_FLOOR_M = 20
-- Fraction of eligible NPCs that crouch, rolled once per NPC (cached in _eligible) so the line is a mix.
local CROUCH_CHANCE = 0.30
-- npc id -> { at, op, want } - the held decision. Dropped on entity unregister.
local _decision = {}

--- True while this NPC's held stance decision is crouch (HUD read).
function is_crouched(id)
    local dec = _decision[id]
    return dec ~= nil and dec.want == move.crouch
end
-- npc id -> tier-and-roll eligibility, static per NPC life (the at_reaction _tier_cache
-- shape); saves a rank read per engine ask. Dropped on entity unregister.
local _eligible = {}

-- hold_position ONLY (built lazily - stalker_ids is absent in the validator stub). The 2026-07-28
-- source audit of every body-state ask site (stalker_combat_actions.cpp) proved the other combat
-- ops ask in MOVING phases, where a crouch answer slows the engine's own move:
--   take_cover  - asks per execute ONLY while far from cover (:575-585), proposal STAND, he walks;
--   get_ready   - asks at initialize + per execute while far (:374-380), proposal STAND, he
--                 walks/runs to position (:362-371);
--   look_out    - asks once at initialize with the cover's own peek property, then MOVES to the
--                 lookout spot (:704-709);
--   hold_position - asks once at initialize and sets movement STAND in the same breath (:843-850):
--                 the one stationary ask, the firing-line case this module exists for.
-- A mover keeps the engine's proposal at full speed; never slow a mover (module law, user-ruled).
local _stationary_ops
local function _ops()
    if not _stationary_ops then
        _stationary_ops = {
            [stalker_ids.action_hold_position] = true,
        }
    end
    return _stationary_ops
end

-- The measured half: cast a crouch-eye shot ray to the enemy. Crouch only if it is CLEAR - he can hit
-- the enemy from a crouch, so the low stance just steadies the aim; a blocked crouch line means a low
-- wall would eat his own shot, so stand and fire over it. Returns (posture, crouch_shot_clear for trace).
-- @cost O(1) | 2 luabind (positions) + 1 raycast; runs once per DECIDE_MS per NPC
local function _decide(npc, enemy)
    local np, ep = npc:position(), enemy:position()
    -- Flat distance floor (CONDUCT_FLOOR_M): closer than this is a close/dynamic fight - stand and stay
    -- mobile, never crouch at the enemy's feet. Flat, not a fraction of weapon range (a rifle's reach does
    -- not push its close fight farther out; the old per-weapon fraction sent the sniper floor to ~45m,
    -- exactly where a sniper benefits from crouch most - the inversion, 2026-07-29).
    if np:distance_to_sqr(ep) < CONDUCT_FLOOR_M * CONDUCT_FLOOR_M then return move.stand, false end
    if xcombat.has_obstacle_to_target(np, ep, xcombat.BODY_Y.CROUCH_EYE) then return move.stand, false end
    return move.crouch, true
end

-- Tier and the crouch-disposition roll, cached once per NPC. Community is decided by the caller
-- (zombied are controlled to a forced STAND on a separate branch), so it is not re-checked here.
-- @cost O(1) after the first call per id
local function _is_eligible(npc, id)
    local ok = _eligible[id]
    if ok == nil then
        ok = POSTURE_TIERS[ranks.get_obj_rank_name(npc) or ""] == true
            and math_random() < CROUCH_CHANCE
        _eligible[id] = ok
    end
    return ok
end

-- Answer one engine body-state ask with the HELD posture, re-deciding at most once per DECIDE_MS.
-- Overrides vanilla's pick in BOTH directions: its blind crouch on a bump is the 1.0.0 bug; its stand
-- next to chest-high cover wastes the stillness accuracy gain. Zombied are controlled too, to a forced
-- STAND, through this SAME held/freeze/trace path - a decision, not a bypass.
-- @cost O(1) | per ask: 1 community read + (non-zombied) 1 kind read + table reads; geometry runs only on re-decides
local function _on_combat_body_state(npc, world_operator, _body_state, flags)
    if not cfg.conduct_posture then return end
    if not _ops()[world_operator] then return end
    -- Two control policies at the stationary op, one shared decision path below. A zombie is forced
    -- upright: a mindless shambler never holds a deliberate firing-line crouch (any weapon; the crouch
    -- path is long-weapon only). An eligible long-weapon veteran crouches or stands by the crouch-shot
    -- ray. Everyone else is left to vanilla. The danger-duck (at_danger, a direct set_body_state on a
    -- startle) is a reaction, not deliberate posture, and is untouched here.
    local id = npc:id()
    local zombied = xcreature.community(npc) == "zombied"
    if not zombied then
        local kind = xcombat.get_weapon_kind(npc)
        if not (kind and LONG_KINDS[kind]) then return end
        if not _is_eligible(npc, id) then return end
    end
    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return end
    local tg = time_global()
    local held = _decision[id]
    -- While a hit reaction plays (additive flinch, crit stagger, or a queued script animation overlay -
    -- xcombat.body_busy, the same read the maneuvers gate their seize on), FREEZE the posture: never
    -- re-decide and never issue a crouch<->stand transition mid-reaction. A stance flip landing inside a
    -- flinch is the "sliding when shot" class (at_stance v1); the held 3s decision only bounded its RATE,
    -- not the coincidence, and the additive flinch does not change the op so this callback keeps firing
    -- through it. Keep applying the last held posture (idempotent - holds the pre-reaction pose); with no
    -- decision yet, leave vanilla's body_state for this ask and decide once the body is free.
    local busy, busy_why = xcombat.body_busy(npc)
    if busy then
        if at_debug.on() then
            at_debug.dbg("[STANCE] id=%d freeze=%s held=%s", id, tostring(busy_why),
                held and (held.want == move.crouch and "crouch" or "stand") or "none")
        end
        if held then flags.body_state = held.want end
        return
    end
    -- Held purely by TIME. An op-change early re-decide was tried first and removed same day:
    -- combat ops ping-pong several times a second, so it bypassed the hold and posture still
    -- flipped at 1-2s (field session 02:48). Posture owes nothing to the op; 1 decision per
    -- DECIDE_MS is the contract.
    if not (held and (tg - held.at) < DECIDE_MS) then
        local prev_want = held and held.want
        -- Zombied are forced upright; everyone else is decided by the crouch-shot ray.
        local want, crouch_clear
        if zombied then
            want, crouch_clear = move.stand, false
        else
            want, crouch_clear = _decide(npc, enemy)
        end
        held = { at = tg, op = world_operator, want = want }
        _decision[id] = held
        if at_debug.on() and want ~= prev_want then
            at_debug.dbg("[STANCE] id=%d op=%s zombied=%s crouch_shot=%s -> %s", id,
                tostring(world_operator), tostring(zombied), tostring(crouch_clear),
                want == move.crouch and "crouch" or "stand")
        end
    end
    flags.body_state = held.want
end

-- Weapon spacing (t198), the second Conduct habit: a standing per-NPC cover-distance band answered
-- through the engine's own combat-distance asks (npc_on_get_min_combat_dist / _max, #563), so every
-- cover re-pick keeps the NPC's gun useful. SCALES the handed base, never replaces it - the engine's
-- weapon-type semantics (ai_stalker_cover.cpp:96-119) survive underneath. The engine already places
-- shotgun max 5m / pistol max 10m / sniper min 20m via its own cvars; the disposition adds the two
-- reads the engine lacks: the SMG (falls to the 20m default, tightened close) and the sniper minimum
-- raised by rank (a skilled sniper holds range). The handlers fire only on a cover re-search
-- (invalidation cadence; the cached best_cover() read runs zero Lua, ai_stalker_cover.cpp:282-294).
-- A seized NPC never reaches them (blocked planner, no find_best_cover) - exempt by construction.
local SPACING_MAX_K = { w_smg = 0.6 }
local SPACING_SNIPER_MIN_K = { novice = 1.0, trainee = 1.0, experienced = 1.15, professional = 1.15,
                               veteran = 1.3, expert = 1.3, master = 1.5, legend = 1.5 }
-- Disposition rows re-derive on this staleness, so a mid-life weapon change re-keys within one TTL
-- (the lazy re-read option of the two recorded at grooming; an item-take event would re-key exactly
-- but pays a callback on every pickup for a value only consulted at re-pick cadence).
local SPACING_TTL_MS = 5000
-- npc id -> { at, min_k, max_k } or { at, skip = true }; lazily derived, TTL-bounded, dropped on
-- entity unregister. eff_min/eff_max stash the last answered band under debug for the pick trace.
local _spacing = {}
-- npc id -> absolute max metres, the Behaviors push overlay (t199): while set it CAPS the answered
-- maximum so the NPC's own re-picks close on the target; at_combat owns set/clear, the disposition
-- entry stays untouched underneath (clearing IS the restore).
local _push_max = {}
-- npc id -> { min, max_floor }, the Behaviors pull overlay (t202, the mirror): while set it RAISES
-- the answered minimum (and floors the maximum past it) so the NPC's own re-picks fall back. Applied
-- AFTER the push cap in both handlers - a vulnerable NPC's self-preservation outranks his push.
local _pull = {}
-- Debug counter, [MON]-style: calls + handler us over a window, flushed from inside the handler.
local SPACING_FLUSH_MS = 5000
local _spacing_counter = { calls = 0, us = 0, last = 0 }

--- Cap this NPC's accepted cover-to-enemy maximum at max_m (the t199 window write). Clearing restores
--- the disposition band by construction - the overlay is a separate entry, nothing is overwritten.
function set_push_max(id, max_m)
    _push_max[id] = max_m
end

function clear_push_max(id)
    _push_max[id] = nil
end

--- Raise this NPC's accepted cover-to-enemy minimum to min_m, flooring the maximum at max_floor_m so
--- the band stays open past it (the t202 pull write). Clearing restores the band by construction.
function set_pull_band(id, min_m, max_floor_m)
    _pull[id] = { min = min_m, max_floor = max_floor_m }
end

function clear_pull_band(id)
    _pull[id] = nil
end

-- The disposition row, lazily derived and TTL-cached: kind + (snipers) tier -> the two scale factors.
-- Zombied carry a skip row - a mindless shambler gets no spacing discipline (the scope rule).
local function _get_spacing_row(npc, id, tg)
    local row = _spacing[id]
    if row and (tg - row.at) < SPACING_TTL_MS then return row end
    local kind = not (xcreature.community(npc) == "zombied") and xcombat.get_weapon_kind(npc) or nil
    if not kind then
        row = { at = tg, skip = true }
    else
        local min_k = kind == "w_sniper"
            and SPACING_SNIPER_MIN_K[ranks.get_obj_rank_name(npc) or ""] or nil
        if min_k == 1.0 then min_k = nil end
        row = { at = tg, min_k = min_k, max_k = SPACING_MAX_K[kind] }
        if at_debug.on() and (row.min_k or row.max_k) then
            at_debug.dbg("[SPACING] band id=%d kind=%s min_k=%s max_k=%s",
                id, kind, tostring(row.min_k), tostring(row.max_k))
        end
    end
    _spacing[id] = row
    return row
end

-- Fold one handler run into the counter window and flush a single [SPACING] rate line per window.
-- Called only under the DEBUG gate; the live handler cost is the table reads and multiplies alone.
local function _record_spacing(us, tg)
    if _spacing_counter.last == 0 then _spacing_counter.last = tg end
    _spacing_counter.calls = _spacing_counter.calls + 1
    _spacing_counter.us = _spacing_counter.us + us
    if tg - _spacing_counter.last < SPACING_FLUSH_MS then return end
    at_debug.dbg("[SPACING] window=%.0fs calls=%d rate=%.1f/s handler_avg=%.1fus",
        (tg - _spacing_counter.last) / 1000, _spacing_counter.calls,
        _spacing_counter.calls / ((tg - _spacing_counter.last) / 1000),
        _spacing_counter.us / _spacing_counter.calls)
    _spacing_counter.calls, _spacing_counter.us, _spacing_counter.last = 0, 0, tg
end

-- The two engine asks. Each SCALES the handed base into flags.ret_value; an untouched ask keeps the
-- engine's own value (flags.ret_value arrives preset to base). The push overlay caps the maximum even
-- with the spacing toggle off - its owner (the Behaviors window) carries its own MCM gate. eff_min /
-- eff_max stash the answered band under debug for the pick proof line.
local function _on_min_dist(npc, base, flags)
    if not npc then return end
    local tmr = xprofiler.new_if(at_debug.on()):start()
    local tg = time_global()
    local id = npc:id()
    local row = cfg.conduct_spacing and _get_spacing_row(npc, id, tg) or nil
    local raised = (row and row.min_k) and base * row.min_k or base
    local pull = _pull[id]
    if pull and pull.min > raised then raised = pull.min end
    if raised ~= base then
        flags.ret_value = raised
        if row and at_debug.on() then row.eff_min = raised end
    end
    tmr:stop()
    if at_debug.on() then _record_spacing(tmr:get_us(), tg) end
end

local function _on_max_dist(npc, base, flags)
    if not npc then return end
    local tmr = xprofiler.new_if(at_debug.on()):start()
    local tg = time_global()
    local id = npc:id()
    local row = cfg.conduct_spacing and _get_spacing_row(npc, id, tg) or nil
    local capped = (row and row.max_k) and base * row.max_k or base
    local push_cap = _push_max[id]
    if push_cap and push_cap < capped then capped = push_cap end
    local pull = _pull[id]
    if pull and pull.max_floor > capped then capped = pull.max_floor end
    if capped ~= base then
        flags.ret_value = capped
        if row and at_debug.on() then row.eff_max = capped end
    end
    tmr:stop()
    if at_debug.on() then _record_spacing(tmr:get_us(), tg) end
end

-- The output proof (the world-trace lesson, architecture.md: measure what he DID): on every actual
-- cover change, log the chosen point's distance to the enemy beside the band answered for this NPC,
-- so the log shows successive picks landing inside the band - never inferred from intent fields.
local function _on_cover_changed(npc, cover_pos)
    if not at_debug.on() or not (npc and cover_pos) then return end
    local id = npc:id()
    local row = _spacing[id]
    if not (row and (row.eff_min or row.eff_max)) and not _push_max[id] and not _pull[id] then return end
    local enemy = npc:best_enemy()
    if not enemy then return end
    local pull = _pull[id]
    at_debug.dbg("[SPACING] pick id=%d cover_to_enemy=%.1fm min=%s max=%s push=%s pull=%s",
        id, cover_pos:distance_to(enemy:position()),
        tostring(row and row.eff_min), tostring(row and row.eff_max), tostring(_push_max[id]),
        tostring(pull and pull.min))
end

local function _on_entity_unregister(se_obj)
    if se_obj then
        _decision[se_obj.id] = nil
        _eligible[se_obj.id] = nil
        _spacing[se_obj.id] = nil
        _push_max[se_obj.id] = nil
        _pull[se_obj.id] = nil
    end
end

-- Whether the combat-distance seam registered (#563+ overlays); false = spacing INACTIVE, engine
-- bands untouched, and the t199 push overlay is inert too (its cap rides the same handlers).
local _spacing_active = false

--- True when the combat-distance handlers are live on this exe (the t199 window's band effector
--- rides them; its owner logs its own INACTIVE from this).
function is_spacing_active()
    return _spacing_active
end

local function _on_first_update()
    at_debug.refresh()
    at_debug.info("Stance conduct initialized (posture=%s spacing=%s)",
        tostring(cfg.conduct_posture), _spacing_active and tostring(cfg.conduct_spacing) or "INACTIVE")
    if not _spacing_active then
        at_debug.info("Weapon spacing INACTIVE: exe lacks the combat-distance asks (#563); engine bands apply")
    end
end

function on_game_start()
    RegisterScriptCallback("npc_on_combat_set_body_state", _on_combat_body_state)
    RegisterScriptCallback("server_entity_on_unregister",  _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",        _on_first_update)
    _spacing_active = xcombat.on_get_min_combat_dist(_on_min_dist)
        and xcombat.on_get_max_combat_dist(_on_max_dist)
    RegisterScriptCallback("npc_on_best_cover_changed", _on_cover_changed)
end

--- at_world_trace: the world trace - slide watchdog + ballistics recorder, outputs only, alifetactics_world.log

local RegisterScriptCallback, UnregisterScriptCallback = RegisterScriptCallback, UnregisterScriptCallback
local IsStalker, time_global, db = IsStalker, time_global, db
local math_sqrt, math_floor, math_max, pairs, tostring = math.sqrt, math.floor, math.max, pairs, tostring
local math_deg, math_acos = math.deg, math.acos
local string_format, table_concat = string.format, table.concat
local ini_sys, tonumber = ini_sys, tonumber
local pcall, debug = pcall, debug

local log = xlog.get_logger("AT.WORLD", { outfile = "alifetactics_world.log", level = "DEBUG" })
local cfg = at_mcm.cfg

local SAMPLE_SEC  = 0.15
local RADIUS_SQR  = 70 * 70
local SLIDE_TOTAL_M = 1.0
local WATCH_MS    = 600
local WATCH_SEC   = 0.06
local SPEED_TOLERANCE = 1.25

local AC_ID = 0
local SHOOTER_RADIUS_SQR = 120 * 120
local NEAR_RADIUS_SQR = 100
local GAP_MS = 180
local REPORT_SEC = 60
local MT_RUN = 1
local WRONGWAY_DEG = 50
local CLASH_WINDOW_MS   = 1000
local CLASH_MIN_FLIPS   = 4
local CLASH_COOLDOWN_MS = 3000
-- Naturalness thresholds; the 10s unseen window is g_ai_fire_make_sense_interval (ai_stalker_fire.cpp:68).
local NAT_SHUF_WINDOW_MS  = 2000
local NAT_SHUF_COOLDOWN_MS = 3000
local NAT_FIRE_COOLDOWN_MS = 3000
local NAT_IDLE_MS         = 1500
local NAT_GLUED_MS        = 2000
local NAT_MOVE_MIN_SQR    = 1.0
local NAT_RELOAD_LOOP_N   = 3
local NAT_UNSEEN_MS       = 10000
local NAT_AIM_OFF_MS      = 1000
local NAT_FIGHT_MS        = 5000
local NAT_BLINDFIRE_MS    = 1000

local TIERS = xcreature.RANK_TIERS

local _enabled = false
local _slide = {}
local _watch = {}
local _dtrace = {}
local _pose = {}
local _speed = {}
local _speed_ceiling = nil
local _drop = {}
local _near_ids = {}
local _clash = {}
local _nat = {}
local _shot_at = {}
local _hit_at = {}
local _orig_set_state
local _MOVE

local _t0 = 0
local _tiers = {}
local _drive = {}
local _bursts = {}
local _open = {}
local _ctx = {}
local _avx, _avz = 0, 0
local _apx, _apz, _at = nil, nil, 0

local function _get_driver(id)
    local maneuver = at_maneuvers.get_maneuver(id)
    if maneuver then return maneuver end
    if at_commitment.get_hold(id) then return "commit" end
    return "vanilla"
end

local function _get_mt_name(v)
    if not _MOVE then _MOVE = { [move.walk] = "walk", [move.run] = "run", [move.stand] = "stand", [move.steal] = "steal" } end
    return _MOVE[v] or tostring(v)
end

local function _is_locomoting(mt)
    return mt == move.walk or mt == move.run or mt == move.steal
end

local function _compute_ceiling()
    local max_v = 0
    local line_count = ini_sys:line_count("stalker_movement_speeds") or 0
    for i = 0, line_count - 1 do
        local _, _, value = ini_sys:r_line("stalker_movement_speeds", i, "", "")
        local v = tonumber(value)
        if v and v > max_v then max_v = v end
    end
    if max_v <= 0 then max_v = 6.0 end
    return max_v * SPEED_TOLERANCE
end

local function _check_speed(npc, id, tg, pos, mt)
    local prev = _speed[id]
    if not prev then
        _speed[id] = { x = pos.x, z = pos.z, t = tg, logged = false }
        return
    end
    local dt = tg - prev.t
    if dt <= 0 then return end
    local mps = math_sqrt((pos.x - prev.x) ^ 2 + (pos.z - prev.z) ^ 2) * 1000 / dt
    if mps > _speed_ceiling then
        if not prev.logged then
            prev.logged = true
            log.info("[WORLD] id=%d %s FLAGS=FAST drv=%s mps=%.1f ceiling=%.1f mt=%s dt=%dms",
                id, npc:name() or "?", _get_driver(id), mps, _speed_ceiling, _get_mt_name(mt), dt)
        end
    else
        prev.logged = false
    end
    prev.x, prev.z, prev.t = pos.x, pos.z, tg
end

local function _check(npc, id, tg, pos, mt)
    if _is_locomoting(mt) then
        _slide[id] = nil
        return
    end
    local anchor = _slide[id]
    if not anchor then
        _slide[id] = { x = pos.x, z = pos.z, t = tg, logged = false }
        return
    end
    if anchor.logged then return end
    local dist = math_sqrt((pos.x - anchor.x) ^ 2 + (pos.z - anchor.z) ^ 2)
    if dist >= SLIDE_TOTAL_M then
        anchor.logged = true
        log.info("[WORLD] id=%d %s FLAGS=SLIDE drv=%s moved=%.2fm over=%dms mt=%s",
            id, npc:name() or "?", _get_driver(id), dist, tg - anchor.t, _get_mt_name(mt))
    end
end

local function _is_near(npc, ap)
    local pos = npc:position()
    return (pos.x - ap.x) ^ 2 + (pos.z - ap.z) ^ 2 <= RADIUS_SQR
end

local function _log_held_danger(npc, id, tg)
    local danger = npc:best_danger()
    if not danger then
        _dtrace[id] = nil
        return
    end
    local src = danger:object()
    local src_id = src and src:id() or -1
    local bt = danger:type()
    local flag = at_danger.has_danger(npc)
    local sm = db.storage[id] and db.storage[id].state_mgr
    local pose = sm and tostring(sm.target_state) or "-"
    local prev = _dtrace[id]
    if prev and prev.bt == bt and prev.src == src_id and prev.flag == flag and prev.pose == pose then return end
    _dtrace[id] = { bt = bt, src = src_id, flag = flag, pose = pose }
    local dp, np = danger:position(), npc:position()
    log.debug("[DANGER-HELD] npc=%d name=%s bd=%s src=%d dist=%.0f age=%dms flag=%s pose=%s",
        id, npc:name() or "?", at_danger.get_type_name(bt), src_id,
        math_sqrt((dp.x - np.x) ^ 2 + (dp.z - np.z) ^ 2), tg - danger:time(), tostring(flag), pose)
end

-- Combat sub-planner action id -> short name (lazy; the ids are runtime globals).
local _COMBAT_ACTIONS
local function _get_action_name(action_id)
    if not _COMBAT_ACTIONS then
        local base = xr_actions_id.combat_monolith_base
        _COMBAT_ACTIONS = {
            [stalker_ids.action_kill_enemy]                = "kill_enemy",
            [stalker_ids.action_kill_enemy_if_not_visible] = "kill_if_not_visible",
            [stalker_ids.action_take_cover]                = "take_cover",
            [stalker_ids.action_look_out]                  = "look_out",
            [stalker_ids.action_hold_position]             = "hold_position",
            [stalker_ids.action_get_ready_to_kill]         = "get_ready",
            [base + 0] = "mono_fight_close", [base + 1] = "mono_fight_far",
            [base + 2] = "mono_look_around", [base + 3] = "mono_go_to_pos",
        }
    end
    return _COMBAT_ACTIONS[action_id] or tostring(action_id)
end

-- The combat sub-planner's current action name, "-" when combat is not the running plan.
local function _get_combat_action(npc)
    local mgr = npc:motivation_action_manager()
    if not (mgr and mgr:initialized()) then return "-" end
    local combat = mgr:action(stalker_ids.action_combat_planner)
    local plan = combat and cast_planner(combat)
    if not (plan and plan:initialized()) then return "-" end
    return _get_action_name(plan:current_action_id())
end

-- One per-NPC combat-state record: engine state, the operator and its combat action, routing, driver, target.
local function _read_pose(npc, id, tg)
    local st = db.storage[id]
    local sm = st and st.state_mgr
    local be = npc:best_enemy()
    return {
        state = sm and tostring(sm.target_state) or "-",
        sct   = st and tostring(st.script_combat_type) or "-",
        op    = xcombat.get_operator(npc),
        sub   = _get_combat_action(npc),
        drv   = _get_driver(id),
        enemy = be and be:id() or -1,
        t     = tg,
    }
end

local function _is_pose_same(prev, cur)
    if not prev then return false end
    return prev.state == cur.state and prev.sct == cur.sct and prev.op == cur.op
        and prev.sub == cur.sub and prev.drv == cur.drv and prev.enemy == cur.enemy
end

local function _log_pose(npc, id, tg)
    if not _enabled then return end
    local cur = _read_pose(npc, id, tg)
    local prev = _pose[id]
    if _is_pose_same(prev, cur) then return end
    _pose[id] = cur
    log.debug("[POSE] id=%d %s dt=%dms state=%s->%s op=%s sub=%s sct=%s drv=%s->%s enemy=%d",
        id, npc:name() or "?", prev and (tg - prev.t) or 0,
        prev and prev.state or "-", cur.state, cur.op, cur.sub, cur.sct, prev and prev.drv or "-", cur.drv, cur.enemy)
end

-- Naturalness checks: flag combat behavior that reads as unnatural, one tagged world-log line each.
local _MOVER_STATES = { assault = true, assault_fire = true, raid = true, sprint = true, rush = true }
local _COMBAT_OPS = { combat = true, danger = true }
local _nat_ms, _nat_n = 0, 0

local function _get_nat(id)
    local nat = _nat[id]
    if not nat then nat = {} _nat[id] = nat end
    return nat
end

-- One shuffle dimension: record its value; log [SHUF] when it flips 3 times inside the window.
local function _check_dim(nat, key, val, id, name, tg)
    local dim = nat[key]
    if not dim then nat[key] = { last = val, t1 = 0, t2 = 0, t3 = 0, cd = 0 } return end
    if val == dim.last then return end
    dim.last = val
    dim.t1, dim.t2, dim.t3 = dim.t2, dim.t3, tg
    if dim.t1 == 0 or (tg - dim.t1) > NAT_SHUF_WINDOW_MS then return end
    if (tg - dim.cd) < NAT_SHUF_COOLDOWN_MS then return end
    dim.cd = tg
    log.info("[SHUF] id=%d %s kind=%s 3flips/%.0fs", id, name, key, NAT_SHUF_WINDOW_MS / 1000)
end

-- Movement heading reversing back and forth: running like an idiot.
local function _check_move(nat, id, name, tg, pos)
    local mv = nat.move
    if not mv then nat.move = { x = pos.x, z = pos.z, dx = 0, dz = 0, t1 = 0, t2 = 0, t3 = 0, cd = 0 } return end
    local dx, dz = pos.x - mv.x, pos.z - mv.z
    if dx * dx + dz * dz < NAT_MOVE_MIN_SQR then return end
    local reversed = (mv.dx * dx + mv.dz * dz) < 0
    mv.x, mv.z, mv.dx, mv.dz = pos.x, pos.z, dx, dz
    if not reversed then return end
    mv.t1, mv.t2, mv.t3 = mv.t2, mv.t3, tg
    if mv.t1 == 0 or (tg - mv.t1) > NAT_SHUF_WINDOW_MS then return end
    if (tg - mv.cd) < NAT_SHUF_COOLDOWN_MS then return end
    mv.cd = tg
    log.info("[SHUF] id=%d %s kind=move 3reversals/%.0fs", id, name, NAT_SHUF_WINDOW_MS / 1000)
end

-- Sees the enemy, lane clear, fire makes sense, not reloading, yet not firing: wasting time.
local function _check_idle(nat, npc, id, name, be, tg)
    if not be then nat.eng_since = nil return end
    if xcombat.is_reloading(npc) then return end
    nat.eng_since = nat.eng_since or tg
    local silent = tg - math_max(_shot_at[id] or 0, nat.eng_since)
    if silent <= NAT_IDLE_MS or not xcombat.can_see(npc, be) then return end
    if xcombat.can_kill_member(npc, be:position()) or not xcombat.fire_make_sense(npc, be) then return end
    if (tg - (nat.idle_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.idle_cd = tg
    log.info("[IDLE] id=%d %s able but silent=%dms enemy=%d", id, name, silent, be:id())
end

-- In a move state but position not changing: glued to the ground.
local function _check_glue(nat, id, name, state, tg, pos)
    if not (state and _MOVER_STATES[state]) then nat.gsince = nil return end
    local gp = nat.gpos
    if not (gp and (pos.x - gp.x) ^ 2 + (pos.z - gp.z) ^ 2 < NAT_MOVE_MIN_SQR) then
        nat.gpos = gp or {}
        nat.gpos.x, nat.gpos.z = pos.x, pos.z
        nat.gsince = tg
        return
    end
    if (tg - (nat.gsince or tg)) <= NAT_GLUED_MS then return end
    if (tg - (nat.glue_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.glue_cd = tg
    log.info("[GLUED] id=%d %s state=%s frozen=%dms", id, name, state, tg - nat.gsince)
end

-- Reload starting again and again with no shot in between: the reload loop.
local function _check_reload(nat, npc, id, name, tg)
    local reloading = xcombat.is_reloading(npc)
    if reloading and not nat.reloading then
        local shot = _shot_at[id] or 0
        if shot > (nat.rl_shot or 0) then nat.rl_n = 0 end
        nat.rl_shot = shot
        nat.rl_n = (nat.rl_n or 0) + 1
        if nat.rl_n >= NAT_RELOAD_LOOP_N and (tg - (nat.rl_cd or 0)) >= NAT_FIRE_COOLDOWN_MS then
            nat.rl_cd, nat.rl_n = tg, 0
            log.info("[RELOADLOOP] id=%d %s %d reloads, no shot between", id, name, NAT_RELOAD_LOOP_N)
        end
    end
    nat.reloading = reloading
end

-- In a fight (recent hit) but no selected enemy: forgot who it's fighting.
local function _check_forgot(nat, id, name, be, tg)
    if be or (tg - (_hit_at[id] or 0)) >= NAT_FIGHT_MS then return end
    if (tg - (nat.forgot_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.forgot_cd = tg
    log.info("[FORGOT] id=%d %s no best_enemy, hit %dms ago", id, name, tg - _hit_at[id])
end

-- Engaged on an enemy unseen past the engine's own fire window: fighting a ghost.
local function _check_ghost(nat, npc, id, name, be, tg)
    if not be then return end
    local unseen = xcombat.get_unseen_ms(npc, be, tg)
    if unseen <= NAT_UNSEEN_MS or (tg - (nat.ghost_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.ghost_cd = tg
    log.info("[GHOST] id=%d %s enemy=%d unseen=%dms still engaged", id, name, be:id(), unseen)
end

-- Fired at an enemy it cannot see whose memory is stale: shooting at nothing.
local function _check_blindfire(nat, npc, id, name, be, tg)
    if not be or (tg - (_shot_at[id] or 0)) >= NAT_BLINDFIRE_MS then return end
    if xcombat.can_see(npc, be) or xcombat.get_unseen_ms(npc, be, tg) <= NAT_UNSEEN_MS then return end
    if (tg - (nat.bf_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.bf_cd = tg
    log.info("[BLINDFIRE] id=%d %s firing at unseen stale enemy=%d", id, name, be:id())
end

-- Aiming at something other than the selected enemy, held: pointing the gun the wrong way.
local function _check_aimoff(nat, npc, id, name, be, tg)
    local aim = xcombat.get_sight_target(npc)
    if not (be and aim and aim ~= be:id()) then nat.aimoff_since = nil return end
    nat.aimoff_since = nat.aimoff_since or tg
    if (tg - nat.aimoff_since) <= NAT_AIM_OFF_MS or (tg - (nat.ao_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.ao_cd = tg
    log.info("[AIMOFF] id=%d %s aim=%d enemy=%d held=%dms", id, name, aim, be:id(), tg - nat.aimoff_since)
end

-- True when a threat is visible and closer than the currently selected enemy.
local function _can_see_closer(npc, tid, be_dsqr, pos)
    local obj = xcombat.resolve_enemy(tid)
    if not (obj and xcombat.can_see(npc, obj)) then return false end
    return not be_dsqr or pos:distance_to_sqr(obj:position()) < be_dsqr
end

local function _log_blindspot(nat, id, name, tid, be_id, tg)
    if (tg - (nat.bs_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.bs_cd = tg
    log.info("[BLINDSPOT] id=%d %s sees closer=%d selected=%d", id, name, tid, be_id)
end

local function _find_blind_tid(npc, threats, be_id, be_dsqr, pos)
    for tid in pairs(threats) do
        if tid ~= be_id and _can_see_closer(npc, tid, be_dsqr, pos) then return tid end
    end
    return nil
end

-- Sees a hostile closer than its pick, over the threat set: ignoring the man in front.
local function _check_blindspot(nat, npc, name, be, tg, pos)
    local id = npc:id()
    local threats = at_core.get_threats(id)
    if not threats then return end
    local be_id = be and be:id() or -1
    local be_dsqr = be and pos:distance_to_sqr(be:position()) or nil
    local tid = _find_blind_tid(npc, threats, be_id, be_dsqr, pos)
    if tid then _log_blindspot(nat, id, name, tid, be_id, tg) end
end

-- In a combat operator but no seen enemy for the engine's fire window: GOAP not resolving.
local function _check_unresolved(nat, npc, name, be, drv, tg)
    local id = npc:id()
    local op = xcombat.get_operator(npc)
    if not _COMBAT_OPS[op] or drv ~= "vanilla" or xcreature.is_zombied(npc) then
        nat.unres_since = nil
        return
    end
    if be and xcombat.get_unseen_ms(npc, be, tg) < NAT_UNSEEN_MS then nat.unres_since = nil return end
    nat.unres_since = nat.unres_since or tg
    if (tg - nat.unres_since) <= NAT_UNSEEN_MS or (tg - (nat.unres_cd or 0)) < NAT_FIRE_COOLDOWN_MS then return end
    nat.unres_cd = tg
    log.info("[UNRESOLVED] id=%d %s op=%s no seen enemy %dms", id, name, op, tg - nat.unres_since)
end

-- Read the combat facts once, run every check. Self-timed for the [NAT] perf line.
local function _check_natural(npc, id, tg, pos)
    local nat = _get_nat(id)
    local name = npc:name() or "?"
    local be = npc:best_enemy()
    local drv = _get_driver(id)
    local st = db.storage[id]
    local state = st and st.state_mgr and st.state_mgr.target_state or nil
    _check_dim(nat, "stance", npc:body_state() == move.crouch, id, name, tg)
    _check_dim(nat, "aim", xcombat.get_sight_target(npc) or -1, id, name, tg)
    _check_dim(nat, "target", be and be:id() or -1, id, name, tg)
    _check_move(nat, id, name, tg, pos)
    _check_idle(nat, npc, id, name, be, tg)
    _check_glue(nat, id, name, state, tg, pos)
    _check_reload(nat, npc, id, name, tg)
    _check_forgot(nat, id, name, be, tg)
    _check_ghost(nat, npc, id, name, be, tg)
    _check_blindfire(nat, npc, id, name, be, tg)
    _check_aimoff(nat, npc, id, name, be, tg)
    _check_blindspot(nat, npc, name, be, tg, pos)
    _check_unresolved(nat, npc, name, be, drv, tg)
end

local function _update_npc(npc, ap, tg)
    if not (npc and IsStalker(npc) and npc:alive() and _is_near(npc, ap)) then return end
    local id = npc:id()
    _near_ids[id] = true
    _log_held_danger(npc, id, tg)
    _log_pose(npc, id, tg)
    local pos = npc:position()
    local mt = npc:movement_type()
    _check(npc, id, tg, pos, mt)
    _check_speed(npc, id, tg, pos, mt)
    local timer = xprofiler.new_if(_enabled):start()
    _check_natural(npc, id, tg, pos)
    timer:stop()
    _nat_ms, _nat_n = _nat_ms + timer:get_ms(), _nat_n + 1
end

local function _run_monitor()
    if not _enabled then return true end
    ResetTimeEvent("at_world_trace", "monitor", SAMPLE_SEC)
    local ac = db.actor
    if not ac then return false end
    local ap, tg = ac:position(), time_global()
    for k in pairs(_near_ids) do _near_ids[k] = nil end
    for i = 1, #db.OnlineStalkers do
        _update_npc(xobject.get_go(db.OnlineStalkers[i]), ap, tg)
    end
    return false
end

local function _on_hit(npc, amount, _local_direction, _who, bone_index)
    if not (npc and IsStalker(npc) and npc:alive() and db.actor) then return end
    local id = npc:id()
    _hit_at[id] = time_global()
    if _watch[id] then return end
    local pos = npc:position()
    _watch[id] = { t0 = time_global(), x = pos.x, z = pos.z, anims0 = npc:animation_count(), drv0 = _get_driver(id),
                   hp0 = npc.health, mt0 = npc:movement_type(), amount = amount or 0, bone = bone_index or -1 }
end

local function _update_watch(npc, id, w, tg)
    local pos = npc:position()
    w.maxd = math_max(w.maxd or 0, math_sqrt((pos.x - w.x) ^ 2 + (pos.z - w.z) ^ 2))
    if _is_locomoting(npc:movement_type()) then w.walked = true end
    if tg - w.t0 < WATCH_MS then return false end
    log.info("[WORLD] hit id=%d %s drv=%s amount=%.2f bone=%d hp0=%.2f hp1=%.2f anims0=%d anims1=%d" ..
        " mt0=%s mt1=%s moved=%.2f walked=%s over=%dms",
        id, npc:name() or "?", w.drv0, w.amount, w.bone, w.hp0, npc.health, w.anims0, npc:animation_count(),
        _get_mt_name(w.mt0), _get_mt_name(npc:movement_type()), w.maxd, w.walked and "y" or "n", tg - w.t0)
    return true
end

local function _run_watch()
    if not _enabled then return true end
    ResetTimeEvent("at_world_trace", "watch", WATCH_SEC)
    local tg = time_global()
    local dropped = 0
    for id, w in pairs(_watch) do
        local npc = xobject.get_go(id)
        local drop = true
        if npc and IsStalker(npc) and npc:alive() then drop = _update_watch(npc, id, w, tg) end
        if drop then dropped = dropped + 1; _drop[dropped] = id end
    end
    for i = 1, dropped do _watch[_drop[i]] = nil; _drop[i] = nil end
    return false
end

local function _on_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _slide[id] = nil
    _watch[id] = nil
    _speed[id] = nil
    _dtrace[id] = nil
    _pose[id] = nil
    _clash[id] = nil
    _near_ids[id] = nil
    _nat[id] = nil
    _shot_at[id] = nil
    _hit_at[id] = nil
end

-- CLASH names the two scripts flipping one near NPC's state against each other.
-- Same file or same state is one scheme cycling and is suppressed; a fast different-file, different-state alternation is the clash.
local function _check_clash(id, name, state, file, tg)
    local rec = _clash[id]
    if not rec then
        _clash[id] = { state = state, file = file, tg = tg, flips = 0, last = 0 }
        return
    end
    if file == rec.file or state == rec.state then
        rec.state, rec.file, rec.tg = state, file, tg
        return
    end
    rec.flips = ((tg - rec.tg) <= CLASH_WINDOW_MS) and (rec.flips + 1) or 1
    local a_file, a_state = rec.file, rec.state
    rec.file, rec.state, rec.tg = file, state, tg
    if rec.flips >= CLASH_MIN_FLIPS and (tg - rec.last) >= CLASH_COOLDOWN_MS then
        rec.last, rec.flips = tg, 0
        log.info("[CLASH] id=%d %s a=%s(%s) b=%s(%s) window=%dms",
            id, name or "?", a_file, a_state, file, state, CLASH_WINDOW_MS)
    end
end

--- Installed on state_mgr.set_state while World trace runs; runs the original first, records the setter for CLASH, noops when trace or debug off.
--- @safety SAFE - only the CLASH bookkeeping is pcall-wrapped; the original set_state runs unguarded first so an instrument error never breaks state-setting
local function _on_set_state(npc, state_name, ...)
    _orig_set_state(npc, state_name, ...)
    if not _enabled then return end
    if not (npc and state_name) then return end
    local id = npc:id()
    if not _near_ids[id] then return end
    local info = debug.getinfo(2, "S")
    pcall(_check_clash, id, npc:name(), state_name, info and info.short_src or "?", time_global())
end

local function _reset()
    _t0 = time_global()
    _tiers, _drive, _bursts, _open, _ctx = {}, {}, {}, {}, {}
    _avx, _avz, _apx, _apz, _at = 0, 0, nil, nil, 0
end

local function _get_tier_row(tier)
    local row = _tiers[tier]
    if not row then
        row = { shots = 0, hits = 0, dmg = 0, near = 0, conv = 0,
                mv_shots = 0, mv_hits = 0, st_shots = 0, st_hits = 0,
                ang_sum = 0, ang_n = 0, ahead_sum = 0, ahead_n = 0, behind_n = 0,
                aim_shots = 0, aim_off_sum = 0, wrongway = 0 }
        _tiers[tier] = row
    end
    return row
end

local function _get_drive_row(name)
    local row = _drive[name]
    if not row then
        row = { shots = 0, hits = 0 }
        _drive[name] = row
    end
    return row
end

local function _stop_burst(id, entry)
    if entry.count > 0 and entry.kind then
        local hist = _bursts[entry.kind]
        if not hist then
            hist = {}
            _bursts[entry.kind] = hist
        end
        local bucket = entry.count > 9 and 10 or entry.count
        hist[bucket] = (hist[bucket] or 0) + 1
    end
    _open[id] = nil
end

local function _on_shot(obj, wpn, body_state, move_type, temp_disp)
    if not (obj and db and db.actor) then return end
    if obj:position():distance_to_sqr(db.actor:position()) > SHOOTER_RADIUS_SQR then return end

    local id = obj:id()
    _shot_at[id] = time_global()
    local tier = ranks.get_obj_rank_name(obj)
    if not tier or tier == "" then return end

    local timer = xprofiler.new_if(_enabled):start()
    local moving = move_type ~= nil and move_type <= MT_RUN
    local drive = "vanilla"
    if at_maneuvers.get_maneuver(id) then
        drive = "maneuver"
    elseif at_commitment.get_hold(id) then
        drive = "hold"
    end
    local kind = xcombat.get_weapon_kind(obj)

    local row = _get_tier_row(tier)
    row.shots = row.shots + 1
    if moving then row.mv_shots = row.mv_shots + 1 else row.st_shots = row.st_shots + 1 end
    _get_drive_row(drive).shots = _get_drive_row(drive).shots + 1

    local tg = time_global()
    local entry = _open[id]
    if entry and (tg - entry.last_ms) > GAP_MS then
        _stop_burst(id, entry)
        entry = nil
    end
    if not entry then
        entry = { last_ms = tg, count = 0, kind = kind }
        _open[id] = entry
    end
    entry.count = entry.count + 1
    entry.last_ms = tg

    _ctx[id] = { tier = tier, moving = moving, drive = drive }
    timer:stop()
    if _enabled then
        log.debug("[BAL] shot id=%d tier=%s kind=%s moving=%s drive=%s [%.3fms]",
            id, tier, tostring(kind), tostring(moving), drive, timer:get_ms())
    end
end

local function _update_velocity()
    if not _enabled then return true end
    if db and db.actor then
        local apos = db.actor:position()
        local tg = time_global()
        if _apx and tg > _at then
            local dt = (tg - _at) / 1000
            _avx = (apos.x - _apx) / dt
            _avz = (apos.z - _apz) / dt
        end
        _apx, _apz, _at = apos.x, apos.z, tg
    end
    ResetTimeEvent("at_world_trace", "velpoll", 0.2)
    return false
end

local function _collect_angle(bullet, shooter, row)
    local dir = bullet.direction
    if not dir then return end
    local apos = db.actor:position()
    local spos = shooter:position()
    local dx, dy, dz = apos.x - spos.x, apos.y + 0.9 - spos.y, apos.z - spos.z
    local dist = math_sqrt(dx * dx + dy * dy + dz * dz)
    if dist < 2 then return end
    local dot = (dir.x * dx + dir.y * dy + dir.z * dz) / dist
    if dot > 1 then dot = 1 elseif dot < -1 then dot = -1 end
    local ang = math_deg(math_acos(dot))
    if ang > 60 then return end
    row.ang_sum = row.ang_sum + ang
    row.ang_n = row.ang_n + 1
    local speed = math_sqrt(_avx * _avx + _avz * _avz)
    if speed > 0.5 then
        local px = spos.x + dir.x * dist - apos.x
        local pz = spos.z + dir.z * dist - apos.z
        local ahead = (px * _avx + pz * _avz) / speed
        row.ahead_sum = row.ahead_sum + ahead
        if ahead >= 0 then row.ahead_n = row.ahead_n + 1 else row.behind_n = row.behind_n + 1 end
    end
end

local function _collect_wrongway(bullet, shooter, ctx)
    local enemy = shooter:best_enemy()
    local dir = bullet.direction
    if not (enemy and dir) then return end
    local ep, sp = enemy:position(), shooter:position()
    local dx, dy, dz = ep.x - sp.x, (ep.y + 0.9) - sp.y, ep.z - sp.z
    local edist = math_sqrt(dx * dx + dy * dy + dz * dz)
    if edist < 2 then return end
    local dot = (dir.x * dx + dir.y * dy + dir.z * dz) / edist
    if dot > 1 then dot = 1 elseif dot < -1 then dot = -1 end
    local off = math_deg(math_acos(dot))
    local row = _get_tier_row(ctx.tier)
    row.aim_shots = row.aim_shots + 1
    row.aim_off_sum = row.aim_off_sum + off
    if off <= WRONGWAY_DEG then return end
    row.wrongway = row.wrongway + 1
    if _enabled then
        log.debug("[BAL] wrongway id=%d tier=%s off=%.0fdeg enemy=%d edist=%.0f drive=%s",
            shooter:id(), ctx.tier, off, enemy:id(), edist, ctx.drive)
    end
end

local function _on_impact(bullet)
    if not (db and db.actor) then return end
    local parent_id = bullet.parent_id
    if not parent_id or parent_id == AC_ID then return end
    local ctx = _ctx[parent_id]
    if not ctx then return end

    local shooter = xobject.get_go(parent_id)
    if shooter then
        _collect_angle(bullet, shooter, _get_tier_row(ctx.tier))
        _collect_wrongway(bullet, shooter, ctx)
    end

    local hit = bullet.target_id == AC_ID
    local near = false
    if not hit then
        local apos = db.actor:position()
        local pos = bullet.position
        local dx, dy, dz = pos.x - apos.x, pos.y - apos.y, pos.z - apos.z
        near = (dx * dx + dy * dy + dz * dz) <= NEAR_RADIUS_SQR
    end
    if not (hit or near) then return end

    local row = _get_tier_row(ctx.tier)
    row.near = row.near + 1
    if hit then
        row.hits = row.hits + 1
        row.conv = row.conv + 1
        if ctx.moving then row.mv_hits = row.mv_hits + 1 else row.st_hits = row.st_hits + 1 end
        _get_drive_row(ctx.drive).hits = _get_drive_row(ctx.drive).hits + 1
    end
    if _enabled then
        log.debug("[BAL] impact id=%d tier=%s hit=%s drive=%s", parent_id, ctx.tier, tostring(hit), ctx.drive)
    end
end

local function _on_actor_hit(obj, amount, local_direction, who, bone_index)
    if not (who and amount and amount > 0) then return end
    if not IsStalker(who) then return end
    local tier = ranks.get_obj_rank_name(who)
    if not tier or tier == "" then return end
    _get_tier_row(tier).dmg = _get_tier_row(tier).dmg + amount
end

local function _get_percent(hits, shots)
    return shots > 0 and (100 * hits / shots) or 0
end

local function _format_hist_line(hist)
    local parts = {}
    for len = 1, 10 do
        if hist[len] then
            parts[#parts + 1] = string_format("%s=%d", len == 10 and "10+" or tostring(len), hist[len])
        end
    end
    return table_concat(parts, " ")
end

local function _run_report()
    if not _enabled then return true end
    write_report()
    ResetTimeEvent("at_world_trace", "report", REPORT_SEC)
    return false
end

local function _apply_enabled()
    local want = cfg.world_trace_enabled and true or false
    if want == _enabled then return end
    _enabled = want
    if _enabled then
        _slide, _watch, _speed = {}, {}, {}
        _clash, _near_ids = {}, {}
        _speed_ceiling = _speed_ceiling or _compute_ceiling()
        _reset()
        if not _orig_set_state then
            _orig_set_state = state_mgr.set_state
            state_mgr.set_state = _on_set_state
        end
        RegisterScriptCallback("npc_on_hit_callback", _on_hit)
        RegisterScriptCallback("server_entity_on_unregister", _on_unregister)
        RegisterScriptCallback("npc_shot_dispersion",   _on_shot)
        RegisterScriptCallback("bullet_on_impact",      _on_impact)
        RegisterScriptCallback("actor_on_hit_callback", _on_actor_hit)
        RemoveTimeEvent("at_world_trace", "monitor")
        CreateTimeEvent("at_world_trace", "monitor", SAMPLE_SEC, _run_monitor)
        RemoveTimeEvent("at_world_trace", "watch")
        CreateTimeEvent("at_world_trace", "watch", WATCH_SEC, _run_watch)
        RemoveTimeEvent("at_world_trace", "report")
        CreateTimeEvent("at_world_trace", "report", REPORT_SEC, _run_report)
        RemoveTimeEvent("at_world_trace", "velpoll")
        CreateTimeEvent("at_world_trace", "velpoll", 0.2, _update_velocity)
        log.info("World trace enabled (slide sample=%dms radius=70m, ballistics report=%ds)",
            math_floor(SAMPLE_SEC * 1000), REPORT_SEC)
    else
        UnregisterScriptCallback("npc_on_hit_callback", _on_hit)
        UnregisterScriptCallback("server_entity_on_unregister", _on_unregister)
        UnregisterScriptCallback("npc_shot_dispersion",   _on_shot)
        UnregisterScriptCallback("bullet_on_impact",      _on_impact)
        UnregisterScriptCallback("actor_on_hit_callback", _on_actor_hit)
        RemoveTimeEvent("at_world_trace", "monitor")
        RemoveTimeEvent("at_world_trace", "watch")
        RemoveTimeEvent("at_world_trace", "report")
        RemoveTimeEvent("at_world_trace", "velpoll")
        if _orig_set_state then
            state_mgr.set_state = _orig_set_state
            _orig_set_state = nil
        end
        write_report()
        log.flush()
        log.info("World trace disabled")
    end
end

local function _update_config()
    _apply_enabled()
end

local function _on_first_update()
    _update_config()
end

local function _on_actor_net_destroy()
    if _enabled then
        write_report()
        log.flush()
    end
end

--- Write the ballistics minute tables now (also runs on the 60s tick and at level exit).
function write_report()
    local minutes = (time_global() - _t0) / 60000
    if minutes <= 0 then return end
    log.info("=== ballistics %dm%02ds ===", math_floor(minutes), math_floor((minutes % 1) * 60))
    for i = 1, #TIERS do
        local tier = TIERS[i]
        local row = _tiers[tier]
        if row and row.shots > 0 then
            local moving_n = row.ahead_n + row.behind_n
            log.info("tier=%-12s shots=%-5d hits=%-4d hit=%.1f%% still=%.1f%% moving=%.1f%% conv=%.0f%% dmg=%.2f hpm=%.1f ang=%.1fdeg ahead=%.0f%% off=%.1fdeg wrong=%.0f%%",
                tier, row.shots, row.hits, _get_percent(row.hits, row.shots), _get_percent(row.st_hits, row.st_shots),
                _get_percent(row.mv_hits, row.mv_shots), _get_percent(row.conv, row.near), row.dmg, row.hits / minutes,
                row.ang_n > 0 and (row.ang_sum / row.ang_n) or 0,
                moving_n > 0 and (100 * row.ahead_n / moving_n) or 0,
                row.aim_shots > 0 and (row.aim_off_sum / row.aim_shots) or 0,
                _get_percent(row.wrongway, row.aim_shots))
        end
    end
    for name, row in pairs(_drive) do
        log.info("drive=%-8s shots=%-5d hits=%-4d hit=%.1f%%", name, row.shots, row.hits, _get_percent(row.hits, row.shots))
    end
    for kind, hist in pairs(_bursts) do
        log.info("bursts kind=%-10s %s", tostring(kind), _format_hist_line(hist))
    end
    if _nat_n > 0 then
        log.info("[NAT] checks=%d total=%.1fms avg=%.3fms", _nat_n, _nat_ms, _nat_ms / _nat_n)
        _nat_ms, _nat_n = 0, 0
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("actor_on_net_destroy",       _on_actor_net_destroy)
    RegisterScriptCallback("on_option_change",           _update_config)
    RegisterScriptCallback("mcm_option_restore_default", _update_config)
end

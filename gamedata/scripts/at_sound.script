--- at_sound: Danger > Sound - hostile stalkers hear the actor's movement and handling noise

local time_global, string_find, string_lower = time_global, string.find, string.lower
local IsStalker, IsMoveState, pairs, tostring = IsStalker, IsMoveState, pairs, tostring
local RegisterScriptCallback, ini_sys, ini_file = RegisterScriptCallback, ini_sys, ini_file
local string_match, tonumber = string.match, tonumber

local LTX_PATH    = "alifetactics\\at_sound_config.ltx"
local LTX_SECTION = "at_sound"

local VANILLA_SOUND_THRESHOLD = 0.5
local VANILLA_NPC_FACTOR      = 1.0
local STRENGTH_SOLID, STRENGTH_FAINT = "solid", "faint"

local TICK_SEC
local STEP_FRESH_MS
local REALERT_MS
local INERTION_MS
local BASE_RADIUS_M
local CROUCH_FACTOR
local SPRINT_FACTOR
local RAIN_CUT
local LAND_RADIUS_M
local HEAR_SCALE_MIN
local HEAR_SCALE_MAX
local MATERIAL_FACTORS
local ACTIONS

local _enabled = { move = true, actions = true }
local _mult = 1.0
local _hear_scale = 1.0
local _step_radius   = 0
local _step_at       = 0
local _step_strength = "faint"
local _alert_at       = {}
local _alert_strength = {}
local _pass_active = false

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_num(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    TICK_SEC       = read_num("tick_sec",       0.5)
    STEP_FRESH_MS  = read_num("step_fresh_ms",  900)
    REALERT_MS     = read_num("realert_ms",     4000)
    INERTION_MS    = read_num("inertion_ms",    5000)
    BASE_RADIUS_M  = read_num("base_radius_m",  5)
    CROUCH_FACTOR  = read_num("crouch_factor",  0)
    SPRINT_FACTOR  = read_num("sprint_factor",  1.6)
    RAIN_CUT       = read_num("rain_cut",       0.4)
    LAND_RADIUS_M  = read_num("land_radius_m",  10)
    HEAR_SCALE_MIN = read_num("hear_scale_min", 0.25)
    HEAR_SCALE_MAX = read_num("hear_scale_max", 2.0)
    MATERIAL_FACTORS = { metal = 1.25, wood = 1.15, water = 1.35,
                         grass = 0.7, dirt = 0.8, earth = 0.8, sand = 0.8 }
    for key in pairs(MATERIAL_FACTORS) do
        local v = ini:r_float_ex(LTX_SECTION, "material_factor_" .. key)
        if v then MATERIAL_FACTORS[key] = v end
    end
    ACTIONS = {}
    local defaults = { WPN_reload = "8, solid", WPN_empty = "6, solid", ITM_use = "5, faint" }
    for s_type, def in pairs(defaults) do
        local raw = ini:r_string_ex(LTX_SECTION, "action_" .. string_lower(s_type)) or def
        local radius, strength = string_match(raw, "^%s*([%d%.]+)%s*,%s*(%a+)")
        if not radius then radius, strength = string_match(def, "^%s*([%d%.]+)%s*,%s*(%a+)") end
        ACTIONS[s_type] = { tonumber(radius), strength }
    end
end

local function _get_material_factor(material)
    if not material then return 1.0 end
    local name = string_lower(material)
    for key, factor in pairs(MATERIAL_FACTORS) do
        if string_find(name, key, 1, true) then return factor end
    end
    return 1.0
end

local function _on_footstep(material, _power, _hud_view, _flags)
    if not _enabled.move then return end
    local stance, strength = 1.0, "faint"
    if IsMoveState("mcCrouch") then
        stance = CROUCH_FACTOR
    elseif IsMoveState("mcSprint") then
        stance, strength = SPRINT_FACTOR, "solid"
    end
    local radius = BASE_RADIUS_M * stance * _get_material_factor(material) * _mult * _hear_scale
    if radius > _step_radius then
        _step_radius, _step_strength = radius, strength
    end
    _step_at = time_global()
end

local function _on_land(_landing_speed)
    if not _enabled.move then return end
    local radius = LAND_RADIUS_M * _mult * _hear_scale
    if radius > _step_radius then
        _step_radius, _step_strength = radius, "solid"
    end
    _step_at = time_global()
end

local function _try_alert(npc, id, pos, tg, source, strength)
    if not npc:alive() then return end
    if not xcreature.is_enemy_to_actor(npc) then return end
    local last = _alert_at[id]
    local escalates = strength == STRENGTH_SOLID and _alert_strength[id] == STRENGTH_FAINT
    if last and (tg - last) < REALERT_MS and not escalates then return end
    _alert_at[id] = tg
    _alert_strength[id] = strength
    xr_danger.set_script_danger(npc, INERTION_MS, AC_ID, pos, strength)
    if at_debug.is_on() then at_debug.debug("[SOUND] alert id=%d name=%s source=%s strength=%s", id, npc:name(), source, strength) end
end

local function _iterate_movement(tg)
    if _step_radius <= 0 then return end
    if (tg - _step_at) > STEP_FRESH_MS then _step_radius = 0 return end
    local radius, strength = _step_radius, _step_strength
    _step_radius, _step_strength = 0, "faint"
    local rain = level.rain_factor()
    if rain and rain > 0 then radius = radius * (1.0 - RAIN_CUT * rain) end
    local radius_sqr = radius * radius
    local actor_pos = db.actor:position()
    for i = 1, #db.OnlineStalkers do
        local id = db.OnlineStalkers[i]
        local st = db.storage[id]
        local npc = st and st.object
        if npc and actor_pos:distance_to_sqr(npc:position()) <= radius_sqr then
            _try_alert(npc, id, actor_pos, tg, "step", strength)
        end
    end
    at_debug.debug("[SOUND] scan radius=%.1fm rain=%.2f", radius, rain or 0)
end

local function _run_pass()
    if not _pass_active then return true end
    ResetTimeEvent("at_sound", "pass", TICK_SEC)
    if not _enabled.move then return end
    if not db.actor then return end
    _iterate_movement(time_global())
end

local function _on_hear(npc, who_id, s_type, dist_sqr, _power, pos)
    if not _enabled.actions then return end
    if who_id ~= AC_ID then return end
    local row = ACTIONS[s_type]
    if not row then return end
    local radius = row[1] * _mult
    if dist_sqr > radius * radius then return end
    if not (npc and IsStalker(npc)) then return end
    _try_alert(npc, npc:id(), pos, time_global(), s_type, row[2])
end

local function _on_entity_unregister(se_obj)
    if se_obj then
        _alert_at[se_obj.id] = nil
        _alert_strength[se_obj.id] = nil
    end
end

local function _compute_hear_scale()
    local threshold = ini_sys:r_float_ex("stalker", "sound_threshold") or VANILLA_SOUND_THRESHOLD
    local perceive = ini_sys:r_string_ex("stalker", "sound_perceive_section") or "stalker_sound_perceive"
    local npc_factor = ini_sys:r_float_ex(perceive, "npc") or VANILLA_NPC_FACTOR
    if threshold <= 0 then return 1.0 end
    local scale = (VANILLA_SOUND_THRESHOLD / threshold) * (npc_factor / VANILLA_NPC_FACTOR)
    if scale < HEAR_SCALE_MIN then return HEAR_SCALE_MIN end
    if scale > HEAR_SCALE_MAX then return HEAR_SCALE_MAX end
    return scale
end

local function _update_config()
    at_debug.update_config()
    _enabled.move    = at_mcm.get_config("danger_move_noise")    ~= false
    _enabled.actions = at_mcm.get_config("danger_heard_actions") ~= false
    _mult = at_mcm.get_config("danger_noise_mult") or 1.0
end

local function _start_pass()
    if _pass_active then return end
    _pass_active = true
    RemoveTimeEvent("at_sound", "pass")
    CreateTimeEvent("at_sound", "pass", TICK_SEC, _run_pass)
end

local function _on_first_update()
    _update_config()
    _hear_scale = _compute_hear_scale()
    _start_pass()
    at_debug.info("Sound initialized (move=%s actions=%s mult=%.2f hear_scale=%.2f)",
        tostring(_enabled.move), tostring(_enabled.actions), _mult, _hear_scale)
end

function on_game_start()
    _load_config()
    RegisterScriptCallback("actor_on_footstep",           _on_footstep)
    RegisterScriptCallback("actor_on_land",               _on_land)
    RegisterScriptCallback("npc_on_hear_callback",        _on_hear)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _update_config)
    RegisterScriptCallback("mcm_option_restore_default",  _update_config)
end

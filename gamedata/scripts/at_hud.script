--- at_hud: live debug HUD listing nearby NPCs with their logic scheme, combat action, and target.
--- Per NPC: the active xr_logic section (scheme@subsection), the engine combat operator + physical state, and
--- the selected enemy with distance and an aim flag (blind = cannot see it, OFF = body pointed away from it).

local pairs, table_sort, math_floor, tostring = pairs, table.sort, math.floor, tostring
local string_sub, string_format = string.sub, string.format
local IsStalker, RegisterScriptCallback = IsStalker, RegisterScriptCallback

local log = xlog.get_logger("AT.HUD", { outfile = "alifetactics.log" })
local cfg = at_mcm.cfg

local REFRESH_INTERVAL_SEC = 1
-- Scan radius and idle-row visibility are code constants, not MCM options: every key in at_mcm defaults
-- must have a tree widget (ui_mcm.get validates the path against the option tree), and these never had one.
local HUD_RADIUS_M  = 100
local HUD_SHOW_IDLE = false

local ROW_H    = 13
local PAD      = 6
local COL_GAP  = 10
-- Columns auto-size to their widest cell (header + rows): width = maxchars * CHAR_W + CELL_PAD. CHAR_W is the
-- approximate pixel advance of the HUD font; CELL_PAD keeps text off the next column. With no fixed column
-- widths a short column is not padded to a huge gap and long content is not clipped.
local CHAR_W   = 6
local CELL_PAD = 3
local MARGIN   = 15
local MAX_ROWS = 50
local NAME_MAX = 18
local CELL_MAX = 20
local TARGET_NAME_MAX = 12
-- body-to-enemy angle above this many degrees reads as "pointed away" (the weird-aim flag)
local FACING_DEG = 60

-- Colors built lazily; GetARGB is not present at module-load under the static validator.
local CLR_TITLE, CLR_AT, CLR_NORMAL, CLR_DIM = nil, nil, nil, nil

local function _init_colors()
    if CLR_TITLE then return end
    CLR_TITLE  = GetARGB(220, 200, 180, 130)
    CLR_AT     = GetARGB(240, 170, 220, 170)
    CLR_NORMAL = GetARGB(220, 200, 200, 200)
    CLR_DIM    = GetARGB(160, 160, 160, 160)
end


-- =========================================================================
-- Position presets
-- =========================================================================

local function _calc_position(panel_h, total_w)
    local cy = math_floor((768 - panel_h) / 2)
    local rx = 1024 - total_w - MARGIN
    local by = 768 - panel_h - MARGIN
    local presets = {
        top_left     = { MARGIN, MARGIN },
        top_right    = { rx,     MARGIN },
        center_left  = { MARGIN, cy },
        center_right = { rx,     cy },
        bottom_left  = { MARGIN, by },
        bottom_right = { rx,     by },
    }
    return presets[cfg.hud_position] or presets.center_right
end


-- =========================================================================
-- Per-NPC derivation: logic scheme, combat operator + state, target + aim flag
-- =========================================================================

local function _truncate(s, limit)
    if not s or s == "" then return "?" end
    if #s > limit then return string_sub(s, 1, limit) end
    return s
end

-- Enemy name + distance + aim flag: "blind" when the NPC cannot see it, "OFF" when its body is pointed away.
local function _target_desc(npc, enemy)
    local epos = enemy:position()
    local dist = math_floor(npc:position():distance_to(epos))
    local name = _truncate(xcreature.get_name(enemy:id()), TARGET_NAME_MAX)
    local flag = ""
    if not npc:see(enemy) then
        flag = " (no sight)"
    elseif xcombat.get_facing_offset(npc, epos) >= FACING_DEG then
        flag = " (turned away)"
    end
    return string_format("%s %dm%s", name, dist, flag)
end

-- tag (AT when our maneuver drives), logic section, combat operator/state, target, in_combat
-- Two separate readings, never merged: DRIVER = who decides this NPC's combat right now - an AT maneuver
-- ("AT flee"/"AT kite") when the takeover holds it, else the engine operator ("eng combat"/"eng danger" or a
-- raw action id "eng 18803") when vanilla drives. STATE = the engine state_mgr target state the body is actually
-- in ("assault", "wounded_heavy", "idle"). So "AT flee" + "wounded_heavy" reads: AT wants a flee, but the engine
-- has the NPC wounded (the takeover action can't run on a wounded body).
local function _derive(npc, st)
    local maneuver = at_combat.get_maneuver(npc:id())
    local tag = maneuver and "AT" or nil
    local logic = _truncate(st.active_section or st.active_scheme or "-", CELL_MAX)
    local driver = maneuver and ("AT " .. maneuver) or ("eng " .. xcombat.get_operator(npc))
    local enemy = npc:best_enemy()
    if not enemy then
        return tag, logic, driver, "-", "-", false
    end
    local sm = st.state_mgr
    local state = (sm and sm.target_state) or "-"
    return tag, logic, driver, state, _target_desc(npc, enemy), true
end


-- =========================================================================
-- Row builder: walk db.storage, derive per NPC, sort, cap
-- =========================================================================

local function _row_for(id, st, ax, r2, actor_id, show_idle)
    if id == actor_id then return nil end
    local npc = level.object_by_id(id)
    if not npc then return nil end
    if not IsStalker(npc) then return nil end
    if not npc:alive() then return nil end
    if ax:distance_to_sqr(npc:position()) >= r2 then return nil end
    local tag, logic, driver, state, target, is_combat = _derive(npc, st)
    if not (show_idle or is_combat) then return nil end
    return {
        tag       = tag,
        name      = _truncate(npc:character_name() or npc:name(), NAME_MAX),
        logic     = logic,
        driver    = driver,
        state     = state,
        target    = target,
        is_combat = is_combat,
    }
end

local function _build_rows()
    if not db.actor then return {} end
    local ax = db.actor:position()
    local r2 = HUD_RADIUS_M * HUD_RADIUS_M
    local show_idle = HUD_SHOW_IDLE
    local actor_id = db.actor:id()

    local rows = {}
    for id, st in pairs(db.storage) do
        local row = _row_for(id, st, ax, r2, actor_id, show_idle)
        if row then rows[#rows + 1] = row end
    end

    table_sort(rows, function(a, b)
        if (a.tag == "AT") ~= (b.tag == "AT") then return a.tag == "AT" end
        if a.is_combat ~= b.is_combat then return a.is_combat end
        return a.name < b.name
    end)

    if #rows > MAX_ROWS then
        local extra = #rows - MAX_ROWS
        for i = #rows, MAX_ROWS + 1, -1 do rows[i] = nil end
        rows[#rows + 1] = { name = string_format("+%d more", extra), logic = "", driver = "", state = "", target = "", is_overflow = true }
    end

    return rows
end


-- =========================================================================
-- UIDebugHUD: CUIScriptWnd painting one static-text widget per cell
-- =========================================================================

-- Per-column pixel widths from the widest cell (header + every row), so each column fits its own content.
local function _column_widths(header, cells)
    local cols = #header
    local max_chars = {}
    for col = 1, cols do max_chars[col] = #header[col] end
    for row_i = 1, #cells do
        local row = cells[row_i]
        for col = 1, cols do
            local chars = #(row[col] or "")
            if chars > max_chars[col] then max_chars[col] = chars end
        end
    end
    local widths = {}
    for col = 1, cols do widths[col] = max_chars[col] * CHAR_W + CELL_PAD end
    return widths
end

class "UIDebugHUD" (CUIScriptWnd)

function UIDebugHUD:__init(rows) super()
    _init_colors()
    self:SetAutoDelete(true)
    self:Enable(true)

    -- Build cell arrays (header first), then size each column to its widest cell.
    local header = { "NAME", "SCHEME", "DRIVER", "STATE", "TARGET" }
    local cells = {}
    for i = 1, #rows do
        local row = rows[i]
        cells[i] = { row.name or "", row.logic or "", row.driver or "", row.state or "", row.target or "" }
    end
    local widths = _column_widths(header, cells)
    local total_w = PAD * 2
    for col = 1, #widths do total_w = total_w + widths[col] + (col < #widths and COL_GAP or 0) end

    -- +2 rows for the header + spacer
    local panel_h = (#rows + 2) * ROW_H + PAD * 2
    local pos = _calc_position(panel_h, total_w)
    self:SetWndPos(vector2():set(pos[1], pos[2]))
    self:SetWndSize(vector2():set(total_w, panel_h))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_at_stats.xml")

    self:_row(xml, PAD, header, widths, CLR_TITLE)

    for i = 1, #rows do
        local row = rows[i]
        local color
        if row.is_overflow then color = CLR_DIM
        elseif row.tag == "AT" then color = CLR_AT
        else color = CLR_NORMAL end
        self:_row(xml, PAD + (i + 1) * ROW_H, cells[i], widths, color)
    end
end

function UIDebugHUD:_row(xml, y, cells, widths, color)
    local col_x = PAD
    for col = 1, #cells do
        self:_cell(xml, col_x, y, widths[col], cells[col], color)
        col_x = col_x + widths[col] + COL_GAP
    end
end

function UIDebugHUD:_cell(xml, x, y, w, text, color)
    local st = xml:InitStatic("line", self)
    st:SetWndPos(vector2():set(x, y))
    st:SetWndSize(vector2():set(w, ROW_H - 2))
    local tc = st:TextControl()
    tc:SetText(text or "")
    tc:SetTextColor(color)
    return st
end

function UIDebugHUD:__finalize() end


-- =========================================================================
-- Lifecycle: visibility-gated 1s refresh via ResetTimeEvent
-- =========================================================================

local _hud = nil
local _tick_active = false

local function _hide()
    if _hud then
        get_hud():RemoveDialogToRender(_hud)
        _hud = nil
    end
end

local function _refresh()
    _hide()
    _hud = UIDebugHUD(_build_rows())
    get_hud():AddDialogToRender(_hud)
end

local function _is_visible()
    if not main_hud_shown() then return false end
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:IsShown() then return false end
    return true
end

local function _tick()
    if not _tick_active then
        _hide()
        return true
    end
    if _is_visible() then _refresh() else _hide() end
    ResetTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC)
end

local function _start()
    if _tick_active then return end
    _tick_active = true
    RemoveTimeEvent("at_hud", "tick")
    CreateTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC, _tick)
    log.info("Debug HUD enabled (position=%s, radius=%dm, show_idle=%s)",
        cfg.hud_position or "center_right", HUD_RADIUS_M, tostring(HUD_SHOW_IDLE))
end

local function _stop()
    _tick_active = false
    RemoveTimeEvent("at_hud", "tick")
    _hide()
    log.info("Debug HUD disabled")
end

local function _on_option_change()
    if cfg.hud_enabled then _start() else _stop() end
end

local function _on_first_update()
    if cfg.hud_enabled then _start() end
end

local function _on_actor_net_destroy()
    _stop()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("actor_on_net_destroy",       _on_actor_net_destroy)
    RegisterScriptCallback("on_option_change",           _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

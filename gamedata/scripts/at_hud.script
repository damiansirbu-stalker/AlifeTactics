--- at_hud: live debug HUD listing nearby NPCs, two lines per NPC on one shared 2-column grid -
--- identical column positions on both lines, so everything aligns by construction (a single line
--- per NPC was tried and proved too wide). NO header rows of any kind (tried, read as noise): the
--- grouping is pure ORDER - AT-driven first (green), then anyone fighting (blue while Commitment
--- refuses his cover move), then idle (only with HUD_SHOW_IDLE) - and every row is self-describing.
--- Line A, bright: full rank + name + hp | SYSTEMS - every AT combat system active on the NPC, one
--- comma-joined list in the who-drives colour (a maneuver's name in caps; COMMIT + age and PIN while
--- Commitment vetoes; CROUCH while Conduct holds a posture), "-" plain when vanilla drives untouched.
--- Line B, dim: target (name + distance + sight word) | engine (scheme + mental). Sight words are
--- plain English: "sees" / "aims-off" (sees but body pointed away) / "blind". The cover belief/ray
--- forensics and the fire-gate verdicts live in the decision trace.

local pairs, table_sort, table_concat, math_floor, tostring = pairs, table.sort, table.concat, math.floor, tostring
local time_global = time_global
local string_sub, string_format, string_upper = string.sub, string.format, string.upper
local IsStalker, RegisterScriptCallback = IsStalker, RegisterScriptCallback

local cfg = at_mcm.cfg

-- 0.5s: the takeover state this HUD reports changes on a 200ms cadence and maneuvers can live ~2-3s;
-- a slower refresh can miss a whole maneuver between two paints (the 2026-07-10 invisible-kite report).
local REFRESH_INTERVAL_SEC = 0.5
-- Scan radius and idle-row visibility are code constants, not MCM options: every key in at_mcm defaults
-- must have a tree widget (ui_mcm.get validates the path against the option tree), and these never had one.
local HUD_RADIUS_M  = 100
local HUD_SHOW_IDLE = false

local ROW_H    = 13
local PAD      = 6
local COL_GAP  = 6
-- Fixed-char column widths (width = chars * CHAR_W + CELL_PAD). CHAR_W is the HUD font's approximate
-- pixel advance. Two lines per NPC over one shared 2-column grid: the panel is ~316px (under 1/3
-- screen) and the name budgets are LARGER than the single-line layout allowed.
local CHAR_W   = 6
local CELL_PAD = 2
local MARGIN   = 15
local MAX_ROWS = 16
local SUBJECT_NAME_MAX = 15
local TARGET_NAME_MAX  = 20
local SCHEME_MAX       = 14
-- body-to-enemy angle above this many degrees reads as "pointed away" (the weird-aim flag)
local FACING_DEG = 60

-- Colors built lazily; GetARGB is not present at module-load under the static validator.
local CLR_AT, CLR_HOLD, CLR_CONDUCT, CLR_NORMAL, CLR_DIM = nil, nil, nil, nil, nil

-- Row colour = which combat system touches the NPC: green a maneuver drives him, blue Commitment holds
-- him, mauve Conduct posture (crouch) on an otherwise vanilla NPC, plain vanilla untouched, dim detail.
local function _init_colors()
    if CLR_AT then return end
    CLR_AT      = GetARGB(240, 170, 220, 170)
    CLR_HOLD    = GetARGB(240, 150, 190, 235)
    CLR_CONDUCT = GetARGB(240, 205, 165, 220)
    CLR_NORMAL  = GetARGB(220, 200, 200, 200)
    CLR_DIM     = GetARGB(160, 160, 160, 160)
end


-- =========================================================================
-- Position presets
-- =========================================================================

local function _calc_position(panel_h, total_w, pos_key)
    local cy = math_floor((768 - panel_h) / 2)
    local rx = 1024 - total_w - MARGIN
    local by = 768 - panel_h - MARGIN
    local presets = {
        top_left     = { MARGIN, MARGIN },
        top_right    = { rx,     MARGIN },
        center_left  = { MARGIN, cy },
        center_right = { rx,     cy },
        bottom_left  = { MARGIN, by },
        bottom_right = { rx,     by },
    }
    return presets[pos_key] or presets.center_right
end


-- =========================================================================
-- Per-NPC derivation: logic scheme, combat operator + state, target + aim flag
-- =========================================================================

local function _truncate(s, limit)
    if not s or s == "" then return "?" end
    if #s > limit then return string_sub(s, 1, limit) end
    return s
end

-- Sight to the enemy in plain words: "blind" (the engine's visible_now is false - he does not see the
-- enemy right now), "aims-off" (sees it but body pointed >= FACING_DEG off it), "sees" (looking at it).
local function _sight_flag(npc, enemy)
    if not xcombat.sees(npc, enemy) then return "blind" end
    if xcombat.get_facing_offset(npc, enemy:position()) >= FACING_DEG then return "aims-off" end
    return "sees"
end

-- The target cell: enemy name + distance + sight word, "-" when no selected enemy.
local function _target_cell(npc, enemy)
    if not enemy then return "-" end
    return string_format("%s %dm %s",
        _truncate(xcreature.get_name(enemy:id()), TARGET_NAME_MAX),
        math_floor(npc:position():distance_to(enemy:position())),
        _sight_flag(npc, enemy))
end

-- Reverse map anim enum -> label, built lazily (anim is a global enum, absent at file body).
local _MENTAL
local function _mental_name(npc)
    if not _MENTAL then _MENTAL = { [anim.free] = "free", [anim.danger] = "danger", [anim.panic] = "panic" } end
    local mental = npc:mental_state()
    return _MENTAL[mental] or tostring(mental)
end

-- The SYSTEMS cell: every AT combat system active on the NPC, one comma-joined list rendered in the
-- who-drives colour, so the three systems read the same way instead of one being a bright headline and
-- another a dim exile. A maneuver is exclusive (it blocks the planner, so no hold and no conduct can
-- co-occur) and stands alone; Commitment (COMMIT + age, PIN) and Conduct (CROUCH) are composable
-- modifiers on a vanilla NPC and list together when both hold. Returns the text and the dominant
-- driver (AT > HOLD > CONDUCT) that colours the row. "-" plain when vanilla drives untouched.
local function _systems(id, maneuver)
    if maneuver then return string_upper(maneuver), "AT" end
    local tokens, driver = {}, nil
    -- Commitment is one system with two vetoes (MCM Combat > Commitment): the action-switch hold
    -- (COMMIT) and the cover-pin (PIN, commitment_cover_pin).
    local hold = at_commitment.get_hold(id)
    if hold then tokens[#tokens + 1] = string_format("COMMIT %ds", math_floor((time_global() - hold.since) / 1000)) end
    if at_commitment.cover_held(id) then tokens[#tokens + 1] = "PIN" end
    if #tokens == 0 then
        -- Afterglow: commitments run sub-second (deny-only, no imposed delay), invisible at the refresh
        -- cadence - the row stays blue for a few seconds showing what was just committed.
        local recent = at_commitment.get_recent_hold(id)
        if recent then tokens[#tokens + 1] = string_format("COMMITTED %.1fs x%d", recent.held_ms / 1000, recent.denies) end
    end
    if #tokens > 0 then driver = "HOLD" end
    -- Conduct posture (at_stance, Combat > Conduct): crouches an experienced rifleman behind real cover.
    -- Composes with a Commitment hold on the same vanilla NPC, so it appends rather than replaces.
    if at_stance.crouched(id) then
        tokens[#tokens + 1] = "CROUCH"
        driver = driver or "CONDUCT"
    end
    if #tokens == 0 then return "-", nil end
    return table_concat(tokens, ", "), driver
end

local function _derive(npc, st)
    local id = npc:id()
    local maneuver = at_combat.get_maneuver(id)
    local enemy = npc:best_enemy()
    local rank = ranks.get_obj_rank_name(npc)
    -- The three combat systems (Maneuvers, Commitment, Conduct) collapse into one comma-joined SYSTEMS
    -- cell; its dominant driver colours the whole row. Mechanics (ammo AP, healing, limp) are not
    -- combat state and stay in the log / world trace.
    local systems, driver = _systems(id, maneuver)
    return {
        driver  = driver,
        stalker = string_format("(%s) %s %d%%",
            rank or "-",
            _truncate(npc:character_name() or npc:name(), SUBJECT_NAME_MAX),
            math_floor((npc.health or 0) * 100)),
        target  = _target_cell(npc, enemy),
        -- scheme is omitted when absent, not printed as "-" (a leading dash reads as a stray
        -- minus); mental is always present, so the cell is never empty.
        engine  = (st.active_scheme and (_truncate(st.active_scheme, SCHEME_MAX) .. " ") or "")
            .. _mental_name(npc),
        systems = systems,
        is_combat = enemy ~= nil,
    }
end


-- =========================================================================
-- Row builder: walk db.storage, derive per NPC, sort, cap
-- =========================================================================

-- Cheap candidate pass: no raycast, no name read, no operator read - just the row's identity and
-- sort keys. The expensive derivation (_derive: cover ray, operator, names) runs only for the
-- capped visible set, so a huge crowd costs MAX_ROWS derivations, not one per NPC in radius.
local function _candidate(id, st, ax, r2, actor_id, show_idle)
    if id == actor_id then return nil end
    local npc = st.object or xobject.go(id)
    if not npc then return nil end
    if not IsStalker(npc) then return nil end
    if not npc:alive() then return nil end
    local dist_sqr = ax:distance_to_sqr(npc:position())
    if dist_sqr >= r2 then return nil end
    local maneuver = at_combat.get_maneuver(id)
    local is_combat = maneuver ~= nil or npc:best_enemy() ~= nil
    if not (show_idle or is_combat) then return nil end
    return { npc = npc, st = st, dist_sqr = dist_sqr, at = maneuver ~= nil, is_combat = is_combat }
end

local function _build_rows()
    local actor = db.actor
    if not actor then return {} end
    local ax = actor:position()
    local r2 = HUD_RADIUS_M * HUD_RADIUS_M
    local actor_id = actor:id()

    -- Partition into sections instead of interleaved sorting: AT-driven, then anyone fighting,
    -- then idle (only with HUD_SHOW_IDLE); nearest first within each.
    local at_list, fight_list, idle_list = {}, {}, {}
    for id, st in pairs(db.storage) do
        local cand = _candidate(id, st, ax, r2, actor_id, HUD_SHOW_IDLE)
        if cand then
            local list = (cand.at and at_list) or (cand.is_combat and fight_list) or idle_list
            list[#list + 1] = cand
        end
    end
    local by_dist = function(a, b) return a.dist_sqr < b.dist_sqr end
    table_sort(at_list, by_dist)
    table_sort(fight_list, by_dist)
    table_sort(idle_list, by_dist)

    -- No header rows of any kind: the grouping is pure ORDER (maneuvers first - and green - then
    -- fighters, then idle), every row self-describing. Skipped entries land in the overflow line.
    local rows, shown, total = {}, 0, #at_list + #fight_list + #idle_list
    local function emit(list)
        for i = 1, #list do
            if #rows >= MAX_ROWS then return end
            rows[#rows + 1] = _derive(list[i].npc, list[i].st)
            shown = shown + 1
        end
    end
    emit(at_list)
    emit(fight_list)
    emit(idle_list)

    if shown < total then
        rows[#rows + 1] = { stalker = string_format("+%d more", total - shown), is_overflow = true }
    end

    return rows
end


-- =========================================================================
-- UIDebugHUD: CUIScriptWnd built ONCE, refresh only rewrites text + colors
-- (no per-tick widget construction). Two lines per NPC on ONE shared grid.
-- =========================================================================

-- The shared grid (chars per column) and what each line puts in it. Two columns per line: identity over
-- its target on the left, the active systems over the engine words on the right. The systems budget (28)
-- holds the longest realistic list - "COMMIT 9s, PIN, CROUCH".
local GRID  = { 34, 28 }
local ROW_A = { "stalker", "systems" }
local ROW_B = { "target", "engine" }

local function _lay_widths(chars)
    local widths, total = {}, 0
    for i = 1, #chars do
        widths[i] = chars[i] * CHAR_W + CELL_PAD
        total = total + widths[i] + COL_GAP
    end
    return widths, total
end

class "UIDebugHUD" (CUIScriptWnd)

function UIDebugHUD:__init() super()
    _init_colors()
    self:SetAutoDelete(true)
    self:Enable(true)

    local widths, total_w = _lay_widths(GRID)
    total_w = total_w + PAD * 2
    -- No header lines: MAX_ROWS entries (2 lines each) + 1 overflow line, rows self-describing.
    local panel_h = ((MAX_ROWS + 1) * 2) * ROW_H + PAD * 2
    local pos = _calc_position(panel_h, total_w, cfg.hud_position)
    self:SetWndPos(vector2():set(pos[1], pos[2]))
    self:SetWndSize(vector2():set(total_w, panel_h))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_at_stats.xml")

    -- Entry i on rows ((i-1)*2) and ((i-1)*2 + 1). Entry MAX_ROWS+1 is the single-line "+N more" overflow.
    self.a, self.b = {}, {}
    for i = 1, MAX_ROWS + 1 do
        local row_y = PAD + (i - 1) * 2 * ROW_H
        self.a[i] = self:_line(xml, row_y, widths, PAD)
        self.b[i] = self:_line(xml, row_y + ROW_H, widths, PAD)
    end
    self.used = 0
end

-- Build one row of static-text cells at y from x0, one per width. Returns the TextControl array.
function UIDebugHUD:_line(xml, y, widths, x0)
    local cells, col_x = {}, x0
    for i = 1, #widths do
        cells[i] = self:_cell(xml, col_x, y, widths[i])
        col_x = col_x + widths[i] + COL_GAP
    end
    return cells
end


function UIDebugHUD:_cell(xml, x, y, w)
    local st = xml:InitStatic("line", self)
    st:SetWndPos(vector2():set(x, y))
    st:SetWndSize(vector2():set(w, ROW_H - 2))
    return st:TextControl()
end

-- Rewrite both lines per entry from freshly built rows; blank only what the previous refresh used.
-- No allocation, no widget construction. Both Line A cells take the row color, uniformly - the name and
-- the systems list read in the who-drives colour together, so no system is a bright headline while
-- another is a dim exile. Line B stays dim, the pairing cue. The overflow entry fills only its first A
-- cell. Row color: green = a maneuver drives him, blue = Commitment holds/pins him, mauve = Conduct
-- crouches him, plain = vanilla drives untouched.
local function _row_color(row)
    if row.is_overflow then return CLR_DIM end
    if row.driver == "AT" then return CLR_AT end
    if row.driver == "HOLD" then return CLR_HOLD end
    if row.driver == "CONDUCT" then return CLR_CONDUCT end
    return CLR_NORMAL
end

local function _paint_entry(a, b, row)
    local color = _row_color(row)
    for c = 1, #ROW_A do
        a[c]:SetText(row[ROW_A[c]] or "")
        a[c]:SetTextColor(color)
    end
    for c = 1, #ROW_B do
        b[c]:SetText(row.is_overflow and "" or (row[ROW_B[c]] or ""))
        b[c]:SetTextColor(CLR_DIM)
    end
end

function UIDebugHUD:set_rows(rows)
    local count = #rows
    if count > MAX_ROWS + 1 then count = MAX_ROWS + 1 end
    for i = 1, count do
        _paint_entry(self.a[i], self.b[i], rows[i])
    end
    for i = count + 1, self.used do
        local a, b = self.a[i], self.b[i]
        for c = 1, #ROW_A do a[c]:SetText("") end
        for c = 1, #ROW_B do b[c]:SetText("") end
    end
    self.used = count
end

function UIDebugHUD:__finalize() end


-- =========================================================================
-- Lifecycle: visibility-gated refresh (REFRESH_INTERVAL_SEC) via ResetTimeEvent
-- =========================================================================

local _hud = nil
local _shown = false
local _tick_active = false

local function _debug_wanted()
    return cfg.hud_position ~= "off"
end

local function _hide()
    if _hud and _shown then
        get_hud():RemoveDialogToRender(_hud)
        _shown = false
    end
end

-- Drop the window entirely (position change, actor teardown); the next refresh rebuilds it.
local function _drop_hud()
    _hide()
    _hud = nil
end

local function _refresh()
    local tmr = xprofiler.new_if(at_debug.on()):start()
    if _debug_wanted() then
        local rows = _build_rows()
        if not _hud then _hud = UIDebugHUD() end
        if not _shown then
            get_hud():AddDialogToRender(_hud)
            _shown = true
        end
        _hud:set_rows(rows)
    end
    tmr:stop()
    if at_debug.on() then at_debug.dbg("[HUD] refresh [%.2fms]", tmr:get_ms()) end
end

local function _is_visible()
    if not main_hud_shown() then return false end
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:IsShown() then return false end
    return true
end

local function _tick()
    if not _tick_active then
        _hide()
        return true
    end
    -- Re-arm FIRST: ProcessEventQueue has no error protection, so an expired event that errors would
    -- re-fire and re-error every frame, starving every time event in the game.
    ResetTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC)
    if _is_visible() then _refresh() else _hide() end
end

local function _start()
    if _tick_active then return end
    _tick_active = true
    RemoveTimeEvent("at_hud", "tick")
    CreateTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC, _tick)
    at_debug.info("Debug HUD enabled (position=%s, radius=%dm, show_idle=%s)",
        cfg.hud_position or "center_right", HUD_RADIUS_M, tostring(HUD_SHOW_IDLE))
end

local function _stop()
    _tick_active = false
    RemoveTimeEvent("at_hud", "tick")
    _drop_hud()
    at_debug.info("Debug HUD disabled")
end

local function _refresh_log()
    at_debug.refresh()
end

local function _on_option_change()
    _refresh_log()
    _drop_hud()
    if _debug_wanted() then _start() else _stop() end
end

local function _on_first_update()
    _refresh_log()
    if _debug_wanted() then _start() end
end

local function _on_actor_net_destroy()
    _stop()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("actor_on_net_destroy",       _on_actor_net_destroy)
    RegisterScriptCallback("on_option_change",           _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

--- at_hud: live debug HUD - nearby NPCs, two lines each on one shared grid, row colour = the driving system

local pairs, table_sort, table_concat, math_floor, tostring = pairs, table.sort, table.concat, math.floor, tostring
local time_global = time_global
local string_sub, string_format, string_upper = string.sub, string.format, string.upper
local RegisterScriptCallback = RegisterScriptCallback

local cfg = at_mcm.cfg

local REFRESH_INTERVAL_SEC = 0.5
local HUD_SHOW_IDLE = false

local ROW_H    = 13
local PAD      = 6
local COL_GAP  = 6
local CHAR_W   = 6
local CELL_PAD = 2
local MARGIN   = 15
local MAX_ROWS = 16
local SUBJECT_NAME_MAX = 15
local TARGET_NAME_MAX  = 20
local SCHEME_MAX       = 14
local FACING_DEG = 60

local GRID  = { 34, 28 }
local ROW_A = { "stalker", "systems" }
local ROW_B = { "target", "engine" }

local CLR_AT, CLR_HOLD, CLR_PUSH, CLR_CONDUCT, CLR_NORMAL, CLR_DIM = nil, nil, nil, nil, nil, nil
local _MENTAL
local _hud = nil
local _shown = false
local _tick_active = false

local function _init_colors()
    if CLR_AT then return end
    CLR_AT      = GetARGB(240, 170, 220, 170)
    CLR_HOLD    = GetARGB(240, 150, 190, 235)
    CLR_PUSH    = GetARGB(240, 235, 190, 140)
    CLR_CONDUCT = GetARGB(240, 205, 165, 220)
    CLR_NORMAL  = GetARGB(220, 200, 200, 200)
    CLR_DIM     = GetARGB(160, 160, 160, 160)
end

local function _compute_position(panel_h, total_w, pos_key)
    local cy = math_floor((768 - panel_h) / 2)
    local rx = 1024 - total_w - MARGIN
    local by = 768 - panel_h - MARGIN
    local presets = {
        top_left     = { MARGIN, MARGIN },
        top_right    = { rx,     MARGIN },
        center_left  = { MARGIN, cy },
        center_right = { rx,     cy },
        bottom_left  = { MARGIN, by },
        bottom_right = { rx,     by },
    }
    return presets[pos_key] or presets.center_right
end

local function _format_label(s, limit)
    if not s or s == "" then return "?" end
    if #s > limit then return string_sub(s, 1, limit) end
    return s
end

local function _get_sight_flag(npc, enemy)
    if not xcombat.can_see(npc, enemy) then return "blind" end
    if not xcombat.is_facing(npc, enemy:position(), FACING_DEG) then return "aims-off" end
    return "sees"
end

local function _get_target_cell(npc, enemy)
    if not enemy then return "-" end
    return string_format("%s %dm %s",
        _format_label(xcreature.get_name(enemy:id()), TARGET_NAME_MAX),
        math_floor(npc:position():distance_to(enemy:position())),
        _get_sight_flag(npc, enemy))
end

local function _get_mental_name(npc)
    if not _MENTAL then _MENTAL = { [anim.free] = "free", [anim.danger] = "danger", [anim.panic] = "panic" } end
    local mental = npc:mental_state()
    return _MENTAL[mental] or tostring(mental)
end

local function _format_systems(id, maneuver)
    if maneuver then return string_upper(maneuver), "AT" end
    local tokens, driver = {}, nil
    local hold = at_commitment.get_hold(id)
    local pinned, pin_vuln = at_commitment.is_cover_pinned(id)
    if hold then
        tokens[#tokens + 1] = string_format(hold.vuln and "LIQUIDATE %ds" or "COMMIT %ds",
            math_floor((time_global() - hold.since) / 1000))
    end
    if pinned then
        tokens[#tokens + 1] = (pin_vuln and not (hold and hold.vuln)) and "LIQUIDATE" or "PIN"
    end
    if #tokens == 0 then
        local recent = at_commitment.get_recent_hold(id)
        if recent then
            tokens[#tokens + 1] = string_format(recent.vuln and "LIQUIDATED %.1fs x%d" or "COMMITTED %.1fs x%d",
                recent.held_ms / 1000, recent.denies)
        end
    end
    if #tokens > 0 then driver = "HOLD" end
    if at_behaviors.get_push(id) then
        tokens[#tokens + 1] = "PUSH"
        driver = driver or "PUSH"
    end
    if at_behaviors.get_pull(id) then
        tokens[#tokens + 1] = "PULL"
        driver = driver or "PULL"
    end
    if at_conduct.is_crouched(id) then
        tokens[#tokens + 1] = "CROUCH"
        driver = driver or "CONDUCT"
    end
    if #tokens == 0 then return "-", nil end
    return table_concat(tokens, ", "), driver
end

local function _build_row(npc, st)
    local id = npc:id()
    local maneuver = at_maneuvers.get_maneuver(id)
    local enemy = npc:best_enemy()
    local rank = ranks.get_obj_rank_name(npc)
    local systems, driver = _format_systems(id, maneuver)
    return {
        driver  = driver,
        stalker = string_format("(%s) %s %d%%",
            rank or "-",
            _format_label(npc:character_name() or npc:name(), SUBJECT_NAME_MAX),
            math_floor((npc.health or 0) * 100)),
        target  = _get_target_cell(npc, enemy),
        engine  = ((st and st.active_scheme) and (_format_label(st.active_scheme, SCHEME_MAX) .. " ") or "")
            .. _get_mental_name(npc),
        systems = systems,
        is_combat = enemy ~= nil,
    }
end

local function _build_candidate(id, record, show_idle)
    local npc = xobject.get_go(id)
    if not npc then return nil end
    if not npc:alive() then return nil end
    if not at_core.is_in_gate(record) then return nil end
    local maneuver = record.maneuver and record.maneuver.name or nil
    local is_combat = maneuver ~= nil or record.best_enemy_id ~= nil
    if not (show_idle or is_combat) then return nil end
    return { npc = npc, st = db.storage[id], dist_sqr = record.actor_dist_sqr,
        at = maneuver ~= nil, is_combat = is_combat }
end

local function _build_rows()
    local actor = db.actor
    if not actor then return {} end

    local at_list, fight_list, idle_list = {}, {}, {}
    for id, record in pairs(at_core.get_combat_records()) do
        local cand = _build_candidate(id, record, HUD_SHOW_IDLE)
        if cand then
            local list = (cand.at and at_list) or (cand.is_combat and fight_list) or idle_list
            list[#list + 1] = cand
        end
    end
    local is_closer = function(a, b) return (a.dist_sqr or 0) < (b.dist_sqr or 0) end
    table_sort(at_list, is_closer)
    table_sort(fight_list, is_closer)
    table_sort(idle_list, is_closer)

    local rows, shown, total = {}, 0, #at_list + #fight_list + #idle_list
    local function add_rows(list)
        for i = 1, #list do
            if #rows >= MAX_ROWS then return end
            rows[#rows + 1] = _build_row(list[i].npc, list[i].st)
            shown = shown + 1
        end
    end
    add_rows(at_list)
    add_rows(fight_list)
    add_rows(idle_list)

    if shown < total then
        rows[#rows + 1] = { stalker = string_format("+%d more", total - shown), is_overflow = true }
    end

    return rows
end

local function _compute_widths(chars)
    local widths, total = {}, 0
    for i = 1, #chars do
        widths[i] = chars[i] * CHAR_W + CELL_PAD
        total = total + widths[i] + COL_GAP
    end
    return widths, total
end

class "UIDebugHUD" (CUIScriptWnd)

function UIDebugHUD:__init() super()
    _init_colors()
    self:SetAutoDelete(true)
    self:Enable(true)

    local widths, total_w = _compute_widths(GRID)
    total_w = total_w + PAD * 2
    local panel_h = ((MAX_ROWS + 1) * 2) * ROW_H + PAD * 2
    local pos = _compute_position(panel_h, total_w, cfg.hud_position)
    self:SetWndPos(vector2():set(pos[1], pos[2]))
    self:SetWndSize(vector2():set(total_w, panel_h))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_at_stats.xml")

    self.a, self.b = {}, {}
    for i = 1, MAX_ROWS + 1 do
        local row_y = PAD + (i - 1) * 2 * ROW_H
        self.a[i] = self:_build_line(xml, row_y, widths, PAD)
        self.b[i] = self:_build_line(xml, row_y + ROW_H, widths, PAD)
    end
    self.used = 0
end

function UIDebugHUD:_build_line(xml, y, widths, x0)
    local cells, col_x = {}, x0
    for i = 1, #widths do
        cells[i] = self:_build_cell(xml, col_x, y, widths[i])
        col_x = col_x + widths[i] + COL_GAP
    end
    return cells
end

function UIDebugHUD:_build_cell(xml, x, y, w)
    local st = xml:InitStatic("line", self)
    st:SetWndPos(vector2():set(x, y))
    st:SetWndSize(vector2():set(w, ROW_H - 2))
    return st:TextControl()
end

local function _get_row_color(row)
    if row.is_overflow then return CLR_DIM end
    if row.driver == "AT" then return CLR_AT end
    if row.driver == "HOLD" then return CLR_HOLD end
    if row.driver == "PUSH" or row.driver == "PULL" then return CLR_PUSH end
    if row.driver == "CONDUCT" then return CLR_CONDUCT end
    return CLR_NORMAL
end

local function _render_entry(a, b, row)
    local color = _get_row_color(row)
    for c = 1, #ROW_A do
        a[c]:SetText(row[ROW_A[c]] or "")
        a[c]:SetTextColor(color)
    end
    for c = 1, #ROW_B do
        b[c]:SetText(row.is_overflow and "" or (row[ROW_B[c]] or ""))
        b[c]:SetTextColor(CLR_DIM)
    end
end

function UIDebugHUD:set_rows(rows)
    local count = #rows
    if count > MAX_ROWS + 1 then count = MAX_ROWS + 1 end
    for i = 1, count do
        _render_entry(self.a[i], self.b[i], rows[i])
    end
    for i = count + 1, self.used do
        local a, b = self.a[i], self.b[i]
        for c = 1, #ROW_A do a[c]:SetText("") end
        for c = 1, #ROW_B do b[c]:SetText("") end
    end
    self.used = count
end

function UIDebugHUD:__finalize() end

local function _is_hud_wanted()
    return cfg.hud_position ~= "off"
end

local function _hide()
    if _hud and _shown then
        get_hud():RemoveDialogToRender(_hud)
        _shown = false
    end
end

local function _destroy_hud()
    _hide()
    _hud = nil
end

local function _render_hud()
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    if _is_hud_wanted() then
        local rows = _build_rows()
        if not _hud then _hud = UIDebugHUD() end
        if not _shown then
            get_hud():AddDialogToRender(_hud)
            _shown = true
        end
        _hud:set_rows(rows)
    end
    timer:stop()
    if at_debug.is_on() then at_debug.debug("[HUD] refresh [%.2fms]", timer:get_ms()) end
end

local function _is_visible()
    if not main_hud_shown() then return false end
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:IsShown() then return false end
    return true
end

local function _update_hud()
    if not _tick_active then
        _hide()
        return true
    end
    ResetTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC)
    if _is_visible() then _render_hud() else _hide() end
end

local function _start()
    if _tick_active then return end
    _tick_active = true
    RemoveTimeEvent("at_hud", "tick")
    CreateTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC, _update_hud)
    at_debug.info("Debug HUD enabled (position=%s, radius=gate, show_idle=%s)",
        cfg.hud_position or "center_right", tostring(HUD_SHOW_IDLE))
end

local function _stop()
    _tick_active = false
    RemoveTimeEvent("at_hud", "tick")
    _destroy_hud()
    at_debug.info("Debug HUD disabled")
end

local function _on_option_change()
    at_debug.update_config()
    _destroy_hud()
    if _is_hud_wanted() then _start() else _stop() end
end

local function _on_first_update()
    at_debug.update_config()
    if _is_hud_wanted() then _start() end
end

local function _on_actor_net_destroy()
    _stop()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("actor_on_net_destroy",       _on_actor_net_destroy)
    RegisterScriptCallback("on_option_change",           _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

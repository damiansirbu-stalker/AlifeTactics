--- at_hud: live debug HUD listing nearby NPCs with their logic scheme, combat action, and target.
--- Per NPC: the active xr_logic section (scheme@subsection), the engine combat operator + physical state, the
--- selected enemy with distance and an aim flag (blind = cannot see it, OFF = body pointed away from it), and
--- the cover readout (planner flags / geometric ray, at_combat_trace.cover_string).

local pairs, table_sort, math_floor, math_max, tostring = pairs, table.sort, math.floor, math.max, tostring
local string_sub, string_format = string.sub, string.format
local IsStalker, RegisterScriptCallback = IsStalker, RegisterScriptCallback

local log = xlog.get_logger("AT.HUD", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

local REFRESH_INTERVAL_SEC = 3
-- Scan radius and idle-row visibility are code constants, not MCM options: every key in at_mcm defaults
-- must have a tree widget (ui_mcm.get validates the path against the option tree), and these never had one.
local HUD_RADIUS_M  = 100
local HUD_SHOW_IDLE = false

local ROW_H    = 13
local PAD      = 6
local COL_GAP  = 6
-- Fixed-char column widths (width = chars * CHAR_W + CELL_PAD). CHAR_W is the HUD font's approximate pixel
-- advance. Each NPC renders on TWO lines (see LINE_A / LINE_B): the essentials bright on top, the detail
-- dim and indented below, so the panel is ~half as wide as one row of nine columns and nothing clips.
local CHAR_W   = 6
local CELL_PAD = 2
local MARGIN   = 15
local MAX_ROWS = 16
local NAME_MAX = 16
local CELL_MAX = 10
local TARGET_NAME_MAX = 12
-- body-to-enemy angle above this many degrees reads as "pointed away" (the weird-aim flag)
local FACING_DEG = 60

-- Colors built lazily; GetARGB is not present at module-load under the static validator.
local CLR_TITLE, CLR_AT, CLR_NORMAL, CLR_DIM = nil, nil, nil, nil

local function _init_colors()
    if CLR_TITLE then return end
    CLR_TITLE  = GetARGB(220, 200, 180, 130)
    CLR_AT     = GetARGB(240, 170, 220, 170)
    CLR_NORMAL = GetARGB(220, 200, 200, 200)
    CLR_DIM    = GetARGB(160, 160, 160, 160)
end


-- =========================================================================
-- Position presets
-- =========================================================================

local function _calc_position(panel_h, total_w)
    local cy = math_floor((768 - panel_h) / 2)
    local rx = 1024 - total_w - MARGIN
    local by = 768 - panel_h - MARGIN
    local presets = {
        top_left     = { MARGIN, MARGIN },
        top_right    = { rx,     MARGIN },
        center_left  = { MARGIN, cy },
        center_right = { rx,     cy },
        bottom_left  = { MARGIN, by },
        bottom_right = { rx,     by },
    }
    return presets[cfg.hud_position] or presets.center_right
end


-- =========================================================================
-- Per-NPC derivation: logic scheme, combat operator + state, target + aim flag
-- =========================================================================

local function _truncate(s, limit)
    if not s or s == "" then return "?" end
    if #s > limit then return string_sub(s, 1, limit) end
    return s
end

-- Enemy name + distance (the sight cue is its own column via _sight_flag).
local function _target_desc(npc, enemy)
    local dist = math_floor(npc:position():distance_to(enemy:position()))
    return string_format("%s %dm", _truncate(xcreature.get_name(enemy:id()), TARGET_NAME_MAX), dist)
end

-- Sight to the enemy as its own short flag: "blind" (cannot see it), "off" (sees it but body pointed away from
-- it), "see" (looking at it). The "does he see me" cue from the old HUD, promoted to its own column.
local function _sight_flag(npc, enemy)
    if not xcombat.sees(npc, enemy) then return "blind" end
    if xcombat.get_facing_offset(npc, enemy:position()) >= FACING_DEG then return "off" end
    return "see"
end

-- Cover readout for a fighting row: the combat planner's stored flags against the geometric ray from the
-- enemy to the NPC, formatted by at_combat_trace.cover_string ("ynn/y"). The divergence between the flag half
-- (arrived-at-my-cover bookkeeping) and the ray half (is the line to him blocked) is what the column watches.
-- Runs only while the HUD is visible and the row has an enemy, so the raycast costs nothing when the HUD is off.
local function _cover_flag(npc, enemy)
    local in_cover, looked_out, held = xcombat.get_cover_state(npc)
    local blocked = xcombat.has_obstacle_to_target(enemy:position(), npc:position())
    return at_combat_trace.cover_string(in_cover, looked_out, held, blocked)
end

-- The three enemy-keyed cells (sight flag, cover readout, name+distance), "-" across when no selected enemy.
local function _enemy_cells(npc, enemy)
    if not enemy then return "-", "-", "-" end
    return _sight_flag(npc, enemy), _cover_flag(npc, enemy), _target_desc(npc, enemy)
end

-- Rank names abbreviated to 3 chars so the rank column never widens the panel.
local RANK_SHORT = {
    novice = "nov", trainee = "trn", experienced = "exp", professional = "pro",
    veteran = "vet", expert = "xpt", master = "mst", legend = "leg",
}

-- Reverse map anim enum -> label, built lazily (anim is a global enum, absent at file body).
local _MENTAL
local function _mental_name(npc)
    if not _MENTAL then _MENTAL = { [anim.free] = "free", [anim.danger] = "danger", [anim.panic] = "panic" } end
    local mental = npc:mental_state()
    return _MENTAL[mental] or tostring(mental)
end

-- Per-NPC readout across the AlifeTactics systems, one table. tag=AT drives the row COLOUR (green), so the
-- AT-vs-engine distinction lives in that colour and ACTION carries the bare maneuver name (flee / kite / retreat /
-- snipe) when the takeover holds the NPC, else the engine motivation operator (combat / danger / alife). The rank
-- (feeds Accuracy / NPC Ammo / Healing) renders as a name prefix, not its own column; hp feeds Healing and the
-- hurt situation; cover watches the planner-flag-vs-ray divergence; ENEMY keeps the sight cue. The old danger
-- column is gone (near-always "-"); grenade evidence lives on the decision trace.
local function _derive(npc, st)
    local maneuver = at_combat.get_maneuver(npc:id())
    local sm = st.state_mgr
    local enemy = npc:best_enemy()
    local sees, cover, enemy_desc = _enemy_cells(npc, enemy)
    local rank = ranks.get_obj_rank_name(npc)
    return {
        tag       = maneuver and "AT" or nil,
        rank      = rank and (RANK_SHORT[rank] or rank) or "-",
        hp        = math_floor((npc.health or 0) * 100) .. "%",
        scheme    = _truncate(st.active_scheme or st.active_section or "-", CELL_MAX),
        action    = maneuver or xcombat.get_operator(npc),
        state     = _truncate((sm and sm.target_state) or "-", CELL_MAX),
        mental    = _mental_name(npc),
        sees      = sees,
        cover     = cover,
        enemy     = enemy_desc,
        is_combat = enemy ~= nil,
    }
end


-- =========================================================================
-- Row builder: walk db.storage, derive per NPC, sort, cap
-- =========================================================================

-- Cheap candidate pass: no raycast, no name read, no operator read - just the row's identity and
-- sort keys. The expensive derivation (_derive: cover ray, operator, names) runs only for the
-- capped visible set, so a huge crowd costs MAX_ROWS derivations, not one per NPC in radius.
local function _candidate(id, st, ax, r2, actor_id, show_idle)
    if id == actor_id then return nil end
    local npc = st.object or level.object_by_id(id)
    if not npc then return nil end
    if not IsStalker(npc) then return nil end
    if not npc:alive() then return nil end
    local dist_sqr = ax:distance_to_sqr(npc:position())
    if dist_sqr >= r2 then return nil end
    local maneuver = at_combat.get_maneuver(id)
    local is_combat = maneuver ~= nil or npc:best_enemy() ~= nil
    if not (show_idle or is_combat) then return nil end
    return { npc = npc, st = st, dist_sqr = dist_sqr, at = maneuver ~= nil, is_combat = is_combat }
end

local function _build_rows()
    local actor = db.actor
    if not actor then return {} end
    local ax = actor:position()
    local r2 = HUD_RADIUS_M * HUD_RADIUS_M
    local actor_id = actor:id()

    local cands = {}
    for id, st in pairs(db.storage) do
        local cand = _candidate(id, st, ax, r2, actor_id, HUD_SHOW_IDLE)
        if cand then cands[#cands + 1] = cand end
    end

    -- AT-driven first, then anyone fighting, then nearest first.
    table_sort(cands, function(a, b)
        if a.at ~= b.at then return a.at end
        if a.is_combat ~= b.is_combat then return a.is_combat end
        return a.dist_sqr < b.dist_sqr
    end)

    local count = #cands
    local visible = count > MAX_ROWS and MAX_ROWS or count
    local rows = {}
    for i = 1, visible do
        local cand = cands[i]
        local row = _derive(cand.npc, cand.st)
        row.name = "(" .. row.rank .. ")" .. _truncate(cand.npc:character_name() or cand.npc:name(), NAME_MAX)
        rows[i] = row
    end
    if count > MAX_ROWS then
        rows[visible + 1] = { name = string_format("+%d more", count - MAX_ROWS), is_overflow = true }
    end

    return rows
end


-- =========================================================================
-- UIDebugHUD: CUIScriptWnd built ONCE, refresh only rewrites text + colors
-- (no per-tick widget construction). Each NPC is TWO lines: LINE_A carries the
-- essentials bright (AT-green when driven), LINE_B the detail dim and indented.
-- Two narrow lines beat one wide row - the panel is half as wide, nothing clips.
-- =========================================================================

local LINE_A = { { "name", NAME_MAX + 6 }, { "hp", 4 }, { "action", 12 }, { "enemy", TARGET_NAME_MAX + 6 } }
local LINE_B = { { "scheme", CELL_MAX }, { "state", CELL_MAX }, { "mental", 6 }, { "sees", 5 }, { "cover", 6 } }
local LINE_B_INDENT = CHAR_W * 2

local function _lay_widths(cols)
    local widths, total = {}, 0
    for i = 1, #cols do
        widths[i] = cols[i][2] * CHAR_W + CELL_PAD
        total = total + widths[i] + COL_GAP
    end
    return widths, total
end

class "UIDebugHUD" (CUIScriptWnd)

function UIDebugHUD:__init() super()
    _init_colors()
    self:SetAutoDelete(true)
    self:Enable(true)

    local wa, wa_total = _lay_widths(LINE_A)
    local wb, wb_total = _lay_widths(LINE_B)
    local total_w = math_max(wa_total, LINE_B_INDENT + wb_total) + PAD * 2
    -- 2 header lines + spacer + MAX_ROWS entries (2 lines each) + 1 overflow line
    local panel_h = (MAX_ROWS * 2 + 4) * ROW_H + PAD * 2
    local pos = _calc_position(panel_h, total_w)
    self:SetWndPos(vector2():set(pos[1], pos[2]))
    self:SetWndSize(vector2():set(total_w, panel_h))

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_at_stats.xml")

    -- Header: LINE_A labels on row 0, LINE_B labels on row 1 (dim). Entries start after a spacer row.
    self:_header(xml, self:_line(xml, PAD, wa, PAD), LINE_A, CLR_TITLE)
    self:_header(xml, self:_line(xml, PAD + ROW_H, wb, PAD + LINE_B_INDENT), LINE_B, CLR_DIM)

    -- Header rows 0-1, spacer row 2, entry i on rows (1+i*2) and (2+i*2). Entry MAX_ROWS+1 is the
    -- single-line "+N more" overflow: its A-row lands on the last panel row, its B-row stays blank.
    self.a, self.b = {}, {}
    for i = 1, MAX_ROWS + 1 do
        local y_a = PAD + (1 + i * 2) * ROW_H
        self.a[i] = self:_line(xml, y_a, wa, PAD)
        self.b[i] = self:_line(xml, y_a + ROW_H, wb, PAD + LINE_B_INDENT)
    end
    self.used = 0
end

-- Build one row of static-text cells at y from x0, one per width. Returns the TextControl array.
function UIDebugHUD:_line(xml, y, widths, x0)
    local cells, col_x = {}, x0
    for i = 1, #widths do
        cells[i] = self:_cell(xml, col_x, y, widths[i])
        col_x = col_x + widths[i] + COL_GAP
    end
    return cells
end

function UIDebugHUD:_header(_xml, cells, cols, color)
    for i = 1, #cols do
        cells[i]:SetText(cols[i][1])
        cells[i]:SetTextColor(color)
    end
end

function UIDebugHUD:_cell(xml, x, y, w)
    local st = xml:InitStatic("line", self)
    st:SetWndPos(vector2():set(x, y))
    st:SetWndSize(vector2():set(w, ROW_H - 2))
    return st:TextControl()
end

-- Rewrite both lines per row from freshly built rows; blank only what the previous refresh used.
-- No allocation, no widget construction.
function UIDebugHUD:set_rows(rows)
    local count = #rows
    if count > MAX_ROWS + 1 then count = MAX_ROWS + 1 end
    for i = 1, count do
        local row = rows[i]
        local color = (row.is_overflow and CLR_DIM) or (row.tag == "AT" and CLR_AT) or CLR_NORMAL
        local a, b = self.a[i], self.b[i]
        a[1]:SetText(row.name or ""); a[2]:SetText(row.hp or "")
        a[3]:SetText(row.action or ""); a[4]:SetText(row.enemy or "")
        for c = 1, #a do a[c]:SetTextColor(color) end
        if row.is_overflow then
            for c = 1, #b do b[c]:SetText("") end
        else
            b[1]:SetText(row.scheme or ""); b[2]:SetText(row.state or ""); b[3]:SetText(row.mental or "")
            b[4]:SetText(row.sees or ""); b[5]:SetText(row.cover or "")
            for c = 1, #b do b[c]:SetTextColor(CLR_DIM) end
        end
    end
    for i = count + 1, self.used do
        local a, b = self.a[i], self.b[i]
        for c = 1, #a do a[c]:SetText("") end
        for c = 1, #b do b[c]:SetText("") end
    end
    self.used = count
end

function UIDebugHUD:__finalize() end


-- =========================================================================
-- Lifecycle: visibility-gated 1s refresh via ResetTimeEvent
-- =========================================================================

local _hud = nil
local _shown = false
local _tick_active = false

local function _hide()
    if _hud and _shown then
        get_hud():RemoveDialogToRender(_hud)
        _shown = false
    end
end

-- Drop the window entirely (position change, actor teardown); the next
-- refresh rebuilds it at the current preset.
local function _drop_hud()
    _hide()
    _hud = nil
end

local function _refresh()
    local tmr = xprofiler.new_if(_dbg):start()
    local rows = _build_rows()
    if not _hud then _hud = UIDebugHUD() end
    if not _shown then
        get_hud():AddDialogToRender(_hud)
        _shown = true
    end
    _hud:set_rows(rows)
    tmr:stop()
    if _dbg then log.debug("[HUD] refresh rows=%d [%.2fms]", #rows, tmr:get_ms()) end
end

local function _is_visible()
    if not main_hud_shown() then return false end
    local pda_menu = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    if pda_menu and pda_menu:IsShown() then return false end
    return true
end

local function _tick()
    if not _tick_active then
        _hide()
        return true
    end
    if _is_visible() then _refresh() else _hide() end
    ResetTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC)
end

local function _start()
    if _tick_active then return end
    _tick_active = true
    RemoveTimeEvent("at_hud", "tick")
    CreateTimeEvent("at_hud", "tick", REFRESH_INTERVAL_SEC, _tick)
    log.info("Debug HUD enabled (position=%s, radius=%dm, show_idle=%s)",
        cfg.hud_position or "center_right", HUD_RADIUS_M, tostring(HUD_SHOW_IDLE))
end

local function _stop()
    _tick_active = false
    RemoveTimeEvent("at_hud", "tick")
    _drop_hud()
    log.info("Debug HUD disabled")
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_option_change()
    _refresh_log()
    _drop_hud()
    if cfg.hud_position ~= "off" then _start() else _stop() end
end

local function _on_first_update()
    _refresh_log()
    if cfg.hud_position ~= "off" then _start() end
end

local function _on_actor_net_destroy()
    _stop()
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("actor_on_net_destroy",       _on_actor_net_destroy)
    RegisterScriptCallback("on_option_change",           _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

-- Single squad, varied distance / direction / faction
--------------------------------------------------------------------------------

--- @export console
function at_spawn()
    _spawn(DEFAULT_SECTION, DEFAULT_DISTANCE, 0)
end

--- @export console
function at_spawn_near()
    _spawn(DEFAULT_SECTION, 20, 0)
end


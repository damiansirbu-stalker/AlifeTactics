-- Test helper for at_ammo: spawns a military squad, injects AP boxes covering
-- common military calibers into each member, then after 2s walks the squad and
-- calls at_ammo.pick(npc) on each so the handler runs against the AP-augmented
-- inventory. Watch alifetactics.log for [AMMO] lines; expect ammo_type ratchets
-- to the AP index for each weapon.
local AP_TEST_AMMO = {
    "ammo_5.45x39_ap",
    "ammo_5.56x45_ap",
    "ammo_7.62x39_ap",
    "ammo_9x39_ap",
}

-- Per-NPC proof flow: snapshot inventory count of the picked AP section at three
-- timestamps, then log so post-test grep can verify the load + fire cascade.
local function _ammo_proof_snap(phase, state)
    local go = level.object_by_id(state.npc_id)
    if not go or not go:alive() then return end
    local wpn = go:active_item()
    if not (wpn and IsWeapon(wpn)) then return end
    local inv_ap = wpn:get_ammo_count_for_type(state.ap_idx)
    local mag    = wpn:get_ammo_in_magazine()
    local type_now = wpn:get_ammo_type()
    log.info("[AMMO_PROOF] phase=%d npc=%d wpn=%s ap_sec=%s ap_idx=%d inv_ap=%d mag=%d type=%d",
        phase, state.npc_id, wpn:section(), state.ap_sec, state.ap_idx,
        inv_ap, mag, type_now)
end

-- After at_ammo.pick succeeded, force unload + schedule three snapshots so we can
-- verify (1) engine reloaded AP from inventory (2) NPC fired AP rounds in combat.
local function _ammo_proof_setup(go, wpn)
    local ap_idx = wpn:get_ammo_type()
    local ammo_class = parse_list(ini_sys, wpn:section(), "ammo_class")
    local ap_sec = (ammo_class and ammo_class[ap_idx + 1]) or "?"
    wpn:unload_magazine(true)
    local state = { npc_id = go:id(), ap_idx = ap_idx, ap_sec = ap_sec }
    _ammo_proof_snap(0, state)
    local stamp = tostring(time_global())
    CreateTimeEvent(0, "ammo_proof_1_" .. go:id() .. "_" .. stamp, 3, function()
        _ammo_proof_snap(1, state)
        return true
    end)
    CreateTimeEvent(0, "ammo_proof_2_" .. go:id() .. "_" .. stamp, 15, function()
        _ammo_proof_snap(2, state)
        return true
    end)
end

-- Phase 1: inject AP boxes into se inventory. Record the npc id so phase 2 can
-- find the same NPC after the engine syncs the new items into online inventory.
local function _ammo_inject_visit(se, actor_id, ax, ids, counters)
    if not se or se.id == actor_id then return end
    local go = level.object_by_id(se.id)
    if not go then return end
    if not (IsStalker(go) and go:alive()) then return end
    if ax:distance_to(go:position()) >= 100 then return end
    for k = 1, #AP_TEST_AMMO do
        alife_create_item(AP_TEST_AMMO[k], se)
        counters.ammo = counters.ammo + 1
    end
    ids[#ids + 1] = se.id
end

local function _ammo_pick_one(id, counters)
    local go = level.object_by_id(id)
    if not go then return end
    if not (IsStalker(go) and go:alive()) then return end
    local wpn = go:active_item()
    local before_type = (wpn and IsWeapon(wpn)) and wpn:get_ammo_type() or -1
    local changed = at_ammo.pick(go)
    counters.pick = counters.pick + 1
    if changed and wpn and IsWeapon(wpn) and wpn:get_ammo_type() ~= before_type then
        _ammo_proof_setup(go, wpn)
        counters.proof = counters.proof + 1
    end
end

-- Phase 2: for each recorded id, run at_ammo.pick against the now-synced inventory
-- and set up the proof flow if the pick changed ammo_type.
local function _ammo_pick_phase(ids, counters)
    if not (at_ammo and at_ammo.pick) then return end
    for i = 1, #ids do
        _ammo_pick_one(ids[i], counters)
    end
end

local function _ammo_test_tick()
    local actor = db.actor
    if not actor then return end
    local ax = actor:position()
    local actor_id = actor:id()
    local counters = { ammo = 0, pick = 0, proof = 0 }
    local ids = {}
    alife():iterate_objects(function(se) _ammo_inject_visit(se, actor_id, ax, ids, counters) end)
    log.info("[AMMO_TEST] phase=inject npcs=%d ammo=%d", #ids, counters.ammo)
    CreateTimeEvent(0, "at_ammo_test_pick_" .. tostring(time_global()), 2, function()
        _ammo_pick_phase(ids, counters)
        log.info("[AMMO_TEST] phase=pick picks=%d proofs=%d", counters.pick, counters.proof)
        _tip(string_format("AT.AMMO test: npcs=%d picks=%d proofs=%d",
            #ids, counters.pick, counters.proof))
        return true
    end)
end

--- @export console
function at_spawn_ammo_test()
    _spawn("army_sim_squad_novice", 60, 0)
    CreateTimeEvent(0, "at_ammo_test_" .. tostring(time_global()), 2, function()
        _ammo_test_tick()
        return true
    end)
end

--------------------------------------------------------------------------------
-- Multi-squad scenarios (combat planner stress tests)
--------------------------------------------------------------------------------

-- 3 bandit squads in a line ahead. Tests mode progression as NPCs close to floor.
--- @export console
function at_spawn_horde()
    _spawn_set("horde", {
        { "bandit_sim_squad_novice", 30,  0 },
        { "bandit_sim_squad_novice", 60,  0 },
        { "bandit_sim_squad_novice", 100, 0 },
    })
end

-- 2 squads on opposite flanks. Tests multi-direction reservation + mode-per-NPC.
--- @export console
function at_spawn_pincer()
    _spawn_set("pincer", {
        { "bandit_sim_squad_novice", 60, -90 },
        { "bandit_sim_squad_novice", 60,  90 },
    })
end

-- 4 squads in a circle around actor. Cover convergence stress (many NPCs picking
-- cover in same area). Validates db.used_level_vertex_ids reservation.
--- @export console
function at_spawn_swarm()
    _spawn_set("swarm", {
        { "bandit_sim_squad_novice", 50,    0 },
        { "bandit_sim_squad_novice", 50,   90 },
        { "bandit_sim_squad_novice", 50,  180 },
        { "bandit_sim_squad_novice", 50,  -90 },
    })
end

-- Mixed faction wave: bandits ahead, military flank, monolith behind. Tests
-- different communities (monolith excluded from at_combat via community gate),
-- different weapon loadouts, simultaneous mode tracking.
--- @export console
function at_spawn_mixed()
    _spawn_set("mixed", {
        { "bandit_sim_squad_novice",    60,    0 },
        { "army_sim_squad_novice",      70,   60 },
        { "monolith_sim_squad_novice",  80, -120 },
    })
end

--------------------------------------------------------------------------------
-- Dumps
--------------------------------------------------------------------------------

--- @export console
function at_dump()
    if not db.actor then return end
    local count = 0
    at_hitresponse.iterate_disclosed(function(squad_id, shooter_count)
        count = count + 1
        log.info("[DUMP] squad=%d shooters=%d", squad_id, shooter_count)
    end)
    _tip(string_format("AT.TEST: %d disclosed-squad records (see alifetactics.log)", count))
end

-- Posture (stand/crouch) is now rolled per maneuver in at_combat, not fixed by maneuver name, so the
-- crouch% line below is no longer derivable from the behavior counts. Left empty (reports 0%).
local CROUCH_BEHAVIORS = {}

local function _fmt_counts(tbl)
    local parts = {}
    for k, v in pairs(tbl) do parts[#parts + 1] = k .. "=" .. v end
    return table_concat(parts, " ")
end

local function _inc(tbl, key) tbl[key] = (tbl[key] or 0) + 1 end

--- @export console
function at_combat_stats()
    if not (at_combat and at_combat.get_stats) then return end
    local stats, last_eval, last_reason = at_combat.get_stats()
    local managed, rejects = 0, {}
    for npc_id, ok in pairs(last_eval) do
        if ok then managed = managed + 1 else _inc(rejects, last_reason[npc_id] or "?") end
    end
    local crouch, total = 0, 0
    for name, count in pairs(stats.behaviors) do
        total = total + count
        if CROUCH_BEHAVIORS[name] then crouch = crouch + count end
    end
    log.info("[STATS] managed=%d rejected: %s", managed, _fmt_counts(rejects))
    log.info("[STATS] decisions=%d crouch=%.0f%% behaviors: %s",
        total, total > 0 and crouch / total * 100 or 0, _fmt_counts(stats.behaviors))
    log.info("[STATS] resolve: %s backoffs=%d", _fmt_counts(stats.resolve), stats.backoffs)
    log.info("[STATS] perf tick avg=%.3fms max=%.3fms n=%d | read avg=%.3fms n=%d",
        stats.tick_n > 0 and stats.tick_sum / stats.tick_n or 0, stats.tick_max, stats.tick_n,
        stats.read_n > 0 and stats.read_sum / stats.read_n or 0, stats.read_n)
    _tip("AT.TEST: combat stats -> alifetactics.log")
end

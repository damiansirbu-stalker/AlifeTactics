-- Give the actor a Fort-17 + three boxes of 9x18, so you can engage a spawned squad and hurt them (the flee test).
--- @export console
function at_give_pistol()
    local id = db.actor and db.actor:id()
    if not id then return end
    xinventory.create_item("wpn_fort", id)
    for _ = 1, 3 do xinventory.create_item("ammo_9x18_fmj", id) end
    _tip("AT.TEST: Fort-17 + 3 boxes 9x18 given")
end

-- Spawn an armed military squad, then strip every weapon 3s later so each member reads as unarmed.
-- Tests that AT declines an unarmed NPC: get_weapon_kind returns nil so _can_seize is false, no takeover
-- fires, and vanilla drives the gunless NPC (its own rearm lives in the blocked combat planner).
--- @export console
function at_spawn_unarmed()
    local squad = _spawn("army_sim_squad_novice", 40, 0)
    if not squad then return end
    local squad_id = squad.id
    CreateTimeEvent(0, "at_unarmed_strip_" .. tostring(time_global()), 3, function()
        local sq = alife_object(squad_id)
        local removed = sq and _strip_weapons(sq) or 0
        log.info("[SPAWN] unarmed squad=%d weapons_removed=%d", squad_id, removed)
        _tip(string_format("AT.TEST: unarmed squad id=%d, %d weapons removed", squad_id, removed))
        return true
    end)
end

-- Test helper for at_ammo: arm every online stalker near the actor with AP boxes
-- matching its weapon plus a veteran rank, so it fires AP. Spawn hostile factions
-- (at_spawn_mixed / at_spawn_*), run at_arm_ap, let them fight, and watch
-- alifetactics.log for the [AP] engage / disengage lines (log level DEBUG).
-- The AP section set is at_ammo.AP_SECTIONS - one set, arming and firing agree.

-- Test arming: veteran rank so AP fires, 3 boxes of 15 rounds each, within 120m.
local AP_RANK    = 14000
local AP_BOXES   = 3
local AP_PER_BOX = 15
local AP_RADIUS  = 120

-- First AP section in the weapon's ammo_class, or nil if it fires no AP variant.
local function _ap_for_weapon(wpn_sec)
    local ammo_class = parse_list(ini_sys, wpn_sec, "ammo_class")
    if not ammo_class then return nil end
    for i = 1, #ammo_class do
        if at_ammo.AP_SECTIONS[ammo_class[i]] then return ammo_class[i] end
    end
    return nil
end

-- Give one online stalker AP boxes for its weapon plus a veteran rank. Returns true if armed.
-- Skips an NPC already carrying that AP section, so a periodic caller (at_lab_loop) does not stack boxes.
local function _arm_ap(npc)
    local wpn = npc:active_item()
    if not (wpn and IsWeapon(wpn)) then return false end
    local sec = _ap_for_weapon(wpn:section())
    if not sec then return false end
    if npc:object(sec) ~= nil then return false end
    npc:set_character_rank(AP_RANK)
    for _ = 1, AP_BOXES do xinventory.create_item(sec, npc:id(), { ammo = AP_PER_BOX }) end
    return true
end

-- Arm every online stalker within AP_RADIUS of the actor so they fire AP when they fight.
--- @export console
function at_arm_ap()
    if not db.actor then return end
    local apos = db.actor:position()
    local actor_id = db.actor:id()
    local r2 = AP_RADIUS * AP_RADIUS
    local seen, armed = 0, 0
    for id in pairs(db.storage) do
        local npc = level.object_by_id(id)
        if npc and id ~= actor_id and IsStalker(npc) and npc:alive()
            and npc:position():distance_to_sqr(apos) <= r2
        then
            seen = seen + 1
            armed = armed + (_arm_ap(npc) and 1 or 0)
        end
    end
    log.info("[AMMO] arm_ap armed=%d seen=%d boxes=%d rank=%d", armed, seen, AP_BOXES, AP_RANK)
    _tip(string_format("AT.AMMO: armed %d/%d stalkers with AP (rank %d). Fight them, watch [AP] log.",
        armed, seen, AP_RANK))
end

--------------------------------------------------------------------------------
-- The lab harness: stock every nearby stalker so all AlifeTactics systems have fuel.
-- Per pass: a medkit + bandage to anyone missing them (Healing spends them when hurt), AP boxes +
-- veteran rank for the active weapon (Ammo fires them; the rank also moves the Accuracy tier and the
-- healing-charge tier), and one palette weapon per squad (kind variety - a sniper feeds snipe, a
-- shotgun/pistol feeds the kite range bands). Fights, hits, and heals then show in alifetactics.log
-- under [AP] / [HEAL] / [LIMP] / [ACC] / [DISCLOSURE] / [CROSSFIRE] / [JAM] / monitor with log
-- level DEBUG.
--------------------------------------------------------------------------------

local LAB_RADIUS_SQR  = 100 * 100
local LAB_PERIOD_SEC  = 30
local LAB_WEAPONS = { "wpn_svd", "wpn_spas12", "wpn_mp5", "wpn_pm" }
local _lab_wpn_i = 0

-- Give one item unless already carried (loop-safe).
local function _lab_ensure(npc, section)
    if npc:object(section) ~= nil then return 0 end
    xinventory.create_item(section, npc:id())
    return 1
end

-- Give the next palette weapon + 2 ammo boxes (the engine equips it when it scores higher).
local function _lab_give_weapon(npc)
    _lab_wpn_i = _lab_wpn_i + 1
    local sec = LAB_WEAPONS[((_lab_wpn_i - 1) % #LAB_WEAPONS) + 1]
    if not ini_sys:section_exist(sec) then return "none" end
    xinventory.create_item(sec, npc:id())
    local ammo_class = parse_list(ini_sys, sec, "ammo_class")
    local ammo = ammo_class and ammo_class[1]
    if ammo then
        xinventory.create_item(ammo, npc:id())
        xinventory.create_item(ammo, npc:id())
    end
    return sec
end

-- Stock one NPC: meds, AP + rank, and the squad's palette weapon (once per squad per pass).
-- Returns (items_given, ap_armed 0|1, weapon_given 0|1).
local function _lab_stock_npc(npc, squads)
    local items = _lab_ensure(npc, "medkit") + _lab_ensure(npc, "bandage")
    local ap = _arm_ap(npc) and 1 or 0
    local squad = get_object_squad(npc)
    if not squad or squads[squad.id] then return items, ap, 0 end
    squads[squad.id] = _lab_give_weapon(npc)
    return items, ap, 1
end

-- One pass over online stalkers near the actor. Squads get their weapon once per pass (first member).
local function _lab_pass()
    if not db.actor then return end
    local apos = db.actor:position()
    local actor_id = db.actor:id()
    local seen, items, aps, weapons = 0, 0, 0, 0
    local squads = {}
    for id in pairs(db.storage) do
        local npc = level.object_by_id(id)
        if npc and id ~= actor_id and IsStalker(npc) and npc:alive()
            and npc:position():distance_to_sqr(apos) <= LAB_RADIUS_SQR
        then
            seen = seen + 1
            local items_n, ap_n, wpn_n = _lab_stock_npc(npc, squads)
            items   = items + items_n
            aps     = aps + ap_n
            weapons = weapons + wpn_n
        end
    end
    log.info("[LAB] pass npcs=%d items_given=%d ap_armed=%d squad_weapons=%d", seen, items, aps, weapons)
    _tip(string_format("AT.LAB: %d NPCs stocked, %d items, %d AP-armed, %d squad weapons", seen, items, aps, weapons))
end

--- One harness pass: stock every nearby stalker (meds, AP + rank, squad weapons).
--- @export console
function at_lab()
    _lab_pass()
end

local _lab_loop_on = false

local function _lab_tick()
    if not _lab_loop_on then return true end
    _lab_pass()
    ResetTimeEvent("at_lab", "loop", LAB_PERIOD_SEC)
end

--- Toggle the periodic harness: a stocking pass every 30s until toggled off.
--- @export console
function at_lab_loop()
    if _lab_loop_on then
        _lab_loop_on = false
        RemoveTimeEvent("at_lab", "loop")
        log.info("[LAB] loop stopped")
        _tip("AT.LAB: loop stopped")
        return
    end
    _lab_loop_on = true
    _lab_pass()
    RemoveTimeEvent("at_lab", "loop")
    CreateTimeEvent("at_lab", "loop", LAB_PERIOD_SEC, _lab_tick)
    log.info("[LAB] loop started period=%ds", LAB_PERIOD_SEC)
    _tip("AT.LAB: loop started (a pass every " .. LAB_PERIOD_SEC .. "s)")
end

--------------------------------------------------------------------------------
-- Multi-squad scenarios (combat planner stress tests)
--------------------------------------------------------------------------------

-- 3 bandit squads in a line ahead. Tests mode progression as NPCs close to floor.
--- @export console
function at_spawn_horde()
    _spawn_set("horde", {
        { "bandit_sim_squad_novice", 30,  0 },
        { "bandit_sim_squad_novice", 60,  0 },
        { "bandit_sim_squad_novice", 100, 0 },
    })
end

-- 2 squads on opposite flanks. Tests multi-direction reservation + mode-per-NPC.
--- @export console
function at_spawn_pincer()
    _spawn_set("pincer", {
        { "bandit_sim_squad_novice", 60, -90 },
        { "bandit_sim_squad_novice", 60,  90 },
    })
end

-- 4 squads in a circle around actor. Cover convergence stress (many NPCs picking
-- cover in same area). Validates db.used_level_vertex_ids reservation.
--- @export console
function at_spawn_swarm()
    _spawn_set("swarm", {
        { "bandit_sim_squad_novice", 50,    0 },
        { "bandit_sim_squad_novice", 50,   90 },
        { "bandit_sim_squad_novice", 50,  180 },
        { "bandit_sim_squad_novice", 50,  -90 },
    })
end

-- Mixed faction wave: bandits ahead, military flank, monolith behind. Tests
-- different communities (monolith and zombied are excluded from flee/retreat only;
-- the universal rows - counterflank, kite, snipe - still fire for them), different
-- weapon loadouts, simultaneous tracking.
--- @export console
function at_spawn_mixed()
    _spawn_set("mixed", {
        { "bandit_sim_squad_novice",    60,    0 },
        { "army_sim_squad_novice",      70,   60 },
        { "monolith_sim_squad_novice",  80, -120 },
    })
end

--------------------------------------------------------------------------------
-- Dumps
--------------------------------------------------------------------------------

--- @export console
function at_dump()
    if not db.actor then return end
    local count = 0
    at_disclosure.iterate_disclosed(function(squad_id, shooter_count)
        count = count + 1
        log.info("[DUMP] squad=%d shooters=%d", squad_id, shooter_count)
    end)
    _tip(string_format("AT.TEST: %d disclosed-squad records (see alifetactics.log)", count))
end

-- Combat telemetry dump removed: the DEBUG alifetactics.log already carries the per-decision
-- scan / decide / eval lines, so no separate console aggregate is needed.

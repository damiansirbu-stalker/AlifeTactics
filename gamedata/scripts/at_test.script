--- at_test: AlifeTactics tests - unarmed-seize spawn, AP arming, lab stocking, the mutant efficiency harness
--- @novalidate(conventions.unused_export, reason:"console commands, invoked by name via run_string")
--- @novalidate(xray.stale_entity_table, reason:"_eff.seen is reset each phase and dropped at harness stop, never leaks")

local tostring, string_format, math_rad, math_cos, math_sin = tostring, string.format, math.rad, math.cos, math.sin
local pairs, IsStalker, IsWeapon, get_object_squad = pairs, IsStalker, IsWeapon, get_object_squad
local time_global, alife_object, level = time_global, alife_object, level
local alife = alife
local type, ipairs, rawget, table_concat = type, ipairs, rawget, table.concat
local math_floor, math_max, math_random = math.floor, math.max, math.random

local DEFAULT_SECTION  = "bandit_sim_squad_novice"
local DEFAULT_DISTANCE = 50
local INVALID_VERTEX   = 4294967295

local EFFECT_GEAR = { "af_gravi", "af_soul", "af_fireball", "af_electra_sparkler", "af_compass", "af_kevlar", "wpn_binoc", "device_torch_nv_1" }

local AP_RANK    = 14000
local AP_BOXES   = 3
local AP_PER_BOX = 15
local AP_RADIUS  = 120

local LAB_RADIUS_SQR  = 100 * 100
local LAB_PERIOD_SEC  = 30
local LAB_WEAPONS = { "wpn_svd", "wpn_spas12", "wpn_mp5", "wpn_pm" }

local _strip_buf = {}
local _lab_wpn_i = 0
local _lab_loop_on = false

local EFF_COUNT, EFF_DIST, EFF_PHASE_SEC, EFF_ANNOUNCE_SEC = 2, 12, 60, 5
local EFF_INT_JIT, EFF_INT_REVERT, EFF_INT_LO, EFF_INT_HI = 20, 0.3, 10, 100
local EFF_PHASES = {
    { at = false, move = "stand"  },
    { at = true,  move = "stand"  },
    { at = false, move = "strafe" },
    { at = true,  move = "strafe" },
}
local _eff = nil
local _eff_log = nil

local function _show_tip(msg)
    if db.actor then news_manager.send_tip(db.actor, msg, nil, nil, 5000) end
end

local function _compute_rotated_dir(dir, angle_deg)
    local rad = math_rad(angle_deg)
    local cos_a = math_cos(rad)
    local sin_a = math_sin(rad)
    return vector():set(dir.x * cos_a + dir.z * sin_a, dir.y, -dir.x * sin_a + dir.z * cos_a)
end

local function _add_grenades(squad, pos, lvid, gvid, grenades)
    local count = grenades or 0
    if count == 0 or squad:npc_count() == 0 then return end
    local sim = alife()
    for member in squad:squad_members() do
        for _ = 1, count do sim:create("grenade_f1", pos, lvid, gvid, member.id) end
    end
end

local function _add_member_gear(sim, member_id, pos, lvid, gvid)
    for i = 1, #EFFECT_GEAR do
        if ini_sys:section_exist(EFFECT_GEAR[i]) then sim:create(EFFECT_GEAR[i], pos, lvid, gvid, member_id) end
    end
end

local function _add_squad_gear(squad, pos, lvid, gvid)
    if squad:npc_count() == 0 then return end
    local sim = alife()
    for member in squad:squad_members() do
        _add_member_gear(sim, member.id, pos, lvid, gvid)
    end
end

local function _add_weapon_id(_owner, item)
    if IsWeapon(item) then _strip_buf[#_strip_buf + 1] = item:id() end
end

local function _remove_weapons(sim, npc)
    for i = #_strip_buf, 1, -1 do _strip_buf[i] = nil end
    npc:iterate_inventory(_add_weapon_id, npc)
    local removed = 0
    for i = 1, #_strip_buf do
        local se = alife_object(_strip_buf[i])
        if se then sim:release(se, true); removed = removed + 1 end
    end
    return removed
end

local function _remove_squad_weapons(squad)
    if squad:npc_count() == 0 then return 0 end
    local sim = alife()
    local removed = 0
    for member in squad:squad_members() do
        local npc = level.object_by_id(member.id)
        if npc then removed = removed + _remove_weapons(sim, npc) end
    end
    return removed
end

local function _spawn_squad(section, distance, angle_deg, grenades)
    section   = section   or DEFAULT_SECTION
    distance  = distance  or DEFAULT_DISTANCE
    angle_deg = angle_deg or 0
    if not db.actor then
        _show_tip("AT.TEST: not in game")
        return
    end
    if not ini_sys:section_exist(section) then
        local msg = string_format("AT.TEST: squad section '%s' not in squad_descr", section)
        at_debug.warn(msg)
        _show_tip(msg)
        return
    end

    local actor      = db.actor
    local actor_pos  = actor:position()
    local actor_lvid = actor:level_vertex_id()
    local actor_gvid = actor:game_vertex_id()

    local squad = alife():create(section, actor_pos, actor_lvid, actor_gvid)
    if not squad then
        _show_tip("AT.TEST: alife:create failed for " .. section)
        return
    end
    squad:create_npc(nil, actor_pos, actor_lvid, actor_gvid)
    if squad:npc_count() > 0 then
        for member in squad:squad_members() do
            local se = member.object or alife_object(member.id)
            if se then SIMBOARD:setup_squad_and_group(se) end
        end
    end
    _add_grenades(squad, actor_pos, actor_lvid, actor_gvid, grenades)
    _add_squad_gear(squad, actor_pos, actor_lvid, actor_gvid)

    local dir         = _compute_rotated_dir(actor:direction(), angle_deg)
    local target_pos  = vector():set(
        actor_pos.x + dir.x * distance,
        actor_pos.y,
        actor_pos.z + dir.z * distance
    )
    local target_lvid = level.vertex_id(target_pos)
    local on_map      = target_lvid ~= INVALID_VERTEX
    if on_map then
        TeleportSquad(squad, target_pos, target_lvid, actor_gvid)
    end

    at_debug.info("[SPAWN] section=%s squad_id=%d distance=%dm angle=%ddeg on_map=%s",
        section, squad.id, distance, angle_deg, tostring(on_map))
    _show_tip(string_format("AT.TEST: %s id=%d %s",
        section, squad.id,
        on_map and (distance .. "m @" .. angle_deg .. "deg") or "at actor (off-map)"))
    return squad
end

local function _find_ap_section(wpn_sec)
    local ammo_class = parse_list(ini_sys, wpn_sec, "ammo_class")
    if not ammo_class then return nil end
    for i = 1, #ammo_class do
        if at_ammo.AP_SECTIONS[ammo_class[i]] then return ammo_class[i] end
    end
    return nil
end

local function _add_ap(npc)
    local wpn = npc:active_item()
    if not (wpn and IsWeapon(wpn)) then return false end
    local sec = _find_ap_section(wpn:section())
    if not sec then return false end
    if npc:object(sec) ~= nil then return false end
    npc:set_character_rank(AP_RANK)
    for _ = 1, AP_BOXES do xinventory.create_item(sec, npc:id(), { ammo = AP_PER_BOX }) end
    return true
end

local function _add_item(npc, section)
    if npc:object(section) ~= nil then return 0 end
    xinventory.create_item(section, npc:id())
    return 1
end

local function _add_weapon(npc)
    _lab_wpn_i = _lab_wpn_i + 1
    local sec = LAB_WEAPONS[((_lab_wpn_i - 1) % #LAB_WEAPONS) + 1]
    if not ini_sys:section_exist(sec) then return "none" end
    xinventory.create_item(sec, npc:id())
    local ammo_class = parse_list(ini_sys, sec, "ammo_class")
    local ammo = ammo_class and ammo_class[1]
    if ammo then
        xinventory.create_item(ammo, npc:id())
        xinventory.create_item(ammo, npc:id())
    end
    return sec
end

local function _add_npc_stock(npc, squads)
    local items = _add_item(npc, "medkit") + _add_item(npc, "bandage")
    local ap = _add_ap(npc) and 1 or 0
    local squad = get_object_squad(npc)
    if not squad or squads[squad.id] then return items, ap, 0 end
    squads[squad.id] = _add_weapon(npc)
    return items, ap, 1
end

local function _run_lab_pass()
    if not db.actor then return end
    local apos = db.actor:position()
    local actor_id = db.actor:id()
    local seen, items, aps, weapons = 0, 0, 0, 0
    local squads = {}
    for id in pairs(db.storage) do
        local npc = level.object_by_id(id)
        if npc and id ~= actor_id and IsStalker(npc) and npc:alive()
            and npc:position():distance_to_sqr(apos) <= LAB_RADIUS_SQR
        then
            seen = seen + 1
            local items_n, ap_n, wpn_n = _add_npc_stock(npc, squads)
            items   = items + items_n
            aps     = aps + ap_n
            weapons = weapons + wpn_n
        end
    end
    at_debug.info("[LAB] pass npcs=%d items_given=%d ap_armed=%d squad_weapons=%d", seen, items, aps, weapons)
    _show_tip(string_format("AT.LAB: %d NPCs stocked, %d items, %d AP-armed, %d squad weapons", seen, items, aps, weapons))
end

local function _update_lab()
    if not _lab_loop_on then return true end
    _run_lab_pass()
    ResetTimeEvent("at_lab", "loop", LAB_PERIOD_SEC)
end

-- Efficiency harness: AT off/on x stand/strafe A/B per species, counting hits and driven moves; TestZone owns the bench primitives.
local function _get_eff_cfg()
    local flags = {}
    for k, v in pairs(at_mcm.cfg) do
        if tostring(k):sub(1, 4) == "mut_" and (type(v) == "boolean" or type(v) == "number") then flags[k] = v end
    end
    return flags
end

local function _set_eff_at(on)
    local cfg = at_mcm.cfg
    if on then
        for k, v in pairs(_eff.snap) do cfg[k] = v end
        if _eff.int_base then cfg.mut_int_base = _eff.int_cur or _eff.int_base end
    else
        for k in pairs(_eff.snap) do cfg[k] = (type(cfg[k]) == "boolean") and false or 0 end
    end
end

local function _format_eff_moves(moves)
    local parts = {}
    for move, count in pairs(moves) do parts[#parts + 1] = move .. ":" .. count end
    return #parts > 0 and table_concat(parts, " ") or "-"
end

local function _on_eff_before_hit(s_hit)
    if not (_eff and s_hit) then return end
    local attacker = s_hit.draftsman
    if attacker and attacker:id() ~= AC_ID and xcreature.get_mutant_species(attacker:id()) then
        _eff.phase.hits = _eff.phase.hits + 1
    end
end

local function _on_eff_mob_update(mob)
    if not (_eff and mob and mob:alive()) then return end
    local rec = at_mutants.get_mutant_record(mob:id())
    if not (rec and rec.fired_at) then return end
    if _eff.seen[mob:id()] ~= rec.fired_at then
        _eff.seen[mob:id()] = rec.fired_at
        local move = rec.fired_move or "?"
        _eff.phase.moves[move] = (_eff.phase.moves[move] or 0) + 1
        _eff_log.info("[fire] p%d id=%d move=%s", _eff.i, mob:id(), move)
    end
end

local function _start_eff_phase(i)
    _eff.i = i
    local phase_def = EFF_PHASES[i]
    _eff.phase = { hits = 0, moves = {}, move = phase_def.move, at = phase_def.at }
    _eff.phase_at = time_global()
    _eff.next_announce = 0
    _eff.seen = {}
    _set_eff_at(phase_def.at)
    _eff.tz.clear_mutants()
    _eff.tz.start_actor_drive(phase_def.move)
    _eff.tz.spawn_mutant(_eff.species, EFF_COUNT, EFF_DIST)
    _eff_log.info("[phase %d/4] %s AT=%s %s spawn=%d", i, _eff.species, phase_def.at and "on" or "off", phase_def.move, EFF_COUNT)
end

local function _log_eff_summary()
    _eff_log.info("=== %s SUMMARY (count=%d dist=%dm phase=%ds) ===", _eff.species, EFF_COUNT, EFF_DIST, EFF_PHASE_SEC)
    for _, phase_rec in ipairs(_eff.results) do
        _eff_log.info("%-6s AT %-3s : hits=%d moves=%s", phase_rec.move, phase_rec.at and "on" or "off", phase_rec.hits, _format_eff_moves(phase_rec.moves))
    end
    _eff_log.flush()
end

local function _stop_eff()
    if not _eff then return end
    _set_eff_at(true)
    _eff.tz.stop_actor_drive()
    _eff.tz.clear_mutants()
    _eff.tz.stop_lifepump()
    UnregisterScriptCallback("actor_on_before_hit", _on_eff_before_hit)
    UnregisterScriptCallback("monster_on_update", _on_eff_mob_update)
    RemoveTimeEvent("at_efficiency", "tick")
    if _eff_log then _eff_log.flush() end
    _eff = nil
end

local function _update_eff()
    if not _eff then return true end
    ResetTimeEvent("at_efficiency", "tick", 1)
    local now = time_global()
    local into = (now - _eff.phase_at) / 1000
    local left = EFF_PHASE_SEC - into
    local phase_def = EFF_PHASES[_eff.i]
    if phase_def.at and _eff.int_base then
        _eff.int_cur = _eff.int_cur + (_eff.int_base - _eff.int_cur) * EFF_INT_REVERT + (math_random() * 2 - 1) * EFF_INT_JIT
        if _eff.int_cur < EFF_INT_LO then _eff.int_cur = EFF_INT_LO elseif _eff.int_cur > EFF_INT_HI then _eff.int_cur = EFF_INT_HI end
        at_mcm.cfg.mut_int_base = _eff.int_cur
    end
    if now >= _eff.next_announce then
        _eff.next_announce = now + EFF_ANNOUNCE_SEC * 1000
        _show_tip(string_format("%s | AT %s | %s | %ds", _eff.species, phase_def.at and "ON" or "OFF", phase_def.move, math_max(0, math_floor(left))))
        _eff_log.info("[run] p%d %s AT=%s %s t=%ds hits=%d moves=%s", _eff.i, _eff.species, phase_def.at and "on" or "off", phase_def.move,
            math_floor(into), _eff.phase.hits, _format_eff_moves(_eff.phase.moves))
    end
    if left <= 0 then
        _eff.results[#_eff.results + 1] = _eff.phase
        _eff_log.info("[phase %d/4 END] %s AT=%s %s hits=%d moves=%s", _eff.i, _eff.species, phase_def.at and "on" or "off", phase_def.move,
            _eff.phase.hits, _format_eff_moves(_eff.phase.moves))
        if _eff.i >= #EFF_PHASES then
            _log_eff_summary()
            _show_tip(_eff.species .. " done - see harness_at.log")
            _stop_eff()
        else
            _start_eff_phase(_eff.i + 1)
        end
    end
    return false
end

--- Spawn an armed military squad, strip every weapon 3s later - proves the unarmed seize decline.
function create_squad_unarmed()
    local squad = _spawn_squad("army_sim_squad_novice", 40, 0)
    if not squad then return end
    local squad_id = squad.id
    CreateTimeEvent(0, "at_unarmed_strip_" .. tostring(time_global()), 3, function()
        local sq = alife_object(squad_id)
        local removed = sq and _remove_squad_weapons(sq) or 0
        at_debug.info("[SPAWN] unarmed squad=%d weapons_removed=%d", squad_id, removed)
        _show_tip(string_format("AT.TEST: unarmed squad id=%d, %d weapons removed", squad_id, removed))
        return true
    end)
end

--- Arm every online stalker within 120m with AP for its weapon plus a veteran rank.
function add_ap_ammo()
    if not db.actor then return end
    local apos = db.actor:position()
    local actor_id = db.actor:id()
    local r2 = AP_RADIUS * AP_RADIUS
    local seen, armed = 0, 0
    for id in pairs(db.storage) do
        local npc = level.object_by_id(id)
        if npc and id ~= actor_id and IsStalker(npc) and npc:alive()
            and npc:position():distance_to_sqr(apos) <= r2
        then
            seen = seen + 1
            armed = armed + (_add_ap(npc) and 1 or 0)
        end
    end
    at_debug.info("[AMMO] arm_ap armed=%d seen=%d boxes=%d rank=%d", armed, seen, AP_BOXES, AP_RANK)
    _show_tip(string_format("AT.AMMO: armed %d/%d stalkers with AP (rank %d). Fight them, watch [AP] log.",
        armed, seen, AP_RANK))
end

--- One harness pass: stock every nearby stalker (meds, AP + rank, squad weapons).
function run_lab()
    _run_lab_pass()
end

--- Toggle the periodic harness: a stocking pass every 30s until toggled off.
function run_lab_loop()
    if _lab_loop_on then
        _lab_loop_on = false
        RemoveTimeEvent("at_lab", "loop")
        at_debug.info("[LAB] loop stopped")
        _show_tip("AT.LAB: loop stopped")
        return
    end
    _lab_loop_on = true
    _run_lab_pass()
    RemoveTimeEvent("at_lab", "loop")
    CreateTimeEvent("at_lab", "loop", LAB_PERIOD_SEC, _update_lab)
    at_debug.info("[LAB] loop started period=%ds", LAB_PERIOD_SEC)
    _show_tip("AT.LAB: loop started (a pass every " .. LAB_PERIOD_SEC .. "s)")
end

--- Run the 4-phase AT off/on x stand/strafe efficiency A/B on a mutant species; logs to harness_at.log. Needs TestZone.
function run_efficiency(species, int_base)
    if _eff then return _show_tip("AT.EFF: running - stop_efficiency() first") end
    if not (db.actor and species) then return _show_tip("AT.EFF: need in-game and a species") end
    local tz = rawget(_G, "tz_commands")
    if not (type(tz) == "table" and type(tz.spawn_mutant) == "function" and type(tz.start_actor_drive) == "function") then
        return _show_tip("AT.EFF: TestZone not loaded (needs tz_commands)")
    end
    _eff_log = xlog.get_logger("harness_at", { outfile = "harness_at.log", buffer_size = 1, level = "INFO" })
    _eff = { species = species, results = {}, snap = _get_eff_cfg(), seen = {},
             int_base = int_base, int_cur = int_base, tz = tz }
    _eff_log.info("========== RUN %s%s ==========", species, int_base and (" int_base=" .. int_base) or "")
    tz.start_lifepump(1.0, 0.02)
    RegisterScriptCallback("actor_on_before_hit", _on_eff_before_hit)
    RegisterScriptCallback("monster_on_update", _on_eff_mob_update)
    _start_eff_phase(1)
    RemoveTimeEvent("at_efficiency", "tick")
    CreateTimeEvent("at_efficiency", "tick", 1, _update_eff)
    _show_tip("AT.EFF: " .. species .. " - follow the tip (stand / strafe)")
end

--- Stop the efficiency harness, release its mutants, and restore the AT config and actor control.
function stop_efficiency()
    _stop_eff()
    _show_tip("AT.EFF: stopped")
end


--- at_test: Console commands for AlifeTactics (squad spawn, dumps)

local tostring, string_format, math_rad, math_cos, math_sin = tostring, string.format, math.rad, math.cos, math.sin
local time_global, IsStalker, alife_create_item, alife_object, level =
    time_global, IsStalker, alife_create_item, alife_object, level
local alife = alife
local pairs, table_concat = pairs, table.concat
-- CreateTimeEvent NOT cached: demonized_time_events replaces it at runtime.

local log = xlog.get_logger("AT.TEST", { outfile = "alifetactics.log" })

local DEFAULT_SECTION  = "bandit_sim_squad_novice"
local DEFAULT_DISTANCE = 50
local INVALID_VERTEX   = 4294967295

local function _tip(msg)
    if db.actor then news_manager.send_tip(db.actor, msg, nil, nil, 5000) end
end

-- Rotate a forward vector by angle_deg around Y (right-handed, Y up).
-- 0 = forward, 90 = right, -90 = left, 180 = behind.
local function _rotate_y(dir, angle_deg)
    local rad = math_rad(angle_deg)
    local cos_a = math_cos(rad)
    local sin_a = math_sin(rad)
    return vector():set(dir.x * cos_a + dir.z * sin_a, dir.y, -dir.x * sin_a + dir.z * cos_a)
end

-- Spawn at actor vertex then teleport to `distance` meters along (actor facing rotated by angle).
-- Off-map target vertex -> stay at actor.
local function _spawn(section, distance, angle_deg)
    section   = section   or DEFAULT_SECTION
    distance  = distance  or DEFAULT_DISTANCE
    angle_deg = angle_deg or 0
    if not db.actor then
        _tip("AT.TEST: not in game")
        return
    end
    if not ini_sys:section_exist(section) then
        local msg = string_format("AT.TEST: squad section '%s' not in squad_descr", section)
        log.warn(msg)
        _tip(msg)
        return
    end

    local actor      = db.actor
    local actor_pos  = actor:position()
    local actor_lvid = actor:level_vertex_id()
    local actor_gvid = actor:game_vertex_id()

    local squad = alife():create(section, actor_pos, actor_lvid, actor_gvid)
    if not squad then
        _tip("AT.TEST: alife:create failed for " .. section)
        return
    end
    squad:create_npc(nil, actor_pos, actor_lvid, actor_gvid)
    if squad:npc_count() > 0 then
        for member in squad:squad_members() do
            local se = member.object or alife_object(member.id)
            if se then SIMBOARD:setup_squad_and_group(se) end
        end
    end

    local dir         = _rotate_y(actor:direction(), angle_deg)
    local target_pos  = vector():set(
        actor_pos.x + dir.x * distance,
        actor_pos.y,
        actor_pos.z + dir.z * distance
    )
    local target_lvid = level.vertex_id(target_pos)
    local on_map      = target_lvid ~= INVALID_VERTEX
    if on_map then
        TeleportSquad(squad, target_pos, target_lvid, actor_gvid)
    end

    log.info("[SPAWN] section=%s squad_id=%d distance=%dm angle=%ddeg on_map=%s",
        section, squad.id, distance, angle_deg, tostring(on_map))
    _tip(string_format("AT.TEST: %s id=%d %s",
        section, squad.id,
        on_map and (distance .. "m @" .. angle_deg .. "deg") or "at actor (off-map)"))
end

-- Spawn N squads in one call. Each entry: { section, distance, angle_deg }.
local function _spawn_set(label, entries)
    for i = 1, #entries do
        local entry = entries[i]
        _spawn(entry[1], entry[2], entry[3])
    end
    log.info("[SPAWN] set=%s count=%d", label, #entries)
end


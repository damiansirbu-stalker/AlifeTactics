--- at_mcm: MCM configuration for AlifeTactics combat AI

local log = xlog.get_logger("AT.MCM", { outfile = "alifetactics.log" })

-- ==================== DEFAULTS ====================

local defaults = {
    -- Hit Sharing
    hit_share_enabled         = true,
    hit_share_retention_min   = 2,
    -- Healing
    healing_enabled           = true,
    heal_rate_multiplier      = 1.0,
    charge_chance_novice      = 50,
    charge_chance_experienced = 50,
    charge_chance_veteran     = 50,
    charge_chance_master      = 50,
    limping_anim_enabled      = true,
    limping_health_threshold  = 0.65,
    healing_anim_enabled      = true,
    -- Accuracy
    accuracy_enabled       = true,
    acc_disp_novice        = 1.00,
    acc_disp_trainee       = 0.90,
    acc_disp_experienced   = 0.80,
    acc_disp_professional  = 0.70,
    acc_disp_veteran       = 0.60,
    acc_disp_expert        = 0.52,
    acc_disp_master        = 0.45,
    acc_disp_legend        = 0.38,
    -- Stance Switch
    stance_enabled = true,
    -- Development
    log_level = "WARN",
}

-- ==================== CONFIG ====================

local RegisterScriptCallback = RegisterScriptCallback

local _key_to_tab = {
    -- Hit Sharing
    hit_share_enabled         = "hit_share",
    hit_share_retention_min   = "hit_share",
    -- Healing
    healing_enabled           = "health",
    heal_rate_multiplier      = "health",
    charge_chance_novice      = "health",
    charge_chance_experienced = "health",
    charge_chance_veteran     = "health",
    charge_chance_master      = "health",
    limping_anim_enabled      = "health",
    limping_health_threshold  = "health",
    healing_anim_enabled      = "health",
    -- Accuracy
    accuracy_enabled       = "accuracy",
    acc_disp_novice        = "accuracy",
    acc_disp_trainee       = "accuracy",
    acc_disp_experienced   = "accuracy",
    acc_disp_professional  = "accuracy",
    acc_disp_veteran       = "accuracy",
    acc_disp_expert        = "accuracy",
    acc_disp_master        = "accuracy",
    acc_disp_legend        = "accuracy",
    -- Stance Switch
    stance_enabled = "stance",
    -- Development
    log_level     = "development",
    btn_reset_all = "development",
}

local function path_builder(key)
    return "at/" .. (_key_to_tab[key] or "development") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("at", defaults, path_builder)

-- ==================== BUTTON HANDLERS ====================

-- functor_ui receives the UI_MCM instance as trailing arg (ui_mcm.script:1435).
-- functor would receive nothing. MCM 1.7.2fix leaves the file-local GUI nil on fresh opens
-- (only Open_to sets it, and Reset_last_opt skips Open_to when last_path is nil), so
-- ui_mcm.get_gui() returns nil. functor_ui sidesteps that bug.
-- MCM keeps file-local opt_temp (pending widget edits) at ui_mcm.script:175. Any widget
-- the user touched before clicking the reset button is still there, and On_Accept at
-- ui_mcm.script:2393 writes opt_temp AFTER our config writes, partially un-applying the
-- reset. The warning desc above the button instructs the user to save or discard first.
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", path_builder(k), v)
    end
    config:save()
    load_config()
    -- Without this, consumer-local caches (log level, _disp lookup) stay stale.
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then
            gui.owner:SetMsg(msg, 5)
        end
        -- Close via On_Cancel, not On_Discard. On_Discard calls Reset_opt -> scroll_opt:Clear
        -- at ui_mcm.script:949, which destroys the btn_reset_all button while its click
        -- handler is still on the stack; C++ dispatcher returns into the freed control and
        -- SEH-fires on some exe builds. On_Cancel only calls HideDialog + Unregister_UI;
        -- scroll_opt children stay alive long enough for the handler to unwind.
        if gui.On_Cancel then
            gui:On_Cancel()
        end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, "AlifeTactics: all settings restored to defaults.")
end

-- ==================== MCM DEFINITION ====================

function on_mcm_load()
    return {
        id = "at",
        gr = {
            -- ============ HIT SHARING TAB ============
            {
                id = "hit_share",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_hit_share_desc" },
                    { id = "hit_share_enabled", type = "check", val = 1, def = true },

                    -- Retention
                    { id = "div_retention", type = "line" },
                    { id = "hdr_retention", type = "desc", text = "ui_mcm_at_hdr_retention", clr = {255, 200, 200, 200} },

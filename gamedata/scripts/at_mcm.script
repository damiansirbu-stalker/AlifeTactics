local function path_builder(key)
    return "at/" .. (_key_to_tab[key] or "development") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("at", defaults, path_builder)

local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", path_builder(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then
            gui.owner:SetMsg(msg, 5)
        end
        if gui.On_Cancel then
            gui:On_Cancel()
        end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_at_reset_all_done"))
end

local function _disable_ctrl(ctrl) ctrl:Enable(false) end
local function _grey_cap(cap, clr) cap:TextControl():SetTextColor(clr) end

--- Render a check as a permanent ON, greyed, non-interactive toggle (the always-on danger fixes)
--- @safety SAFE - each call is pcall-guarded against a handler MCM omits on some build
function render_locked_check(_anchor, handlers)
    if type(handlers) ~= "table" then return end
    if handlers.ctrl then pcall(_disable_ctrl, handlers.ctrl) end
    if handlers.cap then pcall(_grey_cap, handlers.cap, GetARGB(255, 120, 120, 120)) end
end

--- Build the option tree (the canonical six-category structure; paths and hints per the architecture)
function on_mcm_load()
    local rct_fb = {
        aim_novice = 0.24, aim_trainee = 0.40, aim_experienced = 0.54, aim_professional = 0.66,
        aim_veteran = 0.80, aim_expert = 0.92, aim_master = 1.06, aim_legend = 1.50,
        track_novice = 0.196, track_trainee = 0.222, track_experienced = 0.245, track_professional = 0.264,
        track_veteran = 0.287, track_expert = 0.306, track_master = 0.328, track_legend = 0.400,
        lead_novice = 2.00, lead_trainee = 1.85, lead_experienced = 1.70, lead_professional = 1.55,
        lead_veteran = 1.40, lead_expert = 1.25, lead_master = 1.10, lead_legend = 1.00,
        qsize_novice = 1.00, qsize_trainee = 0.97, qsize_experienced = 0.95, qsize_professional = 0.93,
        qsize_veteran = 0.91, qsize_expert = 0.89, qsize_master = 0.87, qsize_legend = 0.80,
        qinterval_novice = 1.00, qinterval_trainee = 0.96, qinterval_experienced = 0.93, qinterval_professional = 0.89,
        qinterval_veteran = 0.86, qinterval_expert = 0.82, qinterval_master = 0.79, qinterval_legend = 0.75,
        vision_novice = 1.00, vision_trainee = 1.03, vision_experienced = 1.06, vision_professional = 1.09,
        vision_veteran = 1.12, vision_expert = 1.15, vision_master = 1.18, vision_legend = 1.21,
        vrange_novice = 1.00, vrange_trainee = 1.02, vrange_experienced = 1.05, vrange_professional = 1.07,
        vrange_veteran = 1.09, vrange_expert = 1.11, vrange_master = 1.13, vrange_legend = 1.15,
    }
    local RCT_CONFIG_PATH    = "alifetactics\\at_reaction_config.ltx"
    local RCT_CONFIG_SECTION = "at_reaction"
    local rct_ini = ini_file(RCT_CONFIG_PATH)
    local function rct_def(key)
        return rct_ini:r_float_ex(RCT_CONFIG_SECTION, key) or rct_fb[key]
    end
    local function wip_page(id)
        return {
            id = id,
            sh = true,
            gr = {
                { id = "title", type = "slide", link = "at_mcm_banner",
                    text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_at_" .. id .. "_desc" },            },
        }
    end
    return {
        id = "at",
        gr = {
            {
                id = "combat",
                gr = {
                    {
                        id = "maneuvers",
                        sh = true,
                        gr = {
                            { id = "title", type = "slide", link = "at_mcm_banner",

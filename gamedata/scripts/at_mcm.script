                            { id = "desc", type = "desc", text = "ui_mcm_at_combat_desc" },
                            { id = "combat_enabled", type = "check", val = 1, def = true, hint = "at_combat_combat_enabled" },
                            { id = "combat_ignore_companions", type = "check", val = 1, def = true, hint = "at_combat_combat_ignore_companions" },

                            { id = "div_maneuvers", type = "line" },
                            { id = "hdr_maneuvers", type = "desc", text = "ui_mcm_at_combat_hdr_maneuvers", clr = {255, 200, 200, 200} },
                            { id = "maneuver_kite",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_kite" },
                            { id = "maneuver_retreat", type = "check", val = 1, def = true, hint = "at_combat_maneuver_retreat" },
                            { id = "maneuver_flee",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_flee" },

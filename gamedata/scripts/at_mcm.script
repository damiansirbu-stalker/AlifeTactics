local function _log_mcm_settings()
    local parts = {}
    for key in pairs(defaults) do
        parts[#parts + 1] = key .. "=" .. tostring(cfg[key])
    end
    table.sort(parts)
    at_debug.info("[MCM] %s", table.concat(parts, " "))
end

local function _on_first_update()
    at_debug.refresh()
    at_debug.info("AlifeTactics MCM loaded (log_level=%s)", get_config("log_level") or "WARN")
    _log_mcm_settings()
end

local function _on_option_change()
    load_config()
end

function on_game_start()
    load_config()
    RegisterScriptCallback("actor_on_first_update", _on_first_update)
    RegisterScriptCallback("on_option_change", _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

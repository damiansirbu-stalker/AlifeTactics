--- at_mcm: MCM configuration for AlifeTactics combat AI

local log = xlog.get_logger("AT.MCM", { outfile = "alifetactics.log" })

-- ==================== DEFAULTS ====================
-- Squad Memory is internal core (substrate + role assignment), no MCM toggle.
-- Each user-facing system has its own tab and its own master toggle.

local defaults = {
    -- Hit Sharing
    hit_share_enabled        = true,
    substrate_retention_sec  = 60,
    -- Healing
    healing_enabled           = true,
    heal_rate_multiplier      = 1.0,
    charge_chance_novice      = 50,
    charge_chance_experienced = 50,
    charge_chance_veteran     = 50,
    charge_chance_master      = 50,
    -- Accuracy
    accuracy_enabled       = true,
    acc_mult_novice        = 1.00,
    acc_mult_trainee       = 0.90,
    acc_mult_experienced   = 0.80,
    acc_mult_professional  = 0.70,
    acc_mult_veteran       = 0.60,
    acc_mult_expert        = 0.52,
    acc_mult_master        = 0.45,
    acc_mult_legend        = 0.38,
    -- Maneuver
    maneuver_enabled = true,
    -- Stance Switch
    stance_enabled = true,
    -- Development
    log_level = "WARN",
}

-- ==================== CONFIG ====================

local RegisterScriptCallback = RegisterScriptCallback

local _key_to_tab = {
    -- Hit Sharing
    hit_share_enabled         = "hit_share",
    substrate_retention_sec   = "hit_share",
    -- Healing
    healing_enabled           = "health",
    heal_rate_multiplier      = "health",
    charge_chance_novice      = "health",
    charge_chance_experienced = "health",
    charge_chance_veteran     = "health",
    charge_chance_master      = "health",
    -- Accuracy
    accuracy_enabled       = "accuracy",
    acc_mult_novice        = "accuracy",
    acc_mult_trainee       = "accuracy",
    acc_mult_experienced   = "accuracy",
    acc_mult_professional  = "accuracy",
    acc_mult_veteran       = "accuracy",
    acc_mult_expert        = "accuracy",
    acc_mult_master        = "accuracy",
    acc_mult_legend        = "accuracy",
    -- Maneuver
    maneuver_enabled = "maneuver",
    -- Stance Switch
    stance_enabled = "stance",
    -- Development
    log_level = "development",
}

local function path_builder(key)
    return "at/" .. (_key_to_tab[key] or "development") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("at", defaults, path_builder)

-- ==================== MCM DEFINITION ====================

function on_mcm_load()
    return {
        id = "at",
        gr = {
            -- ============ HIT SHARING TAB ============
            {
                id = "hit_share",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_hit_share_desc" },
                    { id = "hit_share_enabled", type = "check", val = 1, def = true },

                    -- Substrate retention
                    { id = "div_retention", type = "line" },
                    { id = "hdr_retention", type = "desc", text = "ui_mcm_at_hdr_retention", clr = {255, 200, 200, 200} },
                    { id = "substrate_retention_sec", type = "track", val = 2, min = 10, max = 600, step = 5, def = 60 },
                },
            },
            -- ============ HEALING TAB ============
            {
                id = "health",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_health_desc" },
                    { id = "healing_enabled", type = "check", val = 1, def = true },

                    -- Medkit Restoration (info-only: DLTX overlay, boot-time, no runtime toggle)
                    { id = "div_medkit_restoration", type = "line" },
                    { id = "hdr_medkit_restoration", type = "desc", text = "ui_mcm_at_hdr_medkit_restoration", clr = {255, 200, 200, 200} },
                    { id = "info_medkit_restoration", type = "desc", text = "ui_mcm_at_health_medkit_restoration_info" },

                    -- Heal Rate
                    { id = "div_heal_rate", type = "line" },
                    { id = "hdr_heal_rate", type = "desc", text = "ui_mcm_at_hdr_heal_rate", clr = {255, 200, 200, 200} },
                    { id = "heal_rate_multiplier", type = "track", val = 2, min = 0.5, max = 3.0, step = 0.1, def = 1.0 },

                    -- Healing Charge
                    { id = "div_healing_charge", type = "line" },
                    { id = "hdr_healing_charge", type = "desc", text = "ui_mcm_at_hdr_healing_charge", clr = {255, 200, 200, 200} },
                    { id = "charge_chance_novice",      type = "track", val = 2, min = 0, max = 100, step = 5, def = 50 },
                    { id = "charge_chance_experienced", type = "track", val = 2, min = 0, max = 100, step = 5, def = 50 },
                    { id = "charge_chance_veteran",     type = "track", val = 2, min = 0, max = 100, step = 5, def = 50 },
                    { id = "charge_chance_master",      type = "track", val = 2, min = 0, max = 100, step = 5, def = 50 },
                },
            },
            -- ============ ACCURACY TAB ============
            {
                id = "accuracy",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_accuracy_desc" },
                    { id = "accuracy_enabled", type = "check", val = 1, def = true },

                    -- Rank Curve
                    { id = "div_accuracy_curve", type = "line" },
                    { id = "hdr_accuracy_curve", type = "desc", text = "ui_mcm_at_hdr_accuracy_curve", clr = {255, 200, 200, 200} },
                    { id = "acc_mult_novice",       type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 1.00 },
                    { id = "acc_mult_trainee",      type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.90 },
                    { id = "acc_mult_experienced",  type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.80 },
                    { id = "acc_mult_professional", type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.70 },
                    { id = "acc_mult_veteran",      type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.60 },
                    { id = "acc_mult_expert",       type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.52 },
                    { id = "acc_mult_master",       type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.45 },
                    { id = "acc_mult_legend",       type = "track", val = 2, min = 0.20, max = 1.50, step = 0.05, def = 0.38 },
                },
            },
            -- ============ MANEUVER TAB ============
            {
                id = "maneuver",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_maneuver_desc" },
                    { id = "maneuver_enabled", type = "check", val = 1, def = true },
                },
            },
            -- ============ STANCE SWITCH TAB ============
            {
                id = "stance",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_stance_desc" },
                    { id = "stance_enabled", type = "check", val = 1, def = true },
                },
            },
            -- ============ DEVELOPMENT TAB ============
            {
                id = "development",
                sh = true,
                gr = {
                    { id = "title", type = "slide", link = "at_mcm_banner",
                        text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                    { id = "desc", type = "desc", text = "ui_mcm_at_development_desc" },

                    -- Logging
                    { id = "div_logging", type = "line" },
                    { id = "hdr_logging", type = "desc", text = "ui_mcm_at_hdr_logging", clr = {255, 200, 200, 200} },
                    { id = "log_level", type = "list", val = 0, def = "WARN",
                        content = {
                            {"ERROR", "error"},
                            {"WARN", "warn"},
                            {"INFO", "info"},
                            {"DEBUG", "debug"},
                        },
                    },
                },
            },
        },
    }
end

local function _on_first_update()
    log.set_level(get_config("log_level") or "WARN")
    log.info("AlifeTactics MCM loaded (log_level=%s)", get_config("log_level") or "WARN")
end

local function _on_option_change()
    load_config()
    log.set_level(get_config("log_level") or "WARN")
end

function on_game_start()
    load_config()
    RegisterScriptCallback("actor_on_first_update", _on_first_update)
    RegisterScriptCallback("on_option_change", _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default", _on_option_change)
end

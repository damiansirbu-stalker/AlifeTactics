local RegisterScriptCallback = RegisterScriptCallback

-- Every value here MUST mirror the on_mcm_load tree: an option's saved path is at/<tab>/<key>, and
-- ui_mcm.get validates that path against the option tree before touching storage (opt_val gate,
-- MCM ui_mcm.script:711-714) - a path the tree does not contain reads nothing, logs
-- "!MCM given bad path", and the getter silently falls back to the code default.
local _key_to_tab = {
    disclosure_enabled        = "effectiveness/disclosure",
    disclosure_retention_min  = "effectiveness/disclosure",
    disclosure_survivor_gate  = "effectiveness/disclosure",
    healing_enabled           = "mechanics/healing",
    heal_rate_multiplier      = "mechanics/healing",
    charge_chance_novice      = "mechanics/healing",
    charge_chance_experienced = "mechanics/healing",
    charge_chance_veteran     = "mechanics/healing",
    charge_chance_master      = "mechanics/healing",
    limping_anim_enabled      = "mechanics/healing",
    limping_health_threshold  = "mechanics/healing",
    healing_anim_enabled      = "mechanics/healing",
    accuracy_enabled       = "effectiveness/accuracy",
    acc_disp_novice        = "effectiveness/accuracy",
    acc_disp_trainee       = "effectiveness/accuracy",
    acc_disp_experienced   = "effectiveness/accuracy",
    acc_disp_professional  = "effectiveness/accuracy",
    acc_disp_veteran       = "effectiveness/accuracy",
    acc_disp_expert        = "effectiveness/accuracy",
    acc_disp_master        = "effectiveness/accuracy",
    acc_disp_legend        = "effectiveness/accuracy",
    combat_enabled = "combat/maneuvers",
    combat_ignore_companions = "combat/maneuvers",
    maneuver_kite    = "combat/maneuvers",
    maneuver_retreat = "combat/maneuvers",
    maneuver_flee    = "combat/maneuvers",
    maneuver_snipe   = "combat/maneuvers",
    crossfire_enabled = "effectiveness/crossfire",
    crossfire_factor  = "effectiveness/crossfire",
    danger_hit_bypass   = "effectiveness/danger",
    danger_attack_sound = "effectiveness/danger",
    danger_actor_tables = "effectiveness/danger",
    jam_enabled         = "mechanics/jam",
    ammo_enabled        = "mechanics/ammo",
    log_level     = "development",
    btn_reset_all = "development",
    hud_position   = "development",
}

local function path_builder(key)
    return "at/" .. (_key_to_tab[key] or "development") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("at", defaults, path_builder)

-- functor_ui receives the UI_MCM instance as trailing arg (ui_mcm.script:1435).
-- functor would receive nothing. MCM 1.7.2fix leaves file-local GUI nil on fresh
-- opens (only Open_to sets it, Reset_last_opt skips Open_to when last_path is nil),
-- so ui_mcm.get_gui() returns nil. functor_ui sidesteps that bug.
-- MCM keeps file-local opt_temp (pending widget edits) at ui_mcm.script:175. On_Accept
-- at ui_mcm.script:2393 writes opt_temp AFTER our config writes, partially un-applying
-- the reset. The warning desc above the button instructs the user to save or discard first.
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", path_builder(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then
            gui.owner:SetMsg(msg, 5)
        end
        -- Close via On_Cancel: On_Discard calls Reset_opt -> scroll_opt:Clear at
        -- ui_mcm.script:949, which destroys btn_reset_all while its click handler is
        -- still on the stack; C++ dispatcher returns into the freed control and
        -- SEH-fires on some exe builds. On_Cancel only calls HideDialog + Unregister_UI.
        if gui.On_Cancel then
            gui:On_Cancel()
        end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_at_reset_all_done"))
end

-- The menu tree groups pages under the category folders Combat / Effectiveness / Mechanics / Effects / Mutants.
-- (1) The saved setting path is path_builder(key) = at/_key_to_tab[key]/key and it MUST match this tree:
-- ui_mcm.get validates the path against the option tree before reading storage (opt_val gate, MCM
-- ui_mcm.script:711-714), so reparenting a page moves its path - update _key_to_tab in the same edit, and
-- values stored under the old path are orphaned (defaults apply until the user re-sets them). The original
-- restructure assumed the path was independent of the tree; it is not - every read off-tree logged
-- "!MCM given bad path" and returned the code default. (2) An option's label/hint string is
-- opt_str .. (v.hint or path) (ui_mcm.script:1412,886), so each option sets hint = its original
-- "at_<tab>_<key>" and the label resolves to the existing ui_mcm_at_<tab>_<key> string without renaming any
-- strings to the new tree path. desc/hdr/title nodes keep explicit text. Only the ui_mcm_menu_<id> page
-- labels move (handled in ui_st_mcm_at.xml). WIP sub-pages carry a single "wip" desc until their feature exists.
function on_mcm_load()
    local function wip_page(id)
        return {
            id = id,
            sh = true,
            gr = {
                { id = "title", type = "slide", link = "at_mcm_banner",
                    text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_at_" .. id .. "_desc" },            },
        }
    end
    return {
        id = "at",
        gr = {
            {
                id = "combat",
                gr = {
                    {
                        id = "maneuvers",
                        sh = true,

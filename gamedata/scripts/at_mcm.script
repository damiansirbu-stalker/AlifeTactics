local function build_path(key)
    return "at/" .. (_key_to_tab[key] or "development") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("at", defaults, build_path)

local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", build_path(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then
            gui.owner:SetMsg(msg, 5)
        end
        if gui.On_Cancel then
            gui:On_Cancel()
        end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

local function _disable_ctrl(ctrl) ctrl:Enable(false) end
local function _set_cap_color(cap, clr) cap:TextControl():SetTextColor(clr) end

local function _log_mcm_settings()
    local parts = {}
    for key in pairs(defaults) do
        parts[#parts + 1] = key .. "=" .. tostring(cfg[key])
    end
    table.sort(parts)
    at_debug.info("[MCM] %s", table.concat(parts, " "))
end

local function _on_first_update()
    at_debug.update_config()
    at_debug.info("AlifeTactics MCM loaded (log_level=%s)", get_config("log_level") or "WARN")
    _log_mcm_settings()
end

local function _on_option_change()
    load_config()
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_at_reset_all_done"))
end

--- Render a check as a permanent ON, greyed, non-interactive toggle (the always-on danger fixes).
--- @safety SAFE - each call is pcall-guarded against a handler MCM omits on some build
function render_locked_check(_anchor, handlers)
    if type(handlers) ~= "table" then return end
    if handlers.ctrl then pcall(_disable_ctrl, handlers.ctrl) end
    if handlers.cap then pcall(_set_cap_color, handlers.cap, GetARGB(255, 120, 120, 120)) end
end

--- Build the option tree (the canonical six-category structure; paths and hints per the architecture).
function on_mcm_load()
    local rct_fb = {
        aim_base = 0.24, aim_rank_pct = 63,
        track_base = 0.196, track_rank_pct = 12,
        lead_base = 2.00, lead_rank_pct = -7.4,
        vision_base = 1.00, vision_rank_pct = 2.9,
        vrange_base = 1.00, vrange_rank_pct = 2.1,
        qsize_base = 1.00, qsize_rank_pct = -0.6,
        qinterval_base = 1.00, qinterval_rank_pct = -0.7,
    }
    local RCT_CONFIG_PATH    = "alifetactics\\at_reaction_config.ltx"
    local RCT_CONFIG_SECTION = "at_reaction"
    local rct_ini = ini_file(RCT_CONFIG_PATH)
    local function get_rct(key)
        return rct_ini:r_float_ex(RCT_CONFIG_SECTION, key) or rct_fb[key]
    end
    local function build_wip_page(id)
        return {
            id = id,
            sh = true,
            gr = {
                { id = "title", type = "slide", link = "at_mcm_banner",
                    text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_at_" .. id .. "_desc" },            },
        }
    end
    return {
        id = "at",
        gr = {
            {
                id = "combat",
                gr = {
                    {
                        id = "general",
                        sh = true,
                        gr = {
                            { id = "title", type = "slide", link = "at_mcm_banner",
                                text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                            { id = "desc", type = "desc", text = "ui_mcm_at_combat_general_desc" },
                            { id = "int_base",     type = "track", val = 2, min = 0, max = 100, step = 5, def = 40, hint = "at_general_int_base" },
                            { id = "int_rank_pct", type = "track", val = 2, min = 0, max = 20, step = 1, def = 6, hint = "at_general_int_rank_pct" },
                        },
                    },
                    {
                        id = "maneuvers",
                        sh = true,
                        gr = {
                            { id = "title", type = "slide", link = "at_mcm_banner",
                                text = "ui_mcm_at_title", size = {512, 50}, spacing = 20 },
                            { id = "desc", type = "desc", text = "ui_mcm_at_combat_desc" },
                            { id = "combat_enabled", type = "check", val = 1, def = true, hint = "at_combat_combat_enabled" },
                            { id = "combat_ignore_companions", type = "check", val = 1, def = true, hint = "at_combat_combat_ignore_companions" },
                            { id = "combat_hit_hold", type = "check", val = 1, def = true, hint = "at_combat_combat_hit_hold" },

                            { id = "div_maneuvers", type = "line" },
                            { id = "hdr_maneuvers", type = "desc", text = "ui_mcm_at_combat_hdr_maneuvers", clr = {255, 200, 200, 200} },
                            { id = "maneuver_counterflank",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_counterflank" },
                            { id = "maneuver_reload_cover",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_reload_cover" },
                            { id = "maneuver_flee",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_flee" },
                            { id = "maneuver_retreat", type = "check", val = 1, def = true, hint = "at_combat_maneuver_retreat" },
                            { id = "maneuver_kite",    type = "check", val = 1, def = true, hint = "at_combat_maneuver_kite" },
                            { id = "maneuver_pickoff", type = "check", val = 1, def = true, hint = "at_combat_maneuver_pickoff" },

                            { id = "div_footer", type = "line" },
                            { id = "platform", type = "desc", text = "ui_mcm_xmcm_footer",
                                ui_hook_functor = { _at_init.get_platform_functor() }, clr = {255, 212, 201, 168} },                        },

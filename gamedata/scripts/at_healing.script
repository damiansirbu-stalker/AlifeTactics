--- at_healing: Heal-rate scaling, per-rank healing charge, limp + heal animations

local math_random, tostring = math.random, tostring
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global
local IsStalker, IsWounded = IsStalker, IsWounded

local LIMP_ELIGIBILITY_CHECK_MS = 1000
local LIMP_DROP_CHECK_MS        = 200
local LIMP_SAMPLE_MS            = 1000
local LIMP_REARM_MS             = 5000
-- Displacement that counts as "moved" for the drop detectors (anchor drift / path-stop sample).
local LIMP_MOVE_M               = 0.2
local LIMP_MOVE_SQR             = LIMP_MOVE_M * LIMP_MOVE_M
-- Presentation-only perceivability gate: the limp pose and heal gesture play only within this
-- radius of the actor (nobody sees them farther; xcombat.actor_dist_sqr is the 5s-TTL cached
-- read the combat seize gate shares). The healing SIMULATION (hp/bleed ticks, item consumption)
-- is never distance-gated - off-screen stalkers heal identically.
local ANIM_ACTOR_RADIUS_M       = 50
local ANIM_RADIUS_SQR           = ANIM_ACTOR_RADIUS_M * ANIM_ACTOR_RADIUS_M
-- xr_eat_medkit.consume_medkit schedules heal_hp/heal_bleed with left=15.
local HEAL_TICK_FIRST           = 15

-- Posture-slot tables for the dmg_norm hurt pose (the clutch-the-torso overlay), one variant per
-- commanded gait. Engine indexes torso anims by weapon posture slot, not inventory slot. Missing
-- entries fall through to slot 0 (fist). Slots 5, 7 not present in the OMF; slot 6 exists only as
-- the run variant (verified 2026-07-08 by binary grep across the GAMMA-installed and xrMPE
-- stalker_animation.omf - a queued name the OMF lacks error-logs and plays nothing).
local LIMP_IDLE_BY_SLOT = {
    [0] = "dmg_norm_torso_0_idle_0", [1] = "dmg_norm_torso_1_idle_0",
    [2] = "dmg_norm_torso_2_idle_0", [3] = "dmg_norm_torso_3_idle_0",
    [4] = "dmg_norm_torso_4_idle_0",
    [8] = "dmg_norm_torso_8_idle_0", [9] = "dmg_norm_torso_9_idle_0",
    [10] = "dmg_norm_torso_10_idle_0",
}
local LIMP_WALK_BY_SLOT = {
    [0] = "dmg_norm_torso_0_walk_0", [1] = "dmg_norm_torso_1_walk_0",
    [2] = "dmg_norm_torso_2_walk_0", [3] = "dmg_norm_torso_3_walk_0",
    [4] = "dmg_norm_torso_4_walk_0",
    [8] = "dmg_norm_torso_8_walk_0", [9] = "dmg_norm_torso_9_walk_0",
    [10] = "dmg_norm_torso_10_walk_0",
}
local LIMP_RUN_BY_SLOT = {
    [0] = "dmg_norm_torso_0_run_0", [1] = "dmg_norm_torso_1_run_0",
    [2] = "dmg_norm_torso_2_run_0", [3] = "dmg_norm_torso_3_run_0",
    [4] = "dmg_norm_torso_4_run_0", [6] = "dmg_norm_torso_6_run_0",
    [8] = "dmg_norm_torso_8_run_0", [9] = "dmg_norm_torso_9_run_0",
    [10] = "dmg_norm_torso_10_run_0",
}
local HEAL_ANIM_MEDKIT  = "dmg_norm_torso_11_attack_0"
local HEAL_ANIM_BANDAGE = "norm_torso_12_attack_0"

local _limping = {}

-- Vanilla pstor writes to a wrong key when name is nil. Guard explicitly.
local function _safe_save(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _safe_load(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end

local log = xlog.get_logger("AT.HEALING", { outfile = "alifetactics.log" })
local _dbg = false
local _heal_active = false
local cfg = at_mcm.cfg

-- Vanilla rank intervals (game_relations.ltx [game_relations] rating) folded
-- into MCM tiers via ranks.get_obj_rank_name.
local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local function _rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

-- One-shot medkit/bandage gesture. Gated on healing_anim toggle, on no visible
-- enemy (no anim during combat), and on not-on-ground. The hurt pose belongs to
-- LIMP, not here; HEAL is "I am applying an item" and nothing else. The engine
-- drains the queue when the gesture ends; action transitions clear it on the way
-- to action_wounded / action_critically_wounded (stalker_base_action.cpp:24-29).
local function _try_play_heal_anim(npc, gesture)
    if not cfg.healing_anim_enabled then return end
    if xcombat.actor_dist_sqr(npc) > ANIM_RADIUS_SQR then return end
    if npc:best_enemy() then
        if _dbg then log.debug("[HEAL] anim skipped id=%d reason=combat", npc:id()) end
        return
    end
    if IsWounded(npc) or npc:critically_wounded() then
        if _dbg then log.debug("[HEAL] anim skipped id=%d reason=wounded", npc:id()) end
        return
    end
    utils_obj.add_anim(npc, gesture)
    if _dbg then log.debug("[HEAL] anim id=%d gesture=%s", npc:id(), gesture) end
end

-- Vanilla xr_eat_medkit.heal_hp (script:188-201) with MCM rate multiplier.
-- Reschedules via xr_eat_medkit.heal_hp lookup so the chain stays on the patched function.
local function _patched_heal_hp(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        local mult = cfg.heal_rate_multiplier
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        if left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_MEDKIT)
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- Vanilla xr_eat_medkit.heal_bleed (script:203-215) with logging only.
-- Engine bleeding field is a hard set per tick, not a delta -- no multiplier.
local function _patched_heal_bleed(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        npc.bleeding = 0.07
        if left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_BANDAGE)
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- xr_eat_medkit.consume_medkit save-wrap, logging only: the real-item-vs-charge proof. A non-nil
-- medkit is a REAL inventory item the vanilla path is about to release (alife_release_id,
-- xr_eat_medkit.script:218-221); nil is the per-rank healing_charge fallback (no item existed).
-- This line is what distinguishes "they heal with real medkits" from silent magic healing.
local _orig_consume

local function _patched_consume(npc, medkit, kind)
    if _dbg and npc then
        log.debug("[HEAL] consume id=%d item=%s kind=%s",
            npc:id(), medkit and medkit:section() or "CHARGE", tostring(kind))
    end
    return _orig_consume(npc, medkit, kind)
end

local function _install_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        log.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _patched_heal_hp
    xr_eat_medkit.heal_bleed = _patched_heal_bleed
    if xr_eat_medkit.consume_medkit then
        _orig_consume = xr_eat_medkit.consume_medkit
        xr_eat_medkit.consume_medkit = _patched_consume
    end
    _heal_active = true
    log.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    log.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
    log.info("[PATCH] xr_eat_medkit.consume_medkit wrapped (item-vs-charge trace)")
end

-- Per-rank charge override of vanilla's flat 50% roll at xr_eat_medkit.script:36-44.
-- Vanilla's bug (re-roll on every save load) is suppressed in zzz_at_healing_patch.script.
local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = npc:id()
    local name = npc:name()
    if _safe_load(id, name, "at_charge_processed") then
        tmr:stop()
        if _dbg then
            log.debug("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, tmr:get_ms())
        end
        return
    end
    _safe_save(id, name, "at_charge_processed", true)

    local tier = _rank_tier(npc)
    local chance = (cfg["charge_chance_" .. tier] or 50) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _safe_save(id, name, "healing_charge", granted)
    tmr:stop()
    if _dbg then
        log.debug("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", tmr:get_ms())
    end
end

-- Hurt pose for the active weapon posture slot, variant by the commanded gait.
local function _pick_limp_anim(npc, mt)
    local tbl = (mt == move.walk and LIMP_WALK_BY_SLOT)
             or (mt == move.run  and LIMP_RUN_BY_SLOT)
             or LIMP_IDLE_BY_SLOT
    return tbl[npc:active_slot()] or tbl[0]
end

-- Drop one NPC's record and release the skeleton. clear_animations wipes only the script queue
-- (script_game_object3.cpp:466-476); the next engine update resumes its own animation selection.
local function _drop_limp(npc, id, reason, us)
    _limping[id] = nil
    if npc:alive() then npc:clear_animations() end
    if _dbg then log.debug("[LIMP] lost id=%d hp=%.2f reason=%s [%dus]", id, npc.health, reason, us or -1) end
end

-- The drop detectors, on their own 200ms clock. While a script animation is queued the engine
-- SUSPENDS its whole animation selection: update_impl returns right after play_script
-- (stalker_animation_manager_update.cpp:232) so play_torso/play_legs never run, and the script bone
-- mask covers every part but the head (stalker_animation_manager.cpp:97). The legs only look alive
-- while the skeleton loops the last-fed cycle, so an overlay outliving its gait freezes or slides the
-- body. Detectors: wounded/dead; the commanded gait changed from the add-time one; a stand-variant
-- NPC drifted off its add-time anchor; a walk/run-variant NPC stopped displacing (path ended with the
-- command still up). Returns true when the record was dropped.
local function _try_drop_limp(npc, id, rec, tg)
    local tmr = xprofiler.new_if(_dbg):start()
    if not npc:alive() or IsWounded(npc) or npc:critically_wounded() then
        tmr:stop()
        _drop_limp(npc, id, "wounded_or_dead", tmr:get_us())
        return true
    end
    if rec.mt == nil then tmr:stop() return false end
    if npc:movement_type() ~= rec.mt then
        tmr:stop()
        _drop_limp(npc, id, "gait_changed", tmr:get_us())
        return true
    end
    local pos = npc:position()
    if rec.mt == move.stand then
        if rec.anchor and pos:distance_to_sqr(rec.anchor) > LIMP_MOVE_SQR then
            tmr:stop()
            _drop_limp(npc, id, "moved", tmr:get_us())
            return true
        end
        tmr:stop()
        return false
    end
    if (tg - (rec.sample_ms or 0)) < LIMP_SAMPLE_MS then tmr:stop() return false end
    local displaced = rec.last_pos == nil or pos:distance_to_sqr(rec.last_pos) > LIMP_MOVE_SQR
    rec.sample_ms = tg
    rec.last_pos = pos
    if not displaced then
        tmr:stop()
        _drop_limp(npc, id, "stopped", tmr:get_us())
        return true
    end
    tmr:stop()
    return false
end

-- [LIMP] decline aggregate, debug only: for HURT stalkers that failed eligibility, count the first
-- failing gate and summarize one line per window - the flood-free answer to "why is nobody limping"
-- (a per-decline line would be one per hurt NPC per second). The reads duplicate the eligibility
-- chain's, on the debug path only, so the live chain keeps its short-circuit shape.
local _limp_declines = { n = 0, far = 0, enemy = 0, mental = 0, standing = 0, wounded = 0, smart_cover = 0, zombied = 0, other = 0 }
local LIMP_DECLINE_WINDOW = 100

local function _limp_note_decline(npc)
    local d = _limp_declines
    local reason = (xcombat.actor_dist_sqr(npc) > ANIM_RADIUS_SQR and "far")
        or (npc:best_enemy() and "enemy")
        or (npc:mental_state() ~= anim.free and "mental")
        or (npc:body_state() ~= move.standing and "standing")
        or (IsWounded(npc) and "wounded")
        or (npc:in_smart_cover() and "smart_cover")
        or (npc:character_community() == "zombied" and "zombied")
        or "other"
    d[reason] = d[reason] + 1
    d.n = d.n + 1
    if d.n >= LIMP_DECLINE_WINDOW then
        log.debug("[LIMP] declined n=%d far=%d enemy=%d mental=%d standing=%d wounded=%d smart_cover=%d zombied=%d other=%d",
            d.n, d.far, d.enemy, d.mental, d.standing, d.wounded, d.smart_cover, d.zombied, d.other)
        d.n, d.far, d.enemy, d.mental, d.standing, d.wounded, d.smart_cover, d.zombied, d.other = 0, 0, 0, 0, 0, 0, 0, 0, 0
    end
end

local function _on_npc_update(npc, st)
    if not st then return end
    if not cfg.limping_anim_enabled then return end
    local id = npc:id()
    local tg = time_global()

    local rec = _limping[id]
    if rec and tg >= (rec.next_drop_ms or 0) then
        rec.next_drop_ms = tg + LIMP_DROP_CHECK_MS
        if _try_drop_limp(npc, id, rec, tg) then return end
    end
    if st._at_limp_next_check_ms and tg < st._at_limp_next_check_ms then return end
    st._at_limp_next_check_ms = tg + LIMP_ELIGIBILITY_CHECK_MS
    local tmr = xprofiler.new_if(_dbg):start()
    local eligible = IsStalker(npc)
        and npc:alive()
        and xcombat.actor_dist_sqr(npc) <= ANIM_RADIUS_SQR
        and not npc:in_smart_cover()
        and npc.health < cfg.limping_health_threshold
        and not npc:best_enemy()
        and npc:mental_state() == anim.free
        and npc:body_state() == move.standing
        and npc:character_community() ~= "zombied"
        and not IsWounded(npc)

    if not eligible then
        tmr:stop()
        if _dbg and IsStalker(npc) and npc:alive() and npc.health < cfg.limping_health_threshold then
            _limp_note_decline(npc)
        end
        if not _limping[id] then return end
        _drop_limp(npc, id, "not_eligible", tmr:get_us())
        return
    end
    rec = _limping[id]
    if not rec then
        rec = { next_add_ms = 0 }
        _limping[id] = rec
        if _dbg then tmr:stop() log.debug("[LIMP] gained id=%d hp=%.2f [%dus]", id, npc.health, tmr:get_us()) end
    end
    if tg < rec.next_add_ms then return end
    if npc:animation_count() > 0 then return end

    local mt = npc:movement_type()
    local anim_name = _pick_limp_anim(npc, mt)
    utils_obj.add_anim(npc, anim_name)
    rec.next_add_ms = tg + LIMP_REARM_MS
    rec.mt = mt
    rec.anchor = npc:position()
    rec.last_pos = nil
    rec.sample_ms = tg
    if _dbg then
        tmr:stop()
        local slot = npc:active_slot()
        local wpn  = npc:active_item()
        local sect = wpn and wpn:section() or "none"
        log.debug("[LIMP] anim id=%d name=%s slot=%d section=%s hp=%.2f [%dus]",
            id, anim_name, slot, sect, npc.health, tmr:get_us())
    end
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _limping[se_obj.id] = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_actor_first_update()
    _limping = {}
    _refresh_log()
    if not _heal_active then return end
    log.info("Health module initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        cfg.heal_rate_multiplier,
        cfg.charge_chance_novice,
        cfg.charge_chance_experienced,
        cfg.charge_chance_veteran,
        cfg.charge_chance_master)
end

function on_game_start()
    RegisterScriptCallback("npc_on_update",              _on_npc_update)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)

    -- get_config (closure) bypasses cfg cache, safe before at_mcm.on_game_start runs.
    if at_mcm.get_config("healing_enabled") == false then
        log.info("Stalker Healing disabled at boot; vanilla xr_eat_medkit behavior in effect")
        return
    end
    _install_heal_patch()
    RegisterScriptCallback("npc_on_net_spawn", _on_net_spawn)
end

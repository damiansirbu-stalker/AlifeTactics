--- at_healing: active first-aid healing - heal rate, per-rank medkit charge, limp and heal animations

local math_random, tostring, pairs, type = math.random, tostring, pairs, type
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global
local IsStalker, IsWounded = IsStalker, IsWounded

local MONITOR_PERIOD_SEC        = 0.2
local LIMP_ELIGIBILITY_CHECK_MS = 1000
local LIMP_SAMPLE_MS            = 1000
local LIMP_REARM_MS             = 5000
local LIMP_MOVE_M               = 0.2
local LIMP_MOVE_SQR             = LIMP_MOVE_M * LIMP_MOVE_M
local ANIM_ACTOR_RADIUS_M       = 50
local ANIM_RADIUS_SQR           = ANIM_ACTOR_RADIUS_M * ANIM_ACTOR_RADIUS_M
local HEAL_TICK_FIRST           = 15

local LIMP_IDLE_BY_SLOT = {
    [0] = "dmg_norm_torso_0_idle_0", [1] = "dmg_norm_torso_1_idle_0",
    [2] = "dmg_norm_torso_2_idle_0", [3] = "dmg_norm_torso_3_idle_0",
    [4] = "dmg_norm_torso_4_idle_0",
    [8] = "dmg_norm_torso_8_idle_0", [9] = "dmg_norm_torso_9_idle_0",
    [10] = "dmg_norm_torso_10_idle_0",
}
local LIMP_WALK_BY_SLOT = {
    [0] = "dmg_norm_torso_0_walk_0", [1] = "dmg_norm_torso_1_walk_0",
    [2] = "dmg_norm_torso_2_walk_0", [3] = "dmg_norm_torso_3_walk_0",
    [4] = "dmg_norm_torso_4_walk_0",
    [8] = "dmg_norm_torso_8_walk_0", [9] = "dmg_norm_torso_9_walk_0",
    [10] = "dmg_norm_torso_10_walk_0",
}
local LIMP_RUN_BY_SLOT = {
    [0] = "dmg_norm_torso_0_run_0", [1] = "dmg_norm_torso_1_run_0",
    [2] = "dmg_norm_torso_2_run_0", [3] = "dmg_norm_torso_3_run_0",
    [4] = "dmg_norm_torso_4_run_0", [6] = "dmg_norm_torso_6_run_0",
    [8] = "dmg_norm_torso_8_run_0", [9] = "dmg_norm_torso_9_run_0",
    [10] = "dmg_norm_torso_10_run_0",
}
local HEAL_ANIM_MEDKIT  = "dmg_norm_torso_11_attack_0"
local HEAL_ANIM_BANDAGE = "norm_torso_12_attack_0"

local ENGAGED_MELEE_SQR = 5 * 5
local LIMP_DECLINE_WINDOW = 100
local WOUNDED_MEDKITS = { "medkit_script", "medkit", "medkit_army", "medkit_scientic" }

local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local _limping = {}
local _npc_states = {}
local _heal_active = false
local _orig_consume
local _wounded_wrapped = false
local _monitor_active = false
local _limp_declines = { n = 0, far = 0, enemy = 0, mental = 0, standing = 0, wounded = 0, smart_cover = 0, faction = 0, other = 0 }

local cfg = at_mcm.cfg

local function _save_var(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _load_var(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end

local function _get_rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

local function _is_calm(npc)
    return npc:mental_state() == anim.free
end

local function _try_play_heal_anim(npc, gesture)
    if not cfg.healing_anim_enabled then return end
    if xcombat.get_actor_dist_sqr(npc) > ANIM_RADIUS_SQR then return end
    if xcombat.get_best_enemy(npc) then
        if at_debug.is_on() then at_debug.debug("[HEAL] anim skipped id=%d reason=combat", npc:id()) end
        return
    end
    if IsWounded(npc) or npc:critically_wounded() then
        if at_debug.is_on() then at_debug.debug("[HEAL] anim skipped id=%d reason=wounded", npc:id()) end
        return
    end
    if npc:movement_type() ~= move.stand then
        if at_debug.is_on() then at_debug.debug("[HEAL] anim skipped id=%d reason=moving", npc:id()) end
        return
    end
    if npc:animation_count() > 0 then
        if at_debug.is_on() then at_debug.debug("[HEAL] anim skipped id=%d reason=queued", npc:id()) end
        return
    end
    utils_obj.add_anim(npc, gesture)
    if at_debug.is_on() then at_debug.debug("[HEAL] anim id=%d gesture=%s", npc:id(), gesture) end
end

local function _is_engaged(npc)
    local enemy = xcombat.get_best_enemy(npc)
    if not (enemy and enemy:alive()) then return false end
    if npc:active_item() and npc:weapon_unstrapped() then return true end
    return npc:position():distance_to_sqr(enemy:position()) <= ENGAGED_MELEE_SQR
end

local function _try_pause_hp(npc, id, name, left)
    if not _is_engaged(npc) then return false end
    if at_debug.is_on() then at_debug.debug("[HEAL] hp_pause id=%d left=%d engaged", id, left) end
    ResetTimeEvent(id, name .. "_self_healing_event_hp_" .. left, level.get_time_factor())
    return true
end

local function _log_hp_complete(timer, npc, id, left)
    if not at_debug.is_on() then return end
    local reason = "ticks_exhausted"
    if npc == nil then
        reason = "no_obj"
    elseif not npc:alive() then
        reason = "dead"
    end
    at_debug.debug("[HEAL] complete id=%d reason=%s left=%d [%.2fms]", id, reason, left, timer:get_ms())
end

local function _update_heal_hp(id, left)
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local nextl = left - 1
    local npc = xobject.get_go(id)
    if npc and npc:alive() and nextl > 1 then
        local enabled = cfg.healing_enabled ~= false
        local name = npc:name()
        if enabled and _try_pause_hp(npc, id, name, left) then
            timer:stop()
            return false
        end
        local mult = enabled and cfg.heal_rate_multiplier or 1
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        if enabled and left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_MEDKIT)
        end
        timer:stop()
        if at_debug.is_on() then
            at_debug.debug("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, timer:get_ms())
        end
        CreateTimeEvent(id, name .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        timer:stop()
        _log_hp_complete(timer, npc, id, left)
    end
    return true
end

local function _update_heal_bleed(id, left)
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local nextl = left - 1
    local npc = xobject.get_go(id)
    if npc and npc:alive() and nextl > 1 then
        npc.bleeding = 0.07
        if cfg.healing_enabled ~= false and left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_BANDAGE)
        end
        timer:stop()
        if at_debug.is_on() then
            at_debug.debug("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, timer:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        timer:stop()
        if at_debug.is_on() then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            at_debug.debug("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, timer:get_ms())
        end
    end
    return true
end

local function _trace_consume(npc, medkit, kind)
    if at_debug.is_on() and npc then
        at_debug.debug("[HEAL] consume id=%d item=%s kind=%s",
            npc:id(), medkit and medkit:section() or "CHARGE", tostring(kind))
    end
    return _orig_consume(npc, medkit, kind)
end

local function _register_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        at_debug.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _update_heal_hp
    xr_eat_medkit.heal_bleed = _update_heal_bleed
    if xr_eat_medkit.consume_medkit then
        _orig_consume = xr_eat_medkit.consume_medkit
        xr_eat_medkit.consume_medkit = _trace_consume
    end
    _heal_active = true
    at_debug.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    at_debug.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
    at_debug.info("[PATCH] xr_eat_medkit.consume_medkit wrapped (item-vs-charge trace)")
end

local function _register_hook(class_obj, name, wrapper)
    if not class_obj then return nil end
    local original = class_obj[name]
    if type(original) ~= "function" then return nil end
    class_obj[name] = function(...) return wrapper(original, ...) end
    return original
end

local function _get_medkit_section(npc)
    for i = 1, #WOUNDED_MEDKITS do
        if npc:object(WOUNDED_MEDKITS[i]) then return WOUNDED_MEDKITS[i] end
    end
    return "none"
end

local function _trace_wounded_eat(orig, self)
    local sec
    if at_debug.is_on() and self and self.npc then
        sec = _get_medkit_section(self.npc)
    end
    local ret = orig(self)
    if ret and sec then
        at_debug.debug("[HEAL] wounded_consume id=%d item=%s", self.npc:id(), sec)
    end
    return ret
end

local function _register_wounded_trace()
    if _wounded_wrapped then return end
    local _ = xr_wounded and xr_wounded.unlock_medkit
    local class_obj = xr_wounded and xr_wounded.Cwound_manager
    local original = class_obj and _register_hook(class_obj, "eat_medkit", _trace_wounded_eat)
    if not original then
        at_debug.warn("[PATCH] xr_wounded.Cwound_manager.eat_medkit unavailable; wounded-consume trace off")
        return
    end
    _wounded_wrapped = true
    at_debug.info("[PATCH] xr_wounded.Cwound_manager.eat_medkit wrapped (wounded-consume trace)")
end

local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    if cfg.healing_enabled == false then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local id = npc:id()
    local name = npc:name()
    if _load_var(id, name, "at_charge_processed") then
        timer:stop()
        if at_debug.is_on() then
            at_debug.debug("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, timer:get_ms())
        end
        return
    end
    _save_var(id, name, "at_charge_processed", true)

    local tier = _get_rank_tier(npc)
    local chance = (cfg["charge_chance_" .. tier] or 50) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _save_var(id, name, "healing_charge", granted)
    timer:stop()
    if at_debug.is_on() then
        at_debug.debug("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", timer:get_ms())
    end
end

local function _select_limp_anim(npc, mt)
    local tbl = (mt == move.walk and LIMP_WALK_BY_SLOT)
             or (mt == move.run  and LIMP_RUN_BY_SLOT)
             or LIMP_IDLE_BY_SLOT
    return tbl[npc:active_slot()] or tbl[0]
end

local function _stop_limp(npc, id, reason, us)
    _limping[id] = nil
    if npc:alive() then npc:clear_animations() end
    if at_debug.is_on() then at_debug.debug("[LIMP] lost id=%d hp=%.2f reason=%s [%dus]", id, npc.health, reason, us or -1) end
end

local function _is_in_combat(npc)
    return xcombat.get_best_enemy(npc) ~= nil or not _is_calm(npc)
end

local function _try_drop_limp(npc, id, rec, tg)
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    if not npc:alive() or IsWounded(npc) or npc:critically_wounded() then
        timer:stop()
        _stop_limp(npc, id, "wounded_or_dead", timer:get_us())
        return true
    end
    if _is_in_combat(npc) then
        timer:stop()
        _stop_limp(npc, id, "combat", timer:get_us())
        return true
    end
    if rec.mt == nil then timer:stop() return false end
    if npc:movement_type() ~= rec.mt then
        timer:stop()
        _stop_limp(npc, id, "gait_changed", timer:get_us())
        return true
    end
    local pos = npc:position()
    if rec.mt == move.stand then
        if rec.anchor and pos:distance_to_sqr(rec.anchor) > LIMP_MOVE_SQR then
            timer:stop()
            _stop_limp(npc, id, "moved", timer:get_us())
            return true
        end
        timer:stop()
        return false
    end
    if (tg - (rec.sample_ms or 0)) < LIMP_SAMPLE_MS then timer:stop() return false end
    local displaced = rec.last_pos == nil or pos:distance_to_sqr(rec.last_pos) > LIMP_MOVE_SQR
    rec.sample_ms = tg
    rec.last_pos = pos
    if not displaced then
        timer:stop()
        _stop_limp(npc, id, "stopped", timer:get_us())
        return true
    end
    timer:stop()
    return false
end

local function _get_decline_reason(npc)
    if xcombat.get_actor_dist_sqr(npc) > ANIM_RADIUS_SQR then return "far" end
    if xcombat.get_best_enemy(npc) then return "enemy" end
    if not _is_calm(npc) then return "mental" end
    if npc:body_state() ~= move.standing then return "standing" end
    if IsWounded(npc) then return "wounded" end
    if npc:in_smart_cover() then return "smart_cover" end
    if not at_faction.has_flavor(npc, "healing") then return "faction" end
    return "other"
end

local function _log_decline(npc)
    local counts = _limp_declines
    local reason = _get_decline_reason(npc)
    counts[reason] = counts[reason] + 1
    counts.n = counts.n + 1
    if counts.n >= LIMP_DECLINE_WINDOW then
        at_debug.debug("[LIMP] declined n=%d far=%d enemy=%d mental=%d standing=%d wounded=%d smart_cover=%d faction=%d other=%d",
            counts.n, counts.far, counts.enemy, counts.mental, counts.standing, counts.wounded, counts.smart_cover, counts.faction, counts.other)
        counts.n, counts.far, counts.enemy, counts.mental, counts.standing, counts.wounded, counts.smart_cover, counts.faction, counts.other = 0, 0, 0, 0, 0, 0, 0, 0, 0
    end
end

local function _run_limp_check(npc, id, state, tg)
    local rec = _limping[id]
    if rec and _try_drop_limp(npc, id, rec, tg) then return end
    if state.eligibility_at and tg < state.eligibility_at then return end
    state.eligibility_at = tg + LIMP_ELIGIBILITY_CHECK_MS
    local timer = xprofiler.new_if(at_debug.is_on()):start()
    local eligible = IsStalker(npc)
        and npc:alive()
        and xcombat.get_actor_dist_sqr(npc) <= ANIM_RADIUS_SQR
        and not npc:in_smart_cover()
        and npc.health < cfg.limping_health_threshold
        and not xcombat.get_best_enemy(npc)
        and _is_calm(npc)
        and npc:body_state() == move.standing
        and at_faction.has_flavor(npc, "healing")
        and not IsWounded(npc)

    if not eligible then
        timer:stop()
        if at_debug.is_on() and IsStalker(npc) and npc:alive() and npc.health < cfg.limping_health_threshold then
            _log_decline(npc)
        end
        if not _limping[id] then return end
        _stop_limp(npc, id, "not_eligible", timer:get_us())
        return
    end
    rec = _limping[id]
    if not rec then
        rec = { next_add_ms = 0 }
        _limping[id] = rec
        if at_debug.is_on() then timer:stop() at_debug.debug("[LIMP] gained id=%d hp=%.2f [%dus]", id, npc.health, timer:get_us()) end
    end
    if tg < rec.next_add_ms then return end
    if npc:animation_count() > 0 then return end

    local mt = npc:movement_type()
    local anim_name = _select_limp_anim(npc, mt)
    utils_obj.add_anim(npc, anim_name)
    rec.next_add_ms = tg + LIMP_REARM_MS
    rec.mt = mt
    rec.anchor = npc:position()
    rec.last_pos = nil
    rec.sample_ms = tg
    if at_debug.is_on() then
        timer:stop()
        local slot = npc:active_slot()
        local wpn  = npc:active_item()
        local sect = wpn and wpn:section() or "none"
        at_debug.debug("[LIMP] anim id=%d name=%s slot=%d section=%s hp=%.2f [%dus]",
            id, anim_name, slot, sect, npc.health, timer:get_us())
    end
end

local function _run_monitor()
    if not _monitor_active then return true end
    ResetTimeEvent("at_healing", "monitor", MONITOR_PERIOD_SEC)
    if not cfg.limping_anim_enabled then return end
    local tg = time_global()
    for id, state in pairs(_npc_states) do
        local npc = xobject.get_go(id)
        if npc then _run_limp_check(npc, id, state, tg) end
    end
end

local function _on_roster_spawn(npc, se_obj)
    if not npc or not IsStalker(npc) then return end
    _npc_states[npc:id()] = { eligibility_at = 0 }
    _on_net_spawn(npc, se_obj)
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    _npc_states[id] = nil
    _limping[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _limping[se_obj.id] = nil
    _npc_states[se_obj.id] = nil
end

local function _on_actor_first_update()
    _limping = {}
    at_debug.update_config()
    if not _monitor_active then
        _monitor_active = true
        RemoveTimeEvent("at_healing", "monitor")
        CreateTimeEvent("at_healing", "monitor", MONITOR_PERIOD_SEC, _run_monitor)
    end
    if not _heal_active then return end
    at_debug.info("Healing initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        cfg.heal_rate_multiplier,
        cfg.charge_chance_novice,
        cfg.charge_chance_experienced,
        cfg.charge_chance_veteran,
        cfg.charge_chance_master)
end

function on_game_start()
    RegisterScriptCallback("npc_on_net_spawn",            _on_roster_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          at_debug.update_config)
    RegisterScriptCallback("mcm_option_restore_default", at_debug.update_config)

    _register_heal_patch()
    _register_wounded_trace()
end

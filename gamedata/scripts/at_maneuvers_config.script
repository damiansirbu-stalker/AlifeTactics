--- at_maneuvers_config: the maneuver catalog - array order is priority; at_maneuvers binds the methods

--- Build the catalog rows over the method table and LTX reader at_maneuvers passes in
function get_catalog(fn, read_int)
    return {
        {
            name             = "counterflank",
            toggle           = "maneuver_counterflank",
            vs_actor         = true,
            check_need       = fn.check_actor_close,
            factions         = nil,
            weapons          = nil,
            find_destination = fn.find_counterflank_spot,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on          = "time",
            timeout          = read_int("counterflank_max_ms", 3000),
        },
        {
            name             = "reload_cover",
            toggle           = "maneuver_reload_cover",
            check_need       = fn.check_reloading,
            factions         = nil,
            weapons          = nil,
            find_destination = fn.find_reload_cover,
            update           = fn.apply_state,
            check_end        = fn.check_end_reload_cover,
            fire             = xcombat.READY, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "flee",
            toggle           = "maneuver_flee",
            check_need       = fn.check_hurt,
            factions         = { ecolog = true, csky = true, renegade = true },
            weapons          = nil,
            find_destination = fn.find_flee_base,
            update           = fn.apply_state,
            fire             = xcombat.STOW, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on          = "arrival",
            timeout          = read_int("flee_max_ms", 20000),
        },
        {
            name             = "retreat",
            toggle           = "maneuver_retreat",
            check_need       = fn.check_hurt,
            factions         = { army = true, dolg = true, freedom = true, killer = true, isg = true, stalker = true, bandit = true, greh = true, ecolog = true, csky = true, renegade = true },
            weapons          = nil,
            find_destination = fn.find_retreat_cover,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "kite",
            toggle           = "maneuver_kite",
            check_need       = fn.check_too_close,
            factions         = nil,
            weapons          = nil,
            find_destination = fn.find_kite_lane,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "pickoff",
            toggle           = "maneuver_pickoff",
            need_recheck     = false,
            check_need       = fn.check_stalled,
            factions         = nil,
            weapons          = nil,
            find_destination = fn.find_pickoff_spot,
            update           = fn.apply_state,
            check_end        = fn.check_end_pickoff,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on          = "time",
            timeout          = read_int("pickoff_hold_ms", 8000),
        },
    }
end

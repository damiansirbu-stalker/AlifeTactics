--- at_maneuvers_config: the maneuver catalog - array order is priority; at_maneuvers binds the
--- methods. Also the loader for at_faction_config.ltx, the mod-wide faction policy file.

local string_match, string_gmatch, tonumber, pairs = string.match, string.gmatch, tonumber, pairs

local FACTION_LTX = "alifetactics\\at_faction_config.ltx"

--- The [section] block of at_faction_config.ltx. Any AT system reads its own section through this
--- one loader: the factions whitelist as a set (nil = any faction), chance, and the
--- chance_<faction> sparse overrides (nil chance = every NPC).
function get_faction_policy(sec)
    local map = xltx.section(FACTION_LTX, sec)
    local factions, chance_by
    if map.factions then
        factions = {}
        for faction in string_gmatch(map.factions, "[^%s,]+") do factions[faction] = true end
    end
    for key, val in pairs(map) do
        local faction = string_match(key, "^chance_(.+)$")
        if faction then
            chance_by = chance_by or {}
            chance_by[faction] = tonumber(val)
        end
    end
    return factions, tonumber(map.chance), chance_by
end

--- Per-NPC inclination: a stable id-hash against chance - one NPC either carries the behavior for
--- his whole life or never does (save/load stable, zero state; the prime multiplier decorrelates
--- the consecutive ids squad members spawn with). nil chance = everyone.
function has_inclination(id, chance)
    if not chance then return true end
    return (id * 2654435761) % 100 < chance * 100
end

--- Build the catalog rows over the method table and LTX reader at_maneuvers passes in; each row's
--- faction palette and inclination chances attach from at_faction_config.ltx
function get_catalog(fn, read_int)
    local rows = {
        {
            name             = "counterflank",
            toggle           = "maneuver_counterflank",
            vs_actor         = true,
            check_need       = fn.check_actor_close,
            weapons          = nil,
            find_destination = fn.find_counterflank_spot,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on          = "time",
            timeout          = read_int("counterflank_max_ms", 3000),
        },
        {
            name             = "reload_cover",
            toggle           = "maneuver_reload_cover",
            check_need       = fn.check_reloading,
            weapons          = nil,
            find_destination = fn.find_reload_cover,
            update           = fn.apply_state,
            check_end        = fn.check_end_reload_cover,
            fire             = xcombat.READY, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "flee",
            toggle           = "maneuver_flee",
            check_need       = fn.check_hurt,
            weapons          = nil,
            find_destination = fn.find_flee_base,
            update           = fn.apply_state,
            fire             = xcombat.STOW, posture = xcombat.STAND, movement = xcombat.RUN,
            ends_on          = "arrival",
            timeout          = read_int("flee_max_ms", 20000),
        },
        {
            name             = "retreat",
            toggle           = "maneuver_retreat",
            check_need       = fn.check_hurt,
            weapons          = nil,
            find_destination = fn.find_retreat_cover,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "kite",
            toggle           = "maneuver_kite",
            check_need       = fn.check_too_close,
            weapons          = nil,
            find_destination = fn.find_kite_lane,
            update           = fn.apply_state,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.WALK,
            ends_on          = "arrival",
            timeout          = read_int("maneuver_max_ms", 8000),
        },
        {
            name             = "pickoff",
            toggle           = "maneuver_pickoff",
            need_recheck     = false,
            check_need       = fn.check_stalled,
            weapons          = nil,
            find_destination = fn.find_pickoff_spot,
            update           = fn.apply_state,
            check_end        = fn.check_end_pickoff,
            fire             = xcombat.FIRE, posture = xcombat.STAND, movement = xcombat.STILL,
            ends_on          = "time",
            timeout          = read_int("pickoff_hold_ms", 8000),
        },
    }
    for i = 1, #rows do
        local row = rows[i]
        row.factions, row.chance, row.chance_by = get_faction_policy(row.name)
    end
    return rows
end

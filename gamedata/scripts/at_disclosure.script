--- at_disclosure: the hit-victim turn + squad investigate on suppressed attacks.
--- The victim turns through the engine's own selection: a standing per-NPC hit-redirect lever
--- (set_hit_redirect, PR #636) makes the real "he hit me" term outrank a seen enemy within falloff
--- range - no forged sighting, and fire still requires real line of sight. Squadmates within
--- earshot of a SUPPRESSED hit get a graded investigate stamp (the at_sound idiom): they walk the
--- shooter's position through the danger scheme and escalate to combat only on real perception.
--- An unsuppressed shot seeds nothing - the engine's own gunfire hearing owns it. A killed victim
--- seeds nothing - native death-sound and corpse discovery own it. No relation writes, no memory
--- injection, no squad-wide combat-mask forcing (the force-disclosure eras are retired).

local tostring, IsStalker, IsWeapon, RegisterScriptCallback = tostring, IsStalker, IsWeapon, RegisterScriptCallback
-- CreateTimeEvent / RemoveTimeEvent not cached: demonized_time_events replaces them at runtime;
-- cached locals would pin the dead originals.

local cfg = at_mcm.cfg

-- The standing victim-turn lever (PR #636): the last attacker within TURN_FALLOFF_M outranks a
-- seen enemy by up to TURN_MAX in selection. 900/60 probe-proven (formula-exact selection flip
-- against a fully-visible competitor at ~10m, probe_hit_redirect.log).
local TURN_MAX       = 900
local TURN_FALLOFF_M = 60

-- Squad investigate: members within earshot of the VICTIM hear a suppressed impact and walk the
-- shooter's position at the graded "solid" reaction (at_danger t163). Tune from playtest.
local EARSHOT_SQR       = 15 * 15
local STAMP_INERTION_MS = 15000
local RESTAMP_MS        = 4000

local TIMER_EV = "at_disclosure"

-- _stamp_at: member id -> last stamp time_global (the re-stamp throttle).
local _stamp_at    = {}
local _pending_seq = 0
local _stat        = { hits = 0, loud = 0, stamps = 0, victim_seeds = 0 }

-- Redirect-bind presence, captured from the first lever write (true/false; nil = no write yet).
-- false = floor exe: the on-hit victim seed below carries the turn instead.
local _has_redirect = nil

-- Suppressed-now: an integral silencer (weapon_silencer_status 1) or an attachable one currently
-- mounted (status 2 + weapon_is_silencer, the utils_item.has_attached_silencer shape,
-- utils_item.script:414-420). A shooter without a ranged weapon in hand - a mutant, a knife - is
-- silent by definition. Humans = stalkers and the actor (IsStalker(actor) is false; AC_ID covers it).
local function _shot_is_suppressed(who)
    if not (IsStalker(who) or who:id() == AC_ID) then return true end
    local wpn = who:active_item()
    if not (wpn and IsWeapon(wpn)) then return true end
    local status = wpn:weapon_silencer_status()
    if status == 1 then return true end
    return status == 2 and wpn:weapon_is_silencer()
end

-- Write the standing selection levers for one stalker. The turn lever follows the MCM toggles
-- (off = -1 = vanilla hit step); the actor-bias dial applies independently of disclosure (it is
-- the target-priority fairness dial, npc side stays vanilla). Zombied keep vanilla selection.
local function _apply_selection_levers(npc)
    if not IsStalker(npc) then return end
    if xcreature.is_zombied(npc) then return end
    local turn_on = cfg.disclosure_enabled and cfg.disclosure_turn
    local applied = xcombat.set_hit_redirect(npc, turn_on and TURN_MAX or -1, TURN_FALLOFF_M)
    if _has_redirect == nil then _has_redirect = applied end
    xcombat.set_visible_enemy_bias(npc, cfg.selection_actor_bias, -1)
    if at_debug.on() then
        at_debug.dbg("[LEVER] id=%d redirect=%d bias=%d bind=%s",
            npc:id(), turn_on and TURN_MAX or -1, cfg.selection_actor_bias, tostring(applied))
    end
end

-- Stamp one squadmate with the scripted investigate danger at the shooter's position, when he is
-- alive, not zombied, within earshot of the victim, and past the re-stamp throttle. Returns true
-- when stamped.
local function _stamp_one(member_id, victim_pos, who_id, who_pos, tg)
    local member = xobject.go(member_id)
    if not member then return false end
    if not member:alive() then return false end
    if xcreature.is_zombied(member) then return false end
    if member:position():distance_to_sqr(victim_pos) > EARSHOT_SQR then return false end
    local last = _stamp_at[member_id]
    if last and (tg - last) < RESTAMP_MS then return false end
    _stamp_at[member_id] = tg
    xr_danger.set_script_danger(member, STAMP_INERTION_MS, who_id, who_pos, "solid")
    return true
end

-- Stamp the victim's squadmates within earshot with the scripted investigate danger at the
-- shooter's position. Grade "solid": a buddy-hit is confirmed evidence, so the reaction walks
-- (raid), never runs. A fighting member is untouched by construction - the danger scheme does not
-- run for an NPC with a combat enemy. Returns the stamped count.
local function _stamp_squad(victim, victim_id, who_id, who_pos)
    local squad = xsquad.get_squad_by_member(victim_id)
    if not squad then return 0 end
    if squad:npc_count() == 0 then return 0 end
    local tg = time_global()
    local victim_pos = victim:position()
    local stamped = 0
    for member in squad:squad_members() do
        if member.id ~= victim_id and _stamp_one(member.id, victim_pos, who_id, who_pos, tg) then
            stamped = stamped + 1
        end
    end
    return stamped
end

-- Deferred victim-turn trace, dbg only: read best_enemy ~1s after the admitted hit and log whether
-- selection flipped to the shooter. The redirect's effect is engine-internal, so this line is the
-- only log-readable proof of the turn. -1 = no selected enemy. seen and dist make a false
-- self-explanatory: flipped=false with seen=true = stayed on a SEEN enemy (correct - seen plus the
-- actor pull outweighs the hit term); dist past TURN_FALLOFF_M = the redirect is 0 there (correct).
-- Suspicious only when false with seen=false AND dist inside the falloff.
local function _trace_turn(victim_id, who_id)
    _pending_seq = _pending_seq + 1
    CreateTimeEvent(TIMER_EV, "turn_" .. _pending_seq, 1, function()
        local victim = xobject.go(victim_id)
        if victim and victim:alive() then
            local best = victim:best_enemy()
            local best_id = best and best:id() or -1
            local best_seen = best ~= nil and xcombat.sees(victim, best) or false
            local dist = -1
            local who = xobject.go(who_id)
            if who then dist = victim:position():distance_to(who:position()) end
            at_debug.dbg("[TURN] victim=%d best=%d seen=%s shooter=%d dist=%.0f flipped=%s",
                victim_id, best_id, tostring(best_seen), who_id, dist, tostring(best_id == who_id))
        end
        return true
    end)
end

-- One-frame-deferred hit resolver (survivor semantics): a hit that killed the victim seeds
-- nothing - the engine's death sound and corpse discovery own that case. For a surviving victim:
-- on a floor exe the scripted danger orients him on the KNOWN shooter position (its look order
-- wins - the danger action is the selected action) and combat registration enters him into the
-- fight; on a redirect exe the standing lever already owns the turn. Then the squad investigate.
local function _resolve_hit(victim_id, who_id)
    local victim = xobject.go(victim_id)
    if not victim then return end
    if not victim:alive() then
        if at_debug.on() then at_debug.dbg("[HIT] suppressed-kill seeds nothing victim=%d shooter=%d", victim_id, who_id) end
        return
    end
    local who = xobject.go(who_id)
    if not who then return end
    local who_pos = who:position()

    if _has_redirect == false and cfg.disclosure_turn then
        xr_danger.set_script_danger(victim, STAMP_INERTION_MS, who_id, who_pos, "solid")
        xcombat.register_in_combat(victim)
        _stat.victim_seeds = _stat.victim_seeds + 1
    end

    local stamped = _stamp_squad(victim, victim_id, who_id, who_pos)
    _stat.stamps = _stat.stamps + stamped
    if at_debug.on() then
        at_debug.dbg("[HIT] victim=%d shooter=%d stamped=%d victim_seed=%s",
            victim_id, who_id, stamped, tostring(_has_redirect == false and cfg.disclosure_turn))
        _trace_turn(victim_id, who_id)
    end
end

local function _on_hit(npc, amount, _local_direction, who, bone_index)
    if not cfg.disclosure_enabled then return end
    if bone_index == "from_death_callback" then return end
    if not amount or amount <= 0 then return end
    if not (who and npc) then return end
    if who:id() == npc:id() then return end
    if xcreature.is_zombied(npc) then return end
    if not xcreature.is_enemy(npc, who) then return end

    _stat.hits = _stat.hits + 1
    if not _shot_is_suppressed(who) then
        _stat.loud = _stat.loud + 1
        if at_debug.on() then at_debug.dbg("[HIT] loud shooter=%d - engine hearing owns it", who:id()) end
        return
    end

    _pending_seq = _pending_seq + 1
    local victim_id, shooter_id = npc:id(), who:id()
    CreateTimeEvent(TIMER_EV, "pending_" .. _pending_seq, 0, function()
        _resolve_hit(victim_id, shooter_id)
        return true
    end)
end

local function _on_net_spawn(npc)
    if not npc then return end
    _apply_selection_levers(npc)
end

local function _on_entity_unregister(se_obj)
    if se_obj then _stamp_at[se_obj.id] = nil end
end

local function _on_first_update()
    _stamp_at = {}
    _stat = { hits = 0, loud = 0, stamps = 0, victim_seeds = 0 }
    at_debug.refresh()
    at_debug.info("Disclosure initialized (enabled=%s, turn=%s, actor_bias=%d, dbg=%s)",
        cfg.disclosure_enabled and "true" or "false",
        cfg.disclosure_turn and "true" or "false",
        cfg.selection_actor_bias,
        at_debug.on() and "true" or "false")
end

--- Counters snapshot for diagnostics (at_test.at_dump): admitted hits, loud skips, squad stamps,
--- floor-exe victim seeds, and whether the redirect bind is live.
function get_stats()
    return {
        hits = _stat.hits, loud = _stat.loud, stamps = _stat.stamps,
        victim_seeds = _stat.victim_seeds, has_redirect = _has_redirect,
    }
end

function on_game_start()
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
end

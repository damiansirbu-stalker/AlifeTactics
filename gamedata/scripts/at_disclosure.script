--- at_disclosure: Force-disclose shooter on first faction-enemy hit - to the whole squad, or to the
--- victim himself when squadless (a solo victim otherwise got nothing; the self-disclosure re-enables
--- memory a combat-ignore may have suppressed and registers him in combat).

local pairs, tostring, tonumber, RegisterScriptCallback, IsStalker = pairs, tostring, tonumber, RegisterScriptCallback, IsStalker
-- CreateTimeEvent / ResetTimeEvent / RemoveTimeEvent not cached: demonized_time_events
-- replaces them at runtime; cached locals would pin the dead originals.

local log = xlog.get_logger("AT.DISCLOSURE", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

local TIMER_EV           = "at_disclosure"
local TIMER_DECAY        = "decay"
local DECAY_INTERVAL_SEC = 5

local _disclosed = {}
local _pending_seq = 0

-- xcreature.community returns "monster" for non-stalkers, so mutant-vs-stalker hits
-- pass via is_factions_enemies(<faction>, "monster").
local function _shooter_is_combat_enemy(npc, who)
    local npc_comm = xcreature.community(npc)
    if not npc_comm or npc_comm == "" or npc_comm == "none" then return false end
    local who_comm = xcreature.community(who)
    if not who_comm or who_comm == "" or who_comm == "none" then return false end
    if who_comm == npc_comm then return false end
    return game_relations.is_factions_enemies(npc_comm, who_comm)
end

-- Disclose the shooter to one squad member via xlibs (memory inject + combat register, no relation
-- mutation). The disclosure gate already requires a faction enemy, so the engine engages the shooter
-- without any goodwill write. Returns false on a nil member. The register_in_combat inside disclose_enemy
-- writes the same squad combat-mask bit the Combat takeover graft sets for a different reason (planner-block
-- compensation, xcombat.script register_in_combat) - two leaves, one engine bit; neither is redundant.
local function _disclose_to_member(mem_npc, who)
    return xcombat.disclose_enemy(mem_npc, who)
end

local function _disclose(squad, who)
    if squad:npc_count() == 0 then return 0 end
    local count = 0
    for member in squad:squad_members() do
        if _disclose_to_member(level.object_by_id(member.id), who) then
            count = count + 1
        end
    end
    return count
end

local function _log_disclosure(opts)
    local who      = opts.who
    local wpn_d    = IsStalker(who) and who:active_item() or nil
    local sect_d   = wpn_d and wpn_d:section() or "none"
    local silenc_d = sect_d ~= "none" and (tonumber(ini_sys:r_string_ex(sect_d, "silencer_status")) or -1) or -1
    local victim   = opts.victim
    local dist_d   = victim and victim:position():distance_to(who:position()) or -1
    log.debug("[DISCLOSURE] squad=%d shooter=%d disclosed_to=%d section=%s silenc=%d dist=%.1f [gate=%.2fms disclose=%.2fms total=%.2fms]",
        opts.squad_id, opts.who_id, opts.disclosed_to, sect_d, silenc_d, dist_d,
        opts.gate_ms, opts.disclose_ms, opts.total_ms)
end

local function _collect_expired(map, now, threshold)
    local expired = {}
    for shooter_id, last_hit in pairs(map) do
        if now - last_hit > threshold then
            expired[#expired + 1] = shooter_id
        end
    end
    return expired
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = se_obj.id
    local was_squad = _disclosed[id] ~= nil
    _disclosed[id] = nil
    local affected = {}
    for _, map in pairs(_disclosed) do
        if map[id] then affected[#affected + 1] = map end
    end
    local cleared = #affected
    for i = 1, cleared do affected[i][id] = nil end
    tmr:stop()
    if _dbg and (was_squad or cleared > 0) then
        log.debug("[UNREGISTER] entity=%d was_squad=%s cleared=%d [%.2fms]",
            id, tostring(was_squad), cleared, tmr:get_ms())
    end
end

local function _decay_tick()
    ResetTimeEvent(TIMER_EV, TIMER_DECAY, DECAY_INTERVAL_SEC)
    local now = xtime.game_sec()
    if now == 0 then return end
    local threshold = cfg.disclosure_retention_min * 60
    local tmr = xprofiler.new_if(_dbg):start()
    local pruned = 0
    for _, map in pairs(_disclosed) do
        local expired = _collect_expired(map, now, threshold)
        local count = #expired
        for i = 1, count do map[expired[i]] = nil end
        pruned = pruned + count
    end
    tmr:stop()
    if _dbg and pruned > 0 then
        log.debug("[DECAY] pruned=%d threshold=%.0f [%.2fms]",
            pruned, threshold, tmr:get_ms())
    end
end

-- Disclose to the key's audience: a squad key reaches every member; a solo key (the victim's own id,
-- used when the victim has no squad) reaches the victim alone. Returns the member count reached.
local function _disclose_key(key_id, who, victim)
    local squad = xobject.se(key_id)
    if squad and squad.squad_members then return _disclose(squad, who) end
    return (victim and _disclose_to_member(victim, who)) and 1 or 0
end

-- Survivor gate: one-frame deferred resolver. Re-reads victim alive state; if the hit
-- killed the victim, drops the disclosure. Registration moves into the resolver so
-- a suppressed kill does NOT block a later real disclosure from the same shooter.
local function _resolve_pending(key_id, who_id, victim_id, gate_ms, total_ms)
    local victim = level.object_by_id(victim_id)
    if not victim or not victim:alive() then
        if _dbg then
            log.debug("[HIT] suppressed reason=victim_died key=%d shooter=%d victim=%d [gate=%.2fms total=%.2fms]",
                key_id, who_id, victim_id, gate_ms, total_ms)
        end
        return
    end

    if not _disclosed[key_id] then _disclosed[key_id] = {} end
    local first_hit = _disclosed[key_id][who_id] == nil
    _disclosed[key_id][who_id] = xtime.game_sec()

    if not first_hit then
        if _dbg then
            log.debug("[HIT] key=%d shooter=%d (refreshed deferred) [gate=%.2fms total=%.2fms]",
                key_id, who_id, gate_ms, total_ms)
        end
        return
    end

    local who = level.object_by_id(who_id)
    if not who then return end

    local tmr_disclose = xprofiler.new_if(_dbg):start()
    local disclosed_to = _disclose_key(key_id, who, victim)
    tmr_disclose:stop()

    if _dbg then
        _log_disclosure({
            squad_id = key_id, who_id = who_id, disclosed_to = disclosed_to,
            who = who, victim = victim,
            gate_ms = gate_ms, disclose_ms = tmr_disclose:get_ms(),
            total_ms = total_ms + tmr_disclose:get_ms(),
        })
    end
end

local function _on_hit(npc, amount, _local_direction, who, bone_index)
    if not cfg.disclosure_enabled then return end
    if xcreature.community(npc) == "zombied" then return end
    if bone_index == "from_death_callback" then return end
    if not amount or amount <= 0 then return end
    if not who or not npc then return end
    if who:id() == npc:id() then return end

    local tmr_total = xprofiler.new_if(_dbg):start()

    local tmr_gate = xprofiler.new_if(_dbg):start()
    local is_enemy = _shooter_is_combat_enemy(npc, who)
    tmr_gate:stop()
    if not is_enemy then
        tmr_total:stop()
        if _dbg then
            log.debug("[HIT] rejected reason=not_faction_enemy [gate=%.2fms total=%.2fms]",
                tmr_gate:get_ms(), tmr_total:get_ms())
        end
        return
    end

    -- The idempotency/retention key: the squad id, or the victim's own id when squadless (a solo
    -- victim discloses to himself - squad and NPC server ids share one id space, so no collision).
    local squad  = xsquad.get_squad_by_member(npc:id())
    local key_id = squad and squad.id or npc:id()
    local who_id = who:id()
    local gate_ms = tmr_gate:get_ms()

    if cfg.disclosure_survivor_gate then
        tmr_total:stop()
        _pending_seq = _pending_seq + 1
        local victim_id = npc:id()
        local total_ms = tmr_total:get_ms()
        local seq = _pending_seq
        CreateTimeEvent(TIMER_EV, "pending_" .. seq, 0, function()
            _resolve_pending(key_id, who_id, victim_id, gate_ms, total_ms)
            return true
        end)
        return
    end

    local now = xtime.game_sec()
    if not _disclosed[key_id] then _disclosed[key_id] = {} end
    local first_hit = _disclosed[key_id][who_id] == nil
    _disclosed[key_id][who_id] = now

    if not first_hit then
        tmr_total:stop()
        if _dbg then
            log.debug("[HIT] key=%d shooter=%d (refreshed) [gate=%.2fms total=%.2fms]",
                key_id, who_id, gate_ms, tmr_total:get_ms())
        end
        return
    end

    local tmr_disclose = xprofiler.new_if(_dbg):start()
    local disclosed_to = _disclose_key(key_id, who, npc)
    tmr_disclose:stop()
    tmr_total:stop()

    if _dbg then
        _log_disclosure({
            squad_id = key_id, who_id = who_id, disclosed_to = disclosed_to,
            who = who, victim = npc,
            gate_ms = gate_ms, disclose_ms = tmr_disclose:get_ms(),
            total_ms = tmr_total:get_ms(),
        })
    end
end

local function _inherit_one(npc, shooter_id, npc_id)
    if shooter_id == npc_id then return false end
    local who = level.object_by_id(shooter_id)
    if not who then return false end
    _disclose_to_member(npc, who)
    return true
end

local function _inherit_from_squad(npc, npc_id, squad_id, squad_map)
    local inherited = 0
    for shooter_id in pairs(squad_map) do
        if _inherit_one(npc, shooter_id, npc_id) then
            inherited = inherited + 1
        end
    end
    if _dbg and inherited > 0 then
        log.debug("[INHERIT] npc=%d squad=%d shooters=%d", npc_id, squad_id, inherited)
    end
end

local function _redisclose_member(mem_npc, who, shooter_id)
    if not mem_npc then return false end
    if mem_npc:id() == shooter_id then return false end
    return _disclose_to_member(mem_npc, who)
end

local function _redisclose_squad(squad_id, who, shooter_id)
    local sq = xobject.se(squad_id)
    if not sq or not sq.squad_members then return 0 end
    if sq:npc_count() == 0 then return 0 end
    local count = 0
    for member in sq:squad_members() do
        if _redisclose_member(level.object_by_id(member.id), who, shooter_id) then
            count = count + 1
        end
    end
    return count
end

local function _on_shooter_online(npc, npc_id)
    local total = 0
    for squad_id, map in pairs(_disclosed) do
        if map[npc_id] then
            total = total + _redisclose_squad(squad_id, npc, npc_id)
        end
    end
    if _dbg and total > 0 then
        log.debug("[REDISCLOSE] shooter=%d members=%d", npc_id, total)
    end
end

local function _on_net_spawn(npc)
    if not npc then return end
    local npc_id = npc:id()
    local squad = xsquad.get_squad_by_member(npc_id)
    if squad then
        local squad_map = _disclosed[squad.id]
        if squad_map then _inherit_from_squad(npc, npc_id, squad.id, squad_map) end
    end
    _on_shooter_online(npc, npc_id)
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_first_update()
    _disclosed = {}
    _refresh_log()
    RemoveTimeEvent(TIMER_EV, TIMER_DECAY)
    CreateTimeEvent(TIMER_EV, TIMER_DECAY, DECAY_INTERVAL_SEC, _decay_tick)
    log.info("Hit disclosure initialized (enabled=%s, retention=%dmin, dbg=%s)",
        cfg.disclosure_enabled and "true" or "false",
        cfg.disclosure_retention_min,
        _dbg and "true" or "false")
end

--- Walk every (squad_id, shooter_count) pair
function iterate_disclosed(fn)
    for squad_id, map in pairs(_disclosed) do
        local count = 0
        for _ in pairs(map) do count = count + 1 end
        fn(squad_id, count)
    end
end

function on_game_start()
    RegisterScriptCallback("npc_on_hit_callback",        _on_hit)
    RegisterScriptCallback("npc_on_net_spawn",           _on_net_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)
end

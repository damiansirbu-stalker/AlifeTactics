--- at_disclosure: the hit-victim turn (standing hit-redirect lever) + squad investigate on suppressed attacks

local tostring, IsStalker, IsWeapon, RegisterScriptCallback = tostring, IsStalker, IsWeapon, RegisterScriptCallback

local cfg = at_mcm.cfg

local LTX_PATH    = "alifetactics\\at_disclosure_config.ltx"
local LTX_SECTION = "at_disclosure"

local TIMER_EV = "at_disclosure"

local TURN_MAX
local TURN_FALLOFF_M
local EARSHOT_SQR
local STAMP_INERTION_MS
local RESTAMP_MS

local _stamp_at    = {}
local _pending_seq = 0
local _stat        = { hits = 0, loud = 0, stamps = 0, victim_seeds = 0 }
local _has_redirect = nil

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_num(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    TURN_MAX          = read_num("turn_max", 900)
    TURN_FALLOFF_M    = read_num("turn_falloff_m", 60)
    local earshot_m   = read_num("earshot_m", 15)
    EARSHOT_SQR       = earshot_m * earshot_m
    STAMP_INERTION_MS = read_num("stamp_inertion_ms", 15000)
    RESTAMP_MS        = read_num("restamp_ms", 4000)
end

local function _is_shot_suppressed(who)
    if not (IsStalker(who) or who:id() == AC_ID) then return true end
    local wpn = who:active_item()
    if not (wpn and IsWeapon(wpn)) then return true end
    local status = wpn:weapon_silencer_status()
    if status == 1 then return true end
    return status == 2 and wpn:weapon_is_silencer()
end

local function _apply_selection_levers(npc)
    if not IsStalker(npc) then return end
    if not at_faction.has_flavor(npc, "disclosure") then return end
    local turn_on = cfg.disclosure_enabled and cfg.disclosure_turn
    local applied = xcombat.set_hit_redirect(npc, turn_on and TURN_MAX or -1, TURN_FALLOFF_M)
    if _has_redirect == nil then _has_redirect = applied end
    xcombat.set_visible_enemy_bias(npc, cfg.selection_actor_bias, -1)
    if at_debug.is_on() then
        at_debug.debug("[LEVER] id=%d redirect=%d bias=%d bind=%s",
            npc:id(), turn_on and TURN_MAX or -1, cfg.selection_actor_bias, tostring(applied))
    end
end

local function _try_stamp_member(member_id, victim_pos, who_id, who_pos, tg)
    local member = xobject.get_go(member_id)
    if not member then return false end
    if not member:alive() then return false end
    if not at_faction.has_flavor(member, "disclosure") then return false end
    if member:position():distance_to_sqr(victim_pos) > EARSHOT_SQR then return false end
    local last = _stamp_at[member_id]
    if last and (tg - last) < RESTAMP_MS then return false end
    _stamp_at[member_id] = tg
    xr_danger.set_script_danger(member, STAMP_INERTION_MS, who_id, who_pos, "solid")
    return true
end

local function _apply_squad_stamps(victim, victim_id, who_id, who_pos)
    local squad = xsquad.get_squad_by_member(victim_id)
    if not squad then return 0 end
    if squad:npc_count() == 0 then return 0 end
    local tg = time_global()
    local victim_pos = victim:position()
    local stamped = 0
    for member in squad:squad_members() do
        if member.id ~= victim_id and _try_stamp_member(member.id, victim_pos, who_id, who_pos, tg) then
            stamped = stamped + 1
        end
    end
    return stamped
end

local function _trace_turn(victim_id, who_id)
    _pending_seq = _pending_seq + 1
    CreateTimeEvent(TIMER_EV, "turn_" .. _pending_seq, 1, function()
        local victim = xobject.get_go(victim_id)
        if victim and victim:alive() then
            local best = victim:best_enemy()
            local best_id = best and best:id() or -1
            local best_seen = best ~= nil and xcombat.can_see(victim, best) or false
            local dist = -1
            local who = xobject.get_go(who_id)
            if who then dist = victim:position():distance_to(who:position()) end
            at_debug.debug("[TURN] victim=%d best=%d seen=%s shooter=%d dist=%.0f flipped=%s",
                victim_id, best_id, tostring(best_seen), who_id, dist, tostring(best_id == who_id))
        end
        return true
    end)
end

local function _resolve_hit(victim_id, who_id)
    local victim = xobject.get_go(victim_id)
    if not victim then return end
    if not victim:alive() then
        if at_debug.is_on() then at_debug.debug("[HIT] suppressed-kill seeds nothing victim=%d shooter=%d", victim_id, who_id) end
        return
    end
    local who = xobject.get_go(who_id)
    if not who then return end
    local who_pos = who:position()

    if _has_redirect == false and cfg.disclosure_turn then
        xr_danger.set_script_danger(victim, STAMP_INERTION_MS, who_id, who_pos, "solid")
        xcombat.register_in_combat(victim)
        _stat.victim_seeds = _stat.victim_seeds + 1
    end

    local stamped = _apply_squad_stamps(victim, victim_id, who_id, who_pos)
    _stat.stamps = _stat.stamps + stamped
    if at_debug.is_on() then
        at_debug.debug("[HIT] victim=%d shooter=%d stamped=%d victim_seed=%s",
            victim_id, who_id, stamped, tostring(_has_redirect == false and cfg.disclosure_turn))
        _trace_turn(victim_id, who_id)
    end
end

local function _on_hit(npc, amount, _local_direction, who, bone_index)
    if not cfg.disclosure_enabled then return end
    if bone_index == "from_death_callback" then return end
    if not amount or amount <= 0 then return end
    if not (who and npc) then return end
    if who:id() == npc:id() then return end
    if not at_faction.has_flavor(npc, "disclosure") then return end
    if not xcreature.is_enemy(npc, who) then return end

    _stat.hits = _stat.hits + 1
    if not _is_shot_suppressed(who) then
        _stat.loud = _stat.loud + 1
        if at_debug.is_on() then at_debug.debug("[HIT] loud shooter=%d - engine hearing owns it", who:id()) end
        return
    end

    _pending_seq = _pending_seq + 1
    local victim_id, shooter_id = npc:id(), who:id()
    CreateTimeEvent(TIMER_EV, "pending_" .. _pending_seq, 0, function()
        _resolve_hit(victim_id, shooter_id)
        return true
    end)
end

local function _on_net_spawn(npc)
    if not npc then return end
    _apply_selection_levers(npc)
end

local function _on_entity_unregister(se_obj)
    if se_obj then _stamp_at[se_obj.id] = nil end
end

local function _on_first_update()
    _stamp_at = {}
    _stat = { hits = 0, loud = 0, stamps = 0, victim_seeds = 0 }
    at_debug.update_config()
    at_debug.info("Disclosure initialized (enabled=%s, turn=%s, actor_bias=%d, dbg=%s)",
        cfg.disclosure_enabled and "true" or "false",
        cfg.disclosure_turn and "true" or "false",
        cfg.selection_actor_bias,
        at_debug.is_on() and "true" or "false")
end

--- Counters snapshot for diagnostics (at_test.at_dump).
function get_stats()
    return {
        hits = _stat.hits, loud = _stat.loud, stamps = _stat.stamps,
        victim_seeds = _stat.victim_seeds, has_redirect = _has_redirect,
    }
end

function on_game_start()
    _load_config()
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
end

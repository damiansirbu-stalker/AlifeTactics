--- at_gear: the functional-inventory source - walks what a stalker carries and registers effect providers

local math_max, math_min, tostring = math.max, math.min, tostring
local IsStalker, AC_ID, type = IsStalker, AC_ID, type
local RegisterScriptCallback, ini_file, ini_sys = RegisterScriptCallback, ini_file, ini_sys
local level = level
local xinventory, xcreature, xprofiler = xinventory, xcreature, xprofiler
local at_debug, at_effects_resolver, xcombat = at_debug, at_effects_resolver, xcombat
local EFFECT = at_effects_resolver.EFFECT

local cfg = at_mcm.cfg

local GEAR_LTX = "alifetactics\\at_gear_config.ltx"
local GEAR_SECTION = "at_gear"

local _ARTY_KINDS = { gravi = true, thermal = true, chemical = true, electro = true, special = true }

local _tier_step   = 0.02
local _tier_cap    = 0.10
local _binoc_range = 1.50
local _nvg_range   = 1.50
local _night_start = 22
local _night_end   = 5
local _regen_scale = 0.003

local _kind = {}
local _resolved = {}
local _n039

local function _has_n039(npc)
    if _n039 == nil then _n039 = type(npc.set_health_restore_boost) == "function" end
    return _n039
end

local function _is_night()
    if not level.present() then return false end
    local hours = level.get_time_hours()
    return hours >= _night_start or hours < _night_end
end

local function _get_tier(sec)
    local tier = ini_sys:r_float_ex(sec, "tier") or 1
    if tier < 1 then return 1 end
    return tier
end

local function _get_tier_strength(sec)
    return math_min(_get_tier(sec) * _tier_step, _tier_cap)
end

local _CONTRIBUTE = {
    gravi    = function(acc, sec) acc.resist = math_max(acc.resist, _get_tier_strength(sec)) end,
    chemical = function(acc, sec) acc.chem   = math_max(acc.chem,   _get_tier_strength(sec)) end,
    thermal  = function(acc, sec) acc.disp   = math_max(acc.disp,   _get_tier_strength(sec)) end,
    electro  = function(acc, sec) acc.dealt  = math_max(acc.dealt,  _get_tier_strength(sec)) end,
    special  = function(acc, sec) acc.dealt  = math_max(acc.dealt,  _get_tier_strength(sec)) end,
    plate    = function(acc, sec) acc.plate  = math_max(acc.plate,  _get_tier_strength(sec)) end,
    binoc    = function(acc) acc.binoc = true end,
    nvg      = function(acc) acc.nvg = true end,
}

local function _collect(acc, sec)
    local kind = _kind[sec]
    if not kind then return end
    if _ARTY_KINDS[kind] then acc.aura = true end
    _CONTRIBUTE[kind](acc, sec)
end

local function _trace_resolve(id, record, timer)
    at_debug.dbg("[GEAR] resolve id=%d resist=%.3f plate=%.3f dealt=%.3f disp=%.3f regen=%.5f binoc=%s nvg=%s aura=%s combat=%s [%.3fms]",
        id, record.resist, record.plate, record.dealt, record.disp, record.regen,
        tostring(record.binoc), tostring(record.nvg), tostring(record.aura), tostring(record.combat), timer:get_ms())
end

local function _resolve(id)
    if not cfg.gear_enabled then return false end
    local timer = xprofiler.new_if(at_debug.on()):start()
    local acc = { resist = 0, chem = 0, plate = 0, dealt = 0, disp = 0, binoc = false, nvg = false, aura = false }
    local npc = xinventory.iterate_inventory(id, function(_owner, item)
        _collect(acc, item:section())
    end)
    if not npc then timer:stop() return nil end

    local regen = 0
    if _has_n039(npc) then
        regen = acc.chem * _regen_scale
    else
        acc.resist = math_max(acc.resist, acc.chem)
    end
    local record = {
        resist = acc.resist, plate = acc.plate, dealt = acc.dealt, disp = acc.disp, regen = regen,
        binoc = acc.binoc, nvg = acc.nvg, aura = acc.aura,
        combat = not xcreature.is_zombied(npc),
    }
    _resolved[id] = record
    timer:stop()
    if at_debug.on() then _trace_resolve(id, record, timer) end
    return record
end

local function _carrier_record(npc)
    if not (npc and IsStalker(npc) and npc:id() ~= AC_ID) then return nil end
    local id = npc:id()
    local record = _resolved[id]
    if record ~= nil then return record or nil end
    return _resolve(id) or nil
end

local function _p_dealt(npc)
    if not (cfg.gear_enabled and cfg.gear_dealt_enabled) then return nil end
    local record = _carrier_record(npc)
    if not (record and record.combat and record.dealt > 0) then return nil end
    return 1 + record.dealt
end

local function _p_resist(npc)
    if not (cfg.gear_enabled and cfg.gear_resist_enabled) then return nil end
    local record = _carrier_record(npc)
    if not (record and record.combat) then return nil end
    local strength = math_max(record.plate, record.resist)
    if strength <= 0 then return nil end
    return 1 - strength
end

local function _p_disp(npc)
    if not (cfg.gear_enabled and cfg.gear_disp_enabled) then return nil end
    local record = _carrier_record(npc)
    if not (record and record.combat and record.disp > 0) then return nil end
    return 1 - record.disp
end

local function _p_vision_range(npc)
    if not cfg.gear_enabled then return nil end
    local record = _carrier_record(npc)
    if not (record and record.combat) then return nil end
    if _is_night() then
        if record.nvg and cfg.gear_nvg_enabled then return _nvg_range end
    else
        if record.binoc and cfg.gear_binoc_enabled then return _binoc_range end
    end
    return nil
end

local function _p_aura(npc)
    if not (cfg.gear_enabled and cfg.gear_aura_enabled) then return nil end
    local record = _carrier_record(npc)
    return (record and record.aura) or nil
end

local function _apply_regen(npc)
    if not (npc and _has_n039(npc)) then return end
    if not (cfg.gear_enabled and cfg.gear_regen_enabled) then
        xcombat.set_health_restore_boost(npc, 0)
        return
    end
    local record = _carrier_record(npc)
    local boost = (record and record.combat and record.regen) or 0
    xcombat.set_health_restore_boost(npc, boost)
    if at_debug.on() and boost > 0 then
        at_debug.dbg("[GEAR] regen id=%d boost=%.5f", npc:id(), boost)
    end
end

local function _reresolve(npc)
    local id = npc:id()
    _resolved[id] = nil
    at_effects_resolver.refresh(npc)
    _apply_regen(npc)
end

local function _on_inventory_change(npc, item)
    if not (cfg.gear_enabled and npc and IsStalker(npc)) then return end
    local sect = item and item:section()
    if sect and not _kind[sect] then return end
    if _resolved[npc:id()] == nil then return end
    _reresolve(npc)
end

local function _on_net_spawn(npc, _se_obj)
    if npc then _apply_regen(npc) end
end

local function _on_entity_unregister(se_obj)
    if se_obj then _resolved[se_obj.id] = nil end
end

local function _load_config()
    local ini = ini_file(GEAR_LTX)
    if not (ini and ini:section_exist(GEAR_SECTION)) then return end
    _tier_step   = ini:r_float_ex(GEAR_SECTION, "tier_step")   or _tier_step
    _tier_cap    = ini:r_float_ex(GEAR_SECTION, "tier_cap")    or _tier_cap
    _binoc_range = ini:r_float_ex(GEAR_SECTION, "binoc_range") or _binoc_range
    _nvg_range   = ini:r_float_ex(GEAR_SECTION, "nvg_range")   or _nvg_range
    _night_start = ini:r_float_ex(GEAR_SECTION, "night_start_h") or _night_start
    _night_end   = ini:r_float_ex(GEAR_SECTION, "night_end_h")   or _night_end
    _regen_scale = ini:r_float_ex(GEAR_SECTION, "regen_scale") or _regen_scale
    local groups = { "gravi", "thermal", "chemical", "electro", "special", "plate", "binoc", "nvg" }
    for i = 1, #groups do
        local kind = groups[i]
        local list = ini:r_string_ex(GEAR_SECTION, kind)
        if list then
            for sec in list:gmatch("[^%s,]+") do _kind[sec] = kind end
        end
    end
end

local function _on_first_update()
    local function s(b) return b and "on" or "off" end
    at_debug.info("Gear source initialized (enabled=%s resist=%s dealt=%s disp=%s regen=%s aura=%s binoc=%s nvg=%s regen_bind=%s)",
        s(cfg.gear_enabled), s(cfg.gear_resist_enabled), s(cfg.gear_dealt_enabled),
        s(cfg.gear_disp_enabled), s(cfg.gear_regen_enabled), s(cfg.gear_aura_enabled),
        s(cfg.gear_binoc_enabled), s(cfg.gear_nvg_enabled), _n039 and "on" or "off/unprobed")
end

--- Re-resolve one NPC's gear now, for a caller that granted items with no take event
function refresh(npc)
    if not (cfg.gear_enabled and npc and IsStalker(npc)) then return end
    _reresolve(npc)
end

function on_game_start()
    _resolved = {}
    _load_config()
    at_effects_resolver.register(EFFECT.DAMAGE_DEALT,    _p_dealt)
    at_effects_resolver.register(EFFECT.DAMAGE_RESIST,   _p_resist)
    at_effects_resolver.register(EFFECT.SHOT_DISPERSION, _p_disp)
    at_effects_resolver.register(EFFECT.VISION_RANGE,    _p_vision_range)
    at_effects_resolver.register(EFFECT.AURA,            _p_aura)
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_item_take",            _on_inventory_change)
    RegisterScriptCallback("npc_on_item_drop",            _on_inventory_change)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
end

--- at_conduct: the Conduct habits (Combat > Conduct) - cover posture and weapon spacing on vanilla-driven NPCs

local RegisterScriptCallback = RegisterScriptCallback
local tostring, time_global, math_random = tostring, time_global, math.random
local math_floor, string_gmatch = math.floor, string.gmatch

local cfg = at_mcm.cfg

local LTX_PATH    = "alifetactics\\at_conduct_config.ltx"
local LTX_SECTION = "at_conduct"

local LONG_KINDS
local POSTURE_TIERS
local DECIDE_MS
local CONDUCT_FLOOR_M
local CROUCH_CHANCE
local SPACING_MAX_K
local SPACING_SNIPER_MIN_K
local SPACING_TTL_MS
local SPACING_FLUSH_MS = 5000

local SPACING_KINDS = { "w_pistol", "w_shotgun", "w_rifle", "w_smg", "w_sniper" }
local SPACING_RANKS = { "novice", "trainee", "experienced", "professional",
                        "veteran", "expert", "master", "legend" }

local _decision = {}
local _eligible = {}
local _spacing = {}
local _push_max = {}
local _pull = {}
local _spacing_counter = { calls = 0, us = 0, last = 0 }
local _spacing_active = false

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    local function read_float(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    local function read_set(k, d)
        local raw = ini:r_string_ex(LTX_SECTION, k)
        if not raw then return d end
        local set = {}
        for word in string_gmatch(raw, "[%w_]+") do set[word] = true end
        return set
    end
    DECIDE_MS       = read_int("decide_ms", 3000)
    CONDUCT_FLOOR_M = read_int("conduct_floor_m", 20)
    CROUCH_CHANCE   = read_float("crouch_chance", 0.30)
    SPACING_TTL_MS  = read_int("spacing_ttl_ms", 5000)
    LONG_KINDS      = read_set("posture_kinds", { w_rifle = true, w_sniper = true })
    POSTURE_TIERS   = read_set("posture_tiers", { experienced = true, professional = true,
                                                  veteran = true, expert = true, master = true, legend = true })
    SPACING_MAX_K = { w_smg = 0.6 }
    for i = 1, #SPACING_KINDS do
        local v = ini:r_float_ex(LTX_SECTION, "spacing_max_k_" .. SPACING_KINDS[i])
        if v then SPACING_MAX_K[SPACING_KINDS[i]] = v end
    end
    SPACING_SNIPER_MIN_K = { novice = 1.0, trainee = 1.0, experienced = 1.15, professional = 1.15,
                             veteran = 1.3, expert = 1.3, master = 1.5, legend = 1.5 }
    for i = 1, #SPACING_RANKS do
        local v = ini:r_float_ex(LTX_SECTION, "spacing_sniper_min_k_" .. SPACING_RANKS[i])
        if v then SPACING_SNIPER_MIN_K[SPACING_RANKS[i]] = v end
    end
end

--- True while this NPC's held posture decision is crouch (HUD read).
function is_crouched(id)
    local dec = _decision[id]
    return dec ~= nil and dec.want == move.crouch
end

local _stationary_ops
local function _ops()
    if not _stationary_ops then
        _stationary_ops = {
            [stalker_ids.action_hold_position] = true,
        }
    end
    return _stationary_ops
end

--- Decide posture by the crouch-eye shot ray: crouch only when the crouched line to the enemy is clear.
local function _decide(npc, enemy)
    local np, ep = npc:position(), enemy:position()
    if np:distance_to_sqr(ep) < CONDUCT_FLOOR_M * CONDUCT_FLOOR_M then return move.stand, false end
    if xcombat.has_obstacle_to_target(np, ep, xcombat.BODY_Y.CROUCH_EYE) then return move.stand, false end
    return move.crouch, true
end

--- Tier and the crouch-disposition roll, cached once per NPC life.
local function _is_eligible(npc, id)
    local ok = _eligible[id]
    if ok == nil then
        ok = POSTURE_TIERS[ranks.get_obj_rank_name(npc) or ""] == true
            and math_random() < CROUCH_CHANCE
        _eligible[id] = ok
    end
    return ok
end

--- Answer one engine body-state ask with the held posture, re-deciding at most once per DECIDE_MS.
local function _on_combat_body_state(npc, world_operator, _body_state, flags)
    if not cfg.conduct_posture then return end
    if not _ops()[world_operator] then return end
    local id = npc:id()
    local zombied = xcreature.is_zombied(npc)
    if not zombied then
        local kind = xcombat.get_weapon_kind(npc)
        if not (kind and LONG_KINDS[kind]) then return end
        if not _is_eligible(npc, id) then return end
    end
    local enemy = xcombat.get_best_enemy(npc)
    if not (enemy and enemy:alive()) then return end
    local tg = time_global()
    local held = _decision[id]
    local busy, busy_why = xcombat.is_body_busy(npc)
    if busy then
        if at_debug.on() then
            at_debug.dbg("[CONDUCT] id=%d freeze=%s held=%s", id, tostring(busy_why),
                held and (held.want == move.crouch and "crouch" or "stand") or "none")
        end
        if held then flags.body_state = held.want end
        return
    end
    if not (held and (tg - held.at) < DECIDE_MS) then
        local prev_want = held and held.want
        local want, crouch_clear
        if zombied then
            want, crouch_clear = move.stand, false
        else
            want, crouch_clear = _decide(npc, enemy)
        end
        held = { at = tg, op = world_operator, want = want }
        _decision[id] = held
        if at_debug.on() and want ~= prev_want then
            at_debug.dbg("[CONDUCT] id=%d op=%s zombied=%s crouch_shot=%s -> %s", id,
                tostring(world_operator), tostring(zombied), tostring(crouch_clear),
                want == move.crouch and "crouch" or "stand")
        end
    end
    flags.body_state = held.want
end

--- Cap this NPC's accepted cover-to-enemy maximum at max_m; clearing the overlay restores the band.
function set_push_max(id, max_m)
    _push_max[id] = max_m
end

--- Clear the push cap overlay.
function clear_push_max(id)
    _push_max[id] = nil
end

--- Raise this NPC's accepted cover-to-enemy minimum to min_m, flooring the maximum at max_floor_m.
function set_pull_band(id, min_m, max_floor_m)
    _pull[id] = { min = min_m, max_floor = max_floor_m }
end

--- Clear the pull band overlay.
function clear_pull_band(id)
    _pull[id] = nil
end

--- The spacing disposition row (kind + tier scale factors), lazily derived and TTL-cached.
local function _get_spacing_row(npc, id, tg)
    local row = _spacing[id]
    if row and (tg - row.at) < SPACING_TTL_MS then return row end
    local kind = not (xcreature.is_zombied(npc)) and xcombat.get_weapon_kind(npc) or nil
    if not kind then
        row = { at = tg, skip = true }
    else
        local min_k = kind == "w_sniper"
            and SPACING_SNIPER_MIN_K[ranks.get_obj_rank_name(npc) or ""] or nil
        if min_k == 1.0 then min_k = nil end
        row = { at = tg, min_k = min_k, max_k = SPACING_MAX_K[kind] }
        if at_debug.on() and (row.min_k or row.max_k) then
            at_debug.dbg("[SPACING] band id=%d kind=%s min_k=%s max_k=%s",
                id, kind, tostring(row.min_k), tostring(row.max_k))
        end
    end
    _spacing[id] = row
    return row
end

local function _record_spacing(us, tg)
    if _spacing_counter.last == 0 then _spacing_counter.last = tg end
    _spacing_counter.calls = _spacing_counter.calls + 1
    _spacing_counter.us = _spacing_counter.us + us
    if tg - _spacing_counter.last < SPACING_FLUSH_MS then return end
    at_debug.dbg("[SPACING] window=%.0fs calls=%d rate=%.1f/s handler_avg=%.1fus",
        (tg - _spacing_counter.last) / 1000, _spacing_counter.calls,
        _spacing_counter.calls / ((tg - _spacing_counter.last) / 1000),
        _spacing_counter.us / _spacing_counter.calls)
    _spacing_counter.calls, _spacing_counter.us, _spacing_counter.last = 0, 0, tg
end

local function _on_min_dist(npc, base, flags)
    if not npc then return end
    local timer = xprofiler.new_if(at_debug.on()):start()
    local tg = time_global()
    local id = npc:id()
    local row = cfg.conduct_spacing and _get_spacing_row(npc, id, tg) or nil
    local raised = (row and row.min_k) and base * row.min_k or base
    local pull = _pull[id]
    if pull and pull.min > raised then raised = pull.min end
    if raised ~= base then
        flags.ret_value = raised
        if row and at_debug.on() then row.eff_min = raised end
    end
    timer:stop()
    if at_debug.on() then _record_spacing(timer:get_us(), tg) end
end

local function _on_max_dist(npc, base, flags)
    if not npc then return end
    local timer = xprofiler.new_if(at_debug.on()):start()
    local tg = time_global()
    local id = npc:id()
    local row = cfg.conduct_spacing and _get_spacing_row(npc, id, tg) or nil
    local capped = (row and row.max_k) and base * row.max_k or base
    local push_cap = _push_max[id]
    if push_cap and push_cap < capped then capped = push_cap end
    local pull = _pull[id]
    if pull and pull.max_floor > capped then capped = pull.max_floor end
    if capped ~= base then
        flags.ret_value = capped
        if row and at_debug.on() then row.eff_max = capped end
    end
    timer:stop()
    if at_debug.on() then _record_spacing(timer:get_us(), tg) end
end

--- The output proof: on every actual cover change, log the pick's enemy distance beside the answered band.
local function _on_cover_changed(npc, cover_pos)
    if not at_debug.on() or not (npc and cover_pos) then return end
    local id = npc:id()
    local row = _spacing[id]
    if not (row and (row.eff_min or row.eff_max)) and not _push_max[id] and not _pull[id] then return end
    local enemy = npc:best_enemy()
    if not enemy then return end
    local pull = _pull[id]
    at_debug.dbg("[SPACING] pick id=%d cover_to_enemy=%.1fm min=%s max=%s push=%s pull=%s",
        id, cover_pos:distance_to(enemy:position()),
        tostring(row and row.eff_min), tostring(row and row.eff_max), tostring(_push_max[id]),
        tostring(pull and pull.min))
end

local function _on_entity_unregister(se_obj)
    if se_obj then
        _decision[se_obj.id] = nil
        _eligible[se_obj.id] = nil
        _spacing[se_obj.id] = nil
        _push_max[se_obj.id] = nil
        _pull[se_obj.id] = nil
    end
end

--- True when the combat-distance handlers are live on this exe.
function is_spacing_active()
    return _spacing_active
end

local function _on_first_update()
    at_debug.refresh()
    at_debug.info("Conduct initialized (posture=%s spacing=%s)",
        tostring(cfg.conduct_posture), _spacing_active and tostring(cfg.conduct_spacing) or "INACTIVE")
    if not _spacing_active then
        at_debug.info("Weapon spacing INACTIVE: exe lacks the combat-distance asks (#563); engine bands apply")
    end
end

function on_game_start()
    _load_config()
    RegisterScriptCallback("npc_on_combat_set_body_state", _on_combat_body_state)
    RegisterScriptCallback("server_entity_on_unregister",  _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",        _on_first_update)
    _spacing_active = xcombat.on_get_min_combat_dist(_on_min_dist)
        and xcombat.on_get_max_combat_dist(_on_max_dist)
    RegisterScriptCallback("npc_on_best_cover_changed", _on_cover_changed)
end

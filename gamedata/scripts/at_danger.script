-- @override
--- at_danger: AlifeTactics danger scheme, installed as a function-level patch.

local _evaid = 188113
local _actid = 188113
local math_random, tonumber = math.random, tonumber
local time_global = time_global
local IsStalker, IsMonster, IsWounded = IsStalker, IsMonster, IsWounded

local _enabled = { hit_bypass = true, attack_sound = true, actor_tables = true, neutral_gunfire = true }
local _actor_tables_live = false

local NEUTRAL_GUNFIRE_RADIUS_SQR = 30 * 30

local ini = ini_file("ai_tweaks\\xr_danger.ltx")
DangerInertion = utils_data.collect_section(ini,"danger_inertion",true)
DangerIgnore = utils_data.collect_section(ini,"danger_object",true)
DangerInertionActor = utils_data.collect_section(ini,"danger_inertion_actor",true)
DangerIgnoreActor = utils_data.collect_section(ini,"danger_object_actor",true)
ini = nil

local CORPSE_STALE_SEC = 12000
local EVAL_BUDGET = 200
local FAR_DIST_M = 150
local GRENADE_CHANCE_PCT = 33

local _condlist_cache = {}
local function _parse_cached(npc, bd_name, key, src)
	if src == nil then return nil end
	local parsed = _condlist_cache[src]
	if parsed == nil then
		parsed = xr_logic.parse_condlist(npc, bd_name, key, src)
		_condlist_cache[src] = parsed or false
	end
	return parsed or nil
end

local script_danger = {}
local bd_types = {
	[danger_object.bullet_ricochet] = "bullet_ricochet",
	[danger_object.attack_sound]    = "attack_sound",
	[danger_object.entity_attacked] = "entity_attacked",
	[danger_object.entity_death]    = "entity_death",
	[danger_object.entity_corpse]   = "entity_corpse",
	[danger_object.attacked]        = "attacked",
	[danger_object.grenade]         = "grenade",
	[danger_object.enemy_sound]     = "enemy_sound",
}

-- Public name for a danger enum value, for the at_world_trace [DANGER-HELD] readout.
function get_type_name(danger_type)
	return bd_types[danger_type] or tostring(danger_type)
end

--- Stamp a scripted danger on npc at pos for `time` ms; optional strength = the reaction grade (faint/solid)
function set_script_danger(npc,time,who_id,pos,strength)
	if not who_id then
		return
	end
	local id = npc:id()
	if not (script_danger[id]) then
		script_danger[id] = {danger_time = time_global(), danger_inertion = time, id = who_id, position = pos, strength = strength}
	else
		script_danger[id].danger_time = time_global()
		script_danger[id].danger_inertion = time
		script_danger[id].id = who_id
		script_danger[id].position = pos
		script_danger[id].strength = strength
	end
end

--- True while the danger scheme's evaluator holds for npc
function has_danger(npc)
	local id = npc:id()
	local st = db.storage[id]
	return st and st.danger_flag == true
end
function get_danger_time(danger,npc)
	if (danger:type() == danger_object.entity_corpse) then
		local corpse_object = danger:object()
		if corpse_object and not IsStalker(corpse_object) then
			if at_debug.on() then at_debug.dbg("mutant corpse death_time skipped section=%s", corpse_object:section()) end
			return 0
		end
		return corpse_object and corpse_object:death_time() or 0
	end

	return danger:time()
end

local function danger_in_radius(npc,best_danger,bd_type)
	local bd_name = bd_types[bd_type]
	local bdo = best_danger:object()
	local from_actor = _actor_tables_live and _enabled.actor_tables
		and bdo and bdo:id() == AC_ID
	local src = (from_actor and DangerIgnoreActor[bd_name]) or DangerIgnore[bd_name]
	local condlist = _parse_cached(npc, bd_name, "danger_object", src)
	local ignore_distance = condlist and tonumber(xr_logic.pick_section_from_condlist(db.actor,npc,condlist)) or 0

	if (ignore_distance == 0) then
		return false
	end

	if (best_danger:position():distance_to_sqr(npc:position()) < ignore_distance) then
		return true
	end

	return false
end

local function is_danger(npc,best_danger,script)
	if xr_wounded.is_heavy_wounded_by_id(npc:id()) then
		return false
	end

	if (xrs_kill_wounded and axr_task_manager.hostages_by_id[npc:id()]) then
		return false
	end

	local best_danger_object = best_danger:object()
	local bd_type = best_danger:type()

	if (bd_type == danger_object.grenade) then
		if not (best_danger:dependent_object() and not xcreature.is_zombied(npc)) then
			return false
		end

		return danger_in_radius(npc,best_danger,bd_type)
	end

	if (xr_combat_ignore.npc_in_safe_zone(npc)) then
		return false
	end

	if (bd_type == danger_object.entity_corpse) then
		if (best_danger_object and IsStalker(best_danger_object) and xcreature.community(best_danger_object) == xcreature.community(npc)) then
			local corpse_st = db.storage[best_danger_object:id()]
			if not (corpse_st and corpse_st.death_time and corpse_st.death_by_id) then
				return false
			end

			local killer = db.storage[corpse_st.death_by_id] and db.storage[corpse_st.death_by_id].object
			if not (killer and (IsMonster(killer) or IsStalker(killer)) and killer:alive() and npc:relation(killer) > 0 and xcreature.community(killer) ~= xcreature.community(npc)) then
				return false
			end

			if (xr_combat_ignore.ignore_enemy_by_overrides(npc,killer)) then
				return false
			end

			if (game.get_game_time():diffSec(corpse_st.death_time) > CORPSE_STALE_SEC) then
				return false
			end

			return danger_in_radius(npc,best_danger,bd_type)
		end
		return false
	end

	if (best_danger:dependent_object()) then
		best_danger_object = best_danger:dependent_object()
	end

	if _enabled.neutral_gunfire and (bd_type == danger_object.attack_sound)
		and best_danger_object and best_danger_object:id() == AC_ID
		and npc:relation(db.actor) < game_object.enemy then
		return (best_danger:position():distance_to_sqr(npc:position()) <= NEUTRAL_GUNFIRE_RADIUS_SQR)
	end

	if _enabled.hit_bypass and best_danger_object and (best_danger:perceive_type() == danger_object.hit)
		and not xr_combat_ignore.ignore_enemy_by_overrides(npc, best_danger_object) then
		if at_debug.on() then at_debug.dbg("hit-type bypass npc=%s src=%s", npc:name(), best_danger_object:name()) end
		return true
	end

	if not (best_danger_object and (IsMonster(best_danger_object) or IsStalker(best_danger_object)) and npc:relation(best_danger_object) >= 2) then
		return false
	end

	if (xr_corpse_detection.is_under_corpse_detection(npc) or xr_help_wounded.is_under_help_wounded(npc)) then
		return false
	elseif (xrs_kill_wounded and xrs_kill_wounded.is_under_kill_wounded(npc)) then
		return false
	end

	if not (best_danger_object:alive() and xr_combat_ignore.is_enemy(npc, best_danger_object,true)) then
		return false
	end

	return danger_in_radius(npc,best_danger,bd_type)
end

local function check_script_danger(id)
	if (script_danger[id]) then
		if (time_global() < script_danger[id].danger_time + script_danger[id].danger_inertion) then
			return true
		else
			script_danger[id] = nil
		end
	end
	return false
end

class "at_evaluator_danger" (property_evaluator)
function at_evaluator_danger:__init(name, storage, npc) super (nil, name)
	self.a = storage
end

local SLOW_EVAL_US = 2000

local function eval_danger(self)
	local npc = self.object
	if not npc then
		if at_debug.on() then at_debug.dbg("eval_danger called with nil self.object") end
		return false
	end

	local danger = npc:best_danger()

	local flags = {ret_value = true}
	SendScriptCallback("npc_on_eval_danger", npc, flags)
	if flags.ret_value == false then return false end

	if check_script_danger(npc:id()) then
		return true
	end

	if not (danger) then
		return false
	end

	local tg = time_global()
	local bd_type = danger:type()
	local bd_name = bd_types[bd_type]
	local cur_danger_time = get_danger_time(danger, npc)
	if type(cur_danger_time) ~= "number" then cur_danger_time = 0 end

	local a = self.a
	if (type(a.inertion) == "number" and type(a.danger_time) == "number") then
		if (a.type ~= bd_type and cur_danger_time > a.danger_time) then

		else
			if (tg < a.danger_time + a.inertion) then
				return true
			elseif (cur_danger_time <= a.danger_time) then
				return false
			end
		end
	end

	local danger_obj = danger:object()
	local from_actor = _enabled.actor_tables and danger_obj and danger_obj:id() == AC_ID
	local src = (from_actor and DangerInertionActor[bd_name]) or DangerInertion[bd_name]
	local inertion = tonumber(xr_logic.pick_section_from_condlist(db.actor, npc, _parse_cached(npc, bd_name, "danger_inertion_time", src))) or 0
	local danger_time = cur_danger_time

	if not danger_time or type(danger_time) ~= "number" then
		if at_debug.on() then at_debug.dbg("non-numeric danger_time caught npc=%s bd_type=%s value=%s", npc:name(), bd_name, tostring(danger_time)) end
		return false
	end

	if (tg >= danger_time + inertion) then
		return false
	end

	local is_dangerous = is_danger(npc, danger)
	if not is_dangerous then
		return false
	end

	self.a.danger_time = danger_time
	self.a.inertion = inertion
	self.a.type = bd_type

	return true
end

local collectgarbage = collectgarbage
local _eval_n, _eval_sum_us, _eval_max_us, _eval_heap_kb = 0, 0, 0, 0

function at_evaluator_danger:evaluate()
	local npc = self.object
	if not npc then return false end
	local timer = xprofiler.new_if(at_debug.on()):start()
	local danger = eval_danger(self) or false
	local st = db.storage[npc:id()]
	if st then st.danger_flag = danger end
	timer:stop()
	if at_debug.on() then
		local us = timer:get_us()
		_eval_n = _eval_n + 1
		_eval_sum_us = _eval_sum_us + us
		if us > _eval_max_us then _eval_max_us = us end
		if us > SLOW_EVAL_US then
			at_debug.dbg("[PERF] eval_danger SLOW us=%d heap=%dKB", us, collectgarbage("count"))
		end
		if _eval_n >= EVAL_BUDGET then
			local heap_kb = collectgarbage("count")
			at_debug.dbg("[PERF] eval_danger n=%d avg=%dus max=%dus heap=%dKB (%+dKB)",
				_eval_n, _eval_sum_us / _eval_n, _eval_max_us, heap_kb, heap_kb - _eval_heap_kb)
			_eval_n, _eval_sum_us, _eval_max_us, _eval_heap_kb = 0, 0, 0, heap_kb
		end
	end
	return danger
end

class "at_action_danger" ( action_base )
function at_action_danger:__init( name, storage )  super ( nil, name )
	self.a = storage
end
function at_action_danger:initialize()
	action_base.initialize( self )
	self.a.stage = 1
	self.object:set_path_type(game_object.level_path)
	self.object:set_detail_path_type(move.line)
	self.object:set_desired_direction()
	self.a.last_state = state_mgr.get_state(self.object)
end

local function script_action_danger_scripted(npc,st)
	local id = npc:id()
	local bdo = script_danger[id].id and db.storage[script_danger[id].id] and db.storage[script_danger[id].id].object

	local bdo_pos = script_danger[id].position
	local dist = bdo_pos and npc:position():distance_to_sqr(bdo_pos)
	local tg = time_global()

	local who_dist = bdo and bdo:position():distance_to_sqr(bdo_pos)

	local strength = script_danger[id].strength
	if at_debug.on() then at_debug.dbg("scripted danger reaction npc=%s strength=%s", npc:name(), tostring(strength)) end
	if (strength == "faint") then
		state_mgr.set_state(npc,"threat_na",nil,nil,{look_position = bdo_pos},{fast_set = true})
		return
	end
	local move_state = strength == "solid" and "raid" or "assault"

	if (st.stage == 1) then
		local new_vid = random_choice(utils_obj.try_to_strafe(npc),utils_obj.try_go_backward(npc,6),utils_obj.try_go_cover(npc,bdo and bdo:position() or bdo_pos or npc:position()))

		st.lvid = nil

		if (new_vid and (not st.lvid or (new_vid ~= st.lvid and new_vid ~= npc:level_vertex_id())))then
			st.lvid = new_vid
		end

		if not (new_vid) then
			local dir = bdo_pos and vector():set(npc:position()):sub(bdo_pos) or npc:direction()
			dir = vector_rotate_y(dir,math_random(-20,20))

			local node = at_position_node(5)
			node = node:select_best_vertex_id(npc,dir,npc:level_vertex_id(),20,35)

			if (node and node.vertex_id and node.vertex_id ~= npc:level_vertex_id()) then
				st.lvid = node.vertex_id
			end
		end

		if (st.lvid and st.lvid ~= npc:level_vertex_id()) then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
			st.stage = 2

			local sm = db.storage[npc:id()].state_mgr
			if (sm and sm.target_state ~= move_state) then
				npc:clear_animations()
				sm:set_state(move_state,nil,nil,{look_position = who_dist and who_dist < 22500 and bdo and bdo:position() or bdo_pos}, {fast_set = true})
				sm.animation:set_state(nil, true)
				sm.animation:set_control()
				sm.animstate:set_state(nil, true)
				sm.animstate:set_control()
			end

			return
		end

		state_mgr.set_state(npc,"hide_na",nil,nil,{look_position = who_dist and who_dist < 22500 and bdo and bdo:position() or bdo_pos},{fast_set = true})
	elseif (st.stage == 2) then
		if (npc:level_vertex_id() == st.lvid) then
			local tg = time_global()
			st.__dtimer = not st.__dtimer and tg + math_random(5000,15000) or st.__dtimer
			if (tg > st.__dtimer) then
				st.stage = 1
				return
			end
			state_mgr.set_state(npc,"threat_danger",nil,nil,{look_position = who_dist and who_dist < 22500 and bdo and bdo:position() or bdo_pos},{fast_set = true})
			return
		end
		state_mgr.set_state(npc,move_state,nil,nil,{look_position = who_dist and who_dist < 22500 and bdo and bdo:position() or bdo_pos},{fast_set = true})
		utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
	end
end

local function script_action_danger_grenade(npc,st,bd,best_danger_object,dependent_object,bd_type)
	local bdo = dependent_object or best_danger_object

	local bdo_pos = bdo and bdo:position()
	local dist = bdo_pos and npc:position():distance_to_sqr(bdo_pos)

	local be = npc:best_enemy() or best_danger_object and npc:relation(best_danger_object) > 0 and best_danger_object

	local tg = time_global()

	if (dist and dist >= FAR_DIST_M) then
		
		local sm = db.storage[npc:id()].state_mgr
		if (sm and sm.target_state ~= "threat_danger") then
			npc:clear_animations()
			sm:set_state("threat_danger",nil,nil,{look_position = bdo_pos}, {fast_set = true})
			sm.animation:set_state(nil, true)
			sm.animation:set_control()
			sm.animstate:set_state(nil, true)
			sm.animstate:set_control()
		end
		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,npc:level_vertex_id())
		return
	end

	if (st.stage == 1) then
		local dir = bdo_pos and vector():set(npc:position()):sub(bdo_pos) or npc:direction()
		dir = vector_rotate_y(dir,math_random(-20,20))

		local new_vid = npc:vertex_in_direction(npc:level_vertex_id(),dir,math_random(20,35))
		st.lvid = nil

		if (new_vid and (not st.lvid or (new_vid ~= st.lvid and new_vid ~= npc:level_vertex_id())))then
			st.lvid = new_vid
		end

		if not (new_vid) then
			local node = at_position_node(5)
			node = node:select_best_vertex_id(npc,dir,npc:level_vertex_id(),20,35)

			if (node and node.vertex_id and node.vertex_id ~= npc:level_vertex_id()) then
				st.lvid = node.vertex_id
			end
		end

		if (st.lvid and st.lvid ~= npc:level_vertex_id()) then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
			st.stage = 2

			local sm = db.storage[npc:id()].state_mgr
			if (sm) then
				npc:clear_animations()
				sm:set_state("assault",nil,nil,{look_object = dist <= 100 and nil or bdo}, {fast_set = true})
				sm.animation:set_state(nil, true)
				sm.animation:set_control()
				sm.animstate:set_state(nil, true)
				sm.animstate:set_control()
			end

			return
		end

		state_mgr.set_state(npc,"hide_na",nil,nil,{look_object = be and npc:see(be) and be or bdo},{fast_set = true})
	elseif (st.stage == 2) then
		if (npc:level_vertex_id() == st.lvid) then
			st.stage = 1
			return
		end
		state_mgr.set_state(npc,"assault",nil,nil,{look_object = dist <= 100 and nil or bdo},{fast_set = true})
		utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
	end
end

local function script_action_danger_corpse(npc,st,bd,best_danger_object,dependent_object,bd_type)
	local bdo = best_danger_object or dependent_object
	if not bdo then return end

	local dst = db.storage[bdo:id()]
	local killer = dependent_object or dst and dst.death_by_id and (db.storage[dst.death_by_id] and db.storage[dst.death_by_id].object or level.object_by_id(dst.death_by_id))

	if ((st.stage or 0) >= 4 and killer and killer:id() == AC_ID and killer:alive() and npc:relation(killer) < game_object.enemy and npc:see(killer)) then
		local squad = xsquad.get_squad_by_member(npc:id())
		if (squad) then
			for k in squad:squad_members() do
				local member = db.storage[k.id] and db.storage[k.id].object or level.object_by_id(k.id)
				if (member) then
					member:force_set_goodwill( -1000, killer)
				end
			end
		else
			npc:force_set_goodwill( -1000, killer)
		end
	end

	if (st.stage == 1) then
		st.lvid = bdo:level_vertex_id()
		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)

		state_mgr.set_state(npc,"assault",nil,nil,{look_object = bdo},{fast_set = true})
		st.rnd = math_random(30)

		st.stage = 2
	elseif (st.stage == 2) then
		if not (st.rnd and  st.lvid) then
			st.stage = 1
			return
		end

		local dist = bdo and bdo:position():distance_to_sqr(npc:position()) or 0
		if (st.lvid == npc:level_vertex_id() or dist <= st.rnd) then
			local rnd = math_random(100)
			if (rnd <= GRENADE_CHANCE_PCT) then
				xr_sound.set_sound_play(npc:id(),"search")
				state_mgr.set_state(npc,"threat_danger",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
				st.dtimer = time_global() + math_random(3000,5000)
			elseif (dist <= 5 and not st.searched) then
				st.searched = true
				state_mgr.set_state(npc,"search",nil,nil,nil,{fast_set = true})
				st.dtimer = time_global() + math_random(3000,5000)
			else
				state_mgr.set_state(npc,"raid",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
			end

			st.stage = 3
			return
		end
		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
		state_mgr.set_state(npc,"assault",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
	elseif (st.stage == 3) then
		if (st.dtimer and time_global() < st.dtimer) then
			return
		end

		local dist_to_killer = dst and dst.killer_last_known_position and npc:position():distance_to_sqr(dst.killer_last_known_position) or 30

		local new_vid = random_choice(utils_obj.try_to_strafe(npc),utils_obj.try_go_backward(npc,6),utils_obj.try_go_cover(npc,dst and dst.killer_last_known_position or bdo and bdo:position() or npc:position()))

		if (new_vid and (not st.lvid or new_vid ~= st.lvid))then
			st.lvid = new_vid
		end

		if not (new_vid) then
			local dir = dst and dst.killer_last_known_position and vector():set(dst.killer_last_known_position):sub(npc:position()) or killer and vector():set(killer:position()):sub(npc:position()) or npc:direction()
			local node = at_position_node(3)
			node = node:select_best_vertex_id(npc,dir,npc:level_vertex_id(),10,dist_to_killer/2)

			if (node and node.vertex_id and node.vertex_id ~= npc:level_vertex_id()) then
				st.lvid  = node.vertex_id
			end
		end

		if (st.lvid) then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
			state_mgr.set_state(npc,"assault",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
			st.stage = 4
			return
		end
		st.dtimer = time_global() + math_random(5000,7000)
		st.stage = 5
		state_mgr.set_state(npc,"threat_danger",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
		return
	elseif (st.stage == 4) then
		if (npc:level_vertex_id() == st.lvid) then
			st.dtimer = time_global() + math_random(5000,7000)
			st.stage = 5
			state_mgr.set_state(npc,"hide_na",nil,nil,{look_position = dst and dst.killer_last_known_position},{fast_set = true})
			return
		end
		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
	elseif (st.stage == 5) then
		if (st.dtimer and time_global() < st.dtimer) then
			return
		end
		st.lvid = nil
		st.stage = 6
	elseif (st.stage == 6) then
		local new_vid = utils_obj.try_go_cover(npc,dst and dst.killer_last_known_position or bdo and bdo:position() or npc:position())
		if (new_vid) then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,new_vid)
			state_mgr.set_state(npc,"hide_na",nil,nil,{look_position = dst and (dst.killer_last_known_position or (dst.object and dst.object:position()))},{fast_set = true})
		end
	end
end

local function script_action_danger_attacked(npc,st,bd,best_danger_object,dependent_object,bd_type)
	local bdo = dependent_object or best_danger_object
	local tg = time_global()

	if (st.stage == 1) then

		if not (st.last_pos) then
			st.last_pos = bdo and vector():set(bdo:position())
		end

		local dir = st.last_pos and vector():set(st.last_pos):sub(npc:position()) or vector():set(npc:direction())
		local dist_to_bdo = st.last_pos and npc:position():distance_to_sqr(st.last_pos) or 30

		local target_vertex_id = random_choice(utils_obj.try_to_strafe(npc),utils_obj.try_go_backward(npc,6),utils_obj.try_go_cover(npc,st.last_pos or npc:position()))

		if (target_vertex_id) then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,target_vertex_id)
			state_mgr.set_state(npc,"assault",nil,nil,{look_position = st.last_pos},{fast_set = true})
			st.stage = 2
			return
		end

		st.dtimer = tg + math_random(5000,6000)
		st.stage = 3
		return
	elseif (st.stage == 2) then
		if (npc:level_vertex_id() == st.lvid) then
			st.dtimer = tg + math_random(5000,7000)
			st.stage = 3
			return
		end
		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc,st.lvid)
	elseif (st.stage == 3) then
		if (st.dtimer and tg < st.dtimer) then
			state_mgr.set_state(npc,"threat_danger",nil,nil,{look_position = st.last_pos},{fast_set = true})
			return
		end
		st.stage = 1
	end
end

local ALERT_CLOSE_DIST_SQR = 120

local function script_action_danger_alert(npc, st, bd, best_danger_object, dependent_object, bd_type)
	local bdo = dependent_object or best_danger_object
	if not bdo or not bdo:alive() then return end

	local npc_pos = npc:position()
	local bdo_pos = bdo:position()
	local dist = npc_pos:distance_to_sqr(bdo_pos)
	local be = npc:best_enemy() or best_danger_object
	local tg = time_global()

	if bdo:id() == db.actor:id() and npc:relation(db.actor) < game_object.enemy then
		if not _enabled.neutral_gunfire then return end
		state_mgr.set_state(npc, "threat_na", nil, nil, {look_position = bdo_pos}, {fast_set = true})
		return
	end
	if not _enabled.attack_sound then return end

	if dist <= ALERT_CLOSE_DIST_SQR then
		if be and npc:see(be) then
			state_mgr.set_state(npc, "hide_na", nil, nil, {look_object = be}, {fast_set = true})
			if not utils_obj.squad_in_los(npc, be) then
				local wpn = npc:best_weapon()
				if wpn then
					local look_pos = vector():set(be:position())
					look_pos.y = look_pos.y + 1.5
					npc:set_sight(look.fire_point, look_pos)
				end
			end
		else
			state_mgr.set_state(npc, "threat_danger", nil, nil, {look_position = bdo_pos}, {fast_set = true})
		end

		local sm = db.storage[npc:id()] and db.storage[npc:id()].state_mgr
		if sm and sm.target_state ~= "threat_danger" then
			npc:clear_animations()
			sm:set_state("threat_danger", nil, nil, {look_position = bdo_pos}, {fast_set = true})
			sm.animation:set_state(nil, true)
			sm.animation:set_control()
			sm.animstate:set_state(nil, true)
			sm.animstate:set_control()
		end

		st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id())
		return
	end

	if be and npc:see(be) and npc:relation(be) >= 2 then
		if not st.stage or st.stage < 1 then st.stage = 1 end
	else
		st.stage = 2
	end

	if st.stage == 1 then
		local new_vid = random_choice(
			utils_obj.try_to_strafe(npc),
			utils_obj.try_go_cover(npc, bdo_pos),
			utils_obj.try_go_backward(npc, 6)
		)

		if new_vid and new_vid ~= npc:level_vertex_id() then
			st.lvid = utils_obj.send_to_nearest_accessible_vertex(npc, new_vid)
			st.stage = 2
			local sm = db.storage[npc:id()].state_mgr
			if sm and sm.target_state ~= "assault" then
				npc:clear_animations()
				sm:set_state("assault", nil, nil, {look_position = bdo_pos}, {fast_set = true})
				sm.animation:set_state(nil, true)
				sm.animation:set_control()
				sm.animstate:set_state(nil, true)
				sm.animstate:set_control()
			end
			return
		end

		state_mgr.set_state(npc, "threat_danger", nil, nil, {look_position = bdo_pos}, {fast_set = true})
		return
	end

	if st.stage == 2 then
		st.__dtimer = st.__dtimer or tg + math_random(8500, 12500)
		if tg > st.__dtimer or (st.lvid and npc:level_vertex_id() == st.lvid) then
			st.stage = nil
			st.__dtimer = nil
			return
		end
		state_mgr.set_state(npc, "threat_danger", nil, nil, {look_position = bdo_pos}, {fast_set = true})
		return
	end
end

function at_action_danger:execute()
	action_base.execute(self)

	local npc = self.object

	if not npc:alive() then return end

	if (check_script_danger(npc:id())) then
		script_action_danger_scripted(npc,self.a)
		return
	end

	local best_danger = npc:best_danger()
	if not (best_danger) then
		return
	end

	if (npc:path_type() ~= game_object.level_path) then
		npc:set_path_type(game_object.level_path)
	end

	local best_danger_object = best_danger:object()
	local bd_type = best_danger:type()
	local dependent_object = best_danger:dependent_object()

	if (bd_type == danger_object.grenade) then
		script_action_danger_grenade(npc,self.a,best_danger,best_danger_object,dependent_object,bd_type)
	elseif (bd_type == danger_object.entity_corpse) then
		script_action_danger_corpse(npc,self.a,best_danger,best_danger_object,dependent_object,bd_type)
	elseif (bd_type == danger_object.attacked) then
		script_action_danger_attacked(npc,self.a,best_danger,best_danger_object,dependent_object,bd_type)
	elseif (_enabled.attack_sound or _enabled.neutral_gunfire) and (bd_type == danger_object.attack_sound) then
		if at_debug.on() then at_debug.dbg("attack_sound dispatch npc=%s src=%s", npc:name(), best_danger_object and best_danger_object:name() or "nil") end
		script_action_danger_alert(npc,self.a,best_danger,best_danger_object,dependent_object,bd_type)
	end
end

function at_action_danger:finalize()
	self.a.stage = 1
	if (self.a.last_state) then
		state_mgr.set_state(self.object,self.a.last_state)
	end

	local own_id = self.object:id()
	for k,v in pairs(db.used_level_vertex_ids) do
		if v == own_id then
			db.used_level_vertex_ids[k] = nil
		end
	end

	self.a.__warning_shot_tmr = nil
	utils_obj.send_to_nearest_accessible_vertex(self.object,self.object:level_vertex_id())
	action_base.finalize(self)
end

class "at_evaluator_check_danger" (property_evaluator)
function at_evaluator_check_danger:__init(name, storage) super (nil, name)
	self.a = storage
end
function at_evaluator_check_danger:evaluate()

	if (self.a.disable) then
		return false
	end

	if not (IsStalker(self.object)) then
		return false
	end

	if not (self.object:alive()) then
		return false
	end

	if (self.object:best_enemy()) then
		return false
	end

	if (IsWounded(self.object)) then
		return false
	end

	if (not at_faction.has_flavor(self.object, "danger")) then
		return false
	end

	local id = self.object:id()
	if not (db.storage[id].danger_flag) then
		return false
	end

	if (check_script_danger(id)) then
		return true
	end

	local bd = self.object:best_danger()
	if not (bd) then
		return false
	end

	local bd_type = bd:type()
	if (self.object:has_info("npcx_is_companion") and bd_type == danger_object.entity_corpse) then
		return false
	end

	if not (bd_type == danger_object.attacked or bd_type == danger_object.entity_corpse or bd_type == danger_object.grenade
		or ((_enabled.attack_sound or _enabled.neutral_gunfire) and bd_type == danger_object.attack_sound)) then
		return false
	end

	return true
end
class "at_position_node"
function at_position_node:__init(amt)
	self.node = {}
	for i=1,amt do
		self.node[i] = {}
	end
end

function at_position_node:select_best_vertex_id(object,dir,lvid,min_dist,max_dist,find_furthest)
	local close
	min_dist = min_dist and (min_dist <= max_dist and min_dist or max_dist) or 10
	max_dist = max_dist and (max_dist >= min_dist and max_dist or min_dist) or 30
	for i=1, #self.node do
		local direction = vector_rotate_y(vec_set(dir), math_random(-180,180))

		self.node[i].vertex_id = level.vertex_in_direction(lvid, direction, math_random(min_dist,max_dist) )

		if (self.node[i].vertex_id and utils_obj.accessible(object,self.node[i].vertex_id) and self.node[i].vertex_id ~= lvid) then
			self.node[i].distance = self.node[i].vertex_id == lvid and -1 or object:position():distance_to_sqr(level.vertex_position(self.node[i].vertex_id))

			if not (close) then
				close = i --self.node[i].vertex_id
			end

			if (close) then
				if (find_furthest) then
					if (self.node[close] and self.node[close].distance < self.node[i].distance) then
						close = i
					end
				else
					if (self.node[close] and self.node[i].distance < self.node[close].distance) then
						close = i
					end
				end
			end
		end
	end
	return close and self.node[close]
end

function setup_generic_scheme(npc,ini,scheme,section,stype,temp)
	local st = xr_logic.assign_storage_and_bind(npc,ini,"danger","danger",temp)
	db.storage[npc:id()].danger_flag = false
	db.storage[npc:id()].danger_flag_scripted = nil
end

function add_to_binder(npc,ini,scheme,section,storage,temp)
	if not npc then return end
	local manager = npc:motivation_action_manager()
	if not manager then return end

	local evaluator1 = at_evaluator_danger("danger", storage, npc)
	local evaluator2 = at_evaluator_check_danger("script_danger",storage,npc)
	if not evaluator1 or not evaluator2 then return end

	local danger_action = manager:action(stalker_ids.action_danger_planner)
	local danger_action_planner = cast_planner(danger_action)
	if not danger_action or not danger_action_planner then return end

	manager:remove_evaluator(stalker_ids.property_danger)
	manager:add_evaluator(stalker_ids.property_danger,evaluator1)
	manager:add_evaluator(_evaid,evaluator2)

	danger_action_planner:remove_evaluator(stalker_ids.property_danger)

	local wp = world_property

	local evaluator3 = at_evaluator_danger("danger", storage, npc)
	danger_action:add_precondition( wp(_evaid, false) )
	temp.action = at_action_danger("danger", storage)

	if not evaluator3 or not temp.action then return end
	danger_action_planner:add_evaluator(stalker_ids.property_danger,evaluator3)

	temp.action:add_precondition( wp(_evaid, true) )
	temp.action:add_precondition( wp(stalker_ids.property_danger, true) )
	temp.action:add_effect( wp(_evaid,false) )

	manager:add_action(_actid,temp.action)
end

function configure_actions(npc,ini,scheme,section,stype,temp)
	if not npc then return end
	local manager = npc:motivation_action_manager()
	if not manager or not temp.action then return end

	local wp = world_property

	temp.action:add_precondition( wp(stalker_ids.property_alive, true) )
	temp.action:add_precondition( wp(stalker_ids.property_enemy, false) )

	local action
	local p = {
				xr_actions_id.alife,
				xr_actions_id.state_mgr + 2
	}

	for i=1,#p do
		action = manager:action(p[i])
		if (action) then
			action:add_precondition( wp(_evaid,false) )
		else
			printf("xr_danger: no action id p[%s]",i)
		end
	end
end

function reset_generic_scheme(npc,scheme,section,stype,st)

end

local function _on_entity_unregister(se_obj)
	if se_obj then script_danger[se_obj.id] = nil end
end

local function _refresh_log()
	at_debug.refresh()
	if at_mcm then
		_enabled.hit_bypass      = at_mcm.get_config("danger_hit_bypass")      ~= false
		_enabled.attack_sound    = at_mcm.get_config("danger_attack_sound")    ~= false
		_enabled.actor_tables    = at_mcm.get_config("danger_actor_tables")    ~= false
		_enabled.neutral_gunfire = at_mcm.get_config("danger_neutral_gunfire") ~= false
	end
end

local function _on_actor_first_update()
	_refresh_log()
	at_debug.info("xr_danger patch initialized")
end

local _patched = false
local function _install_patches()
	if _patched then return end
	_patched = true
	_actid = xr_danger.actid or _actid
	xr_danger.setup_generic_scheme = setup_generic_scheme
	xr_danger.add_to_binder        = add_to_binder
	xr_danger.configure_actions    = configure_actions
	xr_danger.reset_generic_scheme = reset_generic_scheme
	xr_danger.get_danger_time      = get_danger_time
	xr_danger.set_script_danger    = set_script_danger
	xr_danger.has_danger           = has_danger
	_actor_tables_live = xr_danger.DangerIgnoreActor ~= nil
end

function on_game_start()
	_install_patches()
	RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
	RegisterScriptCallback("actor_on_first_update", _on_actor_first_update)
	RegisterScriptCallback("on_option_change", _refresh_log)
	RegisterScriptCallback("mcm_option_restore_default", _refresh_log)
end

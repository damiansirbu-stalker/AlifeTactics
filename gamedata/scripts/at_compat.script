--- at_compat: third-party hit-pipeline compatibility - the grok_bo coupling lives only here

local RegisterScriptCallback, UnregisterScriptCallback, type = RegisterScriptCallback, UnregisterScriptCallback, type
local at_effects_resolver, xcombat, at_debug, db = at_effects_resolver, xcombat, at_debug, db
local RESIST = at_effects_resolver.EFFECT.DAMAGE_RESIST

local function _trace_result(npc, before, applied, factor)
    if not at_debug.is_on() then return end
    at_debug.debug("[COMPAT] gbo_resist id=%d before=%.3f applied=%.4f factor=%.3f hp=%.3f",
        npc:id(), before, applied, factor, xcombat.get_health_frac(npc))
end

local function _register_gbo_wrapper()
    if type(grok_bo) ~= "table" or type(grok_bo.npc_on_before_hit) ~= "function" then return false end
    local orig = grok_bo.npc_on_before_hit
    local function _apply_resist(npc, shit, bone_id, flags)
        local who = shit and shit.draftsman
        if not (npc and who and db.actor and who:id() == db.actor:id() and npc:alive()) then
            return orig(npc, shit, bone_id, flags)
        end
        local factor = at_effects_resolver.resolve(npc, RESIST)
        if not factor then return orig(npc, shit, bone_id, flags) end
        local before = xcombat.get_health_frac(npc)
        orig(npc, shit, bone_id, flags)
        local applied = before - xcombat.get_health_frac(npc)
        if applied > 0 and npc:alive() then xcombat.add_health_frac(npc, applied * (1 - factor)) end
        _trace_result(npc, before, applied, factor)
    end
    UnregisterScriptCallback("npc_on_before_hit", orig)
    RegisterScriptCallback("npc_on_before_hit", _apply_resist)
    return true
end

local function _on_actor_first_update()
    if _register_gbo_wrapper() then
        at_debug.info("[COMPAT] grok_bo npc_on_before_hit wrapped: NPC artefact resistance restored for player hits")
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", _on_actor_first_update)
end

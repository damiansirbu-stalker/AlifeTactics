--- at_health: Heal-rate scaling, per-rank healing charge, limp + heal animations

local math_random = math.random
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global
local IsStalker, IsWounded = IsStalker, IsWounded

local LIMP_ELIGIBILITY_CHECK_MS = 1000
local LIMP_REARM_MS             = 5000
-- xr_eat_medkit.consume_medkit schedules heal_hp/heal_bleed with left=15.
local HEAL_TICK_FIRST           = 15

-- Posture-slot table for the dmg_norm torso overlay (damaged_walk / damaged_run anims).
-- Engine indexes torso anims by weapon posture slot, not inventory slot. Missing entries fall
-- through to slot 0 (fist). Slots 5, 7 not present in vanilla OMF.
local LIMP_IDLE_BY_SLOT = {
    [0] = "dmg_norm_torso_0_idle_0", [1] = "dmg_norm_torso_1_idle_0",
    [2] = "dmg_norm_torso_2_idle_0", [3] = "dmg_norm_torso_3_idle_0",
    [4] = "dmg_norm_torso_4_idle_0", [6] = "dmg_norm_torso_6_idle_0",
    [8] = "dmg_norm_torso_8_idle_0", [9] = "dmg_norm_torso_9_idle_0",
    [10] = "dmg_norm_torso_10_idle_0",
}
local LIMP_WALK_BY_SLOT = {
    [0] = "dmg_norm_torso_0_walk_0", [1] = "dmg_norm_torso_1_walk_0",
    [2] = "dmg_norm_torso_2_walk_0", [3] = "dmg_norm_torso_3_walk_0",
    [4] = "dmg_norm_torso_4_walk_0", [6] = "dmg_norm_torso_6_walk_0",
    [8] = "dmg_norm_torso_8_walk_0", [9] = "dmg_norm_torso_9_walk_0",
    [10] = "dmg_norm_torso_10_walk_0",
}
local LIMP_RUN_BY_SLOT = {
    [0] = "dmg_norm_torso_0_run_0", [1] = "dmg_norm_torso_1_run_0",
    [2] = "dmg_norm_torso_2_run_0", [3] = "dmg_norm_torso_3_run_0",
    [4] = "dmg_norm_torso_4_run_0", [6] = "dmg_norm_torso_6_run_0",
    [8] = "dmg_norm_torso_8_run_0", [9] = "dmg_norm_torso_9_run_0",
    [10] = "dmg_norm_torso_10_run_0",
}
local HEAL_ANIM_MEDKIT  = "dmg_norm_torso_11_attack_0"
local HEAL_ANIM_BANDAGE = "norm_torso_12_attack_0"

local _limping = {}

-- Vanilla pstor writes to a wrong key when name is nil. Guard explicitly.
local function _safe_save(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _safe_load(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end

local log = xlog.get_logger("AT.HEALTH", { outfile = "alifetactics.log" })
local _dbg = false
local _heal_active = false
local cfg = at_mcm.cfg

-- Vanilla rank intervals (game_relations.ltx [game_relations] rating) folded
-- into MCM tiers via ranks.get_obj_rank_name.
local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local function _rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

-- One-shot medkit/bandage gesture. Gated on healing_anim toggle, on no visible
-- enemy (no anim during combat), and on not-on-ground. The hurt pose belongs to
-- LIMP, not here; HEAL is "I am applying an item" and nothing else. The engine
-- drains the queue when the gesture ends; action transitions clear it on the way
-- to action_wounded / action_critically_wounded (stalker_base_action.cpp:24-29).
local function _try_play_heal_anim(npc, gesture)
    if not cfg.healing_anim_enabled then return end
    if npc:best_enemy() then return end
    if IsWounded(npc) or npc:critically_wounded() then return end
    utils_obj.add_anim(npc, gesture)
end

-- Vanilla xr_eat_medkit.heal_hp (script:188-201) with MCM rate multiplier.
-- Reschedules via xr_eat_medkit.heal_hp lookup so the chain stays on the patched function.
local function _patched_heal_hp(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        local mult = cfg.heal_rate_multiplier
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        if left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_MEDKIT)
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- Vanilla xr_eat_medkit.heal_bleed (script:203-215) with logging only.
-- Engine bleeding field is a hard set per tick, not a delta -- no multiplier.
local function _patched_heal_bleed(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        npc.bleeding = 0.07
        if left == HEAL_TICK_FIRST then
            _try_play_heal_anim(npc, HEAL_ANIM_BANDAGE)
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

local function _install_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        log.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _patched_heal_hp
    xr_eat_medkit.heal_bleed = _patched_heal_bleed
    _heal_active = true
    log.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    log.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
end

-- Per-rank charge override of vanilla's flat 50% roll at xr_eat_medkit.script:36-44.
-- Vanilla's bug (re-roll on every save load) is suppressed in zzz_at_health_patch.script.
local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = npc:id()
    local name = npc:name()
    if _safe_load(id, name, "at_charge_processed") then
        tmr:stop()
        if _dbg then
            log.debug("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, tmr:get_ms())
        end
        return
    end
    _safe_save(id, name, "at_charge_processed", true)

    local tier = _rank_tier(npc)
    local chance = (cfg["charge_chance_" .. tier] or 50) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _safe_save(id, name, "healing_charge", granted)
    tmr:stop()
    if _dbg then
        log.debug("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", tmr:get_ms())
    end
end

local function _pick_limp_anim(npc)
    local slot = npc:active_slot()
    local mt   = npc:movement_type()
    local tbl  = (mt == move.walk and LIMP_WALK_BY_SLOT)
              or (mt == move.run  and LIMP_RUN_BY_SLOT)
              or LIMP_IDLE_BY_SLOT
    return tbl[slot] or tbl[0]
end

local function _on_npc_update(npc, st)
    if not st then return end
    local id = npc:id()
    local tg = time_global()

    if not cfg.limping_anim_enabled then return end
    -- Per-tick drop on ground-state transitions; the throttled eligibility check below
    -- would otherwise let the torso overlay loop on a prone body for up to 1s. The
    -- action transition into action_wounded / action_critically_wounded clears the
    -- engine queue via CStalkerActionBase::initialize, so we do not call
    -- clear_animations here ourselves.
    if _limping[id] and (not npc:alive() or IsWounded(npc) or npc:critically_wounded()) then
        _limping[id] = nil
        if _dbg then log.debug("[LIMP] lost id=%d hp=%.2f reason=wounded_or_dead", id, npc.health) end
        return
    end
    if st._at_limp_next_check_ms and tg < st._at_limp_next_check_ms then return end
    st._at_limp_next_check_ms = tg + LIMP_ELIGIBILITY_CHECK_MS
    local eligible = IsStalker(npc)
        and npc:alive()
        and not npc:in_smart_cover()
        and npc.health < cfg.limping_health_threshold
        and not npc:best_enemy()
        and npc:mental_state() == anim.free
        and npc:body_state() == move.standing
        and npc:character_community() ~= "zombied"
        and not IsWounded(npc)

    if not eligible then
        if not _limping[id] then return end
        _limping[id] = nil
        -- No clear_animations: the currently-playing overlay finishes on its OMF length
        -- (~2-3s) and the 5s rearm gate prevents the next add. An external clear here
        -- would race state_mgr's set_state early-return (state_mgr.script:388) on
        -- non-action-transition flips (combat hand-off being the worst case) and could
        -- strand the engine queue empty for the rest of a behavior_hold window.
        if _dbg then log.debug("[LIMP] lost id=%d hp=%.2f", id, npc.health) end
        return
    end
    local rec = _limping[id]
    if not rec then
        rec = { next_add_ms = 0 }
        _limping[id] = rec
        if _dbg then log.debug("[LIMP] gained id=%d hp=%.2f", id, npc.health) end
    end
    if tg < rec.next_add_ms then return end
    if npc:animation_count() > 0 then return end

    local anim_name = _pick_limp_anim(npc)
    utils_obj.add_anim(npc, anim_name)
    rec.next_add_ms = tg + LIMP_REARM_MS
    if _dbg then
        local slot = npc:active_slot()
        local wpn  = npc:active_item()
        local sect = wpn and wpn:section() or "none"
        log.debug("[LIMP] anim id=%d name=%s slot=%d section=%s hp=%.2f",
            id, anim_name, slot, sect, npc.health)
    end
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _limping[se_obj.id] = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_actor_first_update()
    _limping = {}
    _refresh_log()
    if not _heal_active then return end
    log.info("Health module initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        cfg.heal_rate_multiplier,
        cfg.charge_chance_novice,
        cfg.charge_chance_experienced,
        cfg.charge_chance_veteran,
        cfg.charge_chance_master)
end

function on_game_start()
    RegisterScriptCallback("npc_on_update",              _on_npc_update)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)

    -- get_config (closure) bypasses cfg cache, safe before at_mcm.on_game_start runs.
    if at_mcm.get_config("healing_enabled") == false then
        log.info("Stalker Healing disabled at boot; vanilla xr_eat_medkit behavior in effect")
        return
    end
    _install_heal_patch()
    RegisterScriptCallback("npc_on_net_spawn", _on_net_spawn)
end

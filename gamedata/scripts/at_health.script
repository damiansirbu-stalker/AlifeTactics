--- at_health: Per-NPC healing tuning and visual cues
--- Patches xr_eat_medkit.heal_hp / heal_bleed to scale per-tick recovery by an
--- MCM multiplier, overrides vanilla's flat 50% healing_charge roll with per-rank
--- probabilities, and drives optional limp + heal-gesture animations.
--- See architecture.md Healing section for engine-call detail.

local math_random = math.random
local se_save_var, se_load_var = se_save_var, se_load_var
local RegisterScriptCallback, time_global = RegisterScriptCallback, time_global
local IsStalker, IsWounded = IsStalker, IsWounded

-- ==================== VISUAL LAYER CONSTANTS ====================

local LIMP_ELIGIBILITY_CHECK_MS = 1000
-- Min ms between successive limp anim queues; lower stalls locomotion.
local LIMP_REARM_MS             = 5000
-- xr_eat_medkit.consume_medkit calls heal_hp/heal_bleed with left=15.
local HEAL_TICK_FIRST          = 15
-- _healing_active auto-expires after this (covers save/load + offline edge cases).
local HEAL_ACTIVE_EXPIRY_MS    = 30000

-- Torso-layer limp variants from vanilla stalker OMF. The "torso_N_*" naming
-- encodes (damage character N, gait). Bone mask is torso-only so engine drives
-- legs/root normally -> NPC walks/stands without floating. Distinct from the
-- full-body "dmg_norm_walk_fwd_0" (locomotion replacement, Path 2 only).
local LIMP_ANIM_IDLE    = "dmg_norm_torso_1_idle_0"
local LIMP_ANIM_WALK    = "dmg_norm_torso_0_walk_0"
local LIMP_ANIM_RUN     = "dmg_norm_torso_0_run_0"
local HEAL_ANIM_MEDKIT  = "dmg_norm_torso_11_attack_0"
local HEAL_ANIM_BANDAGE = "norm_torso_12_attack_0"

-- [npc_id] = { next_add_ms } limp anim queue scheduler state per NPC
local _limping = {}
-- [npc_id] = expiry_ms while heal_hp or heal_bleed cycle is running (gates limp)
local _healing_active = {}
-- Heal sequence: [id] = { stage = "clutch"|"gesture", until_ms, gesture_anim }
-- At heal cycle start: stop NPC, play wound-clutch pose for CLUTCH_MS, then
-- swap to medkit/bandage gesture for GESTURE_MS, then restore movement.
local _heal_seq = {}
local HEAL_CLUTCH_MS  = 3000
local HEAL_GESTURE_MS = 3000

-- pstor wrappers with nil-key guard. Both functions accept (id, name, key[, val]); if
-- name is nil, vanilla pstor silently writes to a wrong key (and reads back nil), so
-- guard explicitly. Callers can pass npc:name() without their own pre-check.
local function _safe_save(id, name, key, val)
    if not name then return end
    se_save_var(id, name, key, val)
end
local function _safe_load(id, name, key)
    if not name then return nil end
    return se_load_var(id, name, key)
end
-- CreateTimeEvent is NOT cached at module load: demonized_time_events replaces this
-- global at runtime, so capturing the upvalue would pin the original (vanilla) impl.

local log = xlog.get_logger("AT.HEALTH", { outfile = "alifetactics.log" })
local _dbg = false
local _heal_active = false
local cfg = at_mcm.cfg

-- Vanilla rank names from game_relations.ltx [game_relations] rating folded into
-- the four MCM tiers. ranks.get_obj_rank_name resolves the numeric rank against
-- the same source so any mod that reshapes the rating intervals keeps working.
local _RANK_TO_TIER = {
    novice       = "novice",
    trainee      = "novice",
    experienced  = "experienced",
    professional = "experienced",
    veteran      = "veteran",
    expert       = "veteran",
    master       = "master",
    legend       = "master",
}

local function _rank_tier(npc)
    return _RANK_TO_TIER[ranks.get_obj_rank_name(npc)] or "novice"
end

-- ==================== PATCH: HEAL_HP MULTIPLIER ====================

-- Mirrors vanilla xr_eat_medkit.heal_hp (script:188-201) logic but scales
-- the per-tick heal by the current MCM multiplier. Recursive scheduling
-- captures xr_eat_medkit.heal_hp (our function after install) so the chain
-- propagates the multiplier through all 13 ticks. xprofiler.new_if(_dbg)
-- is a no-op singleton when debug logging is off, real profile_timer when
-- on -- timing appears in the [HEAL] debug line at zero cost otherwise.
local function _patched_heal_hp(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        _healing_active[id] = time_global() + HEAL_ACTIVE_EXPIRY_MS
        local mult = cfg.heal_rate_multiplier
        npc:change_health(0.05 * mult)
        npc.bleeding = 0.01
        if left == HEAL_TICK_FIRST and cfg.healing_anim_enabled then
            npc:movement_enabled(false)
            npc:set_desired_position()
            npc:clear_animations()
            utils_obj.add_anim(npc, LIMP_ANIM_IDLE)
            _heal_seq[id] = {
                stage      = "clutch",
                until_ms   = time_global() + HEAL_CLUTCH_MS,
                gesture    = HEAL_ANIM_MEDKIT,
                last_hp    = npc.health,
            }
            if _dbg then log.debug("[HEAL] seq_start id=%d kind=medkit", id) end
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] hp_tick id=%d mult=%.2f health=%.2f left=%d [%.2fms]",
                id, mult, npc.health, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_hp_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_hp, id, nextl)
    else
        _healing_active[id] = nil
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

-- ==================== PATCH: HEAL_BLEED LOG ====================

-- Mirrors vanilla xr_eat_medkit.heal_bleed (script:203-215). No behavior
-- change: vanilla sets npc.bleeding = 0.07 per tick for 13 ticks (left=15..3,
-- exits at left=2). The replacement only adds [HEAL] bleed_tick / bleed_complete
-- log lines and xprofiler timing so bandage consumption is observable end-to-end,
-- matching the heal_hp pattern. Recursive scheduling captures xr_eat_medkit
-- .heal_bleed (our function after install) so the chain stays on the patched
-- function through all 13 ticks. No MCM-tunable multiplier because the engine
-- field is a hard set, not a delta -- a multiplier on a target value would be
-- unintuitive.
local function _patched_heal_bleed(id, left)
    local tmr = xprofiler.new_if(_dbg):start()
    local nextl = left - 1
    local npc = level.object_by_id(id)
    if npc and npc:alive() and nextl > 1 then
        _healing_active[id] = time_global() + HEAL_ACTIVE_EXPIRY_MS
        npc.bleeding = 0.07
        if left == HEAL_TICK_FIRST and cfg.healing_anim_enabled then
            npc:movement_enabled(false)
            npc:set_desired_position()
            npc:clear_animations()
            utils_obj.add_anim(npc, LIMP_ANIM_IDLE)
            _heal_seq[id] = {
                stage      = "clutch",
                until_ms   = time_global() + HEAL_CLUTCH_MS,
                gesture    = HEAL_ANIM_BANDAGE,
                last_hp    = npc.health,
            }
            if _dbg then log.debug("[HEAL] seq_start id=%d kind=bandage", id) end
        end
        tmr:stop()
        if _dbg then
            log.debug("[HEAL] bleed_tick id=%d bleeding=%.3f left=%d [%.2fms]",
                id, npc.bleeding, nextl, tmr:get_ms())
        end
        CreateTimeEvent(id, npc:name() .. "_self_healing_event_bleed_" .. nextl,
            level.get_time_factor(), xr_eat_medkit.heal_bleed, id, nextl)
    else
        _healing_active[id] = nil
        tmr:stop()
        if _dbg then
            local reason = (not npc) and "no_obj"
                or (not npc:alive()) and "dead"
                or "ticks_exhausted"
            log.debug("[HEAL] bleed_complete id=%d reason=%s left=%d [%.2fms]",
                id, reason, left, tmr:get_ms())
        end
    end
    return true
end

local function _install_heal_patch()
    if not (xr_eat_medkit and xr_eat_medkit.heal_hp and xr_eat_medkit.heal_bleed) then
        log.warn("[PATCH] xr_eat_medkit.heal_hp or heal_bleed unavailable; module disabled")
        return
    end
    xr_eat_medkit.heal_hp = _patched_heal_hp
    xr_eat_medkit.heal_bleed = _patched_heal_bleed
    _heal_active = true
    log.info("[PATCH] xr_eat_medkit.heal_hp replaced with multiplier-aware version")
    log.info("[PATCH] xr_eat_medkit.heal_bleed replaced with logged version")
end

-- ==================== CALLBACK: PER-RANK HEALING CHARGE ====================

-- Fires when an NPC game_object first becomes online (npc_on_net_spawn).
-- Vanilla server-entity on_register has already fired by now and may have
-- set healing_charge=true on a 50% roll. We override unconditionally with
-- our per-rank roll: every stalker, every spawn, exactly one resolution.
-- at_charge_processed flag is persisted via se_save_var so subsequent
-- offline/online transitions (or save/load cycles) skip the re-roll.
local function _on_net_spawn(npc, _se_obj)
    if not _heal_active then return end
    if not npc or not IsStalker(npc) or not npc:alive() then return end
    local tmr = xprofiler.new_if(_dbg):start()
    local id = npc:id()
    local name = npc:name()
    if _safe_load(id, name, "at_charge_processed") then
        tmr:stop()
        if _dbg then
            log.debug("[CHARGE] already_processed id=%d name=%s [%.2fms]", id, name, tmr:get_ms())
        end
        return
    end
    _safe_save(id, name, "at_charge_processed", true)

    local tier = _rank_tier(npc)
    local chance = (cfg["charge_chance_" .. tier] or 50) / 100
    local rolled = math_random()
    local granted = rolled < chance
    _safe_save(id, name, "healing_charge", granted)
    tmr:stop()
    if _dbg then
        log.debug("[CHARGE] id=%d tier=%s chance=%.2f rolled=%.3f granted=%s [%.2fms]",
            id, tier, chance, rolled, granted and "true" or "false", tmr:get_ms())
    end
end

-- ==================== CALLBACK: LIMPING VISUAL ====================

local function _pick_limp_anim(npc)
    local mt = npc:movement_type()
    if mt == move.walk then return LIMP_ANIM_WALK end
    if mt == move.run  then return LIMP_ANIM_RUN  end
    return LIMP_ANIM_IDLE
end

-- End the staged heal sequence: restore movement, clear anim, drop the entry.
-- Called when the gesture stage completes or when damage aborts the sequence.
local function _end_heal_sequence(npc, id)
    _heal_seq[id] = nil
    npc:movement_enabled(true)
    npc:clear_animations()
end

-- Drive one tick of the staged heal sequence (clutch -> gesture -> restore).
-- Returns early when no sequence is active. Aborts on incoming damage so NPC
-- can defend themselves instead of standing helpless during combat.
local function _drive_heal_sequence(npc, id, tg)
    local seq = _heal_seq[id]
    if not seq then return end
    if not npc:alive() then _heal_seq[id] = nil; return end
    if seq.last_hp and npc.health < seq.last_hp - 0.02 then
        -- Net HP drop while frozen -> NPC under attack -> abort
        if _dbg then
            log.debug("[HEAL] seq_abort id=%d reason=damage hp=%.2f->%.2f", id, seq.last_hp, npc.health)
        end
        _end_heal_sequence(npc, id)
        return
    end
    if tg >= seq.until_ms then
        if seq.stage == "clutch" then
            npc:clear_animations()
            utils_obj.add_anim(npc, seq.gesture)
            seq.stage    = "gesture"
            seq.until_ms = tg + HEAL_GESTURE_MS
            if _dbg then log.debug("[HEAL] seq_gesture id=%d anim=%s", id, seq.gesture) end
        else
            if _dbg then log.debug("[HEAL] seq_end id=%d", id) end
            _end_heal_sequence(npc, id)
            return
        end
    end
    seq.last_hp = npc.health
end

-- npc_on_update fires every motivator binder tick (~30-60 Hz per online stalker
-- from xr_motivator.script:486). Throttled per-NPC to LIMP_ELIGIBILITY_CHECK_MS
-- via storage table; eligibility -> pick the gait-matching torso overlay
-- (idle/walk/run) and re-queue whenever the script-animation queue is empty.
-- Continuous visual coverage without stacking (count==0 gate). Engine pops the
-- anim after each playthrough; our next eligibility tick refills the queue.
local function _on_npc_update(npc, st)
    if not st then return end
    local id = npc:id()
    local tg = time_global()

    _drive_heal_sequence(npc, id, tg)

    if not cfg.limping_anim_enabled then return end
    if st._at_limp_next_check_ms and tg < st._at_limp_next_check_ms then return end
    st._at_limp_next_check_ms = tg + LIMP_ELIGIBILITY_CHECK_MS
    local active = _healing_active[id]
    local eligible = IsStalker(npc)
        and npc:alive()
        and not (active and tg < active)
        and not npc:in_smart_cover()
        and npc.health < cfg.limping_health_threshold
        and npc:mental_state() == anim.free
        and npc:body_state() == move.standing
        and npc:character_community() ~= "zombied"
        and not IsWounded(npc)

    if not eligible then
        if not _limping[id] then return end
        _limping[id] = nil
        if _dbg then log.debug("[LIMP] lost id=%d hp=%.2f", id, npc.health) end
        return
    end
    local rec = _limping[id]
    if not rec then
        rec = { next_add_ms = 0 }
        _limping[id] = rec
        if _dbg then log.debug("[LIMP] gained id=%d hp=%.2f", id, npc.health) end
    end
    if tg < rec.next_add_ms then return end
    if npc:animation_count() > 0 then return end

    local anim_name = _pick_limp_anim(npc)
    utils_obj.add_anim(npc, anim_name)
    rec.next_add_ms = tg + LIMP_REARM_MS
    if _dbg then log.debug("[LIMP] anim id=%d name=%s hp=%.2f", id, anim_name, npc.health) end
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    _limping[se_obj.id] = nil
    _healing_active[se_obj.id] = nil
    _heal_seq[se_obj.id] = nil
end

-- ==================== LIFECYCLE ====================

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_actor_first_update()
    _refresh_log()
    if not _heal_active then return end
    log.info("Health module initialized (heal_mult=%.2f tiers novice=%d%% experienced=%d%% veteran=%d%% master=%d%%)",
        cfg.heal_rate_multiplier,
        cfg.charge_chance_novice,
        cfg.charge_chance_experienced,
        cfg.charge_chance_veteran,
        cfg.charge_chance_master)
end

function on_game_start()
    RegisterScriptCallback("npc_on_update",              _on_npc_update)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",     _on_actor_first_update)
    RegisterScriptCallback("on_option_change",          _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default", _refresh_log)

    -- Read via get_config (always fresh from ui_mcm.get); cfg.healing_enabled
    -- would be the default at this point because at_mcm.on_game_start has not
    -- yet called load_config() (at_health < at_mcm alphabetically).
    if at_mcm.get_config("healing_enabled") == false then
        log.info("Stalker Healing disabled at boot; vanilla xr_eat_medkit behavior in effect")
        return
    end
    _install_heal_patch()
    RegisterScriptCallback("npc_on_net_spawn", _on_net_spawn)
end

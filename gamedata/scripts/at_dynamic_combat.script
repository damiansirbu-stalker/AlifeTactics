--- at_dynamic_combat: Rotate squad members through engine DetourEnemy via SeeEnemy evaluator override
-- Per-NPC override of stalker_ids.property_see_enemy on the combat planner
-- (action_planner_script.cpp:49 exposes add_evaluator). When the squad's
-- rotation marks this NPC designated, the evaluator returns false; the
-- engine combat sub-planner then sees SeeEnemy=false and picks
-- CStalkerActionDetourEnemy (op 25) because LookedOut+PositionHolded are
-- already accumulated from the cover cycle (stalker_combat_planner.cpp:387-405).
-- Engine runs its own cover pick + path + fire (stalker_combat_actions.cpp:924-1022).
-- No engine memory state mutation. No enable_memory_object calls.
-- No re-enable timer for engine state; designation clears via short-lived
-- flag set by the tick.
--
-- Per-NPC bind via npc_on_net_spawn. Bind deferred until actor_on_first_update
-- via _first_update_fired flag to avoid modifying GOAP during LSS save-restoration.
-- xslice sweep at first_update binds pre-existing NPCs in batches.

local pairs, RegisterScriptCallback, IsWounded, IsStalker =
    pairs, RegisterScriptCallback, IsWounded, IsStalker
local math_random = math.random
local xcreature, xslice = xcreature, xslice
-- DO NOT cache CreateTimeEvent / ResetTimeEvent / RemoveTimeEvent as locals.
-- demonized_time_events.script replaces them; cached locals capture the dead
-- originals and timers never fire. See doc/library/xray/internals/globals.md:208-219.

local log = xlog.get_logger("AT.DYN", { outfile = "alifetactics.log" })
local _dbg = false

-- ==================== CONSTANTS ====================

local TIMER_EV           = "at_dynamic_combat"
local TIMER_TICK         = "tick"
local TIMER_CLEAR_PFX    = "clear_"
local TICK_INTERVAL_SEC  = 20
local DESIGNATE_HOLD_SEC = 4   -- how long SeeEnemy is held false per designation

local INVALID_GROUP = 65535

local BIND_SWEEP_QUEUE = "at_dynamic_combat_sweep"
local BIND_SWEEP_STEP  = 5     -- NPCs to bind per frame during the sweep

local FACTION_SKIP = {
    monolith = true,
    zombied  = true,
}

-- ==================== STATE ====================

local _enabled = true

-- Per-squad designated set: _designated[squad_id] = { [npc_id] = true, ... }
-- Cleared per-designation by a short-lived TimeEvent (DESIGNATE_HOLD_SEC).
-- Full rotation reset happens in _pick_member when every eligible member has
-- been picked at least once.
local _designated = {}

-- Per-NPC bind dedup.
local _bound = {}

-- Set true at the end of actor_on_first_update. While false, npc_on_net_spawn
-- does NOT bind: that runs during the LSS save-restoration phase where the
-- engine is bulk-restoring NPCs and their motivation managers; GOAP modifications
-- during that window can crash native code. The xslice sweep at first_update
-- binds pre-existing NPCs safely once LSS is done; only post-load spawns hit the
-- immediate-bind path.
local _first_update_fired = false

-- ==================== EVALUATOR ====================

-- SeeEnemy evaluator override. Returns false when the NPC is in its squad's
-- current designated rotation; otherwise mirrors the engine evaluator
-- (stalker_property_evaluators.cpp:127-132): SeeEnemy = best_enemy and
-- can_see(best_enemy).
class "evaluator_see_enemy" (property_evaluator)
function evaluator_see_enemy:__init(name) super (nil, name) end

function evaluator_see_enemy:evaluate()
    local npc = self.object
    if not npc or not npc:alive() then return false end

    if _enabled then
        local squad = get_object_squad(npc)
        if squad then
            local set = _designated[squad.id]
            if set and set[npc:id()] then return false end
        end
    end

    local be = npc:best_enemy()
    if not be then return false end
    return npc:see(be) and true or false
end

-- ==================== BINDER ====================

-- Per-NPC bind: override SeeEnemy on the NPC's combat planner. action_planner
-- add_evaluator replaces any existing evaluator for the property (post_combat_idle
-- uses the same pattern at stalker-anomaly/post_combat_idle.script:218-222).
local function _bind_npc(npc)
    if not npc or not npc:alive() then return end
    if not IsStalker(npc) then return end
    if npc:section() == "actor_visual_stalker" then return end
    local id = npc:id()
    if id == AC_ID then return end
    if _bound[id] then return end

    local manager = npc:motivation_action_manager()
    if not manager then return end

    local combat = manager:action(stalker_ids.action_combat_planner)
    if not combat then return end

    local evaluator = evaluator_see_enemy("eva_at_see_enemy")
    if not evaluator then return end

    combat:add_evaluator(stalker_ids.property_see_enemy, evaluator)
    _bound[id] = true

    if _dbg then log.debug("[BIND] npc=%d", id) end
end

-- ==================== SUBSTRATE ACCESS ====================

local function _is_engaged(record)
    if not record then return false end
    return xtime.game_sec() < (record.engaged_until or 0)
end

-- ==================== MEMBER PICK ====================

-- Pick one non-commander member who has not been designated this rotation. When
-- every eligible member has been designated, reset the designated set and pick
-- fresh. Returns nil when the squad has no alive non-wounded non-commander
-- online members.
local function _pick_member(squad, designated)
    if not squad or not squad.squad_members then return nil end

    local commander_id = squad.commander_id and squad:commander_id() or nil
    if commander_id == INVALID_GROUP then commander_id = nil end

    local candidates = {}
    for member in squad:squad_members() do
        if member.id ~= commander_id then
            local npc = level.object_by_id(member.id)
            if npc and npc:alive() and not IsWounded(npc) then
                candidates[#candidates + 1] = member.id
            end
        end
    end
    if #candidates == 0 then return nil end

    local fresh = {}
    for i = 1, #candidates do
        if not designated[candidates[i]] then
            fresh[#fresh + 1] = candidates[i]
        end
    end
    if #fresh == 0 then
        for i = 1, #candidates do designated[candidates[i]] = nil end
        fresh = candidates
    end

    return fresh[math_random(#fresh)]
end

-- ==================== DESIGNATE ====================

-- Mark NPC designated, schedule the short-lived clear. No engine APIs touched.
local function _designate(squad_id, npc_id)
    local designated = _designated[squad_id]
    if not designated then
        designated = {}
        _designated[squad_id] = designated
    end
    designated[npc_id] = true

    local ev_id = TIMER_CLEAR_PFX .. squad_id .. "_" .. npc_id
    CreateTimeEvent(TIMER_EV, ev_id, DESIGNATE_HOLD_SEC, function()
        local set = _designated[squad_id]
        if set then set[npc_id] = nil end
        if _dbg then
            log.debug("[CLEAR] squad=%d npc=%d designation released", squad_id, npc_id)
        end
        return true
    end)

    if _dbg then
        log.debug("[DESIGNATE] squad=%d npc=%d see_enemy_held_false hold=%ds",
            squad_id, npc_id, DESIGNATE_HOLD_SEC)
    end
end

-- ==================== TICK ====================

local function _on_tick()
    ResetTimeEvent(TIMER_EV, TIMER_TICK, TICK_INTERVAL_SEC)
    if not _enabled then return end
    if not at_squad_memory then return end

    local now = xtime.game_sec()
    if now == 0 then return end

    local tmr = xprofiler.new_if(_dbg):start()
    local engaged_count, designated_count = 0, 0

    at_squad_memory.iterate(function(squad_id, record)
        if not _is_engaged(record) then return end
        if _dbg then engaged_count = engaged_count + 1 end

        local squad = alife_object(squad_id)
        if not squad then return end
        if FACTION_SKIP[squad.player_id or ""] then return end

        local designated = _designated[squad_id]
        if not designated then
            designated = {}
            _designated[squad_id] = designated
        end

        local npc_id = _pick_member(squad, designated)
        if not npc_id then return end

        _designate(squad_id, npc_id)
        if _dbg then designated_count = designated_count + 1 end
    end)

    tmr:stop()
    if _dbg then
        log.debug("[TICK] engaged_squads=%d designated=%d [%.2fms]",
            engaged_count, designated_count, tmr:get_ms())
    end
end

-- ==================== SWEEP ====================

local function _bind_one_id(npc_id)
    if not npc_id then return true end
    if _bound[npc_id] then return true end
    local npc = level.object_by_id(npc_id)
    if not npc then return true end
    _bind_npc(npc)
    return true
end

local function _on_sweep_done()
    local count = 0
    for _ in pairs(_bound) do count = count + 1 end
    log.info("[SWEEP] bind sweep complete, bound=%d", count)
end

local function _start_bind_sweep()
    if not xslice or not xcreature then return end
    if xslice.is_active(BIND_SWEEP_QUEUE) then return end

    local queue = {}
    for obj in xcreature.online_iter() do
        if obj and IsStalker(obj) and obj:alive() then
            local id = obj:id()
            if id ~= AC_ID and not _bound[id] then
                queue[#queue + 1] = id
            end
        end
    end
    if #queue == 0 then return end

    if _dbg then log.debug("[SWEEP] queued=%d step=%d", #queue, BIND_SWEEP_STEP) end
    xslice.start(BIND_SWEEP_QUEUE, queue, {
        step    = BIND_SWEEP_STEP,
        func    = _bind_one_id,
        on_done = _on_sweep_done,
    })
end

-- ==================== LIFECYCLE ====================

local function _on_npc_spawn(npc)
    if not _enabled then return end
    if not _first_update_fired then return end
    _bind_npc(npc)
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _designated[id] = nil
    _bound[id] = nil
end

local function _refresh_config()
    if not (at_mcm and at_mcm.get_config) then return end

    local level_str = at_mcm.get_config("log_level") or "WARN"
    log.set_level(level_str)
    _dbg = log.get_level() >= 5

    local v = at_mcm.get_config("dynamic_combat_enabled")
    if v ~= nil then _enabled = v end
end

local function _on_first_update()
    _designated = {}
    _bound = {}
    _refresh_config()
    RemoveTimeEvent(TIMER_EV, TIMER_TICK)
    CreateTimeEvent(TIMER_EV, TIMER_TICK, TICK_INTERVAL_SEC, _on_tick)
    log.info("Dynamic Combat initialized (enabled=%s, tick=%ds, hold=%ds, dbg=%s)",
        _enabled and "true" or "false", TICK_INTERVAL_SEC, DESIGNATE_HOLD_SEC,
        _dbg and "true" or "false")
    if _enabled then _start_bind_sweep() end
    _first_update_fired = true
end

function on_game_start()
    RegisterScriptCallback("npc_on_net_spawn",            _on_npc_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_config)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_config)
end

--- at_combat_trace: decision/transition trace for the v2 takeover. One function per event; every one noops
--- when disabled (set_enabled(false) flips the gate, so the off path builds no string and allocates nothing).
--- Call sites pass the per-NPC state the monitor already computed - the trace reads its fields, never re-probes.

local tostring = tostring
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _names = {}

local function _yn(v) return v and "Y" or "N" end
local function _show(v) return v ~= nil and tostring(v) or "-" end

--- Cache a per-id display name (raw ids are unreadable in a fight log).
function at_combat_trace.set_name(id, name) _names[id] = name end

--- Enable/disable all tracing. The shell mirrors its _dbg flag here from the log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- Drop all per-id memory (level load / first update).
function at_combat_trace.reset() _names = {} end

--- Drop one NPC's memory on unregister.
function at_combat_trace.forget(id) _names[id] = nil end

--- Install outcome per NPC (tracked / not_stalker).
function at_combat_trace.install(id, name, result)
    if not _on then return end
    log.info("inst id=%s name=%s result=%s", _show(id), _show(name), result)
end

--- One line per monitor tick: fight state, the selected enemy, and every trigger's value plus which fired.
--- `fired` is the scan outcome (a trigger name, or a skip reason like idle / no_enemy / cant_seize / none).
function at_combat_trace.monitor(id, state, fired)
    if not _on then return end
    log.info("mon id=%s name=%s fight=%s ene=%s dist=%.1f too_close=%s hurt=%s gren=%s stall=%s -> %s",
        _show(id), _show(_names[id]), _yn(state.fighting), _show(state.enemy_id), state.dist or -1,
        _yn(state.t_too_close), _yn(state.t_hurt), _yn(state.t_grenade), _yn(state.t_stalled), fired or "none")
end

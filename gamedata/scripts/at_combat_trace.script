--- at_combat_trace: DEBUG-gated decision tracing + telemetry for at_combat.
--- Every function noops when tracing is off, so at_combat's decision pipeline carries no inline
--- log/stat blocks. at_combat mirrors its _dbg flag here via set_enabled and holds none of the trace
--- state. Stats accumulate only while enabled; at_test reads them through at_combat.get_stats.

local tostring, IsStalker = tostring, IsStalker
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _last_eval_logged = {}

local function _new_stats()
    return { behaviors = {}, resolve = {}, cover = {}, backoffs = 0,
             tick_sum = 0, tick_max = 0, tick_n = 0, read_sum = 0, read_n = 0,
             stages = {} }
end
local _stats = _new_stats()

local function _stat(tbl, key)
    tbl[key] = (tbl[key] or 0) + 1
end

-- Y / N / ? (nil = the reading was short-circuited, never evaluated this recompute)
local function _yn(value)
    if value == nil then return "?" end
    return value and "Y" or "N"
end

--- Enable/disable all tracing. at_combat calls this from its log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- Reset accumulated telemetry and eval-transition memory (level load / first update).
function at_combat_trace.reset()
    _stats = _new_stats()
    _last_eval_logged = {}
end

--- Drop one NPC's eval-transition memory on unregister.
function at_combat_trace.forget(id) _last_eval_logged[id] = nil end

--- Accumulated telemetry table for the at_test stats dump.
function at_combat_trace.stats() return _stats end

--- One line per recompute: the NPC, the enemy it answers to, all readings, the problem, the chosen maneuver.
--- Enemy + names + health read here (gated) so the off path pays nothing. Counts the maneuver.
function at_combat_trace.decide(id, npc, state, ctx, tg, problem, role, maneuver)
    if not _on then return end
    if maneuver then _stat(_stats.behaviors, maneuver) end
    local age = tg - state.last_seen
    local enemy = ctx.enemy
    log.debug("decide npc=%d(%s) grp=%s wpn=%s/%s env=%s hp=%.2f ene=%d(%s/%s) see=%s age=%dms zone=%s dist=%.1f cover=%s fr=%s occ=%s prob=%s role=%s man=%s",
        id, npc:name(), state.group, state.weapon_kind or "none", state.bucket_name, state.env or "?",
        npc.health, enemy:id(), enemy:name(), IsStalker(enemy) and "stalker" or "mutant",
        _yn(age == 0), age, state.range_zone, ctx.dist, _yn(state.at_cover),
        _yn(ctx.r_friendly), _yn(ctx.r_occluder), tostring(problem), tostring(role or "-"), tostring(maneuver))
end

--- Maneuver switch with the rolled knobs (fire/posture/movement) held for the maneuver's lifetime.
function at_combat_trace.switch(id, name, fire, posture, movement)
    if not _on then return end
    log.debug("switch npc=%d man=%s fire=%s posture=%s move=%s",
        id, name, tostring(fire), tostring(posture), tostring(movement))
end

--- Move issued; lvid is the requested vertex, sent is where send_to routed it, cover the claim outcome.
function at_combat_trace.resolve_ok(id, maneuver, vid, sent, dist, cover)
    if not _on then return end
    _stat(_stats.resolve, tostring(maneuver) .. "/ok")
    log.debug("resolve npc=%d man=%s ok lvid=%d sent=%d dist=%.1f cover=%s",
        id, tostring(maneuver), vid, sent, dist, tostring(cover or "na"))
end

--- Resolver returned no vertex; counts the fail.
function at_combat_trace.resolve_fail(id, maneuver, dist)
    if not _on then return end
    _stat(_stats.resolve, tostring(maneuver) .. "/fail")
    log.debug("resolve npc=%d man=%s fail dist=%.1f", id, tostring(maneuver), dist)
end

--- Cover reservation event (held / stolen / claim_fail); reads the contesting owner here (gated).
function at_combat_trace.cover(id, event, lvid)
    if not _on then return end
    _stat(_stats.cover, event)
    local owner = lvid and xcombat.get_cover_owner(lvid)
    log.debug("cover npc=%d %s lvid=%s owner=%s", id, event, tostring(lvid), tostring(owner or "-"))
end

--- Pick-fail streak crossed threshold; NPC handed back to vanilla for backoff ms.
function at_combat_trace.backoff(id, streak, backoff)
    if not _on then return end
    _stats.backoffs = _stats.backoffs + 1
    log.debug("backoff npc=%d streak=%d backoff=%dms -> vanilla", id, streak, backoff)
end

--- Eval result, logged only on transition (managed<->rejected) per NPC.
function at_combat_trace.eval(id, result, reason)
    if not _on then return end
    local prev = _last_eval_logged[id]
    if prev == result then return end
    _last_eval_logged[id] = result
    log.debug("eval npc=%d %s->%s reason=%s", id, prev == nil and "init" or tostring(prev), tostring(result), reason)
end

--- Per-recompute total ms; accumulates tick avg/max into stats. Read via at_combat_stats, not logged per tick.
function at_combat_trace.perf(ms)
    if not _on then return end
    _stats.tick_n = _stats.tick_n + 1
    _stats.tick_sum = _stats.tick_sum + ms
    if ms > _stats.tick_max then _stats.tick_max = ms end
end

--- Per-stage duration; accumulates stage avg/max into stats.stages. Read via at_combat_stats, not logged per tick.
function at_combat_trace.stage(name, ms)
    if not _on then return end
    local st = _stats.stages[name]
    if not st then
        st = { sum = 0, max = 0, n = 0 }
        _stats.stages[name] = st
    end
    st.n = st.n + 1
    st.sum = st.sum + ms
    if ms > st.max then st.max = ms end
    if name == "read" then
        _stats.read_n = _stats.read_n + 1
        _stats.read_sum = _stats.read_sum + ms
    end
end

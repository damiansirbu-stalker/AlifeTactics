--- at_combat_trace: DEBUG-gated decision tracing + telemetry for at_combat.
--- Every function noops when tracing is off, so at_combat's decision pipeline carries no inline
--- log/stat blocks. at_combat mirrors its _dbg flag here via set_enabled and holds none of the trace
--- state. Stats accumulate only while enabled; at_test reads them through at_combat.get_stats.

local tostring = tostring
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _last_eval_logged = {}

local function _new_stats()
    return { behaviors = {}, resolve = {}, backoffs = 0,
             tick_sum = 0, tick_max = 0, tick_n = 0, read_sum = 0, read_n = 0 }
end
local _stats = _new_stats()

local function _stat(tbl, key)
    tbl[key] = (tbl[key] or 0) + 1
end

--- Enable/disable all tracing. at_combat calls this from its log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- Reset accumulated telemetry and eval-transition memory (level load / first update).
function at_combat_trace.reset()
    _stats = _new_stats()
    _last_eval_logged = {}
end

--- Drop one NPC's eval-transition memory on unregister.
function at_combat_trace.forget(id) _last_eval_logged[id] = nil end

--- Accumulated telemetry table for the at_test stats dump.
function at_combat_trace.stats() return _stats end

--- [DECIDE] one line per recompute: the readings, the problem, and the maneuver chosen; counts the maneuver.
function at_combat_trace.decide(id, s, problem, maneuver, dist)
    if not _on then return end
    if maneuver then _stat(_stats.behaviors, maneuver) end
    log.debug("[DECIDE] npc=%d grp=%s wpn=%s env=%s zone=%s prob=%s -> %s dist=%.1f",
        id, s.group, s.weapon_kind or "none", s.env or "?", s.range_zone, tostring(problem), tostring(maneuver), dist)
end

--- [COMBAT] maneuver switch.
function at_combat_trace.switch(id, name)
    if not _on then return end
    log.debug("[COMBAT] switch npc=%d -> %s", id, name)
end

--- [RESOLVE] move issued; lvid is the requested vertex, sent is where send_to routed it.
function at_combat_trace.resolve_ok(id, maneuver, vid, sent, dist)
    if not _on then return end
    _stat(_stats.resolve, tostring(maneuver) .. "/ok")
    log.debug("[RESOLVE] npc=%d %s ok lvid=%d sent=%d dist=%.1f", id, tostring(maneuver), vid, sent, dist)
end

--- [RESOLVE] resolver returned no vertex; counts the fail.
function at_combat_trace.resolve_fail(id, maneuver, dist)
    if not _on then return end
    _stat(_stats.resolve, tostring(maneuver) .. "/fail")
    log.debug("[RESOLVE] npc=%d %s FAIL dist=%.1f", id, tostring(maneuver), dist)
end

--- [BACKOFF] pick-fail streak crossed threshold; NPC handed back to vanilla for backoff ms.
function at_combat_trace.backoff(id, streak, backoff)
    if not _on then return end
    _stats.backoffs = _stats.backoffs + 1
    log.debug("[BACKOFF] npc=%d streak=%d backoff=%dms -> vanilla", id, streak, backoff)
end

--- [COMBAT] eval result, logged only on transition (managed<->rejected) per NPC.
function at_combat_trace.eval(id, result, reason)
    if not _on then return end
    local prev = _last_eval_logged[id]
    if prev == result then return end
    _last_eval_logged[id] = result
    log.debug("[COMBAT] eval npc=%d %s->%s reason=%s", id, prev == nil and "init" or tostring(prev), tostring(result), reason)
end

--- [PERF] per-recompute total ms + outcome tag; accumulates tick avg/max.
function at_combat_trace.perf(id, tag, ms)
    if not _on then return end
    log.debug("[PERF] npc=%d %s %.3fms", id, tostring(tag), ms)
    _stats.tick_n = _stats.tick_n + 1
    _stats.tick_sum = _stats.tick_sum + ms
    if ms > _stats.tick_max then _stats.tick_max = ms end
end

--- at_combat_trace: DEBUG-gated decision logging for at_combat. Every function noops when tracing is off,
--- so at_combat's scan carries no inline log blocks. at_combat mirrors its _dbg flag here via set_enabled.
--- One line per done-scan (scan), per committed maneuver (decide), and per takeover transition (eval).
--- No aggregate counters: the log lines are the telemetry.

local tostring = tostring
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _logged_eval = {}
local _last_action = {}
local _names = {}

-- nil-safe field stringifier for the trace lines (value, or "-" when absent)
local function _show(v) return v ~= nil and tostring(v) or "-" end

-- Per-id display name, cached by at_combat from npc:name() (raw ids are unreadable mid-fight).
function at_combat_trace.set_name(id, name) _names[id] = name end
local function _get_name(id) return _names[id] or "-" end

--- Enable/disable all tracing. at_combat calls this from its log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- Drop the eval-transition memory (level load / first update).
function at_combat_trace.reset() _logged_eval = {} _last_action = {} _names = {} end

--- Drop one NPC's eval-transition memory on unregister.
function at_combat_trace.forget(id) _logged_eval[id] = nil _last_action[id] = nil _names[id] = nil end

--- Install outcome per NPC (attempt / no_manager / installed). Noop when DEBUG is off, like every trace fn.
function at_combat_trace.install(id, name, reason)
    if not _on then return end
    log.debug("install npc=%s(%s) %s", tostring(id), tostring(name or "-"), reason)
end

--- One line per done-scan: the readings the checks saw and the outcome (which check fired, which maneuver,
--- or "-" for a turret tick where nothing fired). Skipped while a maneuver is committed (no work to log).
function at_combat_trace.scan(npc, enemy, state, check, maneuver, scan_us)
    if not _on then return end
    local id = npc:id()
    local age = state.unseen_ms or 0
    log.debug("scan npc=%d(%s) dist=%.1f hp=%.2f zone=%s sees=%s fire=%s ene=%s(%s) age=%d pal=%s/%s/%s dest=%s rout=%s cover=%s check=%s man=%s us=%.0f",
        id, _get_name(id), npc:position():distance_to(enemy:position()), npc.health, _show(state.range_zone), state.sees and "Y" or "N",
        _show(state.fire), _show(enemy:id()), _show(enemy:name()), age,
        _show(state.community), _show(state.bucket_name), _show(state.env),
        _show(state.dest), _show(state.rout), _show(state.cover_lvid),
        _show(check), _show(maneuver),
        scan_us)
end

--- Maneuver committed: the check that fired it, the rolled posture/speed, the apply + resolve costs.
function at_combat_trace.decide(id, name, check, posture, movement, apply_ms, resolve_ms, ok, state)
    if not _on then return end
    log.debug("decide npc=%d(%s) man=%s check=%s posture=%s move=%s dest=%s rout=%s cover=%s apply=%.3fms resolve=%.3fms ok=%s",
        id, _get_name(id), name, tostring(check), tostring(posture), tostring(movement),
        tostring(state.dest or "-"), tostring(state.rout or "-"), tostring(state.cover_lvid or "-"), apply_ms, resolve_ms, tostring(ok))
end

--- Action-state probe, logged only when an installed NPC's current top-level action changes. cur is the
--- action the brain is actually running (AT = our takeover, COMBAT / DANGER = the vanilla planners we block);
--- eval is whether our evaluator wants to manage right now. `eval=true cur=COMBAT` means the precondition
--- block leaked (we want control, the vanilla combat planner ran anyway); `eval=false cur=COMBAT` is an
--- expected handback. Quiet at steady state (only flips log), so it answers the grenade question directly.
function at_combat_trace.current_action(id, eval, label, cur)
    if not _on then return end
    if _last_action[id] == label then return end
    _last_action[id] = label
    log.debug("act npc=%d(%s) eval=%s cur=%s(%s)", id, _get_name(id), tostring(eval), label, tostring(cur))
end

--- Eval result, logged only on transition (managed<->rejected) per NPC.
function at_combat_trace.eval(id, result, reason, state)
    if not _on then return end
    local prev = _logged_eval[id]
    if prev == result then return end
    _logged_eval[id] = result
    local age = (state and state.unseen_ms) or 0
    log.debug("eval npc=%d(%s) %s->%s reason=%s age=%d", id, _get_name(id), prev == nil and "init" or tostring(prev), tostring(result), reason, age)
end

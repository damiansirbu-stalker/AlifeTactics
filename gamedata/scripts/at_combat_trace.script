--- at_combat_trace: decision/transition trace for the v2 takeover. One function per event; every one noops
--- when disabled (set_enabled(false) flips the gate, so the off path builds no string and allocates nothing).
--- Call sites pass the per-NPC state the monitor already computed - the trace reads its fields, never re-probes.

local tostring = tostring
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _names = {}

-- The monitor outcomes that mean "the NPC was fighting and the triggers were evaluated this tick" (so the
-- line carries distance + every trigger value). Any other outcome is a skip before evaluation (short line).
local SCAN_RESULTS = { too_close = true, grenade = true, hurt = true, stalled = true, none = true }

local function _yes_no(v) return v and "yes" or "no" end
local function _show(v) return v ~= nil and tostring(v) or "unknown" end

--- Cache a per-id display name (raw ids are unreadable in a fight log).
function at_combat_trace.set_name(id, name) _names[id] = name end

--- Enable/disable all tracing. The shell mirrors its debug flag here from the log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- The debug gate, for callers that must skip diagnostic-only work (an extra probe) when tracing is off.
function at_combat_trace.enabled() return _on end

--- Drop all per-id memory (level load / first update).
function at_combat_trace.reset() _names = {} end

--- Drop one NPC's memory on unregister.
function at_combat_trace.forget(id) _names[id] = nil end

--- One line when AT starts tracking a stalker.
function at_combat_trace.installed(id, name)
    if not _on then return end
    log.info("installed id=%s name=%s", _show(id), _show(name))
end

--- One line when a fired trigger seized nobody: reason "not_viable" (a maneuver's palette matched this NPC but
--- its resolver declined - no cover reachable, fully walled in) names the maneuver; reason "no_maneuver" (no
--- palette matched - wrong faction or weapon, e.g. monolith / zombied on hurt) has maneuver "-". Distinguishes a
--- decline from a seize (which logs a begin) and from a quiet tick, and says which half declined.
function at_combat_trace.declined(id, trigger, maneuver)
    if not _on then return end
    log.info("declined id=%s name=%s trigger=%s maneuver=%s reason=%s",
        _show(id), _show(_names[id]), _show(trigger), _show(maneuver or "-"),
        maneuver and "not_viable" or "no_maneuver")
end

--- One line when a maneuver is actually issued (the action's initialize): the destination vertex, the applied
--- fire mode, the movement (so RUN is visible on a flee), the mode the catalog row requested, and the t134 gate
--- value. requested is the row's fire; fire is what set_combat got; fire_make_sense is the engine gate - false
--- forces a firing row (FIRE/SNIPE) down to READY (weapon up, no trigger: occluded / point-blank / floor gap /
--- no LOS), "na" when the row does not fire so the gate was never consulted. requested==fire with
--- fire_make_sense=true means the shot was taken as asked.
function at_combat_trace.issue(id, maneuver, dest, fire, movement, requested, fire_make_sense)
    if not _on then return end
    log.info("issue id=%s name=%s maneuver=%s dest=%s fire=%s move=%s requested=%s fire_make_sense=%s",
        _show(id), _show(_names[id]), _show(maneuver), _show(dest), _show(fire), _show(movement), _show(requested), _show(fire_make_sense))
end

--- One line the first time the on_enemy_eval subscriber forces is_enemy(fled enemy)=false for a flee hold - the
--- proof the seam fires. One-shot per hold (deduped by the caller) so a busy is_enemy poll does not spam the log.
--- Paired with disengage_release below.
function at_combat_trace.disengage(id)
    if not _on then return end
    log.info("disengage id=%s name=%s forced is_enemy(fled enemy)=false", _show(id), _show(_names[id]))
end

--- One line when a flee's disengage hold clears: reason "settle" (the settle window after hand-back expired, the
--- rout is over) or "caught" (a hit landed after hand-back, so the NPC drops the hold and fights back). The proof
--- of WHEN and WHY the enemy becomes selectable again.
function at_combat_trace.disengage_release(id, reason)
    if not _on then return end
    log.info("disengage_release id=%s name=%s reason=%s", _show(id), _show(_names[id]), _show(reason))
end

--- One line when a flee resolves its destination: path "too_close" (enemy inside flee_min_dist, declined - nobody
--- flees point-blank), "base" (a friendly base at least flee_base_min_dist_m away, biased to the rear hemisphere),
--- or "no_base" (no friendly base that far and clear was reachable, declined). The proof of the point-blank gate and
--- the far-base pick.
function at_combat_trace.resolve_flee(id, path)
    if not _on then return end
    log.info("resolve_flee id=%s name=%s path=%s", _show(id), _show(_names[id]), _show(path))
end

--- One line per monitor tick for a fighting NPC: the selected enemy and the outcome. When the triggers were
--- evaluated (result is a trigger name or "none") the line also carries the distance and every trigger value;
--- when the NPC was skipped before evaluation (no_enemy / cannot_seize) the line is short.
function at_combat_trace.monitor(id, state, result)
    if not _on then return end
    if SCAN_RESULTS[result] then
        log.info("monitor id=%s name=%s fighting=yes target=%s(%s) distance=%.1f seen=%s aim=%ddeg operator=%s too_close=%s hurt=%s grenade=%s stalled=%s result=%s",
            _show(id), _show(_names[id]), _show(state.enemy_id), _show(state.enemy_name), state.dist or -1,
            _yes_no(state.seen), state.aim_off or -1, _show(state.operator),
            _yes_no(state.t_too_close), _yes_no(state.t_hurt), _yes_no(state.t_grenade), _yes_no(state.t_stalled), result)
    else
        log.info("monitor id=%s name=%s fighting=yes target=%s result=%s",
            _show(id), _show(_names[id]), _show(state.enemy_id), result)
    end
end

--- One line when AT seizes an NPC: the maneuver and the trigger that fired it.
function at_combat_trace.begin(id, maneuver, trigger)
    if not _on then return end
    log.info("begin id=%s name=%s maneuver=%s trigger=%s",
        _show(id), _show(_names[id]), _show(maneuver), _show(trigger))
end

--- One line when a maneuver completes and AT hands the NPC back to vanilla.
function at_combat_trace.commit(id, maneuver, reason, dur_ms)
    if not _on then return end
    log.info("commit id=%s name=%s maneuver=%s reason=%s dur=%dms",
        _show(id), _show(_names[id]), _show(maneuver), _show(reason), dur_ms or -1)
end

--- at_combat_trace: decision/transition trace for the v2 takeover. One function per event; every one noops
--- when disabled (set_enabled(false) flips the gate, so the off path builds no string and allocates nothing).
--- Call sites pass the per-NPC state the monitor already computed - the trace reads its fields, never re-probes.

local tostring = tostring
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })

at_combat_trace = at_combat_trace or {}

local _on = false
local _names = {}

local function _yes_no(v)
    return v and "yes" or "no"
end

local function _show(v)
    return v ~= nil and tostring(v) or "unknown"
end

-- Single-letter flag: y / n / ? (nil = unknowable, no planner to ask).
local function _flag(v)
    if v == nil then return "?" end
    return v and "y" or "n"
end

--- Compact cover readout "<in_cover><looked_out><held>/<ray>": the combat planner's stored beliefs
--- (xcombat.get_cover_state - "???" when there is no planner to ask) against the geometric line
--- (xcombat.has_obstacle_to_target from the enemy to the NPC - y = something blocks the line to him). The
--- divergence between the flag half and the ray half is the evidence the cover traces exist to collect
--- (in_cover is arrived-at-my-chosen-point bookkeeping, never a concealment test). Pure formatting - the
--- caller does the reads (at_combat._trace_decision, at_hud), so this stays probe-free.
function at_combat_trace.cover_string(in_cover, looked_out, held, blocked)
    return _flag(in_cover) .. _flag(looked_out) .. _flag(held) .. "/" .. (blocked and "y" or "n")
end

--- Cache a per-id display name (raw ids are unreadable in a fight log).
function at_combat_trace.set_name(id, name) _names[id] = name end

--- Enable/disable all tracing. The shell mirrors its debug flag here from the log-level refresh.
function at_combat_trace.set_enabled(on) _on = on end

--- The debug gate, for callers that must skip diagnostic-only work (an extra probe) when tracing is off.
function at_combat_trace.enabled() return _on end

--- Drop all per-id memory (level load / first update).
function at_combat_trace.reset() _names = {} end

--- Drop one NPC's memory on unregister.
function at_combat_trace.forget(id) _names[id] = nil end

--- One line when AT starts tracking a stalker.
function at_combat_trace.installed(id, name)
    if not _on then return end
    log.info("installed id=%s name=%s", _show(id), _show(name))
end

--- One line when a maneuver begins (the graft action's initialize - the first engine write): the situation
--- that fired it, the destination vertex, the applied fire mode, the movement (so RUN is visible on a flee),
--- the mode the catalog row requested, the fire-gate value, and the DECIDE-time cover readout (see
--- cover_string; read before the seize because the blocked planner can only let the flags decay).
--- requested is the row's fire; fire is what set_combat got. Gate values: "seen" = enemy visible right now,
--- fired with no further gate (vanilla kill_enemy order); "true" = blind but fire_make_sense allowed it (the
--- 10s auto-weapon window); "false" = blind and denied, dropped to READY (occluded / floor gap / window
--- expired); "na" = the row does not fire.
function at_combat_trace.begin_maneuver(id, maneuver, trigger, dest, fire, movement, requested, fire_make_sense, cover, send_us, apply_us)
    if not _on then return end
    log.info("begin id=%s name=%s maneuver=%s trigger=%s dest=%s fire=%s move=%s requested=%s fire_make_sense=%s cover=%s [send=%dus apply=%dus]",
        _show(id), _show(_names[id]), _show(maneuver), _show(trigger), _show(dest), _show(fire), _show(movement), _show(requested), _show(fire_make_sense), _show(cover), send_us or -1, apply_us or -1)
end

--- One line per flee feasibility check: path "squad_stands" (a squadmate lives, declined - a rout is for the
--- last man; a squadded timid NPC answers pressure with retreat, the row above), "under_fire" (a fresh hit or
--- a perceived shot from the enemy, declined - nobody turns his back mid-burst; the cursor defers and re-asks
--- a lap later), "too_close" (enemy inside flee_min_dist, declined - nobody flees point-blank), "base" (a
--- friendly base at least flee_base_min_dist_m away, biased to the rear hemisphere), or "no_base" (no friendly
--- base that far and clear was reachable, declined).
function at_combat_trace.can_flee(id, path)
    if not _on then return end
    log.info("can_flee id=%s name=%s path=%s", _show(id), _show(_names[id]), _show(path))
end

--- One line per kite feasibility check: the current distance and the lane vertex. lane="none" with
--- back_m carrying the SET back-off (KITE_BACK) = fully boxed in, no lane at all; lane="none" with
--- back_m carrying the FOUND lane's length = the lane was too short to clear the weapon minimum (the
--- indoor stub), declined - the arrived-but-nothing-moved ping-pong guard.
function at_combat_trace.can_kite(id, dist, back_m, vid)
    if not _on then return end
    log.info("can_kite id=%s name=%s dist=%.1f back_m=%.1f lane=%s",
        _show(id), _show(_names[id]), dist or -1, back_m or -1, _show(vid or "none"))
end

--- One line when the short circuit refuses a pick: the same situation fired again with the NPC still
--- within CIRCUIT_MOVE_M of the previous pick, past the limit - the transactions are provably changing
--- nothing (the indoor ping-pong signature). Vanilla owns him until he moves, the situation changes, or
--- the fight ends.
function at_combat_trace.circuit(id, situation, picks)
    if not _on then return end
    log.info("circuit id=%s name=%s situation=%s picks=%d - takeover suspended until the world changes",
        _show(id), _show(_names[id]), _show(situation), picks or -1)
end

--- One line per snipe feasibility check: path "plant" (taken), "in_enemy_range" (inside the enemy's weapon
--- maximum, declined - a motionless head inside the enemy's band is a gift), "under_fire" (a fresh hit or a
--- perceived shot, declined - a hold's premise is being unbothered), or "targeted" (the actor's aim is on
--- him, declined). dist/enemy_max carry the range evidence on the range path.
function at_combat_trace.can_snipe(id, dist, enemy_max, path)
    if not _on then return end
    log.info("can_snipe id=%s name=%s dist=%.1f enemy_max=%s result=%s",
        _show(id), _show(_names[id]), dist or -1, _show(enemy_max), _show(path))
end

--- One line per counterflank feasibility check: path "taken" (clear line to the actor, holds in place and
--- engages) or "obstructed" (a wall or object blocks the line - facing him is theater, declined).
function at_combat_trace.can_counterflank(id, path)
    if not _on then return end
    log.info("can_counterflank id=%s name=%s path=%s", _show(id), _show(_names[id]), _show(path))
end

--- One line per retreat feasibility check: path "taken" (vertex accepted; cover_dist > npc_dist is the proof
--- the retreat grows the distance), "no_cover" (nothing behind him), "toward_enemy" (the winner sat closer to
--- the enemy than he stands, rejected), or "claim_lost" (another NPC reserved the vertex first).
function at_combat_trace.can_retreat(id, path, vid, cover_dist, npc_dist)
    if not _on then return end
    log.info("can_retreat id=%s name=%s path=%s cover=%s cover_dist=%.1f npc_dist=%.1f",
        _show(id), _show(_names[id]), _show(path), _show(vid or "-"), cover_dist or -1, npc_dist or -1)
end

--- One line per begin check for an NPC skipped BEFORE the catalog walk: no_enemy (fighting but no selected
--- enemy), at_cap (the concurrency failsafe), or cannot_seize with the blocking gate as reason (no_weapon /
--- smart_cover), so the log says WHY, not just that it could not. The ":" concat lives inside the _on
--- guard, so the off path allocates nothing. Evaluated checks log through decision() instead.
function at_combat_trace.monitor(id, state, result, reason, us)
    if not _on then return end
    log.info("monitor id=%s name=%s target=%s result=%s%s [%dus]",
        _show(id), _show(_names[id]), _show(state.enemy_id), result, reason and (":" .. reason) or "", us or -1)
end

--- The uniform decision line, one per evaluated begin check: the selected enemy, the distance, the sight and
--- facing reads, who drives (operator), the DECIDE-time cover readout (cover_string), the per-row catalog
--- walk with its cost, and the outcome. rows= is one comma-joined entry per examined row, in walk order:
--- "name:situation/stage" - situation the fired need (actor_close / too_close / hurt / stalled), stage how
--- far the row got (scope / off / palette / declined / picked), "-" a row whose need did not hold (fell
--- through in the same tick). The one row whose can_maneuver ran carries the per-layer timings
--- "/should=Xus/can=Yus" - the
--- evidence the need layer stays microseconds while the feasibility owns the geometry cost; the walk ends at
--- that row, so rows below it do not appear. walk= is the whole walk's microseconds - the wall-clock
--- evidence for any cost claim about this path. result= is the picked maneuver or "none".
function at_combat_trace.decision(id, state, result)
    if not _on then return end
    log.info("monitor id=%s name=%s target=%s(%s) distance=%.1f seen=%s aim=%ddeg operator=%s cover=%s rows=%s walk=%dus check=%dus result=%s",
        _show(id), _show(_names[id]), _show(state.enemy_id), _show(state.enemy_name), state.dist or -1,
        _yes_no(state.seen), state.aim_off or -1, _show(state.operator), _show(state.cover), _show(state.rows),
        state.walk_us or -1, state.check_us or -1, result)
end

--- One line per update tick of an open maneuver (200ms, debug only) - the mid-maneuver aim evidence.
--- target is nil or { id, name, seen, aim_off }: the STAGED enemy the maneuver is committed to
--- (never a mid-maneuver re-selection - the commitment lives in at_combat, xcombat.resolve_enemy).
--- aim= is the body-to-target angle in degrees (large = body pointed away from the thing he aims
--- at), fire=/gate= what apply_state issued and why.
function at_combat_trace.update_maneuver(id, maneuver, target, fire, gate, us)
    if not _on then return end
    if not target then
        log.info("update id=%s name=%s maneuver=%s target=nil fire=%s gate=%s [%dus]",
            _show(id), _show(_names[id]), _show(maneuver), _show(fire), _show(gate), us or -1)
        return
    end
    log.info("update id=%s name=%s maneuver=%s target=%s(%s) seen=%s aim=%ddeg fire=%s gate=%s [%dus]",
        _show(id), _show(_names[id]), _show(maneuver), _show(target.id), _show(target.name),
        _yes_no(target.seen), target.aim_off or -1,
        _show(fire), _show(gate), us or -1)
end

--- One line when a maneuver ends and AT hands the NPC back to vanilla. dur= the maneuver's life,
--- the [us] the end check's own cost.
function at_combat_trace.end_maneuver(id, maneuver, reason, dur_ms, us)
    if not _on then return end
    log.info("end id=%s name=%s maneuver=%s reason=%s dur=%dms [%dus]",
        _show(id), _show(_names[id]), _show(maneuver), _show(reason), dur_ms or -1, us or -1)
end

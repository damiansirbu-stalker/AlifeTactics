--- at_combat: the intermittent takeover monitor - seizes one NPC for one committed maneuver the actor is
--- party to, then hands back. Doctrine in at_combat_doctrine, graft in xcombat. The monitor is one
--- scheduled pass (_run_monitor, a vanilla time event every MONITOR_PERIOD_SEC) over _npc_states - AT
--- runs zero code on any per-frame path.

local IsStalker, IsWounded, time_global, tostring, pairs = IsStalker, IsWounded, time_global, tostring, pairs
local math_floor, math_random, RegisterScriptCallback, AC_ID = math.floor, math.random, RegisterScriptCallback, AC_ID
local string_match, tonumber = string.match, tonumber

local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine
local show, flag = at_debug.show, at_debug.flag

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"
local BEGIN_PERIOD_MS, UPDATE_PERIOD_MS, END_PERIOD_MS, HIT_FIGHT_MS

-- The monitor pass period. update/end checks run on the pass directly (200ms); the begin period is a
-- multiple of it (600ms = every 3rd pass), so every check fires at its exact configured cadence.
local MONITOR_PERIOD_SEC = 0.2

local COMPANION_INFO = "npcx_is_companion"
-- Defensive default only: every catalog row declares its own timeout, so this is unreachable today;
-- it exists so a future row that omits one caps at a sane bound instead of nil-arithmetic (f011).
local MANEUVER_CAP_MS = 8000
local MAX_CONCURRENT


-- Per-NPC state store: one flat record per tracked NPC, created by _install on spawn, dropped on
-- net_destroy / entity unregister. Existence of a record IS "AT tracks this NPC". Never saved.

local _npc_states = {}
-- ONLINE NPCs currently holding a maneuver. MAX_CONCURRENT caps how many run at once (a runaway
-- failsafe). _drop_gate keeps it accurate on every gate-clearing path (end AND despawn), so a dead NPC
-- can never leak a slot.
local _open_count = 0

-- Scheme fire discipline: while a maneuver drives an NPC, the state machinery asks
-- state_mgr_weapon.get_queue_params for the burst, and every state without an animation-specific
-- entry falls to the caller's generic {5,300,0} override - full-auto on a pistol, a burst on a
-- sniper rifle (state_mgr.script:322). For maneuver-held NPCs we swap that fallback: each query
-- ROLLS burst size and pause inside the engine planner's own per-weapon medium band
-- (xcombat.FIRE_QUEUE, the [fire_queue_params] envelope) - the same fresh-numbers-per-burst
-- variance the vanilla planner has - then multiplies by the Fire Discipline rank factors
-- (at_reaction.queue_scales: one owner, toggle-governed, pure Lua so it works on every exe).
-- The pickoff row swaps the weapon band for its own {1 shot, deliberate pause} band. The
-- animation-tuned entries (state_mgr_weapon state_queue_params) keep their priority, the
-- original's aim_time machinery stays intact, and NPCs we are not driving pass through
-- byte-identical. Bands fill at _load_config; a queue_w_* LTX key pins that kind to fixed
-- values (no roll).
local QUEUE_KINDS = { "w_pistol", "w_shotgun", "w_rifle", "w_smg", "w_sniper" }
local _queue_band_by_kind = {}
local _pickoff_band

local _orig_get_queue_params
-- The kind read adds no crash surface over the original: vanilla get_queue_params makes the
-- same class of member calls (best_weapon, aim_time) on the same NPC at this seam.
local function _patched_get_queue_params(npc, st, override)
    local state = npc and _npc_states[npc:id()]
    if state and state.maneuver then
        local tmr = xprofiler.new_if(at_debug.on()):start()
        local band
        if state.maneuver.name == "pickoff" then
            band = _pickoff_band
        else
            local kind = xcombat.get_weapon_kind(npc)
            band = kind and _queue_band_by_kind[kind]
        end
        if band then
            local size     = math_random(band[1], band[2])
            local interval = math_random(band[3], band[4])
            local sk, ik = at_reaction.queue_scales(npc)
            size = math_floor(size * sk + 0.5)
            if size < 1 then size = 1 end
            interval = math_floor(interval * ik + 0.5)
            override = { size, interval, 0 }
        end
        tmr:stop()
        if at_debug.on() then
            at_debug.dbg("[QUE] id=%d row=%s size=%s interval=%s [%.3fms]",
                npc:id(), state.maneuver.name,
                band and tostring(override[1]) or "vanilla",
                band and tostring(override[2]) or "vanilla", tmr:get_ms())
        end
    end
    return _orig_get_queue_params(npc, st, override)
end


-- Fight detection and the seize gates: one named predicate each.

-- In a fight = the engine selected an enemy, OR a hit landed recently (the far-shooter case, where the enemy is
-- out of the distance gate so best_enemy is still nil but the NPC is plainly under fire). Takes the enemy the
-- caller already read (one best_enemy luabind per begin check, not two).
local function _is_fighting(enemy, state, tg)
    if enemy ~= nil then return true end
    return state.hit_at ~= nil and (tg - state.hit_at) < HIT_FIGHT_MS
end

-- Eligibility: does AT manage this NPC at all. Enabled, inside the share, not a companion. Changes rarely.
local function _manages(npc)
    if not cfg.combat_enabled then return false end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return false end
    return true
end

-- Seizability: armed and not already in a smart cover (vanilla owns that micro). No indoor gate - the
-- takeover fights everywhere; xcombat.is_indoor (a proper roof+walls raycast) stays available if a future
-- maneuver ever needs it, but the takeover does not.
local function _can_seize(npc)
    if xcreature.community(npc) == "zombied" then return false, "zombied" end
    if not xcombat.get_weapon_kind(npc) then return false, "no_weapon" end
    if npc:in_smart_cover() then return false, "smart_cover" end
    -- Never seize an animating body (design law, 2026-07-27): a seize writes state and starts
    -- movement, which under a playing stagger/flinch/overlay is the glide by construction. The
    -- tick defers; the begin check re-asks in 600ms, after the reaction released the body. The
    -- tripping TERM is the returned reason ("stagger"/"overlay"/"flinch"), so the monitor trace
    -- splits the deferral counts by cause with no string built on the live path.
    local busy, why = xcombat.body_busy(npc)
    if busy then return false, why end
    return true
end


-- The maneuver lifecycle: _try_begin_maneuver stages a row and raises the gate; the engine grants control at the
-- grafted action's initialize and calls _begin_maneuver (the first engine write); _update_maneuver re-runs the
-- row's update while it runs; _try_end_maneuver calls _end_maneuver on arrival or the cap.

-- Release the reserved cover vertex. Every state-dropping path calls this (_end_maneuver AND the
-- death/despawn handlers): nothing else ever cleans a dead NPC's claim in db.used_level_vertex_ids.
local function _release_cover(state)
    if state and state.cover_lvid then
        xcombat.release_cover(state.cover_lvid, state.id)
        state.cover_lvid = nil
    end
end

-- Lower the gate and keep the concurrent count accurate. EVERY path that clears an open gate routes here
-- (_end_maneuver AND the death/despawn handlers), so _open_count can never leak a slot to a dead NPC.
local function _drop_gate(state)
    if state and state.gate then
        _open_count = _open_count - 1
        if _open_count < 0 then _open_count = 0 end
        state.gate = false
    end
end

-- Trace-only raw reads. state_mgr keeps its per-NPC record on db.storage; target_state is the state the
-- state machinery is currently driving toward and combat is its own idle-bookkeeping flag. Both are plain
-- table fields (zero luabind), read verbatim into trace lines so a session shows what the state machinery
-- held at each moment without this file interpreting it.
local function _sm_target(id)
    local st = db.storage[id]
    local sm = st and st.state_mgr
    return sm and sm.target_state or nil
end

local function _sm_combat(id)
    local st = db.storage[id]
    local sm = st and st.state_mgr
    return sm and sm.combat or nil
end

-- Metres from the NPC to the maneuver's staged destination vertex, or -1 when there is no destination.
-- Trace-path only (one luabind for the vertex position), always called inside an at_debug.on() gate.
local function _dest_m(npc, dest)
    if not dest then return -1 end
    return npc:position():distance_to(level.vertex_position(dest))
end

-- Debug-only lethality evidence per maneuver window: shots fired (npc_shot_dispersion, once per
-- bullet, ai_stalker_fire.cpp:135-139) vs hits landed on the actor (actor_on_hit_callback carries
-- the shooter). Both handlers bail on the at_debug.on() gate; the counts ride the end trace line.
local _shots = {}
local _hits = {}

-- End the maneuver: lower the gate, clear the row, release any cover the feasibility check reserved, on
-- EVERY exit (arrived, cap, never-begun) so a gate that raised but never ran a maneuver does not leak the
-- reservation in db.used_level_vertex_ids (t136). Also resets the stall tracker: a transaction consumes
-- the situation's accumulated measurement, so `stalled` means "standoff SINCE the last maneuver" and a
-- completed hold negates its own need (a fresh stall must accumulate before the next one).
-- The end line, extracted so _end_maneuver stays a lifecycle function. need_cleared: did the maneuver
-- negate the situation it fired on? Re-run the row's own need with a fresh memo. nil = couldn't check
-- (target gone, or the row opts out); false = the need still holds = churn (the maneuver ran and did
-- not solve its problem); true = cleared. The measured "did it work", not a guess. A row carrying
-- need_recheck=false is exempt (pickoff: its success is the tracker reset that happens after this
-- trace, so the recheck would read pre-reset state and mutate the tracker it measures - r003); the
-- line prints "-" for it. reenters/vertex/dest_m/tgt are the raw reads
-- for the re-entry question; the position half says whether the NPC ever reached what he was sent to.
-- need_cleared label: "-" = the row opts out of the recheck (need_recheck=false: its success IS
-- the reset the recheck would read); else y/n from the recheck, "?" = could not check (target gone).
local function _cleared_label(row, need_cleared)
    if row and row.need_recheck == false then return "-" end
    return flag(need_cleared)
end

local function _trace_end(state, tg, reason, check_us)
    local check = check_us or -1
    local row = state.maneuver
    local npc = xobject.go(state.id)
    local need_cleared
    if row and row.need_recheck ~= false and state.trigger and npc then
        local enemy = xcombat.resolve_enemy(state.enemy_id)
        if enemy then need_cleared = doctrine.recheck_need(row, npc, enemy, state, tg) == nil end
    end
    local vertex, dest_m = "gone", -1
    if npc then vertex, dest_m = npc:level_vertex_id(), _dest_m(npc, state.dest) end
    at_debug.dbg("[CMB] end id=%s name=%s maneuver=%s reason=%s dur=%dms shots=%d hits_actor=%d result=%s" ..
        " need_cleared=%s reenters=%d vertex=%s dest=%s dest_m=%.1f tgt=%s [%dus]",
        show(state.id), show(state.name), show(row and row.name), show(reason),
        math_floor(tg - (state.begin_at or tg)), _shots[state.id] or 0, _hits[state.id] or 0,
        show(state.result or "-"), _cleared_label(row, need_cleared), state.reenters or 0,
        show(vertex), show(state.dest), dest_m, show(_sm_target(state.id)), check)
end

local function _end_maneuver(state, tg, reason, check_us)
    if at_debug.on() then _trace_end(state, tg, reason, check_us) end
    _shots[state.id] = nil
    _hits[state.id] = nil
    state.result = nil
    state.reenters, state.granted_at, state.released_at = nil, nil, nil
    state.tgt_seen, state.tgt_at, state.sent = nil, nil, nil
    state.escape_warned = nil
    state.sight_warned, state.sight_glue_count = nil, nil
    _drop_gate(state)
    state.maneuver = nil
    state.dest = nil
    state.trigger = nil
    state.maneuver_at = nil
    state.begin_at = nil
    state.stall_set = false
    state.pickoff_exit_sqr = nil
    _release_cover(state)
end

-- The begin line, plus a second line only when send_to substituted the destination. Extracted so
-- _begin_maneuver keeps one level of nesting: send_to re-targets an inaccessible vertex to
-- accessible_nearest and falls back to the NPC's own node, and until now nothing recorded that it had.
local function _trace_begin(npc, state, fire, gate, send_us, apply_us)
    if not at_debug.on() then return end
    local maneuver = state.maneuver
    local pos = npc:position()
    at_debug.dbg("[CMB] begin id=%s name=%s maneuver=%s trigger=%s dest=%s sent=%s fire=%s move=%s" ..
        " requested=%s fire_gate=%s cover=%s op=%s tgt=%s vertex=%s pos=%.1f,%.1f dest_m=%.1f [send=%dus apply=%dus]",
        show(state.id), show(state.name), show(maneuver.name), show(state.trigger), show(state.dest),
        show(state.sent), show(fire), show(maneuver.movement), show(maneuver.fire), show(gate), show(state.cover),
        show(xcombat.get_operator(npc)), show(_sm_target(state.id)), show(npc:level_vertex_id()),
        pos.x, pos.z, _dest_m(npc, state.sent or state.dest), send_us, apply_us)
    if state.sent == state.dest then return end
    at_debug.dbg("[CMB] dest_substituted id=%s maneuver=%s asked=%s got=%s own=%s",
        show(state.id), show(maneuver.name), show(state.dest), show(state.sent), show(npc:level_vertex_id()))
end

-- The re-entry line: the grafted action's initialize ran again while this maneuver was already begun.
-- Extracted for the same nesting reason. away= is how long another action held the NPC, from the release
-- stamp, which is the one interval the 200ms operator census cannot resolve.
local function _trace_reenter(npc, state, maneuver, tg)
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] reenter id=%s maneuver=%s n=%d op=%s tgt=%s combat=%s vertex=%s dest=%s dest_m=%.1f" ..
        " since_begin=%dms since_apply=%dms away=%dms",
        show(state.id), show(maneuver.name), state.reenters,
        show(xcombat.get_operator(npc)), show(_sm_target(state.id)), flag(_sm_combat(state.id)),
        show(npc:level_vertex_id()), show(state.dest), _dest_m(npc, state.sent or state.dest),
        math_floor(tg - (state.begin_at or tg)), math_floor(tg - state.maneuver_at),
        state.released_at and math_floor(tg - state.released_at) or -1)
end

-- Begin the maneuver - the first engine write, at the grafted action's initialize (the engine granted control
-- this frame; writing earlier would fight vanilla, which drives until the planner swap). Sets the destination
-- once (the engine walks it), applies the row's combat state once. Target
-- commitment: the maneuver fights the enemy it was STAGED against (state.enemy_id), never whatever the brain
-- re-selected since - a gone/dead target means the maneuver does not begin. The begin write is timed in two
-- parts (send=/apply=, debug only) so a slow begin names which engine call cost it - send_to or apply_state.
local function _begin_maneuver(npc)
    local state = _npc_states[npc:id()]
    if not state or not state.maneuver then return end
    local tg = time_global()
    local maneuver = state.maneuver
    -- RE-ENTRY: the grafted action's initialize ran again while this maneuver was already begun. The
    -- shell's begin CHECK cannot be the source (CHECKS gates begin_maneuver on open == false, so it does
    -- not run while state.gate is up), so every one of these came from the engine re-selecting the
    -- grafted action. The line records the raw reads at that instant and nothing is suppressed - the
    -- re-issue below still runs, exactly as it does today.
    if state.maneuver_at then
        state.reenters = (state.reenters or 0) + 1
        _trace_reenter(npc, state, maneuver, tg)
    end
    -- When the engine granted control this time round, so the next release can report how long we held it.
    state.granted_at = tg
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    if not enemy then _end_maneuver(state, tg, "target_lost") return end
    -- send_to substitutes silently: an inaccessible vertex is re-targeted to accessible_nearest, and a
    -- failure there falls back to the NPC's own node. Keep what it ACTUALLY set, so the trace and any
    -- distance read reflect where he was really sent rather than where the row asked.
    local tmr_send = xprofiler.new_if(at_debug.on()):start()
    state.sent = xcombat.send_to(npc, state.dest)
    tmr_send:stop()
    local tmr_apply = xprofiler.new_if(at_debug.on()):start()
    local fire, gate = doctrine.apply_state(npc, maneuver, enemy)
    tmr_apply:stop()
    state.maneuver_at = tg
    _shots[state.id] = nil
    _hits[state.id] = nil
    _trace_begin(npc, state, fire, gate, math_floor(tmr_send:get_us()), math_floor(tmr_apply:get_us()))
end

-- Shot counter (debug only): one increment per bullet a maneuvering NPC fires.
local function _on_shot_fired(obj)
    if not at_debug.on() or not obj then return end
    local id = obj:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _shots[id] = (_shots[id] or 0) + 1
    end
end

-- Actor-hit counter (debug only): one increment per damaging hit a maneuvering NPC lands on the actor.
local function _on_actor_hit(_, amount, _, who)
    if not at_debug.on() or not who then return end
    if not amount or amount <= 0 then return end
    local id = who:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _hits[id] = (_hits[id] or 0) + 1
    end
end

-- Outcome stamp (debug only): a maneuvering NPC wounding or killing his COMMITTED target marks the
-- maneuver's result, printed on the end trace line (npc_on_enemy_wounded_or_killed cannot fire for
-- the actor as victim, so the player-facing outcome stays the hits_actor counter).
local function _on_enemy_downed(npc, victim)
    if not at_debug.on() or not (npc and victim) then return end
    local state = _npc_states[npc:id()]
    if not (state and state.maneuver) then return end
    if victim:id() ~= state.enemy_id then return end
    state.result = victim:alive() and "wounded" or "killed"
end

-- One spec drives every AT NPC: gate = the per-NPC flag the grafted evaluator polls; on_begin = _begin_maneuver,
-- called once when the grafted action activates. Per-NPC state lives in _npc_states, keyed by id.
-- The gate reads cfg.combat_enabled FIRST: the graft installs for every stalker even when the feature is off,
-- and the engine re-evaluates the grafted evaluator every plan solve (problem_solver actual()), so with the
-- feature disabled the whole crossing is one Lua boolean read - the npc:id() luabind never runs.
-- The engine took the NPC away from the grafted action. Stamped so the NEXT on_begin can report how long
-- someone else held him, which is the one interval no other seam exposes: the operator census samples at
-- 200ms and the re-entry line only fires once control comes back. Trace-only, no behaviour.
local function _on_release(npc)
    local state = _npc_states[npc:id()]
    if not (state and state.maneuver_at) then return end
    local tg = time_global()
    state.released_at = tg
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] release id=%s maneuver=%s held=%dms op=%s tgt=%s vertex=%s",
        show(state.id), show(state.maneuver and state.maneuver.name),
        math_floor(tg - (state.granted_at or tg)),
        show(xcombat.get_operator(npc)), show(_sm_target(state.id)), show(npc:level_vertex_id()))
end

local SPEC = {
    gate = function(npc)
        if not cfg.combat_enabled then return false end
        local state = _npc_states[npc:id()]
        return state ~= nil and state.gate == true
    end,
    on_begin = _begin_maneuver,
    on_release = _on_release,
}

-- Compact cover readout "<in_cover><looked_out><held>/<ray>": the combat planner's stored beliefs
-- (xcombat.get_cover_state - "???" when there is no planner to ask) against the geometric line
-- (xcombat.has_obstacle_to_target from the enemy to the NPC - y = something blocks the line to him). The
-- divergence between the flag half and the ray half is the evidence the cover traces exist to collect
-- (in_cover is arrived-at-my-chosen-point bookkeeping, never a concealment test).
local function _cover_string(in_cover, looked_out, held, blocked)
    return flag(in_cover) .. flag(looked_out) .. flag(held) .. "/" .. (blocked and "y" or "n")
end

-- Debug-only decision trace, gated here so the bridge reads (name, operator, facing, sight, cover) never run
-- when tracing is off. The cover read happens at DECIDE time, before any seize: under a takeover block the
-- planner flags can only decay (the blocked planner cannot run take_cover, the on_best_cover_changed clear
-- still fires), so the pre-seize value is the truthful one - the begin line reprints it from state.cover.
-- rows= is one comma-joined entry per examined catalog row in walk order ("name:situation/stage", built by
-- doctrine.resolve_maneuver); walk= the whole walk's microseconds, check= the begin check's own cost.
local function _trace_decision(npc, state, enemy, result)
    if not at_debug.on() then return end
    local enemy_pos = enemy:position()
    state.enemy_name = xcreature.get_name(enemy:id())
    state.operator   = xcombat.get_operator(npc)
    state.aim_off    = math_floor(xcombat.get_facing_offset(npc, enemy_pos))
    state.seen       = xcombat.sees(npc, enemy)
    local in_cover, looked_out, held = xcombat.get_cover_state(npc)
    state.cover = _cover_string(in_cover, looked_out, held,
        xcombat.has_obstacle_to_target(enemy_pos, npc:position(), xcombat.BODY_Y.STAND_EYE))
    at_debug.dbg("[CMB] monitor id=%s name=%s target=%s(%s) distance=%.1f seen=%s aim=%ddeg operator=%s cover=%s rows=%s walk=%dus check=%dus result=%s",
        show(state.id), show(state.name), show(state.enemy_id), show(state.enemy_name), state.dist or -1,
        state.seen and "yes" or "no", state.aim_off or -1, show(state.operator), show(state.cover),
        show(state.rows), state.walk_us or -1, state.check_us or -1, result or "none")
end

-- The begin-check skip line, for an NPC turned away BEFORE the catalog walk: no_enemy (fighting but
-- no selected enemy), at_cap (the concurrency failsafe), or cannot_seize with the blocking gate as
-- detail (no_weapon / smart_cover), so the log says WHY, not just that it could not. The ":" concat
-- lives inside the gate, so the off path allocates nothing.
local function _trace_monitor_skip(state, result, detail, us)
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] monitor id=%s name=%s target=%s result=%s%s [%dus]",
        show(state.id), show(state.name), show(state.enemy_id), result,
        detail and (":" .. detail) or "", us or -1)
end

-- The seize gates after the fighting read, cheapest first. Returns (skip reason, detail) for the monitor
-- trace, or nil when the NPC may walk the catalog. Which fights qualify is not decided here: every row
-- declares whose problem it answers (vs_actor), and the walk skips rows out of scope - AT seizes only
-- problems the actor is party to, as row data, not as a gate branch.
-- Concurrency cap (failsafe): the field is full, so skip the catalog walk (and its find_destination
-- raycasts) before any expensive read; the NPC retries on its next begin check.
local function _seize_blocked(npc)
    local can_seize, seize_block = _can_seize(npc)
    if not can_seize then return "cannot_seize", seize_block end
    if MAX_CONCURRENT > 0 and _open_count >= MAX_CONCURRENT then return "at_cap" end
    return nil
end

-- Look for a maneuver to begin: managed, fighting, seizable, under the cap, a catalog row picked (its
-- need fired, palette matched, its find_destination yielded a destination). Staging = record the row +
-- destination + the row's committed target and raise the gate; the engine grants control at the next
-- plan solve and calls _begin_maneuver. No engine write happens here - vanilla still drives this frame.
-- There is no reseize cooldown: every row's need states the full problem and the maneuver's success
-- negates it, so the trigger itself is the throttle - a re-fired need is a real, recurred problem.
local function _try_begin_maneuver(npc, state, tg)
    if not _manages(npc) then state.fighting = false return end
    local tmr = xprofiler.new_if(at_debug.on()):start()

    local enemy = npc:best_enemy()
    state.fighting = _is_fighting(enemy, state, tg)
    if not state.fighting then state.stall_set = false state.row_cursor = 1 state.circuit_sit = nil return end
    if at_debug.on() then state.name = npc:name() end

    if not enemy then
        state.enemy_id = nil
        tmr:stop()
        _trace_monitor_skip(state, "no_enemy", nil, tmr:get_us())
        return
    end
    state.enemy_id = enemy:id()

    local blocked, block_detail = _seize_blocked(npc)
    if blocked then
        tmr:stop()
        _trace_monitor_skip(state, blocked, block_detail, tmr:get_us())
        return
    end

    -- resolve_maneuver arbitrates the catalog from the per-NPC cursor (per row: scope -> toggle ->
    -- check_need -> palette -> find_destination). A row whose need is absent falls through in the same
    -- tick; the one find_destination that runs ends the walk and moves the cursor past its row (decline =
    -- defer, pick = the next decision starts below). Returns (maneuver, dest) on a pick and nil
    -- otherwise; it stores the fired situation on state.trigger and the walked rows + timings on
    -- state.rows / state.walk_us.
    local maneuver, dest = doctrine.resolve_maneuver(npc, enemy, state, tg)
    if maneuver then
        -- Late-bind top-up (t148): a scheme can bind to this NPC AFTER install_takeover ran (a gulag
        -- job change re-runs configure_schemes, xr_logic.script:279-295), and its action would carry
        -- no blocking precondition for this NPC's whole life. Top up the per-NPC blocked set right
        -- before the gate goes up - the only moment the hole matters - so every listed competitor
        -- present on the manager NOW is blocked. Idempotent per id (the per-NPC set in xcombat
        -- prevents the duplicate-condition THROW); costs a handful of manager:action lookups per
        -- staging, only for ids that never bound.
        xcombat.topup_takeover_block(npc)
        state.gate = true
        _open_count = _open_count + 1
        state.maneuver = maneuver
        state.dest = dest
        state.maneuver_at = nil
        state.begin_at = tg
    end
    tmr:stop()
    if at_debug.on() then state.check_us = math_floor(tmr:get_us()) end
    _trace_decision(npc, state, enemy, maneuver and maneuver.name)
    -- A vs_actor row commits to the ACTOR: its problem is the actor, not the selected enemy, so the
    -- maneuver aims at, ends on, and resolves the actor for its whole life. Staged AFTER the decision
    -- trace so the trace's (id, name, distance) triple all read the selected enemy.
    if maneuver and maneuver.vs_actor then state.enemy_id = AC_ID end
end

-- Sight-glue watchdog (debug-gated by the caller; the escape-WARN shape): a firing row's
-- committed-target sight write (xcombat set_combat, f015) makes a foreign sight owner impossible
-- while the maneuver applies - so 3 consecutive interval samples serving another object's sight
-- are a self-reporting regression, named once per maneuver. The caller samples BEFORE the row's
-- re-apply (a post-apply read echoes our own write); the counter resets on any clean sample and
-- clears at maneuver end.
local function _check_sight_glue(state, maneuver, sight_id)
    if state.sight_warned then return end
    if maneuver.fire ~= xcombat.FIRE and maneuver.fire ~= xcombat.SNIPE then return end
    if sight_id == nil or sight_id == state.enemy_id then
        state.sight_glue_count = nil
        return
    end
    state.sight_glue_count = (state.sight_glue_count or 0) + 1
    if state.sight_glue_count < 3 then return end
    state.sight_warned = true
    at_debug.warn("[CMB] sight_glue id=%d maneuver=%s staged=%d sight=%d - committed-target sight lost (f015 regression)",
        state.id, maneuver.name, state.enemy_id, sight_id)
end

-- Run the maneuver's own update from its catalog row (a firing row re-checks its shot, flee re-asserts its
-- holster, a row without one does nothing). Begun-guarded: no engine write before _begin_maneuver ran.
-- Target commitment: the row keeps aiming at the STAGED enemy (state.enemy_id) for the maneuver's whole
-- life; a gone/dead target applies READY here and the end check closes the maneuver on its next period.
-- The debug trace is the mid-maneuver aim evidence: sight to the staged target, body-to-target angle,
-- applied fire + gate.
local function _update_maneuver(npc, state, tg)
    local maneuver = state.maneuver
    if not maneuver or not state.maneuver_at then return end
    -- Escape watchdog (LIVE, not debug-gated): the block list is a denylist against an open set, so a
    -- scheme this install adds later - or one that bound after the graft (the t148 late-bind case) -
    -- can hold the top-level slot under an open maneuver with no error anywhere. One WARN per maneuver
    -- names the foreign operator so a silent escape becomes a reportable log line. The known, designed
    -- non-takeover owners are excluded: death never reaches here (_run_npc_checks ends on dead first)
    -- and wounded ends on this same pass via _end_reason's wounded term. Cost on the healthy path: one
    -- current_action_id compare per update check.
    if not state.escape_warned and not xcombat.is_takeover_current(npc)
        and not (IsWounded(npc) or xcombat.is_staggering(npc)) then
        state.escape_warned = true
        at_debug.warn("[CMB] escape id=%d maneuver=%s op=%s - an unblocked action holds the slot under an open maneuver (denylist gap, t148)",
            state.id, maneuver.name, xcombat.get_operator(npc))
    end
    if not maneuver.update then return end
    -- A reloading weapon: leave the applied state completely alone this pass. Re-applying ANY
    -- state mid-reload costs a weapon-pose transition - the discipline's READY degrade at reload
    -- start plus FIRE at reload end was 2 visible dips per reload, read as a "reload shuffle" on
    -- small mags (field session 2026-07-23, single-weapon case). The state applied BEFORE the
    -- reload stays; the mag-swap animation plays inside it; the begin path is untouched (a
    -- maneuver STARTING mid-reload still applies its state once, with the discipline's degrade
    -- keeping the fire goal off the reloading gun).
    if xcombat.is_reloading(npc) then return end
    -- An animating body: leave the applied state alone this pass, same shape as the reload skip -
    -- a re-apply would fight the playing reaction. The stagger, the flinch, and a script overlay
    -- all PAUSE here and the maneuver resumes when the animation releases the body; only the real
    -- wounded-down state (IsWounded) ends the maneuver, on the end check. The pause line keeps the
    -- skipped passes visible in a debug log (otherwise a paused maneuver reads as silence).
    local busy, busy_why = xcombat.body_busy(npc)
    if busy then
        at_debug.dbg("[CMB] pause id=%s maneuver=%s why=%s", show(state.id), show(maneuver.name), show(busy_why))
        return
    end
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    -- The sight sample is taken BEFORE the row re-applies its state: the re-apply writes the
    -- committed-target sight itself (xcombat set_combat, f015), so a read taken after it echoes
    -- our own write and could never see a foreign owner - the sample must show what the 200ms
    -- interval LEFT in the slot. Debug-only: zero reads, zero lines when tracing is off.
    local sight_id, sight_mode
    if at_debug.on() then
        sight_id, sight_mode = xcombat.get_sight_target(npc)
        -- Enemy-guarded at the call: with the target gone the maneuver is one end check from
        -- closing and a foreign sight is then legitimate, not glue.
        if enemy then _check_sight_glue(state, maneuver, sight_id) end
    end
    local tmr = xprofiler.new_if(at_debug.on()):start()
    local fire, gate = maneuver.update(npc, maneuver, enemy)
    tmr:stop()
    if not at_debug.on() then return end
    local us = math_floor(tmr:get_us())
    if not enemy then
        at_debug.dbg("[CMB] update id=%s name=%s maneuver=%s target=nil fire=%s fire_gate=%s [%dus]",
            show(state.id), show(state.name), show(maneuver.name), show(fire), show(gate), us)
        return
    end
    -- The 200ms sample of who actually holds the top-level slot while AT believes it is driving, plus the
    -- state machinery's own target and the raw geometry. op is the engine's current action id mapped to a
    -- name: any value other than "takeover" means the graft was NOT current at this sample.
    -- sight= is the sight manager's current object (tgt = the staged target, an id = someone else, - = not
    -- an object) and stype= its mode - the identity+mode pair the direction evaluator gates fire on
    -- (never the body angle), so a zero-shot hold shows here whether the look order was ever accepted.
    local pos = npc:position()
    local tgt = _sm_target(state.id)
    local sight_label = sight_id and (sight_id == state.enemy_id and "tgt" or tostring(sight_id)) or "-"
    -- One line per TRANSITION of the state machinery's target, not per sample: this is where our applied
    -- combat state being replaced (notably by "idle") shows up with a timestamp, instead of having to be
    -- diffed out of the 200ms samples below.
    if tgt ~= state.tgt_seen then
        at_debug.dbg("[CMB] tgt_change id=%s maneuver=%s from=%s to=%s op=%s held=%dms",
            show(state.id), show(maneuver.name), show(state.tgt_seen), show(tgt),
            show(xcombat.get_operator(npc)), math_floor(tg - (state.tgt_at or tg)))
        state.tgt_seen, state.tgt_at = tgt, tg
    end
    at_debug.dbg("[CMB] update id=%s name=%s maneuver=%s target=%s(%s) seen=%s aim=%ddeg sight=%s stype=%s"
        .. " fire=%s fire_gate=%s op=%s tgt=%s mt=%s vertex=%s pos=%.1f,%.1f dest_m=%.1f reenters=%d [%dus]",
        show(state.id), show(state.name), show(maneuver.name), show(enemy:id()), show(xcreature.get_name(enemy:id())),
        xcombat.sees(npc, enemy) and "yes" or "no", math_floor(xcombat.get_facing_offset(npc, enemy:position())),
        sight_label, show(sight_mode),
        show(fire), show(gate), show(xcombat.get_operator(npc)), show(tgt),
        show(npc:movement_type()), show(npc:level_vertex_id()), pos.x, pos.z,
        _dest_m(npc, state.sent or state.dest), state.reenters or 0, us)
end

-- Movers end on arrival; the cap (from begin_at) ends everything, so a gate that raised but never began a
-- maneuver cannot wedge the NPC. Holds have no arrival and end only on the cap. A row's check_end is its
-- PREMISE: the need terms that must hold for the transaction's whole life (pickoff: not under fire, not
-- targeted, enemy outside his effective range) - a broken premise ends the maneuver now, not at the cap. A feature turned off mid-maneuver
-- ends here too: SPEC.gate already handed the NPC back to vanilla, so the row's update must stop driving
-- it - ending drops state.gate, which stops _update_maneuver on the same pass.
-- Why an open maneuver should end NOW, or nil to keep running: the row's premise (check_end, a broken
-- premise names itself), arrival for begun movers, the time cap for everything - a staged-never-granted
-- gate ends on the cap too, so it cannot wedge the NPC.
local function _end_reason(npc, enemy, state, tg)
    -- A wounded NPC belongs to the wounded scheme: the graft's own sidor_wounded_base precondition
    -- already handed him over (55 op=sidor_act_wounded_base update samples while maneuvers stayed
    -- open, 2026-07-27 session), so the transaction ends NOW instead of re-applying state onto an
    -- NPC AT no longer drives - and the cover claim releases through the normal path (f003).
    -- IsWounded ONLY (user ruling 2026-07-28): the crit stagger (xcombat.is_staggering) is a ~1s
    -- hit reaction, not the wounded state - it pauses the maneuver via the body_busy skip instead
    -- of ending it, so a rout or kite survives a heavy hit.
    if IsWounded(npc) then return "wounded" end
    local maneuver = state.maneuver
    local begun = maneuver ~= nil and state.maneuver_at ~= nil
    local broken = begun and maneuver.check_end and maneuver.check_end(npc, enemy, state, tg)
    if broken then return broken end
    if begun and maneuver.ends_on == "arrival" and xcombat.is_arrived(npc) then return "arrived" end
    if (tg - (state.begin_at or tg)) >= ((maneuver and maneuver.timeout) or MANEUVER_CAP_MS) then return "cap" end
    return nil
end

local function _try_end_maneuver(npc, state, tg)
    if not _manages(npc) then _end_maneuver(state, tg, "disabled") return end
    -- Target commitment: the staged enemy died or despawned - hand back now, vanilla picks the next
    -- fight. Only for a BEGUN maneuver; a staged-never-granted gate still ends on the cap in _end_reason.
    local enemy
    if state.maneuver and state.maneuver_at then
        enemy = xcombat.resolve_enemy(state.enemy_id)
        if not enemy then
            _end_maneuver(state, tg, "target_lost")
            return
        end
    end
    local tmr = xprofiler.new_if(at_debug.on()):start()
    local reason = _end_reason(npc, enemy, state, tg)
    tmr:stop()
    if reason then _end_maneuver(state, tg, reason, math_floor(tmr:get_us())) end
end


-- The check catalog: every timed operation is one row { name, period, open, run }; open is the state.gate
-- value the check requires (false = no maneuver open, true = one running). Built in _load_config, after
-- the periods are read.

local CHECKS

local function _build_checks()
    CHECKS = {
        { name = "begin_maneuver",  period = BEGIN_PERIOD_MS,  open = false, run = _try_begin_maneuver },
        { name = "update_maneuver", period = UPDATE_PERIOD_MS, open = true,  run = _update_maneuver    },
        { name = "end_maneuver",    period = END_PERIOD_MS,    open = true,  run = _try_end_maneuver   },
    }
end

-- Run one check: bail unless its own period elapsed, else stamp and run.
local function _run_check(check, npc, state, tg)
    if tg - (state.ran_at[check.name] or 0) < check.period then return end
    state.ran_at[check.name] = tg
    check.run(npc, state, tg)
end

-- The monitor pass, a vanilla time event every MONITOR_PERIOD_SEC: for each tracked NPC, resolve the
-- object and run whichever checks are due. The per-frame cost of the whole monitor is ONE timer compare
-- inside vanilla's own ProcessEventQueue walk (_g.script:364, driven from the actor update at
-- bind_stalker_ext.script:26); the real work runs 5 times a second total, never per frame, never per NPC
-- per frame. xobject.go returns nil for a gone id (nil-guarded level.object_by_id, a net_Find hash; level_script.cpp:131-138).
-- The pass re-arms FIRST: ProcessEventQueue has no error protection, so an error mid-pass with the event
-- still expired would re-fire and re-error every frame, starving every time event in the game (the
-- 2026-07-11 frozen-HUD loop); re-armed, a fault costs one aborted pass and the queue heals itself.
local _monitor_active = false

-- Tier-1 coarse perf span (todo-all-mods-tracing t05): ONE timer around the WHOLE maneuver pass, never
-- per-NPC or per-check - the per-check detail stays in the [CMB] lines (Tier-2). Accumulates over a
-- window and emits a single [MON] summary (tick avg/max + NPCs per pass). Noop below DEBUG.
local MON_FLUSH_MS = 5000
local _mon = { ms = 0, max = 0, ticks = 0, last = 0 }

-- Fold one maneuver pass into the coarse window, flushing a single [MON] summary per window. The pass
-- fires every MONITOR_PERIOD_SEC; the 600ms begin check folds into every 3rd pass, so tick_max captures
-- the begin-included heavy pass while tick_avg blends all passes. Called only under the DEBUG gate.
local function _record_pass(ms, tg)
    if _mon.last == 0 then _mon.last = tg end
    _mon.ms = _mon.ms + ms
    if ms > _mon.max then _mon.max = ms end
    _mon.ticks = _mon.ticks + 1
    if tg - _mon.last >= MON_FLUSH_MS then
        at_debug.dbg("[MON] window=%.0fs ticks=%d tick_avg=%.3fms tick_max=%.3fms",
            (tg - _mon.last) / 1000, _mon.ticks, _mon.ms / _mon.ticks, _mon.max)
        _mon.ms, _mon.max, _mon.ticks, _mon.last = 0, 0, 0, tg
    end
end

-- One NPC's slice of the pass: run whichever checks match its open/closed state and are due.
-- ALIVE only - the engine combat binds (see, fire_make_sense, best_enemy) fault on a dead stalker's
-- torn-down AI state (the smart_cast guards type, not liveness). A tracked NPC found dead ends its
-- maneuver through the normal path (gate, cover, count, the traced "died" reason - 4 begins with no
-- end lines in the 2026-07-11 session were exactly these); the roster entry itself dies on
-- net_destroy/unregister.
local function _run_npc_checks(npc, state, tg)
    if not npc:alive() then
        if state.maneuver then _end_maneuver(state, tg, "died") end
        _drop_gate(state)
        _release_cover(state)
        return
    end
    local open = state.gate == true
    for i = 1, #CHECKS do
        local check = CHECKS[i]
        if check.open == open then _run_check(check, npc, state, tg) end
    end
end

local function _run_monitor()
    if not _monitor_active then return true end
    ResetTimeEvent("at_combat", "monitor", MONITOR_PERIOD_SEC)
    local tg = time_global()
    local tmr = xprofiler.new_if(at_debug.on()):start()
    for id, state in pairs(_npc_states) do
        local npc = xobject.go(id)
        if npc then _run_npc_checks(npc, state, tg) end
    end
    tmr:stop()
    if at_debug.on() then _record_pass(tmr:get_ms(), tg) end
end

local function _start_monitor()
    if _monitor_active then return end
    _monitor_active = true
    RemoveTimeEvent("at_combat", "monitor")
    CreateTimeEvent("at_combat", "monitor", MONITOR_PERIOD_SEC, _run_monitor)
end

local function _stop_monitor()
    _monitor_active = false
    RemoveTimeEvent("at_combat", "monitor")
end


-- Public API consumed by at_hud and the at_test observer.

--- Current maneuver name for an NPC, or nil when AT is not driving one.
function get_maneuver(id)
    local state = _npc_states[id]
    return state and state.maneuver and state.maneuver.name
end


-- Lifecycle: install on spawn, stamp the far-shooter fight entry on hit, clean up on destroy / unregister.

local function _install(npc)
    if not npc or not IsStalker(npc) then return end
    local id = npc:id()
    if _npc_states[id] then return end
    _npc_states[id] = { id = id, ran_at = {} }
    xcombat.install_takeover(npc, SPEC)
    if at_debug.on() then at_debug.dbg("[CMB] installed id=%d name=%s", id, npc:name()) end
end

-- A hit stamps the fight clock so a far shooter - out of the engine's enemy-distance gate, best_enemy still nil -
-- reads as fighting on the next begin check.
local function _on_hit(npc, amount)
    if not npc or not amount or amount <= 0 then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    state.hit_at = time_global()
end

-- Reload edges (npc_on_weapon_reload_start/stop, the n031 engine events): stamp the NPC's reload state
-- so the reload_cover row's need is a pure-Lua read on the walk. The stop edge is best-effort (a weapon
-- detached mid-reload fires nothing), so the stamp carries reload_at and the row bounds it with a
-- staleness window plus the authoritative xcombat.is_reloading confirm at feasibility. On an exe without
-- the events the stamps never set and the row is inert (self-gating; INACTIVE logged at on_game_start).
-- Debug [RELOAD] edge traces: stop held-ms near the mag-swap duration = the maneuver's state force
-- left the engine reload running; stop right after the row's "taken" = it canceled it. The start
-- line carries the weapon and its mag_left - a near-full mag is the planner topping up, not a
-- misfire (the evidence the old at_jam npc_on_update poll existed for).
local function _on_reload_start(npc, wpn)
    if not npc then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    state.reloading = true
    state.reload_at = time_global()
    if at_debug.on() then
        at_debug.dbg("[RELOAD] start id=%d wpn=%s mag_left=%d fighting=%s", state.id,
            wpn and wpn:section() or "?", wpn and wpn:get_ammo_in_magazine() or -1,
            npc:best_enemy() and "yes" or "no")
    end
end

local function _on_reload_stop(npc)
    if not npc then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    if at_debug.on() then
        at_debug.dbg("[RELOAD] stop id=%d held=%dms", npc:id(),
            state.reload_at and (time_global() - state.reload_at) or -1)
    end
    state.reloading = nil
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    xcombat.release_takeover(npc)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
    _shots[id] = nil
    _hits[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    -- Clear xcombat's install guard too: an id unregistered WITHOUT a prior net_destroy would leave a stale
    -- guard there and the recycled id would silently skip its next graft.
    xcombat.release_takeover_id(id)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
    _shots[id] = nil
    _hits[id] = nil
end

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    BEGIN_PERIOD_MS     = read_int("begin_period_ms",     600)
    UPDATE_PERIOD_MS    = read_int("update_period_ms",    200)
    END_PERIOD_MS       = read_int("end_period_ms",       200)
    HIT_FIGHT_MS        = read_int("hit_fight_ms",        5000)
    MAX_CONCURRENT      = read_int("max_concurrent_maneuvers", 20)
    for i = 1, #QUEUE_KINDS do
        local kind = QUEUE_KINDS[i]
        local min_s, max_s, min_i, max_i = xcombat.get_fire_queue(kind, "medium")
        local band = { min_s, max_s, min_i, max_i }
        local raw = ini:r_string_ex(LTX_SECTION, "queue_" .. kind)
        local o_size, o_interval = string_match(raw or "", "^%s*(%d+)%s*,%s*(%d+)")
        if o_size then
            -- An LTX key pins this kind to fixed values: a degenerate band, no roll.
            local s, iv = tonumber(o_size), tonumber(o_interval)
            band = { s, s, iv, iv }
        end
        _queue_band_by_kind[kind] = band
    end
    _pickoff_band = { 1, 1,
        read_int("pickoff_interval_min_ms", 1500),
        read_int("pickoff_interval_max_ms", 2000) }
    _build_checks()
end

local function _refresh_log()
    at_debug.refresh()
end

-- The monitor runs only while the feature is on. Turning it off mid-game first ends every open maneuver
-- through the normal path (gate down, cover released, count accurate) - SPEC.gate already handed those NPCs
-- back to vanilla at the next plan solve - then stops the pass, so a disabled feature costs zero.
local function _apply_enabled()
    if cfg.combat_enabled then
        _start_monitor()
        return
    end
    local tg = time_global()
    for _, state in pairs(_npc_states) do
        if state.maneuver then _end_maneuver(state, tg, "disabled") end
    end
    _stop_monitor()
end

local function _on_option_change()
    _refresh_log()
    _apply_enabled()
end

local function _on_first_update()
    _open_count = 0
    _refresh_log()
    -- Time events do not survive a save load (_g.script header), so the monitor arms here, per session.
    _apply_enabled()
    at_debug.info("Combat monitor initialized (enabled=%s dbg=%s cap=%d queue_patch=%s)",
        tostring(cfg.combat_enabled), tostring(at_debug.on()), MAX_CONCURRENT,
        _orig_get_queue_params and "installed" or "missing")
end

function on_game_start()
    _load_config()
    doctrine.load_config()
    -- Function-level monkey-patch (script-loading.md pattern): the state machinery has no callback
    -- at the queue-params seam. Install-once guard for defensive re-entry; the module reference
    -- auto-loads in-game, and an environment without it (test harness) skips the patch.
    if not _orig_get_queue_params and state_mgr_weapon and state_mgr_weapon.get_queue_params then
        _orig_get_queue_params = state_mgr_weapon.get_queue_params
        state_mgr_weapon.get_queue_params = _patched_get_queue_params
    end
    -- Declare the takeover to state_mgr, through vanilla's own extension point. Its idle evaluator forces
    -- its combat flag false on every evaluation where the current action is absent from this table
    -- (state_mgr.script:93-96), which leaves state_mgr_to_idle_combat applicable for the whole life of a
    -- maneuver - and that action re-sends the NPC to his own vertex, clears his animations and forces
    -- state "idle" (:194-210), deleting whatever the row applied. The table's own comment says a scheme
    -- that drives body and movement state itself belongs here; xrs_facer registers itself the same way
    -- (xrs_facer.script:29-32). Additive, idempotent, and nothing is removed on teardown because the
    -- graft is permanent for the NPC's life.
    if state_mgr and state_mgr.combat_action_ids and xcombat.TAKEOVER_ID then
        state_mgr.combat_action_ids[xcombat.TAKEOVER_ID] = true
    end
    RegisterScriptCallback("npc_on_net_spawn",            _install)
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_shot_dispersion",         _on_shot_fired)
    RegisterScriptCallback("actor_on_hit_callback",       _on_actor_hit)
    RegisterScriptCallback("npc_on_enemy_wounded_or_killed", _on_enemy_downed)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default",  _on_option_change)
    if not (xcombat.on_reload_start(_on_reload_start) and xcombat.on_reload_stop(_on_reload_stop)) then
        at_debug.info("Reload Cover INACTIVE: exe lacks the NPC reload events (PR #611); row inert")
    end
end

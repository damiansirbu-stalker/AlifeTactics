-- =========================================================================
-- Target resolvers (existing 7 + 2 new for short-stride movement)
-- =========================================================================

local function _claim(lvid, id) return xcombat.claim_cover(lvid, id) end
local function _release(lvid, id) xcombat.release_cover(lvid, id) end

local function _lat_off(ctx)
    return xcombat.lateral_offset(ctx.bucket, ctx.dx, ctx.dz, ctx.dist, SQUAD_LATERAL_STEP_M, SQUAD_LATERAL_BUCKETS)
end

local INVALID_LVID   = xcombat.INVALID_LVID
local COVER_SEARCH_R = 15
local COVER_NEAR_R   = 10
local COVER_WIDE_R   = 30

local function _resolve_cover_step_fwd(npc, ctx)
    local step = ADVANCE_STEP_M
    local target_pos
    if ctx.dist <= step then
        target_pos = vector():set(ctx.ene_pos.x, ctx.npc_pos.y, ctx.ene_pos.z)
    else
        local k = step / ctx.dist
        target_pos = vector():set(
            ctx.npc_pos.x + ctx.dx * k,
            ctx.npc_pos.y,
            ctx.npc_pos.z + ctx.dz * k)
    end
    local ox, oz = _lat_off(ctx)
    target_pos.x = target_pos.x + ox
    target_pos.z = target_pos.z + oz
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local lvid = xcombat.cover_vertex(npc, target_pos, ctx.ene_pos, COVER_SEARCH_R)
        if lvid then return lvid end
    end
    if ctx.dist > 0 then
        local dir = vector():set(ctx.dx / ctx.dist, 0, ctx.dz / ctx.dist)
        local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, step)
        if fb then return fb end
    end
    return nil, "no_cover_no_path"
end

local function _resolve_cover_nearest(npc, ctx)
    local ox, oz = _lat_off(ctx)
    local search_pos = vector():set(ctx.npc_pos.x + ox, ctx.npc_pos.y, ctx.npc_pos.z + oz)
    local lvid = xcombat.cover_vertex(npc, search_pos, ctx.ene_pos, COVER_NEAR_R)
    if lvid then return lvid end
    lvid = xcombat.cover_vertex(npc, search_pos, ctx.ene_pos, COVER_WIDE_R)
    if lvid then return lvid end
    return nil, "no_cover"
end

local function _resolve_step_away(npc, ctx)
    if ctx.dist <= 0 then return nil, "adjacent" end
    local step = STEP_AWAY_M
    local k = step / ctx.dist
    local target_pos = vector():set(
        ctx.npc_pos.x - ctx.dx * k,
        ctx.npc_pos.y,
        ctx.npc_pos.z - ctx.dz * k)
    local ox, oz = _lat_off(ctx)
    target_pos.x = target_pos.x + ox
    target_pos.z = target_pos.z + oz
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local lvid = xcombat.cover_vertex(npc, target_pos, ctx.ene_pos, COVER_SEARCH_R)
        if lvid then return lvid end
    end
    local dir = vector():set(-ctx.dx / ctx.dist, 0, -ctx.dz / ctx.dist)
    local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, step)
    if fb then return fb end
    return nil, "no_cover_no_path"
end

local function _resolve_charge_enemy(npc, ctx)
    local elvid = ctx.enemy:level_vertex_id()
    if elvid and elvid < INVALID_LVID and npc:accessible(elvid) then return elvid end
    if ctx.dist > 0 then
        local dir = vector():set(ctx.dx / ctx.dist, 0, ctx.dz / ctx.dist)
        local step = math_min(ctx.dist, CHARGE_STEP_M)
        local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, step)
        if fb then return fb end
    end
    return nil, "no_path_to_enemy"
end

local function _resolve_hold(_npc, ctx, self)
    return self.target_lvid or ctx.npc_lvid
end

local function _resolve_cover_flank(npc, ctx)
    if ctx.dist <= 0 then return nil, "adjacent" end
    local sign = (ctx.id % 2 == 0) and 1 or -1
    local nx, nz = ctx.dx / ctx.dist, ctx.dz / ctx.dist
    local px, pz = -nz * sign, nx * sign
    local target_pos = vector():set(
        ctx.npc_pos.x + px * FLANK_LATERAL_M + nx * FLANK_FORWARD_M,
        ctx.npc_pos.y,
        ctx.npc_pos.z + pz * FLANK_LATERAL_M + nz * FLANK_FORWARD_M)
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local lvid = xcombat.cover_vertex(npc, target_pos, ctx.ene_pos, COVER_SEARCH_R)
        if lvid then return lvid end
    end
    local dir = vector():set(px, 0, pz)
    local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, FLANK_LATERAL_M)
    if fb then return fb end
    return nil, "no_flank_room"
end

local function _resolve_flee_far(npc, ctx)
    if ctx.dist <= 0 then return nil, "adjacent" end
    local dir = vector():set(-ctx.dx / ctx.dist, 0, -ctx.dz / ctx.dist)
    local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, FLEE_STEP_M)
    if fb then return fb end
    return nil, "no_flee_room"
end

local function _resolve_step_toward_short(npc, ctx)
    if ctx.dist <= 0 then return nil, "adjacent" end
    local dir = vector():set(ctx.dx / ctx.dist, 0, ctx.dz / ctx.dist)
    local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, STEP_SHORT_M)
    if fb then return fb end
    return nil, "no_step_room"
end

local function _resolve_step_away_short(npc, ctx)
    if ctx.dist <= 0 then return nil, "adjacent" end
    local dir = vector():set(-ctx.dx / ctx.dist, 0, -ctx.dz / ctx.dist)
    local fb = xcombat.vertex_toward(npc, ctx.npc_lvid, dir, STEP_SHORT_M)
    if fb then return fb end
    return nil, "no_step_room"
end

local TARGET_RESOLVERS = {
    cover_step_fwd     = _resolve_cover_step_fwd,
    cover_nearest      = _resolve_cover_nearest,
    step_away          = _resolve_step_away,
    charge_enemy       = _resolve_charge_enemy,
    cover_flank        = _resolve_cover_flank,
    flee_far           = _resolve_flee_far,
    hold               = _resolve_hold,
    step_toward_short  = _resolve_step_toward_short,
    step_away_short    = _resolve_step_away_short,
}


-- =========================================================================
-- State machine reads (each hysteresis self-contained)
-- =========================================================================

local CONTACT_DEBOUNCE_MS = 500
local THREAT_HIT_LOCK_MS  = 3000
local THREAT_SEE_DEBOUNCE_MS = 1000
local RANGE_DEADBAND_M = 3
local POSITION_MISS_DEBOUNCE = 3
local FRIENDLY_CLEAR_DEBOUNCE = 2
local HEALTH_WOUNDED_BELOW = 0.50
local HEALTH_HEALTHY_ABOVE = 0.55

local function _read_health(npc, state)
    local hp = npc.health
    if state.health == "HEALTHY" then
        if hp < HEALTH_WOUNDED_BELOW then return "WOUNDED" end
        return "HEALTHY"
    end
    if hp > HEALTH_HEALTHY_ABOVE then return "HEALTHY" end
    return "WOUNDED"
end

local function _read_environment(npc_pos, npc_lvid, state)
    if state._env_lvid == npc_lvid then return state.environment end
    state._env_lvid = npc_lvid
    if xcombat.is_indoor(npc_pos) then return "INDOOR" end
    return "OUTDOOR"
end

local function _read_contact(npc, enemy, state, tg)
    if npc:see(enemy) then
        state._contact_lost_at = nil
        return "VISUAL"
    end
    if state.contact == "NO_VISUAL" then return "NO_VISUAL" end
    if not state._contact_lost_at then
        state._contact_lost_at = tg
        return "VISUAL"
    end
    if tg - state._contact_lost_at < CONTACT_DEBOUNCE_MS then return "VISUAL" end
    state._contact_lost_at = nil
    return "NO_VISUAL"
end

local function _read_squad(state)
    if not state.squad_id then return "INTACT" end
    local alive   = xcombat.squad_alive_count(state.squad_id)
    local initial = xcombat.squad_initial(state.squad_id) or alive
    if initial < 1 then return "INTACT" end
    local ratio = alive / initial
    if ratio >= 0.75 then return "INTACT" end
    if ratio >= 0.25 then return "DEPLETED" end
    return "DECIMATED"
end

local function _read_friendly_line(npc, npc_pos, ene_pos, state)
    if xcombat.friendly_in_line(npc, npc_pos, ene_pos, FRIENDLY_LINE_THRESH_M) then
        state._friendly_clear_count = 0
        return "BLOCKED"
    end
    if state.friendly_line == "CLEAR" then return "CLEAR" end
    state._friendly_clear_count = (state._friendly_clear_count or 0) + 1
    if state._friendly_clear_count < FRIENDLY_CLEAR_DEBOUNCE then return "BLOCKED" end
    return "CLEAR"
end

local function _read_range_fit(state, dist)
    local rng = xcombat.weapon_range(state.weapon_kind)
    if state.range_fit == "IN_ZONE" then
        if dist < rng.min then return "TOO_CLOSE" end
        if dist > rng.max then return "TOO_FAR" end
        return "IN_ZONE"
    end
    if state.range_fit == "TOO_CLOSE" then
        if dist > rng.min + RANGE_DEADBAND_M then return "IN_ZONE" end
        return "TOO_CLOSE"
    end
    if dist < rng.max - RANGE_DEADBAND_M then return "IN_ZONE" end
    return "TOO_FAR"
end

local function _read_threat(npc, enemy, state, tg)
    if state._threat_hit_at and tg - state._threat_hit_at < THREAT_HIT_LOCK_MS then
        return "THREATENED"
    end
    if enemy:see(npc) then
        state._threat_see_lost_at = nil
        return "THREATENED"
    end
    if state.threat == "SAFE" then return "SAFE" end
    if not state._threat_see_lost_at then
        state._threat_see_lost_at = tg
        return "THREATENED"
    end
    if tg - state._threat_see_lost_at < THREAT_SEE_DEBOUNCE_MS then return "THREATENED" end
    state._threat_see_lost_at = nil
    return "SAFE"
end

local function _read_position(npc_pos, ene_pos, state)
    if xcombat.has_occluder_between(npc_pos, ene_pos) then
        state._position_miss_count = 0
        return "IN_COVER"
    end
    if state.position == "EXPOSED" then return "EXPOSED" end
    state._position_miss_count = (state._position_miss_count or 0) + 1
    if state._position_miss_count < POSITION_MISS_DEBOUNCE then return "IN_COVER" end
    return "EXPOSED"
end


-- =========================================================================
-- State init + delta detection (reads in cost order, all updated each tick)
-- =========================================================================

local function _init_state(npc)
    local id = npc:id()
    local squad = xsquad.get_squad_by_member(id)
    local squad_id = squad and squad.id or nil
    if squad_id and not xcombat.squad_initial(squad_id) then
        xcombat.squad_initial(squad_id, xcombat.squad_alive_count(squad_id))
    end
    return {
        npc_id        = id,
        squad_id      = squad_id,
        community     = _community[id] or character_community(npc) or "stalker",
        weapon_kind   = xcombat.weapon_kind(npc),
        health        = "HEALTHY",
        environment   = "OUTDOOR",
        contact       = "NO_VISUAL",
        squad         = "INTACT",
        friendly_line = "CLEAR",
        range_fit     = "IN_ZONE",
        threat        = "SAFE",
        position      = "EXPOSED",
    }
end

-- Track a single variable update; returns first delta key (or carries through).
local function _track(state, key, new_value, first)
    if new_value == state[key] then return first end
    state[key] = new_value
    return first or key
end

local function _update_state(npc, enemy, state, tg, ctx)
    state.weapon_kind = xcombat.weapon_kind(npc)
    local first = nil
    first = _track(state, "health",        _read_health(npc, state),                                first)
    first = _track(state, "environment",   _read_environment(ctx.npc_pos, ctx.npc_lvid, state),     first)
    first = _track(state, "contact",       _read_contact(npc, enemy, state, tg),                    first)
    first = _track(state, "squad",         _read_squad(state),                                      first)
    first = _track(state, "friendly_line", _read_friendly_line(npc, ctx.npc_pos, ctx.ene_pos, state), first)
    first = _track(state, "range_fit",     _read_range_fit(state, ctx.dist),                        first)
    first = _track(state, "threat",        _read_threat(npc, enemy, state, tg),                     first)
    first = _track(state, "position",      _read_position(ctx.npc_pos, ctx.ene_pos, state),         first)
    return first
end


-- =========================================================================
-- Rule lists per faction x environment
-- =========================================================================

local MILITARY_OUTDOOR = {
    { when = function(s) return s.health == "WOUNDED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.health == "WOUNDED" and s.squad == "DECIMATED" end,
      do_ = "RETREAT_OPEN_STAND" },
    { when = function(s) return s.health == "WOUNDED" end,
      do_ = "RETREAT_COVER_CROUCH" },
    { when = function(s) return s.range_fit == "TOO_CLOSE" end,
      do_ = "RETREAT_OPEN_STEP" },
    { when = function(s) return s.threat == "THREATENED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.contact == "VISUAL" and s.friendly_line == "BLOCKED" end,
      do_ = "ADVANCE_COVER_FLANK" },
    { when = function(s) return s.range_fit == "TOO_FAR" end,
      do_ = "ADVANCE_COVER_STAND" },
    { when = function(s) return s.contact == "VISUAL" and s.weapon_kind == "w_sniper" end,
      do_ = "HOLD_OPEN_SNIPE" },
    { when = function(s) return s.contact == "VISUAL" and (s.weapon_kind == "w_smg" or s.weapon_kind == "w_rifle") end,
      do_ = "SUPPRESS_OPEN_CROUCH" },
    { when = function(s) return s.contact == "VISUAL" end,
      do_ = "ADVANCE_COVER_FLANK" },
    { when = function(s) return s.contact == "NO_VISUAL" end,
      do_ = "ADVANCE_COVER_FLANK" },
    { when = function(_s) return true end,
      do_ = "HOLD_OPEN_HIDE" },
}

local MILITARY_INDOOR = {
    { when = function(s) return s.health == "WOUNDED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.health == "WOUNDED" end,
      do_ = "RETREAT_COVER_CROUCH" },
    { when = function(s) return s.range_fit == "TOO_CLOSE" end,
      do_ = "RETREAT_OPEN_STEP" },
    { when = function(s) return s.threat == "THREATENED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.contact == "VISUAL" and s.friendly_line == "BLOCKED" end,
      do_ = "RETREAT_OPEN_STEP" },
    { when = function(s) return s.range_fit == "TOO_FAR" and xcombat.AGGRESSOR_KINDS[s.weapon_kind] end,
      do_ = "ADVANCE_OPEN_RUN" },
    { when = function(s) return s.range_fit == "TOO_FAR" end,
      do_ = "ADVANCE_OPEN_STEP" },
    { when = function(s) return s.contact == "VISUAL" and (s.weapon_kind == "w_smg" or s.weapon_kind == "w_rifle") end,
      do_ = "SUPPRESS_OPEN_CROUCH" },
    { when = function(s) return s.contact == "VISUAL" end,
      do_ = "HOLD_OPEN_CROUCH" },
    { when = function(s) return s.contact == "NO_VISUAL" end,
      do_ = "ADVANCE_OPEN_RUN" },
    { when = function(_s) return true end,
      do_ = "HOLD_OPEN_HIDE" },
}

local STALKER_DEFAULT = {
    { when = function(s) return s.health == "WOUNDED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.health == "WOUNDED" and s.squad == "DECIMATED" end,
      do_ = "RETREAT_OPEN_STAND" },
    { when = function(s) return s.health == "WOUNDED" end,
      do_ = "RETREAT_COVER_CROUCH" },
    { when = function(s) return s.range_fit == "TOO_CLOSE" end,
      do_ = "RETREAT_OPEN_STEP" },
    { when = function(s) return s.threat == "THREATENED" and s.position == "EXPOSED" end,
      do_ = "HOLD_COVER_CROUCH" },
    { when = function(s) return s.contact == "VISUAL" and s.friendly_line == "BLOCKED" end,
      do_ = "ADVANCE_COVER_FLANK" },
    { when = function(s) return s.range_fit == "TOO_FAR" end,
      do_ = "ADVANCE_COVER_STAND" },
    { when = function(s) return s.contact == "VISUAL" and s.weapon_kind == "w_sniper" end,
      do_ = "HOLD_OPEN_SNIPE" },
    { when = function(s) return s.contact == "VISUAL" end,
      do_ = "HOLD_OPEN_CROUCH" },
    { when = function(s) return s.contact == "NO_VISUAL" end,
      do_ = "ADVANCE_COVER_STAND" },
    { when = function(_s) return true end,
      do_ = "HOLD_OPEN_HIDE" },
}

local FACTION_RULES = {
    OUTDOOR = {
        army     = MILITARY_OUTDOOR, army_npc = MILITARY_OUTDOOR,
        dolg     = MILITARY_OUTDOOR, freedom  = MILITARY_OUTDOOR,
        isg      = MILITARY_OUTDOOR,
    },
    INDOOR = {
        army     = MILITARY_INDOOR,  army_npc = MILITARY_INDOOR,
        dolg     = MILITARY_INDOOR,  freedom  = MILITARY_INDOOR,
        isg      = MILITARY_INDOOR,
    },
    OUTDOOR_DEFAULT = STALKER_DEFAULT,
    INDOOR_DEFAULT  = STALKER_DEFAULT,
}


-- =========================================================================
-- Decide: walk rules top-down, first match wins. Squad-uniqueness skip with
-- first-eligible-taken fallback. Optional on_delta filter (transition rules).
-- =========================================================================

-- Returns (picked, taken_marker) for one rule. picked = behavior name if free;
-- taken_marker = behavior name if matched-but-squadmate-has-it; nils otherwise.
local function _rule_picks(rule, state, first_delta, npc_id)
    if rule.on_delta and rule.on_delta ~= first_delta then return nil, nil end
    if not rule.when(state) then return nil, nil end
    local unique = rule.unique ~= false
    if unique and xcombat.squadmate_in(state.squad_id, npc_id, rule.do_) then
        return nil, rule.do_
    end
    return rule.do_, nil
end

local function _decide(rules, state, first_delta, npc_id)
    local fallback = nil
    for i = 1, #rules do
        local picked, taken = _rule_picks(rules[i], state, first_delta, npc_id)
        if picked then return picked end
        if taken then fallback = fallback or taken end
    end
    return fallback
end


-- =========================================================================
-- Evaluator
-- =========================================================================

class "evaluator_at_combat" ( property_evaluator )

function evaluator_at_combat:__init(name) super (nil, name)
end

local function _decide_eval(npc, id)
    if not cfg.combat_enabled then return false, "disabled" end
    if (id % 1000) >= (cfg.combat_share * 1000) then return false, "hash_out" end
    if not npc:alive() then return false, "dead" end
    if IsWounded(npc) then return false, "wounded" end
    local until_ms = _fail_until[id]
    if until_ms and time_global() < until_ms then return false, "fail_backoff" end
    local be = npc:best_enemy()
    if not (be and be:alive()) then return false, "no_enemy" end
    return true, "in_range"
end

local function _log_eval_transition(id, result, reason)
    local prev = _last_eval_logged[id]
    if prev == result then return end
    _last_eval_logged[id] = result
    log.debug("[COMBAT] eval npc=%d %s->%s reason=%s",
        id,
        prev == nil and "init" or tostring(prev),
        tostring(result),
        reason)
end

function evaluator_at_combat:evaluate()
    local npc = self.object
    local id = npc:id()
    local result, reason = _decide_eval(npc, id)
    _last_eval[id]   = result
    _last_reason[id] = reason
    if _dbg then _log_eval_transition(id, result, reason) end
    return result
end


-- =========================================================================
-- Action
-- =========================================================================

class "action_at_combat" ( action_base )

function action_at_combat:__init(name) super (nil, name)
end

local function _on_pick_fail(id)
    local streak = (_fail_streak[id] or 0) + 1
    _fail_streak[id] = streak
    if streak >= FAIL_THRESHOLD then
        local backoff = FAIL_BACKOFF_MS * (streak - FAIL_THRESHOLD + 1)
        _fail_until[id] = time_global() + backoff
        if _dbg then log.debug("[BACKOFF] npc=%d streak=%d backoff=%dms -> vanilla", id, streak, backoff) end
    end
    return streak
end

function action_at_combat:_apply_plan(plan, ctx)
    local npc = self.object
    if plan.state ~= self.last_state then
        state_mgr.set_state(npc, plan.state, nil, nil,
            { look_object = ctx.enemy }, { fast_set = true })
        self.last_state = plan.state
    end
    if plan.body ~= self.last_body then
        npc:set_body_state(move[plan.body])
        self.last_body = plan.body
    end
    if plan.mvt ~= self.last_mvt then
        npc:set_movement_type(move[plan.mvt])
        self.last_mvt = plan.mvt
    end
    local want_sniper = plan.sniper_aim == true
    if want_sniper ~= self.last_sniper_mode then
        npc:sniper_fire_mode(want_sniper)
        self.last_sniper_mode = want_sniper
    end
end

function action_at_combat:_repick(plan, ctx)
    local npc = self.object
    local id = npc:id()
    local resolver = TARGET_RESOLVERS[plan.target]
    if not resolver then return end
    local new_lvid, reason = resolver(npc, ctx, self)
    if not new_lvid then
        local streak = _on_pick_fail(id)
        if _dbg then
            log.debug("[RESOLVE] npc=%d %s target=%s FAIL reason=%s streak=%d dist=%.1f",
                id, tostring(self.current_behavior), plan.target, reason or "?", streak, ctx.dist)
        end
        return
    end
    _fail_streak[id] = 0
    if new_lvid == self.target_lvid then return end
    local skip_reservation = (plan.target == "charge_enemy")
    if not skip_reservation and not _claim(new_lvid, id) then
        if _dbg then
            log.debug("[RESOLVE] npc=%d %s target=%s contested lvid=%d",
                id, tostring(self.current_behavior), plan.target, new_lvid)
        end
        return
    end
    _release(self.target_lvid, id)
    self.target_lvid = new_lvid
    xcombat.send_to(npc, new_lvid)
    if _dbg then
        log.debug("[RESOLVE] npc=%d %s target=%s ok lvid=%d dist=%.1f",
            id, tostring(self.current_behavior), plan.target, new_lvid, ctx.dist)
    end
end

function action_at_combat:_switch(name, ctx)
    local npc = self.object
    local id = npc:id()
    local state = _state[id]
    xcombat.record_pick(state and state.squad_id or nil, id, name)
    self.current_behavior = name
    local plan = BEHAVIORS[name].plan
    self:_apply_plan(plan, ctx)
    self:_repick(plan, ctx)
    if _dbg then log.debug("[COMBAT] switch npc=%d -> %s", id, name) end
end

function action_at_combat:initialize()
    action_base.initialize(self)
    local npc = self.object
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    self.current_behavior = nil
    self.target_lvid      = nil
    self.last_state       = nil
    self.last_body        = nil
    self.last_mvt         = nil
    self.last_sniper_mode = false
end

function action_at_combat:execute()
    action_base.execute(self)
    local npc = self.object
    local id = npc:id()
    local tg = time_global()

    if tg - (_last_decide_npc[id] or 0) < THROTTLE_NPC_MS then return end

    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return end
    _last_decide_npc[id] = tg

    local state = _state[id]
    local first_delta = nil
    if not state then
        state = _init_state(npc)
        _state[id] = state
        first_delta = "init"
    end

    local npc_pos = npc:position()
    local ene_pos = enemy:position()
    local dx = ene_pos.x - npc_pos.x
    local dz = ene_pos.z - npc_pos.z
    local dist = math_sqrt(dx*dx + dz*dz)
    local ctx = {
        npc_pos  = npc_pos,
        ene_pos  = ene_pos,
        npc_lvid = npc:level_vertex_id(),
        dist     = dist,
        dx       = dx,
        dz       = dz,
        enemy    = enemy,
        id       = id,
        bucket   = id % SQUAD_LATERAL_BUCKETS,
    }

    local delta_from_read = _update_state(npc, enemy, state, tg, ctx)
    first_delta = first_delta or delta_from_read
    if not first_delta then return end

    local env_table  = FACTION_RULES[state.environment]
    local rules      = (env_table and env_table[state.community])
                       or FACTION_RULES[state.environment .. "_DEFAULT"]
    if not rules then return end

    local picked = _decide(rules, state, first_delta, id)
    if _dbg then
        log.debug("[DECIDE] npc=%d comm=%s env=%s hp=%s contact=%s range=%s threat=%s pos=%s squad=%s fline=%s wpn=%s dist=%.1f delta=%s -> %s",
            id, state.community, state.environment, state.health, state.contact,
            state.range_fit, state.threat, state.position, state.squad, state.friendly_line,
            state.weapon_kind or "none", dist, tostring(first_delta), tostring(picked))
    end
    if not picked then return end

    if picked ~= self.current_behavior then
        self:_switch(picked, ctx)
    else
        local plan = BEHAVIORS[picked].plan
        if plan.track or xcombat.cover_stolen(self.target_lvid, id) then
            self:_repick(plan, ctx)
        end
    end

    npc:set_sight(look.fire_point,
        vector():set(ene_pos.x, ene_pos.y + 1.5, ene_pos.z))
end

function action_at_combat:finalize()
    action_base.finalize(self)
    local npc = self.object
    local id = npc:id()
    _release(self.target_lvid, id)
    self.target_lvid = nil
    local state = _state[id]
    xcombat.clear_pick(state and state.squad_id or nil, id)
    if self.last_sniper_mode then
        npc:sniper_fire_mode(false)
        self.last_sniper_mode = false
    end
end


-- =========================================================================
-- Lifecycle: install, unregister, hit tracking, MCM refresh
-- =========================================================================

local function _on_npc_hit(npc, amount, _local_direction, who, _bone_id)
    if not (npc and amount and amount > 0 and who) then return end
    local state = _state[npc:id()]
    if not state then return end
    state._threat_hit_at = time_global()
end

local function _install(npc)
    if not npc then return end
    if not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    _community[id] = character_community(npc) or ""

    local manager = npc:motivation_action_manager()
    if not manager then return end

    manager:add_evaluator(EVAL_ID, evaluator_at_combat("eva_at_combat"))

    local action = action_at_combat("act_at_combat")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(EVAL_ID, true))
    action:add_effect(world_property(EVAL_ID, false))
    manager:add_action(ACT_ID, action)

    local blocked = {
        stalker_ids.action_combat_planner,
        stalker_ids.action_danger_planner,
        xr_danger.actid,
        xr_actions_id.state_mgr + 2,
        xr_actions_id.alife,
    }
    for i = 1, #blocked do
        local act = manager:action(blocked[i])
        if act then act:add_precondition(world_property(EVAL_ID, false)) end
    end
end

local function _on_net_spawn(npc)
    _install(npc)
end

local function _on_net_destroy(npc)
    if not npc then return end
    _installed[npc:id()] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _installed[id]        = nil
    _last_eval[id]        = nil
    _last_eval_logged[id] = nil
    _last_reason[id]      = nil
    _fail_until[id]       = nil
    _fail_streak[id]      = nil
    _community[id]        = nil
    _state[id]            = nil
    _last_decide_npc[id]  = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
end

local function _on_first_update()
    _installed         = {}
    _state             = {}
    _last_decide_npc   = {}
    _last_eval         = {}
    _last_eval_logged  = {}
    _last_reason       = {}
    _fail_until        = {}
    _fail_streak       = {}
    _community         = {}
    _refresh_log()
    log.info("Combat module initialized (enabled=%s share=%.2f dbg=%s)",
        cfg.combat_enabled and "true" or "false",
        cfg.combat_share or 0.5,
        _dbg and "true" or "false")
end

function on_game_start()
    _load_tunables()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("npc_on_hit_callback",         _on_npc_hit)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

--- at_combat: Pattern B planner takeover. While the takeover gate is open (_should_manage) the engine runs
--- our action instead of the vanilla combat/danger/alife planners. Per AI tick the action runs two throttled
--- gates: AIM points the weapon at the enemy (fast, reaction cadence); DECIDE chooses one maneuver (slow)
--- from the NPC's doctrine palette (faction x weapon x terrain) via palette -> problem -> pick, holds it
--- until the next DECIDE. All NPC control goes through xcombat (set_combat / aim_at / send_to).

local IsStalker, IsWounded, time_global = IsStalker, IsWounded, time_global
local math_sqrt, math_floor, math_min, math_max, math_random = math.sqrt, math.floor, math.min, math.max, math.random
local character_community, pairs, RegisterScriptCallback = character_community, pairs, RegisterScriptCallback
local vector, anim, game_object = vector, anim, game_object

local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

-- Custom GOAP evaluator + action id, registered per stalker on its motivation_action_manager. The 188000+
-- band stays clear of the engine/Anomaly base ids (low offsets from stalker_ids.action_script); 188200 sits
-- above xr_danger's 188113. See doc/library/modding/goap-injection.md:237. ACT_ID is a module field so
-- at_hud reads one source instead of re-hardcoding the literal.
ACT_ID = 188200
local EVAL_ID = ACT_ID

-- xcombat control-knob aliases
local FIRE, SNIPE, STOW       = xcombat.FIRE, xcombat.SNIPE, xcombat.STOW
local STAND, CROUCH           = xcombat.STAND, xcombat.CROUCH
local STILL, WALK, RUN        = xcombat.STILL, xcombat.WALK, xcombat.RUN

-- Roles (the slot a maneuver fills in a palette; one per faction)
local R_HOLD, R_SNIPE, R_COVER, R_FWD, R_BACK, R_FLANK, R_SIDE, R_FALLBACK =
      "hold", "snipe", "cover", "forward", "back", "flank", "step_side", "fallback"

-- Problems, highest priority first
local P_HURT, P_LOST, P_BLOCKED, P_FAR, P_CLOSE, P_NONE =
      "hurt", "lost", "blocked", "too_far", "too_close", "none"

-- Faction groups + their style/lean
local DISC, MONO, COMMON, RECK, ZOMB = "DISCIPLINED", "MONOLITH", "COMMON", "RECKLESS", "ZOMBIED"

local FACTION_GROUP = {
    military = DISC, army = DISC, army_npc = DISC, dolg = DISC, freedom = DISC, isg = DISC, killer = DISC,
    monolith = MONO,
    stalker = COMMON, ecolog = COMMON, csky = COMMON,
    bandit = RECK, renegade = RECK, greh = RECK,
    zombied = ZOMB,
}
local GROUP_STYLE = { [DISC] = "COVER", [MONO] = "COVER", [COMMON] = "MIXED", [RECK] = "OPEN", [ZOMB] = "OPEN" }
local GROUP_LEAN  = { [DISC] = "STEADY", [MONO] = "FEARLESS", [COMMON] = "CAUTIOUS", [RECK] = "AGGRESSIVE", [ZOMB] = "FEARLESS" }

local BUCKET_SNIPER, BUCKET_CLOSE, BUCKET_RIFLE = "SNIPER", "CLOSE", "RIFLE"

-- Perf timer stage names (-> at_combat_trace.stage). resolve = find_peek/find_point, apply = set_combat.
local S_RESOLVE, S_APPLY = "resolve", "apply"


-- =========================================================================
-- LTX tunables (deferred load: ini_file at module scope is a freeze hazard)
-- =========================================================================

local LTX_PATH    = "alifetactics\\at_combat.ltx"
local LTX_SECTION = "at_combat"

local AIM_THROTTLE_MS, DECIDE_THROTTLE_MS, FAIL_THRESHOLD, FAIL_BACKOFF_MS
local FRIENDLY_THRESH_M, RANGE_DEADBAND_M, HURT_FRAC, LOST_SIGHT_MS
local ADVANCE_STEP_M, BACK_STEP_M, FLANK_LAT_M, FLANK_FWD_M, STEP_SIDE_M
local SQUAD_BUCKETS
local STANDOFF = {}

local function _load_tunables()
    local ini = ini_file(LTX_PATH)
    local function f(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    local function i(k, d) local v = ini:r_float_ex(LTX_SECTION, k); return v and math_floor(v) or d end
    AIM_THROTTLE_MS    = i("aim_throttle_ms",        200)
    DECIDE_THROTTLE_MS = i("decide_throttle_ms",     1500)
    FAIL_THRESHOLD     = i("fail_threshold",         3)
    FAIL_BACKOFF_MS    = i("fail_backoff_ms",        10000)
    FRIENDLY_THRESH_M  = f("friendly_line_thresh_m", 1.5)
    RANGE_DEADBAND_M   = f("range_deadband_m",       3)
    HURT_FRAC          = f("hurt_frac",              0.30)
    LOST_SIGHT_MS      = i("lost_sight_ms",          12000)
    ADVANCE_STEP_M     = f("advance_step_m",         15)
    BACK_STEP_M        = f("back_step_m",            12)
    FLANK_LAT_M        = f("flank_lateral_m",        12)
    FLANK_FWD_M        = f("flank_forward_m",        6)
    STEP_SIDE_M        = f("step_side_m",            4)
    SQUAD_BUCKETS      = i("squad_buckets",          5)
    STANDOFF[BUCKET_CLOSE] = f("standoff_close_m",   10)
    STANDOFF[BUCKET_RIFLE] = f("standoff_rifle_m",   30)
end


-- =========================================================================
-- Per-NPC tracking
-- =========================================================================

local _installed   = {}
local _state       = {}
local _last_decide = {}
local _last_aim    = {}
local _last_eval   = {}
local _last_reason = {}
local _fail_until  = {}
local _fail_streak = {}
local _community   = {}


-- =========================================================================
-- Maneuver catalog. Each carries its role, fire mode, cover flag, and the three doctrine tags
-- (factions / weapons / environment). Posture and speed are NOT here - they are rolled at maneuver
-- start (see _roll). STOW holsters the weapon (sprint state) and is reserved for flee only: R_BACK on
-- P_HURT. Every other role keeps the weapon up and fires while repositioning; R_FALLBACK (FIRE) is the
-- range-management fighting withdrawal on P_CLOSE. DROPPED: BACK_COVER_FIRE, FLANK_OPEN_STOW, FORWARD_OPEN_STOW.
-- =========================================================================

-- nil tag = applies to everything
local ALL = nil
local SNIPER_ONLY = { [BUCKET_SNIPER] = true }

local MANEUVERS = {
    HOLD_FIRE          = { role = R_HOLD,  fire = FIRE,  factions = ALL,                                       weapons = ALL },
    HOLD_SNIPE         = { role = R_SNIPE, fire = SNIPE, factions = { [DISC]=true, [MONO]=true, [COMMON]=true }, weapons = SNIPER_ONLY },
    COVER_FIRE         = { role = R_COVER, fire = FIRE,  cover = true, factions = { [MONO]=true, [COMMON]=true, [DISC]=true } },
    FORWARD_OPEN_FIRE  = { role = R_FWD,   fire = FIRE,  factions = { [COMMON]=true, [RECK]=true, [ZOMB]=true } },
    FORWARD_COVER_FIRE = { role = R_FWD,   fire = FIRE,  cover = true, factions = { [MONO]=true, [DISC]=true } },
    BACK_OPEN_STOW     = { role = R_BACK,  fire = STOW,  factions = { [COMMON]=true, [RECK]=true } },
    BACK_COVER_STOW    = { role = R_BACK,  fire = STOW,  cover = true, factions = { [DISC]=true } },
    BACK_OPEN_FIRE     = { role = R_FALLBACK, fire = FIRE, factions = { [DISC]=true, [COMMON]=true, [RECK]=true } },
    FLANK_OPEN_FIRE    = { role = R_FLANK, fire = FIRE,  factions = { [RECK]=true },  env = "OUTDOOR" },
    FLANK_COVER_FIRE   = { role = R_FLANK, fire = FIRE,  cover = true, factions = { [MONO]=true, [DISC]=true }, env = "OUTDOOR" },
    STEP_SIDE_FIRE     = { role = R_SIDE,  fire = FIRE,  factions = { [DISC]=true, [MONO]=true, [COMMON]=true, [RECK]=true } },
}


-- =========================================================================
-- Doctrine palette: filter the catalog by an NPC's (group, weapon bucket, environment) into a
-- role -> maneuver-name map. Rebuilt only when one of the three inputs changes.
-- =========================================================================

local function _weapon_bucket(kind)
    if xcombat.SNIPER_KINDS[kind] then return BUCKET_SNIPER end
    if xcombat.AGGRESSOR_KINDS[kind] then return BUCKET_CLOSE end
    return BUCKET_RIFLE
end

local function _build_palette(group, bucket, env)
    local pal = {}
    for name, maneuver in pairs(MANEUVERS) do
        local fac_ok = (maneuver.factions == nil) or maneuver.factions[group]
        local wpn_ok = (maneuver.weapons == nil) or maneuver.weapons[bucket]
        local env_ok = (maneuver.env == nil) or (maneuver.env == env)
        if fac_ok and wpn_ok and env_ok then pal[maneuver.role] = name end
    end
    return pal
end


-- =========================================================================
-- Movement resolution (one resolver, dispatched by role + cover flag). Returns a destination vertex
-- or nil; stationary roles return the NPC's own node. Squad bucket parity fans flank/sidestep direction.
-- =========================================================================

local function _resolve(maneuver, npc, ctx, state)
    local role = maneuver.role
    if role == R_HOLD or role == R_SNIPE then return ctx.npc_lvid end
    if role == R_COVER then return xcombat.find_peek(npc, ctx.ene_pos) end
    -- adjacent enemy: the npc->enemy direction is unreliable; hold rather than move blind (also avoids /0)
    if ctx.dist < 1 then return ctx.npc_lvid end

    local sign = (ctx.bucket % 2 == 0) and 1 or -1
    local dir, dist
    if role == R_FWD then
        local standoff = STANDOFF[state.bucket_name] or 0
        dir, dist = ctx.dir_to, math_min(ADVANCE_STEP_M, math_max(ctx.dist - standoff, 0))
    elseif role == R_BACK or role == R_FALLBACK then
        dir, dist = vector():set(-ctx.dir_to.x, 0, -ctx.dir_to.z), BACK_STEP_M
    elseif role == R_FLANK then
        local fx = -ctx.dir_to.z * sign * FLANK_LAT_M + ctx.dir_to.x * FLANK_FWD_M
        local fz =  ctx.dir_to.x * sign * FLANK_LAT_M + ctx.dir_to.z * FLANK_FWD_M
        local len = math_sqrt(fx*fx + fz*fz)
        dir, dist = vector():set(fx / len, 0, fz / len), len
    else
        dir, dist = vector():set(-ctx.dir_to.z * sign, 0, ctx.dir_to.x * sign), STEP_SIDE_M
    end

    if maneuver.cover then
        local search = vector():set(ctx.npc_pos.x + dir.x * dist, ctx.npc_pos.y, ctx.npc_pos.z + dir.z * dist)
        return xcombat.find_peek(npc, ctx.ene_pos, search)
    end
    return xcombat.find_point(npc, dir, dist)
end


-- =========================================================================
-- Roll: posture (stand/crouch) + speed (walk/run), respecting the engine's state matrix
-- (crouch+fire -> walk; STOW -> run+stand; snipe/hold -> still). Held for the maneuver's lifetime.
-- =========================================================================

local function _roll(fire, stationary)
    if fire == SNIPE or stationary then
        return (math_random(2) == 1) and STAND or CROUCH, STILL
    end
    if fire == STOW then
        return STAND, RUN
    end
    if math_random(2) == 1 then
        return STAND, (math_random(2) == 1) and WALK or RUN
    end
    return CROUCH, WALK
end


-- =========================================================================
-- Readings + problem detection
-- =========================================================================

local function _range_zone(state, dist)
    local band = state.range_band
    local zone = state.range_zone
    if zone == "FAR" then
        if dist < band.max - RANGE_DEADBAND_M then zone = "IN" end
    elseif zone == "CLOSE" then
        if dist > band.min + RANGE_DEADBAND_M then zone = "IN" end
    else
        if dist > band.max then zone = "FAR"
        elseif dist < band.min then zone = "CLOSE" end
    end
    state.range_zone = zone
    return zone
end

-- The single problem the NPC must answer this recompute, in priority order.
local function _read_problem(npc, enemy, state, ctx, tg)
    local see = npc:see(enemy)
    if see then state.last_seen = tg end

    if state.lean ~= "FEARLESS" and npc.health < HURT_FRAC then return P_HURT end
    if (tg - state.last_seen) > LOST_SIGHT_MS then return P_LOST end
    local friendly = xcombat.has_friendly_in_line(npc, ctx.npc_pos, ctx.ene_pos, FRIENDLY_THRESH_M)
    ctx.r_friendly = friendly
    if friendly then return P_BLOCKED end
    if not see then
        local occluder = xcombat.has_occluder_between(ctx.npc_pos, ctx.ene_pos)
        ctx.r_occluder = occluder
        if occluder then return P_BLOCKED end
    end

    local zone = _range_zone(state, ctx.dist)
    if zone == "FAR" then return P_FAR end
    if zone == "CLOSE" then return P_CLOSE end
    return P_NONE
end

-- Problem -> maneuver, via the palette. The read names the need; the faction's palette supplies the variant.
local function _pick(state, problem, pal)
    if problem == P_HURT   then return pal[R_BACK] or pal[R_COVER] or pal[R_HOLD] end
    if problem == P_LOST   then return pal[R_FWD]  or pal[R_FLANK] or pal[R_HOLD] end
    if problem == P_BLOCKED then return pal[R_SIDE] or pal[R_FLANK] or pal[R_HOLD] end
    if problem == P_FAR then
        if state.bucket_name == BUCKET_SNIPER then return pal[R_SNIPE] or pal[R_HOLD] end
        return pal[R_FWD] or pal[R_HOLD]
    end
    if problem == P_CLOSE then return pal[R_FALLBACK] or pal[R_BACK] or pal[R_HOLD] end
    -- P_NONE: the resting base
    if state.bucket_name == BUCKET_SNIPER and pal[R_SNIPE] then return pal[R_SNIPE] end
    if state.style == "COVER" and not state.at_cover and pal[R_COVER] then return pal[R_COVER] end
    return pal[R_HOLD]
end


-- =========================================================================
-- State init + per-recompute refresh
-- =========================================================================

local function _init_state(npc)
    local id = npc:id()
    local squad = xsquad.get_squad_by_member(id)
    local squad_id = squad and squad.id or nil
    local community = _community[id] or character_community(npc) or "stalker"
    local group = FACTION_GROUP[community] or COMMON
    return {
        npc_id        = id,
        squad_id      = squad_id,
        bucket        = xcombat.get_squad_ordinal(squad_id, id) % SQUAD_BUCKETS,
        community     = community,
        group         = group,
        style         = GROUP_STYLE[group],
        lean          = GROUP_LEAN[group],
        weapon_kind   = nil,
        bucket_name   = BUCKET_RIFLE,
        range_band    = xcombat.WEAPON_RANGES.w_rifle,
        palette       = nil,
        pal_key       = nil,
        env           = "OUTDOOR",
        _env_lvid     = nil,
        range_zone    = "IN",
        last_seen     = time_global(),
        at_cover      = false,
        last_cover_vid = nil,
    }
end

-- Refresh weapon bucket / band / environment and rebuild the palette only when one of the three changes.
local function _refresh(state, npc, npc_pos, npc_lvid)
    local kind = xcombat.get_weapon_kind(npc) or "w_rifle"
    state.weapon_kind = kind
    state.bucket_name = _weapon_bucket(kind)
    state.range_band  = xcombat.get_weapon_range(kind)
    if state._env_lvid ~= npc_lvid then
        state._env_lvid = npc_lvid
        state.env = xcombat.is_indoor(npc_pos) and "INDOOR" or "OUTDOOR"
    end
    local key = state.group .. "|" .. state.bucket_name .. "|" .. state.env
    if key ~= state.pal_key then
        state.pal_key = key
        state.palette = _build_palette(state.group, state.bucket_name, state.env)
    end
end


-- =========================================================================
-- TAKEOVER GATE. The engine polls this evaluator while planning: true = AT drives the
-- NPC (the vanilla combat/danger/alife planners are precondition-blocked), false = vanilla
-- resumes. This is the on/off of the whole takeover; the per-tick pipeline is below.
-- =========================================================================

class "evaluator_at_combat" ( property_evaluator )

function evaluator_at_combat:__init(name) super (nil, name)
end

-- The takeover test, highest-priority check first; first failure returns (false, reason).
local function _should_manage(npc, id)
    if not cfg.combat_enabled then return false, "disabled" end
    if (id % 1000) >= (cfg.combat_share * 1000) then return false, "hash_out" end
    if not npc:alive() then return false, "dead" end
    if IsWounded(npc) then return false, "wounded" end
    if cfg.combat_ignore_companions and npc:has_info("npcx_is_companion") then return false, "companion" end
    local until_ms = _fail_until[id]
    if until_ms and time_global() < until_ms then return false, "fail_backoff" end
    local be = npc:best_enemy()
    if not (be and be:alive()) then return false, "no_enemy" end
    return true, "managed"
end

function evaluator_at_combat:evaluate()
    local npc = self.object
    local id = npc:id()
    local result, reason = _should_manage(npc, id)
    _last_eval[id]   = result
    _last_reason[id] = reason
    if _dbg then at_combat_trace.eval(id, result, reason) end
    return result
end


-- =========================================================================
-- Action
-- =========================================================================

class "action_at_combat" ( action_base )

function action_at_combat:__init(name) super (nil, name)
end

local function _claim(lvid, id) return xcombat.claim_cover(lvid, id) end
local function _release(lvid, id) xcombat.release_cover(lvid, id) end

local function _on_pick_fail(id)
    local streak = (_fail_streak[id] or 0) + 1
    _fail_streak[id] = streak
    if streak >= FAIL_THRESHOLD then
        local backoff = FAIL_BACKOFF_MS * (streak - FAIL_THRESHOLD + 1)
        _fail_until[id] = time_global() + backoff
        at_combat_trace.backoff(id, streak, backoff)
    end
end

-- Cover sticky test: true = hold the reserved peek (not yet reached and not stolen). Traces held / stolen.
-- @cost O(1) | 0 luabind (is_cover_stolen is a db table read)
local function _cover_held(target_lvid, is_cover, npc_lvid, id)
    if not (is_cover and target_lvid and npc_lvid ~= target_lvid) then return false end
    if xcombat.is_cover_stolen(target_lvid, id) then
        at_combat_trace.cover(id, "stolen", target_lvid)
        return false
    end
    at_combat_trace.cover(id, "held", target_lvid)
    return true
end

-- Resolve + send the destination for the active maneuver. Cover targets are sticky (kept until reached
-- or stolen); other moves re-resolve each recompute to track the enemy; stationary parks on the own node.
function action_at_combat:_move(maneuver, ctx, state)
    local npc = self.object
    local id = ctx.id
    local is_cover   = (maneuver.cover == true) or (maneuver.role == R_COVER)
    local stationary = (maneuver.role == R_HOLD or maneuver.role == R_SNIPE)

    -- stationary maneuvers park on the own node once, then never re-resolve
    if stationary and self.target_lvid == ctx.npc_lvid then return end
    if stationary then
        _release(self.target_lvid, id)
        self.target_lvid = ctx.npc_lvid
        state.last_cover_vid = nil
        xcombat.send_to(npc, ctx.npc_lvid)
        return
    end

    -- cover targets are sticky: hold the reserved peek until it is reached or stolen
    if _cover_held(self.target_lvid, is_cover, ctx.npc_lvid, id) then return end

    local mtmr = xprofiler.new_if(_dbg):start()
    local vid = _resolve(maneuver, npc, ctx, state)
    at_combat_trace.stage(S_RESOLVE, mtmr:stop():get_ms())
    if not vid then
        _on_pick_fail(id)
        at_combat_trace.resolve_fail(id, self.current_behavior, ctx.dist)
        return
    end
    _fail_streak[id] = 0
    if vid == self.target_lvid then return end
    if is_cover and not _claim(vid, id) then
        at_combat_trace.cover(id, "claim_fail", vid)
        return
    end
    _release(self.target_lvid, id)
    self.target_lvid = vid
    state.last_cover_vid = is_cover and vid or nil
    local sent = xcombat.send_to(npc, vid)
    at_combat_trace.resolve_ok(id, self.current_behavior, vid, sent, ctx.dist, is_cover and "claimed" or nil)
end

-- Switch to a new maneuver: release old cover, roll posture/speed, write the combat state, resolve dest.
function action_at_combat:_apply(maneuver, name, ctx, state)
    local id = ctx.id
    _release(self.target_lvid, id)
    self.target_lvid     = nil
    state.last_cover_vid = nil
    self.current_behavior = name
    local stationary = (maneuver.role == R_HOLD or maneuver.role == R_SNIPE)
    self.posture, self.movement = _roll(maneuver.fire, stationary)
    local atmr = xprofiler.new_if(_dbg):start()
    xcombat.set_combat(self.object, { fire = maneuver.fire, posture = self.posture, movement = self.movement, aim = ctx.enemy })
    at_combat_trace.stage(S_APPLY, atmr:stop():get_ms())
    at_combat_trace.switch(id, name, maneuver.fire, self.posture, self.movement)
    self:_move(maneuver, ctx, state)
end

function action_at_combat:initialize()
    action_base.initialize(self)
    local npc = self.object
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    self.current_behavior = nil
    self.target_lvid      = nil
    self.posture          = nil
    self.movement         = nil
end

-- =========================================================================
-- THE PIPELINE. While the takeover gate is open, the engine runs this action each AI tick.
-- execute() is the skeleton; it runs two gates, each on its own throttle:
--   AIM    (aim_throttle_ms)    _aim     point the weapon at the enemy
--   DECIDE (decide_throttle_ms) _decide  choose and drive one maneuver, in 3 steps:
--       1. palette   _refresh        doctrine(faction) x weapon x terrain -> maneuver set
--       2. problem   _read_problem   the single problem to solve this tick
--       3. maneuver  _pick           problem -> palette role -> maneuver, then _apply / _move
-- =========================================================================

function action_at_combat:execute()
    action_base.execute(self)
    local npc = self.object
    local id, tg = npc:id(), time_global()

    local aim_ready    = tg - (_last_aim[id]    or 0) >= AIM_THROTTLE_MS
    local decide_ready = tg - (_last_decide[id] or 0) >= DECIDE_THROTTLE_MS
    if not (aim_ready or decide_ready) then return end

    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return end

    if aim_ready    then self:_aim(npc, id, enemy, tg) end
    if decide_ready then self:_decide(npc, id, enemy, tg) end
end

-- AIM gate: re-point the weapon at the enemy's current position.
function action_at_combat:_aim(npc, id, enemy, tg)
    _last_aim[id] = tg
    xcombat.aim_at(npc, enemy:position())
end

-- DECIDE gate: palette -> problem -> maneuver, then switch (_apply) or hold (_move). Timed end to end.
function action_at_combat:_decide(npc, id, enemy, tg)
    _last_decide[id] = tg
    local timer = xprofiler.new_if(_dbg):start()

    local ctx   = self:_gather(npc, id, enemy)
    local state = ctx.state
    _refresh(state, npc, ctx.npc_pos, ctx.npc_lvid)
    local problem = _read_problem(npc, enemy, state, ctx, tg)
    local picked  = _pick(state, problem, state.palette) or "HOLD_FIRE"

    local maneuver = MANEUVERS[picked]
    at_combat_trace.decide(id, npc, state, ctx, tg, problem, maneuver and maneuver.role, picked)
    if maneuver and picked ~= self.current_behavior then
        self:_apply(maneuver, picked, ctx, state)
    elseif maneuver then
        self:_move(maneuver, ctx, state)
    end

    at_combat_trace.perf(timer:stop():get_ms())
end

-- Per-tick context: state (lazily created), positions, distance, direction, at-cover flag.
function action_at_combat:_gather(npc, id, enemy)
    local state = _state[id]
    if not state then
        state = _init_state(npc)
        _state[id] = state
    end
    local npc_pos  = npc:position()
    local ene_pos  = enemy:position()
    local npc_lvid = npc:level_vertex_id()
    local dx, dz   = ene_pos.x - npc_pos.x, ene_pos.z - npc_pos.z
    local dist     = math_sqrt(dx*dx + dz*dz)
    local inv      = dist > 0 and (1 / dist) or 0
    state.at_cover = state.last_cover_vid ~= nil and npc_lvid == state.last_cover_vid
    return {
        npc = npc, id = id, enemy = enemy, state = state,
        npc_pos = npc_pos, ene_pos = ene_pos, npc_lvid = npc_lvid,
        dist = dist, dir_to = vector():set(dx * inv, 0, dz * inv), bucket = state.bucket,
    }
end

function action_at_combat:finalize()
    action_base.finalize(self)
    local npc = self.object
    _release(self.target_lvid, npc:id())
    self.target_lvid = nil
    npc:sniper_fire_mode(false)
end


-- =========================================================================
-- Lifecycle: install, unregister, MCM refresh
-- =========================================================================

-- TAKEOVER INSTALL (once per NPC, on spawn): graft the evaluator + action into the GOAP
-- manager and block the vanilla planners. The block list below is exactly what AT takes over.
local function _install(npc)
    if not npc then return end
    if not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    _community[id] = character_community(npc) or ""

    local manager = npc:motivation_action_manager()
    if not manager then return end

    manager:add_evaluator(EVAL_ID, evaluator_at_combat("eva_at_combat"))

    local action = action_at_combat("act_at_combat")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(EVAL_ID, true))
    action:add_effect(world_property(EVAL_ID, false))
    manager:add_action(ACT_ID, action)

    local blocked = {
        stalker_ids.action_combat_planner,
        stalker_ids.action_danger_planner,
        xr_danger.actid,
        xr_actions_id.state_mgr + 2,
        xr_actions_id.alife,
    }
    for i = 1, #blocked do
        local act = manager:action(blocked[i])
        if act then act:add_precondition(world_property(EVAL_ID, false)) end
    end
end

local function _on_net_spawn(npc)
    _install(npc)
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    _installed[id] = nil
    -- offline NPC must not keep holding an online cover slot; finalize may not run on offline teardown
    xcombat.release_owner_cover(id)
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _installed[id]   = nil
    _last_eval[id]   = nil
    at_combat_trace.forget(id)
    _last_reason[id] = nil
    _fail_until[id]  = nil
    _fail_streak[id] = nil
    _community[id]   = nil
    _state[id]       = nil
    _last_decide[id] = nil
    _last_aim[id]    = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    at_combat_trace.set_enabled(_dbg)
end

--- Telemetry (counters) + eval snapshot for the at_test stats dump. DEBUG-accumulated.
function get_stats()
    return at_combat_trace.stats(), _last_eval, _last_reason
end

local function _on_first_update()
    _installed   = {}
    _state       = {}
    _last_decide = {}
    _last_aim    = {}
    _last_eval   = {}
    _last_reason = {}
    _fail_until  = {}
    _fail_streak = {}
    _community   = {}
    at_combat_trace.reset()
    _refresh_log()
    log.info("Combat module initialized (enabled=%s share=%.2f dbg=%s)",
        cfg.combat_enabled and "true" or "false",
        cfg.combat_share or 1.0,
        _dbg and "true" or "false")
end

function on_game_start()
    _load_tunables()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

--- at_combat: the engine half of the combat takeover (Pattern B). Owns the GOAP evaluator + action, the
--- single per-tick scan, the per-NPC slot store, the cover reservation, the handback hysteresis, and the
--- lifecycle. The decision half - which check fires, which maneuver answers it, where to move - lives in
--- at_combat_doctrine; this file turns those answers into xcombat commands.
---
--- INVERSION OF CONTROL - this file runs no loop of its own. _install grafts two probes into each stalker's
--- engine GOAP brain (motivation_action_manager): an evaluator (a boolean sensor the engine polls every plan
--- solve - "should AT drive this NPC?") and an action (the behavior the engine runs every frame the evaluator
--- wins). The engine pumps the brain and calls into us; we never schedule ourselves. Both callbacks read
--- npc:best_enemy() at entry - the engine's own per-NPC target, chosen in the memory manager one layer below
--- the blocked combat planner (enemy_manager + memory_manager, see doc/library/modding/stalker-combat-brain.md).
--- We consume that target; we never compute it. The takeover owns what to do, not who the enemy is.
---
--- One scan per tick (execute). Registered checks each carry a period and a wait flag:
---   aim (aim_period_ms)  re-points the weapon every tick - except during a flee (STOW), which faces the run path.
---   the rest            wait: they only fire once the current maneuver is done (npc:path_completed,
---                       or the maneuver_max_ms stuck cap). The NPC is a turret by
---                       default; a maneuver runs only when a check fires, is committed once started, and
---                       is never interrupted before it completes. No base/override, no resting maneuver.
--- All per-NPC state lives in one flat slot (_combat[id]); nothing is stored on the engine object or the
--- action instance. Tracing is noop when DEBUG is off.

local IsStalker, time_global, tostring = IsStalker, time_global, tostring
local math_sqrt, math_floor, math_random = math.sqrt, math.floor, math.random
local RegisterScriptCallback = RegisterScriptCallback
local vector, anim, game_object = vector, anim, game_object

local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine
-- weapon-stowed fire mode (a flee): the turret stops aiming and faces its run path.
local STOW = xcombat.STOW

-- Custom GOAP evaluator + action id, grafted per stalker on its motivation_action_manager. The 188000+ band
-- stays clear of the engine/Anomaly base ids; 188200 sits above xr_danger's 188113. ACT_ID is a module field
-- so at_hud reads one source instead of re-hardcoding the literal. See doc/library/modding/goap-injection.md.
ACT_ID = 188200
local EVAL_ID = ACT_ID


-- =========================================================================
-- LTX tunables (scan plumbing + handback hysteresis; the doctrine half loads its own). Deferred load.
-- =========================================================================

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"

local AIM_MS, CONTEXT_MS, MANEUVER_MAX_MS, LOST_SIGHT_MS, SEE_THROTTLE_MS, EVAL_PERIOD_MS

local function _load_tunables()
    local ini = ini_file(LTX_PATH)
    local function i(k, d) local v = ini:r_float_ex(LTX_SECTION, k); return v and math_floor(v) or d end
    AIM_MS          = i("aim_period_ms",     200)
    CONTEXT_MS      = i("context_period_ms", 1000)
    MANEUVER_MAX_MS = i("maneuver_max_ms",   8000)
    LOST_SIGHT_MS   = i("lost_sight_ms",     5000)
    SEE_THROTTLE_MS = i("see_throttle_ms",   500)
    EVAL_PERIOD_MS  = i("eval_period_ms",    250)
end


-- =========================================================================
-- Per-NPC slot store. One flat record per NPC, created on first touch; holds the evaluator hysteresis, the
-- weapon/community/palette cache, the running maneuver, the held cover vertex, and the per-check last-run
-- timestamps. squad_id is a field (nil = solo). Cleared on unregister; never saved.
-- =========================================================================

local _takeover_installed = {}
local _combat    = {}

local function _slot(id)
    local slot = _combat[id]
    if not slot then
        slot = { ran_at = {} }
        _combat[id] = slot
    end
    return slot
end

-- Throttled see() probe: at most one raycast per SEE_THROTTLE_MS, cached in slot.sees. This answers the
-- tactical "can I see the enemy right now" question for the doctrine checks (is_blocked_wall, is_enemy_unseen)
-- and for picking the movement track position. The handback does NOT use this - it reads the engine memory
-- clock (xcombat.enemy_unseen_ms), which also counts sound and hits.
local function _probe_see(npc, enemy, slot, tg)
    if tg - (slot.probe_at or 0) < SEE_THROTTLE_MS then return slot.sees end
    slot.sees = npc:see(enemy)
    slot.probe_at = tg
    return slot.sees
end


-- DEBUG probe label: which top-level action an installed NPC is actually running. AT = our takeover
-- (ACT_ID), COMBAT / DANGER = the vanilla planners we precondition-block, "-" = uninitialized. Resolved at
-- call time (under _dbg only) so the module still loads where stalker_ids is absent (the validator stub).
local function _act_label(cur)
    if cur == nil then return "-" end
    if cur == ACT_ID then return "AT" end
    if cur == stalker_ids.action_combat_planner then return "COMBAT" end
    if cur == stalker_ids.action_danger_planner then return "DANGER" end
    return tostring(cur)
end


-- =========================================================================
-- TAKEOVER GATE. The engine polls this evaluator while planning: true = AT drives the NPC (vanilla
-- combat/danger/alife planners are precondition-blocked), false = vanilla resumes.
-- =========================================================================

class "evaluator_at_combat" ( property_evaluator )

function evaluator_at_combat:__init(name) super (nil, name)
end

-- One source of truth for "has the committed maneuver finished travelling": the engine reports the path
-- complete, or the stuck cap elapsed, or no maneuver is set. Both the action's done-check (when to re-decide)
-- and the transaction guard below test arrival through this, so they cannot disagree. No distance proxy - a
-- move ends where the engine says it ended (path_completed), not a fixed radius short of it.
local function _maneuver_done(npc, slot, tg)
    if not slot.maneuver then return true end
    if npc:path_completed() then return true end
    return (tg - (slot.maneuver_at or 0)) > MANEUVER_MAX_MS
end

-- Maneuver transaction guard: a committed maneuver still travelling keeps AT driving. NO soft reason
-- (lost_sight, no_enemy) may break a maneuver mid-flight - only hard stops (dead/wounded/disabled/companion)
-- do. In flight = a maneuver is set and not yet done, so it yields the instant the move arrives or the cap trips.
local function _maneuver_in_flight(npc, slot, tg)
    return slot.maneuver ~= nil and not _maneuver_done(npc, slot, tg)
end

-- Central handback decision, recomputed off the hot path in _on_update (throttled) and cached in slot.eval.
-- Hard stops yield immediately, even mid-maneuver. Wounded is NOT checked here - it is a GOAP precondition on
-- the action (sidor_wounded_base), engine-gated. Two soft handbacks, both guarded by the in-flight maneuver so
-- a committed move always finishes first: no_enemy (the engine's enemy manager has no target - died, despawned,
-- or forgotten past its inertia window) and lost_sight (the enemy is still remembered but unsensed past
-- LOST_SIGHT_MS). Lost-sight reads the engine memory clock (time_global - memory_time, aggregating
-- sight/sound/hit), the same signal vanilla uses to disengage (xr_combat_ignore.script:111); best_enemy is
-- memory-derived with inertia (enemy_manager.cpp:30-32), so it does not flicker.
local function _should_manage(npc, id, tg)
    if not cfg.combat_enabled then return false, "disabled" end
    if (id % 1000) >= (cfg.combat_share * 1000) then return false, "hash_out" end
    if not npc:alive() then return false, "dead" end
    if cfg.combat_ignore_companions and npc:has_info("npcx_is_companion") then return false, "companion" end
    -- A weaponless NPC cannot fight, and AT blocks the engine's own rearm (it lives inside action_combat_planner),
    -- so an unarmed NPC under AT deadlocks - hand it back so the engine rearms or flees. TTL-cached, so a
    -- weapon-switch transient (brief nil active_item) does not false-trigger.
    if not xcombat.get_weapon_kind(npc) then return false, "unarmed" end

    local slot = _slot(id)
    local enemy = npc:best_enemy()
    if not enemy or not enemy:alive() then
        slot.unseen_ms = nil
        if _maneuver_in_flight(npc, slot, tg) then return true, "finish_maneuver" end
        return false, "no_enemy"
    end
    local unseen = xcombat.enemy_unseen_ms(npc, enemy, tg)
    slot.unseen_ms = unseen
    if unseen > LOST_SIGHT_MS then
        if _maneuver_in_flight(npc, slot, tg) then return true, "pursue_to_lastknown" end
        return false, "lost_sight"
    end
    return true, "managed"
end

-- Pure read. The engine polls this every plan solve (more during a re-plan), so it must be a flag read, not a
-- computation. The decision is recomputed off the hot path by _on_update (throttled) and stored in slot.eval;
-- nil before the first _on_update tick reads as false, so vanilla drives until AT's first decision (safe).
function evaluator_at_combat:evaluate()
    return _slot(self.object:id()).eval == true
end


-- =========================================================================
-- Action
-- =========================================================================

class "action_at_combat" ( action_base )

function action_at_combat:__init(name) super (nil, name)
end

function action_at_combat:initialize()
    action_base.initialize(self)
    local npc = self.object
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    -- Fresh fight: clear the per-fight maneuver state (engage reopens). The cache (weapon/palette) persists.
    local slot = _slot(npc:id())
    slot.maneuver    = nil
    slot.maneuver_at = nil
    slot.dest        = nil
    slot.enemy_id    = nil
    slot.fire        = nil
end

-- Per-scan context: positions, distance, direction, the enemy id (for is_target_changed), health.
-- The enemy position is the LIVE position when the NPC currently sees the enemy, else its last-known position
-- from memory (xcombat.enemy_track_pos) - so a chase toward an unseen enemy heads to where it was lost, not
-- after the live fleeing target. slot.sees is refreshed by execute() just before this call.
function action_at_combat:_gather(npc, id, enemy, slot, tg)
    local npc_pos   = npc:position()
    local enemy_pos = xcombat.enemy_track_pos(npc, enemy, slot.sees)
    local npc_lvid  = npc:level_vertex_id()
    local dx, dz    = enemy_pos.x - npc_pos.x, enemy_pos.z - npc_pos.z
    local dist      = math_sqrt(dx*dx + dz*dz)
    local inv       = dist > 0 and (1 / dist) or 0
    return {
        npc = npc, id = id, enemy = enemy, enemy_id = enemy:id(), slot = slot, tg = tg,
        npc_pos = npc_pos, enemy_pos = enemy_pos, npc_lvid = npc_lvid,
        dist = dist, dir_to = vector():set(dx * inv, 0, dz * inv), health = npc.health,
    }
end

-- Commit a maneuver: release any held cover, record it, roll posture/speed, write the combat state, resolve +
-- send the destination (cover targets reserved; a nil-resolving move holds and fires on the own node).
function action_at_combat:_start(name, ctx, slot, check)
    local maneuver = doctrine.MANEUVERS[name]
    if not maneuver then return end
    local id = ctx.id
    xcombat.release_cover(slot.cover_lvid, id)
    slot.cover_lvid  = nil
    slot.maneuver    = name
    slot.maneuver_at = ctx.tg
    slot.enemy_id    = ctx.enemy_id
    slot.fire        = maneuver.fire
    local posture, movement = doctrine.roll(slot, maneuver.fire, doctrine.is_stationary(maneuver), ctx.tg)
    local atmr = xprofiler.new_if(_dbg):start()
    -- a flee (STOW) faces its run path: no aim target, so set_combat leaves the sight on path_dir
    local aim = (maneuver.fire == STOW) and nil or ctx.enemy
    local ok = xcombat.set_combat(self.object, { fire = maneuver.fire, posture = posture, movement = movement, aim = aim })
    local apply_ms = atmr:stop():get_ms()
    local mtmr = xprofiler.new_if(_dbg):start()
    local vid = doctrine.resolve(maneuver, self.object, ctx, slot)
    local resolve_ms = mtmr:stop():get_ms()
    if doctrine.is_cover(maneuver) and vid ~= ctx.npc_lvid and xcombat.claim_cover(vid, id) then slot.cover_lvid = vid end
    slot.dest = xcombat.send_to(self.object, vid)
    at_combat_trace.decide(id, name, check, posture, movement, apply_ms, resolve_ms, ok, slot)
end


-- A check fires when its period elapsed (stamped here) and its predicate holds for an eligible maneuver;
-- returns the check name to add as a candidate, or nil. Lifted out so the scan loop stays shallow.
local function _check_fires(check, ctx, slot, tg, ran)
    if tg - (ran[check.name] or 0) < check.period then return nil end
    ran[check.name] = tg
    if check.pred(ctx, slot) and slot.palette[check.name] then return check.name end
    return nil
end


-- =========================================================================
-- THE SCAN: aim always, then (only when the current maneuver is done) refresh + the wait checks.
-- =========================================================================

function action_at_combat:execute()
    action_base.execute(self)
    local npc = self.object
    local id, tg = npc:id(), time_global()
    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return end
    local slot = _slot(id)
    local ran  = slot.ran_at

    -- aim (wait = false): re-point every tick, unless the weapon is stowed (a flee faces its run path).
    if slot.fire ~= STOW and tg - (ran.aim or 0) >= AIM_MS then
        ran.aim = tg
        xcombat.aim_at(npc, enemy:position())
    end

    -- the wait checks only fire once the current maneuver is done.
    if not _maneuver_done(npc, slot, tg) then return end

    -- refresh LOS first: _gather reads slot.sees to pick the track position (live vs last-known), and the
    -- tactical checks (is_blocked_wall, is_enemy_unseen) consume it too.
    _probe_see(npc, enemy, slot, tg)

    local prof = xprofiler.new_if(_dbg):start()
    local ctx = self:_gather(npc, id, enemy, slot, tg)
    local gather_us = prof:stop():get_us()

    -- refresh the palette (is_context_changed) and the cheap reads the checks consume.
    prof = xprofiler.new_if(_dbg):start()
    if tg - (ran.context or 0) >= CONTEXT_MS then
        ran.context = tg
        doctrine.refresh(slot, npc, ctx.npc_pos, ctx.npc_lvid)
    end
    local refresh_us = prof:stop():get_us()

    prof = xprofiler.new_if(_dbg):start()
    doctrine.range_zone(slot, ctx.dist)
    local read_us = prof:stop():get_us()

    -- run every due check; a true one with an eligible maneuver becomes a candidate; shuffle-pick one.
    prof = xprofiler.new_if(_dbg):start()
    local fired, count = nil, 0
    local checks = doctrine.CHECKS
    for i = 1, #checks do
        local name = _check_fires(checks[i], ctx, slot, tg, ran)
        if name then
            count = count + 1
            fired = fired or {}
            fired[count] = name
        end
    end
    local checks_us = prof:stop():get_us()
    local picked, maneuver
    if count > 0 then
        picked = fired[math_random(count)]
        maneuver = doctrine.pick(picked, slot)
    end
    if maneuver then
        self:_start(maneuver, ctx, slot, picked)
    elseif slot.fire == STOW then
        -- a finished flee left the weapon down and nothing else fired: re-arm and hold fire in place.
        maneuver = "hold_fire"
        self:_start(maneuver, ctx, slot, "rearm")
    end
    at_combat_trace.scan(id, ctx, picked, maneuver, gather_us, refresh_us, read_us, checks_us)
end

function action_at_combat:finalize()
    action_base.finalize(self)
    local npc = self.object
    local id = npc:id()
    local slot = _combat[id]
    if slot then
        xcombat.release_cover(slot.cover_lvid, id)
        slot.cover_lvid = nil
        slot.fire = nil
    end
    npc:sniper_fire_mode(false)
end


-- =========================================================================
-- Lifecycle: install, unregister, MCM refresh
-- =========================================================================

local function _install(npc)
    if not npc then return end
    if not IsStalker(npc) then return end
    local id = npc:id()
    if _takeover_installed[id] then return end

    local manager = npc:motivation_action_manager()
    if not manager then return end
    _takeover_installed[id] = true

    manager:add_evaluator(EVAL_ID, evaluator_at_combat("eva_at_combat"))

    local action = action_at_combat("act_at_combat")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    -- Wounded yields to the engine wounded scheme, the way every vanilla planner-blocking scheme does
    -- (axr_stalker_panic, axr_fight_from_cover, ...). The engine evaluates sidor_wounded_base for every stalker
    -- already, so this adds no per-frame cost and replaces the old per-poll IsWounded check in the evaluator.
    action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base, false))
    action:add_precondition(world_property(EVAL_ID, true))
    action:add_effect(world_property(EVAL_ID, false))
    manager:add_action(ACT_ID, action)

    local blocked = {
        stalker_ids.action_combat_planner,
        stalker_ids.action_danger_planner,
        xr_danger.actid,
        xr_actions_id.state_mgr + 2,
        xr_actions_id.alife,
    }
    for i = 1, #blocked do
        local act = manager:action(blocked[i])
        if act then act:add_precondition(world_property(EVAL_ID, false)) end
    end
end

local function _on_net_spawn(npc)
    _install(npc)
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    _takeover_installed[id] = nil
    local slot = _combat[id]
    if slot then
        xcombat.release_cover(slot.cover_lvid, id)
        slot.cover_lvid = nil
    end
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _takeover_installed[id] = nil
    local slot = _combat[id]
    if slot then xcombat.release_cover(slot.cover_lvid, id) end
    _combat[id] = nil
    at_combat_trace.forget(id)
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    at_combat_trace.set_enabled(_dbg)
end

--- Current maneuver name for an NPC (at_hud reads it), or nil when AT is not driving one.
function get_maneuver(id)
    local slot = _combat[id]
    return slot and slot.maneuver
end

local function _on_first_update()
    _takeover_installed = {}
    _combat    = {}
    at_combat_trace.reset()
    _refresh_log()
    log.info("Combat module initialized (enabled=%s share=%.2f dbg=%s)",
        cfg.combat_enabled and "true" or "false",
        cfg.combat_share or 1.0,
        _dbg and "true" or "false")
end

-- The takeover decision, recomputed off the hot path. npc_on_update fires every frame for every online stalker
-- (xr_motivator.script:486), even while vanilla drives, so it keeps slot.eval fresh for the evaluator to read.
-- Self-throttled to EVAL_PERIOD_MS (gate runs before any work); this is where best_enemy / see / has_info now
-- live, off the engine-polled evaluator. _takeover_installed gate skips any stalker AT did not install on.
local function _on_update(npc)
    local id = npc:id()
    if not _takeover_installed[id] then return end
    local slot = _slot(id)
    local tg = time_global()
    if tg - (slot.eval_at or 0) < EVAL_PERIOD_MS then return end
    slot.eval_at = tg
    slot.eval, slot.reason = _should_manage(npc, id, tg)
    if _dbg then
        at_combat_trace.set_name(id, npc:name())
        at_combat_trace.eval(id, slot.eval, slot.reason, slot)
        local mgr = npc:motivation_action_manager()
        local cur = (mgr and mgr:initialized()) and mgr:current_action_id() or nil
        at_combat_trace.curact(id, slot.eval, _act_label(cur), cur)
    end
end

function on_game_start()
    _load_tunables()
    doctrine.load_tunables()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("npc_on_update",               _on_update)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

--- at_combat: Pattern B planner takeover with delta-driven state machines + rule lists
--- per-faction x per-environment. State variables: health / environment / contact /
--- squad / friendly_line / range_fit / threat / position. Decide walks the faction's
--- rule list top-down, first match wins (squad-uniqueness skip with fallback).

local IsStalker, IsWounded, time_global = IsStalker, IsWounded, time_global
local character_community = character_community
local math_sqrt, math_floor, math_min = math.sqrt, math.floor, math.min
local RegisterScriptCallback = RegisterScriptCallback
local move, look, anim, state_mgr, vector = move, look, anim, state_mgr, vector

local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

local EVAL_ID = 188200
local ACT_ID  = 188200

-- =========================================================================
-- LTX tunables (deferred load: ini_file at module scope is a freeze hazard)
-- =========================================================================

local LTX_PATH    = "alifetactics\\at_combat.ltx"
local LTX_SECTION = "at_combat"

local ADVANCE_STEP_M, STEP_AWAY_M, CHARGE_MIN_DIST_M, STEP_SHORT_M
local FLANK_LATERAL_M, FLANK_FORWARD_M, FLEE_STEP_M, COVER_REACH_SQR
local SQUAD_LATERAL_BUCKETS, SQUAD_LATERAL_STEP_M
local THROTTLE_NPC_MS
local FRIENDLY_LINE_THRESH_M
local FAIL_BACKOFF_MS, FAIL_THRESHOLD

local function _load_tunables()
    local ini = ini_file(LTX_PATH)
    local function f(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    local function i(k, d) local v = ini:r_float_ex(LTX_SECTION, k); return v and math_floor(v) or d end
    ADVANCE_STEP_M           = f("advance_step_m",            15)
    STEP_AWAY_M              = f("step_away_m",               15)
    STEP_SHORT_M             = f("step_short_m",              4)
    CHARGE_MIN_DIST_M        = f("charge_min_dist_m",         10)
    FLANK_LATERAL_M          = f("flank_lateral_m",           20)
    FLANK_FORWARD_M          = f("flank_forward_m",           5)
    FLEE_STEP_M              = f("flee_step_m",               30)
    COVER_REACH_SQR          = f("cover_reach_sqr",           2025)
    SQUAD_LATERAL_BUCKETS    = i("squad_lateral_buckets",     5)
    SQUAD_LATERAL_STEP_M     = f("squad_lateral_step_m",      4)
    THROTTLE_NPC_MS          = i("throttle_npc_ms",           1500)
    FRIENDLY_LINE_THRESH_M   = f("friendly_line_thresh_m",    1.5)
    FAIL_BACKOFF_MS          = i("fail_backoff_ms",           10000)
    FAIL_THRESHOLD           = i("fail_threshold",            3)
end


-- =========================================================================
-- Per-NPC tracking (state machines, throttle, fail backoff, install sentinel)
-- =========================================================================

local _installed        = {}
local _state            = {}
local _last_decide_npc  = {}
local _last_eval        = {}
local _last_reason      = {}
local _fail_until       = {}
local _fail_streak      = {}
local _community        = {}

-- All decision tracing + telemetry lives in at_combat_trace (DEBUG-gated, noop off). The pipeline
-- below calls at_combat_trace.* directly; _dbg only gates the xprofiler timers and the per-frame eval.



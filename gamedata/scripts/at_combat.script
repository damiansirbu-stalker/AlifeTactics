--- at_combat: the intermittent takeover monitor - seizes one NPC for one committed maneuver where vanilla is weak, then hands back. Doctrine in at_combat_doctrine, graft in xcombat.

local IsStalker, time_global, tostring = IsStalker, time_global, tostring
local math_floor, RegisterScriptCallback, AC_ID = math.floor, RegisterScriptCallback, AC_ID

local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine
local trace = at_combat_trace
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"
local BEGIN_PERIOD_MS, UPDATE_PERIOD_MS, END_PERIOD_MS, HIT_FIGHT_MS, RESEIZE_COOLDOWN_MS
local SEIZE_RADIUS_SQR

local COMPANION_INFO = "npcx_is_companion"
local MANEUVER_CAP_MS = 8000
local MAX_CONCURRENT


-- Per-NPC state store: one flat record per installed NPC, created on first touch. Never saved.

local _installed = {}
local _states    = {}
-- ONLINE NPCs currently holding a maneuver. MAX_CONCURRENT caps how many run at once (bounds ongoing
-- cost and keeps most of the field on vanilla). _drop_gate keeps it honest on every gate-clearing path
-- (end AND despawn), so a dead NPC can never leak a slot.
local _open_count = 0

local function _state(id)
    local state = _states[id]
    if not state then state = { id = id, ran_at = {} } _states[id] = state end
    return state
end


-- Fight detection and the seize gates: one named predicate each.

-- In a fight = the engine selected an enemy, OR a hit landed recently (the far-shooter case, where the enemy is
-- out of the distance gate so best_enemy is still nil but the NPC is plainly under fire). Takes the enemy the
-- caller already read (one best_enemy luabind per begin check, not two).
local function _is_fighting(enemy, state, tg)
    if enemy ~= nil then return true end
    return state.hit_at ~= nil and (tg - state.hit_at) < HIT_FIGHT_MS
end

-- Eligibility: does AT manage this NPC at all. Enabled, inside the share, not a companion. Changes rarely.
local function _manages(npc)
    if not cfg.combat_enabled then return false end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return false end
    return true
end

-- Seizability: armed and not already in a smart cover (vanilla owns that micro). No indoor gate - the
-- takeover fights everywhere; xcombat.is_indoor (a proper roof+walls raycast) stays available if a future
-- maneuver ever needs it, but the takeover does not.
local function _can_seize(npc)
    if not xcombat.get_weapon_kind(npc) then return false, "no_weapon" end
    if npc:in_smart_cover() then return false, "smart_cover" end
    return true
end


-- The maneuver lifecycle: _try_begin_maneuver stages a row and raises the gate; the engine grants control at the
-- grafted action's initialize and calls _begin_maneuver (the first engine write); _update_maneuver re-runs the
-- row's update while it runs; _try_end_maneuver calls _end_maneuver on arrival or the cap.

-- Release the reserved cover vertex. Every state-dropping path calls this (_end_maneuver AND the
-- death/despawn handlers): nothing else ever cleans a dead NPC's claim in db.used_level_vertex_ids.
local function _release_cover(state)
    if state and state.cover_lvid then
        xcombat.release_cover(state.cover_lvid, state.id)
        state.cover_lvid = nil
    end
end

-- Lower the gate and keep the concurrent count honest. EVERY path that clears an open gate routes here
-- (_end_maneuver AND the death/despawn handlers), so _open_count can never leak a slot to a dead NPC.
local function _drop_gate(state)
    if state and state.gate then
        _open_count = _open_count - 1
        if _open_count < 0 then _open_count = 0 end
        state.gate = false
    end
end

-- End the maneuver: lower the gate, clear the row, keep end_at for the reseize cooldown. Releases any cover the
-- feasibility check reserved, on EVERY exit (arrived, cap, never-begun) so a gate that raised but never ran a maneuver
-- does not leak the reservation in db.used_level_vertex_ids (t136).
local function _end_maneuver(state, tg, reason, check_us)
    if _dbg then trace.end_maneuver(state.id, state.maneuver and state.maneuver.name, reason, math_floor(tg - (state.begin_at or tg)), check_us) end
    _drop_gate(state)
    state.maneuver = nil
    state.dest = nil
    state.trigger = nil
    state.maneuver_at = nil
    state.begin_at = nil
    state.end_at = tg
    _release_cover(state)
end

-- Begin the maneuver - the first engine write, at the grafted action's initialize (the engine granted control
-- this frame; writing earlier would fight vanilla, which drives until the planner swap). Sets the destination
-- once (the engine walks it), applies the row's combat state once, opens a STOW rout's flee hold. Target
-- commitment: the maneuver fights the enemy it was STAGED against (state.enemy_id), never whatever the brain
-- re-selected since - a gone/dead target means the maneuver does not begin. The begin write is timed in two
-- parts (send=/apply=, debug only) so a slow begin names which engine call cost it - send_to or apply_state.
local function _begin_maneuver(npc)
    local state = _states[npc:id()]
    if not state or not state.maneuver then return end
    local tg = time_global()
    local maneuver = state.maneuver
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    if not enemy then _end_maneuver(state, tg, "target_lost") return end
    local tmr_send = xprofiler.new_if(_dbg):start()
    xcombat.send_to(npc, state.dest)
    tmr_send:stop()
    local tmr_apply = xprofiler.new_if(_dbg):start()
    local fire, gate = doctrine.apply_state(npc, maneuver, enemy)
    tmr_apply:stop()
    state.maneuver_at = tg
    if maneuver.fire == xcombat.STOW then
        state.flee_enemy = enemy:id()
        state.flee_until = tg + (maneuver.timeout or MANEUVER_CAP_MS) + RESEIZE_COOLDOWN_MS
    else
        state.flee_enemy = nil
    end
    if _dbg then
        trace.begin_maneuver(state.id, maneuver.name, state.trigger, state.dest, fire, maneuver.movement,
            maneuver.fire, gate, state.cover, math_floor(tmr_send:get_us()), math_floor(tmr_apply:get_us()))
    end
end

-- One spec drives every AT NPC: gate = the per-NPC flag the grafted evaluator polls; on_begin = _begin_maneuver,
-- called once when the grafted action activates. Per-NPC state lives in _states, keyed by id.
-- The gate reads cfg.combat_enabled FIRST: the graft installs for every stalker even when the feature is off,
-- and the engine re-evaluates the grafted evaluator every plan solve (problem_solver actual()), so with the
-- feature disabled the whole crossing is one Lua boolean read - the npc:id() luabind never runs.
local SPEC = {
    gate = function(npc)
        if not cfg.combat_enabled then return false end
        local state = _states[npc:id()]
        return state ~= nil and state.gate == true
    end,
    on_begin = _begin_maneuver,
}

-- Debug-only decision trace, gated here so the bridge reads (name, operator, facing, sight, cover) never run
-- when tracing is off. The cover read happens at DECIDE time, before any seize: under a takeover block the
-- planner flags can only decay (the blocked planner cannot run take_cover, the on_best_cover_changed clear
-- still fires), so the pre-seize value is the truthful one - the begin line reprints it from state.cover.
local function _trace_decision(npc, state, enemy, result)
    if not _dbg then return end
    local enemy_pos = enemy:position()
    state.enemy_name = xcreature.get_name(enemy:id())
    state.operator   = xcombat.get_operator(npc)
    state.aim_off    = math_floor(xcombat.get_facing_offset(npc, enemy_pos))
    state.seen       = xcombat.sees(npc, enemy)
    local in_cover, looked_out, held = xcombat.get_cover_state(npc)
    state.cover = trace.cover_string(in_cover, looked_out, held,
        xcombat.has_obstacle_to_target(enemy_pos, npc:position()))
    trace.decision(state.id, state, result or "none")
end

-- The seize gates after the fighting read, cheapest first. Returns (skip reason, detail) for the monitor
-- trace, or nil when the NPC may walk the catalog.
-- Eligibility: a fight WITH the actor is never truncated (one compare; the engine's own is_enemy
-- distance gates bound where those fights form, so this adds no long-range behavior of its own). An
-- NPC-vs-NPC fight qualifies only within the seize radius of the actor - beyond it a maneuver is
-- spectacle nobody can see, and it holds a concurrency slot. actor_dist_sqr is a 5s-TTL cached read.
-- Concurrency cap (failsafe): the field is full, so skip the catalog walk (and its can_maneuver
-- raycasts) before any expensive read; the NPC retries on its next begin check.
local function _seize_blocked(npc, state)
    if SEIZE_RADIUS_SQR > 0 and state.enemy_id ~= AC_ID
        and xcombat.actor_dist_sqr(npc) > SEIZE_RADIUS_SQR then
        return "far"
    end
    local can_seize, seize_block = _can_seize(npc)
    if not can_seize then return "cannot_seize", seize_block end
    if MAX_CONCURRENT > 0 and _open_count >= MAX_CONCURRENT then return "at_cap" end
    return nil
end

-- Look for a maneuver to begin: managed, off cooldown, fighting, the enemy eligible, seizable, under the cap,
-- a catalog row picked (its need fired, palette matched, its can_maneuver yielded a destination). Staging =
-- record the row + destination and raise the gate; the engine grants control at the next plan solve and calls
-- _begin_maneuver. No engine write happens here - vanilla still drives this frame.
local function _try_begin_maneuver(npc, state, tg)
    if not _manages(npc) then state.fighting = false return end
    local tmr = xprofiler.new_if(_dbg):start()

    -- Reseize cooldown FIRST: hold off a fresh seize for a window after a maneuver ends, else the takeover
    -- goes continuous. Checked before the fighting read so a cooling NPC skips the best_enemy luabind entirely.
    if RESEIZE_COOLDOWN_MS > 0 and state.end_at and (tg - state.end_at) < RESEIZE_COOLDOWN_MS then
        tmr:stop()
        trace.monitor(state.id, state, "cooldown", nil, tmr:get_us())
        return
    end

    local enemy = npc:best_enemy()
    state.fighting = _is_fighting(enemy, state, tg)
    if not state.fighting then state.stall_set = false state.row_cursor = 1 return end
    if _dbg then trace.set_name(state.id, npc:name()) end

    if not enemy then
        state.enemy_id = nil
        tmr:stop()
        trace.monitor(state.id, state, "no_enemy", nil, tmr:get_us())
        return
    end
    state.enemy_id = enemy:id()

    local blocked, block_detail = _seize_blocked(npc, state)
    if blocked then
        tmr:stop()
        trace.monitor(state.id, state, blocked, block_detail, tmr:get_us())
        return
    end

    -- resolve_maneuver arbitrates the catalog from the per-NPC cursor (per row: should_maneuver ->
    -- palette -> can_maneuver). A row whose need is absent falls through in the same tick; the one
    -- can_maneuver that runs ends the walk and moves the cursor past its row (decline = defer, pick =
    -- the next decision starts below). Returns (maneuver, dest) on a pick and nil otherwise; it stores
    -- the fired situation on state.trigger and the walked rows + timings on state.rows / state.walk_us.
    local maneuver, dest = doctrine.resolve_maneuver(npc, enemy, state, tg)
    if maneuver then
        state.gate = true
        _open_count = _open_count + 1
        state.maneuver = maneuver
        state.dest = dest
        state.maneuver_at = nil
        state.begin_at = tg
    end
    tmr:stop()
    if _dbg then state.check_us = math_floor(tmr:get_us()) end
    _trace_decision(npc, state, enemy, maneuver and maneuver.name)
end

-- Run the maneuver's own update from its catalog row (a firing row re-checks its shot, flee re-asserts its
-- holster, a row without one does nothing). Begun-guarded: no engine write before _begin_maneuver ran.
-- Target commitment: the row keeps aiming at the STAGED enemy (state.enemy_id) for the maneuver's whole
-- life; a gone/dead target applies READY here and the end check closes the maneuver on its next period.
-- The debug trace is the mid-maneuver aim evidence: sight to the staged target, body-to-target angle,
-- applied fire + gate.
local function _update_maneuver(npc, state, _tg)
    local maneuver = state.maneuver
    if not maneuver or not state.maneuver_at then return end
    if not maneuver.update then return end
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    local tmr = xprofiler.new_if(_dbg):start()
    local fire, gate = maneuver.update(npc, maneuver, enemy)
    tmr:stop()
    if not _dbg then return end
    local us = math_floor(tmr:get_us())
    if not enemy then
        trace.update_maneuver(state.id, maneuver.name, nil, fire, gate, us)
        return
    end
    trace.update_maneuver(state.id, maneuver.name, {
        id       = enemy:id(),
        name     = xcreature.get_name(enemy:id()),
        seen     = xcombat.sees(npc, enemy),
        aim_off  = math_floor(xcombat.get_facing_offset(npc, enemy:position())),
    }, fire, gate, us)
end

-- Movers end on arrival; the cap (from begin_at) ends everything, so a gate that raised but never began a
-- maneuver cannot wedge the NPC. Holds have no arrival and end only on the cap. A feature turned off
-- mid-maneuver ends here too: SPEC.gate already handed the NPC back to vanilla, so the row's update must
-- stop driving it - ending drops state.gate, which stops _update_maneuver on the same scan.
local function _try_end_maneuver(npc, state, tg)
    if not _manages(npc) then _end_maneuver(state, tg, "disabled") return end
    local maneuver = state.maneuver
    -- Target commitment: the staged enemy died or despawned - hand back now, vanilla picks the next
    -- fight. Only for a BEGUN maneuver; a staged-never-granted gate still ends on the cap below.
    if maneuver and state.maneuver_at and not xcombat.resolve_enemy(state.enemy_id) then
        _end_maneuver(state, tg, "target_lost")
        return
    end
    local tmr = xprofiler.new_if(_dbg):start()
    if maneuver and maneuver.ends_on == "arrival" and state.maneuver_at and xcombat.is_arrived(npc) then
        tmr:stop()
        _end_maneuver(state, tg, "arrived", math_floor(tmr:get_us()))
    elseif (tg - (state.begin_at or tg)) >= ((maneuver and maneuver.timeout) or MANEUVER_CAP_MS) then
        tmr:stop()
        _end_maneuver(state, tg, "cap", math_floor(tmr:get_us()))
    end
end


-- The scan: every timed operation is one row { name, period, open, run }; open is the state.gate value the check
-- requires (false = no maneuver open, true = one running). Built in _load_config, after the periods are read.

local SCAN

local function _build_scan()
    SCAN = {
        { name = "begin_maneuver",  period = BEGIN_PERIOD_MS,  open = false, run = _try_begin_maneuver },
        { name = "update_maneuver", period = UPDATE_PERIOD_MS, open = true,  run = _update_maneuver    },
        { name = "end_maneuver",    period = END_PERIOD_MS,    open = true,  run = _try_end_maneuver   },
    }
end

-- Run one check: bail unless its own period elapsed, else stamp and run.
local function _run_check(check, npc, state, tg)
    if tg - (state.ran_at[check.name] or 0) < check.period then return end
    state.ran_at[check.name] = tg
    check.run(npc, state, tg)
end

-- npc_on_update fires every frame for every online stalker (xr_motivator.script:486); between due periods this
-- walk is three compares and returns - no engine read or write happens outside a due check.
local function _on_update(npc)
    local id = npc:id()
    if not _installed[id] then return end
    local state = _state(id)
    local tg = time_global()
    local open = state.gate == true
    for i = 1, #SCAN do
        local check = SCAN[i]
        if check.open == open then _run_check(check, npc, state, tg) end
    end
end


-- Public API consumed by at_hud and the at_test observer.

--- Current maneuver name for an NPC, or nil when AT is not driving one.
function get_maneuver(id)
    local state = _states[id]
    return state and state.maneuver and state.maneuver.name
end

--- Takeover status word for an NPC: the maneuver name while one is open, "cooldown" through the
--- reseize window after one ended, nil otherwise. The at_hud maneuver column reads this.
function get_status(id)
    local state = _states[id]
    if not state then return nil end
    if state.maneuver then return state.maneuver.name end
    if state.end_at and RESEIZE_COOLDOWN_MS > 0 and (time_global() - state.end_at) < RESEIZE_COOLDOWN_MS then
        return "cooldown"
    end
    return nil
end


-- Lifecycle: install on spawn, stamp the far-shooter fight entry on hit, clean up on destroy / unregister.

local function _install(npc)
    if not npc or not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    xcombat.install_takeover(npc, SPEC)
    if _dbg then trace.installed(id, npc:name()) end
end

-- A hit stamps the fight clock (far-shooter reads as fighting). After hand-back a hit means the fled enemy
-- caught up, so clear flee_enemy and let the NPC fight back.
local function _on_hit(npc, amount)
    if not npc or not amount or amount <= 0 then return end
    local id = npc:id()
    if not _installed[id] then return end
    local state = _state(id)
    state.hit_at = time_global()
    if not state.gate then state.flee_enemy = nil end
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    xcombat.release_takeover(npc)
    _drop_gate(_states[id])
    _release_cover(_states[id])
    _installed[id] = nil
    _states[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    -- Clear xcombat's install guard too: an id unregistered WITHOUT a prior net_destroy would leave a stale
    -- guard there and the recycled id would silently skip its next graft.
    xcombat.release_takeover_id(id)
    _drop_gate(_states[id])
    _release_cover(_states[id])
    _installed[id] = nil
    _states[id] = nil
    if _dbg then trace.forget(id) end
end

-- While a fleeing NPC still has an active ignore (state.flee_enemy set, state.flee_until not reached), answer the
-- engine is_enemy check false so it does not turn the NPC back to fight. _begin_maneuver sets it; a non-flee
-- maneuver or a hit clears it.
local function _on_enemy_eval(obj, enemy, flags)
    if not obj or not enemy then return end
    local state = _states[obj:id()]
    if not state or not state.flee_enemy then return end
    if enemy:id() == state.flee_enemy and time_global() < state.flee_until then
        flags.override = true
        flags.result = false
    end
end

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    BEGIN_PERIOD_MS     = read_int("begin_period_ms",     500)
    UPDATE_PERIOD_MS    = read_int("update_period_ms",    200)
    END_PERIOD_MS       = read_int("end_period_ms",       200)
    HIT_FIGHT_MS        = read_int("hit_fight_ms",        5000)
    RESEIZE_COOLDOWN_MS = read_int("reseize_cooldown_ms", 5000)
    MAX_CONCURRENT      = read_int("max_concurrent_maneuvers", 20)
    local radius_m      = read_int("seize_actor_radius_m", 50)
    SEIZE_RADIUS_SQR    = radius_m * radius_m
    _build_scan()
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    trace.set_enabled(_dbg)
end

local function _on_first_update()
    trace.reset()
    _open_count = 0
    _refresh_log()
    log.info("Combat monitor initialized (enabled=%s dbg=%s cap=%d)",
        tostring(cfg.combat_enabled), tostring(_dbg), MAX_CONCURRENT)
end

function on_game_start()
    _load_config()
    doctrine.load_config()
    RegisterScriptCallback("npc_on_net_spawn",            _install)
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_on_update",               _on_update)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("on_enemy_eval",               _on_enemy_eval)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

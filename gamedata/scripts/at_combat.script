--- at_combat: Pattern B planner takeover (goap-injection.md:427-447). Per-NPC
--- list of allowed behaviors (chosen by faction / weapon / hp); within the
--- list, first behavior whose applies(ctx) check matches the situation fires.

local RegisterScriptCallback, IsStalker, IsWounded, time_global = RegisterScriptCallback, IsStalker, IsWounded, time_global
local character_community, tostring, math_sqrt, math_random, math_min, math_max = character_community, tostring, math.sqrt, math.random, math.min, math.max

local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg

local EVAL_ID = 188200
local ACT_ID  = 188200

local ADVANCE_STEP_M       = 15
local STEP_AWAY_M          = 15
local CHARGE_STEP_M        = 20
local FLANK_LATERAL_M      = 20
local FLANK_FORWARD_M      = 5
local FLEE_STEP_M          = 30
-- best_cover viability: max search radius (15) + max distance to enemy (30) = 45m.
-- target_pos farther than this from enemy yields no valid cover (engine constraint),
-- so skip the call and fall straight to the open-terrain branch. Cuts wasted engine
-- quadtree queries for long-range ADVANCE and FLANKING ticks.
local COVER_REACH_SQR      = 2025
local KEEP_POINT_MIN       = 1500
local KEEP_POINT_MAX       = 3500
local BEHAVIOR_HOLD_MIN    = 1500
local BEHAVIOR_HOLD_MAX    = 3500
local FAIL_THRESHOLD       = 3
local FAIL_BACKOFF_MS      = 10000
local WEAPON_KIND_TTL_MS   = 2000

-- Engaged NPC disengages at (min_dist - this); stops boundary flicker.
local EVAL_HYSTERESIS_M    = 2

-- Squad spread: per-NPC lateral offset bucket. Stable hash on npc:id() picks
-- one of N buckets centered on 0; buckets are {-(N-1)/2..(N-1)/2} * step.
-- Same NPC always lands in the same bucket across save / load so squad
-- members deterministically fan out across the engagement line.
local SQUAD_LATERAL_BUCKETS = 5
local SQUAD_LATERAL_STEP_M  = 4

-- Weapon kinds that trigger CLOSE_ASSAULT.applies (charge instead of cover work).
-- These weapons want close-quarters engagement; fire-from-cover at range is
-- ineffective for them.
local AGGRESSOR_KINDS = {
    w_pistol  = true,
    w_shotgun = true,
    w_smg     = true,
    w_knife   = true,
}

local _installed        = {}
local _last_eval        = {}
local _last_eval_logged = {}
local _last_reason      = {}
local _fail_until       = {}
local _fail_streak      = {}

-- Cached at npc_on_net_spawn. character_community never changes for an NPC.
local _community   = {}

-- Cached lazily in gather. NPCs rarely swap weapons mid-fight; 2s TTL avoids
-- per-tick item_in_slot + r_string_ex while still catching swaps within a
-- typical engagement window. Entry shape: { kind = string|nil, expires = ms }.
local _weapon_kind = {}


-- =========================================================================
-- Cache accessors
-- =========================================================================

local function _get_community(npc, id)
    local cached = _community[id]
    if cached ~= nil then return cached end
    -- Defensive: install populates the cache, but fallback covers race / missed callback.
    local fresh = character_community(npc) or ""
    _community[id] = fresh
    return fresh
end

-- Reads the primary slot first (rifles, shotguns, SMGs, snipers all share
-- SLOT_RIFLE). Falls back to pistol then knife if primary slot is empty.
-- Uses item_in_slot rather than npc:active_item() so the result is stable
-- across animation transitions where active_item briefly returns nil.
local function _get_weapon_kind(npc, id, tg)
    local entry = _weapon_kind[id]
    if entry and tg < entry.expires then return entry.kind end
    local wpn = xinventory.get_equipped_rifle(npc)
             or xinventory.get_equipped_pistol(npc)
             or xinventory.get_equipped_knife(npc)
    local kind
    if wpn then
        local section = wpn:section()
        if section then kind = ini_sys:r_string_ex(section, "kind") end
    end
    _weapon_kind[id] = { kind = kind, expires = tg + WEAPON_KIND_TTL_MS }
    return kind
end


-- =========================================================================
-- Cover reservation
-- =========================================================================

local function _claim_cover(lvid, id)
    if not lvid or lvid >= 4294967295 then return false end
    local owner = db.used_level_vertex_ids[lvid]
    if owner and owner ~= id then return false end
    db.used_level_vertex_ids[lvid] = id
    return true
end

local function _release_cover(lvid, id)
    if not lvid then return end
    if db.used_level_vertex_ids[lvid] == id then
        db.used_level_vertex_ids[lvid] = nil
    end
end

local function _reservation_stolen(lvid, id)
    if not lvid then return false end
    local owner = db.used_level_vertex_ids[lvid]
    return owner ~= nil and owner ~= id
end


-- =========================================================================
-- Squad lateral spread offset (perpendicular to npc -> enemy vector)
-- =========================================================================

local function _lateral_offset(bucket, dx, dz, dist)
    if not bucket or not dist or dist <= 0 then return 0, 0 end
    local lateral_m = (bucket - (SQUAD_LATERAL_BUCKETS - 1) * 0.5) * SQUAD_LATERAL_STEP_M
    return -dz / dist * lateral_m, dx / dist * lateral_m
end


-- =========================================================================
-- Target resolvers. Each returns a level_vertex_id (or nil on fail).
-- =========================================================================

-- cover_step_fwd: step 15m toward enemy, find cover near that point, apply
-- lateral squad spread. Fallback: vertex_in_direction for open terrain.
local function _resolve_cover_step_fwd(npc, ctx)
    local step = ADVANCE_STEP_M
    local target_pos
    if ctx.dist <= step then
        target_pos = vector():set(ctx.ene_pos.x, ctx.npc_pos.y, ctx.ene_pos.z)
    else
        local k = step / ctx.dist
        target_pos = vector():set(
            ctx.npc_pos.x + ctx.dx * k,
            ctx.npc_pos.y,
            ctx.npc_pos.z + ctx.dz * k)
    end
    local off_x, off_z = _lateral_offset(ctx.bucket, ctx.dx, ctx.dz, ctx.dist)
    target_pos.x = target_pos.x + off_x
    target_pos.z = target_pos.z + off_z
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local cover = npc:best_cover(target_pos, ctx.ene_pos, 15, 1, 30)
        local lvid = cover and cover:level_vertex_id()
        if lvid and lvid < 4294967295 and npc:accessible(lvid) then return lvid end
    end
    if ctx.dist > 0 then
        local dir = vector():set(ctx.dx / ctx.dist, 0, ctx.dz / ctx.dist)
        local fb = level.vertex_in_direction(ctx.npc_lvid, dir, step)
        if fb and fb < 4294967295 and npc:accessible(fb) and fb ~= ctx.npc_lvid then return fb end
    end
    return nil
end

-- cover_nearest: cover near NPC that hides from enemy, lateral spread applied.
-- Two-tier radius (10 then 30) mirrors vanilla find_best_cover (ai_stalker_cover.cpp:141, 150).
local function _resolve_cover_nearest(npc, ctx)
    local off_x, off_z = _lateral_offset(ctx.bucket, ctx.dx, ctx.dz, ctx.dist)
    local search_pos = vector():set(
        ctx.npc_pos.x + off_x,
        ctx.npc_pos.y,
        ctx.npc_pos.z + off_z)
    local cover = npc:best_cover(search_pos, ctx.ene_pos, 10, 1, 20)
    local lvid = cover and cover:level_vertex_id()
    if lvid and lvid < 4294967295 and npc:accessible(lvid) then return lvid end
    cover = npc:best_cover(search_pos, ctx.ene_pos, 30, 1, 20)
    lvid = cover and cover:level_vertex_id()
    if lvid and lvid < 4294967295 and npc:accessible(lvid) then return lvid end
    return nil
end

-- step_away: step 15m backward from enemy, find cover, lateral spread applied.
local function _resolve_step_away(npc, ctx)
    if ctx.dist <= 0 then return nil end
    local step = STEP_AWAY_M
    local k = step / ctx.dist
    local target_pos = vector():set(
        ctx.npc_pos.x - ctx.dx * k,
        ctx.npc_pos.y,
        ctx.npc_pos.z - ctx.dz * k)
    local off_x, off_z = _lateral_offset(ctx.bucket, ctx.dx, ctx.dz, ctx.dist)
    target_pos.x = target_pos.x + off_x
    target_pos.z = target_pos.z + off_z
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local cover = npc:best_cover(target_pos, ctx.ene_pos, 15, 1, 30)
        local lvid = cover and cover:level_vertex_id()
        if lvid and lvid < 4294967295 and npc:accessible(lvid) then return lvid end
    end
    local dir = vector():set(-ctx.dx / ctx.dist, 0, -ctx.dz / ctx.dist)
    local fb = level.vertex_in_direction(ctx.npc_lvid, dir, step)
    if fb and fb < 4294967295 and npc:accessible(fb) and fb ~= ctx.npc_lvid then return fb end
    return nil
end

-- charge_enemy: head straight to enemy's lvid. No cover seeking. Reservation
-- is skipped at the _repick layer because multiple aggressors converging on
-- the same enemy is the intended behavior.
local function _resolve_charge_enemy(npc, ctx)
    local elvid = ctx.enemy:level_vertex_id()
    if elvid and elvid < 4294967295 and npc:accessible(elvid) then return elvid end
    if ctx.dist > 0 then
        local dir = vector():set(ctx.dx / ctx.dist, 0, ctx.dz / ctx.dist)
        local step = math_min(ctx.dist, CHARGE_STEP_M)
        local fb = level.vertex_in_direction(ctx.npc_lvid, dir, step)
        if fb and fb < 4294967295 and npc:accessible(fb) and fb ~= ctx.npc_lvid then return fb end
    end
    return nil
end

-- hold: stay at current target_lvid (or current npc_lvid if no target yet).
local function _resolve_hold(_npc, ctx, self)
    return self.target_lvid or ctx.npc_lvid
end

-- cover_flank: lateral 20m perpendicular to npc->enemy + 5m forward, find cover
-- near that point. Per-id sign (id % 2) picks left/right; same NPC always flanks
-- the same side. In a squad, half-and-half split emerges to a natural pincer.
-- At long ranges the best_cover max_dist=30 constraint usually fails; falls
-- back to vertex_in_direction along the perpendicular.
local function _resolve_cover_flank(npc, ctx)
    if ctx.dist <= 0 then return nil end
    local sign = (ctx.id % 2 == 0) and 1 or -1
    local nx, nz = ctx.dx / ctx.dist, ctx.dz / ctx.dist
    local perp_x, perp_z = -nz * sign, nx * sign
    local target_pos = vector():set(
        ctx.npc_pos.x + perp_x * FLANK_LATERAL_M + nx * FLANK_FORWARD_M,
        ctx.npc_pos.y,
        ctx.npc_pos.z + perp_z * FLANK_LATERAL_M + nz * FLANK_FORWARD_M)
    if target_pos:distance_to_sqr(ctx.ene_pos) <= COVER_REACH_SQR then
        local cover = npc:best_cover(target_pos, ctx.ene_pos, 15, 1, 30)
        local lvid = cover and cover:level_vertex_id()
        if lvid and lvid < 4294967295 and npc:accessible(lvid) then return lvid end
    end
    local dir = vector():set(perp_x, 0, perp_z)
    local fb = level.vertex_in_direction(ctx.npc_lvid, dir, FLANK_LATERAL_M)
    if fb and fb < 4294967295 and npc:accessible(fb) and fb ~= ctx.npc_lvid then return fb end
    return nil
end

-- flee_far: pure backward sprint. No cover preference, no lateral spread.
-- 30m vertex along negated npc->enemy direction.
local function _resolve_flee_far(npc, ctx)
    if ctx.dist <= 0 then return nil end
    local dir = vector():set(-ctx.dx / ctx.dist, 0, -ctx.dz / ctx.dist)
    local fb = level.vertex_in_direction(ctx.npc_lvid, dir, FLEE_STEP_M)
    if fb and fb < 4294967295 and npc:accessible(fb) and fb ~= ctx.npc_lvid then return fb end
    return nil
end

local TARGET_RESOLVERS = {
    cover_step_fwd = _resolve_cover_step_fwd,
    cover_nearest  = _resolve_cover_nearest,
    step_away      = _resolve_step_away,
    charge_enemy   = _resolve_charge_enemy,
    cover_flank    = _resolve_cover_flank,
    flee_far       = _resolve_flee_far,
    hold           = _resolve_hold,
}


-- =========================================================================
-- Behaviors. Each row: plan (state/body/mvt/target), applies(ctx) check,
-- optional variants table for weapon-kind state overrides (sparse merge).
-- body / mvt as string keys; resolved at apply time via move[name] (engine
-- enum may not be bound at module load).
-- =========================================================================

local function _always_applies(_ctx) return true end

local BEHAVIORS = {
    ADVANCE = {
        plan = { state = "assault_fire", body = "standing", mvt = "run", target = "cover_step_fwd" },
        applies = function(ctx) return ctx.dist > cfg.advance_dist or not ctx.see end,
    },
    TAKE_COVER = {
        plan = { state = "hide_na", body = "crouch", mvt = "run", target = "cover_nearest" },
        applies = function(ctx) return ctx.see_me and not ctx.has_high_cover end,
    },
    SNIPE = {
        -- Crouched sniper-fire from current position. plan.sniper_aim flips the
        -- engine's m_sniper_fire_mode flag (ai_stalker_fire.cpp:193, 225, 239)
        -- so aim direction tracks m_head.target instead of weapon LastFD.
        plan = { state = "hide_sniper_fire", body = "crouch", mvt = "stand", target = "hold", sniper_aim = true },
        applies = function(ctx) return ctx.weapon_kind == "w_sniper" and ctx.see end,
    },
    FIRE_FROM_COVER = {
        plan = { state = "threat_fire", body = "standing", mvt = "stand", target = "hold" },
        applies = function(ctx) return ctx.has_high_cover and ctx.see end,
    },
    FIRE_HOLD = {
        plan = { state = "hide_fire", body = "crouch", mvt = "stand", target = "hold" },
        applies = function(ctx) return ctx.see end,
    },
    RETREAT = {
        plan = { state = "panic", body = "standing", mvt = "run", target = "step_away" },
        applies = function(ctx) return ctx.hp_frac < cfg.retreat_hp end,
    },
    CLOSE_ASSAULT = {
        plan = { state = "assault_fire", body = "standing", mvt = "run", target = "charge_enemy" },
        applies = function(ctx) return AGGRESSOR_KINDS[ctx.weapon_kind] == true end,
    },
    -- Mindless shamble for zombied: walk forward firing (raid_fire = weapon=fire,
    -- mvt=walk, mental=danger per state_lib.script:135-141). No cover seeking, no
    -- retreat — they don't think, they walk and shoot.
    ZOMBIE_SHAMBLE = {
        plan = { state = "raid_fire", body = "standing", mvt = "walk", target = "charge_enemy" },
        applies = _always_applies,
    },
    -- Lateral approach via cover_flank resolver. Disciplined behavior — used by
    -- military / monolith / merc when they have cover but no LOS to enemy at range.
    FLANKING = {
        plan = { state = "assault_fire", body = "standing", mvt = "run", target = "cover_flank" },
        applies = function(ctx) return ctx.dist > cfg.advance_dist and not ctx.see and ctx.has_high_cover end,
    },
    -- Tactical pullback firing. sneak_fire (state_lib.script:170-177) = weapon=fire,
    -- crouch, walk, danger. Combined with step_away target = NPC crouch-walks
    -- backward while engine fire dispatch keeps firing at sight target. HP-driven
    -- with id-hash gate so squads split (half pull back, half fall through to
    -- whatever else applies).
    RETREAT_AND_FIRE = {
        plan = { state = "sneak_fire", body = "crouch", mvt = "walk", target = "step_away" },
        applies = function(ctx) return ctx.hp_frac < cfg.retreat_hp and (ctx.id % 10) < 5 end,
    },
    -- Real flee. sprint (state_lib.script:99-105) = weapon=strapped, run, panic
    -- mental. Weapon goes away, NPC sprints backward via flee_far resolver, no
    -- firing, no cover preference.
    FLEE = {
        plan = { state = "sprint", body = "standing", mvt = "run", target = "flee_far" },
        applies = function(ctx) return ctx.hp_frac < cfg.retreat_hp end,
    },
    -- Catch-all for COWARD when NPC has no LOS and no other behavior applies.
    -- hide_na (state_lib.script:319-325) = weapon unstrapped, crouch, stand,
    -- danger mental, no animation. NPC stays put crouched silently. Prevents
    -- the otherwise-frozen NPC stall in coward lists that lack ADVANCE.
    HOLD_STILL = {
        plan = { state = "hide_na", body = "crouch", mvt = "stand", target = "hold" },
        applies = _always_applies,
    },
}


-- =========================================================================
-- Allowed-behavior lists per NPC class. Module-level constants; _allowed_for
-- returns the reference (no per-tick allocation). Order in each list is the
-- priority: earlier rows checked first.
-- =========================================================================

-- Per-faction behavior lists. Each list is the priority order the decide loop
-- walks; first behavior with applies(ctx)==true fires. HP/weapon gating lives
-- in each behavior's applies, not in list selection — list selection is pure
-- community lookup.
--
-- HP-driven behaviors (RETREAT, RETREAT_AND_FIRE, FLEE) are first in each list
-- that includes them. RETREAT_AND_FIRE has a 50/50 id-hash gate so squads split
-- (half pull back firing, half fall through to RETREAT/FLEE or combat).
local LIST_MILITARY         = { "RETREAT_AND_FIRE", "SNIPE", "FLANKING", "FIRE_FROM_COVER", "TAKE_COVER", "FIRE_HOLD", "ADVANCE" }
local LIST_FANATIC          = { "CLOSE_ASSAULT", "SNIPE", "FLANKING", "FIRE_FROM_COVER", "TAKE_COVER", "FIRE_HOLD", "ADVANCE" }
local LIST_MERC             = { "RETREAT_AND_FIRE", "RETREAT", "SNIPE", "FLANKING", "FIRE_FROM_COVER", "TAKE_COVER", "FIRE_HOLD", "ADVANCE" }
local LIST_DISORGANIZED     = { "RETREAT_AND_FIRE", "RETREAT", "CLOSE_ASSAULT", "ADVANCE", "FIRE_FROM_COVER", "FIRE_HOLD" }
local LIST_COWARD           = { "RETREAT_AND_FIRE", "FLEE", "FIRE_FROM_COVER", "TAKE_COVER", "FIRE_HOLD", "HOLD_STILL" }
local LIST_TACTICAL_DEFAULT = { "RETREAT_AND_FIRE", "RETREAT", "SNIPE", "ADVANCE", "TAKE_COVER", "FIRE_FROM_COVER", "FIRE_HOLD" }
local LIST_ZOMBIE           = { "ZOMBIE_SHAMBLE" }

-- Community → list. Unknown communities fall through to LIST_TACTICAL_DEFAULT.
-- Community strings are engine-authoritative (game_relations.ltx:26).
local FACTION_LIST = {
    army       = LIST_MILITARY,
    army_npc   = LIST_MILITARY,
    dolg       = LIST_MILITARY,
    freedom    = LIST_MILITARY,
    isg        = LIST_MILITARY,
    monolith   = LIST_FANATIC,
    greh       = LIST_FANATIC,
    greh_npc   = LIST_FANATIC,
    killer     = LIST_MERC,
    bandit     = LIST_DISORGANIZED,
    renegade   = LIST_DISORGANIZED,
    ecolog     = LIST_COWARD,
    csky       = LIST_COWARD,
    zombied    = LIST_ZOMBIE,
}

local function _allowed_for(ctx)
    return FACTION_LIST[ctx.community] or LIST_TACTICAL_DEFAULT
end


-- =========================================================================
-- Gather: collect all factors into ctx once per tick.
-- =========================================================================

local function _gather_inputs(npc, id, tg)
    local ctx = {}
    ctx.npc_pos  = npc:position()
    ctx.npc_lvid = npc:level_vertex_id()
    ctx.hp_frac  = npc.health
    local enemy = npc:best_enemy()
    if enemy and enemy:alive() then
        ctx.enemy   = enemy
        ctx.ene_pos = enemy:position()
        ctx.see     = npc:see(enemy)
        ctx.see_me  = enemy:see(npc)
        local dx = ctx.ene_pos.x - ctx.npc_pos.x
        local dz = ctx.ene_pos.z - ctx.npc_pos.z
        ctx.dx    = dx
        ctx.dz    = dz
        ctx.dist  = math_sqrt(dx*dx + dz*dz)
        local dir = vector():set(dx, 0, dz)
        ctx.has_high_cover = level.high_cover_in_direction(ctx.npc_lvid, dir) >= 0.2
    end
    ctx.weapon_kind = _get_weapon_kind(npc, id, tg)
    ctx.community   = _get_community(npc, id)
    ctx.bucket      = id % SQUAD_LATERAL_BUCKETS
    ctx.id          = id
    return ctx
end


-- =========================================================================
-- Decide: pick the first behavior in the allowed list whose applies(ctx)
-- is true. Returns the behavior name string, or nil to signal handoff.
-- =========================================================================

local function _decide_behavior(ctx)
    if not ctx.enemy then return nil end
    if ctx.dist < cfg.min_dist then return nil end
    local list = _allowed_for(ctx)
    for i = 1, #list do
        local behavior = BEHAVIORS[list[i]]
        if behavior and behavior.applies(ctx) then return list[i] end
    end
    return nil
end

-- HP-driven behaviors that bypass the behavior_hold commit gate. All three
-- interrupt in-flight commitment when HP drops below retreat_hp. nil (handoff)
-- is also a bypass case, handled by the action-side _should_hold check.
local BYPASSES_HOLD = { RETREAT = true, RETREAT_AND_FIRE = true, FLEE = true }


-- =========================================================================
-- Evaluator
-- =========================================================================

class "evaluator_at_combat" ( property_evaluator )

function evaluator_at_combat:__init(name) super (nil, name)
end

local function _decide_eval(npc, id)
    if not cfg.combat_enabled then return false, "disabled" end
    if (id % 1000) >= (cfg.combat_share * 1000) then return false, "hash_out" end
    if not npc:alive() then return false, "dead" end
    if IsWounded(npc) then return false, "wounded" end
    local until_ms = _fail_until[id]
    if until_ms and time_global() < until_ms then return false, "fail_backoff" end
    local be = npc:best_enemy()
    if not (be and be:alive()) then return false, "no_enemy" end
    local d2 = npc:position():distance_to_sqr(be:position())
    local floor_m = (_last_eval[id] == true)
        and math_max(cfg.min_dist - EVAL_HYSTERESIS_M, 1)
        or cfg.min_dist
    if d2 < (floor_m * floor_m) then return false, "too_close" end
    return true, "in_range"
end

local function _log_eval_transition(id, result, reason, ms)
    local prev = _last_eval_logged[id]
    if prev == result then return end
    _last_eval_logged[id] = result
    log.debug("[COMBAT] eval npc=%d %s->%s reason=%s [%.3fms]",
        id,
        prev == nil and "init" or tostring(prev),
        tostring(result),
        reason,
        ms)
end

function evaluator_at_combat:evaluate()
    local tmr = xprofiler.new_if(_dbg):start()
    local npc = self.object
    local id = npc:id()
    local result, reason = _decide_eval(npc, id)
    _last_eval[id]   = result
    _last_reason[id] = reason
    tmr:stop()
    if _dbg then _log_eval_transition(id, result, reason, tmr:get_ms()) end
    return result
end


-- =========================================================================
-- Action
-- =========================================================================

class "action_at_combat" ( action_base )

function action_at_combat:__init(name) super (nil, name)
end

-- Streak persists past threshold; each fail past threshold extends the backoff
-- linearly (3 fails = 10s, 4 = 20s, 5 = 30s, ...). Stuck NPCs settle into long
-- backoffs and stay in vanilla. Streak resets on successful pick at the
-- _repick site (`_fail_streak[id] = 0`).
local function _on_pick_fail(id)
    local streak = (_fail_streak[id] or 0) + 1
    _fail_streak[id] = streak
    if streak >= FAIL_THRESHOLD then
        _fail_until[id] = time_global() + FAIL_BACKOFF_MS * (streak - FAIL_THRESHOLD + 1)
    end
    return streak
end

function action_at_combat:_apply_state(plan, ctx)
    local npc = self.object
    if plan.state ~= self.last_state then
        if _dbg then
            log.debug("[COMBAT] state npc=%d %s->%s",
                npc:id(), tostring(self.last_state), tostring(plan.state))
        end
        state_mgr.set_state(npc, plan.state, nil, nil,
            { look_object = ctx.enemy }, { fast_set = true })
        self.last_state = plan.state
    end
    if plan.body ~= self.last_body then
        if _dbg then
            log.debug("[COMBAT] body npc=%d %s->%s",
                npc:id(), tostring(self.last_body), tostring(plan.body))
        end
        npc:set_body_state(move[plan.body])
        self.last_body = plan.body
    end
    if plan.mvt ~= self.last_mvt then
        if _dbg then
            log.debug("[COMBAT] mvt npc=%d %s->%s",
                npc:id(), tostring(self.last_mvt), tostring(plan.mvt))
        end
        npc:set_movement_type(move[plan.mvt])
        self.last_mvt = plan.mvt
    end
    -- Engine sniper aim mode (ai_stalker_fire.cpp:193, 225, 239). When true,
    -- aim direction tracks m_head.target instead of weapon LastFD. Only SNIPE
    -- behavior plan sets sniper_aim=true; flipping back to false on exit so
    -- the NPC doesn't stay in sniper aim when vanilla planner resumes.
    local want_sniper = plan.sniper_aim == true
    if want_sniper ~= self.last_sniper_mode then
        npc:sniper_fire_mode(want_sniper)
        if _dbg then
            log.debug("[COMBAT] sniper_aim npc=%d %s->%s",
                npc:id(), tostring(self.last_sniper_mode), tostring(want_sniper))
        end
        self.last_sniper_mode = want_sniper
    end
end

function action_at_combat:_repick(plan, ctx)
    local tmr = xprofiler.new_if(_dbg):start()
    local npc = self.object
    local id = npc:id()
    local resolver = TARGET_RESOLVERS[plan.target]
    if not resolver then
        tmr:stop()
        return tmr:get_ms()
    end
    local new_lvid = resolver(npc, ctx, self)
    if not new_lvid then
        local streak = _on_pick_fail(id)
        tmr:stop()
        if _dbg then
            log.debug("[COMBAT] pick_fail npc=%d kind=%s bucket=%d streak=%d [%.3fms]",
                id, plan.target, ctx.bucket or -1, streak, tmr:get_ms())
        end
        return tmr:get_ms()
    end
    _fail_streak[id] = 0
    if new_lvid == self.target_lvid then
        self._next_pick = time_global() + math_random(KEEP_POINT_MIN, KEEP_POINT_MAX)
        tmr:stop()
        return tmr:get_ms()
    end
    -- charge_enemy targets the enemy's vertex; multiple aggressors converging
    -- on the same enemy is the intended behavior, so skip the reservation.
    local skip_reservation = (plan.target == "charge_enemy")
    if not skip_reservation and not _claim_cover(new_lvid, id) then
        -- Throttle next attempt; otherwise reserve_fail logs spam every tick.
        self._next_pick = time_global() + math_random(KEEP_POINT_MIN, KEEP_POINT_MAX)
        tmr:stop()
        if _dbg then
            log.debug("[COMBAT] reserve_fail npc=%d lvid=%d bucket=%d owner=%s [%.3fms]",
                id, new_lvid, ctx.bucket or -1,
                tostring(db.used_level_vertex_ids[new_lvid]), tmr:get_ms())
        end
        return tmr:get_ms()
    end
    _release_cover(self.target_lvid, id)
    self.target_lvid = new_lvid
    npc:set_dest_level_vertex_id(new_lvid)
    self._next_pick = time_global() + math_random(KEEP_POINT_MIN, KEEP_POINT_MAX)
    tmr:stop()
    if _dbg then
        log.debug("[COMBAT] pick npc=%d kind=%s lvid=%d dist=%.1fm bucket=%d [%.3fms]",
            id, plan.target, new_lvid, ctx.dist or 0, ctx.bucket or -1, tmr:get_ms())
    end
    return tmr:get_ms()
end

function action_at_combat:initialize()
    local tmr = xprofiler.new_if(_dbg):start()
    action_base.initialize(self)
    local npc = self.object
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    self.current_behavior     = nil
    self.target_lvid          = nil
    self._next_pick           = 0
    self._behavior_hold_until = 0
    self._behavior_entered_at = 0
    self._next_tick_log       = 0
    self.last_state           = nil
    self.last_body            = nil
    self.last_mvt             = nil
    self.last_sniper_mode     = false
    tmr:stop()
    if _dbg then log.debug("[COMBAT] action_init npc=%d [%.3fms]", npc:id(), tmr:get_ms()) end
end

function action_at_combat:_log_tick(npc, behavior, interesting, tg, phase_ms)
    if not _dbg then return end
    if not (interesting or tg > (self._next_tick_log or 0)) then return end
    log.debug("[COMBAT] tick npc=%d behavior=%s [gather=%.3fms decide=%.3fms apply=%.3fms pick=%.3fms fire=%.3fms total=%.3fms]",
        npc:id(),
        behavior or "?",
        phase_ms.gather,
        phase_ms.decide,
        phase_ms.apply,
        phase_ms.pick,
        phase_ms.fire,
        phase_ms.total)
    self._next_tick_log = tg + 2000
end

-- True when we should suppress the new decision and keep the current behavior.
-- nil (handoff) and RETREAT (HP emergency) bypass the commit gate.
function action_at_combat:_should_hold(new_behavior, tg)
    if new_behavior == nil then return false end
    if BYPASSES_HOLD[new_behavior] then return false end
    if self.current_behavior == nil then return false end
    return tg < self._behavior_hold_until
end

function action_at_combat:_log_behavior_change(npc, prev, next_, dist, held_ms)
    if not _dbg then return end
    log.debug("[COMBAT] behavior npc=%d %s->%s dist=%.1fm held=%dms",
        npc:id(),
        prev or "init",
        next_ or "none",
        dist or 0,
        held_ms or 0)
end

function action_at_combat:execute()
    local exec_tmr = xprofiler.new_if(_dbg):start()
    action_base.execute(self)
    local npc = self.object
    local id  = npc:id()
    local tg  = time_global()

    local gather_tmr = xprofiler.new_if(_dbg):start()
    local ctx = _gather_inputs(npc, id, tg)
    gather_tmr:stop()

    if not ctx.enemy then
        exec_tmr:stop()
        return
    end

    local decide_tmr = xprofiler.new_if(_dbg):start()
    local new_behavior = _decide_behavior(ctx)
    decide_tmr:stop()

    -- Behavior hold: after a behavior change, commit for 1.5-3.5s before the
    -- decide tree can flip again. Sub-second oscillation observed when an NPC
    -- moved across adjacent vertices whose high_cover_in_direction value
    -- straddled 0.20. RETREAT and nil (handoff) bypass via _should_hold.
    if self:_should_hold(new_behavior, tg) then
        new_behavior = self.current_behavior
    end

    local behavior_changed = (new_behavior ~= self.current_behavior)
    if behavior_changed then
        -- held_ms = 0 on the first entry (no previous behavior to measure).
        -- Otherwise = time since the previous behavior was entered.
        local held_ms = self.current_behavior and (tg - self._behavior_entered_at) or 0
        self:_log_behavior_change(npc, self.current_behavior, new_behavior, ctx.dist, held_ms)
        self.current_behavior = new_behavior
        self._behavior_hold_until = tg + math_random(BEHAVIOR_HOLD_MIN, BEHAVIOR_HOLD_MAX)
        self._behavior_entered_at = tg
    end

    if not new_behavior then
        exec_tmr:stop()
        return
    end

    local behavior = BEHAVIORS[new_behavior]
    if not behavior then
        exec_tmr:stop()
        return
    end

    local plan = behavior.plan

    local apply_tmr = xprofiler.new_if(_dbg):start()
    local state_was = self.last_state
    self:_apply_state(plan, ctx)
    apply_tmr:stop()
    local state_changed = (state_was ~= self.last_state)

    local target_was = self.target_lvid
    local pick_ms = 0
    if tg > self._next_pick or _reservation_stolen(self.target_lvid, id) then
        pick_ms = self:_repick(plan, ctx) or 0
    end
    local pick_happened = (target_was ~= self.target_lvid)

    local fire_tmr = xprofiler.new_if(_dbg):start()
    local ene_pos = ctx.ene_pos
    npc:set_sight(look.fire_point,
        vector():set(ene_pos.x, ene_pos.y + 1.5, ene_pos.z))
    fire_tmr:stop()

    exec_tmr:stop()
    if _dbg then
        self:_log_tick(npc, new_behavior, behavior_changed or state_changed or pick_happened, tg, {
            gather = gather_tmr:get_ms(),
            decide = decide_tmr:get_ms(),
            apply  = apply_tmr:get_ms(),
            pick   = pick_ms,
            fire   = fire_tmr:get_ms(),
            total  = exec_tmr:get_ms(),
        })
    end
end

function action_at_combat:finalize()
    local tmr = xprofiler.new_if(_dbg):start()
    action_base.finalize(self)
    local npc = self.object
    local id = npc:id()
    _release_cover(self.target_lvid, id)
    self.target_lvid = nil
    -- Clear the engine sniper aim flag so vanilla planner resumes cleanly.
    if self.last_sniper_mode then
        npc:sniper_fire_mode(false)
        if _dbg then
            log.debug("[COMBAT] sniper_aim npc=%d true->false (finalize)", id)
        end
        self.last_sniper_mode = false
    end
    tmr:stop()
    if _dbg then
        log.debug("[COMBAT] action_fin npc=%d eval_reason=%s [%.3fms]",
            id, _last_reason[id] or "?", tmr:get_ms())
    end
end


-- =========================================================================
-- Lifecycle: install, unregister, MCM refresh
-- =========================================================================

local function _install(npc)
    local tmr = xprofiler.new_if(_dbg):start()
    if not npc then return end
    if not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    _community[id] = character_community(npc) or ""

    local manager = npc:motivation_action_manager()
    if not manager then return end

    manager:add_evaluator(EVAL_ID, evaluator_at_combat("eva_at_combat"))

    local action = action_at_combat("act_at_combat")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(EVAL_ID, true))
    action:add_effect(world_property(EVAL_ID, false))
    manager:add_action(ACT_ID, action)

    local blocked = {
        stalker_ids.action_combat_planner,
        stalker_ids.action_danger_planner,
        xr_danger.actid,
        xr_actions_id.state_mgr + 2,
        xr_actions_id.alife,
    }
    for i = 1, #blocked do
        local act = manager:action(blocked[i])
        if act then act:add_precondition(world_property(EVAL_ID, false)) end
    end

    tmr:stop()
    if _dbg then
        log.debug("[COMBAT] install npc=%d community=%s [%.3fms]",
            id, _community[id], tmr:get_ms())
    end
end

local function _on_net_spawn(npc)
    _install(npc)
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _installed[id]        = nil
    _last_eval[id]        = nil
    _last_eval_logged[id] = nil
    _last_reason[id]      = nil
    _fail_until[id]       = nil
    _fail_streak[id]      = nil
    _community[id]        = nil
    _weapon_kind[id]      = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    if _dbg then
        log.debug("[COMBAT] config enabled=%s share=%.2f min_dist=%dm advance_dist=%dm retreat_hp=%.2f",
            cfg.combat_enabled and "true" or "false",
            cfg.combat_share or 0.5,
            cfg.min_dist or 8,
            cfg.advance_dist or 40,
            cfg.retreat_hp or 0.30)
    end
end

local function _on_first_update()
    _installed        = {}
    _last_eval        = {}
    _last_eval_logged = {}
    _last_reason      = {}
    _fail_until       = {}
    _fail_streak      = {}
    _community        = {}
    _weapon_kind      = {}
    _refresh_log()
    log.info("Combat module initialized (enabled=%s share=%.2f min_dist=%dm dbg=%s)",
        cfg.combat_enabled and "true" or "false",
        cfg.combat_share or 0.5,
        cfg.min_dist or 8,
        _dbg and "true" or "false")
end

function on_game_start()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

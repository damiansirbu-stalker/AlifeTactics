--- at_combat: the v2 intermittent takeover - the monitor (shell). Vanilla owns every NPC by default; AT
--- watches a fight and decides the one moment to seize for a single committed maneuver where vanilla is weak.
--- This file is the always-on monitor plus the transaction it drives: per installed stalker it reads the fight
--- state and, while fighting the actor, fires the trigger table; a fired trigger picks a catalog maneuver (from
--- at_combat_doctrine) and BEGINs it. The GOAP graft lives in xcombat (install_takeover); AT supplies the spec
--- (gate + on_begin) and runs the committed maneuver to its end (arrival or cap), then COMMITs - the whole
--- transaction is legible in the log (begin -> commit).
---
--- INVERSION OF CONTROL: the monitor runs under npc_on_update - the engine pumps it; it never loops itself.
--- One decision point lives here (the monitor); the per-NPC state is one flat record (_state(id)); the
--- decision half (fight detection helpers, trigger predicates) is at_combat_doctrine; tracing is noop when off.

local IsStalker, time_global, tostring = IsStalker, time_global, tostring
local math_floor, RegisterScriptCallback = math.floor, RegisterScriptCallback

local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine
local trace = at_combat_trace
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"
local MONITOR_MS, WATCH_MS, HIT_FIGHT_MS, RESEIZE_COOLDOWN_MS, DISENGAGE_HOLD_MS

local COMPANION_INFO = "npcx_is_companion"


-- =========================================================================
-- Per-NPC state store. One flat record per installed NPC, created on first touch: the monitor throttle clock,
-- the fight/trigger readings (for the trace), the stall tracker, and (later) the open transaction. Never saved.
-- =========================================================================

local _installed = {}
local _states    = {}

local function _state(id)
    local state = _states[id]
    if not state then state = { id = id } _states[id] = state end
    return state
end


-- =========================================================================
-- Fight detection and the two seize gates. Each is one named predicate - no inline conditions in the monitor.
-- =========================================================================

-- In a fight = the engine selected an enemy, OR a hit landed recently (the far-shooter case, where the enemy is
-- out of the distance gate so best_enemy is still nil but the NPC is plainly under fire).
local function _is_fighting(npc, state, tg)
    if npc:best_enemy() ~= nil then return true end
    return state.hit_at ~= nil and (tg - state.hit_at) < HIT_FIGHT_MS
end

-- Eligibility: does AT manage this NPC at all. Enabled, inside the share, not a companion. Changes rarely.
local function _manages(npc)
    if not cfg.combat_enabled then return false end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return false end
    return true
end

-- Seizability: can AT take this NPC right now. Armed (an unarmed NPC under AT would deadlock - the engine's
-- own rearm lives in the blocked combat planner), and not already in a smart cover (vanilla owns that micro).
local function _can_seize(npc)
    if not xcombat.get_weapon_kind(npc) then return false end
    if npc:in_smart_cover() then return false end
    return true
end

-- Scope gate: the takeover runs only against the actor. NPC-vs-NPC is out (the actor is always online, has a
-- stable id, never despawns mid-fight, exposes facing/health). One predicate; every maneuver and read downstream
-- takes a generic enemy, so widening to NPC-vs-NPC later is this line alone. No readme / MCM surface.
local function _target_eligible(enemy)
    return enemy:id() == AC_ID
end


-- =========================================================================
-- The transaction. BEGIN (the monitor) raises the gate and records the chosen maneuver + its resolved
-- destination; the graft issues it ONCE via SPEC.on_begin when AT takes control, then the engine state machine
-- carries it - AT runs no per-frame code. The monitor watches the end on its throttled tick (arrival for movers,
-- the time cap for holds) and COMMITs, lowering the gate to hand back. The maneuver catalog (handles, palette,
-- resolver, fire spec) lives in at_combat_doctrine; the shell is maneuver-agnostic.
-- =========================================================================

-- BEGIN: raise the gate, record the maneuver (a catalog row) and its cached destination. The body issues it on
-- its next execute, under AT control - issuing movement now would fight vanilla, which still drives this frame.
local function _begin(state, maneuver, dest, trigger, tg)
    state.gate = true
    state.maneuver = maneuver
    state.dest = dest
    state.maneuver_at = nil
    state.begin_at = tg
    if _dbg then trace.begin(state.id, maneuver.name, trigger) end
end

-- COMMIT: lower the gate, clear the maneuver and its destination. Vanilla resumes from where AT left the NPC.
-- commit_at is stamped (and NOT cleared) so _decide can enforce the reseize cooldown: without it a pressing enemy
-- re-fires the same trigger on the next decide tick and the intermittent takeover degenerates into a continuous one.
local function _commit(state, tg, reason)
    if _dbg then trace.commit(state.id, state.maneuver and state.maneuver.name, reason, math_floor(tg - (state.begin_at or tg))) end
    -- flee opens a disengage window: after hand-back, the on_enemy_eval subscriber forces is_enemy(actor)=false for
    -- this NPC for DISENGAGE_HOLD_MS, so the rout continues instead of the NPC re-acquiring the actor and turning to
    -- fight the instant vanilla resumes. Only flee disengages; every other maneuver hands back to normal combat.
    if state.maneuver and state.maneuver.name == "flee" and DISENGAGE_HOLD_MS > 0 then
        state.disengage_until = tg + DISENGAGE_HOLD_MS
    end
    state.gate = false
    state.maneuver = nil
    state.dest = nil
    state.maneuver_at = nil
    state.begin_at = nil
    state.commit_at = tg
    -- Release any cover a cover maneuver reserved at resolve, on EVERY exit (arrived, cap, never-started) so a gate
    -- that raised but never ran a maneuver does not leak the reservation in db.used_level_vertex_ids (t136).
    if state.cover_lvid then
        xcombat.release_cover(state.cover_lvid, state.id)
        state.cover_lvid = nil
    end
end

-- Issue the maneuver: send the NPC to its cached destination and set the maneuver's fire/posture/movement with
-- the enemy as look_object, so the engine state machine carries the walk+fire (the binder pumps state_mgr every
-- frame). The single place AT writes the engine; AT then runs nothing per frame. Arrival and the cap are watched.
local function _issue(npc, state, tg)
    local maneuver = state.maneuver
    local enemy = npc:best_enemy()
    if not enemy then _commit(state, tg, "no_enemy") return end
    -- The enemy can change between _decide (where scope is checked) and here (the action's initialize), and the
    -- grafted action can re-initialize mid-transaction; re-check scope so a maneuver never issues against a
    -- non-eligible (NPC) enemy that slipped into best_enemy in the window.
    if not _target_eligible(enemy) then _commit(state, tg, "not_eligible") return end
    xcombat.send_to(npc, state.dest)
    -- Fire discipline at the decision point (t134): a firing maneuver drops to READY (weapon up, no trigger) when
    -- the engine gate says a shot makes no sense - occluded, point-blank, floor gap, or no LOS. Consulted ONCE here,
    -- never per shot; the maneuver holds seconds and vanilla's own gate runs the rest of the time.
    local fire = maneuver.fire
    if (fire == xcombat.FIRE or fire == xcombat.SNIPE) and not xcombat.fire_make_sense(npc, enemy) then
        fire = xcombat.READY
    end
    xcombat.set_combat(npc, { fire = fire, posture = maneuver.posture, movement = maneuver.movement, aim = enemy })
    state.maneuver_at = tg
end

-- on_begin: the graft calls this ONCE when AT takes the NPC (the action's initialize). Issue the maneuver under
-- AT control. The engine state machine then carries it; AT runs nothing per frame. Arrival and the stuck cap are
-- watched by the monitor on its throttled tick.
local function _on_begin(npc)
    local state = _states[npc:id()]
    if not state or not state.maneuver then return end
    _issue(npc, state, time_global())
end

-- One spec drives every AT NPC: gate = the per-NPC transaction flag the grafted evaluator polls; on_begin = the
-- one-time maneuver start the grafted action calls. Per-NPC state lives in _states, keyed by id.
local SPEC = {
    gate = function(npc) local state = _states[npc:id()] return state ~= nil and state.gate == true end,
    on_begin = _on_begin,
}


-- =========================================================================
-- THE MONITOR. npc_on_update fires every frame per online stalker; _on_update self-throttles (MONITOR_MS while
-- deciding, WATCH_MS while a maneuver runs) and dispatches: gate up -> _watch the running maneuver for its end;
-- gate down -> _decide whether to take over. Each is one helper so the dispatch stays flat.
-- =========================================================================

-- Gate up: commit when the maneuver finished. Movers (ends_on=arrival) end on is_arrived; the per-maneuver
-- timeout (measured from begin_at, the gate-raise time) ends everything - including a gate that never started a
-- maneuver (a precondition blocked the action), so a raised gate can never wedge the NPC. Holds (ends_on=time)
-- carry no arrival condition (their dest is the NPC's own node, trivially arrived) and end only on the timeout.
local function _watch(npc, state, tg)
    local maneuver = state.maneuver
    if maneuver and maneuver.ends_on == "arrival" and state.maneuver_at and xcombat.is_arrived(npc) then
        _commit(state, tg, "arrived")
    elseif (tg - (state.begin_at or tg)) >= ((maneuver and maneuver.timeout) or 8000) then
        _commit(state, tg, "cap")
    end
end

-- Debug-only per-tick decision trace, gated here so the bridge reads (name, operator, facing, sight) never run
-- when tracing is off.
local function _trace_decision(npc, state, enemy, fired)
    if not _dbg then return end
    state.enemy_name = xcreature.get_name(enemy:id())
    state.operator   = xcombat.get_operator(npc)
    state.aim_off    = math_floor(xcombat.get_facing_offset(npc, enemy:position()))
    state.seen       = npc:see(enemy)
    trace.monitor(state.id, state, fired or "none")
end

-- Gate down: decide whether to take the NPC over. Eligible, fighting, an enemy selected and it IS the actor,
-- seizable, then the trigger table; a fired trigger picks a catalog maneuver (with its resolved destination) and
-- BEGINs it. The not-actor skip is silent (NPC-vs-NPC is the common case, uninteresting). Other skip reasons are
-- traced (trace noops when off).
local function _decide(npc, id, state, tg)
    if not _manages(npc) then state.fighting = false return end
    state.fighting = _is_fighting(npc, state, tg)
    if not state.fighting then state.stall_set = false return end
    if _dbg then trace.set_name(id, npc:name()) end

    local enemy = npc:best_enemy()
    if not enemy then
        state.enemy_id = nil
        trace.monitor(id, state, "no_enemy")
        return
    end
    state.enemy_id = enemy:id()

    if not _target_eligible(enemy) then return end

    -- Reseize cooldown: hold off a fresh takeover for a window after the last COMMIT. A committed maneuver leaves
    -- the NPC near the enemy (a kite ends ~kite_back_m away), so without this the same trigger re-fires on the next
    -- decide tick and the intermittent model collapses into a continuous takeover. 0 = off.
    if RESEIZE_COOLDOWN_MS > 0 and state.commit_at and (tg - state.commit_at) < RESEIZE_COOLDOWN_MS then
        trace.monitor(id, state, "cooldown")
        return
    end

    if not _can_seize(npc) then
        trace.monitor(id, state, "cannot_seize")
        return
    end

    local fired = doctrine.eval_triggers(npc, enemy, state, tg)
    if fired then
        local maneuver, dest = doctrine.pick_maneuver(npc, fired, enemy, state)
        if maneuver then _begin(state, maneuver, dest, fired, tg) end
    end
    _trace_decision(npc, state, enemy, fired)
end

local function _on_update(npc)
    local id = npc:id()
    if not _installed[id] then return end
    local state = _state(id)
    local tg = time_global()
    local due = state.gate and WATCH_MS or MONITOR_MS
    if tg - (state.mon_at or 0) < due then return end
    state.mon_at = tg
    if state.gate then _watch(npc, state, tg)
    else _decide(npc, id, state, tg) end
end


-- =========================================================================
-- Public API consumed by at_hud (the running-maneuver readout) and the at_test observer. Returns nil until the
-- body that drives a maneuver lands.
-- =========================================================================

--- Current maneuver name for an NPC, or nil when AT is not driving one.
function get_maneuver(id)
    local state = _states[id]
    return state and state.maneuver and state.maneuver.name
end


-- =========================================================================
-- Lifecycle: install on spawn, stamp the far-shooter fight entry on hit, clean up on destroy / unregister.
-- =========================================================================

local function _install(npc)
    if not npc or not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    xcombat.install_takeover(npc, SPEC)
    if _dbg then trace.installed(id, npc:name()) end
end

-- A hit stamps the fight clock so the far-shooter case (best_enemy still nil) reads as fighting in the monitor.
local function _on_hit(npc, amount)
    if not npc or not amount or amount <= 0 then return end
    local id = npc:id()
    if _installed[id] then _state(id).hit_at = time_global() end
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    xcombat.release_takeover(npc)
    _installed[id] = nil
    _states[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _installed[id] = nil
    _states[id] = nil
    if _dbg then trace.forget(id) end
end

-- The single AT owner of the on_enemy_eval seam (xr_combat_ignore.script:85, fires before every distance gate).
-- While a flee's disengage window is open, force is_enemy(actor)=false for this NPC so vanilla stops selecting the
-- actor as its enemy and the rout continues past hand-back. Scoped to the actor (the fled enemy) so the NPC still
-- reacts to any other threat; the window clears lazily on expiry. The t92 sniper force-enable (result=true) is the
-- other branch that will live here, keeping one subscriber on the seam.
local function _on_enemy_eval(obj, enemy, flags)
    if not obj or not enemy then return end
    local state = _states[obj:id()]
    if not (state and state.disengage_until) then return end
    if time_global() >= state.disengage_until then state.disengage_until = nil return end
    if enemy:id() ~= AC_ID then return end
    flags.override = true
    flags.result = false
end

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    MONITOR_MS          = read_int("monitor_period_ms",   500)
    WATCH_MS            = read_int("watch_period_ms",     200)
    HIT_FIGHT_MS        = read_int("hit_fight_ms",        5000)
    RESEIZE_COOLDOWN_MS = read_int("reseize_cooldown_ms", 5000)
    DISENGAGE_HOLD_MS   = read_int("disengage_hold_ms",   5000)
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    trace.set_enabled(_dbg)
end

local function _on_first_update()
    trace.reset()
    _refresh_log()
    log.info("Combat monitor initialized (enabled=%s dbg=%s)",
        tostring(cfg.combat_enabled), tostring(_dbg))
end

function on_game_start()
    _load_config()
    doctrine.load_config()
    RegisterScriptCallback("npc_on_net_spawn",            _install)
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_on_update",               _on_update)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("on_enemy_eval",               _on_enemy_eval)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

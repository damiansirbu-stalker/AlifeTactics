--- at_combat: the intermittent takeover monitor - seizes one NPC for one committed maneuver the actor is
--- party to, then hands back. Doctrine in at_combat_doctrine, graft in xcombat. The monitor is one
--- scheduled pass (_run_monitor, a vanilla time event every MONITOR_PERIOD_SEC) over _npc_states - AT
--- runs zero code on any per-frame path.

local IsStalker, time_global, tostring, pairs = IsStalker, time_global, tostring, pairs
local math_floor, RegisterScriptCallback, AC_ID = math.floor, RegisterScriptCallback, AC_ID
local string_match, tonumber = string.match, tonumber

local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine
local trace = at_combat_trace
local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"
local BEGIN_PERIOD_MS, UPDATE_PERIOD_MS, END_PERIOD_MS, HIT_FIGHT_MS

-- The monitor pass period. update/end checks run on the pass directly (200ms); the begin period is a
-- multiple of it (600ms = every 3rd pass), so every check fires at its exact configured cadence.
local MONITOR_PERIOD_SEC = 0.2

local COMPANION_INFO = "npcx_is_companion"
local MANEUVER_CAP_MS = 8000
local MAX_CONCURRENT


-- Per-NPC state store: one flat record per tracked NPC, created by _install on spawn, dropped on
-- net_destroy / entity unregister. Existence of a record IS "AT tracks this NPC". Never saved.

local _npc_states = {}
-- ONLINE NPCs currently holding a maneuver. MAX_CONCURRENT caps how many run at once (a runaway
-- failsafe). _drop_gate keeps it honest on every gate-clearing path (end AND despawn), so a dead NPC
-- can never leak a slot.
local _open_count = 0

-- Scheme fire discipline: while a maneuver drives an NPC, the state machinery asks
-- state_mgr_weapon.get_queue_params for the burst, and every state without an animation-specific
-- entry falls to the caller's generic {5,300,0} override - full-auto on a pistol, a burst on a
-- sniper rifle (state_mgr.script:322). For maneuver-held NPCs we swap that fallback override for a
-- per-weapon-kind triple {queue size, interval ms, aim time}; the animation-tuned entries
-- (state_mgr_weapon state_queue_params) keep their priority, the original's aim_time machinery
-- stays intact, and NPCs we are not driving pass through byte-identical. Triples fill at
-- _load_config from xcombat.get_fire_queue medium-band midpoints; queue_w_* LTX keys override.
local QUEUE_KINDS = { "w_pistol", "w_shotgun", "w_rifle", "w_smg", "w_sniper" }
local _queue_by_kind = {}

local _orig_get_queue_params
-- The kind read adds no crash surface over the original: vanilla get_queue_params makes the
-- same class of member calls (best_weapon, aim_time) on the same NPC at this seam.
local function _patched_get_queue_params(npc, st, override)
    local state = npc and _npc_states[npc:id()]
    if state and state.maneuver then
        local tmr = xprofiler.new_if(_dbg):start()
        local kind = xcombat.get_weapon_kind(npc)
        local triple = kind and _queue_by_kind[kind]
        tmr:stop()
        if triple then override = triple end
        if _dbg then
            log.debug("[QUE] id=%d kind=%s size=%s interval=%s [%.3fms]",
                npc:id(), tostring(kind),
                triple and tostring(triple[1]) or "vanilla",
                triple and tostring(triple[2]) or "vanilla", tmr:get_ms())
        end
    end
    return _orig_get_queue_params(npc, st, override)
end


-- Fight detection and the seize gates: one named predicate each.

-- In a fight = the engine selected an enemy, OR a hit landed recently (the far-shooter case, where the enemy is
-- out of the distance gate so best_enemy is still nil but the NPC is plainly under fire). Takes the enemy the
-- caller already read (one best_enemy luabind per begin check, not two).
local function _is_fighting(enemy, state, tg)
    if enemy ~= nil then return true end
    return state.hit_at ~= nil and (tg - state.hit_at) < HIT_FIGHT_MS
end

-- Eligibility: does AT manage this NPC at all. Enabled, inside the share, not a companion. Changes rarely.
local function _manages(npc)
    if not cfg.combat_enabled then return false end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return false end
    return true
end

-- Seizability: armed and not already in a smart cover (vanilla owns that micro). No indoor gate - the
-- takeover fights everywhere; xcombat.is_indoor (a proper roof+walls raycast) stays available if a future
-- maneuver ever needs it, but the takeover does not.
local function _can_seize(npc)
    if not xcombat.get_weapon_kind(npc) then return false, "no_weapon" end
    if npc:in_smart_cover() then return false, "smart_cover" end
    return true
end


-- The maneuver lifecycle: _try_begin_maneuver stages a row and raises the gate; the engine grants control at the
-- grafted action's initialize and calls _begin_maneuver (the first engine write); _update_maneuver re-runs the
-- row's update while it runs; _try_end_maneuver calls _end_maneuver on arrival or the cap.

-- Release the reserved cover vertex. Every state-dropping path calls this (_end_maneuver AND the
-- death/despawn handlers): nothing else ever cleans a dead NPC's claim in db.used_level_vertex_ids.
local function _release_cover(state)
    if state and state.cover_lvid then
        xcombat.release_cover(state.cover_lvid, state.id)
        state.cover_lvid = nil
    end
end

-- Lower the gate and keep the concurrent count honest. EVERY path that clears an open gate routes here
-- (_end_maneuver AND the death/despawn handlers), so _open_count can never leak a slot to a dead NPC.
local function _drop_gate(state)
    if state and state.gate then
        _open_count = _open_count - 1
        if _open_count < 0 then _open_count = 0 end
        state.gate = false
    end
end

-- Debug-only lethality evidence per maneuver window: shots fired (npc_shot_dispersion, once per
-- bullet, ai_stalker_fire.cpp:135-139) vs hits landed on the actor (actor_on_hit_callback carries
-- the shooter). Both handlers bail on the _dbg boolean; the counts ride the end trace line.
local _shots = {}
local _hits = {}

-- End the maneuver: lower the gate, clear the row, release any cover the feasibility check reserved, on
-- EVERY exit (arrived, cap, never-begun) so a gate that raised but never ran a maneuver does not leak the
-- reservation in db.used_level_vertex_ids (t136). Also resets the stall tracker: a transaction consumes
-- the situation's accumulated measurement, so `stalled` means "standoff SINCE the last maneuver" and a
-- completed hold negates its own need (a fresh stall must accumulate before the next one).
local function _end_maneuver(state, tg, reason, check_us)
    if _dbg then
        trace.end_maneuver(state.id, state.maneuver and state.maneuver.name, reason,
            math_floor(tg - (state.begin_at or tg)), check_us, _shots[state.id] or 0, _hits[state.id] or 0,
            state.result)
    end
    _shots[state.id] = nil
    _hits[state.id] = nil
    state.result = nil
    _drop_gate(state)
    state.maneuver = nil
    state.dest = nil
    state.trigger = nil
    state.maneuver_at = nil
    state.begin_at = nil
    state.stall_set = false
    _release_cover(state)
end

-- Begin the maneuver - the first engine write, at the grafted action's initialize (the engine granted control
-- this frame; writing earlier would fight vanilla, which drives until the planner swap). Sets the destination
-- once (the engine walks it), applies the row's combat state once. Target
-- commitment: the maneuver fights the enemy it was STAGED against (state.enemy_id), never whatever the brain
-- re-selected since - a gone/dead target means the maneuver does not begin. The begin write is timed in two
-- parts (send=/apply=, debug only) so a slow begin names which engine call cost it - send_to or apply_state.
local function _begin_maneuver(npc)
    local state = _npc_states[npc:id()]
    if not state or not state.maneuver then return end
    local tg = time_global()
    local maneuver = state.maneuver
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    if not enemy then _end_maneuver(state, tg, "target_lost") return end
    local tmr_send = xprofiler.new_if(_dbg):start()
    xcombat.send_to(npc, state.dest)
    tmr_send:stop()
    local tmr_apply = xprofiler.new_if(_dbg):start()
    local fire, gate = doctrine.apply_state(npc, maneuver, enemy)
    tmr_apply:stop()
    state.maneuver_at = tg
    _shots[state.id] = nil
    _hits[state.id] = nil
    if _dbg then
        trace.begin_maneuver(state.id, maneuver.name, state.trigger, state.dest, fire, maneuver.movement,
            maneuver.fire, gate, state.cover, math_floor(tmr_send:get_us()), math_floor(tmr_apply:get_us()))
    end
end

-- Shot counter (debug only): one increment per bullet a maneuvering NPC fires.
local function _on_shot_fired(obj)
    if not _dbg or not obj then return end
    local id = obj:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _shots[id] = (_shots[id] or 0) + 1
    end
end

-- Actor-hit counter (debug only): one increment per damaging hit a maneuvering NPC lands on the actor.
local function _on_actor_hit(_, amount, _, who)
    if not _dbg or not who then return end
    if not amount or amount <= 0 then return end
    local id = who:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _hits[id] = (_hits[id] or 0) + 1
    end
end

-- Outcome stamp (debug only): a maneuvering NPC wounding or killing his COMMITTED target marks the
-- maneuver's result, printed on the end trace line (npc_on_enemy_wounded_or_killed cannot fire for
-- the actor as victim, so the player-facing outcome stays the hits_actor counter).
local function _on_enemy_downed(npc, victim)
    if not _dbg or not (npc and victim) then return end
    local state = _npc_states[npc:id()]
    if not (state and state.maneuver) then return end
    if victim:id() ~= state.enemy_id then return end
    state.result = victim:alive() and "wounded" or "killed"
end

-- One spec drives every AT NPC: gate = the per-NPC flag the grafted evaluator polls; on_begin = _begin_maneuver,
-- called once when the grafted action activates. Per-NPC state lives in _npc_states, keyed by id.
-- The gate reads cfg.combat_enabled FIRST: the graft installs for every stalker even when the feature is off,
-- and the engine re-evaluates the grafted evaluator every plan solve (problem_solver actual()), so with the
-- feature disabled the whole crossing is one Lua boolean read - the npc:id() luabind never runs.
local SPEC = {
    gate = function(npc)
        if not cfg.combat_enabled then return false end
        local state = _npc_states[npc:id()]
        return state ~= nil and state.gate == true
    end,
    on_begin = _begin_maneuver,
}

-- Debug-only decision trace, gated here so the bridge reads (name, operator, facing, sight, cover) never run
-- when tracing is off. The cover read happens at DECIDE time, before any seize: under a takeover block the
-- planner flags can only decay (the blocked planner cannot run take_cover, the on_best_cover_changed clear
-- still fires), so the pre-seize value is the truthful one - the begin line reprints it from state.cover.
local function _trace_decision(npc, state, enemy, result)
    if not _dbg then return end
    local enemy_pos = enemy:position()
    state.enemy_name = xcreature.get_name(enemy:id())
    state.operator   = xcombat.get_operator(npc)
    state.aim_off    = math_floor(xcombat.get_facing_offset(npc, enemy_pos))
    state.seen       = xcombat.sees(npc, enemy)
    local in_cover, looked_out, held = xcombat.get_cover_state(npc)
    state.cover = trace.cover_string(in_cover, looked_out, held,
        xcombat.has_obstacle_to_target(enemy_pos, npc:position()))
    trace.decision(state.id, state, result or "none")
end

-- The seize gates after the fighting read, cheapest first. Returns (skip reason, detail) for the monitor
-- trace, or nil when the NPC may walk the catalog. Which fights qualify is not decided here: every row
-- declares whose problem it answers (vs_actor), and the walk skips rows out of scope - AT seizes only
-- problems the actor is party to, as row data, not as a gate branch.
-- Concurrency cap (failsafe): the field is full, so skip the catalog walk (and its can_maneuver
-- raycasts) before any expensive read; the NPC retries on its next begin check.
local function _seize_blocked(npc)
    local can_seize, seize_block = _can_seize(npc)
    if not can_seize then return "cannot_seize", seize_block end
    if MAX_CONCURRENT > 0 and _open_count >= MAX_CONCURRENT then return "at_cap" end
    return nil
end

-- Look for a maneuver to begin: managed, fighting, seizable, under the cap, a catalog row picked (its
-- need fired, palette matched, its can_maneuver yielded a destination). Staging = record the row +
-- destination + the row's committed target and raise the gate; the engine grants control at the next
-- plan solve and calls _begin_maneuver. No engine write happens here - vanilla still drives this frame.
-- There is no reseize cooldown: every row's need states the full problem and the maneuver's success
-- negates it, so the trigger itself is the throttle - a re-fired need is a real, recurred problem.
local function _try_begin_maneuver(npc, state, tg)
    if not _manages(npc) then state.fighting = false return end
    local tmr = xprofiler.new_if(_dbg):start()

    local enemy = npc:best_enemy()
    state.fighting = _is_fighting(enemy, state, tg)
    if not state.fighting then state.stall_set = false state.row_cursor = 1 state.circuit_sit = nil return end
    if _dbg then trace.set_name(state.id, npc:name()) end

    if not enemy then
        state.enemy_id = nil
        tmr:stop()
        trace.monitor(state.id, state, "no_enemy", nil, tmr:get_us())
        return
    end
    state.enemy_id = enemy:id()

    local blocked, block_detail = _seize_blocked(npc)
    if blocked then
        tmr:stop()
        trace.monitor(state.id, state, blocked, block_detail, tmr:get_us())
        return
    end

    -- resolve_maneuver arbitrates the catalog from the per-NPC cursor (per row: scope -> toggle ->
    -- should_maneuver -> palette -> can_maneuver). A row whose need is absent falls through in the same
    -- tick; the one can_maneuver that runs ends the walk and moves the cursor past its row (decline =
    -- defer, pick = the next decision starts below). Returns (maneuver, dest) on a pick and nil
    -- otherwise; it stores the fired situation on state.trigger and the walked rows + timings on
    -- state.rows / state.walk_us.
    local maneuver, dest = doctrine.resolve_maneuver(npc, enemy, state, tg)
    if maneuver then
        state.gate = true
        _open_count = _open_count + 1
        state.maneuver = maneuver
        state.dest = dest
        state.maneuver_at = nil
        state.begin_at = tg
    end
    tmr:stop()
    if _dbg then state.check_us = math_floor(tmr:get_us()) end
    _trace_decision(npc, state, enemy, maneuver and maneuver.name)
    -- A vs_actor row commits to the ACTOR: its problem is the actor, not the selected enemy, so the
    -- maneuver aims at, ends on, and resolves the actor for its whole life. Staged AFTER the decision
    -- trace so the trace's (id, name, distance) triple all read the selected enemy.
    if maneuver and maneuver.vs_actor then state.enemy_id = AC_ID end
end

-- Run the maneuver's own update from its catalog row (a firing row re-checks its shot, flee re-asserts its
-- holster, a row without one does nothing). Begun-guarded: no engine write before _begin_maneuver ran.
-- Target commitment: the row keeps aiming at the STAGED enemy (state.enemy_id) for the maneuver's whole
-- life; a gone/dead target applies READY here and the end check closes the maneuver on its next period.
-- The debug trace is the mid-maneuver aim evidence: sight to the staged target, body-to-target angle,
-- applied fire + gate.
local function _update_maneuver(npc, state, _tg)
    local maneuver = state.maneuver
    if not maneuver or not state.maneuver_at then return end
    if not maneuver.update then return end
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    local tmr = xprofiler.new_if(_dbg):start()
    local fire, gate = maneuver.update(npc, maneuver, enemy)
    tmr:stop()
    if not _dbg then return end
    local us = math_floor(tmr:get_us())
    if not enemy then
        trace.update_maneuver(state.id, maneuver.name, nil, fire, gate, us)
        return
    end
    trace.update_maneuver(state.id, maneuver.name, {
        id       = enemy:id(),
        name     = xcreature.get_name(enemy:id()),
        seen     = xcombat.sees(npc, enemy),
        aim_off  = math_floor(xcombat.get_facing_offset(npc, enemy:position())),
    }, fire, gate, us)
end

-- Movers end on arrival; the cap (from begin_at) ends everything, so a gate that raised but never began a
-- maneuver cannot wedge the NPC. Holds have no arrival and end only on the cap. A row's should_end is its
-- PREMISE: the need terms that must hold for the transaction's whole life (snipe: not under fire, not
-- targeted) - a broken premise ends the maneuver now, not at the cap. A feature turned off mid-maneuver
-- ends here too: SPEC.gate already handed the NPC back to vanilla, so the row's update must stop driving
-- it - ending drops state.gate, which stops _update_maneuver on the same pass.
-- Why an open maneuver should end NOW, or nil to keep running: the row's premise (should_end, a broken
-- premise names itself), arrival for begun movers, the time cap for everything - a staged-never-granted
-- gate ends on the cap too, so it cannot wedge the NPC.
local function _end_reason(npc, enemy, state, tg)
    local maneuver = state.maneuver
    local begun = maneuver ~= nil and state.maneuver_at ~= nil
    local broken = begun and maneuver.should_end and maneuver.should_end(npc, enemy, state, tg)
    if broken then return broken end
    if begun and maneuver.ends_on == "arrival" and xcombat.is_arrived(npc) then return "arrived" end
    if (tg - (state.begin_at or tg)) >= ((maneuver and maneuver.timeout) or MANEUVER_CAP_MS) then return "cap" end
    return nil
end

local function _try_end_maneuver(npc, state, tg)
    if not _manages(npc) then _end_maneuver(state, tg, "disabled") return end
    -- Target commitment: the staged enemy died or despawned - hand back now, vanilla picks the next
    -- fight. Only for a BEGUN maneuver; a staged-never-granted gate still ends on the cap in _end_reason.
    local enemy
    if state.maneuver and state.maneuver_at then
        enemy = xcombat.resolve_enemy(state.enemy_id)
        if not enemy then
            _end_maneuver(state, tg, "target_lost")
            return
        end
    end
    local tmr = xprofiler.new_if(_dbg):start()
    local reason = _end_reason(npc, enemy, state, tg)
    tmr:stop()
    if reason then _end_maneuver(state, tg, reason, math_floor(tmr:get_us())) end
end


-- The check catalog: every timed operation is one row { name, period, open, run }; open is the state.gate
-- value the check requires (false = no maneuver open, true = one running). Built in _load_config, after
-- the periods are read.

local CHECKS

local function _build_checks()
    CHECKS = {
        { name = "begin_maneuver",  period = BEGIN_PERIOD_MS,  open = false, run = _try_begin_maneuver },
        { name = "update_maneuver", period = UPDATE_PERIOD_MS, open = true,  run = _update_maneuver    },
        { name = "end_maneuver",    period = END_PERIOD_MS,    open = true,  run = _try_end_maneuver   },
    }
end

-- Run one check: bail unless its own period elapsed, else stamp and run.
local function _run_check(check, npc, state, tg)
    if tg - (state.ran_at[check.name] or 0) < check.period then return end
    state.ran_at[check.name] = tg
    check.run(npc, state, tg)
end

-- The monitor pass, a vanilla time event every MONITOR_PERIOD_SEC: for each tracked NPC, resolve the
-- object and run whichever checks are due. The per-frame cost of the whole monitor is ONE timer compare
-- inside vanilla's own ProcessEventQueue walk (_g.script:364, driven from the actor update at
-- bind_stalker_ext.script:26); the real work runs 5 times a second total, never per frame, never per NPC
-- per frame. level.object_by_id is a hash net_Find returning nil for a gone id (level_script.cpp:131-138).
-- The pass re-arms FIRST: ProcessEventQueue has no error protection, so an error mid-pass with the event
-- still expired would re-fire and re-error every frame, starving every time event in the game (the
-- 2026-07-11 frozen-HUD loop); re-armed, a fault costs one aborted pass and the queue heals itself.
local _monitor_active = false

-- One NPC's slice of the pass: run whichever checks match its open/closed state and are due.
-- ALIVE only - the engine combat binds (see, fire_make_sense, best_enemy) fault on a dead stalker's
-- torn-down AI state (the smart_cast guards type, not liveness). A tracked NPC found dead ends its
-- maneuver through the normal path (gate, cover, count, the traced "died" reason - 4 begins with no
-- end lines in the 2026-07-11 session were exactly these); the roster entry itself dies on
-- net_destroy/unregister.
local function _run_npc_checks(npc, state, tg)
    if not npc:alive() then
        if state.maneuver then _end_maneuver(state, tg, "died") end
        _drop_gate(state)
        _release_cover(state)
        return
    end
    local open = state.gate == true
    for i = 1, #CHECKS do
        local check = CHECKS[i]
        if check.open == open then _run_check(check, npc, state, tg) end
    end
end

local function _run_monitor()
    if not _monitor_active then return true end
    ResetTimeEvent("at_combat", "monitor", MONITOR_PERIOD_SEC)
    local tg = time_global()
    for id, state in pairs(_npc_states) do
        local npc = level.object_by_id(id)
        if npc then _run_npc_checks(npc, state, tg) end
    end
end

local function _start_monitor()
    if _monitor_active then return end
    _monitor_active = true
    RemoveTimeEvent("at_combat", "monitor")
    CreateTimeEvent("at_combat", "monitor", MONITOR_PERIOD_SEC, _run_monitor)
end

local function _stop_monitor()
    _monitor_active = false
    RemoveTimeEvent("at_combat", "monitor")
end


-- Public API consumed by at_hud and the at_test observer.

--- Current maneuver name for an NPC, or nil when AT is not driving one.
function get_maneuver(id)
    local state = _npc_states[id]
    return state and state.maneuver and state.maneuver.name
end


-- Lifecycle: install on spawn, stamp the far-shooter fight entry on hit, clean up on destroy / unregister.

local function _install(npc)
    if not npc or not IsStalker(npc) then return end
    local id = npc:id()
    if _npc_states[id] then return end
    _npc_states[id] = { id = id, ran_at = {} }
    xcombat.install_takeover(npc, SPEC)
    if _dbg then trace.installed(id, npc:name()) end
end

-- A hit stamps the fight clock so a far shooter - out of the engine's enemy-distance gate, best_enemy still nil -
-- reads as fighting on the next begin check.
local function _on_hit(npc, amount)
    if not npc or not amount or amount <= 0 then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    state.hit_at = time_global()
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    xcombat.release_takeover(npc)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    -- Clear xcombat's install guard too: an id unregistered WITHOUT a prior net_destroy would leave a stale
    -- guard there and the recycled id would silently skip its next graft.
    xcombat.release_takeover_id(id)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
    if _dbg then trace.forget(id) end
end

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    BEGIN_PERIOD_MS     = read_int("begin_period_ms",     600)
    UPDATE_PERIOD_MS    = read_int("update_period_ms",    200)
    END_PERIOD_MS       = read_int("end_period_ms",       200)
    HIT_FIGHT_MS        = read_int("hit_fight_ms",        5000)
    MAX_CONCURRENT      = read_int("max_concurrent_maneuvers", 20)
    for i = 1, #QUEUE_KINDS do
        local kind = QUEUE_KINDS[i]
        local min_s, max_s, min_i, max_i = xcombat.get_fire_queue(kind, "medium")
        local size, interval = math_floor((min_s + max_s) / 2), math_floor((min_i + max_i) / 2)
        local raw = ini:r_string_ex(LTX_SECTION, "queue_" .. kind)
        local o_size, o_interval = string_match(raw or "", "^%s*(%d+)%s*,%s*(%d+)")
        if o_size then
            size, interval = tonumber(o_size), tonumber(o_interval)
        end
        _queue_by_kind[kind] = { size, interval, 0 }
    end
    _build_checks()
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    trace.set_enabled(_dbg)
end

-- The monitor runs only while the feature is on. Turning it off mid-game first ends every open maneuver
-- through the normal path (gate down, cover released, count honest) - SPEC.gate already handed those NPCs
-- back to vanilla at the next plan solve - then stops the pass, so a disabled feature costs zero.
local function _apply_enabled()
    if cfg.combat_enabled then
        _start_monitor()
        return
    end
    local tg = time_global()
    for _, state in pairs(_npc_states) do
        if state.maneuver then _end_maneuver(state, tg, "disabled") end
    end
    _stop_monitor()
end

local function _on_option_change()
    _refresh_log()
    _apply_enabled()
end

local function _on_first_update()
    trace.reset()
    _open_count = 0
    _refresh_log()
    -- Time events do not survive a save load (_g.script header), so the monitor arms here, per session.
    _apply_enabled()
    log.info("Combat monitor initialized (enabled=%s dbg=%s cap=%d queue_patch=%s)",
        tostring(cfg.combat_enabled), tostring(_dbg), MAX_CONCURRENT,
        _orig_get_queue_params and "installed" or "missing")
end

function on_game_start()
    _load_config()
    doctrine.load_config()
    -- Function-level monkey-patch (script-loading.md pattern): the state machinery has no callback
    -- at the queue-params seam. Install-once guard for defensive re-entry; the module reference
    -- auto-loads in-game, and an environment without it (test harness) skips the patch.
    if not _orig_get_queue_params and state_mgr_weapon and state_mgr_weapon.get_queue_params then
        _orig_get_queue_params = state_mgr_weapon.get_queue_params
        state_mgr_weapon.get_queue_params = _patched_get_queue_params
    end
    RegisterScriptCallback("npc_on_net_spawn",            _install)
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_shot_dispersion",         _on_shot_fired)
    RegisterScriptCallback("actor_on_hit_callback",       _on_actor_hit)
    RegisterScriptCallback("npc_on_enemy_wounded_or_killed", _on_enemy_downed)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default",  _on_option_change)
end

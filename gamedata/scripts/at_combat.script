--- at_combat: the engine half of the combat takeover (Pattern B). Owns the GOAP evaluator + action, the
--- per-action engine state, the three throttled gates, the cover reservation, the handback hysteresis, and
--- the lifecycle. The decision half - which event fires, which maneuver answers it, where to move - lives in
--- at_combat_doctrine; this file turns those answers into xcombat commands.
---
--- Gates (each on its own throttle, execute() bails before any work when none is due):
---   FAST   (fast_throttle_ms)   _aim     point the weapon at the enemy (reaction cadence)
---   MEDIUM (medium_throttle_ms) _medium  urgent events -> a maneuver override (reverts when they clear)
---   SLOW   (slow_throttle_ms)   _slow    rebuild the palette, pick the base maneuver
--- Handback to vanilla is the evaluator returning false. No fail-backoff: a move that can't resolve just
--- holds and fires. The flickery gates (no-enemy, lost-sight) carry a hysteresis window so AT never
--- oscillates with vanilla. Tracing is noop when DEBUG is off.

local IsStalker, IsWounded, time_global = IsStalker, IsWounded, time_global
local math_sqrt, math_floor = math.sqrt, math.floor
local character_community, RegisterScriptCallback = character_community, RegisterScriptCallback
local vector, anim, game_object = vector, anim, game_object

local log = xlog.get_logger("AT.COMBAT", { outfile = "alifetactics.log" })
local _dbg = false
local cfg = at_mcm.cfg
local doctrine = at_combat_doctrine

-- Custom GOAP evaluator + action id, grafted per stalker on its motivation_action_manager. The 188000+ band
-- stays clear of the engine/Anomaly base ids; 188200 sits above xr_danger's 188113. ACT_ID is a module field
-- so at_hud reads one source instead of re-hardcoding the literal. See doc/library/modding/goap-injection.md.
ACT_ID = 188200
local EVAL_ID = ACT_ID

-- Perf timer stage names (-> at_combat_trace.stage).
local S_RESOLVE, S_APPLY = "resolve", "apply"


-- =========================================================================
-- LTX tunables (gate plumbing + handback hysteresis; the doctrine half loads its own). Deferred load.
-- =========================================================================

local LTX_PATH    = "alifetactics\\at_combat_config.ltx"
local LTX_SECTION = "at_combat"

local FAST_MS, MEDIUM_MS, SLOW_MS, NO_ENEMY_MS, LOST_SIGHT_MS, SEE_THROTTLE_MS

local function _load_tunables()
    local ini = ini_file(LTX_PATH)
    local function i(k, d) local v = ini:r_float_ex(LTX_SECTION, k); return v and math_floor(v) or d end
    FAST_MS         = i("fast_throttle_ms",   200)
    MEDIUM_MS       = i("medium_throttle_ms", 500)
    SLOW_MS         = i("slow_throttle_ms",   1000)
    NO_ENEMY_MS     = i("no_enemy_ms",        2500)
    LOST_SIGHT_MS   = i("lost_sight_ms",      2500)
    SEE_THROTTLE_MS = i("see_throttle_ms",    500)
end


-- =========================================================================
-- Per-NPC tracking
-- =========================================================================

local _installed   = {}
local _state       = {}
local _last_aim    = {}
local _last_medium = {}
local _last_slow   = {}
local _last_eval   = {}
local _last_reason = {}
-- _last_enemy: last tg with a live enemy (no-enemy hysteresis). _last_seen: last tg the NPC saw its enemy
-- (lost-sight hysteresis). _see_check / _saw: throttle interval + cached result for the evaluator see() probe.
local _last_enemy  = {}
local _last_seen   = {}
local _see_check   = {}
local _saw         = {}
local _community   = {}


-- =========================================================================
-- TAKEOVER GATE. The engine polls this evaluator while planning: true = AT drives the NPC (vanilla
-- combat/danger/alife planners are precondition-blocked), false = vanilla resumes.
-- =========================================================================

class "evaluator_at_combat" ( property_evaluator )

function evaluator_at_combat:__init(name) super (nil, name)
end

-- Throttled see() probe so the eval doesn't raycast perception every poll. Cached per SEE_THROTTLE_MS.
local function _saw_enemy(npc, enemy, id, tg)
    if tg - (_see_check[id] or 0) < SEE_THROTTLE_MS then return _saw[id] end
    local saw = npc:see(enemy)
    _see_check[id] = tg
    _saw[id] = saw
    return saw
end

local function _should_manage(npc, id, tg)
    if not cfg.combat_enabled then return false, "disabled" end
    if (id % 1000) >= (cfg.combat_share * 1000) then return false, "hash_out" end
    if not npc:alive() then return false, "dead" end
    if IsWounded(npc) then return false, "wounded" end
    if cfg.combat_ignore_companions and npc:has_info("npcx_is_companion") then return false, "companion" end

    local be = npc:best_enemy()
    if not (be and be:alive()) then
        if tg - (_last_enemy[id] or 0) > NO_ENEMY_MS then return false, "no_enemy" end
        return true, "managed"
    end
    _last_enemy[id] = tg

    if _saw_enemy(npc, be, id, tg) then
        _last_seen[id] = tg
    elseif not _last_seen[id] then
        -- start the clock on acquisition so a never-seen ghost also yields after the window
        _last_seen[id] = tg
    end
    if tg - _last_seen[id] > LOST_SIGHT_MS then return false, "lost_sight" end
    return true, "managed"
end

function evaluator_at_combat:evaluate()
    local npc = self.object
    local id = npc:id()
    local result, reason = _should_manage(npc, id, time_global())
    _last_eval[id]   = result
    _last_reason[id] = reason
    if _dbg then at_combat_trace.eval(id, result, reason) end
    return result
end


-- =========================================================================
-- Action
-- =========================================================================

class "action_at_combat" ( action_base )

function action_at_combat:__init(name) super (nil, name)
end

local function _claim(lvid, id) return xcombat.claim_cover(lvid, id) end
local function _release(lvid, id) xcombat.release_cover(lvid, id) end

-- Cover sticky test: true = hold the reserved firing spot (not yet reached, not stolen). Traces held / stolen.
local function _cover_held(target_lvid, is_cover, npc_lvid, id)
    if not (is_cover and target_lvid and npc_lvid ~= target_lvid) then return false end
    if xcombat.is_cover_stolen(target_lvid, id) then
        at_combat_trace.cover(id, "stolen", target_lvid)
        return false
    end
    at_combat_trace.cover(id, "held", target_lvid)
    return true
end

-- Park on the own node (hold and fire). Used by stationary maneuvers and as the resolve-fail fallback.
function action_at_combat:_hold_here(ctx, state)
    _release(self.target_lvid, ctx.id)
    self.target_lvid = ctx.npc_lvid
    state.last_cover_vid = nil
    xcombat.send_to(self.object, ctx.npc_lvid)
end

-- Resolve + send the destination for the active maneuver. Cover targets are sticky; stationary parks once;
-- a move that resolves nil holds and fires in place (never hands to vanilla).
function action_at_combat:_move(maneuver, ctx, state)
    local npc, id = self.object, ctx.id
    local is_cover   = doctrine.is_cover(maneuver)
    local stationary = doctrine.is_stationary(maneuver)

    if stationary then
        if self.target_lvid ~= ctx.npc_lvid then self:_hold_here(ctx, state) end
        return
    end

    if _cover_held(self.target_lvid, is_cover, ctx.npc_lvid, id) then return end

    local mtmr = xprofiler.new_if(_dbg):start()
    local vid = doctrine.resolve(maneuver, npc, ctx, state)
    at_combat_trace.stage(S_RESOLVE, mtmr:stop():get_ms())
    if not vid then
        at_combat_trace.resolve_fail(id, self.current_behavior, ctx.dist)
        if self.target_lvid ~= ctx.npc_lvid then self:_hold_here(ctx, state) end
        return
    end
    if vid == self.target_lvid then return end
    if is_cover and not _claim(vid, id) then
        at_combat_trace.cover(id, "claim_fail", vid)
        return
    end
    _release(self.target_lvid, id)
    self.target_lvid = vid
    state.last_cover_vid = is_cover and vid or nil
    local sent = xcombat.send_to(npc, vid)
    at_combat_trace.resolve_ok(id, self.current_behavior, vid, sent, ctx.dist, is_cover and "claimed" or nil)
end

-- Switch to a maneuver by name: release old cover, roll posture/speed, write the combat state, resolve dest.
-- override = true means a medium urgent maneuver (does not become the base); false sets the resting base.
function action_at_combat:_switch(name, ctx, state, override)
    local maneuver = doctrine.MANEUVERS[name]
    if not maneuver then return end
    state.override = override and true or false
    if not override then state.base_maneuver = name end
    if name == self.current_behavior then
        self:_move(maneuver, ctx, state)
        return
    end
    local id = ctx.id
    _release(self.target_lvid, id)
    self.target_lvid = nil
    state.last_cover_vid = nil
    self.current_behavior = name
    self.posture, self.movement = doctrine.roll(maneuver.fire, doctrine.is_stationary(maneuver))
    local atmr = xprofiler.new_if(_dbg):start()
    local ok = xcombat.set_combat(self.object, { fire = maneuver.fire, posture = self.posture, movement = self.movement, aim = ctx.enemy })
    at_combat_trace.stage(S_APPLY, atmr:stop():get_ms())
    if not ok then
        at_combat_trace.switch(id, name .. "(no_state)", maneuver.fire, self.posture, self.movement)
        return
    end
    at_combat_trace.switch(id, name, maneuver.fire, self.posture, self.movement)
    self:_move(maneuver, ctx, state)
end

function action_at_combat:initialize()
    action_base.initialize(self)
    local npc = self.object
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    self.current_behavior = nil
    self.target_lvid      = nil
    self.posture          = nil
    self.movement         = nil
    self.opened           = false
    local st = _state[npc:id()]
    if st then st.event_pick = {} end
end


-- =========================================================================
-- THE PIPELINE: three gates, each on its own throttle.
-- =========================================================================

function action_at_combat:execute()
    action_base.execute(self)
    local npc = self.object
    local id, tg = npc:id(), time_global()

    local aim_ready    = tg - (_last_aim[id]    or 0) >= FAST_MS
    local medium_ready = tg - (_last_medium[id] or 0) >= MEDIUM_MS
    local slow_ready   = tg - (_last_slow[id]   or 0) >= SLOW_MS
    if not (aim_ready or medium_ready or slow_ready) then return end

    local enemy = npc:best_enemy()
    if not (enemy and enemy:alive()) then return end

    local ctx = self:_gather(npc, id, enemy)
    if slow_ready   then self:_slow(ctx, tg) end
    if medium_ready then self:_medium(ctx, tg) end
    if aim_ready    then self:_aim(npc, id, enemy, tg) end
end

-- FAST gate: re-point the weapon at the enemy's current position.
function action_at_combat:_aim(npc, id, enemy, tg)
    _last_aim[id] = tg
    xcombat.aim_at(npc, enemy:position())
end

-- SLOW gate: refresh palette, read the slow signals, pick the base maneuver (none always resolves a base).
function action_at_combat:_slow(ctx, tg)
    local id, npc, enemy, state = ctx.id, ctx.npc, ctx.enemy, ctx.state
    _last_slow[id] = tg
    local timer = xprofiler.new_if(_dbg):start()

    doctrine.refresh(state, npc, ctx.npc_pos, ctx.npc_lvid)
    doctrine.read_slow(ctx, npc, enemy)

    local event = doctrine.first_event(doctrine.GATE_SLOW, ctx, state, tg)
    at_combat_trace.gate(id, npc, state, ctx, doctrine.GATE_SLOW, event)
    self:_dispatch(event, ctx, state, false)
    self.opened = true

    at_combat_trace.perf(timer:stop():get_ms())
end

-- MEDIUM gate: urgent events override the base maneuver; revert when none applies.
function action_at_combat:_medium(ctx, tg)
    local id, npc, enemy, state = ctx.id, ctx.npc, ctx.enemy, ctx.state
    _last_medium[id] = tg

    doctrine.read_medium(ctx, npc, enemy, tg)

    local event = doctrine.first_event(doctrine.GATE_MEDIUM, ctx, state, tg)
    at_combat_trace.gate(id, npc, state, ctx, doctrine.GATE_MEDIUM, event)
    self:_dispatch(event, ctx, state, true)
end

-- Dispatch: event -> the faction's maneuver. nil event or no maneuver for it = keep current (medium reverts
-- an active override to the base). Slow's "none" always resolves a maneuver, so the base is always set.
function action_at_combat:_dispatch(event, ctx, state, is_medium)
    local name = event and doctrine.pick(event, state)
    if not name then
        if is_medium and state.override then
            self:_switch(state.base_maneuver or "hold_fire", ctx, state, false)
        else
            local maneuver = doctrine.MANEUVERS[self.current_behavior]
            if maneuver then self:_move(maneuver, ctx, state) end
        end
        return
    end
    self:_switch(name, ctx, state, is_medium)
end

-- Per-tick base context: state (lazily created), positions, distance, direction, range zone, at-cover.
function action_at_combat:_gather(npc, id, enemy)
    local state = _state[id]
    if not state then
        state = doctrine.init_state(npc, _community[id] or character_community(npc) or "stalker")
        _state[id] = state
    end
    local npc_pos  = npc:position()
    local ene_pos  = enemy:position()
    local npc_lvid = npc:level_vertex_id()
    local dx, dz   = ene_pos.x - npc_pos.x, ene_pos.z - npc_pos.z
    local dist     = math_sqrt(dx*dx + dz*dz)
    local inv      = dist > 0 and (1 / dist) or 0
    doctrine.range_zone(state, dist)
    state.at_cover = state.last_cover_vid ~= nil and npc_lvid == state.last_cover_vid
    return {
        npc = npc, id = id, enemy = enemy, state = state,
        npc_pos = npc_pos, ene_pos = ene_pos, npc_lvid = npc_lvid,
        dist = dist, dir_to = vector():set(dx * inv, 0, dz * inv), bucket = state.bucket,
        health = npc.health, opened = self.opened,
        grenade = false, under_fire = false, exposed = false,
        see = false, friendly = false, occluder = false,
    }
end

function action_at_combat:finalize()
    action_base.finalize(self)
    local npc = self.object
    _release(self.target_lvid, npc:id())
    self.target_lvid = nil
    npc:sniper_fire_mode(false)
end


-- =========================================================================
-- Lifecycle: install, unregister, MCM refresh
-- =========================================================================

local function _install(npc)
    if not npc then return end
    if not IsStalker(npc) then return end
    local id = npc:id()
    if _installed[id] then return end
    _installed[id] = true
    _community[id] = character_community(npc) or ""

    local manager = npc:motivation_action_manager()
    if not manager then return end

    manager:add_evaluator(EVAL_ID, evaluator_at_combat("eva_at_combat"))

    local action = action_at_combat("act_at_combat")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(EVAL_ID, true))
    action:add_effect(world_property(EVAL_ID, false))
    manager:add_action(ACT_ID, action)

    local blocked = {
        stalker_ids.action_combat_planner,
        stalker_ids.action_danger_planner,
        xr_danger.actid,
        xr_actions_id.state_mgr + 2,
        xr_actions_id.alife,
    }
    for i = 1, #blocked do
        local act = manager:action(blocked[i])
        if act then act:add_precondition(world_property(EVAL_ID, false)) end
    end
end

local function _on_net_spawn(npc)
    _install(npc)
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    _installed[id] = nil
    xcombat.release_owner_cover(id)
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    _installed[id]   = nil
    _last_eval[id]   = nil
    at_combat_trace.forget(id)
    _last_reason[id] = nil
    _last_enemy[id]  = nil
    _last_seen[id]   = nil
    _see_check[id]   = nil
    _saw[id]         = nil
    _community[id]   = nil
    _state[id]       = nil
    _last_medium[id] = nil
    _last_slow[id]   = nil
    _last_aim[id]    = nil
end

local function _refresh_log()
    log.set_level(at_mcm.get_config("log_level") or "WARN")
    _dbg = log.get_level() >= 5
    at_combat_trace.set_enabled(_dbg)
end

--- Telemetry (counters) + eval snapshot for the at_test stats dump. DEBUG-accumulated.
function get_stats()
    return at_combat_trace.stats(), _last_eval, _last_reason
end

local function _on_first_update()
    _installed   = {}
    _state       = {}
    _last_aim    = {}
    _last_medium = {}
    _last_slow   = {}
    _last_eval   = {}
    _last_reason = {}
    _last_enemy  = {}
    _last_seen   = {}
    _see_check   = {}
    _saw         = {}
    _community   = {}
    at_combat_trace.reset()
    _refresh_log()
    log.info("Combat module initialized (enabled=%s share=%.2f dbg=%s)",
        cfg.combat_enabled and "true" or "false",
        cfg.combat_share or 1.0,
        _dbg and "true" or "false")
end

function on_game_start()
    _load_tunables()
    doctrine.load_tunables()
    RegisterScriptCallback("npc_on_net_spawn",            _on_net_spawn)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _refresh_log)
    RegisterScriptCallback("mcm_option_restore_default",  _refresh_log)
end

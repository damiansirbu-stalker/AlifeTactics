--- at_faction: the stalker decision gates - the faction maneuver lists and Intelligence (base + rank), from at_faction_config.ltx

local math_random, math_min = math.random, math.min

local LTX_PATH   = "alifetactics\\at_faction_config.ltx"
local ZOMBIED    = "zombied"

local cfg = at_mcm.cfg

local _ini = xltx.resolve_handle(LTX_PATH)
local _intelligence_cap = xltx.read_num(_ini, "caps", "intelligence") or 0.75
local _chances = {}
local _tier_index = nil

-- The Intelligence probability: base + per-rank slope over the stalker's own rank tier, capped - the act chance of the decision model.
local function _compute_intelligence(npc)
    if not _tier_index then
        _tier_index = {}
        for i = 1, #xcreature.RANK_TIERS do _tier_index[xcreature.RANK_TIERS[i]] = i - 1 end
    end
    local tier = ranks.get_obj_rank_name(npc)
    local index = tier and _tier_index[tier] or 0
    return math_min((cfg.int_base + cfg.int_rank_pct * index) / 100, _intelligence_cap)
end

--- Zombied never participate in any system - the one universal filter; skill and correctness systems read this alone.
function is_participant(npc)
    return xcreature.get_community(npc) ~= ZOMBIED
end

--- The one Intelligence roll of a decision - the chance of the good answer at this opening; the caller spends the opening either way.
function check_intelligence(npc)
    return math_random() < _compute_intelligence(npc)
end

--- The per-action Personality chance for this faction - proclivity 0..1, rolled per opening; a missing action or faction = 1.0 (universal).
function check_personality(npc, action)
    local faction = xcreature.get_community(npc)
    local ck = action .. "/" .. faction
    local chance = _chances[ck]
    if chance == nil then
        chance = xltx.read_num(_ini, action, faction) or xltx.read_num(_ini, action, "default") or 1
        _chances[ck] = chance
    end
    if chance >= 1 then return true end
    if chance <= 0 then return false end
    return math_random() < chance
end

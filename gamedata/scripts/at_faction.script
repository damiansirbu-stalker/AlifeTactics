--- at_faction: faction flavor - the chance a faction's stalker carries each behavior, read from
--- at_faction_config.ltx ([<faction>] key, else [default] key, else 1)

local math_random = math.random

local LTX_PATH   = "alifetactics\\at_faction_config.ltx"
local ROLL_TTL_S = 300

local _ini = xltx.resolve_handle(LTX_PATH)
local _chances = {}
local _rolls = xttltable.create_ttl_table({ default_ttl = ROLL_TTL_S })

--- The configured chance for one faction and key; 1 when neither the faction nor default carries it
function get_faction_chance(faction, key)
    local ck = faction .. "/" .. key
    local chance = _chances[ck]
    if chance == nil then
        chance = xltx.read_num(_ini, faction, key)
        if chance == nil then chance = xltx.read_num(_ini, "default", key) end
        if chance == nil then chance = 1 end
        _chances[ck] = chance
    end
    return chance
end

--- Does THIS stalker carry the behavior: his faction's chance, rolled once per NPC per key and
--- held ROLL_TTL_S so he never flip-flops within a fight; 0 and 1 answer without rolling
function has_flavor(npc, key)
    local chance = get_faction_chance(xcreature.get_community(npc), key)
    if chance >= 1 then return true end
    if chance <= 0 then return false end
    local rk = npc:id() .. "/" .. key
    if _rolls:get_remaining_ttl(rk) ~= nil then return _rolls:get(rk) end
    local held = math_random() < chance
    _rolls:set(rk, held)
    return held
end

--- at_maneuvers: the intermittent takeover - seize one NPC for one committed maneuver, hand back; catalog rows in at_maneuvers_config

local IsStalker, IsWounded, time_global, tostring, pairs = IsStalker, IsWounded, time_global, tostring, pairs
local math_floor, math_random, RegisterScriptCallback, AC_ID = math.floor, math.random, RegisterScriptCallback, AC_ID
local string_match, tonumber = string.match, tonumber
local math_sqrt, vector, table_concat = math.sqrt, vector, table.concat

local cfg = at_mcm.cfg
local show, flag = at_debug.show, at_debug.flag

local LTX_PATH    = "alifetactics\\at_maneuvers_config.ltx"
local LTX_SECTION = "at_maneuvers"

local MONITOR_PERIOD_SEC = 0.2
local COMPANION_INFO = "npcx_is_companion"
local MANEUVER_CAP_MS = 8000
local HOLD_WINDOW_MS = 2000
local MON_FLUSH_MS = 5000
local QUEUE_KINDS = { "w_pistol", "w_shotgun", "w_rifle", "w_smg", "w_sniper" }
local KITE_KINDS = { "w_melee", "w_shotgun", "w_pistol", "w_smg", "w_rifle", "w_sniper", "w_explosive" }
local REPEAT_MOVE_M   = 2
local REPEAT_MOVE_SQR = REPEAT_MOVE_M * REPEAT_MOVE_M

local BEGIN_PERIOD_MS, UPDATE_PERIOD_MS, END_PERIOD_MS, HIT_FIGHT_MS, MAX_CONCURRENT
local HURT_FRAC, STALL_MS, STALL_MOVE_SQR, STALL_CLOSE_M
local KITE_ARC_DEG, KITE_SPREAD_DEG, KITE_DISTANCE_M
local FLEE_MIN_DIST_M, FLEE_BASE_MIN_DIST_M, RETREAT_REAR_M, UNDER_FIRE_MS
local COUNTERFLANK_ACTOR_DIST_SQR, PICKOFF_TARGETED_DEG, PICKOFF_ENTER_FACTOR
local REPEAT_LIMIT, RELOAD_STALE_MS, RELOAD_COVER_CONE_DEG

local _npc_states = {}
local _open_count = 0
local _queue_band_by_kind = {}
local _pickoff_band
local _orig_get_queue_params
local _shots = {}
local _hits = {}
local _monitor_active = false
local _mon = { ms = 0, max = 0, ticks = 0, last = 0 }
local CHECKS
local CATALOG = {}
local _seg = xprofiler.new_if(false)

local function _patched_get_queue_params(npc, st, override)
    local state = npc and _npc_states[npc:id()]
    if state and state.maneuver then
        local timer = xprofiler.new_if(at_debug.on()):start()
        local band
        if state.maneuver.name == "pickoff" then
            band = _pickoff_band
        else
            local kind = xcombat.get_weapon_kind(npc)
            band = kind and _queue_band_by_kind[kind]
        end
        if band then
            local size     = math_random(band[1], band[2])
            local interval = math_random(band[3], band[4])
            local sk, ik = at_reaction.get_queue_scales(npc)
            size = math_floor(size * sk + 0.5)
            if size < 1 then size = 1 end
            interval = math_floor(interval * ik + 0.5)
            override = { size, interval, 0 }
        end
        timer:stop()
        if at_debug.on() then
            at_debug.dbg("[QUE] id=%d row=%s size=%s interval=%s [%.3fms]",
                npc:id(), state.maneuver.name,
                band and tostring(override[1]) or "vanilla",
                band and tostring(override[2]) or "vanilla", timer:get_ms())
        end
    end
    return _orig_get_queue_params(npc, st, override)
end

local function _has_recent_hit(state, tg, window_ms)
    return state.hit_at ~= nil and (tg - state.hit_at) < window_ms
end

local function _is_fighting(enemy, state, tg)
    if enemy ~= nil then return true end
    return _has_recent_hit(state, tg, HIT_FIGHT_MS)
end

local function _is_zombied(npc, state)
    if state.zombied == nil then state.zombied = xcreature.is_zombied(npc) end
    return state.zombied
end

local function _manages(npc)
    if not cfg.combat_enabled then return false end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return false end
    return true
end

local function _can_seize(npc, state)
    if _is_zombied(npc, state) then return false, "zombied" end
    if not xcombat.get_weapon_kind(npc) then return false, "no_weapon" end
    if npc:in_smart_cover() then return false, "smart_cover" end
    local busy, why = xcombat.is_body_busy(npc)
    if busy then return false, why end
    return true
end

local function _find_kite_lane(npc, _enemy, state, _tg, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dist = state.dist
    local dir
    if dist > 0 then
        dir = vector():set((np.x - ep.x) / dist, 0, (np.z - ep.z) / dist)
    else
        local fwd = xcombat.get_facing(npc)
        dir = vector():set(-fwd.x, 0, -fwd.z)
    end
    local back_m = KITE_DISTANCE_M[memo.kind] or KITE_DISTANCE_M.w_rifle
    local vid = xcombat.find_flee_lane(npc, dir, back_m, KITE_ARC_DEG, KITE_SPREAD_DEG)
    local min_m        = xcombat.get_weapon_range(memo.kind).min
    local vp           = vid and level.vertex_position(vid)
    local lane_m       = vp and math_sqrt(xmath.dist_flat_sqr(vp, np)) or -1
    local dest_enemy_m = vp and math_sqrt(xmath.dist_flat_sqr(vp, ep)) or -1
    if vid and dest_enemy_m <= min_m then
        at_debug.dbg("[CMB] can_kite id=%s name=%s dist=%.1f min_m=%.1f back_m=%.1f dest_enemy_m=%.2f lane_m=%.2f lane=%s result=short",
            show(state.id), show(state.name), dist or -1, min_m, back_m, dest_enemy_m, lane_m, show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_kite id=%s name=%s dist=%.1f min_m=%.1f back_m=%.1f dest_enemy_m=%.2f lane_m=%.2f lane=%s result=%s",
        show(state.id), show(state.name), dist or -1, min_m, back_m, dest_enemy_m, lane_m,
        show(vid or "none"), vid and "taken" or "no_lane")
    return vid
end

local function _pickoff_blocked(npc, enemy, state, tg, npc_pos)
    if _has_recent_hit(state, tg, UNDER_FIRE_MS) then return "under_fire" end
    if xcombat.is_under_fire(npc, enemy, tg, UNDER_FIRE_MS) then return "under_fire" end
    if db.actor and xcombat.is_facing(db.actor, npc_pos, PICKOFF_TARGETED_DEG) then return "targeted" end
    return nil
end

local function _find_pickoff_spot(npc, enemy, state, tg, memo)
    local blocked = _pickoff_blocked(npc, enemy, state, tg, memo.npc_pos)
    if blocked then
        at_debug.dbg("[CMB] can_pickoff id=%s name=%s dist=%.1f enemy_max=unknown result=%s",
            show(state.id), show(state.name), state.dist or -1, show(blocked))
        return nil
    end
    local enemy_band = xcombat.get_weapon_range(xcombat.get_weapon_kind(enemy) or "w_rifle")
    local planted = state.dist > enemy_band.max * PICKOFF_ENTER_FACTOR
    at_debug.dbg("[CMB] can_pickoff id=%s name=%s dist=%.1f enemy_max=%s result=%s",
        show(state.id), show(state.name), state.dist or -1, show(enemy_band.max), planted and "plant" or "in_effective_range")
    if not planted then return nil end
    state.pickoff_exit_sqr = enemy_band.max * enemy_band.max
    return npc:level_vertex_id()
end

local function _check_end_pickoff(npc, enemy, state, tg)
    local pos = npc:position()
    local blocked = _pickoff_blocked(npc, enemy, state, tg, pos)
    if blocked then return blocked end
    if state.pickoff_exit_sqr and enemy and xmath.dist_flat_sqr(pos, enemy:position()) < state.pickoff_exit_sqr then
        return "in_effective_range"
    end
    return nil
end

local function _find_counterflank_spot(npc, _enemy, state, _tg, _memo)
    at_debug.dbg("[CMB] can_counterflank id=%s name=%s path=taken", show(state.id), show(state.name))
    return npc:level_vertex_id()
end

local function _find_reload_cover(npc, _enemy, state, _tg, memo)
    if not xcombat.is_reloading(npc) then
        state.reloading = nil
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=not_reloading cover=-", show(state.id), show(state.name))
        return nil
    end
    if not xcombat.actor_can_hit(npc, RELOAD_COVER_CONE_DEG) then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=actor_no_shot cover=-", show(state.id), show(state.name))
        return nil
    end
    local vid = xcombat.find_cover(npc, memo.enemy_pos, { selection = "nearest", firing = false, radius = 5, search_pos = npc:position() })
    if not vid then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=no_cover cover=-", show(state.id), show(state.name))
        return nil
    end
    if not xcombat.claim_cover(vid, state.id) then
        at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=claim_lost cover=%s", show(state.id), show(state.name), show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_reload_cover id=%s name=%s path=taken cover=%s", show(state.id), show(state.name), show(vid))
    state.cover_lvid = vid
    return vid
end

local function _check_end_reload_cover(_npc, _enemy, state, _tg)
    if state.reloading then return nil end
    return "reload_done"
end

local function _find_retreat_cover(npc, _enemy, state, _tg, memo)
    local np, ep = memo.npc_pos, memo.enemy_pos
    local dx, dz = np.x - ep.x, np.z - ep.z
    local dist_sqr = dx * dx + dz * dz
    local center = np
    if dist_sqr > 0 then
        local inv = RETREAT_REAR_M / state.dist
        center = vector():set(np.x + dx * inv, np.y, np.z + dz * inv)
    end
    local vid = xcombat.find_cover(npc, ep, { selection = "best", firing = true, radius = 7, search_pos = center })
    if not vid then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=no_cover cover=- cover_dist=-1.0 npc_dist=-1.0",
            show(state.id), show(state.name))
        return nil
    end
    local vp = level.vertex_position(vid)
    local vdx, vdz = vp.x - ep.x, vp.z - ep.z
    local cover_dist_sqr = vdx * vdx + vdz * vdz
    if cover_dist_sqr <= dist_sqr then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=toward_enemy cover=%s cover_dist=%.1f npc_dist=%.1f",
            show(state.id), show(state.name), show(vid), math_sqrt(cover_dist_sqr), state.dist or -1)
        return nil
    end
    if not xcombat.claim_cover(vid, state.id) then
        at_debug.dbg("[CMB] can_retreat id=%s name=%s path=claim_lost cover=%s cover_dist=-1.0 npc_dist=-1.0",
            show(state.id), show(state.name), show(vid))
        return nil
    end
    at_debug.dbg("[CMB] can_retreat id=%s name=%s path=taken cover=%s cover_dist=%.1f npc_dist=%.1f",
        show(state.id), show(state.name), show(vid), math_sqrt(cover_dist_sqr), state.dist or -1)
    state.cover_lvid = vid
    return vid
end

local function _flee_blocked(npc, enemy, state)
    if not xsquad.is_last_man(npc:id()) then return "squad_stands" end
    local tg = time_global()
    if _has_recent_hit(state, tg, UNDER_FIRE_MS) then return "under_fire" end
    if xcombat.is_under_fire(npc, enemy, tg, UNDER_FIRE_MS) then return "under_fire" end
    return nil
end

local function _find_flee_base(npc, enemy, state, _tg, memo)
    local blocked = _flee_blocked(npc, enemy, state)
    if blocked then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=%s", show(state.id), show(state.name), show(blocked))
        return nil
    end
    if state.dist < FLEE_MIN_DIST_M then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=too_close", show(state.id), show(state.name))
        return nil
    end
    local base = xsmart.find_friendly_base(memo.faction, memo.npc_pos,
        { level_id = xlevel.get_actor_level_id(), away_from_pos = memo.enemy_pos, min_distance = FLEE_BASE_MIN_DIST_M })
    if base then
        at_debug.dbg("[CMB] can_flee id=%s name=%s path=base", show(state.id), show(state.name))
        local vid = base.m_level_vertex_id
        if not vid or vid >= 4294967295 then vid = level.vertex_id(base.position) end
        return vid
    end
    at_debug.dbg("[CMB] can_flee id=%s name=%s path=no_base", show(state.id), show(state.name))
    return nil
end

local function _apply_state(npc, maneuver, enemy)
    return xcombat.set_combat(npc, {
        fire = maneuver.fire, posture = maneuver.posture, movement = maneuver.movement, enemy = enemy,
    })
end

local function _eval_stalled(state, tg, npc_pos, dist)
    if not state.stall_pos then state.stall_pos = vector() end
    local held    = state.stall_set and xmath.dist_flat_sqr(npc_pos, state.stall_pos) <= STALL_MOVE_SQR
    local closing = state.stall_dist and dist < state.stall_dist - STALL_CLOSE_M
    if not held or closing then
        state.stall_pos:set(npc_pos)
        state.stall_dist = dist
        state.stall_since = tg
        state.stall_set = true
        return false
    end
    return (tg - state.stall_since) >= STALL_MS
end

local function _check_too_close(npc, _enemy, state, _tg, memo)
    if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
    if xcombat.is_inside_minimum(state.dist, memo.kind) then return "too_close" end
    return nil
end

local function _check_reloading(_npc, _enemy, state, tg, _memo)
    if not state.reloading then return nil end
    if (tg - (state.reload_at or 0)) > RELOAD_STALE_MS then return nil end
    return "reloading"
end

local function _check_hurt(npc, enemy, state, _tg, memo)
    if memo.hurt == nil then memo.hurt = xcombat.get_health_frac(npc) < HURT_FRAC end
    if not memo.hurt then return nil end
    if memo.enemy_kind == nil then memo.enemy_kind = xcombat.get_weapon_kind(enemy) or "w_rifle" end
    if xcombat.is_inside_reach(state.dist, memo.enemy_kind) then return "hurt" end
    return nil
end

local function _check_stalled(npc, _enemy, state, tg, memo)
    if not _eval_stalled(state, tg, memo.npc_pos, state.dist) then return nil end
    if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
    local band = xcombat.get_weapon_range(memo.kind)
    if state.dist < band.min or state.dist > band.max then return nil end
    return "stalled"
end

local function _check_actor_close(npc, _enemy, state, _tg, memo)
    local ap = memo.actor_pos
    if ap == nil then
        if not db.actor then return nil end
        ap = db.actor:position()
        memo.actor_pos = ap
    end
    local np = memo.npc_pos
    local dx, dz = ap.x - np.x, ap.z - np.z
    local actor_dist_sqr = dx * dx + dz * dz
    if actor_dist_sqr > COUNTERFLANK_ACTOR_DIST_SQR then return nil end
    if state.dist * state.dist <= actor_dist_sqr then return nil end
    if memo.actor_enemy == nil then memo.actor_enemy = xcreature.is_enemy_to_actor(npc) end
    if not memo.actor_enemy then return nil end
    return "actor_close"
end

local function _palette_matches(row, npc, memo)
    if row.factions then
        if memo.faction == nil then memo.faction = xcreature.community(npc) end
        if not row.factions[memo.faction] then return false end
    end
    if row.weapons then
        if memo.kind == nil then memo.kind = xcombat.get_weapon_kind(npc) or "w_rifle" end
        if not row.weapons[memo.kind] then return false end
    end
    return true
end

local function _check_row(row, npc, enemy, state, tg, memo)
    if (row.vs_actor or false) == memo.actor_fight then return nil, nil, "scope" end
    if cfg[row.toggle] == false then return nil, nil, "off" end
    _seg:reset() _seg:start()
    local situation = row.check_need(npc, enemy, state, tg, memo)
    _seg:stop()
    local need_us = _seg:get_us()
    if not situation then return nil, nil, "-", need_us end
    if not _palette_matches(row, npc, memo) then return nil, situation, "palette", need_us end
    _seg:reset() _seg:start()
    local dest = row.find_destination(npc, enemy, state, tg, memo)
    _seg:stop()
    local dest_us = _seg:get_us()
    if dest then return dest, situation, "picked", need_us, dest_us end
    return nil, situation, "declined", need_us, dest_us
end

local function _reset_memo(state, npc, enemy)
    local memo = state.memo
    if not memo then memo = {} state.memo = memo end
    memo.faction, memo.kind, memo.enemy_kind, memo.hurt = nil, nil, nil, nil
    memo.actor_pos, memo.actor_enemy = nil, nil
    memo.actor_fight = state.enemy_id == AC_ID
    local np, ep = npc:position(), enemy:position()
    memo.npc_pos, memo.enemy_pos = np, ep
    local dx, dz = ep.x - np.x, ep.z - np.z
    state.dist = math_sqrt(dx * dx + dz * dz)
    return memo
end

local function _recheck_need(row, npc, enemy, state, tg)
    if not (row and npc and enemy and row.check_need) then return nil end
    local memo = _reset_memo(state, npc, enemy)
    return row.check_need(npc, enemy, state, tg, memo)
end

local function _row_trace(row, situation, stage, need_us, dest_us)
    local head = row.name .. ":" .. (situation and (situation .. "/" .. stage) or stage)
    if dest_us == nil then return head end
    return head .. "/need=" .. math_floor(need_us) .. "us/dest=" .. math_floor(dest_us) .. "us"
end

local function _check_repeat_limit(state, situation, npc_pos)
    if REPEAT_LIMIT <= 0 then return false end
    local stuck = state.repeat_situation == situation and state.repeat_pos ~= nil
        and xmath.dist_flat_sqr(npc_pos, state.repeat_pos) <= REPEAT_MOVE_SQR
    if stuck then
        state.repeat_count = state.repeat_count + 1
    else
        state.repeat_situation = situation
        state.repeat_count = 1
        state.repeat_pos = state.repeat_pos or vector()
    end
    state.repeat_pos:set(npc_pos)
    if state.repeat_count <= REPEAT_LIMIT then return false end
    at_debug.dbg("[CMB] repeat id=%s name=%s situation=%s picks=%d - takeover suspended until the world changes",
        show(state.id), show(state.name), show(situation), state.repeat_count or -1)
    return true
end

local function _resolve_maneuver(npc, enemy, state, tg)
    local count = #CATALOG
    if count == 0 then return nil end
    local start = state.row_cursor or 1
    if start > count then start = 1 end
    local memo = _reset_memo(state, npc, enemy)
    local tracing = at_debug.on()
    local walk_timer = xprofiler.new_if(tracing)
    _seg = xprofiler.new_if(tracing)
    walk_timer:start()
    local rows_trace = tracing and {} or nil
    local spent_row, spent_vid, spent_situation
    for i = 0, count - 1 do
        local idx = (start + i - 1) % count + 1
        local row = CATALOG[idx]
        local vid, situation, stage, need_us, dest_us = _check_row(row, npc, enemy, state, tg, memo)
        if tracing then rows_trace[#rows_trace + 1] = _row_trace(row, situation, stage, need_us, dest_us) end
        if dest_us ~= nil then
            state.row_cursor = idx % count + 1
            spent_row, spent_vid, spent_situation = row, vid, situation
            break
        end
    end
    walk_timer:stop()
    if tracing then
        state.rows = table_concat(rows_trace, ",")
        state.walk_us = math_floor(walk_timer:get_us())
    end
    if not spent_vid then return nil end
    if _check_repeat_limit(state, spent_situation, memo.npc_pos) then
        if state.cover_lvid then
            xcombat.release_cover(state.cover_lvid, state.id)
            state.cover_lvid = nil
        end
        return nil
    end
    state.trigger = spent_situation
    return spent_row, spent_vid
end

local function _release_cover(state)
    if state and state.cover_lvid then
        xcombat.release_cover(state.cover_lvid, state.id)
        state.cover_lvid = nil
    end
end

local function _drop_gate(state)
    if state and state.gate then
        _open_count = _open_count - 1
        if _open_count < 0 then _open_count = 0 end
        state.gate = false
    end
end

local function _get_state_mgr_target(id)
    local st = db.storage[id]
    local sm = st and st.state_mgr
    return sm and sm.target_state or nil
end

local function _dest_m(npc, dest)
    if not dest then return -1 end
    return npc:position():distance_to(level.vertex_position(dest))
end

local function _cleared_label(row, need_cleared)
    if row and row.need_recheck == false then return "-" end
    return flag(need_cleared)
end

local function _trace_end(state, tg, reason, check_us)
    local check = check_us or -1
    local row = state.maneuver
    local npc = xobject.go(state.id)
    local need_cleared
    if row and row.need_recheck ~= false and state.trigger and npc then
        local enemy = xcombat.resolve_enemy(state.enemy_id)
        if enemy then need_cleared = _recheck_need(row, npc, enemy, state, tg) == nil end
    end
    local vertex, dest_m = "gone", -1
    if npc then vertex, dest_m = npc:level_vertex_id(), _dest_m(npc, state.dest) end
    at_debug.dbg("[CMB] end id=%s name=%s maneuver=%s reason=%s dur=%dms shots=%d hits_actor=%d result=%s" ..
        " need_cleared=%s reenters=%d vertex=%s dest=%s dest_m=%.1f target=%s [%dus]",
        show(state.id), show(state.name), show(row and row.name), show(reason),
        math_floor(tg - (state.begin_at or tg)), _shots[state.id] or 0, _hits[state.id] or 0,
        show(state.result or "-"), _cleared_label(row, need_cleared), state.reenters or 0,
        show(vertex), show(state.dest), dest_m, show(_get_state_mgr_target(state.id)), check)
end

local function _end_maneuver(state, tg, reason, check_us)
    if at_debug.on() then _trace_end(state, tg, reason, check_us) end
    _shots[state.id] = nil
    _hits[state.id] = nil
    state.result = nil
    state.reenters, state.granted_at, state.released_at = nil, nil, nil
    state.target_seen, state.target_at, state.sent = nil, nil, nil
    state.escape_warned = nil
    state.sight_warned, state.sight_lost_count = nil, nil
    _drop_gate(state)
    state.maneuver = nil
    state.dest = nil
    state.trigger = nil
    state.maneuver_at = nil
    state.begin_at = nil
    state.stall_set = false
    state.pickoff_exit_sqr = nil
    _release_cover(state)
end

local function _trace_begin(npc, state, fire, gate, send_us, apply_us)
    if not at_debug.on() then return end
    local maneuver = state.maneuver
    local pos = npc:position()
    at_debug.dbg("[CMB] begin id=%s name=%s maneuver=%s trigger=%s dest=%s sent=%s fire=%s move=%s" ..
        " requested=%s fire_gate=%s cover=%s op=%s target=%s vertex=%s pos=%.1f,%.1f dest_m=%.1f [send=%dus apply=%dus]",
        show(state.id), show(state.name), show(maneuver.name), show(state.trigger), show(state.dest),
        show(state.sent), show(fire), show(maneuver.movement), show(maneuver.fire), show(gate), show(state.cover_trace),
        show(xcombat.get_operator(npc)), show(_get_state_mgr_target(state.id)), show(npc:level_vertex_id()),
        pos.x, pos.z, _dest_m(npc, state.sent or state.dest), send_us, apply_us)
    if state.sent == state.dest then return end
    at_debug.dbg("[CMB] dest_substituted id=%s maneuver=%s asked=%s got=%s own=%s",
        show(state.id), show(maneuver.name), show(state.dest), show(state.sent), show(npc:level_vertex_id()))
end

local function _trace_reenter(npc, state, maneuver, tg)
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] reenter id=%s maneuver=%s n=%d op=%s target=%s combat=%s vertex=%s dest=%s dest_m=%.1f" ..
        " since_begin=%dms since_apply=%dms away=%dms",
        show(state.id), show(maneuver.name), state.reenters,
        show(xcombat.get_operator(npc)), show(_get_state_mgr_target(state.id)),
        flag(db.storage[state.id] and db.storage[state.id].state_mgr and db.storage[state.id].state_mgr.combat or nil),
        show(npc:level_vertex_id()), show(state.dest), _dest_m(npc, state.sent or state.dest),
        math_floor(tg - (state.begin_at or tg)), math_floor(tg - state.maneuver_at),
        state.released_at and math_floor(tg - state.released_at) or -1)
end

local function _begin_maneuver(npc)
    local state = _npc_states[npc:id()]
    if not state or not state.maneuver then return end
    local tg = time_global()
    local maneuver = state.maneuver
    if state.maneuver_at then
        state.reenters = (state.reenters or 0) + 1
        _trace_reenter(npc, state, maneuver, tg)
    end
    state.granted_at = tg
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    if not enemy then _end_maneuver(state, tg, "target_lost") return end
    local timer_send = xprofiler.new_if(at_debug.on()):start()
    state.sent = xcombat.send_to(npc, state.dest)
    timer_send:stop()
    local timer_apply = xprofiler.new_if(at_debug.on()):start()
    local fire, gate = _apply_state(npc, maneuver, enemy)
    timer_apply:stop()
    state.maneuver_at = tg
    _shots[state.id] = nil
    _hits[state.id] = nil
    _trace_begin(npc, state, fire, gate, math_floor(timer_send:get_us()), math_floor(timer_apply:get_us()))
end

local function _on_shot_fired(obj)
    if not at_debug.on() or not obj then return end
    local id = obj:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _shots[id] = (_shots[id] or 0) + 1
    end
end

local function _on_actor_hit(_, amount, _, who)
    if not at_debug.on() or not who then return end
    if not amount or amount <= 0 then return end
    local id = who:id()
    local state = _npc_states[id]
    if state and state.maneuver then
        _hits[id] = (_hits[id] or 0) + 1
    end
end

local function _on_enemy_downed(npc, victim)
    if not at_debug.on() or not (npc and victim) then return end
    local state = _npc_states[npc:id()]
    if not (state and state.maneuver) then return end
    if victim:id() ~= state.enemy_id then return end
    state.result = victim:alive() and "wounded" or "killed"
end

local function _on_release(npc)
    local state = _npc_states[npc:id()]
    if not (state and state.maneuver_at) then return end
    local tg = time_global()
    state.released_at = tg
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] release id=%s maneuver=%s held=%dms op=%s target=%s vertex=%s",
        show(state.id), show(state.maneuver and state.maneuver.name),
        math_floor(tg - (state.granted_at or tg)),
        show(xcombat.get_operator(npc)), show(_get_state_mgr_target(state.id)), show(npc:level_vertex_id()))
end

local SPEC = {
    gate = function(npc)
        if not cfg.combat_enabled then return false end
        local state = _npc_states[npc:id()]
        return state ~= nil and state.gate == true
    end,
    on_begin = _begin_maneuver,
    on_release = _on_release,
}

local function _trace_decision(npc, state, enemy, result)
    if not at_debug.on() then return end
    local enemy_pos = enemy:position()
    state.enemy_name = xcreature.get_name(enemy:id())
    state.operator   = xcombat.get_operator(npc)
    state.aim_off    = math_floor(xcombat.get_facing_offset(npc, enemy_pos))
    state.seen       = xcombat.sees(npc, enemy)
    local in_cover, looked_out, held = xcombat.get_cover_state(npc)
    local blocked = xcombat.has_obstacle_to_target(enemy_pos, npc:position(), xcombat.BODY_Y.STAND_EYE)
    state.cover_trace = flag(in_cover) .. flag(looked_out) .. flag(held) .. "/" .. (blocked and "y" or "n")
    at_debug.dbg("[CMB] monitor id=%s name=%s target=%s(%s) distance=%.1f seen=%s aim=%ddeg operator=%s cover=%s rows=%s walk=%dus check=%dus result=%s",
        show(state.id), show(state.name), show(state.enemy_id), show(state.enemy_name), state.dist or -1,
        state.seen and "yes" or "no", state.aim_off or -1, show(state.operator), show(state.cover_trace),
        show(state.rows), state.walk_us or -1, state.check_us or -1, result or "none")
end

local function _trace_monitor_skip(state, result, detail, us)
    if not at_debug.on() then return end
    at_debug.dbg("[CMB] monitor id=%s name=%s target=%s result=%s%s [%dus]",
        show(state.id), show(state.name), show(state.enemy_id), result,
        detail and (":" .. detail) or "", us or -1)
end

local function _seize_blocked(npc, state)
    local can_seize, seize_block = _can_seize(npc, state)
    if not can_seize then return "cannot_seize", seize_block end
    if MAX_CONCURRENT > 0 and _open_count >= MAX_CONCURRENT then return "at_cap" end
    return nil
end

local function _try_begin_maneuver(npc, state, tg)
    if not _manages(npc) then state.fighting = false return end
    local timer = xprofiler.new_if(at_debug.on()):start()

    local enemy = xcombat.get_best_enemy(npc)
    state.fighting = _is_fighting(enemy, state, tg)
    if not state.fighting then state.stall_set = false state.row_cursor = 1 state.repeat_situation = nil return end
    if at_debug.on() then state.name = npc:name() end

    if not enemy then
        state.enemy_id = nil
        timer:stop()
        _trace_monitor_skip(state, "no_enemy", nil, timer:get_us())
        return
    end
    state.enemy_id = enemy:id()

    local blocked, block_detail = _seize_blocked(npc, state)
    if blocked then
        timer:stop()
        _trace_monitor_skip(state, blocked, block_detail, timer:get_us())
        return
    end

    local maneuver, dest = _resolve_maneuver(npc, enemy, state, tg)
    if maneuver then
        xcombat.topup_takeover_block(npc)
        state.gate = true
        _open_count = _open_count + 1
        state.maneuver = maneuver
        state.dest = dest
        state.maneuver_at = nil
        state.begin_at = tg
    end
    timer:stop()
    if at_debug.on() then state.check_us = math_floor(timer:get_us()) end
    _trace_decision(npc, state, enemy, maneuver and maneuver.name)
    if maneuver and maneuver.vs_actor then state.enemy_id = AC_ID end
end

local function _check_sight_lost(state, maneuver, sight_id)
    if state.sight_warned then return end
    if maneuver.fire ~= xcombat.FIRE and maneuver.fire ~= xcombat.SNIPE then return end
    if sight_id == nil or sight_id == state.enemy_id then
        state.sight_lost_count = nil
        return
    end
    state.sight_lost_count = (state.sight_lost_count or 0) + 1
    if state.sight_lost_count < 3 then return end
    state.sight_warned = true
    at_debug.warn("[CMB] sight_lost id=%d maneuver=%s staged=%d sight=%d - committed-target sight lost (f015 regression)",
        state.id, maneuver.name, state.enemy_id, sight_id)
end

local function _update_maneuver(npc, state, tg)
    local maneuver = state.maneuver
    if not maneuver or not state.maneuver_at then return end
    if not state.escape_warned and not xcombat.is_takeover_current(npc)
        and not (IsWounded(npc) or xcombat.is_staggering(npc)) then
        state.escape_warned = true
        at_debug.warn("[CMB] escape id=%d maneuver=%s op=%s - an unblocked action holds the slot under an open maneuver (denylist gap, t148)",
            state.id, maneuver.name, xcombat.get_operator(npc))
    end
    if not maneuver.update then return end
    if xcombat.is_reloading(npc) then return end
    local busy, busy_why = xcombat.is_body_busy(npc)
    if busy then
        at_debug.dbg("[CMB] pause id=%s maneuver=%s why=%s", show(state.id), show(maneuver.name), show(busy_why))
        return
    end
    local enemy = xcombat.resolve_enemy(state.enemy_id)
    local sight_id, sight_mode
    if at_debug.on() then
        sight_id, sight_mode = xcombat.get_sight_target(npc)
        if enemy then _check_sight_lost(state, maneuver, sight_id) end
    end
    local timer = xprofiler.new_if(at_debug.on()):start()
    local fire, gate = maneuver.update(npc, maneuver, enemy)
    timer:stop()
    if not at_debug.on() then return end
    local us = math_floor(timer:get_us())
    if not enemy then
        at_debug.dbg("[CMB] update id=%s name=%s maneuver=%s target=nil fire=%s fire_gate=%s [%dus]",
            show(state.id), show(state.name), show(maneuver.name), show(fire), show(gate), us)
        return
    end
    local pos = npc:position()
    local target = _get_state_mgr_target(state.id)
    local sight_label = sight_id and (sight_id == state.enemy_id and "target" or tostring(sight_id)) or "-"
    if target ~= state.target_seen then
        at_debug.dbg("[CMB] target_change id=%s maneuver=%s from=%s to=%s op=%s held=%dms",
            show(state.id), show(maneuver.name), show(state.target_seen), show(target),
            show(xcombat.get_operator(npc)), math_floor(tg - (state.target_at or tg)))
        state.target_seen, state.target_at = target, tg
    end
    at_debug.dbg("[CMB] update id=%s name=%s maneuver=%s target=%s(%s) seen=%s aim=%ddeg sight=%s stype=%s"
        .. " fire=%s fire_gate=%s op=%s target=%s mt=%s vertex=%s pos=%.1f,%.1f dest_m=%.1f reenters=%d [%dus]",
        show(state.id), show(state.name), show(maneuver.name), show(enemy:id()), show(xcreature.get_name(enemy:id())),
        xcombat.sees(npc, enemy) and "yes" or "no", math_floor(xcombat.get_facing_offset(npc, enemy:position())),
        sight_label, show(sight_mode),
        show(fire), show(gate), show(xcombat.get_operator(npc)), show(target),
        show(npc:movement_type()), show(npc:level_vertex_id()), pos.x, pos.z,
        _dest_m(npc, state.sent or state.dest), state.reenters or 0, us)
end

local function _end_reason(npc, enemy, state, tg)
    if IsWounded(npc) then return "wounded" end
    local maneuver = state.maneuver
    local begun = maneuver ~= nil and state.maneuver_at ~= nil
    local broken = begun and maneuver.check_end and maneuver.check_end(npc, enemy, state, tg)
    if broken then return broken end
    if begun and maneuver.ends_on == "arrival" and xcombat.is_arrived(npc) then return "arrived" end
    if (tg - (state.begin_at or tg)) >= ((maneuver and maneuver.timeout) or MANEUVER_CAP_MS) then return "cap" end
    return nil
end

local function _try_end_maneuver(npc, state, tg)
    if not _manages(npc) then _end_maneuver(state, tg, "disabled") return end
    local enemy
    if state.maneuver and state.maneuver_at then
        enemy = xcombat.resolve_enemy(state.enemy_id)
        if not enemy then
            _end_maneuver(state, tg, "target_lost")
            return
        end
    end
    local timer = xprofiler.new_if(at_debug.on()):start()
    local reason = _end_reason(npc, enemy, state, tg)
    timer:stop()
    if reason then _end_maneuver(state, tg, reason, math_floor(timer:get_us())) end
end

local function _check_hold(npc)
    if xcombat.is_staggering(npc) then return true, "stagger" end
    if xcombat.is_flinching(npc) and npc:movement_type() == move.stand then return true, "flinch" end
    return false
end

local function _apply_hold(npc, state, hold, why)
    if (state.move_hold or false) == hold then return end
    if not xcombat.set_movement_hold(npc, hold) then return end
    state.move_hold = hold or nil
    if at_debug.on() then
        at_debug.dbg("[CMB] hold id=%s on=%s why=%s", show(state.id), flag(hold), show(why))
    end
end

local function _update_hold(npc, state, tg)
    if not cfg.combat_hit_hold then
        if state.move_hold then _apply_hold(npc, state, false, "disabled") end
        return
    end
    if not state.move_hold and not _has_recent_hit(state, tg, HOLD_WINDOW_MS) then return end
    local hold, why = _check_hold(npc)
    _apply_hold(npc, state, hold, why or "released")
end

local function _build_checks()
    CHECKS = {
        { name = "begin_maneuver",  period = BEGIN_PERIOD_MS,  open = false, run = _try_begin_maneuver },
        { name = "update_maneuver", period = UPDATE_PERIOD_MS, open = true,  run = _update_maneuver    },
        { name = "end_maneuver",    period = END_PERIOD_MS,    open = true,  run = _try_end_maneuver   },
    }
end

local function _run_check(check, npc, state, tg)
    if tg - (state.ran_at[check.name] or 0) < check.period then return end
    state.ran_at[check.name] = tg
    check.run(npc, state, tg)
end

local function _record_pass(ms, tg)
    if _mon.last == 0 then _mon.last = tg end
    _mon.ms = _mon.ms + ms
    if ms > _mon.max then _mon.max = ms end
    _mon.ticks = _mon.ticks + 1
    if tg - _mon.last >= MON_FLUSH_MS then
        at_debug.dbg("[MON] window=%.0fs ticks=%d tick_avg=%.3fms tick_max=%.3fms",
            (tg - _mon.last) / 1000, _mon.ticks, _mon.ms / _mon.ticks, _mon.max)
        _mon.ms, _mon.max, _mon.ticks, _mon.last = 0, 0, 0, tg
    end
end

local function _run_npc_checks(npc, state, tg)
    if not npc:alive() then
        if state.move_hold then _apply_hold(npc, state, false, "died") end
        at_behaviors.clear_npc(npc, state, "died", tg)
        if state.maneuver then _end_maneuver(state, tg, "died") end
        _drop_gate(state)
        _release_cover(state)
        return
    end
    _update_hold(npc, state, tg)
    at_behaviors.update_npc(npc, state, tg)
    local open = state.gate == true
    for i = 1, #CHECKS do
        local check = CHECKS[i]
        if check.open == open then _run_check(check, npc, state, tg) end
    end
end

local function _run_monitor()
    if not _monitor_active then return true end
    ResetTimeEvent("at_maneuvers", "monitor", MONITOR_PERIOD_SEC)
    local tg = time_global()
    local timer = xprofiler.new_if(at_debug.on()):start()
    at_behaviors.update_window(tg)
    for id, state in pairs(_npc_states) do
        local npc = xobject.go(id)
        if npc then _run_npc_checks(npc, state, tg) end
    end
    timer:stop()
    if at_debug.on() then _record_pass(timer:get_ms(), tg) end
end

local function _start_monitor()
    if _monitor_active then return end
    _monitor_active = true
    RemoveTimeEvent("at_maneuvers", "monitor")
    CreateTimeEvent("at_maneuvers", "monitor", MONITOR_PERIOD_SEC, _run_monitor)
end

local function _stop_monitor()
    _monitor_active = false
    RemoveTimeEvent("at_maneuvers", "monitor")
end

local function _install(npc)
    if not npc or not IsStalker(npc) then return end
    if cfg.combat_ignore_companions and npc:has_info(COMPANION_INFO) then return end
    local id = npc:id()
    if _npc_states[id] then return end
    _npc_states[id] = { id = id, ran_at = {} }
    xcombat.install_takeover(npc, SPEC)
    if at_debug.on() then at_debug.dbg("[CMB] installed id=%d name=%s", id, npc:name()) end
end

local function _on_hit(npc, amount)
    if not npc or not amount or amount <= 0 then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    state.hit_at = time_global()
    if cfg.combat_enabled and cfg.combat_hit_hold then
        local hold, why = _check_hold(npc)
        if not hold and npc:movement_type() == move.stand then hold, why = true, "hit" end
        if hold then _apply_hold(npc, state, true, why) end
    end
end

local function _on_reload_start(npc, wpn)
    if not npc then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    state.reloading = true
    state.reload_at = time_global()
    if at_debug.on() then
        at_debug.dbg("[RELOAD] start id=%d wpn=%s mag_left=%d fighting=%s", state.id,
            wpn and wpn:section() or "?", wpn and wpn:get_ammo_in_magazine() or -1,
            npc:best_enemy() and "yes" or "no")
    end
end

local function _on_reload_stop(npc)
    if not npc then return end
    local state = _npc_states[npc:id()]
    if not state then return end
    if at_debug.on() then
        at_debug.dbg("[RELOAD] stop id=%d held=%dms", npc:id(),
            state.reload_at and (time_global() - state.reload_at) or -1)
    end
    state.reloading = nil
end

local function _on_net_destroy(npc)
    if not npc then return end
    local id = npc:id()
    local state = _npc_states[id]
    if state and state.move_hold then _apply_hold(npc, state, false, "destroy") end
    if state then at_behaviors.clear_npc(npc, state, "destroy", time_global()) end
    xcombat.release_takeover(npc)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
    _shots[id] = nil
    _hits[id] = nil
end

local function _on_entity_unregister(se_obj)
    if not se_obj then return end
    local id = se_obj.id
    local state = _npc_states[id]
    if state and state.move_hold then
        local npc = xobject.go(id)
        if npc then _apply_hold(npc, state, false, "unregister") else state.move_hold = nil end
    end
    if state then
        local npc = xobject.go(id)
        at_behaviors.clear_npc(npc, state, "unregister", time_global())
    end
    xcombat.release_takeover_id(id)
    _drop_gate(_npc_states[id])
    _release_cover(_npc_states[id])
    _npc_states[id] = nil
    _shots[id] = nil
    _hits[id] = nil
end

local function _load_config()
    local ini = ini_file(LTX_PATH)
    local function read_int(k, d) local v = ini:r_float_ex(LTX_SECTION, k) return v and math_floor(v) or d end
    local function read_float(k, d) return ini:r_float_ex(LTX_SECTION, k) or d end
    BEGIN_PERIOD_MS     = read_int("begin_period_ms",     600)
    UPDATE_PERIOD_MS    = read_int("update_period_ms",    200)
    END_PERIOD_MS       = read_int("end_period_ms",       200)
    HIT_FIGHT_MS        = read_int("hit_fight_ms",        5000)
    MAX_CONCURRENT      = read_int("max_concurrent_maneuvers", 20)
    HURT_FRAC      = read_float("hurt_frac",     0.40)
    STALL_MS       = read_int("stall_ms",        4000)
    local move_m   = read_float("stall_move_m",  2)
    STALL_MOVE_SQR = move_m * move_m
    STALL_CLOSE_M  = read_float("stall_close_m", 2)
    KITE_ARC_DEG    = read_int("kite_arc_deg",    45)
    KITE_SPREAD_DEG = read_int("kite_spread_deg", 90)
    RETREAT_REAR_M  = read_float("retreat_rear_m", 8)
    UNDER_FIRE_MS   = read_int("under_fire_ms",   2000)
    FLEE_MIN_DIST_M      = read_int("flee_min_dist_m",      5)
    FLEE_BASE_MIN_DIST_M = read_int("flee_base_min_dist_m", 100)
    local counterflank_dist_m    = read_float("counterflank_actor_dist_m",  5)
    COUNTERFLANK_ACTOR_DIST_SQR  = counterflank_dist_m * counterflank_dist_m
    PICKOFF_TARGETED_DEG = read_float("pickoff_targeted_deg", 10)
    PICKOFF_ENTER_FACTOR = read_float("pickoff_enter_factor", 1.2)
    RELOAD_COVER_CONE_DEG = read_float("reload_cover_cone_deg", 60)
    REPEAT_LIMIT        = read_int("repeat_limit", 3)
    RELOAD_STALE_MS      = read_int("reload_stale_ms", 6000)
    KITE_DISTANCE_M = { w_melee = 4, w_shotgun = 4, w_pistol = 5, w_smg = 6, w_rifle = 8, w_sniper = 15, w_explosive = 8 }
    for i = 1, #KITE_KINDS do
        local v = ini:r_float_ex(LTX_SECTION, "kite_distance_m_" .. KITE_KINDS[i])
        if v then KITE_DISTANCE_M[KITE_KINDS[i]] = v end
    end
    for i = 1, #QUEUE_KINDS do
        local kind = QUEUE_KINDS[i]
        local min_s, max_s, min_i, max_i = xcombat.get_fire_queue(kind, "medium")
        local band = { min_s, max_s, min_i, max_i }
        local raw = ini:r_string_ex(LTX_SECTION, "queue_" .. kind)
        local o_size, o_interval = string_match(raw or "", "^%s*(%d+)%s*,%s*(%d+)")
        if o_size then
            local s, iv = tonumber(o_size), tonumber(o_interval)
            band = { s, s, iv, iv }
        end
        _queue_band_by_kind[kind] = band
    end
    _pickoff_band = { 1, 1,
        read_int("pickoff_interval_min_ms", 1500),
        read_int("pickoff_interval_max_ms", 2000) }
    CATALOG = at_maneuvers_config.get_catalog({
        check_actor_close      = _check_actor_close,
        check_reloading        = _check_reloading,
        check_hurt             = _check_hurt,
        check_too_close        = _check_too_close,
        check_stalled          = _check_stalled,
        find_counterflank_spot = _find_counterflank_spot,
        find_reload_cover      = _find_reload_cover,
        find_flee_base         = _find_flee_base,
        find_retreat_cover     = _find_retreat_cover,
        find_kite_lane         = _find_kite_lane,
        find_pickoff_spot      = _find_pickoff_spot,
        check_end_reload_cover = _check_end_reload_cover,
        check_end_pickoff      = _check_end_pickoff,
        apply_state            = _apply_state,
    }, read_int)
    _build_checks()
end

local function _disable_combat_state(state, tg)
    if state.maneuver then _end_maneuver(state, tg, "disabled") end
    if not state.move_hold then return end
    local npc = xobject.go(state.id)
    if npc then _apply_hold(npc, state, false, "disabled") else state.move_hold = nil end
end

local function _apply_enabled()
    local tg = time_global()
    at_behaviors.apply_enabled(tg)
    if not (cfg.push_enabled and cfg.pull_enabled) then
        for _, state in pairs(_npc_states) do
            at_behaviors.apply_enabled_npc(xobject.go(state.id), state, tg)
        end
    end
    if not cfg.combat_enabled then
        for _, state in pairs(_npc_states) do _disable_combat_state(state, tg) end
    end
    if cfg.combat_enabled or cfg.push_enabled or cfg.pull_enabled then
        _start_monitor()
    else
        _stop_monitor()
    end
end

local function _on_option_change()
    at_debug.refresh()
    _apply_enabled()
end

local function _on_first_update()
    _open_count = 0
    at_debug.refresh()
    _apply_enabled()
    at_debug.info("Maneuvers monitor initialized (enabled=%s dbg=%s cap=%d queue_patch=%s push=%s band=%s)",
        tostring(cfg.combat_enabled), tostring(at_debug.on()), MAX_CONCURRENT,
        _orig_get_queue_params and "installed" or "missing",
        tostring(cfg.push_enabled), at_conduct.is_spacing_active() and "active" or "INACTIVE")
end

--- Current maneuver name for an NPC, or nil when AT is not driving one
function get_maneuver(id)
    local state = _npc_states[id]
    return state and state.maneuver and state.maneuver.name
end

--- The per-NPC state record for id, or nil when AT does not track it (at_behaviors and the HUD read it)
function get_state(id)
    return _npc_states[id]
end

--- True when a hit landed on this NPC within window_ms (the state.hit_at stamp; window is caller policy)
function has_recent_hit(state, tg, window_ms)
    return _has_recent_hit(state, tg, window_ms)
end

function on_game_start()
    _load_config()
    if not _orig_get_queue_params and state_mgr_weapon and state_mgr_weapon.get_queue_params then
        _orig_get_queue_params = state_mgr_weapon.get_queue_params
        state_mgr_weapon.get_queue_params = _patched_get_queue_params
    end
    if state_mgr and state_mgr.combat_action_ids and xcombat.TAKEOVER_ID then
        state_mgr.combat_action_ids[xcombat.TAKEOVER_ID] = true
    end
    RegisterScriptCallback("npc_on_net_spawn",            _install)
    RegisterScriptCallback("npc_on_hit_callback",         _on_hit)
    RegisterScriptCallback("npc_shot_dispersion",         _on_shot_fired)
    RegisterScriptCallback("actor_on_hit_callback",       _on_actor_hit)
    RegisterScriptCallback("npc_on_enemy_wounded_or_killed", _on_enemy_downed)
    RegisterScriptCallback("npc_on_net_destroy",          _on_net_destroy)
    RegisterScriptCallback("server_entity_on_unregister", _on_entity_unregister)
    RegisterScriptCallback("actor_on_first_update",       _on_first_update)
    RegisterScriptCallback("on_option_change",            _on_option_change)
    RegisterScriptCallback("mcm_option_restore_default",  _on_option_change)
    if not (xcombat.on_reload_start(_on_reload_start) and xcombat.on_reload_stop(_on_reload_stop)) then
        at_debug.info("Reload Cover INACTIVE: exe lacks the NPC reload events (PR #611); row inert")
    end
end

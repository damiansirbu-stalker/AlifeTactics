; AlifeTactics mutants - the innate numbers: species envelopes, tempo bands, wild envelopes, premise rows.
; MCM owns the formula sliders and the per-species move toggles; nothing here is user-facing.
; Every band is BOUNDED (the performance law): variation never leaves a field-sane envelope.

[pages] ; species -> MCM page; a subclass folds into its base page
chimera     = chimera
lurker      = chimera
bloodsucker = bloodsucker
psysucker   = bloodsucker
burer       = burer
dog         = dog
boar        = boar
snork       = snork
pseudodog   = pseudodog
psy_dog     = pseudodog
gigant      = gigant
cat         = cat
flesh       = flesh
fracture    = fracture
karlik      = karlik
tushkano    = tushkano

[moves] ; per-move species envelope: a species either has a move or not (anatomy; engine components, flee = the shared-attack-tree species the proposal reaches)
pounce     = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
lunge      = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
rush       = bloodsucker, psysucker, boar, gigant
dodge      = bloodsucker, psysucker, dog, pseudodog, psy_dog, boar, gigant
flee       = bloodsucker, psysucker, dog, boar, snork, pseudodog, psy_dog, gigant, cat, flesh, fracture, karlik, tushkano
cloak      = bloodsucker, psysucker
gravity    = burer
claw       = chimera, lurker
backstrike = chimera, lurker
roar       = snork, gigant

[intelligence]
cap = 0.75

[tempo] ; per-spawn rolls, ms
pounce_cd_min  = 4000
pounce_cd_max  = 9000
claw_cd_min    = 1400
claw_cd_max    = 2800
dodge_cd_min   = 6000
dodge_cd_max   = 12000
flee_cd_min    = 30000
flee_cd_max    = 60000
flee_hold_min  = 4000
flee_hold_max  = 7000
stare_min      = 2000
stare_max      = 4000
gravity_cd_min = 9000
gravity_cd_max = 16000
roar_cd_min    = 15000
roar_cd_max    = 30000

[fleeing] ; the enemy-fleeing read: receding per 200ms tick with the back turned
recede_m = 0.3
cone_deg = 90

[survival] ; crossing below this health fraction rolls one long run-away window
health_frac = 0.30
hold_min    = 8000
hold_max    = 15000

[threat] ; an enemy weapon aimed within this cone counts as facing the mutant (the shotgun, charge, and dodge gates read it)
facing_cone_deg = 60

[pounce]
band_min_m      = 5
band_max_m      = 11
facing_cone_deg = 35

[dodge] ; the stare-break juke: the enemy aiming inside this range opens a dodge roll
range_m = 10

[aim] ; the homing-leap share: a fired jump steers mid-air on an Intelligence x Wild x share roll; the gain band sits inside the vanilla envelope (borya 0.3, cat 0.6)
share      = 0.25
factor_min = 0.2
factor_max = 0.5

[roar] ; the threat display on a fresh enemy at range, once per engagement
range_min_m = 3
range_max_m = 15

[gravity] ; the burer stare trigger premise
range_m    = 40
cone_deg   = 12
release_ms = 1000

[claw] ; the chimera-class contact strike (covers the lurker: same engine class and anim table)
motion   = jump_attack_0
range_m  = 2.2
clear_ms = 1100

[backstrike] ; per-species motion pair for the rear spin-strike; motions must carry attack_params rows
arc_deg = 120
chimera = jump_attack_0, jump_attack_1
lurker  = jump_attack_0, jump_attack_1

[wild] ; bounded value variation as a fraction of the install's own loaded value
attack_dist_pct = 0.15
jump_band_pct   = 0.15
circle_pct      = 0.20
rush_band_pct   = 0.20
window_pct      = 0.20
ability_pct     = 0.20
turn_min        = 0.90
turn_max        = 1.25

[cloak] ; bloodsucker visibility-transition dwell band, ms
delay_min_ms = 700
delay_max_ms = 2400

[controller] ; the psi tube pacing stays inside a SLOW envelope
tube_delay_min_ms = 5000
tube_delay_max_ms = 9000
see_min_ms        = 800
see_max_ms        = 2000

[poltergeist] ; hover-height band rolled per spawn, metres
height_min_low  = 0.4
height_min_high = 1.2
height_max_low  = 1.6
height_max_high = 3.0

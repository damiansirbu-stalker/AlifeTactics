[personality_backstrike] ; the rear spin-strike; chimera and lurker more often than burer and controller
default    = 1.0
chimera    = 0.7
lurker     = 0.7
burer      = 0.5
controller = 0.5

[personality_cloak] ; the bloodsucker decided vanish; the bloodsucker rules cloak, the psy variant leans on it less
default     = 0
bloodsucker = 1.0
psysucker   = 0.6

[personality_gravity_attack] ; the burer forced gravi throw (the vulnerable/back-turn punish)

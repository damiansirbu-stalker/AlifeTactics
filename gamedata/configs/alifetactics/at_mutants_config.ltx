; AlifeTactics mutants - the innate numbers: species envelopes, the decision clocks, wild envelopes, premise rows.
; MCM owns the formula sliders and the per-species move toggles; nothing here is user-facing.
; Every band is BOUNDED (the performance law): variation never leaves a field-sane envelope.

[pages] ; species -> MCM page; a subclass folds into its base page
chimera     = chimera
lurker      = chimera
bloodsucker = bloodsucker
psysucker   = bloodsucker
burer       = burer
controller  = controller
poltergeist = poltergeist
dog         = dog
boar        = boar
snork       = snork
pseudodog   = pseudodog
psy_dog     = pseudodog
gigant      = gigant
cat         = cat
flesh       = flesh
fracture    = fracture
karlik      = karlik
tushkano    = tushkano

[moves] ; per-move species envelope: a species either has a move or not (anatomy; engine components, flee = the shared-attack-tree species the proposal reaches)
; Every leaping species except the bloodsucker and psysucker can take each of the six shared leaps; the [personality_*] roll, once per individual, decides which it carries.
high_leap      = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
punishing_leap = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
hunting_leap   = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
feral_leap     = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
catching_leap  = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
cutoff_leap    = chimera, lurker, cat, dog, snork, pseudodog, psy_dog
closing_leap   = bloodsucker, psysucker ; their jump never loads its config, so it never hits in the air (bloodsucker.cpp:77,87)
flee           = dog, boar, snork, pseudodog, psy_dog, gigant, cat, flesh, fracture, karlik, tushkano ; not the suckers: their state manager applies a proposal one level above the attack substates (bloodsucker_state_manager.cpp:107-110), so RunAway is never reached
cloak          = bloodsucker, psysucker
gravity_attack = burer
claw           = chimera, lurker
backstrike     = chimera, lurker, burer, controller

[select] ; the walk checks the conditions of up to this many shuffled candidates per beat; the first that fires wins and breaks (the budget - "max 3 checks", user 2026-10-27)
; Repertoire, page toggle and cooldown filter BEFORE the shuffle and never spend a slot (user ruling 2026-11-15).
candidates = 3

[cooldown] ; per-mutant re-fire gaps in ms, one row per key; a leap waits on its own row AND the shared leap row; a key with no row never cools down
leap           = 10000  ; between any two of our leaps: the instant ones home on the player, so two in a row cannot be dodged (user ruling); the game's own telegraphed jumps stay outside. A per-species key was tried and removed 2026-11-15: one leap per 10s for a whole pack was far too easy.
high_leap      = 20000  ; before the same leap again (user ruling: 10s between two of our leaps, 20s before the same one)
punishing_leap = 20000
hunting_leap   = 20000
feral_leap     = 20000
catching_leap  = 20000
cutoff_leap    = 20000
closing_leap   = 20000
claw           = 2000   ; stamped on every claw roll, fired or not (user ruling)
backstrike     = 10000  ; between two arms of the rear strike (user 2026-11-17): armed, the engine strikes every 0.5-1 s on its own (control_melee_jump.cpp:7-8), the Jupiter chimera blender
flee           = 120000 ; a routed mutant does not re-rout as soon as its committed window closes
cloak          = 5000   ; re-cloak gap, so it cannot flicker-spam
gravity_attack = 8000   ; a little over one throw-and-release cycle; the engine's own throws stamp it too, so ours never chains onto one

[caps] ; max driven moves assumed running at once per bucket; a start counts starts_s seconds
starts_s  = 3
vs_player = 3
vs_npc    = 3

[intelligence]
cap = 0.75

[premises] ; the reads the move handlers share through the pass memo
above_m    = 0.8      ; object-position height delta that counts as the enemy being elevated (the game's own dog standard, dog.cpp:410-422) - the High leap and Closing leap perch trigger
perch_gap_m = 1.0     ; the enemy off the navmesh by more than this also counts as perched: a low rock a sucker cannot reach read 0.5-0.7m above it (field 2026-11-16)

[leap] ; the numbers every leap shares; the force is rolled once per mutant at adoption
basis           = 2.0  ; the force basis for a species with no jump_factor (the bloodsucker's jump config never loads); every leaper ships 2.0
force_min_mult  = 1.0  ; every leap flies at basis x [min, max] spread by Wild, so 2.0-3.0 and 2.5 with Wild off (the field-tested 10-01 probe band, narrowed by the user)
force_max_mult  = 1.5
sense_ms        = 1000 ; a leap needs the mutant to have sensed its enemy this recently (its enemy memory): one 600ms beat plus vision-update slack
min_m           = 3    ; no leap but a perch leap inside this: field 2026-11-15, every leap at 0.6-2.2 m stranded or flew through the player in 0.2s, every one from 2.7 m landed clean; claw owns point-blank
stuck_margin_ms = 1000 ; a jump still holding the body past its flight time plus this is logged as stuck, the freeze check

[lead] ; the Catching and Cutoff leap lead over the enemy's current velocity: Intelligence scales it, capped at a full intercept; it counts the flight only, so a Catching leap lands short of a fast runner by its crouch (m35)
floor_mult    = 0.5  ; the lead gain at zero Intelligence, as a fraction of a full intercept (CANDIDATE, field-tune)
max_m         = 1.0  ; the lead offset cap: with no steering a leap hits only within about 1m of its aim point
navmesh_gap_m = 2.5  ; a lead point farther than this above its floor counts as off the navmesh and falls back to the unled point

[motion] ; the enemy motion read, one sample per 600ms beat
move_min_m = 0.5 ; moving: the enemy covered more than this since the last beat, in any direction - the premise of all four moving-enemy leaps
; A steady-direction read (two beats, a turn under 30 deg) gated Catching and Cutoff until 2026-11-15: it passed 1 in 1869 checks against a player, so Personality alone tells the four apart (user ruling).

[closing_leap] ; the bloodsucker gap-closer
aim_max_m  = 15  ; the aim case ends here, the chimera's own jump reach (m_chimera.ltx:137); was the 9-10 m draw radius, too tight in the field (user 2026-11-15); a perch fires at any distance
aim_min_m  = 4.5 ; the aim case starts outside the bloodsucker's own charge band (Run_Attack_Dist 3.5-4.5, m_bloodsucker.ltx:146)

[survival] ; the flee trigger: health below this fraction while far enough to disengage and not nose-on to the enemy
health_frac   = 0.40 ; was 0.30: at 0.30 a hurt mutant died before it could turn (field 2026-11-15, 0 flees in 12 boars), user ruling 0.40
min_dist_m    = 10 ; the actor must be at least this far to flee - inside bite range the mutant stays in the fight (was 20, never met in melee, user ruling 10)
face_cone_deg = 60 ; skip the flee while the enemy sits within this cone of the mutant's nose - no 180 turn-and-die, a tangent or already-turned mutant flees
hold_min      = 45000
hold_max      = 75000

[threat] ; the two facing reads: the wide watch (gravity's "not shooting me" gate) and the tight aim (the Punishing leap and Closing leap read)
facing_cone_deg = 60 ; watching: the enemy roughly faces the mutant - gravity skips a facing player so it never steals the burer's shield
aim_cone_deg    = 15 ; aiming: the enemy holds the crosshair ON the mutant - the Punishing leap and Closing leap aim trigger (field-tune)

; The leap fire gate (restrictor, distance band, angle, height) is the engine can_jump, mirrored in xmonster.try_monster_jump until the jump PR (n070) ships; the handler believes the return.

[adapt] ; the Hunting and Feral leap air-steering gain band = the vanilla envelope (borya 0.3, pseudodog 0.5, cat 0.6)
factor_min = 0.3
factor_max = 0.6

[gravity_attack] ; the burer forced gravi throw, shield-safe: the trigger (vulnerable or back-turned) only fires when the player is not shooting, so no shield is wanted
face_cone_deg = 45 ; the engine gravi facing gate (is_face_target deg(45), burer_state_attack_gravi_inline.h:87); the range band is the burer's own Gravi_MinDist/MaxDist, the LOS its own see
release_ms    = 2500 ; hold the forced-gravi flag and skip re-deciding this long (one gravi cycle), then clear the flag; the engine consumes it on entry, this bounds a missed consume

[claw] ; the chimera-class point-blank pounce with no wind-up, checked on every monster update (covers the lurker: same engine class)
range_m         = 1.8  ; inside the 2m jump hit window (jump_hit_trace_range, m_chimera.ltx:134), with a margin
near_m          = 10   ; the last beat's distance under which the contact lane reads live positions: the reach plus 12 m/s closing over one 600ms beat
facing_cone_deg = 30   ; inside the jump's own angle limit (jump_max_angle 0.55 rad, m_chimera.ltx:138) and its +/-30 deg hit cone

[cloak] ; the bloodsucker decided cloak: vanish reactively while closing, then re-appear when the window ends (forces the vanilla visibility state)
melee_m     = 3     ; no cloak inside this reach - a bloodsucker at strike range attacks, it does not vanish
hit_ms      = 3000  ; a hit within this window counts as "recently hit" - shoot a closing bloodsucker and it vanishes
window_ms   = 2500  ; hold the forced invisibility this long, then release to the engine's natural flicker

[backstrike] ; per-species motion pair for the rear spin-strike; motions must carry attack_params rows
arc_deg    = 120
window_ms  = 1000 ; the arm stays open this long: the engine's own gap is 500-1000 ms, so one strike, two at most; the end relay closes it on the strike where the exe has it
near_m     = 4    ; the engine strikes inside this (MAX_DISTANCE_TO_ENEMY, control_melee_jump.cpp:9), so the arm waits for it
chimera    = jump_attack_0, jump_attack_0 ; both sides the 1.2 row below, not the leap's 1.75 (jump_attack_1): user 2026-11-17
lurker     = jump_attack_0, jump_attack_0
burer      = stand_attack_0, stand_attack_0
controller = stand_attack_0, stand_attack_1

[wild] ; bounded ability variation as a fraction of the install's own loaded value
; Wild may vary (a) a standalone ability number (gravity, telekinesis, aura, detection, psi tube, stamina),
; (b) a value the engine time-scales its animation to (the jump force, control_jump.cpp:513-516), or
; (c) a value a controller reads live per frame with no path or capture consequence (the steering gain, :283-285,326-337).
; Never a value a capture-start gate, a path builder or a prepare trace reads (jump distances, jump_build_line_distance,
; Run_Attack_Dist): those desync from the tuned path and froze the boar charge.
ability_pct     = 0.20

; --- Personality: the per-species chance (0..1) that an individual CARRIES a move, rolled ONCE when its record is created (the repertoire,
; the at_faction Personality twin, section = personality_<move>, key = species, default covers a species listed in [moves] without a row).
; A 0.8 move sits in 8 of 10 individuals, who then take every opening the Intelligence roll passes; the other 2 never try it. 1 always, 0 never.
; Each leap carries its OWN section and they share nothing; the situation (elevation / aiming / motion) decides which leap is eligible on a beat.
; The tables are preferences, never certainties (user ruling 2026-11-15): a species favours one or two leaps at 0.7-0.8 and dislikes others at 0.3-0.4.
; THE LETHALITY LADDER (user ruling 2026-11-15): every table change is checked against it. Score = sum of chance x weight; the weights come from the field hit rates
; of 2026-11-15 (Feral 7 of 7, Punishing 21 of 25, Cutoff 3 of 3, Hunting 5 of 8): High 1, Punishing 2, Hunting 2, Feral 3, Catching 1, Cutoff 2, claw 1.2, backstrike 0.8.
;   dog 2.4 (beginner: High and Punishing, straight open jumps, m_dog.ltx:152-163)   cat 3.3 (beginner: Punishing from the blind side)   psy_dog 3.1 (its phantoms fight)
;   pseudodog 4.6 (even, the dog's strong cousin)   lurker 6.6 (the telegraphed hunter: Hunting, Cutoff, the claw)   snork 6.9 (the guided acrobat: Hunting, Feral)
;   chimera 9.0 (apex: three instant leaps at 0.8, the claw). Burer, controller, bloodsucker and poltergeist fight on another axis (gravity, psi, cloak, telekinesis) and sit off this scale.
; The values ARE each creature's temperament - who pounces, who routs, who holds - grounded in GSC's per-species bestiary (характер) and
; the creature_courage ratings [8] (doc/gsc/gsc-design-documents.md), the engine panic_threshold (flee propensity), and the species ecology.


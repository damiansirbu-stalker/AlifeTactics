chimera     = 0.8
lurker      = 0.8
cat         = 0.7
dog         = 0.6
pseudodog   = 0.4
psy_dog     = 0.3

[personality_intercepting_leap] ; Intercepting leap - the instant led pounce at a steadily moving enemy; snork, chimera, lurker and cat highest
default     = 0.5
snork       = 1.0
chimera     = 0.9
lurker      = 0.9
cat         = 0.9
dog         = 0.8
pseudodog   = 0.7
psy_dog     = 0.5

[personality_closing_leap] ; Closing leap - the bloodsucker gap-closer at a perched or aiming enemy
default     = 0.7
bloodsucker = 0.7
psysucker   = 0.7

[personality_claw] ; the chimera-class contact strike
default = 1.0
chimera = 1.0
lurker  = 1.0

[personality_flee] ; break off when hurt and far; flesh and fracture flee most, the hunters rarely, the pseudogigant never
default     = 0.5
flesh       = 0.8
fracture    = 0.6
cat         = 0.5
tushkano    = 0.5
boar        = 0.5
karlik      = 0.4
bloodsucker = 0.1
psysucker   = 0.1
dog         = 0.1
snork       = 0.1
psy_dog     = 0.1

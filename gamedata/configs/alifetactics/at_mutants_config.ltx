; AlifeTactics mutants - the innate numbers: species envelopes, the decision clocks, wild envelopes, premise rows.
; MCM owns the formula sliders and the per-species move toggles; nothing here is user-facing.
; Every band is BOUNDED (the performance law): variation never leaves a field-sane envelope.

[pages] ; species -> MCM page; a subclass folds into its base page
chimera     = chimera
lurker      = chimera
bloodsucker = bloodsucker
psysucker   = bloodsucker
burer       = burer
controller  = controller
poltergeist = poltergeist
dog         = dog
boar        = boar
snork       = snork
pseudodog   = pseudodog
psy_dog     = pseudodog
gigant      = gigant
cat         = cat
flesh       = flesh
fracture    = fracture
karlik      = karlik
tushkano    = tushkano

[moves] ; per-move species envelope: a species either has a move or not (anatomy; engine components, flee = the shared-attack-tree species the proposal reaches)
leap           = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
jump           = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
leap_adapt     = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
jump_adapt     = chimera, lurker, cat, bloodsucker, psysucker, dog, snork, pseudodog, psy_dog
rush           = bloodsucker, psysucker, boar, gigant
dodge          = bloodsucker, psysucker, dog, pseudodog, psy_dog, boar, gigant
flee           = bloodsucker, psysucker, dog, boar, snork, pseudodog, psy_dog, gigant, cat, flesh, fracture, karlik, tushkano
cloak          = bloodsucker, psysucker
gravity_attack = burer
claw           = chimera, lurker
backstrike     = chimera, lurker, burer, controller
roar           = snork, gigant

[managed] ; the vanilla FSM already fires it for these species (the MANAGED section of their page); absent = NEW
leap           = chimera, lurker, dog, snork, pseudodog, psy_dog, cat
rush           = bloodsucker, psysucker, boar, gigant
gravity_attack = burer
cloak          = bloodsucker, psysucker

[quadrupeds] ; the body-plan law: these jump carriers take OUR commanded leap ONLY at an elevated enemy
species = dog, pseudodog, psy_dog, cat, chimera, lurker

[throttle] ; the decision clocks, seconds, flat (no Wild on our clocks)
default = 6
flee    = 60

[caps] ; max driven moves assumed running at once per bucket; a slot counts slot_s seconds
slot_s    = 3
vs_player = 3
vs_npc    = 3

[intelligence]
cap = 0.75

[premises] ; the anti-exploit reads
aim_held_s   = 3
above_m      = 0.8
strafe_lat_m = 1.0

[fleeing] ; the enemy-fleeing read: receding per beat with the back turned
recede_m = 0.3
cone_deg = 90

[flee] ; the run-away window a fresh hit or close shotgun draw rolls
hold_min = 4000
hold_max = 7000

[survival] ; crossing below this health fraction rolls one long run-away window
health_frac = 0.30
hold_min    = 8000
hold_max    = 15000

[threat] ; an enemy weapon aimed within this cone counts as watching the mutant (the shotgun, dodge, and watching-split gates read it)
facing_cone_deg = 60

[leap] ; the commanded leap-family fire gate; the distance band is the species' own jump_min/max_distance
facing_cone_deg = 35

[adapt] ; the air-steering gain band for both adapt leaps = the vanilla envelope (borya 0.3, pseudodog 0.5, cat 0.6)
factor_min = 0.3
factor_max = 0.6

[dodge] ; the stare-break juke: the enemy aiming inside this range opens a dodge roll
range_m = 10

[roar] ; the threat display on a fresh enemy at range, once per engagement
range_min_m = 3
range_max_m = 15

[gravity_attack] ; the burer is_aim_held premise: a held aim inside this range forces the gravity attack
range_m    = 40
cone_deg   = 12
release_ms = 1000

[claw] ; the chimera-class contact strike (covers the lurker: same engine class and anim table)
motion          = jump_attack_0
range_m         = 2.2
facing_cone_deg = 35
clear_ms        = 1100

[backstrike] ; per-species motion pair for the rear spin-strike; motions must carry attack_params rows
arc_deg    = 120
chimera    = jump_attack_0, jump_attack_1
lurker     = jump_attack_0, jump_attack_1
burer      = stand_attack_0, stand_attack_0
controller = stand_attack_0, stand_attack_1

[wild] ; bounded value variation as a fraction of the install's own loaded value
attack_dist_pct = 0.15
jump_band_pct   = 0.15
circle_pct      = 0.20
rush_band_pct   = 0.20
window_pct      = 0.20
ability_pct     = 0.20
turn_min        = 0.90
turn_max        = 1.25

[cloak] ; bloodsucker visibility-transition dwell band, ms
delay_min_ms = 700
delay_max_ms = 2400

[controller] ; the psi tube pacing stays inside a SLOW envelope
tube_delay_min_ms = 5000
tube_delay_max_ms = 9000
see_min_ms        = 800
see_max_ms        = 2000

[poltergeist] ; hover-height band rolled per spawn, metres
height_min_low  = 0.4
height_min_high = 1.2
height_max_low  = 1.6
height_max_high = 3.0

; AlifeTactics faction policy - how each faction fights, for the WHOLE mod, not only maneuvers:
; any AT system that asks "does this faction do it, and which of its NPCs" owns a section here.
; Maneuver-major: one section per decision, everything about it in one block. Loaded once at
; on_game_start through at_maneuvers.get_faction_policy; runtime reads are table reads.
;   factions         = comma list - only these factions run it; key absent = any faction
;   chance           = 0..1 - fraction of NPCs carrying the behavior, resolved per NPC by a
;                      stable id hash: for-life, save/load stable, no re-rolls; absent = everyone
;   chance_<faction> = 0..1 - sparse per-faction override of chance

[flee]
factions = ecolog, csky, renegade

[retreat]
factions = army, dolg, freedom, killer, isg, stalker, bandit, greh, ecolog, csky, renegade

[pickoff]
chance          = 0.7
chance_ecolog   = 0.2
chance_renegade = 0.3
chance_bandit   = 0.3

[push]
chance          = 0.6
chance_ecolog   = 0.2
chance_renegade = 0.8
chance_bandit   = 0.8
chance_monolith = 0.9

; AlifeTactics combat doctrine: maneuver catalog. Paired with gamedata/scripts/at_combat_doctrine.script.
; handles = the checks (problems) this maneuver answers   move = destination resolver   fire = shoot|snipe|ready|stow
; factions / weapons / env = selection sets (listed in full, no shorthand). A check is answered by a random
; eligible maneuver, so listing the same check on several maneuvers spreads behavior across the squad.

[doctrine]
maneuvers = hold_fire, hold_snipe, cover_fire, advance_open_fire, advance_cover_fire, flank_cover_fire, flank_cover_stow, back_open_fire, flee_open_ready, step_back_fire, step_side_fire

[hold_fire]
handles  = engage, is_target_changed
move     = hold
fire     = shoot
factions = bandit, dolg, ecolog, freedom, killer, army, monolith, stalker, csky, zombied, greh, isg, renegade
weapons  = sniper, close, rifle
env      = indoor, outdoor

[hold_snipe]
handles  = engage, is_target_changed
move     = hold
fire     = snipe
factions = stalker, bandit, dolg, freedom, killer, army, monolith, ecolog, csky, renegade, greh, isg
weapons  = sniper
env      = outdoor

[cover_fire]
handles  = engage, is_target_changed, is_blocked_wall
move     = cover
fire     = shoot
factions = army, dolg, freedom, killer, isg, monolith, stalker, ecolog, csky
weapons  = sniper, close, rifle
env      = indoor, outdoor

[advance_open_fire]
handles  = engage, is_target_changed, is_enemy_unseen
move     = advance_open
fire     = shoot
factions = bandit, ecolog, stalker, csky, zombied, greh, renegade
weapons  = sniper, close, rifle
env      = indoor, outdoor

[advance_cover_fire]
handles  = engage, is_target_changed, is_enemy_unseen
move     = advance_cover
fire     = shoot
factions = army, dolg, freedom, killer, isg, monolith, stalker, ecolog, csky
weapons  = sniper, close, rifle
env      = indoor, outdoor

[flank_cover_fire]
handles  = engage, is_target_changed, is_enemy_unseen
move     = flank_cover
fire     = shoot
factions = army, dolg, freedom, killer, isg, monolith
weapons  = close, rifle
env      = outdoor

[flank_cover_stow]
handles  = is_blocked_wall, is_enemy_unseen
move     = flank_cover
fire     = stow
factions = army, dolg, freedom, killer, isg, monolith
weapons  = close, rifle
env      = outdoor

[back_open_fire]
handles  = is_hurt, is_grenade_near
move     = withdraw
fire     = shoot
factions = army, dolg, freedom, killer, isg, stalker, bandit, greh
weapons  = sniper, close, rifle
env      = indoor, outdoor

; timid factions flee - stow the weapon and run away from the danger (the grenade, or the enemy when hurt).
[flee_open_ready]
handles  = is_hurt, is_grenade_near
move     = flee
fire     = ready
factions = ecolog, csky, renegade
weapons  = sniper, close, rifle
env      = indoor, outdoor

[step_back_fire]
handles  = is_too_close
move     = step_back
fire     = shoot
factions = bandit, dolg, ecolog, freedom, killer, army, monolith, stalker, csky, zombied, greh, isg, renegade
weapons  = sniper, close, rifle
env      = indoor, outdoor

[step_side_fire]
handles  = is_blocked_friendly, is_blocked_wall
move     = step_side
fire     = shoot
factions = bandit, dolg, ecolog, freedom, killer, army, monolith, stalker, csky, zombied, greh, isg, renegade
weapons  = sniper, close, rifle
env      = indoor, outdoor

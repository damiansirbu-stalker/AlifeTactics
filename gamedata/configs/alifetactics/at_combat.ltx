; AlifeTactics combat AI tuning constants. Paired with gamedata/scripts/at_combat.script.
; Sections mirror at_combat.script architecture (see AlifeTactics/doc/architecture.md Combat).
; All keys have script-side fallback defaults, so missing keys won't crash.

[at_combat]
; Evaluator
fail_threshold           = 3      ; consecutive pick-fails before backoff engages
fail_backoff_ms          = 10000  ; per-fail penalty multiplier

; Throttle (replaces old behavior_hold)
throttle_npc_ms          = 1500   ; per-NPC minimum interval between decide attempts
throttle_global_ms       = 250    ; global minimum interval (caps total AI runs across all NPCs)

; State machine - friendly line-of-fire detection
friendly_line_thresh_m   = 1.5    ; lateral distance threshold for squadmate-on-firing-line

; Movement / _repick
advance_step_m           = 15     ; cover_step_fwd lookahead step toward enemy
step_away_m              = 15     ; step_away backstep distance from enemy
step_short_m             = 4      ; step_toward_short / step_away_short short-stride distance
charge_step_m            = 20     ; charge_enemy fallback step when enemy lvid inaccessible
flank_lateral_m          = 20     ; cover_flank perpendicular offset from npc->enemy axis
flank_forward_m          = 5      ; cover_flank forward offset along npc->enemy axis
flee_step_m              = 30     ; flee_far backward sprint distance
cover_reach_sqr          = 2025   ; max (search_pos -> enemy) squared distance for best_cover viability (45m^2)

; Squad spread
squad_lateral_buckets    = 5
squad_lateral_step_m     = 4

; State machine thresholds
advance_dist_m           = 40     ; reserved for future rules conditioning on distance band
charge_min_dist_m        = 10     ; reserved for future rules conditioning on charge stop-distance
retreat_hp_frac          = 0.5    ; deprecated; health state machine uses inline 0.50 / 0.55 thresholds

; at_gear tunables and the artefact anomaly-class membership.
;
; at_gear is the gear SOURCE: it walks a stalker's inventory and registers per-NPC effect contributions
; into at_effects_resolver, which combines them highest-wins and writes the engine. The class -> effect
; ASSIGNMENT (which anomaly class becomes which combat edge) is a design choice and lives in
; at_gear.script (D6); this file holds the DATA - the tier ladder, the optic factors, and which artefact
; section belongs to which anomaly class. Missing keys fall back to the values compiled into at_gear.script.

[at_gear]
; Artefact effect strength: tier x tier_step, capped tier_cap. Vanilla artefacts are tier 2-4, so the
; ladder is 4/6/8% with 10% reserved for a tier-5 artefact - the ceiling, since effects never stack
; (strongest source wins) and there is no aggregate cap.
tier_step   = 0.02
tier_cap    = 0.10

; Carried optics -> VISION_RANGE (detection distance), day/night complementary. Binoculars extend range
; by day only (glass needs light); NVG by night only (goggles do nothing in daylight). Each is a
; multiplier on the effective visible distance; the day/night split is read live at apply time, no tick.
binoc_range   = 1.50
nvg_range     = 1.50
night_start_h = 22
night_end_h   = 5

; Chemical -> passive regen when the n039 engine bind (set_health_restore_boost) is present: an additive
; boost on the restore velocity (base 0.00003), sized as the chemical tier strength x regen_scale.
; PROVISIONAL - tuned when n039 deploys. Until then chemical folds into DAMAGE_RESIST (the D18 interim)
; and this key does nothing.
regen_scale = 0.003

; The aura every artefact carrier wears, whatever the artefact does. Applied by at_effects_resolver (the
; particle owner); this file holds the name because the carrier set is a gear fact. Carried binoculars,
; NVG, and plates grant no aura - they are tools and armour, not anomalous matter.
;
; anomaly2\burer_prepare is the burer's gravity wind-up: a colourless space distortion that tracks the
; body (user pick 2026-07-26, auditioned in game against 8 other candidates). The coloured idle glows
; were tested the same day - thermal red, electric red with sparkle, acidic green, gravi a wide air
; distortion - and rejected as too loud.
;
; BLANK OR MISSING MEANS NO AURA - there is deliberately no fallback to the artefact's own particles key,
; so an unset row can never bring back an effect nobody chose.
;
; ONLY config-referenced particle names belong here. A name that lives solely inside particles.xr can be
; absent from a modpack that ships its own library, and a missing name is an engine fatal with no
; existence check from script (r4.cpp:738-748, doc/library/modding/particles.md). Proven case:
; artefact\effects\af_gravi_idle_color exists in vanilla and is ABSENT from GAMMA's Particles Cinematic
; VFX library. anomaly2\burer_prepare passes that rule - vanilla m_burer.ltx:272 names it as
; Particle_Gravi_Prepare, so every library ships it or its own burers stop telegraphing their gravi
; attack; present in GAMMA's Particles Cinematic VFX 3.5 and the Boomsticks and Sharpsticks library.
aura      = anomaly2\burer_prepare
aura_bone = bip01_spine

; Artefact anomaly-class membership (the 33 classed vanilla artefacts + 6 unclassed quest/unique). A
; section not listed here and not modded in grants nothing. Verified against artefacts.ltx class groups.
gravi    = af_black_spray, af_night_star, af_gravi, af_gold_fish, af_medusa, af_vyvert, af_empty, af_full_empty, af_death_lamp
thermal  = af_itcher, af_pin, af_cristall, af_fireball, af_dummy_glassbeads, af_eye, af_fire, af_lobster_eyes
chemical = af_blood, af_mincer_meat, af_bracelet, af_baloon, af_soul, af_fuzz_kolobok, af_glass, af_cristall_flower
electro  = af_electra_sparkler, af_sponge, af_ring, af_electra_flash, af_dummy_battery, af_dummy_dummy, af_ice, af_electra_moonlight
special  = af_compass, af_oasis_heart, af_monolith, af_vaselisk, af_geliy, af_gimlet

; Ballistic plates (i_attach armour inserts) and the carried optics, by exact section name.
plate = af_kevlar, af_plates, af_kevlar_up, af_plates_up, fieldcraft_plate_attch
binoc = wpn_binoc
nvg   = device_torch_nv_1, device_torch_nv_2, device_torch_nv_3

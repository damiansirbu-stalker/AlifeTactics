; AlifeTactics combat takeover (v2) tuning. Paired with gamedata/scripts/at_combat.script + at_combat_doctrine.script.
; All keys have script-side fallback defaults, so a missing key or file won't crash.

[at_combat]
; The monitor pass (a vanilla time event, 200ms) - each check self-throttles on its own period.
; begin_period_ms quantizes to the pass: 600 = every 3rd pass, its true cadence.
begin_period_ms  = 600     ; begin_maneuver check: no maneuver open, look for a fired need and stage a row
update_period_ms = 200     ; update_maneuver check: re-run the row's update (fire re-check / holster re-assert)
end_period_ms    = 200     ; end_maneuver check: watch for arrival / the time cap / a broken premise, hand back
hit_fight_ms      = 5000    ; a recent hit counts as "fighting" this long (far-shooter entry, best_enemy still nil)
max_concurrent_maneuvers = 20 ; runaway failsafe, never a behavior lever: at most this many NPCs hold a maneuver at once (0 = no cap)

; Needs (when AT seizes - only where vanilla is weak). Each row's need states the FULL problem and the
; maneuver's success negates it, so a solved problem does not re-fire; there is no reseize cooldown.
hurt_frac     = 0.40       ; flee/retreat need below this HP fraction, with the enemy inside his own weapon's reach (0.25 fired too late - by then the wounded animation or death beat the maneuver, 2026-07-11 playtest)
stall_ms      = 4000       ; held position with the enemy not closing this long fires the stalled need (measured SINCE the last maneuver - a finished hold resets it)
stall_move_m  = 2          ; movement under this counts as "held position"
stall_close_m = 2          ; enemy gaining more than this much ground resets the stall timer
repeat_limit = 3          ; consecutive same-situation picks with the NPC still standing within 2m of the last pick before the takeover stops trying (the transactions are provably changing nothing); releases when he moves, the situation changes, or the fight ends (0 = off)
counterflank_actor_dist_m = 5  ; counterflank fires when an enemy actor is inside this range while the NPC's committed target is farther than him

; Scheme fire discipline - the burst a maneuver-driven NPC fires. Replaces the state machinery's
; generic 5-round/300ms fallback (state_mgr.script:322); animation-tuned states (barricade/cover
; attacks) keep their own values. By default each burst ROLLS size and pause fresh inside the engine
; planner's own [fire_queue_params] medium band for the weapon kind (m_stalker.ltx:826-909), then the
; Fire Discipline rank factors scale it. Uncommenting a queue_w_* key PINS that kind to fixed
; "queue size, interval ms" values - no roll (rank factors still apply).
;queue_w_pistol  = 2, 450
;queue_w_shotgun = 2, 675
;queue_w_rifle   = 3, 475
;queue_w_smg     = 7, 400
;queue_w_sniper  = 1, 1750

; Pickoff fire: 1 deliberate aimed shot per pull, the pause rolled fresh each shot in this band -
; the engine's own deliberate-fire rhythm (the [fire_queue_params] sniper medium band). The rank
; interval factor tightens it (legend ~1100-1500ms).
pickoff_interval_min_ms = 1500
pickoff_interval_max_ms = 2000

; The Push window (Combat > Behaviors): stalkers fighting the actor punish his vulnerable window.
; Opened by the actor weapon edges (reload / dry / jam) or the standing finisher condition (actor
; weak); closed when he answers, recovers, or the press cap runs out. Two effectors on the NPCs
; whose selected enemy is the actor: the fire bump (range-gated - inside push_close_m bursts grow
; AND the pause shrinks, out to push_far_m only the pause shrinks; farther a longer burst would
; only spray its dispersed tail) and the band bump (with an advantage - target weak / bleeding /
; back turned - his accepted cover-to-enemy maximum caps at push_band_k x his current distance, so
; his own re-picks close in).
push_close_m       = 15    ; fire bump close band: burst size x push_size_k AND interval x push_interval_k
push_far_m         = 45    ; fire bump far band: interval x push_interval_k only; beyond = untouched
push_size_k        = 1.5   ; burst-size scale on the rank discipline value inside the close band
push_interval_k    = 0.6   ; inter-burst-pause scale on the rank discipline value inside both bands
push_weak_frac     = 0.35  ; finisher opens with the actor's health at or below this fraction (closes 0.10 above it)
push_self_frac     = 0.5   ; finisher band bump only for pushers at or above this health fraction themselves
push_band_k        = 0.6   ; band bump: cover maximum caps at this fraction of the NPC's current distance
push_band_floor_m  = 8     ; the band cap never drops below this
push_back_deg      = 135   ; back-turned advantage: actor facing at least this far off the NPC (135 = genuinely turned away, not a flank)
push_window_max_ms = 8000  ; hard cap on a press window (reload / dry / jam); a mid-window cause change stays on the original clock; the finisher has none, it closes on recovery
push_press_cooldown_ms = 15000 ; after a press window closes, no new one opens for this long - the window is the exception, not the fight's steady state

; The Pull window, the push's mirror: a stalker caught in his OWN vulnerable window (reloading via
; the engine reload events, or badly hurt with fresh incoming hits) while the actor is strong falls
; back - his accepted cover-to-enemy minimum rises past his current distance so his own re-picks
; land farther. No fire side. Per-NPC windows with a per-NPC cooldown; pull outranks push per NPC.
pull_weak_frac    = 0.35  ; hurt cause: the NPC's own health at or below this fraction (closes 0.10 above it)
pull_strong_frac  = 0.5   ; pull only while the actor's health is at or above this fraction (a dying enemy scares nobody back)
pull_band_k       = 1.2   ; his cover minimum rises to this fraction of his current distance
pull_band_floor_m = 8     ; the raised minimum never drops below this - a point-blank pull is a real fallback, not a 3m shuffle
pull_band_cap_m   = 45    ; the raised minimum never exceeds this
pull_band_depth_m = 12    ; the band stays open this far past the raised minimum
pull_cooldown_ms  = 15000 ; per NPC: after his pull clears, no new one for this long
pull_hold_min_ms  = 8000  ; a pull outlives its cause at least this long - a ~3s reload ends before the engine re-picks cover, so the band stands to catch the next re-pick

; Maneuvers (kite backs off a fixed per-weapon distance - no key, KITE_BACK in at_combat_doctrine is the source)
kite_arc_deg    = 45       ; back-lane fan step: try straight-back, then +-45, then +-90 for a clear lane
kite_spread_deg = 90       ; max fan to either side when the straight-back lane is blocked by a wall or obstacle
retreat_rear_m  = 8        ; retreat centers its cover search this far behind the NPC; the winning spot must be farther from the enemy than he stands. MUST exceed the 7m cover-search radius: at 4 the circle included the NPC's own cover, best_cover kept re-picking it, and retreat declined toward_enemy forever (2026-07-11 playtest)
under_fire_ms   = 2000     ; flee and pickoff decline while a hit landed or a shot from that enemy was perceived within this window
reload_cover_cone_deg = 60 ; reload_cover fires when the player has the reloader in view with a firearm and a clear line: holds a firearm, faces him within this many degrees, clear shot line (xcombat.actor_can_hit)
pickoff_targeted_deg = 10  ; pickoff declines (and an open hold ends) while the actor's aim is within this many degrees of the NPC - no motionless head under a crosshair
pickoff_enter_factor = 1.2 ; hysteresis: plant only past the enemy's EFFECTIVE range x this factor; an open hold ends when he closes inside 1.0x (his weapon is dangerous again). Between the two nothing flaps
maneuver_max_ms = 8000     ; stuck cap - a committed maneuver hands back after this even if it never arrives
pickoff_hold_ms = 8000     ; pickoff is a deliberate-fire hold (ends_on=time); it hands back to vanilla after this
counterflank_max_ms = 3000     ; counterflank is a hold: aim at the actor, the turn makes him seen, the engine's selection flips; hands back after this
flee_max_ms     = 20000    ; flee is a rout (ends_on=arrival); a rout to a far base needs a longer cap than a maneuver
flee_min_dist_m = 5        ; flee only when the enemy is at least this far - nobody turns their back point-blank; most combat is <20m so keep this small (0 = off)
flee_base_min_dist_m = 100 ; flee only to a friendly base/smart at least this far away - a real rout to safety, not a near hop

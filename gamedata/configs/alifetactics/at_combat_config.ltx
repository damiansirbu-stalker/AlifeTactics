; AlifeTactics combat takeover (v2) tuning. Paired with gamedata/scripts/at_combat.script + at_combat_doctrine.script.
; All keys have script-side fallback defaults, so a missing key or file won't crash.

[at_combat]
; Monitor (npc_on_update, throttled) - the always-on decision tick per installed stalker
monitor_period_ms = 500    ; min interval between monitor decisions (gate down: deciding whether to take over)
watch_period_ms   = 200    ; min interval while a maneuver runs (gate up: watching for arrival / the time cap)
hit_fight_ms      = 5000    ; a recent hit counts as "fighting" this long (far-shooter entry, best_enemy still nil)
reseize_cooldown_ms = 5000  ; after a maneuver commits, hold off a fresh takeover of the same NPC this long (0 = off); also the flee disengage settle window

; Triggers (when AT seizes - only where vanilla is weak)
hurt_frac     = 0.20       ; flee/retreat trigger below this HP fraction (20% - only when badly hurt, not a scratch)
grenade_ms    = 3000       ; how recently a grenade danger counts as "near"
stall_ms      = 4000       ; held position with the enemy not closing this long fires the stalled trigger
stall_move_m  = 2          ; movement under this counts as "held position"
stall_close_m = 2          ; enemy gaining more than this much ground resets the stall timer

; Maneuvers (Phase 1: kite - the committed back-step on too_close)
kite_back_m    = 6        ; metres to back-step away from the enemy when it violates weapon min range
kite_arc_deg    = 45       ; back-lane fan step: try straight-back, then +-45, then +-90 for a clear lane
kite_spread_deg = 90       ; max fan to either side when the straight-back lane is blocked by a wall or obstacle
maneuver_max_ms = 8000     ; stuck cap - a committed maneuver hands back after this even if it never arrives
snipe_hold_ms   = 8000     ; snipe is a precision-fire hold (ends_on=time); it hands back to vanilla after this
flee_max_ms     = 15000    ; flee is a rout (ends_on=arrival); a rout to a far base needs a longer cap than a maneuver
flee_min_dist_m = 5        ; flee only when the enemy is at least this far - nobody turns their back point-blank; most combat is <20m so keep this small (0 = off)
flee_base_min_dist_m = 100 ; flee only to a friendly base/smart at least this far away - a real rout to safety, not a near hop

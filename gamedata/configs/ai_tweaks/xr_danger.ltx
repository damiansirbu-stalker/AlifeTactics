;Note: Ignore distance is only checked if danger was produced by game_object.enemy with the exception of grenade and ent. corpse
;Inertion values are in milliseconds. Distance values in [danger_object*] are SQUARED meters.
;Section keys are EDangerType names (danger_object.h:16-27). PerceiveType names (hit/sound/visual) are NOT keys — they collide with bullet_ricochet/attack_sound/entity_attacked enum values and would overwrite them in vanilla bd_types.
;Values match GAMMA AI Rework. In GAMMA, Useful Idiots DLTX (mod_xr_danger_z_idiots.ltx) replaces [danger_inertion] entirely and 2 keys of [danger_inertion_actor] with per-NPC condlists; non-companion non-redone-combat values fall through to these same numbers.

[danger_inertion] ;May use condlists from xr_condition
grenade         = 6000
entity_corpse   = 60000
entity_attacked = 30000
attacked        = 120000
bullet_ricochet = 250000
enemy_sound     = 45000
attack_sound    = 45000
entity_death    = 30000

[danger_object] ;Ignore distances squared; weather-conditional
grenade         = 400
entity_corpse   = 10000
entity_attacked = {=is_dark_night} 900, {=is_heavy_rain} 625, {=is_rain} 900, 2500
attacked        = 90000
bullet_ricochet = 16
enemy_sound     = {=is_heavy_rain} 900, {=is_rain} 2500, 5625
attack_sound    = {=is_heavy_rain} 900, {=is_rain} 2500, 5625
entity_death    = {=is_heavy_rain} 225, {=is_rain} 400, 1000

[danger_inertion_actor] ;When the danger source is the actor
grenade         = 6000
entity_corpse   = 60000
entity_attacked = 30000
attacked        = 120000
bullet_ricochet = 5000
enemy_sound     = 45000
attack_sound    = {=actor_enemy} 45000, 3000
entity_death    = 30000

[danger_object_actor] ;When the danger source is the actor
grenade         = 400
entity_corpse   = 60000
entity_attacked = {=is_dark_night} 900, {=is_heavy_rain} 625, {=is_rain} 900, 2500
attacked        = 90000
bullet_ricochet = {=actor_enemy} 250000, 10000
enemy_sound     = {=is_heavy_rain} 900, {=is_rain} 2500, 5625
attack_sound    = {=is_heavy_rain} 900, {=is_rain} 2500, 5625
entity_death    = {=is_heavy_rain} 225, {=is_rain} 400, 1000

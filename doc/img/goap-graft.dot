digraph at_goap_graft {
    // C4 level 3: the takeover control point. xcombat grafts one evaluator+action at the
    // reserved id TAKEOVER_ID (188347) into every stalker's motivation manager at spawn.
    rankdir=TB
    splines=polyline
    nodesep=0.4
    ranksep=0.55

    node [shape=box, style="rounded,filled", fillcolor=white,
          fontsize=13, fontname="Arial", margin="0.14,0.08"]
    edge [fontsize=11, fontname="Arial"]
    graph [fontsize=15, fontname="Arial"]

    spawn [label="npc_on_net_spawn\nat_maneuvers._register_graft\nxcombat.register_takeover(npc, SPEC)", fillcolor=gray95]

    subgraph cluster_graft {
        label="grafted on the action manager at id 188347 (xcombat.script:800-818)"
        style=rounded
        color=gray55
        eva [label="evaluator: reads SPEC.gate\n(state.gate flag, one read per solve)"]
        act [label="action: initialize -> SPEC.on_begin\nexecute empty; finalize -> SPEC.on_release"]
        blk [label="block: every blocked planner gains\nprecondition TAKEOVER_ID == false\n(apply_takeover_block, :832)"]
    }

    down  [label="gate down (188347 false)\nvanilla chain solves; graft dormant", shape=box, fillcolor=white]
    seize [label="seize (188347 true)\nblocked actions unselectable;\ngraft action is the only path to the goal\ninitialize starts the maneuver", fillcolor=gray92]
    rel   [label="release (188347 false)\nvanilla resumes from where the NPC stands", shape=box]

    spawn -> eva
    spawn -> act
    spawn -> blk
    eva -> down [label="need false"]
    eva -> seize [label="need fires -> _try_seize\nadd_start + apply_takeover_block + gate=true"]
    seize -> rel [label="arrival / cap / broken premise / target_lost"]
    rel -> down [constraint=false]
}

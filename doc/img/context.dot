digraph at_context {
    // C4 level 1: AlifeTactics against its neighbours.
    rankdir=TB
    splines=ortho
    pad=0.3
    compound=true
    nodesep=0.5
    ranksep=0.95
    graph [fontname="Arial", fontsize=16]
    node  [shape=box, style="rounded,filled", fillcolor=white,
           color=gray40, fontname="Arial", fontsize=15, margin="0.16,0.1"]
    edge  [fontname="Arial", fontsize=12, color=gray35, arrowsize=0.8]

    player  [label="Player\nobserved inside gate_radius_m"]
    at      [label="AlifeTactics\nat_*.script  (policy: when, whom, which)", fillcolor=gray85, color=gray25, penwidth=1.4]
    xcombat [label="xcombat (xlibs)\nthe one combat-call boundary", shape=hexagon, fillcolor=gray92, color=gray30]

    subgraph cluster_anomaly {
        label="Anomaly Lua layer"
        labeljust=l
        fontname="Arial"
        fontsize=13
        style=rounded
        color=gray55
        anomaly [label="xr_danger | state_mgr | xr_eat_medkit\nxr_weapon_jam | xr_combat_ignore"]
        brain   [label="installed combat brain\nvanilla or a third-party combat-AI overhaul\ncomposed, never replaced"]
    }

    subgraph cluster_engine {
        label="X-Ray engine (C++), themrdemonized fork"
        labeljust=l
        fontname="Arial"
        fontsize=13
        style="rounded,dashed"
        color=gray50
        engine [label="GOAP planners | CEnemyManager\nsight_manager | CVisualMemoryManager\nweapon handler"]
        exes   [label="modded-exes seams\ndemonized or AOEngine\nper-NPC binds, vetoes, callbacks", fillcolor=gray95]
    }

    at -> xcombat     [xlabel="every combat command and read"]
    xcombat -> engine [xlabel="bind / veto / read"]
    at -> anomaly     [xlabel="function patch"]
    at -> engine      [xlabel="engine callbacks", style=dashed]
    exes -> engine    [xlabel="expose", style=dashed]
    engine -> brain   [xlabel="drives NPCs"]
    at -> brain       [xlabel="GOAP graft interrupts, then hands back", constraint=false, style=dashed]
    player -> at      [label="hit / noise / sight", style=dotted]
}

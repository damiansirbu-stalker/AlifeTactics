digraph at_container {
    // C4 level 2: the containers. The user-facing set IS the MCM tree (at_mcm.script),
    // same grouping, order, and names: one box per tab, its pages listed inside, in reading order.
    // Substrate and Observability carry no MCM page. Invisible edges only stack the rows.
    rankdir=TB
    pad=0.3
    nodesep=0.25
    ranksep=0.3
    newrank=true
    graph [fontname="Arial", fontsize=14]
    node  [shape=box, style="rounded,filled", fillcolor=white, width=1.9,
           color=gray40, fontname="Arial", fontsize=12, margin="0.12,0.06"]
    edge  [style=invis]

    subgraph cluster_mcm {
        label="AlifeTactics, the MCM tree"
        labeljust=l
        style="rounded,filled"
        fillcolor=gray96
        color=gray45
        combat  [label="Combat\n\nGeneral\nManeuvers\nCommitment\nConduct\nBehaviors"]
        effect  [label="Effectiveness\n\nAccuracy\nCrossfire\nReaction\nDiscipline\nRange (planned)"]
        percep  [label="Perception\n\nSound\nVision\nDanger"]
        mechan  [label="Mechanics\n\nHealing\nJamming\nAmmo\nAttachments\nGear"]
        effects [label="Effects (planned)"]
        mutants [label="Mutants\n\nGeneral\nPower (off)\n15 species pages"]
        fixes   [label="Fixes to Vanilla"]
        devel   [label="Development"]
        {rank=same; combat; effect; percep; mechan}
        {rank=same; effects; mutants; fixes; devel}
    }

    subgraph cluster_support {
        label="No MCM page"
        labeljust=l
        style="rounded,filled"
        fillcolor=gray90
        color=gray45
        substrate [label="Substrate\n\nat_core: store, loop, budget\nat_faction: repertoire, Intelligence\nat_effects_resolver\nxcombat boundary | GOAP graft (xgraft)", width=3.2]
        observ    [label="Observability, off in play\n\nat_debug | at_world_trace\nat_hud | at_test", width=3.2]
        {rank=same; substrate; observ}
    }

    combat -> effects; effect -> mutants; percep -> fixes; mechan -> devel
    combat -> effect -> percep -> mechan [constraint=false]
    mutants -> substrate; fixes -> observ
}

digraph at_control_loop {
    // C4 level 3: the one combat loop. at_core._run_monitor, a vanilla time event, 200ms.
    rankdir=TB
    splines=ortho
    pad=0.3
    nodesep=0.45
    ranksep=0.55
    graph [fontname="Arial", fontsize=15]
    node  [shape=box, style="rounded,filled", fillcolor=white,
           color=gray40, fontname="Arial", fontsize=13, margin="0.16,0.09"]
    edge  [fontname="Arial", fontsize=11, color=gray35, arrowsize=0.8]

    loop [label="_run_monitor  every 200ms", style=filled, fillcolor=gray85, color=gray25, penwidth=1.4]
    arm  [label="re-arm first (_reset_monitor)", fillcolor=gray95]
    each [label="for each record in _npc_states"]
    dead [label="dead: clear maneuvers + behaviors, next"]
    dist [label="write actor_dist_sqr"]
    best [label="refresh best_enemy_id (per 600ms)\nmaintain _best_enemy_of reverse index"]
    gate [label="gate up?", shape=diamond, fillcolor=gray92, color=gray25, margin="0.14,0.06"]
    run  [label="at_maneuvers.run_maneuver\nupdate + end checks (200ms)"]
    try  [label="at_maneuvers.try_maneuver\nbegin check (600ms)"]
    beh  [label="at_behaviors.update_npc (Push, Pull)"]

    subgraph cluster_events {
        label="events write the record (never scan)"
        labeljust=l
        fontname="Arial"
        fontsize=12
        style=rounded
        color=gray55
        ev_spawn  [label="npc_on_net_spawn\ncreate _npc_states[id]", fillcolor=gray98]
        ev_hit    [label="npc_on_hit_callback\nhit_at, hit_by", fillcolor=gray98]
        ev_reload [label="reload start/stop\nreloading, reload_at", fillcolor=gray98]
    }

    loop -> arm -> each
    each -> dist -> best -> gate
    each -> dead
    gate -> run [xlabel="yes"]
    gate -> try [xlabel="no"]
    run -> beh
    try -> beh

    ev_spawn  -> each [style=dashed, constraint=false]
    ev_hit    -> each [style=dashed, constraint=false]
    ev_reload -> each [style=dashed, constraint=false]
}

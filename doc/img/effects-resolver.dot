digraph at_effects_resolver {
    // C4 level 3: the multi-source effect fan-in. Sources register lazy providers;
    // resolve() keeps the strongest contribution; appliers write engine state at fixed seams.
    rankdir=LR
    splines=ortho
    pad=0.3
    nodesep=0.3
    ranksep=0.9
    graph [fontname="Arial", fontsize=15]
    node  [shape=box, style="rounded,filled", fillcolor=white,
           color=gray40, fontname="Arial", fontsize=13, margin="0.15,0.08"]
    edge  [fontname="Arial", fontsize=11, color=gray35, arrowsize=0.8]

    subgraph cluster_src {
        label="sources (register providers at on_game_start; walk once, cache)"
        labeljust=l
        fontname="Arial"
        fontsize=12
        style=rounded
        color=gray55
        acc  [label="at_accuracy\nSHOT_DISPERSION (rank cone)"]
        rea  [label="at_reaction\nVISION_RANGE (rank slice)"]
        gear [label="at_gear\nDEALT | RESIST | DISPERSION\nVISION_RANGE | AURA"]
    }

    res [label="at_effects_resolver\nresolve(npc, effect) = strongest\nmax | min | boolean OR", shape=hexagon, fillcolor=gray92, color=gray30]

    subgraph cluster_app {
        label="appliers (engine writes)"
        labeljust=l
        fontname="Arial"
        fontsize=12
        style=rounded
        color=gray55
        spawn [label="npc_on_net_spawn\nset_view_distance_factor + aura particle"]
        hit   [label="npc_on_before_hit / actor_on_before_hit\napply_hit_power: RESIST then DEALT"]
        shot  [label="npc_shot_dispersion\napply_dispersion: SHOT_DISPERSION"]
    }

    acc -> res
    rea -> res
    gear -> res
    res -> spawn
    res -> hit
    res -> shot
}

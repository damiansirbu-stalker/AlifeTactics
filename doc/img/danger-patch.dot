digraph at_danger_patch {
    // C4 level 3: the danger scheme, installed as a function-level patch on whichever
    // xr_danger won the MO2 slot. No xr_danger.script of AT's own, so no slot contest.
    // The verdict is a stamp or the type tables; the action claims grenade, corpse and attacked,
    // and every sound danger stays with the engine planner (at_danger.script, at_evaluator_check_danger).
    rankdir=TB
    splines=ortho
    pad=0.3
    nodesep=0.4
    ranksep=0.6
    graph [fontname="Arial", fontsize=15]
    node  [shape=box, style="rounded,filled", fillcolor=white,
           color=gray40, fontname="Arial", fontsize=13, margin="0.15,0.09"]
    edge  [fontname="Arial", fontsize=11, color=gray35, arrowsize=0.8]

    subgraph cluster_feed {
        label="feeders -> patched set_script_danger"
        labeljust=l
        fontname="Arial"
        fontsize=12
        style=rounded
        color=gray55
        feed_win [label="the winner's own\nhear + death callbacks", fillcolor=gray95]
        feed_at  [label="at_sound: your steps, reload,\nempty click, item use,\na missed knife swing", fillcolor=gray95]
    }

    install [label="on_game_start -> _install_patches\npoints the winning xr_danger's 7 entry points at AT", fillcolor=gray95]

    bind [label="bind time (the winner's add_to_binder, now AT's)\nbinds at_evaluator_danger + at_action_danger\ninto every stalker's motivation manager"]

    subgraph cluster_solve {
        label="runtime, per plan solve"
        labeljust=l
        fontname="Arial"
        fontsize=12
        style=rounded
        color=gray55
        eval   [label="eval_danger -> eval_danger_raw (verdict)\nthen npc_on_eval_danger only on would-be-true"]
        stamp  [label="live admitted script_danger stamp\n= TRUE outright (an activator,\ngraded faint / solid / watch)"]
        table  [label="else best_danger type ->\ninertion + ignore tables\n(the winner's xr_danger.ltx) -> danger_flag"]
        act    [label="at_action_danger:execute\nscript_danger first, else per-type response"]
        engine [label="engine danger planner\ncover, look-out, hold, detour, search"]
        safe   [label="combat-safe by GOAP:\naction requires property_enemy == false"]
    }

    install -> bind -> eval
    eval -> stamp  [xlabel="  stamped  "]
    eval -> table  [xlabel="  not stamped  "]
    stamp -> act
    table -> act    [xlabel="  grenade, corpse, attacked  "]
    table -> engine [xlabel="  sound  "]
    act -> safe [style=dashed, arrowhead=none]
    feed_win -> stamp [style=dashed]
    feed_at  -> stamp [style=dashed]
}
